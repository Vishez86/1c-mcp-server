// MCP_Registers.bsl
// ====================================================================
// Чтение регистров 1С: records, slice_first, slice_last, balance, turnovers, balance_and_turnovers.
// А также движения документа по регистрам (get_document_movements).
// ====================================================================

Функция ПрочитатьЗаписи(ПараметрыВызова) Экспорт

	RegisterType = ПолучитьПараметр(ПараметрыВызова, "register_type", "");
	RegisterName = ПолучитьПараметр(ПараметрыВызова, "register", "");
	Mode = ПолучитьПараметр(ПараметрыВызова, "mode", "");
	ПолноеИмя = RegisterType + "." + RegisterName;

	Если ПустаяСтрока(RegisterType) ИЛИ ПустаяСтрока(RegisterName) ИЛИ ПустаяСтрока(Mode) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"register_type, register и mode обязательны.");
	КонецЕсли;

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя регистра: " + ПолноеИмя);
	КонецЕсли;

	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Регистр запрещён: " + ПолноеИмя);
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Регистр не найден: " + ПолноеИмя);
	КонецЕсли;

	// Проверка совместимости режима и типа регистра.
	ПроверитьРежим(RegisterType, Mode);

	// Срезы/остатки/обороты требуют периодического измерения.
	Если (Mode = "slice_first" ИЛИ Mode = "slice_last" ИЛИ Mode = "balance"
		ИЛИ Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers")
		И RegisterType = "РегистрСведений"
		И НЕ РегистрИмеетПериод(ОМД) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_RegisterModeNotSupported(),
			"Режим " + Mode + " не применим к непериодическому регистру " + ПолноеИмя);
	КонецЕсли;

	ТекстЗапроса = СформироватьЗапросРегистра(ПараметрыВызова, ОМД);
	Запрос = Новый Запрос(ТекстЗапроса);
	УстановитьПараметрыФильтра(Запрос, ПараметрыВызова, ПолноеИмя);

	Попытка
		Лимит = Число(ПолучитьПараметр(ПараметрыВызова, "limit", 100));
	Исключение
		Лимит = 100;
	КонецПопытки;
	МаксЛимит = MCP_Config.Лимиты().max_register_rows;
	Если Лимит < 1 Тогда
		Лимит = 100;
	КонецЕсли;
	Если Лимит > МаксЛимит Тогда
		Лимит = МаксЛимит;
	КонецЕсли;
	Смещение = ЦелоеИзСтроки(ПолучитьПараметр(ПараметрыВызова, "cursor", ""), 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	Старт = ТекущиеМиллисекундыUTC();
	РезультатЗапроса = Запрос.Выполнить();
	Длительность = ТекущиеМиллисекундыUTC() - Старт;

	Колонки = Новый Массив;
	Для Каждого К Из РезультатЗапроса.Колонки Цикл
		КС = Новый Структура;
		КС.Вставить("name", К.Имя);
		КС.Вставить("type_description", Строка(К.ТипЗначения));
		Колонки.Добавить(КС);
	КонецЦикла;

	Строки = Новый Массив;
	Усечено = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Счетчик = 0;
	Пропущено = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Смещение Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		СтрокаJSON = Новый Структура;
		Для Каждого К Из РезультатЗапроса.Колонки Цикл
			СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(Выборка[К.Имя], ОпцииВалью));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("register", ПолноеИмя);
	Результат.Вставить("mode", Mode);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("row_count", Счетчик);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("query_used", ТекстЗапроса);
	Результат.Вставить("duration_ms", Длительность);
	Возврат Результат;

КонецФункции

Процедура ПроверитьРежим(RegisterType, Mode)

	Совместимы = Истина;

	Если RegisterType = "РегистрСведений" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "slice_first" ИЛИ Mode = "slice_last");
	ИначеЕсли RegisterType = "РегистрНакопления" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "balance" ИЛИ Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers");
	ИначеЕсли RegisterType = "РегистрБухгалтерии" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "balance" ИЛИ Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers");
	ИначеЕсли RegisterType = "РегистрРасчета" Тогда
		Совместимы = (Mode = "records");
	КонецЕсли;

	Если НЕ Совместимы Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_RegisterModeNotSupported(),
			"Режим " + Mode + " не поддерживается для " + RegisterType);
	КонецЕсли;

КонецПроцедуры

Функция СформироватьЗапросРегистра(Параметры, ОМД)

	RegisterType = ПолучитьПараметр(Параметры, "register_type", "");
	RegisterName = ПолучитьПараметр(Параметры, "register", "");
	Mode = ПолучитьПараметр(Параметры, "mode", "");
	ПолноеИмя = RegisterType + "." + RegisterName;

	Виртуальная = "";
	WHERE = "";
	Фильтр = ПолучитьФильтрСтрокой(Параметры, ПолноеИмя);
	Если Mode = "slice_first" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".СрезПервых(&Период)", ".СрезПервых(&Период, " + Фильтр + ")");
	ИначеЕсли Mode = "slice_last" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".СрезПоследних(&Период)", ".СрезПоследних(&Период, " + Фильтр + ")");
	ИначеЕсли Mode = "balance" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".Остатки(&Период)", ".Остатки(&Период, " + Фильтр + ")");
	ИначеЕсли Mode = "turnovers" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".Обороты(&ПериодНачало, &ПериодКонец)", ".Обороты(&ПериодНачало, &ПериодКонец, , " + Фильтр + ")");
	ИначеЕсли Mode = "balance_and_turnovers" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)", ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец, , , " + Фильтр + ")");
	Иначе
		// records: фильтры идут как WHERE, плюс при необходимости — ограничение по периоду.
		Условия = Новый Массив;
		Если НЕ ПустаяСтрока(Фильтр) Тогда
			Условия.Добавить(Фильтр);
		КонецЕсли;
		ХочетФильтрПоПериоду = ПолучитьПараметр(Параметры, "period_from", Неопределено) <> Неопределено
			ИЛИ ПолучитьПараметр(Параметры, "period_to", Неопределено) <> Неопределено;
		Если ХочетФильтрПоПериоду И НЕ РегистрИмеетПериод(ОМД) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
				"Регистр " + ПолноеИмя + " непериодический: period_from/period_to неприменимы.");
		КонецЕсли;
		Если ПолучитьПараметр(Параметры, "period_from", Неопределено) <> Неопределено Тогда
			Условия.Добавить("Период >= &ПериодНачало");
		КонецЕсли;
		Если ПолучитьПараметр(Параметры, "period_to", Неопределено) <> Неопределено Тогда
			Условия.Добавить("Период <= &ПериодКонец");
		КонецЕсли;
		Если Условия.Количество() > 0 Тогда
			WHERE = Символы.ПС + "ГДЕ " + СтрСоединить(Условия, " И ");
		КонецЕсли;
	КонецЕсли;

	Поля = СформироватьСписокПолей(Параметры, ОМД);

	Текст = "ВЫБРАТЬ " + Поля + Символы.ПС
		+ "ИЗ " + ПолноеИмя + Виртуальная + WHERE;

	OrderBy = БезопасныйСписокПолей(ПолучитьПараметр(Параметры, "order_by", Неопределено), ПолноеИмя);
	Если OrderBy.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО " + СтрСоединить(OrderBy, ", ");
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция СформироватьСписокПолей(Параметры, ОМД)

	Поля = Новый Массив;

	Dimensions = ПолучитьПараметр(Параметры, "dimensions", Неопределено);
	Resources = ПолучитьПараметр(Параметры, "resources", Неопределено);
	Attributes = ПолучитьПараметр(Параметры, "attributes", Неопределено);

	ПолноеИмя = ПолучитьПараметр(Параметры, "register_type", "") + "." + ПолучитьПараметр(Параметры, "register", "");
	ДобавитьБезопасныеПоля(Поля, Dimensions, ПолноеИмя);
	ДобавитьБезопасныеПоля(Поля, Resources, ПолноеИмя);
	ДобавитьБезопасныеПоля(Поля, Attributes, ПолноеИмя);

	Если Поля.Количество() = 0 Тогда
		Если ЕстьЗапрошенныеПоля(Dimensions) ИЛИ ЕстьЗапрошенныеПоля(Resources) ИЛИ ЕстьЗапрошенныеПоля(Attributes) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
				"Не осталось разрешённых полей регистра после проверки.");
		КонецЕсли;
		Если MCP_Security.СкрытыеПоля(ПолноеИмя).Количество() > 0 Тогда
			ПоляПоУмолчанию = БезопасныеПоляРегистра(ПолноеИмя, ОМД);
			Если ПоляПоУмолчанию.Количество() = 0 Тогда
				MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
					"Не осталось разрешённых полей регистра после проверки.");
			КонецЕсли;
			Возврат СтрСоединить(ПоляПоУмолчанию, ", ");
		КонецЕсли;
		Возврат "*";
	КонецЕсли;
	Возврат СтрСоединить(Поля, ", ");

КонецФункции

Функция ПолучитьФильтрСтрокой(Параметры, ПолноеИмя)

	Фильтры = ПолучитьПараметр(Параметры, "filters", Неопределено);
	Если Фильтры = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Условия = Новый Массив;
	БылиФильтры = Ложь;
	Если ТипЗнч(Фильтры) = Тип("Структура") Тогда
		Для Каждого КЗ Из Фильтры Цикл
			БылиФильтры = Истина;
			Если MCP_Security.ИмяБезопасноДляЗапроса(КЗ.Ключ)
				И MCP_Security.ПолеРазрешено(ПолноеИмя, КЗ.Ключ) Тогда
				Условия.Добавить(КЗ.Ключ + " = &Filter_" + КЗ.Ключ);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Фильтры) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Фильтры Цикл
			БылиФильтры = Истина;
			ИмяПоля = Строка(КЗ.Ключ);
			Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
				И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
				Условия.Добавить(ИмяПоля + " = &Filter_" + ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если БылиФильтры И Условия.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
			"Не осталось разрешённых фильтров регистра после проверки.");
	КонецЕсли;

	Возврат СтрСоединить(Условия, " И ");

КонецФункции

Процедура ДобавитьБезопасныеПоля(Поля, Список, ПолноеИмя)

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПоля Из Список Цикл
		Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
			И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция БезопасныйСписокПолей(Список, ПолноеИмя)

	Результат = Новый Массив;
	ДобавитьБезопасныеПоля(Результат, Список, ПолноеИмя);
	Возврат Результат;

КонецФункции

Функция ЕстьЗапрошенныеПоля(Список)

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Список.Количество() > 0;

КонецФункции

Функция ПолучитьПараметр(Параметры, Имя, ПоУмолчанию)

	Если Параметры = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство(Имя, Значение) Тогда
		Если Значение = Null Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Значение = Параметры.Получить(Имя);
		Если Значение <> Неопределено И Значение <> Null Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Число(Текст));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Процедура УстановитьПараметрыФильтра(Запрос, Параметры, ПолноеИмя) Экспорт

	// Период.
	Период = ПолучитьПараметр(Параметры, "period", Неопределено);
	Если Период <> Неопределено Тогда
		Запрос.УстановитьПараметр("Период", MCP_Values.ДекодироватьПараметр(СтруктураDate(Период)));
	КонецЕсли;
	ПериодОт = ПолучитьПараметр(Параметры, "period_from", Неопределено);
	Если ПериодОт <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПериодНачало", MCP_Values.ДекодироватьПараметр(СтруктураDate(ПериодОт)));
	КонецЕсли;
	ПериодДо = ПолучитьПараметр(Параметры, "period_to", Неопределено);
	Если ПериодДо <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПериодКонец", MCP_Values.ДекодироватьПараметр(СтруктураDate(ПериодДо)));
	КонецЕсли;

	// Фильтры по измерениям.
	Фильтры = ПолучитьПараметр(Параметры, "filters", Неопределено);
	Если Фильтры <> Неопределено Тогда
		Если ТипЗнч(Фильтры) = Тип("Структура") Тогда
			Для Каждого КЗ Из Фильтры Цикл
				Если MCP_Security.ИмяБезопасноДляЗапроса(КЗ.Ключ)
					И MCP_Security.ПолеРазрешено(ПолноеИмя, КЗ.Ключ) Тогда
					Запрос.УстановитьПараметр("Filter_" + КЗ.Ключ,
						MCP_Values.ДекодироватьПараметр(КЗ.Значение));
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Фильтры) = Тип("Соответствие") Тогда
			Для Каждого КЗ Из Фильтры Цикл
				ИмяПоля = Строка(КЗ.Ключ);
				Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
					И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
					Запрос.УстановитьПараметр("Filter_" + ИмяПоля,
						MCP_Values.ДекодироватьПараметр(КЗ.Значение));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция СтруктураDate(Значение)

	// Идемпотентно: уже структурированное {kind, value} пропускаем как есть.
	// JSON-объекты могут прийти как Структура или Соответствие — учитываем оба варианта.
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Запас = Неопределено;
		Если Значение.Свойство("kind", Запас) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Если Значение.Получить("kind") <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("kind", "datetime");
	Стр.Вставить("value", Строка(Значение));
	Возврат Стр;

КонецФункции

Функция ТекущиеМиллисекундыUTC()
	Возврат (ТекущаяУниверсальнаяДата() - '19700101') * 1000;
КонецФункции

Функция РегистрИмеетПериод(ОМД)

	// Непериодический РегистрСведений не имеет реквизита Период в стандартных
	// реквизитах. Это самый надёжный универсальный признак.
	Попытка
		Возврат ОМД.СтандартныеРеквизиты.Найти("Период") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// ---- Движения документа ------------------------------------------

Функция ДвиженияДокумента(ТипДокумента, UUID, СписокРегистров, RowLimitPerRegister, IncludeEmpty, Курсор = "", RowCursor = "") Экспорт

	Если НЕ MCP_Security.ТипРазрешен(ТипДокумента) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Документ запрещён: " + ТипДокумента);
	КонецЕсли;

	СсылкаДокумента = MCP_Values.СсылкаПоТипуИUUID(ТипДокумента, UUID);

	Если СсылкаДокумента = Неопределено ИЛИ СсылкаДокумента.Пустая() Тогда
		Возврат Новый Структура("found, document, movements, truncated, next_cursor",
			Ложь, Null, Новый Массив, Ложь, Null);
	КонецЕсли;

	// Определяем потенциальные регистры.
	Если СписокРегистров = Неопределено ИЛИ ТипЗнч(СписокРегистров) <> Тип("Массив")
		ИЛИ СписокРегистров.Количество() = 0 Тогда
		СписокРегистров = СписокРегистраторовДляДокумента(ТипДокумента);
	КонецЕсли;

	Movements = Новый Массив;
	СмещениеРегистров = ЦелоеИзСтроки(Курсор, 0);
	Если СмещениеРегистров < 0 Тогда
		СмещениеРегистров = 0;
	КонецЕсли;
	ВсегоРегистров = СписокРегистров.Количество();
	// Размер страницы по регистрам — отдельная величина, не путать с лимитом строк
	// в каждом регистре. По умолчанию документ затрагивает единицы регистров,
	// поэтому берём общесерверный лимит max_register_rows как верхнюю границу.
	РегистровНаСтраницу = MCP_Config.Лимиты().max_register_rows;
	КонецРегистров = Мин(СмещениеРегистров + РегистровНаСтраницу, ВсегоРегистров);
	Если СмещениеРегистров < ВсегоРегистров Тогда
		Для ИндексРегистра = СмещениеРегистров По КонецРегистров - 1 Цикл
			ПолноеИмяРегистра = СписокРегистров[ИндексРегистра];
			Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ MCP_Security.ТипРазрешен(ПолноеИмяРегистра) Тогда
				Продолжить;
			КонецЕсли;
			Строки = ПрочитатьДвиженияРегистра(ПолноеИмяРегистра, СсылкаДокумента, RowLimitPerRegister, RowCursor);
			Если Строки.row_count = 0 И НЕ IncludeEmpty Тогда
				Продолжить;
			КонецЕсли;

			Стр = Новый Структура;
			Стр.Вставить("register", ПолноеИмяРегистра);
			Стр.Вставить("register_type", MCP_Security.ВидМетаданныхИзПолногоИмени(ПолноеИмяРегистра));
			Стр.Вставить("rows", Строки.rows);
			Стр.Вставить("row_count", Строки.row_count);
			Стр.Вставить("truncated", Строки.truncated);
			Стр.Вставить("next_row_cursor", Строки.next_cursor);
			Movements.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если КонецРегистров < ВсегоРегистров Тогда
		NextCursor = Строка(КонецРегистров);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("found", Истина);
	Результат.Вставить("document", MCP_Values.Кодировать(СсылкаДокумента));
	Результат.Вставить("movements", Movements);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("truncated", NextCursor <> Null);
	Возврат Результат;

КонецФункции

Функция СписокРегистраторовДляДокумента(ТипДокумента)

	Результат = Новый Массив;
	ИмяДокумента = MCP_Security.ИмяОбъектаИзПолногоИмени(ТипДокумента);
	ОМДДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если ОМДДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Регистр Из ОМДДокумента.Движения Цикл
		Вид = MCP_Metadata.ВидПоОбъектуМетаданных(Регистр);
		Если НЕ ПустаяСтрока(Вид) Тогда
			Результат.Добавить(Вид + "." + Регистр.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьДвиженияРегистра(ПолноеИмяРегистра, СсылкаДокумента, Лимит, Курсор = "")

	Поля = ПоляДляЧтенияДвиженийРегистра(ПолноеИмяРегистра);
	Текст = "ВЫБРАТЬ " + Поля + " ИЗ " + ПолноеИмяРегистра + " КАК Т ГДЕ Т.Регистратор = &Регистратор";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Регистратор", СсылкаДокумента);

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Возврат Новый Структура("rows, row_count, truncated, next_cursor", Новый Массив, 0, Ложь, Null);
	КонецПопытки;

	Строки = Новый Массив;
	Усечено = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Счетчик = 0;
	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	Пропущено = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Смещение Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		СтрокаJSON = Новый Структура;
		Для Каждого К Из РезультатЗапроса.Колонки Цикл
			СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(Выборка[К.Имя], ОпцииВалью));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Возврат Новый Структура("rows, row_count, truncated, next_cursor", Строки, Счетчик, Усечено, NextCursor);

КонецФункции

Функция ПоляДляЧтенияДвиженийРегистра(ПолноеИмяРегистра)

	Если MCP_Security.СкрытыеПоля(ПолноеИмяРегистра).Количество() = 0 Тогда
		Возврат "*";
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяРегистра);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Регистр не найден: " + ПолноеИмяРегистра);
	КонецЕсли;

	Поля = БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД);

	Если Поля.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
			"Не осталось разрешённых полей регистра после проверки.");
	КонецЕсли;

	Возврат СтрСоединить(Поля, ", ");

КонецФункции

Функция БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД)

	Поля = Новый Массив;
	Найденные = Новый Соответствие;
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "СтандартныеРеквизиты");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Измерения");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Ресурсы");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Реквизиты");
	Возврат Поля;

КонецФункции

Процедура ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, ИмяКоллекции)

	Попытка
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			Коллекция = ОМД.СтандартныеРеквизиты;
		ИначеЕсли ИмяКоллекции = "Измерения" Тогда
			Коллекция = ОМД.Измерения;
		ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
			Коллекция = ОМД.Ресурсы;
		ИначеЕсли ИмяКоллекции = "Реквизиты" Тогда
			Коллекция = ОМД.Реквизиты;
		Иначе
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Реквизит Из Коллекция Цикл
		ИмяПоля = Реквизит.Имя;
		Если Найденные.Получить(ИмяПоля) = Неопределено
			И MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
			И MCP_Security.ПолеРазрешено(ПолноеИмяРегистра, ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
			Найденные.Вставить(ИмяПоля, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
