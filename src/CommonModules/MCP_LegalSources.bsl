// MCP_LegalSources.bsl
// ====================================================================
// Реестр правовых источников и инструкции по работе с ними.
//
// ОБЯЗАТЕЛЬНАЯ политика: LLM-агент НЕ ищет правовую информацию через
// общий web search, поисковики, сторонние сайты и консультационные
// порталы. Разрешен только прямой доступ к URL источников из этого
// реестра после получения их инструкции через get_legal_source_guide.
// Если разрешенный источник недоступен или документ не найден, агент
// останавливается и сообщает, что проверка не выполнена: переходить к
// открытому веб-поиску даже как к fallback запрещено.
//
// Хранение (быстрый вариант): реестр зашит в модуль по образцу
// MCP_Knowledge_* — расширение самодостаточно, файлы с диска не читаются.
// Если в конфигурации существует регистр сведений MCP_ПравовыеИсточники
// (Измерение: Идентификатор (Строка); Ресурсы: Наименование, Статус,
// Области, ЕстьAPI (Булево), Примечание, Инструкция), его записи
// дополняют и переопределяют встроенный реестр без обновления расширения.
// Мастер-копия инструкций ведется вне 1С (Google Docs); текст в модуле —
// рабочая копия для рантайма.
// ====================================================================

// ---- Публичный API (вызывается из MCP_Tools_Impl) ------------------

Функция ИнструкцияДляАгента() Экспорт

	Возврат
		"ОБЯЗАТЕЛЬНАЯ ПОЛИТИКА ДЛЯ ЛЮБОЙ ПРАВОВОЙ ИНФОРМАЦИИ: "
		+ "сначала вызовите list_legal_sources, затем get_legal_source_guide для выбранного source_id "
		+ "и обращайтесь только напрямую к URL из полученной инструкции. "
		+ "Общий web search, поисковики, сниппеты, не включенные в реестр правовые сайты и консультационные порталы "
		+ "и пересказы запрещены, в том числе для проверки, дополнения и как fallback. "
		+ "Если разрешенный источник недоступен, не содержит документ или не покрывает вопрос, "
		+ "остановитесь, сообщите, что норма не проверена, и запросите уточнение или документ у пользователя. "
		+ "Не заменяйте источник знаниями модели. Это обязательный маршрут, а не рекомендация.";

КонецФункции

Функция ListLegalSources(Область = "") Экспорт

	Область = НРег(СокрЛП(Строка(Область)));

	Источники = Новый Массив;
	Для Каждого Источник Из ВсеИсточники() Цикл
		Если НЕ ПустаяСтрока(Область) И НЕ ПокрываетОбласть(Источник, Область) Тогда
			Продолжить;
		КонецЕсли;
		Источники.Добавить(ОписаниеДляСписка(Источник));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("sources", Источники);
	Результат.Вставить("total", Источники.Количество());
	Если НЕ ПустаяСтрока(Область) Тогда
		Результат.Вставить("area_filter", Область);
	КонецЕсли;
	Если Источники.Количество() = 0 Тогда
		Заметки = Новый Массив;
		Заметки.Добавить("По фильтру area источники не найдены. Вызовите list_legal_sources без фильтра и посмотрите coverage_areas.");
		Результат.Вставить("notes", Заметки);
	КонецЕсли;
	Результат.Вставить("policy", ПолитикаИсточников());
	Возврат Результат;

КонецФункции

Функция GetLegalSourceGuide(ИдентификаторИсточника) Экспорт

	ИскомыйИд = НРег(СокрЛП(Строка(ИдентификаторИсточника)));
	Если ПустаяСтрока(ИскомыйИд) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Параметр source_id обязателен. Идентификаторы источников возвращает list_legal_sources.");
	КонецЕсли;

	Найденный = Неопределено;
	Для Каждого Источник Из ВсеИсточники() Цикл
		Если НРег(Источник.id) = ИскомыйИд Тогда
			Найденный = Источник;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Найденный = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Неизвестный source_id: " + ИскомыйИд + ". Актуальный список идентификаторов возвращает list_legal_sources.");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("source_id", Найденный.id);
	Результат.Вставить("name", Найденный.name);
	Результат.Вставить("official_status", Найденный.official_status);
	Результат.Вставить("coverage_areas", Найденный.coverage_areas);
	Результат.Вставить("api_available", Найденный.api_available);
	Результат.Вставить("guide", Найденный.guide);
	Результат.Вставить("links", Найденный.links);
	Результат.Вставить("storage", Найденный.storage);
	Результат.Вставить("policy", ПолитикаИсточников());
	Возврат Результат;

КонецФункции

// ---- Реестр источников ---------------------------------------------

Функция ИмяРегистраИсточников()
	Возврат "MCP_ПравовыеИсточники";
КонецФункции

Функция ВсеИсточники()

	Источники = Новый Массив;
	Источники.Добавить(ИсточникPravoGovRu());
	Источники.Добавить(ИсточникPravoGovRuActual());
	ДополнитьИзРегистра(Источники);
	Возврат Источники;

КонецФункции

// Записи регистра сведений MCP_ПравовыеИсточники (если он создан в
// конфигурации) переопределяют встроенные источники с тем же
// идентификатором и добавляют новые. Ошибки чтения регистра не фатальны:
// сервер продолжает работать со встроенным реестром.
Процедура ДополнитьИзРегистра(Источники)

	Попытка
		МетаРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистраИсточников());
		Если МетаРегистр = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Т.Идентификатор КАК Идентификатор,
			|	Т.Наименование КАК Наименование,
			|	Т.Статус КАК Статус,
			|	Т.Области КАК Области,
			|	Т.ЕстьAPI КАК ЕстьAPI,
			|	Т.Примечание КАК Примечание,
			|	Т.Инструкция КАК Инструкция
			|ИЗ
			|	РегистрСведений." + ИмяРегистраИсточников() + " КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Ид = СокрЛП(Строка(Выборка.Идентификатор));
			Если ПустаяСтрока(Ид) Тогда
				Продолжить;
			КонецЕсли;

			Источник = НовыйИсточник(Ид,
				СокрЛП(Строка(Выборка.Наименование)),
				СокрЛП(Строка(Выборка.Статус)),
				МассивОбластей(Выборка.Области),
				Выборка.ЕстьAPI = Истина,
				СокрЛП(Строка(Выборка.Примечание)));
			Источник.guide = Строка(Выборка.Инструкция);
			Источник.storage = "register";

			ИндексЗамены = -1;
			Для Индекс = 0 По Источники.Количество() - 1 Цикл
				Если НРег(Источники[Индекс].id) = НРег(Ид) Тогда
					ИндексЗамены = Индекс;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ИндексЗамены >= 0 Тогда
				// Пустая инструкция в регистре не затирает встроенную.
				Если ПустаяСтрока(Источник.guide) Тогда
					Источник.guide = Источники[ИндексЗамены].guide;
					Источник.links = Источники[ИндексЗамены].links;
				КонецЕсли;
				Источники[ИндексЗамены] = Источник;
			Иначе
				Источники.Добавить(Источник);
			КонецЕсли;
		КонецЦикла;

	Исключение
		// Регистр отсутствует или его структура отличается от ожидаемой —
		// молча работаем со встроенным реестром.
	КонецПопытки;

КонецПроцедуры

Функция НовыйИсточник(Ид, Наименование, Статус, Области, ЕстьAPI, Примечание)

	Источник = Новый Структура;
	Источник.Вставить("id", Ид);
	Источник.Вставить("name", Наименование);
	Источник.Вставить("official_status", Статус);
	Источник.Вставить("coverage_areas", Области);
	Источник.Вставить("api_available", ЕстьAPI);
	Источник.Вставить("notes", Примечание);
	Источник.Вставить("guide", "");
	Источник.Вставить("links", Новый Структура);
	Источник.Вставить("storage", "embedded");
	Возврат Источник;

КонецФункции

Функция ОписаниеДляСписка(Источник)

	Описание = Новый Структура;
	Описание.Вставить("id", Источник.id);
	Описание.Вставить("name", Источник.name);
	Описание.Вставить("official_status", Источник.official_status);
	Описание.Вставить("coverage_areas", Источник.coverage_areas);
	Описание.Вставить("api_available", Источник.api_available);
	Описание.Вставить("notes", Источник.notes);
	Описание.Вставить("storage", Источник.storage);
	Возврат Описание;

КонецФункции

Функция ПокрываетОбласть(Источник, Область)

	Для Каждого Значение Из Источник.coverage_areas Цикл
		Если СтрНайти(НРег(Строка(Значение)), Область) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция МассивОбластей(Знач Текст)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Строка(Текст), ",", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если НЕ ПустаяСтрока(Часть) Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолитикаИсточников()

	Политика = Новый Структура;
	Политика.Вставить("internet_search_forbidden", Истина);
	Политика.Вставить("web_search_fallback_forbidden", Истина);
	Политика.Вставить("enforcement", "mandatory");
	Политика.Вставить("allowed_access_mode", "direct_to_registry_source_urls_only");
	Политика.Вставить("on_source_unavailable", "stop_and_report_unverified");

	ЗапрещенныеКаналы = Новый Массив;
	ЗапрещенныеКаналы.Добавить("general_web_search");
	ЗапрещенныеКаналы.Добавить("search_engines");
	ЗапрещенныеКаналы.Добавить("search_snippets");
	ЗапрещенныеКаналы.Добавить("unregistered_third_party_legal_sites");
	ЗапрещенныеКаналы.Добавить("consulting_portals");
	ЗапрещенныеКаналы.Добавить("unregistered_sources");
	Политика.Вставить("forbidden_channels", ЗапрещенныеКаналы);

	ОбязательныйМаршрут = Новый Массив;
	ОбязательныйМаршрут.Добавить("list_legal_sources");
	ОбязательныйМаршрут.Добавить("get_legal_source_guide");
	ОбязательныйМаршрут.Добавить("direct_request_to_guide_url");
	ОбязательныйМаршрут.Добавить("cite_source_document_and_card");
	Политика.Вставить("required_workflow", ОбязательныйМаршрут);
	Политика.Вставить("statement", ИнструкцияДляАгента());
	Возврат Политика;

КонецФункции

// ---- Встроенный источник: pravo.gov.ru ------------------------------

Функция ИсточникPravoGovRu()

	Области = Новый Массив;
	Области.Добавить("федеральное законодательство");
	Области.Добавить("региональное законодательство");
	Области.Добавить("труд");
	Области.Добавить("налоги");
	Области.Добавить("гражданское право");
	Области.Добавить("административное право");
	Области.Добавить("уголовное право");
	Области.Добавить("корпоративное право");
	Области.Добавить("госзакупки");
	Области.Добавить("международные договоры");

	Источник = НовыйИсточник("pravo_gov_ru",
		"Официальный интернет-портал правовой информации, раздел «Официальное опубликование» (publication.pravo.gov.ru)",
		"Официальный источник опубликования правовых актов РФ (юридически значимая публикация)",
		Области,
		Истина,
		"Открытый REST API без аутентификации. Тексты документов — только PDF. "
		+ "Это лента официального опубликования: актуальные консолидированные редакции кодексов здесь не собрать.");

	Ссылки = Новый Структура;
	Ссылки.Вставить("portal", "http://publication.pravo.gov.ru");
	Ссылки.Вставить("api_base", "http://publication.pravo.gov.ru/api");
	Ссылки.Вставить("api_help", "http://publication.pravo.gov.ru/help");
	Ссылки.Вставить("document_card_template", "http://publication.pravo.gov.ru/document/{eoNumber}");
	Ссылки.Вставить("document_pdf_template", "http://publication.pravo.gov.ru/file/pdf?eoNumber={eoNumber}");
	Источник.links = Ссылки;

	Источник.guide = ИнструкцияPravoGovRu();
	Возврат Источник;

КонецФункции

Функция ИнструкцияPravoGovRu()

	Текст =
	"ИСТОЧНИК: Официальный интернет-портал правовой информации — раздел «Официальное опубликование» (publication.pravo.gov.ru).
	|
	|ЧТО ЭТО И ЗАЧЕМ.
	|Это государственный портал, на котором правовые акты РФ публикуются официально: указы Президента, федеральные законы,
	|постановления Правительства, акты федеральных министерств и ведомств, акты субъектов РФ, решения Конституционного Суда,
	|международные договоры. Публикация здесь юридически значима, поэтому на найденный документ можно ссылаться в ответе клиенту.
	|Запомни главное: это лента опубликования, а не справочная система. Здесь ты найдешь акт в той редакции, в которой он был
	|подписан и опубликован. Собирать «действующую редакцию» Трудового или Налогового кодекса по этой ленте нельзя — для
	|актуальных (консолидированных) редакций используй источник pravo_gov_ru_actual из list_legal_sources.
	|
	|ДОСТУП И АУТЕНТИФИКАЦИЯ.
	|REST API открыт, ключей и логинов не нужно, только чтение. Базовый адрес: http://publication.pravo.gov.ru/api
	|Работай по http — https у портала недоступен из многих сред. Ответы приходят в JSON (UTF-8).
	|
	|С ЧЕГО НАЧАТЬ: СПРАВОЧНИКИ.
	|Поиск станет точным, если сначала взять идентификаторы из справочников:
	|1. GET /api/PublicBlocks — блоки публикации. Коды блоков: president (Президент), assembly (Федеральное Собрание),
	|   government (Правительство), federal_authorities (ФОИВ и ФГО), court (судебные акты), subjects (ОГВ субъектов РФ),
	|   international (международные договоры), un_securitycouncil (Совбез ООН). Подблоки: /api/PublicBlocks?parent=assembly
	|2. GET /api/SignatoryAuthorities?block=government — принявшие органы, в ответе GUID органа.
	|3. GET /api/DocumentTypes?SignatoryAuthorityId={GUID} — виды документов органа (Постановление, Распоряжение...), тоже GUID.
	|4. GET /api/Categories?block=subjects — категории принявших органов (нужно в основном для блока субъектов РФ).
	|
	|ПОИСК ДОКУМЕНТОВ: GET /api/Documents.
	|Все параметры необязательны и комбинируются:
	|- Block — код блока публикации (см. выше);
	|- SignatoryAuthorityId — GUID принявшего органа; DocumentTypeId — GUID вида документа;
	|- Name — поиск по названию; ComplexName — по составному названию (вид + дата + номер + орган);
	|- DocumentText — поиск по тексту документа;
	|- Number плюс NumberSearchType (0 — точно, 1 — начинается с, 2 — заканчивается на, 3 — содержит) — поиск по номеру акта;
	|- DocumentDateFrom / DocumentDateTo — период по дате подписания; PublishDateFrom / PublishDateTo — по дате опубликования;
	|- PeriodType=daily|weekly|monthly — опубликованное сегодня / за неделю / за месяц; PeriodType=day плюс Date=... — за конкретный день;
	|- JdRegNumber, JdRegDateFrom, JdRegDateTo — номер и даты регистрации в Минюсте;
	|- PageSize — строго 10, 30, 100 или 200; Index — номер страницы (с 1);
	|- SortedBy (0 — дата подписания, 1 — вид, 2 — орган, 3 — номер, 4 — дата опубликования, 5 — номер опубликования) и SortDestination.
	|Пример: /api/Documents?Block=government&Name=налог&DocumentDateFrom=01.01.2026&PageSize=30&Index=1
	|В ответе: items[] (документы) плюс itemsTotalCount, pagesTotalCount, currentPage — по ним листай страницы.
	|
	|КАК ЧИТАТЬ РЕЗУЛЬТАТ.
	|Ключевые поля документа: eoNumber — номер электронного опубликования, главный идентификатор, сохраняй его всегда;
	|complexName — полное название с видом, датой, номером и органом (им и цитируй документ);
	|name, number, documentDate (дата подписания), publishDateShort/viewDate (дата опубликования);
	|jdRegNumber/jdRegDate — регистрация в Минюсте (для ведомственных актов ее наличие — признак вступившего в силу акта);
	|pagesCount, pdfFileLength — размер PDF. Расширенная карточка одного документа: GET /api/Document?eoNumber={eoNumber}
	|
	|ССЫЛКИ ДЛЯ ПОЛЬЗОВАТЕЛЯ.
	|Карточка документа (ее и вставляй в ответ): http://publication.pravo.gov.ru/document/{eoNumber}
	|Прямая ссылка на PDF с текстом: http://publication.pravo.gov.ru/file/pdf?eoNumber={eoNumber}
	|
	|ОГРАНИЧЕНИЯ И ПОДВОДНЫЕ КАМНИ.
	|1. Текст акта API не возвращает — только PDF по ссылке выше. Параметр DocumentText ищет по тексту, но в ответе все равно карточки.
