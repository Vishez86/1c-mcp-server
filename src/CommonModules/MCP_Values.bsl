// MCP_Values.bsl
// ====================================================================
// Кодирование значений 1С в JSON-совместимые структуры и обратно.
// Используется во всех tools для унифицированного представления данных.
// ====================================================================

// Кодирует значение 1С в JSON-совместимое значение.
//
// Опции (Структура):
//   include_navigation_url   : Булево, по умолчанию Истина
//   binary_as_base64         : Булево, по умолчанию Ложь
//   max_string_length        : Число, ограничение длины строк
//   value_storage_metadata   : Булево, по умолчанию Истина
//
Функция Кодировать(Значение, Опции = Неопределено) Экспорт

	Если Опции = Неопределено Тогда
		Опции = ОпцииПоУмолчанию();
	КонецЕсли;

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Null;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Тогда
		МаксД = Опции.max_string_length;
		Если МаксД > 0 И СтрДлина(Значение) > МаксД Тогда
			Возврат Лев(Значение, МаксД) + "...[truncated]";
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;

	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	// Перечисления.
	ОбъектМД = Неопределено;
	Попытка
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Исключение
		ОбъектМД = Неопределено;
	КонецПопытки;

	Если ОбъектМД <> Неопределено И ОбъектМД.Родитель() = Метаданные.Перечисления Тогда

		Если Значение.Пустая() Тогда
			Возврат Null;
		КонецЕсли;

		// ЗначенияПеречисления.Найти() ищет по имени-строке, а не по ссылке.
		// Корректный путь: через индекс значения у менеджера перечисления.
		ИмяЗначения = "";
		Попытка
			Индекс = Перечисления[ОбъектМД.Имя].Индекс(Значение);
			Если Индекс >= 0 И Индекс < ОбъектМД.ЗначенияПеречисления.Количество() Тогда
				ИмяЗначения = ОбъектМД.ЗначенияПеречисления[Индекс].Имя;
			КонецЕсли;
		Исключение
			ИмяЗначения = "";
		КонецПопытки;

		Стр = Новый Структура;
		Стр.Вставить("type", "Перечисление." + ОбъектМД.Имя);
		Стр.Вставить("name", ИмяЗначения);
		Стр.Вставить("presentation", Строка(Значение));
		Возврат Стр;
	КонецЕсли;

	// Ссылки.
	ОписаниеТипаСсылки = ОписаниеСсылочногоТипа(Значение);
	Если ОписаниеТипаСсылки <> Неопределено Тогда
		Возврат КодироватьСсылку(Значение, ОписаниеТипаСсылки, Опции);
	КонецЕсли;

	// Массив.
	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Кодировать(Элемент, Опции));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Структура / Соответствие.
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КЗ Из Значение Цикл
			Результат.Вставить(КЗ.Ключ, Кодировать(КЗ.Значение, Опции));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		// Ключи Соответствия могут содержать пробелы, точки, начинаться с цифры и т.п. —
		// такие ключи Структура.Вставить отвергает с исключением. JSON-сериализатор 1С
		// корректно работает и с Соответствием, поэтому возвращаем именно его, чтобы
		// один «нестандартный» ключ не валил весь tool-вызов.
		Результат = Новый Соответствие;
		Для Каждого КЗ Из Значение Цикл
			Результат.Вставить(Строка(КЗ.Ключ), Кодировать(КЗ.Значение, Опции));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Таблица значений.
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат КодироватьТаблицуЗначений(Значение, Опции);
	КонецЕсли;

	// ХранилищеЗначения — не раскрываем содержимое.
	Если ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Стр = Новый Структура;
		Стр.Вставить("type", "ХранилищеЗначения");
		Стр.Вставить("has_value", Истина);
		Возврат Стр;
	КонецЕсли;

	// ДвоичныеДанные — по умолчанию опускаем.
	Если ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Если Опции.binary_as_base64 Тогда
			Возврат Base64Строка(Значение);
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("type", "ДвоичныеДанные");
		Стр.Вставить("size", Значение.Размер());
		Возврат Стр;
	КонецЕсли;

	// По умолчанию — представление.
	Возврат Строка(Значение);

КонецФункции

Функция ОпцииПоУмолчанию() Экспорт

	Стр = Новый Структура;
	Стр.Вставить("include_navigation_url", Истина);
	Стр.Вставить("binary_as_base64", Ложь);
	Стр.Вставить("max_string_length", MCP_Config.Лимиты().max_string_length_in_response);
	Стр.Вставить("value_storage_metadata", Истина);
	Возврат Стр;

КонецФункции

Функция КодироватьСсылку(Значение, ОписаниеТипа, Опции)

	Если Значение.Пустая() Тогда
		Возврат Null;
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("type", ОписаниеТипа);
	Стр.Вставить("uuid", Строка(Значение.УникальныйИдентификатор()));
	Стр.Вставить("presentation", Строка(Значение));

	Если Опции.include_navigation_url Тогда
		Попытка
			Стр.Вставить("navigation_url", ПолучитьНавигационнуюСсылку(Значение));
		Исключение
			// Не критично, не добавляем.
		КонецПопытки;
	КонецЕсли;

	Возврат Стр;

КонецФункции

Функция ОписаниеСсылочногоТипа(Значение)

	Попытка
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ОбъектМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Родитель = ОбъектМД.Родитель();
	Если Родитель = Метаданные.Справочники Тогда
		Возврат "Справочник." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.Документы Тогда
		Возврат "Документ." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.ПланыВидовХарактеристик Тогда
		Возврат "ПланВидовХарактеристик." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.ПланыСчетов Тогда
		Возврат "ПланСчетов." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.ПланыВидовРасчета Тогда
		Возврат "ПланВидовРасчета." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.ПланыОбмена Тогда
		Возврат "ПланОбмена." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.БизнесПроцессы Тогда
		Возврат "БизнесПроцесс." + ОбъектМД.Имя;
	ИначеЕсли Родитель = Метаданные.Задачи Тогда
		Возврат "Задача." + ОбъектМД.Имя;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция КодироватьТаблицуЗначений(Таблица, Опции)

	// Имена колонок в СКД-отчётах могут содержать пробелы и спецсимволы —
	// тогда они непригодны в качестве ключей Структуры. Используем Соответствие.
	//
	// Дополнительно: в СКД встречаются повторяющиеся имена колонок (например,
	// "Количество" в разных группировках). Если просто использовать Колонка.Имя
	// в качестве ключа, второе значение перетрёт первое. Поэтому для дубликатов
	// добавляем суффикс "#N" — клиент при необходимости сможет восстановить
	// соответствие по массиву columns, где сохранён оригинальный порядок.
	КлючиКолонок = Новый Массив;
	СчетчикДубликатов = Новый Соответствие;
	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ОригИмя = Колонка.Имя;
		Счет = СчетчикДубликатов.Получить(ОригИмя);
		Если Счет = Неопределено Тогда
			Счет = 0;
		КонецЕсли;
		Счет = Счет + 1;
		СчетчикДубликатов.Вставить(ОригИмя, Счет);

		Ключ = ?(Счет = 1, ОригИмя, ОригИмя + "#" + Счет);
		КлючиКолонок.Добавить(Ключ);

		КС = Новый Структура;
		КС.Вставить("name", ОригИмя);
		КС.Вставить("key", Ключ);
		КС.Вставить("type_description", ОписаниеТипаКолонки(Колонка));
		Колонки.Добавить(КС);
	КонецЦикла;

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаJSON = Новый Соответствие;
		Индекс = 0;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаJSON.Вставить(КлючиКолонок[Индекс], Кодировать(СтрокаТаблицы[Колонка.Имя], Опции));
			Индекс = Индекс + 1;
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Возврат Результат;

КонецФункции

Функция ОписаниеТипаКолонки(Колонка)

	Если Колонка.ТипЗначения = Неопределено Тогда
		Возврат "Произвольный";
	КонецЕсли;
	Возврат Строка(Колонка.ТипЗначения);

КонецФункции

// ---- Декодирование QueryParameterValue -> значение 1С ---------------

Функция ДекодироватьПараметр(ЗначениеПараметра) Экспорт

	Если ЗначениеПараметра = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// JSON-объекты могут прийти как Структура или Соответствие в зависимости от
	// настроек ПрочитатьJSON. Всё, что не контейнер с маркером kind, — оставляем как есть.
	Если НЕ ЭтоОбъектСМаркером(ЗначениеПараметра) Тогда
		Возврат ЗначениеПараметра;
	КонецЕсли;

	Kind = НРег(Строка(ПолучитьПоле(ЗначениеПараметра, "kind", "")));
	Значение = ПолучитьПоле(ЗначениеПараметра, "value", Неопределено);

	Если Kind = "null" ИЛИ Kind = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Kind = "string" Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	Если Kind = "number" Тогда
		Возврат Число(Значение);
	КонецЕсли;

	Если Kind = "boolean" Тогда
		Возврат ПривестиКБулеву(Значение);
	КонецЕсли;

	Если Kind = "date" ИЛИ Kind = "datetime" Тогда
		Возврат РазобратьISO8601(Строка(Значение));
	КонецЕсли;

	Если Kind = "uuid" Тогда
		Возврат Новый УникальныйИдентификатор(Строка(Значение));
	КонецЕсли;

	Если Kind = "ref" Тогда
		ТипРеф = ПолучитьПоле(ЗначениеПараметра, "type", "");
		UUID = ПолучитьПоле(ЗначениеПараметра, "uuid", "");
		Возврат СсылкаПоТипуИUUID(Строка(ТипРеф), Строка(UUID));
	КонецЕсли;

	Если Kind = "enum" Тогда
		ТипРеф = ПолучитьПоле(ЗначениеПараметра, "type", "");
		ИмяЗначения = ПолучитьПоле(ЗначениеПараметра, "name", "");
		Возврат ПеречислениеПоИмени(Строка(ТипРеф), Строка(ИмяЗначения));
	КонецЕсли;

	Если Kind = "array" Тогда
		Результат = Новый Массив;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Эл Из Значение Цикл
				Результат.Добавить(ДекодироватьПараметр(Эл));
			КонецЦикла;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// Fallback.
	Возврат Значение;

КонецФункции

// Истина, если значение — Структура/Соответствие, содержащее ключ kind.
// Любые другие контейнеры (массив, простые значения) трактуем как обычное значение,
// чтобы случайно не «развернуть» произвольный JSON-объект как маркер.
Функция ЭтоОбъектСМаркером(Значение)

	Если ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Запас = Неопределено;
		Возврат Значение.Свойство("kind", Запас);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Возврат Значение.Получить("kind") <> Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПолучитьПоле(Объект, Имя, ПоУмолчанию)

	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция СсылкаПоТипуИUUID(ПолноеИмя, UUID) Экспорт

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя ссылочного типа: " + ПолноеИмя);
	КонецЕсли;

	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_TypeNotAllowed(),
			"Тип запрещён allowlist: " + ПолноеИмя);
	КонецЕсли;

	Менеджер = MCP_Metadata.МенеджерПоТипу(ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_MetadataNotFound(),
			"Неизвестный или неподдерживаемый тип: " + ПолноеИмя);
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(UUID);
	Исключение
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_InvalidArguments(),
			"Некорректный UUID: " + UUID);
	КонецПопытки;

	Возврат Менеджер.ПолучитьСсылку(УИД);

КонецФункции

Функция ПеречислениеПоИмени(ПолноеИмя, ИмяЗначения) Экспорт

	Если НЕ СтрНачинаетсяС(ПолноеИмя, "Перечисление.") Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_TypeNotAllowed(),
			"Ожидается тип Перечисление.<Имя>: " + ПолноеИмя);
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_TypeNotAllowed(),
			"Перечисление запрещено allowlist: " + ПолноеИмя);
	КонецЕсли;

	ИмяПеречисления = Сред(ПолноеИмя, СтрДлина("Перечисление.") + 1);
	Если НЕ MCP_Security.ИмяБезопасноДляЗапроса(ИмяПеречисления) Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя перечисления: " + ИмяПеречисления);
	КонецЕсли;
	Если НЕ MCP_Security.ИмяБезопасноДляЗапроса(ИмяЗначения) Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя значения перечисления: " + ИмяЗначения);
	КонецЕсли;

	ОМД = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_MetadataNotFound(),
			"Перечисление не найдено: " + ПолноеИмя);
	КонецЕсли;
	Если ОМД.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(
			MCP_Errors.Код_InvalidArguments(),
			"Значение перечисления не найдено: " + ИмяПеречисления + "." + ИмяЗначения);
	КонецЕсли;

	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];

КонецФункции

Функция РазобратьISO8601(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;

	// Поддержка YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS, с/без таймзоны.
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		// Альтернатива.
	КонецПопытки;

	Чистая = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), ":", ""), "T", ""), "Z", "");
	Если СтрДлина(Чистая) = 8 Тогда
		Чистая = Чистая + "000000";
	КонецЕсли;
	Если СтрДлина(Чистая) >= 14 Тогда
		Возврат Дата(Лев(Чистая, 14));
	КонецЕсли;
	Возврат '00010101';

КонецФункции

Функция ПривестиКБулеву(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Значение)));
	Возврат Текст = "true"
		ИЛИ Текст = "истина"
		ИЛИ Текст = "1"
		ИЛИ Текст = "yes"
		ИЛИ Текст = "да";

КонецФункции
