// MCP_History.bsl
// ====================================================================
// История объекта: версионирование, журнал регистрации.
// Если механизмы недоступны — возвращает supported=false без ошибки.
// ====================================================================

Функция ПолучитьИсторию(Тип, UUID, Mode, ПериодОт, ПериодДо, IncludeDiff, Лимит, Курсор = "") Экспорт

	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Тип запрещён: " + Тип);
	КонецЕсли;

	Ссылка = MCP_Values.СсылкаПоТипуИUUID(Тип, UUID);
	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Возврат Новый Структура("supported, target, events, truncated, next_cursor, capabilities",
			Истина, Null, Новый Массив, Ложь, Null, ВозможностиИстории());
	КонецЕсли;

	События = Новый Массив;
	Capabilities = ВозможностиИстории();
	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	ЛимитЧтения = Смещение + Лимит + 1;

	Если Mode = "auto" ИЛИ Mode = "event_log" Тогда
		ЗаписиЖР = ПрочитатьЖурналРегистрации(Ссылка, ПериодОт, ПериодДо, ЛимитЧтения);
		Для Каждого З Из ЗаписиЖР Цикл
			События.Добавить(З);
		КонецЦикла;
	КонецЕсли;

	// Версионирование (если включено).
	Если (Mode = "auto" ИЛИ Mode = "versions") И Capabilities.versions Тогда
		ЗаписиВерсий = ПрочитатьВерсии(Ссылка, ПериодОт, ПериодДо, ЛимитЧтения, IncludeDiff);
		Для Каждого З Из ЗаписиВерсий Цикл
			События.Добавить(З);
		КонецЦикла;
	КонецЕсли;

	СтраницаСобытий = Новый Массив;
	Конец = Мин(Смещение + Лимит, События.Количество());
	Если Смещение < События.Количество() Тогда
		Для Индекс = Смещение По Конец - 1 Цикл
			СтраницаСобытий.Добавить(События[Индекс]);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если Конец < События.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("supported", События.Количество() > 0 ИЛИ Capabilities.versions ИЛИ Capabilities.event_log);
	Результат.Вставить("target", MCP_Values.Кодировать(Ссылка));
	Результат.Вставить("events", СтраницаСобытий);
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("capabilities", Capabilities);
	Возврат Результат;

КонецФункции

Функция ВозможностиИстории()

	Стр = Новый Структура;
	Стр.Вставить("versions", Метаданные.ОбщиеМодули.Найти("ВерсионированиеОбъектовСлужебный") <> Неопределено);
	Стр.Вставить("event_log", Истина);
	Стр.Вставить("diff", Ложь);
	Возврат Стр;

КонецФункции

Функция ПрочитатьЖурналРегистрации(Ссылка, ПериодОт, ПериодДо, Лимит)

	Результат = Новый Массив;
	Попытка
		Отбор = Новый Структура;
		Отбор.Вставить("Данные", Ссылка);
		Если ПериодОт <> Неопределено Тогда
			Отбор.Вставить("ДатаНачала", РазобратьДату(ПериодОт));
		КонецЕсли;
		Если ПериодДо <> Неопределено Тогда
			Отбор.Вставить("ДатаОкончания", РазобратьДату(ПериодДо));
		КонецЕсли;

		ТаблицаЖР = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТаблицаЖР, Отбор, , , Лимит);

		Для Каждого Стр Из ТаблицаЖР Цикл
			Событие = Новый Структура;
			Событие.Вставить("timestamp", Формат(Стр.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Событие.Вставить("user", Строка(Стр.ИмяПользователя));
			Событие.Вставить("event_type", Строка(Стр.Событие));
			Событие.Вставить("description", Строка(Стр.Комментарий));
			Событие.Вставить("diff", Null);
			Результат.Добавить(Событие);
		КонецЦикла;
	Исключение
		// Журнал недоступен — возвращаем пустой массив.
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПрочитатьВерсии(Ссылка, ПериодОт, ПериодДо, Лимит, IncludeDiff)

	Результат = Новый Массив;
	// Попытка использовать БСП-подсистему версионирования.
	Попытка
		Если Метаданные.ОбщиеМодули.Найти("ВерсионированиеОбъектовСлужебный") <> Неопределено Тогда
			// В разных конфигурациях интерфейс может отличаться. Здесь — заглушка.
			// Можно вызвать через ОбщегоНазначения.ВычислитьВБезопасномРежиме / Вычислить.
		КонецЕсли;
	Исключение
		// Нет версионирования.
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция РазобратьДату(Текст)
	Возврат XMLЗначение(Тип("Дата"), Текст);
КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции
