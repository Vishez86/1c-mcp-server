// MCP_Audit.bsl
// ====================================================================
// Аудит вызовов MCP-сервера.
// Пишет в журнал регистрации события "MCP.<tool>.success" и "MCP.<tool>.error".
//
// ЗАПРЕТ ДАННЫХ В ЖУРНАЛЕ (требование 14.08.2026). Журнал регистрации не
// должен содержать персональных и коммерческих данных. Значения в него не
// попадают НИ ОДНИМ путём: ни из результата (только счётчики сводки), ни из
// аргументов (только имена ключей и размеры), ни из текста ошибки (только код).
//
// Privacy-маскирование этот запрет обеспечить не может и не могло: оно
// адресовано значениям полей закрытых типов в ОТВЕТЕ, а аргументы вызова —
// это текст, в котором нет ни типов, ни полей. Рубильник privacy.enabled на
// запись в журнал тоже не влияет. Поэтому запрет держится здесь, в писателе.
// ====================================================================

Процедура ЗаписатьУспех(CorrelationID, ИмяТула, Аргументы, Результат, ДлительностьМс = Неопределено,
	ЗамерСтадий = Неопределено) Экспорт

	Сообщение = СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, Результат, Истина, ДлительностьМс,
		ЗамерСтадий);
	ЗаписьЖурналаРегистрации(
		"MCP." + ИмяТула + ".success",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Сообщение);

КонецПроцедуры

Процедура ЗаписатьОшибку(CorrelationID, ИмяТула, Аргументы, Ошибка, ДлительностьМс = Неопределено, Уровень = Неопределено,
	ЗамерСтадий = Неопределено) Экспорт

	Сообщение = СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, Ошибка, Ложь, ДлительностьМс,
		ЗамерСтадий);
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;
	ЗаписьЖурналаРегистрации(
		"MCP." + ИмяТула + ".error",
		Уровень,
		,
		,
		Сообщение);

КонецПроцедуры

// Запись о полном жизненном цикле входящего HTTP POST /rpc.
// Тело и заголовки намеренно не сохраняются: в них могут быть персональные данные и секреты.
Процедура ЗаписатьHTTPЗапрос(КодСостояния, ДлительностьМс, Исход, РазмерТелаСимволов = Неопределено, МетодHTTP = "POST",
	ЗамерСтадий = Неопределено, РазмерОтветаСимволов = Неопределено) Экспорт

	ДанныеЛога = Новый Структура;
	ДанныеЛога.Вставить("kind", "http_request");
	ДанныеЛога.Вставить("http_method", МетодHTTP);
	ДанныеЛога.Вставить("http_status", КодСостояния);
	ДанныеЛога.Вставить("duration_ms", ДлительностьМс);
	ДанныеЛога.Вставить("outcome", Исход);
	ДанныеЛога.Вставить("user", ИмяТекущегоПользователя());
	ДанныеЛога.Вставить("timestamp", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Если РазмерТелаСимволов <> Неопределено Тогда
		ДанныеЛога.Вставить("request_chars", РазмерТелаСимволов);
	КонецЕсли;
	Если РазмерОтветаСимволов <> Неопределено Тогда
		ДанныеЛога.Вставить("response_chars", РазмерОтветаСимволов);
	КонецЕсли;
	ДобавитьСтадииВСообщение(ДанныеЛога, ЗамерСтадий);

	Уровень = УровеньЖурналаРегистрации.Информация;
	Если КодСостояния >= 500 Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Исход = "origin_rejected"
		ИЛИ Исход = "protocol_version_rejected"
		ИЛИ Исход = "empty_body"
		ИЛИ (КодСостояния >= 400 И Исход <> "method_not_allowed") Тогда
		// Список исходов перечислен явно, но 4xx остаётся полом предупреждения:
		// исход, добавленный позже и забытый в этом перечислении, иначе молча
		// уехал бы в «Информацию». Исключение одно — штатный 405 на GET/DELETE,
		// которым Streamable HTTP отвечает по контракту, а не из-за ошибки.
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("MCP.http_request", Уровень, , , СтрокаJSON(ДанныеЛога));

КонецПроцедуры

// Единый источник времени для измерения длительности без зависимости от часового пояса сеанса.
Функция ТекущиеМиллисекундыUTC() Экспорт
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

// ====================================================================
// Замер стадий вызова (профилирование обвязки, ТЗ perf_tool_overhead R-6).
//
// Коллектор — обычная Структура { last_ms, stages, counters }, создаётся здесь
// и передаётся по слоям вызова (HTTP → JSON-RPC → диспетчер → движок запроса).
// Каждый слой закрывает свои стадии ОтметитьСтадию; готовая разбивка пишется
// в существующие события аудита полями stages (мс) и counters (штуки/мс деталей)
// и читается наружу инструментом get_audit_log. В ответ инструмента разбивка
// НЕ выносится — контракт ответа не меняется (R-4), журнал для чтения уже есть.
//
// Правило имён: стадии слоя вызова инструмента — плоские (access_check,
// tool_impl, ...); стадии внутри движка запроса — с префиксом q_ и в сумме
// входят в tool_impl; стадии транспортного слоя — с префиксами http_/rpc_.
// Счётчик с суффиксом _ms — это длительность-деталь, она пересекается со
// стадией-родителем (q_ref_presentation_ms ⊂ q_encode_rows) и в сумму стадий
// не входит.
//
// Вызывающие модули обязаны звать эти функции через Попытку с no-op-фолбэком:
// частичная публикация со старым MCP_Audit не должна ронять запрос — теряется
// только разбивка.
// ====================================================================

Функция НовыйЗамерСтадий() Экспорт

	Замер = Новый Структура;
	Замер.Вставить("last_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Замер.Вставить("stages", Новый Структура);
	Замер.Вставить("counters", Новый Структура);
	Возврат Замер;

КонецФункции

// Закрывает стадию: длительность — от предыдущей отметки (или создания замера)
// до текущего момента. Повторная стадия с тем же именем суммируется.
Процедура ОтметитьСтадию(Замер, Знач ИмяСтадии) Экспорт

	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДобавитьСтадию(Замер, ИмяСтадии, Сейчас - Замер.last_ms);
	Замер.last_ms = Сейчас;

КонецПроцедуры

// Сдвигает точку отсчёта без записи стадии — пропустить участок, который
// уже измерен другим слоем или измерению не подлежит.
Процедура СброситьОтсчетСтадий(Замер) Экспорт

	Если Замер <> Неопределено Тогда
		Замер.last_ms = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;

КонецПроцедуры

// Явное добавление длительности — для стадий, измеренных собственным таймером
// (например, q_db_execute уже измеряется для duration_ms ответа).
Процедура ДобавитьСтадию(Замер, Знач ИмяСтадии, Знач Мс) Экспорт

	Если Замер = Неопределено ИЛИ ТипЗнч(Мс) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	Накоплено = 0;
	Если НЕ Замер.stages.Свойство(ИмяСтадии, Накоплено) Тогда
		Накоплено = 0;
	КонецЕсли;
	Замер.stages.Вставить(ИмяСтадии, Накоплено + Мс);

КонецПроцедуры

Процедура ДобавитьСчётчик(Замер, Знач Имя, Знач Прирост) Экспорт

	Если Замер = Неопределено ИЛИ ТипЗнч(Прирост) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	Накоплено = 0;
	Если НЕ Замер.counters.Свойство(Имя, Накоплено) Тогда
		Накоплено = 0;
	КонецЕсли;
	Замер.counters.Вставить(Имя, Накоплено + Прирост);

КонецПроцедуры

// Снимок наполнения замера для передачи между слоями (например, служебным
// ключом _perf из результата движка запроса в замер вызова инструмента).
// Пустой замер отдаёт Неопределено — нечего переносить и нечего писать.
Функция СтадииИСчётчикиЗамера(Замер) Экспорт

	Если Замер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Замер.stages.Количество() = 0 И Замер.counters.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("stages, counters", Замер.stages, Замер.counters);

КонецФункции

// Переносит стадии и счётчики вложенного снимка (СтадииИСчётчикиЗамера) в замер.
Процедура ПрисоединитьЗамер(Замер, Знач Вложенный) Экспорт

	Если Замер = Неопределено ИЛИ ТипЗнч(Вложенный) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	СтадииВложенного = Неопределено;
	Если Вложенный.Свойство("stages", СтадииВложенного) И ТипЗнч(СтадииВложенного) = Тип("Структура") Тогда
		Для Каждого КЗ Из СтадииВложенного Цикл
			ДобавитьСтадию(Замер, КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	СчётчикиВложенного = Неопределено;
	Если Вложенный.Свойство("counters", СчётчикиВложенного) И ТипЗнч(СчётчикиВложенного) = Тип("Структура") Тогда
		Для Каждого КЗ Из СчётчикиВложенного Цикл
			ДобавитьСчётчик(Замер, КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Кладёт непустые stages/counters замера в сообщение события аудита.
Процедура ДобавитьСтадииВСообщение(Структ, Знач Замер)

	Если Замер = Неопределено ИЛИ ТипЗнч(Замер) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	СтадииЗамера = Неопределено;
	Если Замер.Свойство("stages", СтадииЗамера) И ТипЗнч(СтадииЗамера) = Тип("Структура")
		И СтадииЗамера.Количество() > 0 Тогда
		Структ.Вставить("stages", СтадииЗамера);
	КонецЕсли;
	СчётчикиЗамера = Неопределено;
	Если Замер.Свойство("counters", СчётчикиЗамера) И ТипЗнч(СчётчикиЗамера) = Тип("Структура")
		И СчётчикиЗамера.Количество() > 0 Тогда
		Структ.Вставить("counters", СчётчикиЗамера);
	КонецЕсли;

КонецПроцедуры

Функция СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, ДанныеРезультата, Успех, ДлительностьМс = Неопределено,
	ЗамерСтадий = Неопределено)

	Структ = Новый Структура;
	Структ.Вставить("correlation_id", Строка(CorrelationID));
	Структ.Вставить("tool", ИмяТула);
	Структ.Вставить("user", ИмяТекущегоПользователя());
	Структ.Вставить("timestamp", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Структ.Вставить("success", Успех);
	Если ДлительностьМс <> Неопределено Тогда
		Структ.Вставить("duration_ms", ДлительностьМс);
	КонецЕсли;
	ДобавитьСтадииВСообщение(Структ, ЗамерСтадий);

	Если Успех Тогда
		Структ.Вставить("summary", СводкаРезультата(ДанныеРезультата));
	Иначе
		Структ.Вставить("error", КодОшибкиДляЖурнала(ДанныеРезультата));
	КонецЕсли;

	Структ.Вставить("arguments", МетрикиАргументов(Аргументы));

	Возврат СтрокаJSON(Структ);

КонецФункции

// Из ошибки в журнал идёт ТОЛЬКО код. Ни message, ни details: сообщения
// платформы цитируют фрагмент упавшего запроса, а details у ошибки выполнения
// несёт query_original и query_effective — то есть текст запроса целиком, со
// всеми литералами. Клиенту эти поля по-прежнему возвращаются в ответе: там это
// его собственный запрос, а журнал читают все.
//
// Форма {code: ...} сохранена намеренно: ПрочитатьТайминги достаёт error_code
// именно из неё, и записи прежних ревизий читаются тем же кодом.
Функция КодОшибкиДляЖурнала(Ошибка)

	Результат = Новый Структура;
	Код = "";

	Если ТипЗнч(Ошибка) = Тип("Структура") ИЛИ ТипЗнч(Ошибка) = Тип("ФиксированнаяСтруктура") Тогда
		Ошибка.Свойство("code", Код);
	ИначеЕсли ТипЗнч(Ошибка) = Тип("Соответствие") ИЛИ ТипЗнч(Ошибка) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Ошибка.Получить("code");
		Если Значение <> Неопределено Тогда
			Код = Значение;
		КонецЕсли;
	КонецЕсли;

	Результат.Вставить("code", СтрокаPrivacyБезопасная(Код));
	Возврат Результат;

КонецФункции

// Метрики вызова вместо самих аргументов. Аргументы несут данные всегда, а не
// изредка: у run_1c_query это текст запроса с литералами и значения параметров,
// у search_objects — поисковая строка (то есть ровно то, чем ищут человека), у
// get_object_by_ref — идентификатор конкретного объекта. Поэтому пишем только
// то, что данными не является:
//   keys        — имена ключей ВЕРХНЕГО уровня (схема инструмента: query, limit);
//   query_chars — длина текста запроса, для разбора «большой запрос или нет»;
//   param_count — сколько параметров передано, без имён и без значений.
//
// Вложенные ключи не пишем: у parameters это имена параметров запроса, которые
// клиент выбирает сам, и они могут пересказывать содержимое отбора.
Функция МетрикиАргументов(Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("keys", Новый Массив);

	Если Аргументы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Ключи = КлючиВерхнегоУровня(Аргументы);
		Для Каждого Ключ Из Ключи Цикл
			Результат.keys.Добавить(Ключ);
		КонецЦикла;

		ТекстЗапроса = ЗначениеАргумента(Аргументы, "query");
		Если ТипЗнч(ТекстЗапроса) = Тип("Строка") Тогда
			Результат.Вставить("query_chars", СтрДлина(ТекстЗапроса));
		КонецЕсли;

		Параметры = ЗначениеАргумента(Аргументы, "parameters");
		Если Параметры <> Неопределено Тогда
			Результат.Вставить("param_count", КоличествоЭлементовАргумента(Параметры));
		КонецЕсли;
	Исключение
		// Метрики — вспомогательные. Их сбой не должен ни ронять вызов, ни
		// приводить к записи чего-то неожиданного: возвращаем то, что собрали.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция КлючиВерхнегоУровня(Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из Значение Цикл
			Результат.Добавить(Строка(КЗ.Ключ));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеАргумента(Аргументы, Знач Имя)

	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированнаяСтруктура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие")
		ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция КоличествоЭлементовАргумента(Значение)

	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие")
		ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение.Количество();
	КонецЕсли;
	Возврат 0;

КонецФункции

// Код ошибки — собственный идентификатор сервера (validation_failed_before_run
// и т.п.), но приходит он значением из чужой структуры. Ограничение длины —
// страховка от того, что на его месте однажды окажется текст.
Функция СтрокаPrivacyБезопасная(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) > 64 Тогда
		Текст = Лев(Текст, 64);
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция СводкаРезультата(Данные)

	Сводка = Новый Структура;

	Если ТипЗнч(Данные) = Тип("Структура")
		ИЛИ ТипЗнч(Данные) = Тип("ФиксированнаяСтруктура") Тогда
		ДобавитьСводноеПоле(Сводка, Данные, "row_count");
		ДобавитьСводноеПоле(Сводка, Данные, "truncated");
		ДобавитьСводноеПоле(Сводка, Данные, "count");
		ДобавитьСводноеПоле(Сводка, Данные, "found");
	КонецЕсли;

	Возврат Сводка;

КонецФункции

Процедура ДобавитьСводноеПоле(Сводка, Данные, Имя)
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Сводка.Вставить(Имя, Значение);
	КонецЕсли;
КонецПроцедуры

// Редактор чувствительных ключей (password/token/secret) упразднён вместе с
// записью значений: в журнал не идёт НИ ОДНО значение аргумента, поэтому
// вычищать из них отдельные ключи больше не из чего.

// ====================================================================
// Чтение аудита: тайминги вызовов, записанные процедурами выше.
// ====================================================================

// Возвращает записи аудита MCP из журнала регистрации за окно в минутах.
//
// Аргументы вызовов (`arguments.raw_json`) НЕ возвращаются НИКОГДА и ни в каком
// режиме. Причина не в объёме: privacy-маскирование применяется к результату
// вызова, а не к его аргументам, поэтому текст запроса в журнале лежит как есть —
// вернуть его клиенту значило бы открыть канал в обход маскирования. По той же
// причине не возвращается error.message: сообщения платформы цитируют фрагмент
// упавшего запроса. Код ошибки для разбора таймингов достаточен.
Функция ПрочитатьТайминги(Знач МинутНазад, Знач Инструменты, Знач Исход,
	Знач ВключатьHTTP, Знач CorrelationID, Знач Лимит, Знач ПотолокСканирования) Экспорт

	Предупреждения = Новый Массив;
	Сейчас = ТекущаяДатаСеанса();
	ДатаНачала = Сейчас - МинутНазад * 60;

	Результат = Новый Структура;
	Результат.Вставить("period", Новый Структура("from, to",
		Формат(ДатаНачала, "ДФ=yyyy-MM-ddTHH:mm:ss"),
		Формат(Сейчас, "ДФ=yyyy-MM-ddTHH:mm:ss")));
	Результат.Вставить("source_available", Ложь);
	Результат.Вставить("scanned_events", 0);
	Результат.Вставить("scan_truncated", Ложь);
	Результат.Вставить("events", Новый Массив);
	Результат.Вставить("by_tool", Новый Массив);
	Результат.Вставить("warnings", Предупреждения);

	// Нет права просмотра журнала — деградация флагом, как в get_object_history и
	// get_query_examples: пустой массив без признака читался бы как «вызовов не было».
	Если НЕ ПросмотрЖурналаДоступен() Тогда
		Предупреждения.Добавить("event_log_not_available");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("source_available", Истина);

	СписокСобытий = ИменаСобытийАудита(Инструменты, Исход, ВключатьHTTP);
	Если СписокСобытий.Количество() = 0 Тогда
		Предупреждения.Добавить("no_event_names_resolved");
		Возврат Результат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Событие", СписокСобытий);
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Отбор.Вставить("ДатаОкончания", Сейчас);

	ТаблицаЖР = Новый ТаблицаЗначений;
	Попытка
		ВыгрузитьЖурналРегистрации(ТаблицаЖР, Отбор, , , ПотолокСканирования);
	Исключение
		Предупреждения.Добавить("event_log_read_failed");
		Возврат Результат;
	КонецПопытки;

	Результат.scanned_events = ТаблицаЖР.Количество();
	Если ТаблицаЖР.Количество() >= ПотолокСканирования Тогда
		// Порядок выгрузки и отрезаемый конец окна платформой не гарантируются:
		// при упоре в потолок часть окна не отсканирована, и агрегат неполон.
		Результат.scan_truncated = Истина;
		Предупреждения.Добавить("scan_truncated: часть окна не отсканирована, уменьшите minutes_back");
	КонецЕсли;

	ТаблицаЖР.Сортировать("Дата Убыв");

	Длительности = Новый Соответствие; // имя тула -> ТаблицаЗначений длительностей
	Счётчики = Новый Соответствие;     // имя тула -> Структура(calls, errors)
	БезДлительности = 0;

	Для Каждого СтрокаЖР Из ТаблицаЖР Цикл

		Данные = ИзСтрокиJSONБезопасно(СтрокаЖР.Комментарий);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеCorrelation = "";
		Данные.Свойство("correlation_id", ЗначениеCorrelation);
		Если ЗначениеЗаполнено(CorrelationID) И Строка(ЗначениеCorrelation) <> CorrelationID Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеДлительности = Неопределено;
		Данные.Свойство("duration_ms", ЗначениеДлительности);
		Если ТипЗнч(ЗначениеДлительности) <> Тип("Число") Тогда
			// Записи, сделанные до появления замера, отличимы от нулевых.
			ЗначениеДлительности = Неопределено;
			БезДлительности = БезДлительности + 1;
		КонецЕсли;

		Событие = Новый Структура;
		Событие.Вставить("at", Формат(СтрокаЖР.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Событие.Вставить("duration_ms", ЗначениеДлительности);
		Событие.Вставить("user", Строка(СтрокаЖР.ИмяПользователя));
		Событие.Вставить("correlation_id", Строка(ЗначениеCorrelation));

		Если Строка(СтрокаЖР.Событие) = "MCP.http_request" Тогда
			// Исход HTTP-записи в имени события не закодирован — событие одно, поэтому
			// отбор по именам его не различает, и фильтр исхода применяется здесь.
			// Признак берётся тот же, которым запись классифицировал писатель:
			// уровень «Информация» — штатный ответ (включая 202, 204 и контрактный
			// 405), выше — отклонение Origin/версии, пустое тело, прочий 4xx и 5xx.
			// Своё правило по http_status здесь раздвоило бы классификацию.
			Если Исход <> "all" Тогда
				УспехHTTP = (СтрокаЖР.Уровень = УровеньЖурналаРегистрации.Информация);
				Если (Исход = "success" И НЕ УспехHTTP) ИЛИ (Исход = "error" И УспехHTTP) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Событие.Вставить("kind", "http_request");
			ПеренестиПоле(Событие, Данные, "http_method");
			ПеренестиПоле(Событие, Данные, "http_status");
			ПеренестиПоле(Событие, Данные, "outcome");
			ПеренестиПоле(Событие, Данные, "request_chars");
			ПеренестиПоле(Событие, Данные, "response_chars");
			// Разбивка по стадиям (профилирование): имена стадий и миллисекунды,
			// аргументов и текстов в ней нет — канал обхода маски не открывается.
			ПеренестиПоле(Событие, Данные, "stages");
			ПеренестиПоле(Событие, Данные, "counters");
		Иначе
			ИмяТула = "";
			Данные.Свойство("tool", ИмяТула);
			Если НЕ ЗначениеЗаполнено(ИмяТула) Тогда
				ИмяТула = ИмяТулаИзСобытия(Строка(СтрокаЖР.Событие));
			КонецЕсли;
			Успех = Ложь;
			Данные.Свойство("success", Успех);

			Событие.Вставить("kind", "tool");
			Событие.Вставить("tool", ИмяТула);
			Событие.Вставить("success", Успех = Истина);
			ПеренестиПоле(Событие, Данные, "summary");
			ПеренестиМетрикиАргументов(Событие, Данные);
			// См. комментарий у HTTP-ветки: stages/counters — только имена и числа.
			ПеренестиПоле(Событие, Данные, "stages");
			ПеренестиПоле(Событие, Данные, "counters");
			ЗначениеОшибки = Неопределено;
			Если Данные.Свойство("error", ЗначениеОшибки)
				И (ТипЗнч(ЗначениеОшибки) = Тип("Структура")
					ИЛИ ТипЗнч(ЗначениеОшибки) = Тип("Соответствие")) Тогда
				КодОшибки = "";
				Если ТипЗнч(ЗначениеОшибки) = Тип("Структура") Тогда
					ЗначениеОшибки.Свойство("code", КодОшибки);
				Иначе
					КодОшибки = ?(ЗначениеОшибки.Получить("code") = Неопределено, "",
						ЗначениеОшибки.Получить("code"));
				КонецЕсли;
				Событие.Вставить("error_code", Строка(КодОшибки));
			КонецЕсли;

			НакопитьСтатистику(Счётчики, Длительности, ИмяТула, Успех = Истина, ЗначениеДлительности);
		КонецЕсли;

		// Агрегат считается по всему окну, а список событий обрезается лимитом:
		// иначе by_tool описывал бы только видимую страницу и вводил в заблуждение.
		Если Результат.events.Количество() < Лимит Тогда
			Результат.events.Добавить(Событие);
		КонецЕсли;

	КонецЦикла;

	Если БезДлительности > 0 Тогда
		Предупреждения.Добавить("records_without_duration: " + Формат(БезДлительности, "ЧГ=0")
			+ " (записи ревизий до появления замера)");
	КонецЕсли;

	Результат.by_tool = СобратьАгрегат(Счётчики, Длительности);
	Возврат Результат;

КонецФункции

// Доступность определяем ПРОБНЫМ чтением, а не ПравоДоступа("ПросмотрЖурналаРегистрации", ...):
// это имя невалидно для ПравоДоступа на данной платформе — вызов возбуждает исключение и всегда
// возвращал Ложь даже у пользователя с ПолнымиПравами (подтверждено вживую на get_object_history).
Функция ПросмотрЖурналаДоступен() Экспорт

	Попытка
		Проба = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Проба, , , , 1);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ИменаСобытийАудита(Знач Инструменты, Знач Исход, Знач ВключатьHTTP)

	СписокТулов = Новый Массив;
	Если Инструменты <> Неопределено И Инструменты.Количество() > 0 Тогда
		Для Каждого Имя Из Инструменты Цикл
			СписокТулов.Добавить(СокрЛП(Строка(Имя)));
		КонецЦикла;
	Иначе
		// Имя события собирается как "MCP.<tool>.<исход>", поэтому список берётся из
		// реестра инструментов, а не пишется руками: иначе новый инструмент молча
		// выпал бы из выборки, и его тайминги никто бы не хватился.
		Попытка
			СписокТулов = MCP_Tools.ИменаИнструментов();
		Исключение
			СписокТулов = Новый Массив;
		КонецПопытки;
		// Отказы, у которых имя тула фиксировано сервером (имя из запроса в журнал
		// не попадает — оно произвольное и годится для флуда ЖР).
		СписокТулов.Добавить("access_denied");
		СписокТулов.Добавить("unknown_tool");
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Имя Из СписокТулов Цикл
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Исход <> "error" Тогда
			Имена.Добавить("MCP." + Имя + ".success");
		КонецЕсли;
		Если Исход <> "success" Тогда
			Имена.Добавить("MCP." + Имя + ".error");
		КонецЕсли;
	КонецЦикла;

	Если ВключатьHTTP = Истина Тогда
		Имена.Добавить("MCP.http_request");
	КонецЕсли;

	Возврат Имена;

КонецФункции

Функция ИмяТулаИзСобытия(Знач ИмяСобытия)

	Текст = ИмяСобытия;
	Если СтрНачинаетсяС(Текст, "MCP.") Тогда
		Текст = Сред(Текст, 5);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Текст, ".success") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 8);
	ИначеЕсли СтрЗаканчиваетсяНа(Текст, ".error") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 6);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Метрики вызова из записи аудита — ТОЛЬКО числа: размер текста запроса и
// число переданных параметров. Ни имён ключей, ни тем более значений: канал в
// обход маскирования не открывается, отдаём ровно то, что и в журнал попало
// безопасным (МетрикиАргументов).
//
// Побочно эти два поля служат маркером публикации: до 2026-08-14.3 в записи
// лежал сырой JSON аргументов, который не отдавался вовсе, поэтому у старых
// событий полей нет. Правка запрета данных в журнале снаружи не наблюдается
// ничем другим — гейт свежести MCP_Audit опирается именно на них.
Процедура ПеренестиМетрикиАргументов(Событие, Знач Данные)

	Аргументы = Неопределено;
	Если НЕ Данные.Свойство("arguments", Аргументы) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;
	Если Аргументы.Свойство("query_chars", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		Событие.Вставить("query_chars", Значение);
	КонецЕсли;

	Значение = Неопределено;
	Если Аргументы.Свойство("param_count", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		Событие.Вставить("param_count", Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ПеренестиПоле(Приёмник, Знач Источник, Знач Имя)

	Значение = Неопределено;
	Если Источник.Свойство(Имя, Значение) Тогда
		Приёмник.Вставить(Имя, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура НакопитьСтатистику(Счётчики, Длительности, Знач ИмяТула, Знач Успех, Знач Длительность)

	Если ПустаяСтрока(ИмяТула) Тогда
		Возврат;
	КонецЕсли;

	Счётчик = Счётчики.Получить(ИмяТула);
	Если Счётчик = Неопределено Тогда
		Счётчик = Новый Структура("calls, errors", 0, 0);
		Счётчики.Вставить(ИмяТула, Счётчик);
	КонецЕсли;
	Счётчик.calls = Счётчик.calls + 1;
	Если НЕ Успех Тогда
		Счётчик.errors = Счётчик.errors + 1;
	КонецЕсли;

	Если ТипЗнч(Длительность) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;

	Таблица = Длительности.Получить(ИмяТула);
	Если Таблица = Неопределено Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Значение");
		Длительности.Вставить(ИмяТула, Таблица);
	КонецЕсли;
	Таблица.Добавить().Значение = Длительность;

КонецПроцедуры

Функция СобратьАгрегат(Знач Счётчики, Знач Длительности)

	Результат = Новый Массив;

	Для Каждого КЗ Из Счётчики Цикл
		Строка = Новый Структура;
		Строка.Вставить("tool", КЗ.Ключ);
		Строка.Вставить("calls", КЗ.Значение.calls);
		Строка.Вставить("errors", КЗ.Значение.errors);

		Таблица = Длительности.Получить(КЗ.Ключ);
		Метрики = Новый Структура;
		Если Таблица = Неопределено ИЛИ Таблица.Количество() = 0 Тогда
			Метрики.Вставить("measured", 0);
		Иначе
			Таблица.Сортировать("Значение Возр");
			Последний = Таблица.Количество() - 1;
			// Медиана нижней выборкой: точное определение p50 для чётного числа
			// значений разнится, и интерполяция создала бы число, которого в
			// замерах не было.
			Метрики.Вставить("measured", Таблица.Количество());
			Метрики.Вставить("min", Таблица[0].Значение);
			Метрики.Вставить("p50", Таблица[Цел(Последний / 2)].Значение);
			Метрики.Вставить("max", Таблица[Последний].Значение);
		КонецЕсли;
		Строка.Вставить("duration_ms", Метрики);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИзСтрокиJSONБезопасно(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Значение = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Неопределено;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ИмяТекущегоПользователя()

	Попытка
		ТекПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекПользователь = Неопределено Тогда
			Возврат "system";
		КонецЕсли;
		Возврат ТекПользователь.Имя;
	Исключение
		Возврат "unknown";
	КонецПопытки;

КонецФункции

Функция СтрокаJSON(Значение)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Значение);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Значение);
