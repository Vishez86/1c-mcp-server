// MCP_Audit.bsl
// ====================================================================
// Аудит вызовов MCP-сервера.
// Пишет в журнал регистрации события "MCP.<tool>.success" и "MCP.<tool>.error".
// Чувствительные аргументы и большие payload не сохраняются.
// ====================================================================

Процедура ЗаписатьУспех(CorrelationID, ИмяТула, Аргументы, Результат, ДлительностьМс = Неопределено) Экспорт

	Сообщение = СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, Результат, Истина, ДлительностьМс);
	ЗаписьЖурналаРегистрации(
		"MCP." + ИмяТула + ".success",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Сообщение);

КонецПроцедуры

Процедура ЗаписатьОшибку(CorrelationID, ИмяТула, Аргументы, Ошибка, ДлительностьМс = Неопределено) Экспорт

	Сообщение = СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, Ошибка, Ложь, ДлительностьМс);
	ЗаписьЖурналаРегистрации(
		"MCP." + ИмяТула + ".error",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Сообщение);

КонецПроцедуры

// Запись о полном жизненном цикле входящего HTTP POST /rpc.
// Тело и заголовки намеренно не сохраняются: в них могут быть персональные данные и секреты.
Процедура ЗаписатьHTTPЗапрос(КодСостояния, ДлительностьМс, Исход, РазмерТелаСимволов = Неопределено, МетодHTTP = "POST") Экспорт

	ДанныеЛога = Новый Структура;
	ДанныеЛога.Вставить("kind", "http_request");
	ДанныеЛога.Вставить("http_method", МетодHTTP);
	ДанныеЛога.Вставить("http_status", КодСостояния);
	ДанныеЛога.Вставить("duration_ms", ДлительностьМс);
	ДанныеЛога.Вставить("outcome", Исход);
	ДанныеЛога.Вставить("user", ИмяТекущегоПользователя());
	ДанныеЛога.Вставить("timestamp", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Если РазмерТелаСимволов <> Неопределено Тогда
		ДанныеЛога.Вставить("request_chars", РазмерТелаСимволов);
	КонецЕсли;

	Уровень = УровеньЖурналаРегистрации.Информация;
	Если КодСостояния >= 500 Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли КодСостояния >= 400 ИЛИ Исход <> "success" Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("MCP.http_request", Уровень, , , СтрокаJSON(ДанныеЛога));

КонецПроцедуры

// Единый источник времени для измерения длительности без зависимости от часового пояса сеанса.
Функция ТекущиеМиллисекундыUTC() Экспорт
	Возврат (ТекущаяУниверсальнаяДата() - '19700101') * 1000;

КонецФункции

Функция СформироватьСообщение(CorrelationID, ИмяТула, Аргументы, ДанныеРезультата, Успех, ДлительностьМс = Неопределено)

	Структ = Новый Структура;
	Структ.Вставить("correlation_id", Строка(CorrelationID));
	Структ.Вставить("tool", ИмяТула);
	Структ.Вставить("user", ИмяТекущегоПользователя());
	Структ.Вставить("timestamp", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Структ.Вставить("success", Успех);
	Если ДлительностьМс <> Неопределено Тогда
		Структ.Вставить("duration_ms", ДлительностьМс);
	КонецЕсли;

	Если Успех Тогда
		Структ.Вставить("summary", СводкаРезультата(ДанныеРезультата));
	Иначе
		Структ.Вставить("error", ДанныеРезультата);
	КонецЕсли;

	Структ.Вставить("arguments", БезопасныеАргументы(Аргументы));

	Возврат СтрокаJSON(Структ);

КонецФункции

Функция СводкаРезультата(Данные)

	Сводка = Новый Структура;

	Если ТипЗнч(Данные) = Тип("Структура")
		ИЛИ ТипЗнч(Данные) = Тип("ФиксированнаяСтруктура") Тогда
		ДобавитьСводноеПоле(Сводка, Данные, "row_count");
		ДобавитьСводноеПоле(Сводка, Данные, "truncated");
		ДобавитьСводноеПоле(Сводка, Данные, "count");
		ДобавитьСводноеПоле(Сводка, Данные, "found");
	КонецЕсли;

	Возврат Сводка;

КонецФункции

Процедура ДобавитьСводноеПоле(Сводка, Данные, Имя)
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Сводка.Вставить(Имя, Значение);
	КонецЕсли;
КонецПроцедуры

Функция БезопасныеАргументы(Аргументы)

	// Усекаем длинные строки и убираем известные чувствительные ключи.
	Если Аргументы = Неопределено Тогда
		Возврат Новый Структура;
	КонецЕсли;

	МаксБайт = 4096;

	Попытка
		АргументыДляЖурнала = РедактироватьЧувствительныеКлючи(Аргументы);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, АргументыДляЖурнала);
		Текст = ЗаписьJSON.Закрыть();
	Исключение
		Возврат Новый Структура("serialization_failed", Истина);
	КонецПопытки;

	Если СтрДлина(Текст) > МаксБайт Тогда
		Текст = Лев(Текст, МаксБайт) + "...[truncated]";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("raw_json", Текст);
	Возврат Результат;

КонецФункции

Функция РедактироватьЧувствительныеКлючи(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(РедактироватьЧувствительныеКлючи(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КЗ Из Значение Цикл
			Если КлючЧувствительный(КЗ.Ключ) Тогда
				Результат.Вставить(КЗ.Ключ, "[redacted]");
			Иначе
				Результат.Вставить(КЗ.Ключ, РедактироватьЧувствительныеКлючи(КЗ.Значение));
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КЗ Из Значение Цикл
			Если КлючЧувствительный(КЗ.Ключ) Тогда
				Результат.Вставить(КЗ.Ключ, "[redacted]");
			Иначе
				Результат.Вставить(КЗ.Ключ, РедактироватьЧувствительныеКлючи(КЗ.Значение));
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция КлючЧувствительный(Ключ)

	Текст = НРег(Строка(Ключ));
	Возврат СтрНайти(Текст, "password") > 0
		ИЛИ СтрНайти(Текст, "passwd") > 0
		ИЛИ СтрНайти(Текст, "token") > 0
		ИЛИ СтрНайти(Текст, "authorization") > 0
		ИЛИ СтрНайти(Текст, "secret") > 0
		ИЛИ СтрНайти(Текст, "пароль") > 0
		ИЛИ СтрНайти(Текст, "токен") > 0
		ИЛИ СтрНайти(Текст, "секрет") > 0;

КонецФункции

Функция ИмяТекущегоПользователя()

	Попытка
		ТекПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекПользователь = Неопределено Тогда
			Возврат "system";
		КонецЕсли;
		Возврат ТекПользователь.Имя;
	Исключение
		Возврат "unknown";
	КонецПопытки;

КонецФункции

Функция СтрокаJSON(Значение)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Значение);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;

КонецФункции
