Функция ЭтоРесурсДокументации(URI) Экспорт
	URI = Строка(URI);
	Для Каждого Версия Из ПоддерживаемыеВерсии() Цикл
		Если СтрНачинаетсяС(URI, ПрефиксРесурса(Версия) + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПрочитатьРесурс(URI) Экспорт
	URI = Строка(URI);
	Версия = ВерсияИзURI(URI);
	ПроверитьВерсиюИДомен(Версия, "");
	Префикс = ПрефиксРесурса(Версия);
	Если URI = Префикс + "/index" Тогда
		Возврат ТекстИндекс(Версия);
	ИначеЕсли URI = Префикс + "/provenance" Тогда
		Возврат КонтентРесурса("version-provenance", "", Версия);
	ИначеЕсли СтрНайти(URI, "#") > 0 Тогда
		Возврат КонтентСекцииПоURI(URI);
	Иначе
		TopicID = Сред(URI, СтрДлина(Префикс + "/") + 1);
		Возврат КонтентРесурса(TopicID, URI, Версия);
	КонецЕсли;
КонецФункции

Функция ListTopics(Версия = "", Домен = "") Экспорт
	Версия = НормализоватьВерсию(Версия);
	ПроверитьВерсиюИДомен(Версия, Домен);
	Результат = Новый Структура;
	Результат.Вставить("version", Версия);
	Результат.Вставить("domain", ДоменДокументации());
	Результат.Вставить("supported_versions", ПоддерживаемыеВерсии());
	Результат.Вставить("topics", Темы(Версия));
	Возврат Результат;
КонецФункции

Функция SearchDocs(Query, Версия = "", Домен = "", TopK = 5, MaxCharsPerResult = 1800) Экспорт
	Версия = НормализоватьВерсию(Версия);
	ПроверитьВерсиюИДомен(Версия, Домен);
	Query = СокрЛП(Строка(Query));
	Если ПустаяСтрока(Query) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Параметр query обязателен.");
	КонецЕсли;
	Термы = ТермыПоиска(Query);
	Результаты = Новый Массив;
	Для Каждого Секция Из ВсеСекции() Цикл
		Если Секция.version <> Версия Тогда
			Продолжить;
		КонецЕсли;
		Score = СчетРелевантности(Секция, Термы, Query);
		Если Score > 0 Тогда
			Рез = Новый Структура;
			Рез.Вставить("section_id", Секция.section_id);
			Рез.Вставить("version", Секция.version);
			Рез.Вставить("domain", Секция.domain);
			Рез.Вставить("title", Секция.title);
			Рез.Вставить("source_file", Секция.source_file);
			Рез.Вставить("resource_uri", Секция.resource_uri);
			Рез.Вставить("score", Score);
			Рез.Вставить("excerpt", Обрезать(Фрагмент(Секция.content, Термы), MaxCharsPerResult));
			ДобавитьРезультатПоСчету(Результаты, Рез, TopK);
		КонецЕсли;
	КонецЦикла;
	Ответ = Новый Структура;
	Ответ.Вставить("version", Версия);
	Ответ.Вставить("domain", ДоменДокументации());
	Ответ.Вставить("supported_versions", ПоддерживаемыеВерсии());
	Ответ.Вставить("query", Query);
	Ответ.Вставить("results", Результаты);
	Ответ.Вставить("truncated", Ложь);
	Если Результаты.Количество() = 0 Тогда
		Заметки = Новый Массив;
		Заметки.Добавить("Релевантные секции не найдены. Уточните термин или проверьте список тем через list_1c_language_doc_topics.");
		Ответ.Вставить("notes", Заметки);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция ReadSection(SectionID = "", ResourceURI = "", MaxChars = 8000, Cursor = "", Версия = "", Домен = "") Экспорт
	SectionID = СокрЛП(Строка(SectionID));
	ResourceURI = СокрЛП(Строка(ResourceURI));
	Если ПустаяСтрока(SectionID) = ПустаяСтрока(ResourceURI) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Укажите ровно один из параметров section_id или resource_uri.");
	КонецЕсли;
	Если ПустаяСтрока(ResourceURI) Тогда
		Версия = НормализоватьВерсию(Версия);
	Иначе
		Версия = ВерсияИзURI(ResourceURI);
	КонецЕсли;
	ПроверитьВерсиюИДомен(Версия, Домен);
	Секция = Неопределено;
	Для Каждого Кандидат Из ВсеСекции() Цикл
		Если Кандидат.version <> Версия Тогда
			Продолжить;
		КонецЕсли;
		Если (НЕ ПустаяСтрока(SectionID) И Кандидат.section_id = SectionID)
			ИЛИ (НЕ ПустаяСтрока(ResourceURI) И Кандидат.resource_uri = ResourceURI) Тогда
			Секция = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Секция = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Секция документации не найдена.");
	КонецЕсли;
	Смещение = ЧислоКурсора(Cursor);
	Контент = Сред(Секция.content, Смещение + 1);
	Обрезанный = Обрезать(Контент, MaxChars);
	Ответ = Новый Структура;
	Ответ.Вставить("version", Секция.version);
	Ответ.Вставить("domain", Секция.domain);
	Ответ.Вставить("supported_versions", ПоддерживаемыеВерсии());
	Ответ.Вставить("section_id", Секция.section_id);
	Ответ.Вставить("title", Секция.title);
	Ответ.Вставить("source_file", Секция.source_file);
	Ответ.Вставить("resource_uri", Секция.resource_uri);
	Ответ.Вставить("heading_path", Секция.heading_path);
	Ответ.Вставить("content", Обрезанный);
	Truncated = СтрДлина(Контент) > СтрДлина(Обрезанный);
	Ответ.Вставить("truncated", Truncated);
	Ответ.Вставить("next_cursor", ?(Truncated, Строка(Смещение + СтрДлина(Обрезанный)), Null));
	Возврат Ответ;
КонецФункции

Функция Provenance(Версия = "", Домен = "") Экспорт
	Версия = НормализоватьВерсию(Версия);
	ПроверитьВерсиюИДомен(Версия, Домен);
	Ответ = ReadSection("references/version-provenance.md#versiya-spravochnika", "", 20000, "", Версия, Домен);
	Правила = Новый Структура;
	Правила.Вставить("default_version", ВерсияДокументации());
	Правила.Вставить("supported_versions", ПоддерживаемыеВерсии());
	Правила.Вставить("official_docs_priority", "highest_for_syntax");
	Правила.Вставить("live_metadata_priority", "highest_for_infobase_specific_fields");
	Ответ.Вставить("rules", Правила);
	Возврат Ответ;
КонецФункции

