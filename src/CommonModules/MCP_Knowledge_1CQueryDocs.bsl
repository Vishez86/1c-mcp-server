Процедура ДобавитьРесурс(Ресурсы, URI, Имя, Описание)
	Ресурс = Новый Структура;
	Ресурс.Вставить("uri", URI);
	Ресурс.Вставить("name", Имя);
	Ресурс.Вставить("description", Описание);
	Ресурс.Вставить("mimeType", "text/markdown");
	Ресурсы.Добавить(Ресурс);
КонецПроцедуры

Процедура ДобавитьСекцию(Секции, Version, Domain, SectionID, ResourceURI, Title, SourceFile, TopicID, HeadingPath, Tags, Content)
	Секция = Новый Структура;
	Секция.Вставить("version", Version);
	Секция.Вставить("domain", Domain);
	Секция.Вставить("section_id", SectionID);
	Секция.Вставить("resource_uri", ResourceURI);
	Секция.Вставить("title", Title);
	Секция.Вставить("source_file", SourceFile);
	Секция.Вставить("topic_id", TopicID);
	Секция.Вставить("heading_path", HeadingPath);
	Секция.Вставить("tags", Tags);
	Секция.Вставить("content", Content);
	Секции.Добавить(Секция);
КонецПроцедуры

Функция НормализоватьВерсию(Версия)
	Версия = СокрЛП(Строка(Версия));
	Если ПустаяСтрока(Версия) Тогда
		Возврат ВерсияДокументации();
	КонецЕсли;
	Возврат Версия;
КонецФункции

Процедура ПроверитьВерсиюИДомен(Версия, Домен)
	Версия = СокрЛП(Строка(Версия));
	Домен = СокрЛП(Строка(Домен));
	Если НЕ МассивСодержит(ПоддерживаемыеВерсии(), Версия) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Версия документации не поддерживается: " + Версия);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Домен) И Домен <> ДоменДокументации() Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Домен документации не поддерживается: " + Домен);
	КонецЕсли;
КонецПроцедуры

Функция ПрефиксРесурса(Версия)
	Возврат "1c-docs://" + Версия + "/" + ДоменДокументации();
КонецФункции

Функция ВерсияИзURI(URI)
	URI = Строка(URI);
	ПрефиксПротокола = "1c-docs://";
	Если НЕ СтрНачинаетсяС(URI, ПрефиксПротокола) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "URI документации должен начинаться с " + ПрефиксПротокола);
	КонецЕсли;
	Остаток = Сред(URI, СтрДлина(ПрефиксПротокола) + 1);
	Части = СтрРазделить(Остаток, "/", Ложь);
	Если Части.Количество() < 2 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "URI документации не содержит версию и домен: " + URI);
	КонецЕсли;
	Версия = Части[0];
	Домен = Части[1];
	Если Домен <> ДоменДокументации() Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Домен документации не поддерживается: " + Домен);
	КонецЕсли;
	Возврат Версия;
КонецФункции

Функция ТекстИндекс(Версия)
	Текст = "# Документация по языку запросов 1С " + Версия + Символы.ПС + Символы.ПС;
	Для Каждого Тема Из Темы(Версия) Цикл
		Текст = Текст + "- " + Тема.title + " — " + Тема.resource_uri + Символы.ПС;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция КонтентРесурса(TopicID, URI, Версия)
	Контент = "";
	Для Каждого Секция Из ВсеСекции() Цикл
		Если Секция.version = Версия И Секция.topic_id = TopicID Тогда
			Если НЕ ПустаяСтрока(Контент) Тогда
				Контент = Контент + Символы.ПС;
			КонецЕсли;
			Контент = Контент + Секция.content;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Контент) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Ресурс документации не найден: " + Строка(URI));
	КонецЕсли;
	Возврат Контент;
КонецФункции

Функция КонтентСекцииПоURI(URI)
	Для Каждого Секция Из ВсеСекции() Цикл
		Если Секция.resource_uri = URI Тогда
			Возврат Секция.content;
		КонецЕсли;
	КонецЦикла;
	MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Секция документации не найдена: " + Строка(URI));
КонецФункции

Функция ТермыПоиска(Query)
	Норм = НРег(Строка(Query));
	Пунктуация = ".,;:()[]{}<>/\\|""'\`!?«»" + Символы.Таб + Символы.ПС;
	Для Индекс = 1 По СтрДлина(Пунктуация) Цикл
		Симв = Сред(Пунктуация, Индекс, 1);
		Норм = СтрЗаменить(Норм, Симв, " ");
	КонецЦикла;
	Слова = СтрРазделить(Норм, " ", Ложь);
	Термы = Новый Массив;
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Если СтрДлина(Слово) >= 2 И НЕ МассивСодержит(Термы, Слово) Тогда
			Термы.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;
	Возврат Термы;
КонецФункции

Функция МассивСодержит(МассивЗначений, Искомое)
	Для Каждого Значение Из МассивЗначений Цикл
		Если Значение = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СчетРелевантности(Секция, Термы, Query)
	Score = 0;
	Title = НРег(Секция.title);
	Content = НРег(Секция.content);
	Tags = НРег(СоединитьМассив(Секция.tags, " "));
	Path = НРег(СоединитьМассив(Секция.heading_path, " "));
	QueryNorm = НРег(Query);
	Если СтрНайти(Title, QueryNorm) > 0 Тогда
		Score = Score + 50;
	КонецЕсли;
	Если СтрНайти(Content, QueryNorm) > 0 Тогда
		Score = Score + 25;
	КонецЕсли;
	Для Каждого Терм Из Термы Цикл
		Если СтрНайти(Title, Терм) > 0 Тогда
			Score = Score + 10;
		КонецЕсли;
		Если СтрНайти(Tags, Терм) > 0 Тогда
			Score = Score + 8;
		КонецЕсли;
		Если СтрНайти(Path, Терм) > 0 Тогда
			Score = Score + 5;
		КонецЕсли;
		Если СтрНайти(Content, Терм) > 0 Тогда
			Score = Score + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Score;
КонецФункции

Функция СоединитьМассив(МассивЗначений, Разделитель)
	Текст = "";
	Для Каждого Значение Из МассивЗначений Цикл
		Если НЕ ПустаяСтрока(Текст) Тогда
			Текст = Текст + Разделитель;
		КонецЕсли;
		Текст = Текст + Строка(Значение);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Процедура ДобавитьРезультатПоСчету(Результаты, Рез, TopK)
	Индекс = 0;
	Пока Индекс < Результаты.Количество() Цикл
		Если Рез.score > Результаты[Индекс].score Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Результаты.Вставить(Индекс, Рез);
	Пока Результаты.Количество() > TopK Цикл
		Результаты.Удалить(Результаты.Количество() - 1);
	КонецЦикла;
КонецПроцедуры

Функция Фрагмент(Content, Термы)
	Норм = НРег(Content);
	Позиция = 0;
	Для Каждого Терм Из Термы Цикл
		Позиция = СтрНайти(Норм, Терм);
		Если Позиция > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Позиция <= 0 Тогда
		Возврат Content;
	КонецЕсли;
	Начало = Позиция - 300;
	Если Начало < 1 Тогда
		Начало = 1;
	КонецЕсли;
	Возврат Сред(Content, Начало);
КонецФункции

Функция Обрезать(Content, MaxChars)
	Если MaxChars <= 0 Тогда
		MaxChars = 1;
	КонецЕсли;
	Если СтрДлина(Content) <= MaxChars Тогда
		Возврат Content;
	КонецЕсли;
	Возврат Лев(Content, MaxChars);
КонецФункции

Функция ЧислоКурсора(Cursor)
	Попытка
		Возврат ?(ПустаяСтрока(Строка(Cursor)), 0, Цел(Число(Cursor)));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции
