		"ВЫБРАТЬ, ИЗ, ГДЕ, СГРУППИРОВАТЬ ПО, ИМЕЮЩИЕ, ОБЪЕДИНИТЬ, УПОРЯДОЧИТЬ ПО, ИТОГИ.",
		"1c://knowledge/query/syntax");
