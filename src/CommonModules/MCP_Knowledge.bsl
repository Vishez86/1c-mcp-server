Функция СписокРесурсов() Экспорт

	Ресурсы = Новый Массив;
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query", "1C query knowledge index",
		"Карта встроенных тем по языку запросов 1С.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/syntax", "1C query syntax",
		"Структура запроса, ключевые слова, UNION, ORDER BY, ИТОГИ, ПОДОБНО.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/functions", "1C query functions",
		"Функции, выражения, приведение типов, даты, строки, NULL, литералы.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/optimization", "1C query optimization",
		"Производительность, индексы, ИЛИ, составные типы, RLS, вложенные JOIN.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/temporary-tables", "1C temporary tables",
		"Правила ПОМЕСТИТЬ, ИНДЕКСИРОВАТЬ ПО и чтения временных таблиц.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/compound-types", "1C compound references",
		"ССЫЛКА, ВЫРАЗИТЬ и безопасное обращение к составным ссылочным типам.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/subkonto", "1C accounting subconto",
		"Общие правила работы с бухгалтерскими субконто через регистры и планы счетов.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/parameters", "1C query and report parameters",
		"Параметры запросов, отчётов, ссылок, перечислений и списков.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/reports-vs-query", "1C reports vs direct query",
		"Когда использовать готовый отчет, а когда прямой read-only запрос.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/report-fast-path", "1C report analytics fast path",
		"Быстрый маршрут discovery для отчетной аналитики без широкого сканирования базы.");
	ДобавитьРесурс(Ресурсы, "1c://knowledge/query/payroll", "1C payroll and calculation registers",
		"Общие правила для ЗУП-подобных конфигураций, регистров расчёта и видов расчёта.");

	Возврат Ресурсы;

КонецФункции

Функция ЭтоРесурсЗнаний(URI) Экспорт
	Возврат СтрНачинаетсяС(Строка(URI), "1c://knowledge/query");
КонецФункции

Функция ПрочитатьРесурс(URI) Экспорт

	Если URI = "1c://knowledge/query" Тогда
		Возврат ТекстИндекс();
	ИначеЕсли URI = "1c://knowledge/query/syntax" Тогда
		Возврат ТекстСинтаксис();
	ИначеЕсли URI = "1c://knowledge/query/functions" Тогда
		Возврат ТекстФункции();
	ИначеЕсли URI = "1c://knowledge/query/optimization" Тогда
		Возврат ТекстОптимизация();
	ИначеЕсли URI = "1c://knowledge/query/temporary-tables" Тогда
		Возврат ТекстВременныеТаблицы();
	ИначеЕсли URI = "1c://knowledge/query/compound-types" Тогда
		Возврат ТекстСоставныеТипы();
	ИначеЕсли URI = "1c://knowledge/query/subkonto" Тогда
		Возврат ТекстСубконто();
	ИначеЕсли URI = "1c://knowledge/query/parameters" Тогда
		Возврат ТекстПараметры();
	ИначеЕсли URI = "1c://knowledge/query/reports-vs-query" Тогда
		Возврат ТекстОтчетИлиЗапрос();
	ИначеЕсли URI = "1c://knowledge/query/report-fast-path" Тогда
		Возврат ТекстБыстрыйПутьОтчетнойАналитики();
	ИначеЕсли URI = "1c://knowledge/query/payroll" Тогда
		Возврат ТекстPayroll();
	КонецЕсли;

	ВызватьИсключение "Knowledge resource not found: " + Строка(URI);

КонецФункции

