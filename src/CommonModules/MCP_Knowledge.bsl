Функция Guidance(Topic, QueryText, Intent, IncludeExamples = Ложь, MaxSections = 6) Экспорт

	Если MaxSections = Неопределено ИЛИ MaxSections <= 0 Тогда
		MaxSections = 6;
	КонецЕсли;

	Выбранные = Новый Массив;
	Тема = НРег(Строка(Topic));
	Контекст = СокрЛП(Строка(QueryText) + " " + Строка(Intent));

	Если (ПустаяСтрока(Тема) ИЛИ Тема = "auto") И ПустаяСтрока(Контекст) Тогда
		ДобавитьЕслиУникально(Выбранные, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Выбранные, ПодсказкаSafety());
	ИначеЕсли НЕ ПустаяСтрока(Тема) И Тема <> "auto" Тогда
		ДобавитьПодсказкиПоТеме(Выбранные, Тема);
	Иначе
		ЗаполнитьПодсказкиПоКонтексту(Выбранные, Контекст);
	КонецЕсли;

	Если Выбранные.Количество() = 0 Тогда
		ДобавитьЕслиУникально(Выбранные, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Выбранные, ПодсказкаSafety());
	КонецЕсли;

	Обрезанные = Новый Массив;
	Счетчик = 0;
	Для Каждого П Из Выбранные Цикл
		Если Счетчик >= MaxSections Тогда
			Прервать;
		КонецЕсли;
		Если IncludeExamples Тогда
			ДобавитьПример(П);
		КонецЕсли;
		Обрезанные.Добавить(П);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("configuration_agnostic", Истина);
	Результат.Вставить("source", "doc/skills");
	Результат.Вставить("topics", Темы());
	Результат.Вставить("guidance", Обрезанные);
	Возврат Результат;

КонецФункции

Функция ПодсказкиДляЗапроса(ТекстЗапроса) Экспорт

	Подсказки = Новый Массив;
	ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
	ЗаполнитьПодсказкиПоКонтексту(Подсказки, ТекстЗапроса);
	Если Подсказки.Количество() = 1 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	КонецЕсли;
	Возврат Подсказки;

КонецФункции

Функция ДоменныеПодсказки(ТекстКонтекста) Экспорт

	Результат = Новый Массив;
	Если ПустаяСтрока(ТекстКонтекста) Тогда
		Возврат Результат;
	КонецЕсли;

	// Пробельные последовательности сводятся к одному пробелу, потому что триггеры
	// ищут ключевые слова вместе с окружающими пробелами (" СОЕДИНЕНИЕ "). Без этого
	// подсказка терялась от обычного форматирования: перевод строки или отступ после
	// ключевого слова — нормальный стиль запроса, а не признак другого смысла.
	Текст = НормализоватьПробелыКонтекста(ВРег(Строка(ТекстКонтекста)));
	Для Каждого Описание Из РеестрДоменныхПодсказок() Цикл
		Если СрабатываетТриггерДоменнойПодсказки(Текст, Описание) Тогда
			ДобавитьЕслиУникально(Результат, ПодсказкаПоОписанию(Описание));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьДоменныеПодсказки(Результат, ТекстКонтекста) Экспорт

	Подсказки = ДоменныеПодсказки(ТекстКонтекста);
	Если Подсказки.Количество() > 0 Тогда
		Результат.Вставить("domain_guidance", Подсказки);
	КонецЕсли;

КонецПроцедуры

