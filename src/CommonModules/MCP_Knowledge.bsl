КонецФункции

Функция Guidance(Topic, QueryText, Intent, IncludeExamples = Ложь, MaxSections = 6) Экспорт

	Если MaxSections = Неопределено ИЛИ MaxSections <= 0 Тогда
		MaxSections = 6;
	КонецЕсли;

	Выбранные = Новый Массив;
	Тема = НРег(Строка(Topic));
	Контекст = СокрЛП(Строка(QueryText) + " " + Строка(Intent));

	Если (ПустаяСтрока(Тема) ИЛИ Тема = "auto") И ПустаяСтрока(Контекст) Тогда
		ДобавитьЕслиУникально(Выбранные, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Выбранные, ПодсказкаSafety());
	ИначеЕсли НЕ ПустаяСтрока(Тема) И Тема <> "auto" Тогда
		ДобавитьПодсказкиПоТеме(Выбранные, Тема);
	Иначе
		ЗаполнитьПодсказкиПоКонтексту(Выбранные, Контекст);
	КонецЕсли;

	Если Выбранные.Количество() = 0 Тогда
		ДобавитьЕслиУникально(Выбранные, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Выбранные, ПодсказкаSafety());
	КонецЕсли;

	Обрезанные = Новый Массив;
	Счетчик = 0;
	Для Каждого П Из Выбранные Цикл
		Если Счетчик >= MaxSections Тогда
			Прервать;
		КонецЕсли;
		Если IncludeExamples Тогда
			ДобавитьПример(П);
		КонецЕсли;
		Обрезанные.Добавить(П);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("configuration_agnostic", Истина);
	Результат.Вставить("source", "doc/skills");
	Результат.Вставить("topics", Темы());
	Результат.Вставить("guidance", Обрезанные);
	Возврат Результат;

КонецФункции

Функция ПодсказкиДляЗапроса(ТекстЗапроса) Экспорт

	Подсказки = Новый Массив;
	ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
	ЗаполнитьПодсказкиПоКонтексту(Подсказки, ТекстЗапроса);
	Если Подсказки.Количество() = 1 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	КонецЕсли;
	Возврат Подсказки;

КонецФункции

Процедура ЗаполнитьПодсказкиПоКонтексту(Подсказки, Контекст)

	Текст = ВРег(Строка(Контекст));

	Если СтрНайти(Текст, "ПОМЕСТИТЬ") > 0
		ИЛИ СтрНайти(Текст, "ВТ_") > 0
		ИЛИ СтрНайти(Текст, ";") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаTemporaryTables());
	КонецЕсли;

	Если СтрНайти(Текст, "ИМЕЮЩИЕ") > 0
		ИЛИ СтрНайти(Текст, "ИМЕЯ") > 0
		ИЛИ СтрНайти(Текст, "СГРУППИРОВАТЬ") > 0
		ИЛИ СтрНайти(Текст, "СУММА(") > 0
		ИЛИ СтрНайти(Текст, "КОЛИЧЕСТВО(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаGroupingHaving());
	КонецЕсли;

	Если СтрНайти(Текст, "СУБКОНТО") > 0
		ИЛИ СтрНайти(Текст, "РЕГИСТРБУХГАЛТЕРИИ") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSubconto());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingPatterns());
	КонецЕсли;

	Если СтрНайти(Текст, "ВЫРАЗИТЬ") > 0
		ИЛИ ТекстСодержитОператорССЫЛКА(Текст)
		ИЛИ СтрНайти(Текст, "РЕГИСТРАТОР.") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаCompoundTypes());
	КонецЕсли;

	Если СтрНайти(Текст, ".ОСТАТКИ(") > 0
		ИЛИ СтрНайти(Текст, ".ОБОРОТЫ(") > 0
		ИЛИ СтрНайти(Текст, ".ОСТАТКИИОБОРОТЫ(") > 0
		ИЛИ СтрНайти(Текст, ".СРЕЗПОСЛЕДНИХ(") > 0
		ИЛИ СтрНайти(Текст, ".СРЕЗПЕРВЫХ(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаVirtualTables());
	КонецЕсли;

	Если СтрНайти(Текст, " ЕСТЬ NULL") > 0
		ИЛИ СтрНайти(Текст, "= NULL") > 0
		ИЛИ СтрНайти(Текст, "ЕСТЬNULL(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаNullHandling());
	КонецЕсли;

	Если СтрНайти(Текст, " СОЕДИНЕНИЕ ") > 0
		ИЛИ СтрНайти(Текст, " JOIN ") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаJoins());
	КонецЕсли;

	Если СтрНайти(Текст, " ИЛИ ") > 0
		ИЛИ СтрНайти(Текст, "ПОДОБНО") > 0
		ИЛИ СтрНайти(Текст, "ПОДСТРОКА(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPerformance());
	КонецЕсли;

	Если СтрНайти(Текст, "&") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаParameters());
	КонецЕсли;

	ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());

КонецПроцедуры

Функция ТекстСодержитОператорССЫЛКА(Текст)

	Возврат СтрНайти(Текст, " ССЫЛКА ДОКУМЕНТ.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА СПРАВОЧНИК.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНСЧЕТОВ.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНВИДОВХАРАКТЕРИСТИК.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНВИДОВРАСЧЕТА.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНОБМЕНА.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА БИЗНЕСПРОЦЕСС.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ЗАДАЧА.") > 0;

КонецФункции

Процедура ДобавитьПодсказкиПоТеме(Подсказки, Тема)

	Если Тема = "metadata-first" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
	ИначеЕсли Тема = "query-structure" ИЛИ Тема = "tables-and-sources" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаQueryStructure());
	ИначеЕсли Тема = "virtual-tables" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаVirtualTables());
	ИначеЕсли Тема = "temporary-tables" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаTemporaryTables());
	ИначеЕсли Тема = "joins" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаJoins());
	ИначеЕсли Тема = "grouping-and-having" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаGroupingHaving());
	ИначеЕсли Тема = "functions" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаFunctions());
	ИначеЕсли Тема = "compound-types" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаCompoundTypes());
	ИначеЕсли Тема = "subkonto" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSubconto());
	ИначеЕсли Тема = "accounting-register-patterns" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingPatterns());
	ИначеЕсли Тема = "null-handling" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаNullHandling());
	ИначеЕсли Тема = "parameters" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаParameters());
	ИначеЕсли Тема = "performance-pitfalls" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPerformance());
	ИначеЕсли Тема = "mcp-query-safety" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	Иначе
		ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	КонецЕсли;

КонецПроцедуры

