Функция Подсказка(ID, Title, Instruction, ResourceURI, Severity)
	Стр = Новый Структура;
	Стр.Вставить("id", ID);
	Стр.Вставить("title", Title);
	Стр.Вставить("instruction", Instruction);
	Стр.Вставить("resource_uri", ResourceURI);
	Стр.Вставить("severity", Severity);
	Стр.Вставить("configuration_agnostic", Истина);
	Возврат Стр;
КонецФункции

Процедура ДобавитьПример(Подсказка)

	Если Подсказка.id = "grouping_having" Тогда
		Подсказка.Вставить("example", "ВЫБРАТЬ <Поле>, СУММА(<Ресурс>) КАК Итого ИЗ <Источник> СГРУППИРОВАТЬ ПО <Поле> ИМЕЮЩИЕ СУММА(<Ресурс>) > 0");
	ИначеЕсли Подсказка.id = "temporary_tables_read_only" Тогда
		Подсказка.Вставить("example", "ВЫБРАТЬ <Поля> ПОМЕСТИТЬ ВТ_Данные ИЗ <Источник> ГДЕ <Отбор> ИНДЕКСИРОВАТЬ ПО <Ключ>; ВЫБРАТЬ <Поля> ИЗ ВТ_Данные");
	ИначеЕсли Подсказка.id = "compound_type_cast" Тогда
		Подсказка.Вставить("example", "ГДЕ <Поле> ССЫЛКА <Тип>; ВЫРАЗИТЬ(<Поле> КАК <Тип>).<Реквизит>");
	ИначеЕсли Подсказка.id = "subconto_generic" Тогда
		Подсказка.Вставить("example", "1) get_accounting_accounts_map({account_code_prefix:\"<ПрефиксСчёта>\"}); 2) найти position нужного вида субконто; 3) использовать Субконто<position> или параметр Субконто виртуальной таблицы.");
	ИначеЕсли Подсказка.id = "virtual_table_parameters" Тогда
		Подсказка.Вставить("example", "<Регистр>.Остатки(&Дата, <Измерение> = &Значение) КАК Ост");
	ИначеЕсли Подсказка.id = "accounting_register_patterns" Тогда
		Подсказка.Вставить("example", "1) get_accounting_accounts_map({chart:\"ПланСчетов.<Имя>\", account_code_prefix:\"<Префикс>\"}); 2) передать массив видов субконто в параметр Субконто; 3) группировать по Субконто1 согласно порядку массива.");
	ИначеЕсли Подсказка.id = "accounting-balance-vs-turnover" Тогда
		Подсказка.Вставить("example", "Долг на конец 2024: РегистрБухгалтерии.<Имя>.Остатки(ДАТАВРЕМЯ(2025, 1, 1), , Счет = &Счет) КАК Остатки; обороты за 2024: ...Обороты(ДАТАВРЕМЯ(2024, 1, 1), ДАТАВРЕМЯ(2025, 1, 1), , Счет = &Счет).");
	ИначеЕсли Подсказка.id = "debtors_report_pattern" Тогда
		Подсказка.Вставить("example", "Дебиторка 2024: get_accounting_accounts_map({account_code_prefix:\"62\"}); найти счета 62.01/62.21/62.31 и position Контрагенты; затем ОстаткиИОбороты(&Начало2024,&Начало2025) + Остатки(&ТекущаяДата), группируя по УникальныйИдентификатор(Субконто<position>).");
	ИначеЕсли Подсказка.id = "accounting-register-turnovers-fields" Тогда
		Подсказка.Вставить("example", "Не пишите ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.62.01). Сначала get_accounting_accounts_map({account_code_prefix:\"62.01\"}), затем parameters:{Счет:{kind:\"ref\", type:\"ПланСчетов.<Имя>\", uuid:\"...\"}}; для Обороты используйте параметр Субконто и поля СуммаОборотДт/СуммаОборотКт.");
	ИначеЕсли Подсказка.id = "query_parameters" Тогда
		Подсказка.Вставить("example", "{""query"":""ВЫБРАТЬ ... ГДЕ х.Период >= &НачалоПериода И х.<Измерение> = &Ссылка"",""parameters"":{""НачалоПериода"":{""kind"":""datetime"",""value"":""2025-01-01T00:00:00""},""Удалён"":false,""Ссылка"":{""kind"":""ref"",""type"":""Справочник.<Имя>"",""uuid"":""<uuid из результата tool>""},""Список"":{""kind"":""array"",""value"":[""<Код1>"",""<Код2>""]}}}");
	ИначеЕсли Подсказка.id = "report_or_direct_query_choice" Тогда
		Подсказка.Вставить("example", "1) list_reports({query:\"<намерение пользователя>\", include_variants:true}); 2) если есть кандидаты, спросить: готовый отчет или прямой запрос; 3) выполнить выбранный путь.");
	ИначеЕсли Подсказка.id = "report_fast_path" Тогда
		Подсказка.Вставить("example", "Остатки товара: 1) search_objects({query:\"<товар>\", types:[\"Справочник.Номенклатура\"], limit:5}); 2) get_accounting_accounts_map({account_code_prefix:\"41\", limit:100}); 3) run_1c_query по РегистрБухгалтерии.<Имя>.Остатки с параметром Субконто и параметрами kind=ref/datetime/array.");
	ИначеЕсли Подсказка.id = "payroll_calculation_registers" Тогда
		Подсказка.Вставить("example", "1) get_database_passport({include_calculation_registers:true}); 2) list_metadata_objects({kinds:[\"РегистрРасчета\",\"ПланВидовРасчета\"]}); 3) get_calculation_types_map({plan:\"ПланВидовРасчета.<Имя>\"}); 4) строить запрос только по найденным полям.");
	ИначеЕсли Подсказка.id = "payroll-salary-source-selection" Тогда
		Подсказка.Вставить("example", "Бухгалтерский fallback для начисленной зарплаты за 2024: ...Обороты(ДАТАВРЕМЯ(2024, 1, 1), ДАТАВРЕМЯ(2025, 1, 1), , Счет = &Счет70, &ВидыСубконто) КАК Обороты; СУММА(Обороты.СуммаОборотКт). Дт 70 используйте только для выплат/уменьшения задолженности.");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЕслиУникально(МассивПодсказок, Подсказка)

	Для Каждого Существующая Из МассивПодсказок Цикл
		Если Существующая.id = Подсказка.id Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	МассивПодсказок.Добавить(Подсказка);

КонецПроцедуры

Процедура ДобавитьРесурс(Ресурсы, URI, Имя, Описание)
	Стр = Новый Структура;
	Стр.Вставить("uri", URI);
	Стр.Вставить("name", Имя);
	Стр.Вставить("description", Описание);
	Стр.Вставить("mimeType", "text/markdown");
	Ресурсы.Добавить(Стр);
КонецПроцедуры

Процедура ДобавитьТему(Темы, ID, Title, Summary, ResourceURI)
	Стр = Новый Структура;
	Стр.Вставить("id", ID);
	Стр.Вставить("title", Title);
	Стр.Вставить("summary", Summary);
	Стр.Вставить("resource_uri", ResourceURI);
	Темы.Добавить(Стр);
КонецПроцедуры

