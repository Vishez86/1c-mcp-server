Процедура ДобавитьПодсказкиПоТеме(Подсказки, Тема)

	Если Тема = "metadata-first" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
	ИначеЕсли Тема = "query-structure" ИЛИ Тема = "tables-and-sources" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаQueryStructure());
	ИначеЕсли Тема = "virtual-tables" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаVirtualTables());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
	ИначеЕсли Тема = "temporary-tables" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаTemporaryTables());
	ИначеЕсли Тема = "joins" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаJoins());
	ИначеЕсли Тема = "grouping-and-having" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаGroupingHaving());
	ИначеЕсли Тема = "functions" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаFunctions());
	ИначеЕсли Тема = "compound-types" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаCompoundTypes());
	ИначеЕсли Тема = "subkonto" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSubconto());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingTurnoversFields());
	ИначеЕсли Тема = "accounting-register-patterns" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingPatterns());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingTurnoversFields());
	ИначеЕсли Тема = "null-handling" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаNullHandling());
	ИначеЕсли Тема = "parameters" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаParameters());
	ИначеЕсли Тема = "reports-vs-query" ИЛИ Тема = "reports" ИЛИ Тема = "report-or-query" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаReportsVsDirectQuery());
	ИначеЕсли Тема = "report-fast-path" ИЛИ Тема = "fast-report-path" ИЛИ Тема = "analytics-fast-path" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаFastReportPath());
	ИначеЕсли Тема = "payroll-and-hr" ИЛИ Тема = "payroll" ИЛИ Тема = "calculation-registers" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPayroll());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPayrollSalarySource());
	ИначеЕсли Тема = "performance-pitfalls" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPerformance());
	ИначеЕсли Тема = "mcp-query-safety" Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	Иначе
		ДобавитьЕслиУникально(Подсказки, ПодсказкаMetadataFirst());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());
	КонецЕсли;

КонецПроцедуры

