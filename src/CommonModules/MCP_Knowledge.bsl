			+ "В бухгалтерском регистре используйте виртуальную таблицу Обороты(&Нач, &Кон, ..., Счет = &Счет70) и поле СуммаОборотКт, предварительно получив счет и вид субконто через get_accounting_accounts_map; не стройте зарплатную аналитику через основную таблицу движений + .Субконто, если не требуется детальная корреспонденция проводок.",
		"1c://knowledge/query/payroll",
		"high",
		"payroll",
		"ЗАРПЛАТ,НАЧИСЛЕН,НАЧИСЛЕНО,ОПЛАТА ТРУДА",
		"ИНН,ФИО,70"));
	Реестр.Добавить(ЭлементДоменнойПодсказки(
		"document_tabular_register_join_fanout",
		"Не умножайте строки табличной части движениями",
		"Не соединяйте табличную часть документа с регистром движений только по Регистратор = Ссылка, если суммируете поля табличной части. "
			+ "У одного документа может быть несколько движений регистра, поэтому Количество/Сумма табличной части умножатся на число подходящих движений. "
			+ "Для проверки наличия движения используйте подзапрос РАЗЛИЧНЫЕ Регистратор, СУЩЕСТВУЕТ или В; для детальной сверки связывайте движение с конкретной строкой/аналитикой "
			+ "(например НомерСтроки, субконто, номенклатура) или запускайте типовой отчет/вариант отчета.",
		"1c://knowledge/query/optimization",
		"high",
		"document_register_join",
		"",
		""));
	Возврат Реестр;

КонецФункции

Функция ЭлементДоменнойПодсказки(ID, Title, Instruction, ResourceURI, Severity, TriggerType, TriggerKeys, SecondaryKeys)

	Элемент = Новый Структура;
	Элемент.Вставить("id", ID);
	Элемент.Вставить("title", Title);
	Элемент.Вставить("instruction", Instruction);
	Элемент.Вставить("resource_uri", ResourceURI);
	Элемент.Вставить("severity", Severity);
	Элемент.Вставить("trigger_type", TriggerType);
	Элемент.Вставить("trigger_keys", TriggerKeys);
	Элемент.Вставить("secondary_keys", SecondaryKeys);
	Возврат Элемент;

КонецФункции

// Переводы строк, возвраты каретки и табуляции превращаются в пробелы, затем кратные
// пробелы сжимаются в один. Текст используется только для поиска ключевых слов, поэтому
// исходное форматирование в нём не несёт смысла.
Функция НормализоватьПробелыКонтекста(Текст)

	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " "), Символы.ВК, " "), Символы.Таб, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат " " + СокрЛП(Результат) + " ";

КонецФункции

Функция СрабатываетТриггерДоменнойПодсказки(Текст, Описание)

	Если Описание.trigger_type = "any" Тогда
		Возврат СодержитЛюбое(Текст, Описание.trigger_keys);
	ИначеЕсли Описание.trigger_type = "accounting_balance" Тогда
		Возврат СодержитЛюбое(Текст, Описание.trigger_keys)
			И СодержитЛюбое(Текст, Описание.secondary_keys);
	ИначеЕсли Описание.trigger_type = "payroll" Тогда
		Возврат СодержитЛюбое(Текст, Описание.trigger_keys)
			ИЛИ (СтрНайти(Текст, "СОТРУДНИК") > 0 И СодержитЛюбое(Текст, Описание.secondary_keys))
			ИЛИ (СтрНайти(Текст, "ОБОРОТКТ") > 0 И СтрНайти(Текст, "70") > 0);
	ИначеЕсли Описание.trigger_type = "document_register_join" Тогда
		СтарыйШаблон = СтрНайти(Текст, "ДОКУМЕНТ.") > 0
			И СтрНайти(Текст, "РЕГИСТР") > 0
			И СтрНайти(Текст, "РЕГИСТРАТОР") > 0
			И СтрНайти(Текст, ".ССЫЛКА") > 0
			И (СтрНайти(Текст, " СОЕДИНЕНИЕ ") > 0 ИЛИ СтрНайти(Текст, " JOIN ") > 0);
		ЕстественныйШаблон = СтрНайти(Текст, "ДОКУМЕНТ") > 0
			И СтрНайти(Текст, "ТАБЛИЧН") > 0
			И СтрНайти(Текст, "РЕГИСТР") > 0
			И (СтрНайти(Текст, "СОЕДИН") > 0 ИЛИ СтрНайти(Текст, "JOIN") > 0);
		Возврат СтарыйШаблон ИЛИ ЕстественныйШаблон;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция СодержитЛюбое(Текст, КлючиЧерезЗапятую)

	Для Каждого Ключ Из СтрРазделить(КлючиЧерезЗапятую, ",", Ложь) Цикл
		Ключ = ВРег(СокрЛП(Ключ));
		Если НЕ ПустаяСтрока(Ключ) И СтрНайти(Текст, Ключ) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПодсказкаПоОписанию(Описание)

	Возврат Подсказка(
		Описание.id,
		Описание.title,
		Описание.instruction,
		Описание.resource_uri,
		Описание.severity);

КонецФункции

Функция ДоменнаяПодсказкаПоID(ID)

	Для Каждого Описание Из РеестрДоменныхПодсказок() Цикл
		Если Описание.id = ID Тогда
			Возврат ПодсказкаПоОписанию(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Подсказка(ID, ID, "", Null, "medium");

КонецФункции

Процедура ЗаполнитьПодсказкиПоКонтексту(Подсказки, Контекст)

	Текст = ВРег(Строка(Контекст));

	Если СтрНайти(Текст, "ПОМЕСТИТЬ") > 0
		ИЛИ СтрНайти(Текст, "ВТ_") > 0
		ИЛИ СтрНайти(Текст, ";") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаTemporaryTables());
	КонецЕсли;

	Если СтрНайти(Текст, "ИМЕЮЩИЕ") > 0
		ИЛИ СтрНайти(Текст, "ИМЕЯ") > 0
		ИЛИ СтрНайти(Текст, "СГРУППИРОВАТЬ") > 0
		ИЛИ СтрНайти(Текст, "СУММА(") > 0
		ИЛИ СтрНайти(Текст, "КОЛИЧЕСТВО(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаGroupingHaving());
	КонецЕсли;

	Если СтрНайти(Текст, "СУБКОНТО") > 0
		ИЛИ СтрНайти(Текст, "РЕГИСТРБУХГАЛТЕРИИ") > 0
		ИЛИ СтрНайти(Текст, "ПЛАНСЧЕТОВ") > 0
		ИЛИ СтрНайти(Текст, "ХОЗРАСЧЕТН") > 0
		ИЛИ СтрНайти(Текст, "СЧЕТДТ") > 0
		ИЛИ СтрНайти(Текст, "СЧЕТКТ") > 0
		ИЛИ СтрНайти(Текст, "ОБОРОТЫДТКТ") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSubconto());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingPatterns());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingTurnoversFields());
	КонецЕсли;

	Если ТекстПохожНаСальдоИлиДолг(Текст) Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
	КонецЕсли;
	Если ТекстПохожНаДебиторскийОтчет(Текст) Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаDebtorsReport());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаSubconto());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingPatterns());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingTurnoversFields());
	КонецЕсли;

	Если ТекстПохожНаОтчетнуюАналитику(Текст) Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаFastReportPath());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаReportsVsDirectQuery());
	КонецЕсли;

	Если СтрНайти(Текст, "РЕГИСТРРАСЧЕТА") > 0
		ИЛИ СтрНайти(Текст, "ПЛАНВИДОВРАСЧЕТА") > 0
		ИЛИ СтрНайти(Текст, "ЗАРПЛАТ") > 0
		ИЛИ СтрНайти(Текст, "НАЧИСЛ") > 0
		ИЛИ СтрНайти(Текст, "УДЕРЖ") > 0
		ИЛИ СтрНайти(Текст, "СОТРУДНИК") > 0
		ИЛИ СтрНайти(Текст, "ФИЗИЧЕСК") > 0
		ИЛИ СтрНайти(Текст, "КАДР") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPayroll());
	КонецЕсли;
	Если ТекстПохожНаЗарплатныйЗапрос(Текст) Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPayrollSalarySource());
	КонецЕсли;

	Если СтрНайти(Текст, "ВЫРАЗИТЬ") > 0
		ИЛИ ТекстСодержитОператорССЫЛКА(Текст)
		ИЛИ СтрНайти(Текст, "РЕГИСТРАТОР.") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаCompoundTypes());
	КонецЕсли;

	Если СтрНайти(Текст, ".ОСТАТКИ(") > 0
		ИЛИ СтрНайти(Текст, ".ОБОРОТЫ(") > 0
		ИЛИ СтрНайти(Текст, ".ОСТАТКИИОБОРОТЫ(") > 0
		ИЛИ СтрНайти(Текст, ".СРЕЗПОСЛЕДНИХ(") > 0
		ИЛИ СтрНайти(Текст, ".СРЕЗПЕРВЫХ(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаVirtualTables());
		ДобавитьЕслиУникально(Подсказки, ПодсказкаAccountingBalanceVsTurnover());
	КонецЕсли;

	Если СтрНайти(Текст, " ЕСТЬ NULL") > 0
		ИЛИ СтрНайти(Текст, "= NULL") > 0
		ИЛИ СтрНайти(Текст, "ЕСТЬNULL(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаNullHandling());
	КонецЕсли;

	Если СтрНайти(Текст, " СОЕДИНЕНИЕ ") > 0
		ИЛИ СтрНайти(Текст, " JOIN ") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаJoins());
	КонецЕсли;

	Если СтрНайти(Текст, " ИЛИ ") > 0
		ИЛИ СтрНайти(Текст, "ПОДОБНО") > 0
		ИЛИ СтрНайти(Текст, "ПОДСТРОКА(") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаPerformance());
	КонецЕсли;

	Если СтрНайти(Текст, "&") > 0 Тогда
		ДобавитьЕслиУникально(Подсказки, ПодсказкаParameters());
	КонецЕсли;

	ДобавитьЕслиУникально(Подсказки, ПодсказкаSafety());

КонецПроцедуры

Функция ТекстСодержитОператорССЫЛКА(Текст)

	Возврат СтрНайти(Текст, " ССЫЛКА ДОКУМЕНТ.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА СПРАВОЧНИК.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНСЧЕТОВ.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНВИДОВХАРАКТЕРИСТИК.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНВИДОВРАСЧЕТА.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ПЛАНОБМЕНА.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА БИЗНЕСПРОЦЕСС.") > 0
		ИЛИ СтрНайти(Текст, " ССЫЛКА ЗАДАЧА.") > 0;

КонецФункции

Функция ТекстПохожНаСальдоИлиДолг(Текст)

	Возврат СтрНайти(Текст, "ОСТАТОК") > 0
		ИЛИ СтрНайти(Текст, "ОСТАТК") > 0
		ИЛИ СтрНайти(Текст, "САЛЬДО") > 0
		ИЛИ СтрНайти(Текст, "ДОЛГ") > 0
		ИЛИ СтрНайти(Текст, "ЗАДОЛЖЕН") > 0
		ИЛИ СтрНайти(Текст, "НА КОНЕЦ") > 0
		ИЛИ СтрНайти(Текст, "НА ДАТУ") > 0
		ИЛИ СтрНайти(Текст, "BALANCE") > 0
		ИЛИ СтрНайти(Текст, "DEBT") > 0
		ИЛИ СтрНайти(Текст, "AS OF") > 0;

КонецФункции

Функция ТекстПохожНаДебиторскийОтчет(Текст)

	Возврат СтрНайти(Текст, "ДЕБИТОР") > 0
		ИЛИ СтрНайти(Текст, "ПОКУПАТЕЛ") > 0
		ИЛИ СтрНайти(Текст, "ЗАКАЗЧИК") > 0
		ИЛИ СтрНайти(Текст, "ОТГРУЗК") > 0
		ИЛИ СтрНайти(Текст, "ОПЛАТ") > 0
		ИЛИ СтрНайти(Текст, "RECEIVABLE") > 0
		ИЛИ СтрНайти(Текст, "DEBTOR") > 0;

КонецФункции

Функция ТекстПохожНаЗарплатныйЗапрос(Текст)

	Возврат СтрНайти(Текст, "ЗАРПЛАТ") > 0
		ИЛИ СтрНайти(Текст, "НАЧИСЛЕН") > 0
		ИЛИ СтрНайти(Текст, "НАЧИСЛЕНО") > 0
		ИЛИ СтрНайти(Текст, "ОПЛАТА ТРУДА") > 0
		ИЛИ (СтрНайти(Текст, "СОТРУДНИК") > 0
			И (СтрНайти(Текст, "ИНН") > 0
				ИЛИ СтрНайти(Текст, "ФИО") > 0
				ИЛИ СтрНайти(Текст, "70") > 0));

КонецФункции

Функция ТекстПохожНаОтчетнуюАналитику(Текст)

	Возврат СтрНайти(Текст, "ПРОДАЖ") > 0
		ИЛИ СтрНайти(Текст, "РЕАЛИЗАЦ") > 0
		ИЛИ СтрНайти(Текст, "ВЫРУЧ") > 0
		ИЛИ СтрНайти(Текст, "ПРИБЫЛ") > 0
		ИЛИ СтрНайти(Текст, "РЕНТАБЕЛ") > 0
		ИЛИ СтрНайти(Текст, "МАРЖ") > 0
		ИЛИ СтрНайти(Текст, "НОМЕНКЛАТУР") > 0
		ИЛИ СтрНайти(Текст, "ОТЧЕТ") > 0
		ИЛИ СтрНайти(Текст, "ОТЧЁТ") > 0
		ИЛИ СтрНайти(Текст, "АНАЛИЗ") > 0
		ИЛИ СтрНайти(Текст, "ВЕДОМОСТ") > 0
		ИЛИ СтрНайти(Текст, "ОБОРОТ") > 0
		ИЛИ СтрНайти(Текст, "ОСТАТОК") > 0
		ИЛИ СтрНайти(Текст, "ОСТАТК") > 0
		ИЛИ СтрНайти(Текст, "ДИНАМИК") > 0
		ИЛИ СтрНайти(Текст, "БАЛАНС") > 0
		ИЛИ СтрНайти(Текст, "REPORT") > 0
		ИЛИ СтрНайти(Текст, "ANALYSIS") > 0
		ИЛИ СтрНайти(Текст, "SALES") > 0
		ИЛИ СтрНайти(Текст, "REVENUE") > 0
		ИЛИ СтрНайти(Текст, "TURNOVER") > 0
		ИЛИ СтрНайти(Текст, "BALANCE") > 0
		ИЛИ СтрНайти(Текст, "STATEMENT") > 0;

