// MCP_Tools.bsl
// ====================================================================
// Каталог MCP tools и их dispatcher.
// Содержит описания всех read-only tools (name, title, description, inputSchema)
// и единую точку вызова MCP_Tools_Impl.
// ====================================================================

Функция СписокTools() Экспорт

	Результат = Новый Массив;

	Результат.Добавить(Tool_list_metadata_objects());
	Результат.Добавить(Tool_get_metadata_structure());
	Результат.Добавить(Tool_search_metadata_fields());
	Результат.Добавить(Tool_run_1c_query());
	Результат.Добавить(Tool_validate_1c_query());
	Результат.Добавить(Tool_get_1c_query_guidance());
	Результат.Добавить(Tool_list_registers());
	Результат.Добавить(Tool_get_accounting_accounts_map());
	Результат.Добавить(Tool_get_accounting_balances());
	Результат.Добавить(Tool_get_accounting_entries());
	Результат.Добавить(Tool_get_inventory_balances_by_item());
	Результат.Добавить(Tool_get_calculation_types_map());
	Результат.Добавить(Tool_get_database_passport());
	Результат.Добавить(Tool_get_object_by_ref());
	Результат.Добавить(Tool_find_object_by_id());
	Результат.Добавить(Tool_search_objects());
	Результат.Добавить(Tool_get_link_of_object());
	Результат.Добавить(Tool_find_references_to_object());
	Результат.Добавить(Tool_get_enum_values());
	Результат.Добавить(Tool_get_register_records());
	Результат.Добавить(Tool_get_document_movements());
	Результат.Добавить(Tool_list_reports());
	Результат.Добавить(Tool_get_report_info());
	Результат.Добавить(Tool_run_1c_report());
	Результат.Добавить(Tool_get_object_history());
	Результат.Добавить(Tool_get_current_user_context());

	Возврат Результат;

КонецФункции

// Главный dispatcher.
Функция ВыполнитьИнструмент(ИмяТула, Аргументы) Экспорт

	CorrelationID = Строка(Новый УникальныйИдентификатор);

	Если НЕ MCP_Security.ToolРазрешен(ИмяТула) Тогда
		Возврат СформироватьОшибкуРезультата(
			MCP_Errors.Код_AccessDenied(),
			"Tool недоступен текущему пользователю.",
			Новый Структура("tool", ИмяТула),
			CorrelationID);
	КонецЕсли;

	Попытка
		Данные = Неопределено;

		Если ИмяТула = "list_metadata_objects" Тогда
			Данные = MCP_Tools_Impl.ListMetadataObjects(Аргументы);
		ИначеЕсли ИмяТула = "get_metadata_structure" Тогда
			Данные = MCP_Tools_Impl.GetMetadataStructure(Аргументы);
		ИначеЕсли ИмяТула = "search_metadata_fields" Тогда
			Данные = MCP_Tools_Impl.SearchMetadataFields(Аргументы);
		ИначеЕсли ИмяТула = "run_1c_query" Тогда
			Данные = MCP_Tools_Impl.Run1CQuery(Аргументы);
		ИначеЕсли ИмяТула = "validate_1c_query" Тогда
			Данные = MCP_Tools_Impl.Validate1CQuery(Аргументы);
		ИначеЕсли ИмяТула = "get_1c_query_guidance" Тогда
			Данные = MCP_Tools_Impl.Get1CQueryGuidance(Аргументы);
		ИначеЕсли ИмяТула = "list_registers" Тогда
			Данные = MCP_Tools_Impl.ListRegisters(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_accounts_map" Тогда
			Данные = MCP_Tools_Impl.GetAccountingAccountsMap(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_balances" Тогда
			Данные = MCP_Tools_Impl.GetAccountingBalances(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_entries" Тогда
			Данные = MCP_Tools_Impl.GetAccountingEntries(Аргументы);
		ИначеЕсли ИмяТула = "get_inventory_balances_by_item" Тогда
			Данные = MCP_Tools_Impl.GetInventoryBalancesByItem(Аргументы);
		ИначеЕсли ИмяТула = "get_calculation_types_map" Тогда
			Данные = MCP_Tools_Impl.GetCalculationTypesMap(Аргументы);
		ИначеЕсли ИмяТула = "get_database_passport" Тогда
			Данные = MCP_Tools_Impl.GetDatabasePassport(Аргументы);
		ИначеЕсли ИмяТула = "get_object_by_ref" Тогда
			Данные = MCP_Tools_Impl.GetObjectByRef(Аргументы);
		ИначеЕсли ИмяТула = "find_object_by_id" Тогда
			Данные = MCP_Tools_Impl.FindObjectByID(Аргументы);
		ИначеЕсли ИмяТула = "search_objects" Тогда
			Данные = MCP_Tools_Impl.SearchObjects(Аргументы);
		ИначеЕсли ИмяТула = "get_link_of_object" Тогда
			Данные = MCP_Tools_Impl.GetLinkOfObject(Аргументы);
		ИначеЕсли ИмяТула = "find_references_to_object" Тогда
			Данные = MCP_Tools_Impl.FindReferencesToObject(Аргументы);
		ИначеЕсли ИмяТула = "get_enum_values" Тогда
			Данные = MCP_Tools_Impl.GetEnumValues(Аргументы);
		ИначеЕсли ИмяТула = "get_register_records" Тогда
			Данные = MCP_Tools_Impl.GetRegisterRecords(Аргументы);
		ИначеЕсли ИмяТула = "get_document_movements" Тогда
			Данные = MCP_Tools_Impl.GetDocumentMovements(Аргументы);
		ИначеЕсли ИмяТула = "list_reports" Тогда
			Данные = MCP_Tools_Impl.ListReports(Аргументы);
		ИначеЕсли ИмяТула = "get_report_info" Тогда
			Данные = MCP_Tools_Impl.GetReportInfo(Аргументы);
		ИначеЕсли ИмяТула = "run_1c_report" Тогда
			Данные = MCP_Tools_Impl.Run1CReport(Аргументы);
		ИначеЕсли ИмяТула = "get_object_history" Тогда
			Данные = MCP_Tools_Impl.GetObjectHistory(Аргументы);
		ИначеЕсли ИмяТула = "get_current_user_context" Тогда
			Данные = MCP_Tools_Impl.GetCurrentUserContext(Аргументы);
		Иначе
			Возврат СформироватьОшибкуРезультата(
				MCP_Errors.Код_UnknownTool(),
				"Unknown tool: " + ИмяТула,
				Новый Структура("tool", ИмяТула),
				CorrelationID);
		КонецЕсли;

		// Импл-функции должны возвращать Структуру. Если кто-то вернул иное —
		// конвертируем в пустую структуру, чтобы Данные.Вставить ниже не упало.
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			Данные = Новый Структура;
		КонецЕсли;
		Данные.Вставить("ok", Истина);
		ДобавитьКонтекстАвторизации(Данные, ПолныйКонтекстАвторизацииНужен(ИмяТула, Аргументы));
		ДобавитьИнформациюОМаскированииLLM(Данные);
		ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);
		ПроверитьРазмерРезультата(ДанныеДляLLM);
		БезопасноЗаписатьАудитУспеха(CorrelationID, ИмяТула, Аргументы, ДанныеДляLLM);
		Возврат СформироватьУспешныйРезультат(ДанныеДляLLM, Истина);

	Исключение
		ТекстИскл = ОписаниеОшибки();
		Ошибка = MCP_Errors.РазобратьИсключение(ТекстИскл, CorrelationID);
		БезопасноЗаписатьАудитОшибки(CorrelationID, ИмяТула, Аргументы, Ошибка);
		Возврат СформироватьОшибкуРезультата(Ошибка.code, Ошибка.message, Ошибка.details, CorrelationID);
	КонецПопытки;

КонецФункции

// ---- Сериализация tool result -------------------------------------

Функция СформироватьУспешныйРезультат(Данные, ДанныеУжеМаскированы = Ложь) Экспорт

	Если ДанныеУжеМаскированы Тогда
		ДанныеДляLLM = Данные;
	Иначе
		ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);
	КонецЕсли;

	Контент = Новый Массив;
	Блок = Новый Структура;
	Блок.Вставить("type", "text");
	Если MCP_Config.LegacyFullJSONContent() Тогда
		Блок.Вставить("text", MCP_JSONRPC.СохранитьJSON(ДанныеДляLLM));
	Иначе
		Блок.Вставить("text", СводкаУспешногоРезультата(ДанныеДляLLM));
	КонецЕсли;
	Контент.Добавить(Блок);

	Результат = Новый Структура;
	Результат.Вставить("content", Контент);
	Результат.Вставить("structuredContent", ДанныеДляLLM);
	Результат.Вставить("isError", Ложь);
	Возврат Результат;

КонецФункции

Функция СформироватьОшибкуРезультата(Код, Сообщение, Детали, CorrelationID) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("ok", Ложь);
	Данные.Вставить("message", Сообщение);
	ДобавитьКонтекстАвторизации(Данные, Ложь);
	Диагностика = ИзвлечьДиагностикуОшибки(Детали);
	ОшибкиВалидации = ИзвлечьОшибкиВалидации(Детали);
	Авторизация = АвторизацияИзОшибки(Код, Детали);

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ошибка.Вставить("details", ?(Детали = Неопределено, Новый Структура, Детали));
	Ошибка.Вставить("correlation_id", CorrelationID);
	Если Авторизация <> Неопределено Тогда
		Данные.Вставить("authorization", Авторизация);
		Ошибка.Вставить("authorization", Авторизация);
	КонецЕсли;
	Если Диагностика <> Неопределено Тогда
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "error_code");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "hint");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields_sample");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "see_also");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "platform_message");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "field");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "field_path");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "object");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "suggestions");
	КонецЕсли;
	Если ОшибкиВалидации <> Неопределено Тогда
		Данные.Вставить("validation_errors", ОшибкиВалидации);
		Ошибка.Вставить("validation_errors", ОшибкиВалидации);
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "validation_warnings");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "detected_objects");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "detected_parameters");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "estimated_risk");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "query_guidance");
	КонецЕсли;
	Данные.Вставить("error", Ошибка);
	ДобавитьИнформациюОМаскированииLLM(Данные);
	ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);

	Контент = Новый Массив;
	Блок = Новый Структура;
	Блок.Вставить("type", "text");
	Блок.Вставить("text", "Ошибка: " + Код + ". " + Сообщение + " correlation_id=" + CorrelationID);
	Контент.Добавить(Блок);
	Если MCP_Config.LegacyFullJSONContent() Тогда
		ДиагностическийБлок = Новый Структура;
		ДиагностическийБлок.Вставить("type", "text");
		ДиагностическийБлок.Вставить("text", "Диагностика JSON: " + MCP_JSONRPC.СохранитьJSON(ДанныеДляLLM));
		Контент.Добавить(ДиагностическийБлок);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("content", Контент);
	Результат.Вставить("structuredContent", ДанныеДляLLM);
	Результат.Вставить("isError", Истина);
	Возврат Результат;

КонецФункции

Процедура ДобавитьКонтекстАвторизации(Данные, ПолныйКонтекст = Ложь)

	Контекст = Новый Структура;
	ИмяПользователя = MCP_Security.ИмяТекущегоПользователя();
	ИмяБазы = "";
	ВерсияКонфигурации = "";
	Попытка
		ИмяБазы = Метаданные.Имя;
		ВерсияКонфигурации = Метаданные.Версия;
	Исключение
	КонецПопытки;
	Контекст.Вставить("identity_key", ИмяПользователя + "@" + ИмяБазы + "#" + ВерсияКонфигурации);
	Если ПолныйКонтекст Тогда
		Контекст.Вставить("user_name", ИмяПользователя);
		Контекст.Вставить("infobase_name", ИмяБазы);
		Контекст.Вставить("configuration_version", ВерсияКонфигурации);
		Контекст.Вставить("generated_at", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	КонецЕсли;

	ПолитикаКэша = Новый Структура;
	ПолитикаКэша.Вставить("cacheable", Ложь);
	ПолитикаКэша.Вставить("revalidate_each_call", Истина);
	Контекст.Вставить("cache_policy", ПолитикаКэша);

	Данные.Вставить("auth_context", Контекст);

КонецПроцедуры

Функция ПолныйКонтекстАвторизацииНужен(ИмяТула, Аргументы)

	Если ИмяТула = "get_current_user_context" Тогда
		Возврат Истина;
	КонецЕсли;

	Если MCP_Config.IncludeFullAuthContextByDefault() Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат MCP_Tools_Impl.Получить(Аргументы, "include_auth_context", Ложь);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция СводкаУспешногоРезультата(Данные)

	Части = Новый Массив;
	Части.Добавить("ok=true");

	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "rows", "rows");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "objects", "objects");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "fields", "fields");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "registers", "registers");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "accounts", "accounts");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "calculation_types", "calculation_types");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "matches", "matches");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "reports", "reports");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "values", "values");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "events", "events");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "references", "references");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "movements", "movements");

	Если ЗначениеПоляБулево(Данные, "truncated", Ложь) Тогда
		Части.Добавить("truncated=true");
	КонецЕсли;

	NextCursor = ЗначениеПоляСтрока(Данные, "next_cursor", "");
	Если НЕ ПустаяСтрока(NextCursor) Тогда
		Части.Добавить("next_cursor=" + NextCursor);
	КонецЕсли;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

Процедура ДобавитьРазмерКоллекцииВСводку(Части, Данные, ИмяПоля, Метка)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение)
			И (ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("ФиксированныйМассив")) Тогда
			Части.Добавить(Метка + "=" + Строка(Значение.Количество()));
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ЗначениеПоляБулево(Данные, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Функция ЗначениеПоляСтрока(Данные, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение) И Значение <> Null И Значение <> Неопределено Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Функция АвторизацияИзОшибки(Код, Детали)

	Авторизация = АвторизацияИзДеталей(Детали);
	Если Авторизация <> Неопределено Тогда
		Возврат НормализоватьАвторизациюОтказа(Авторизация, Код, Детали);
	КонецЕсли;

	Если Код <> MCP_Errors.Код_AccessDenied()
		И Код <> MCP_Errors.Код_TypeNotAllowed()
		И Код <> MCP_Errors.Код_FieldNotAllowed() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Авторизация = Новый Структура;
	Если Код = MCP_Errors.Код_TypeNotAllowed() Тогда
		Авторизация.Вставить("reason_code", "mcp_type_not_allowed");
	ИначеЕсли Код = MCP_Errors.Код_FieldNotAllowed() Тогда
		Авторизация.Вставить("reason_code", "mcp_field_not_allowed");
	ИначеЕсли Детали <> Неопределено И ЗначениеДеталей(Детали, "tool", "") <> "" Тогда
		Авторизация.Вставить("reason_code", "mcp_tool_not_allowed");
	Иначе
		Авторизация.Вставить("reason_code", "1c_access_denied");
	КонецЕсли;
	Авторизация.Вставить("denied_operation", "tool_call");
	Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	Если ЗначениеДеталей(Детали, "type", "") <> "" Тогда
		Авторизация.Вставить("denied_type", ЗначениеДеталей(Детали, "type", ""));
	КонецЕсли;
	Если ЗначениеДеталей(Детали, "field", "") <> "" Тогда
		Авторизация.Вставить("denied_field", ЗначениеДеталей(Детали, "field", ""));
	КонецЕсли;
	Если ЗначениеДеталей(Детали, "tool", "") <> "" Тогда
		Авторизация.Вставить("denied_tool", ЗначениеДеталей(Детали, "tool", ""));
	КонецЕсли;
	Возврат Авторизация;

КонецФункции

Функция АвторизацияИзДеталей(Детали)

	Если Детали = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Авторизация = Неопределено;
	Попытка
		Если Детали.Свойство("authorization", Авторизация) Тогда
			Возврат Авторизация;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ParsedDetails = Неопределено;
	Попытка
		Если Детали.Свойство("parsed_details", ParsedDetails) Тогда
			Если ParsedDetails.Свойство("authorization", Авторизация) Тогда
				Возврат Авторизация;
			КонецЕсли;
		КонецЕсли;
	Исключение
