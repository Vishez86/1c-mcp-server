// MCP_Reports.bsl
// ====================================================================
// Работа с отчётами 1С (СКД).
// list_reports / get_report_info / run_1c_report.
// ====================================================================

Функция СписокОтчетов(Запрос, IncludeVariants, IncludeNotAllowed, Лимит, Курсор) Экспорт

	Все = Новый Массив;
	Для Каждого ОМД Из Метаданные.Отчеты Цикл
		ПолноеИмя = "Отчет." + ОМД.Имя;
		Разрешен = MCP_Security.ТипРазрешен(ПолноеИмя);
		Если НЕ Разрешен И НЕ IncludeNotAllowed Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПустаяСтрока(Запрос) Тогда
			ПодходитПоПоиску = СтрНайти(ВРег(ОМД.Имя), ВРег(Запрос)) > 0
				ИЛИ СтрНайти(ВРег(ОМД.Синоним), ВРег(Запрос)) > 0;
			Если НЕ ПодходитПоПоиску Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("type", ПолноеИмя);
		Стр.Вставить("name", ОМД.Имя);
		Стр.Вставить("synonym", ОМД.Синоним);
		Стр.Вставить("description", ОМД.Комментарий);
		Стр.Вставить("allowed", Разрешен);
		Если IncludeVariants Тогда
			Стр.Вставить("variants", ПолучитьВарианты(ОМД));
		КонецЕсли;
		Все.Добавить(Стр);
	КонецЦикла;

	Все.Сортировать("name");

	// Пагинация по cursor (offset как строка).
	Смещение = 0;
	Если НЕ ПустаяСтрока(Курсор) Тогда
		Попытка
			Смещение = Число(Курсор);
		Исключение
			Смещение = 0;
		КонецПопытки;
	КонецЕсли;
	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = 100;
	КонецЕсли;

	Подсписок = Новый Массив;
	Для Каждого Стр Из Все Цикл
	КонецЦикла;

	Конец = Мин(Смещение + Лимит, Все.Количество());
	Подсписок = Новый Массив;
	Для Индекс = Смещение По Конец - 1 Цикл
		// Преобразуем структуру значений таблицы в обычную Структуру.
		Подсписок.Добавить(Все[Индекс]);
	КонецЦикла;

	NextCursor = Null;
	Если Конец < Все.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("reports", Подсписок);
	Результат.Вставить("next_cursor", NextCursor);
	Возврат Результат;

КонецФункции

Функция ПолучитьВарианты(ОМД)

	Варианты = Новый Массив;
	Попытка
		// СКД-варианты.
		КоллекцияВариантов = Неопределено;
		Если Метаданные.ХранилищеВариантовОтчетов <> Неопределено Тогда
			// Простой обход: возьмём только базовый вариант из СКД, если он есть.
		КонецЕсли;
		Если ОМД.ОсновнаяСхемаКомпоновкиДанных <> Неопределено Тогда
			Стр = Новый Структура;
			Стр.Вставить("name", "Основной");
			Стр.Вставить("presentation", "Основной");
			Варианты.Добавить(Стр);
		КонецЕсли;
	Исключение
		// Нет вариантов — пустой массив.
	КонецПопытки;
	Возврат Варианты;

КонецФункции

Функция ИнфоОтчета(ПолноеИмя, Вариант, IncludeSchema, IncludeVariants, IncludeDefaults) Экспорт

	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Отчёт запрещён: " + ПолноеИмя);
	КонецЕсли;

	ИмяОтчета = MCP_Security.ИмяОбъектаИзПолногоИмени(ПолноеИмя);
	ОМД = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не найден: " + ПолноеИмя);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", ПолноеИмя);
	Результат.Вставить("synonym", ОМД.Синоним);
	Результат.Вставить("variants", ?(IncludeVariants, ПолучитьВарианты(ОМД), Новый Массив));
	Результат.Вставить("parameters", ПолучитьПараметрыСКД(ОМД, IncludeDefaults));
	Форматы = Новый Массив;
	Форматы.Добавить("table");
	Форматы.Добавить("json");
	Форматы.Добавить("text");
	Результат.Вставить("output_formats", Форматы);
	Возврат Результат;

КонецФункции

Функция ПолучитьПараметрыСКД(ОМД, IncludeDefaults)

	Параметры = Новый Массив;
	Если ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Попытка
		Схема = ОМД.ПолучитьМакет(ОМД.ОсновнаяСхемаКомпоновкиДанных.Имя);
	Исключение
		Возврат Параметры;
	КонецПопытки;

	Если Схема = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Для Каждого П Из Схема.Параметры Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", П.Имя);
		Стр.Вставить("presentation", П.Заголовок);
		Стр.Вставить("type_description", Строка(П.ТипЗначения));
		Стр.Вставить("required", НЕ П.ИспользованиеОграничения.Доступность);
		Стр.Вставить("default", ?(IncludeDefaults, MCP_Values.Кодировать(П.ЗначениеПоУмолчанию), Null));
		Стр.Вставить("allowed_values", Новый Массив);
		Параметры.Добавить(Стр);
	КонецЦикла;
	Возврат Параметры;

КонецФункции

Функция ВыполнитьОтчет(ПолноеИмя, Вариант, ПараметрыОтчета, OutputFormat, Лимит, TimeoutSeconds, IncludeTotals) Экспорт

	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Отчёт запрещён: " + ПолноеИмя);
	КонецЕсли;

	ИмяОтчета = MCP_Security.ИмяОбъектаИзПолногоИмени(ПолноеИмя);
	ОМД = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не найден: " + ПолноеИмя);
	КонецЕсли;

	Если ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не поддерживает СКД и не имеет адаптера: " + ПолноеИмя);
	КонецЕсли;

	Схема = ОМД.ПолучитьМакет(ОМД.ОсновнаяСхемаКомпоновкиДанных.Имя);
	Если Схема = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Не удалось получить схему отчёта: " + ПолноеИмя);
	КонецЕсли;

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);

	УстановитьПараметрыКомпоновщика(Компоновщик, ПараметрыОтчета);

	Макет = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = Макет.Выполнить(Схема, Компоновщик.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанных"));

	ТЗ = Новый ТаблицаЗначений;
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);

	Вывод = Новый ВыводРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(ТЗ);
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Вывод.Вывести(Процессор);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;

	Если Длительность / 1000 > MCP_Config.Лимиты().report_timeout_seconds Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportTimeout(),
			"Отчёт выполнялся слишком долго: " + Длительность + " мс");
	КонецЕсли;

	МаксСтрок = Мин(?(Лимит = Неопределено, MCP_Config.Лимиты().max_report_rows, Лимит), MCP_Config.Лимиты().max_report_rows);

	Закодировано = MCP_Values.Кодировать(ТЗ);
	Усечено = Ложь;
	Строки = Новый Массив;
	Для Индекс = 0 По Мин(Закодировано.rows.Количество() - 1, МаксСтрок - 1) Цикл
		Строки.Добавить(Закодировано.rows[Индекс]);
	КонецЦикла;
	Если Закодировано.rows.Количество() > МаксСтрок Тогда
		Усечено = Истина;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", ПолноеИмя);
	Результат.Вставить("variant", Вариант);
	Результат.Вставить("columns", Закодировано.columns);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("row_count", Строки.Количество());
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("duration_ms", Длительность);
	Результат.Вставить("warnings", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыКомпоновщика(Компоновщик, ПараметрыОтчета)

	Если ПараметрыОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ПараметрыОтчета) = Тип("Структура") Тогда
		Для Каждого КЗ Из ПараметрыОтчета Цикл
			Значение = MCP_Values.ДекодироватьПараметр(КЗ.Значение);
			ЗначениеПараметра = Компоновщик.Настройки.ПараметрыДанных.НайтиПараметр(Новый ПараметрКомпоновкиДанных(КЗ.Ключ));
			Если ЗначениеПараметра <> Неопределено Тогда
				ЗначениеПараметра.Значение = Значение;
				ЗначениеПараметра.Использование = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
