// MCP_Reports.bsl
// ====================================================================
// Работа с отчётами 1С (СКД).
// list_reports / get_report_info / run_1c_report.
// ====================================================================

Функция СписокОтчетов(ПоисковыйЗапрос, IncludeVariants, IncludeNotAllowed, Лимит, Курсор) Экспорт

	// Используем ТЗ, чтобы отсортировать список по имени: cursor — это offset,
	// и без детерминированной сортировки одна и та же страница могла бы возвращать
	// разные строки между вызовами (особенно после обновления конфигурации).
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("name");
	Таблица.Колонки.Добавить("row");
	ЕстьФильтрПоТексту = НЕ ПустаяСтрока(ПоисковыйЗапрос);
	ФильтрВРег = ?(ЕстьФильтрПоТексту, ВРег(ПоисковыйЗапрос), "");
	Для Каждого ОМД Из Метаданные.Отчеты Цикл
		ПолноеИмя = "Отчет." + ОМД.Имя;
		Разрешен = ОтчетРазрешен(ПолноеИмя);
		Если НЕ Разрешен И НЕ IncludeNotAllowed Тогда
			Продолжить;
		КонецЕсли;

		Если ЕстьФильтрПоТексту Тогда
			ПодходитПоПоиску = СтрНайти(ВРег(ОМД.Имя), ФильтрВРег) > 0
				ИЛИ СтрНайти(ВРег(ОМД.Синоним), ФильтрВРег) > 0;
			Если НЕ ПодходитПоПоиску Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("type", ПолноеИмя);
		Стр.Вставить("name", ОМД.Имя);
		Стр.Вставить("synonym", ОМД.Синоним);
		Стр.Вставить("description", ОМД.Комментарий);
		Стр.Вставить("allowed", Разрешен);
		ПоддержкаВыполнения = ПоддержкаВыполненияОтчета(ОМД, ПолноеИмя);
		Стр.Вставить("execution_supported", ПоддержкаВыполнения.supported);
		Стр.Вставить("execution_reason", ПоддержкаВыполнения.reason);
		Если IncludeVariants Тогда
			Стр.Вставить("variants", ПолучитьВарианты(ОМД, ПолноеИмя));
		КонецЕсли;
		СтрокаТЗ = Таблица.Добавить();
		СтрокаТЗ.name = ОМД.Имя;
		СтрокаТЗ.row = Стр;
	КонецЦикла;
	Таблица.Сортировать("name");
	Все = Новый Массив;
	Для Каждого СтрокаТЗ Из Таблица Цикл
		Все.Добавить(СтрокаТЗ.row);
	КонецЦикла;

	// Пагинация по cursor (offset как строка).
	Смещение = 0;
	Если НЕ ПустаяСтрока(Курсор) Тогда
		Попытка
			Смещение = Цел(Число(Курсор));
		Исключение
			Смещение = 0;
		КонецПопытки;
	КонецЕсли;
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = 100;
	КонецЕсли;

	Конец = Мин(Смещение + Лимит, Все.Количество());
	Подсписок = Новый Массив;
	Если Смещение < Все.Количество() Тогда
		Для Индекс = Смещение По Конец - 1 Цикл
			// Преобразуем структуру значений таблицы в обычную Структуру.
			Подсписок.Добавить(Все[Индекс]);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если Конец < Все.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("reports", Подсписок);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("total_estimated", Все.Количество());
	Возврат Результат;

КонецФункции

Функция ПоддержкаВыполненияОтчета(ОМД, ПолноеИмя)

	Результат = Новый Структура;
	Результат.Вставить("supported", Истина);
	Результат.Вставить("reason", "skd");

	Если ОМД = Неопределено Тогда
		Результат.supported = Ложь;
		Результат.reason = "report_not_found";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Если ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
			Результат.supported = Ложь;
			Результат.reason = "no_skd_adapter";
			Возврат Результат;
		КонецЕсли;
	Исключение
		Результат.supported = Ложь;
		Результат.reason = "no_skd_adapter";
		Возврат Результат;
	КонецПопытки;

	Если ВРег(ПолноеИмя) = ВРег("Отчет.ДоходыРасходы") Тогда
		Результат.supported = Ложь;
		Результат.reason = "universal_output_unsupported";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьВарианты(ОМД, ПолноеИмя = "")

	Варианты = Новый Массив;
	ВидимыеИмена = Новый Соответствие;

	// Сначала — варианты СКД, если они объявлены в конфигурации.
	Попытка
		Для Каждого Вариант Из ОМД.ВариантыНастроек Цикл
			Если НЕ ПустаяСтрока(ПолноеИмя)
				И НЕ MCP_Security.ВариантОтчетаРазрешен(ПолноеИмя, Вариант.Имя) Тогда
				Продолжить;
			КонецЕсли;
			Если ВидимыеИмена.Получить(Вариант.Имя) = Неопределено Тогда
				Стр = Новый Структура;
				Стр.Вставить("name", Вариант.Имя);
				Стр.Вставить("presentation", ?(ПустаяСтрока(Вариант.Синоним), Вариант.Имя, Вариант.Синоним));
				Варианты.Добавить(Стр);
				ВидимыеИмена.Вставить(Вариант.Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Нет ВариантовНастроек — это нормально, перейдём к схеме напрямую.
	КонецПопытки;

	// Резервный «основной» вариант — на случай отчёта без явных вариантов.
	Если Варианты.Количество() = 0 Тогда
		Попытка
			Если ОМД.ОсновнаяСхемаКомпоновкиДанных <> Неопределено
				И (ПустаяСтрока(ПолноеИмя)
					ИЛИ MCP_Security.ВариантОтчетаРазрешен(ПолноеИмя, "Основной")) Тогда
				Стр = Новый Структура;
				Стр.Вставить("name", "Основной");
				Стр.Вставить("presentation", "Основной");
				Варианты.Добавить(Стр);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Варианты;

КонецФункции

Функция ИнфоОтчета(ПолноеИмя, Вариант, IncludeSchema, IncludeVariants, IncludeDefaults) Экспорт

	ПолноеИмя = ПолноеИмяОтчета(ПолноеИмя);
	Если НЕ ОтчетРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Отчёт запрещён: " + ПолноеИмя);
	КонецЕсли;
	ИмяЗапрошенногоВарианта = ИмяЯвногоВарианта(Вариант);
	Если НЕ ПустаяСтрока(ИмяЗапрошенногоВарианта)
		И НЕ MCP_Security.ВариантОтчетаРазрешен(ПолноеИмя, ИмяЗапрошенногоВарианта) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(),
			"Вариант отчёта запрещён: " + ИмяЗапрошенногоВарианта);
	КонецЕсли;

	ИмяОтчета = MCP_Security.ИмяОбъектаИзПолногоИмени(ПолноеИмя);
	ОМД = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не найден: " + ПолноеИмя);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", ПолноеИмя);
	Результат.Вставить("synonym", ОМД.Синоним);
	Результат.Вставить("variants", ?(IncludeVariants, ПолучитьВарианты(ОМД, ПолноеИмя), Новый Массив));
	Результат.Вставить("parameters", ПолучитьПараметрыСКД(ОМД, ИмяОтчета, IncludeDefaults));
	Форматы = Новый Массив;
	Форматы.Добавить("table");
	Форматы.Добавить("json");
	Форматы.Добавить("text");
	Результат.Вставить("output_formats", Форматы);
	// include_schema запрошен клиентом, но универсальный адаптер не возвращает
	// саму схему СКД (только параметры и варианты). Фиксируем явно, чтобы клиент
	// не считал, что отсутствие поля schema означает "схемы нет".
	Предупреждения = Новый Массив;
	Если IncludeSchema Тогда
		Предупреждения.Добавить("include_schema=true: подробная схема СКД пока не возвращается; доступны parameters и variants.");
	КонецЕсли;
	Результат.Вставить("warnings", Предупреждения);
	Возврат Результат;

КонецФункции

Функция ПолучитьПараметрыСКД(ОМД, ИмяОтчета, IncludeDefaults)

	Параметры = Новый Массив;
	Если ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Схема = ПолучитьОсновнуюСхемуСКД(ОМД, ИмяОтчета);

	Если Схема = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Для Каждого П Из Схема.Параметры Цикл
		ЗначениеПоУмолчанию = Null;
		Required = Ложь;
		Если IncludeDefaults Тогда
			Попытка
				ЗначениеПоУмолчанию = MCP_Values.Кодировать(П.ЗначениеПоУмолчанию);
				Required = П.ЗначениеПоУмолчанию = Неопределено;
			Исключение
				ЗначениеПоУмолчанию = Null;
				Required = Ложь;
			КонецПопытки;
		КонецЕсли;
		ДобавитьИлиОбновитьПараметрОтчета(Параметры, П.Имя, П.Заголовок,
			Строка(П.ТипЗначения), Required, ЗначениеПоУмолчанию);
	КонецЦикла;

	ДобавитьПараметрыИзОбъектаОтчета(Параметры, ИмяОтчета, IncludeDefaults);

	// В ряде отчётов параметры появляются только в настройках СКД, а не в
	// Схема.Параметры. Читаем их тем же универсальным компоновщиком, который
	// используется при выполнении отчёта.
	Попытка
		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		Если Схема.НастройкиПоУмолчанию <> Неопределено Тогда
			Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
		КонецЕсли;
		Попытка
			КоллекцияПараметровНастроек = Компоновщик.Настройки.ПараметрыДанных.Элементы;
		Исключение
			КоллекцияПараметровНастроек = Компоновщик.Настройки.ПараметрыДанных;
		КонецПопытки;
		Для Каждого ПарамНастройки Из КоллекцияПараметровНастроек Цикл
			ИмяПараметра = "";
			Представление = "";
			ТипПараметра = "";
			ЗначениеПоУмолчанию = Null;
			Попытка
				ИмяПараметра = Строка(ПарамНастройки.Параметр.Имя);
			Исключение
			КонецПопытки;
			Попытка
				Представление = Строка(ПарамНастройки.Параметр.Заголовок);
			Исключение
			КонецПопытки;
			Попытка
				ТипПараметра = Строка(ПарамНастройки.Параметр.ТипЗначения);
			Исключение
			КонецПопытки;
			Если ПустаяСтрока(ТипПараметра) Тогда
				Попытка
					ТипПараметра = Строка(ТипЗнч(ПарамНастройки.Значение));
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если IncludeDefaults Тогда
				Попытка
					ЗначениеПоУмолчанию = MCP_Values.Кодировать(ПарамНастройки.Значение);
				Исключение
					ЗначениеПоУмолчанию = Null;
				КонецПопытки;
			КонецЕсли;
			ДобавитьИлиОбновитьПараметрОтчета(Параметры, ИмяПараметра, Представление,
				ТипПараметра, Ложь, ЗначениеПоУмолчанию);
		КонецЦикла;
	Исключение
		// Не все версии платформы одинаково раскрывают коллекцию параметров
		// настроек; схема.Параметры выше остаётся безопасным минимумом.
	КонецПопытки;
	Возврат Параметры;

КонецФункции

Процедура ДобавитьПараметрыИзОбъектаОтчета(Параметры, ИмяОтчета, IncludeDefaults)

	Попытка
		ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
		КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек;
		Настройки = КомпоновщикНастроек.Настройки;
		Попытка
			КоллекцияПараметров = Настройки.ПараметрыДанных.Элементы;
		Исключение
			КоллекцияПараметров = Настройки.ПараметрыДанных;
		КонецПопытки;

		Для Каждого ЗначениеПараметра Из КоллекцияПараметров Цикл
			ИмяПараметра = "";
			Представление = "";
			ТипПараметра = "";
			ОписаниеПараметра = Неопределено;
			Попытка
				ИмяПараметра = Строка(ЗначениеПараметра.Параметр.Имя);
			Исключение
				Попытка
					ИмяПараметра = Строка(ЗначениеПараметра.Параметр);
				Исключение
				КонецПопытки;
			КонецПопытки;
			Попытка
				ОписаниеПараметра = КомпоновщикНастроек.Схема.ПараметрыДанных.НайтиПараметр(ЗначениеПараметра.Параметр);
			Исключение
				ОписаниеПараметра = Неопределено;
			КонецПопытки;
			Если ОписаниеПараметра <> Неопределено Тогда
				Попытка
					Представление = Строка(ОписаниеПараметра.Заголовок);
				Исключение
				КонецПопытки;
				Попытка
					ТипПараметра = Строка(ОписаниеПараметра.ТипЗначения);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если ПустаяСтрока(Представление) Тогда
				Попытка
					Представление = Строка(ЗначениеПараметра.Параметр.Заголовок);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если ПустаяСтрока(ТипПараметра) Тогда
				Попытка
					ТипПараметра = Строка(ЗначениеПараметра.Параметр.ТипЗначения);
				Исключение
				КонецПопытки;
			КонецЕсли;
			ЗначениеПоУмолчанию = Null;
			Если IncludeDefaults Тогда
				Попытка
					ЗначениеПоУмолчанию = MCP_Values.Кодировать(ЗначениеПараметра.Значение);
				Исключение
					ЗначениеПоУмолчанию = Null;
				КонецПопытки;
			КонецЕсли;
			ДобавитьИлиОбновитьПараметрОтчета(Параметры, ИмяПараметра, Представление,
				ТипПараметра, Ложь, ЗначениеПоУмолчанию);
		КонецЦикла;
	Исключение
		// Не каждый отчёт создаётся в серверном контексте; схема СКД выше остаётся fallback.
	КонецПопытки;

КонецПроцедуры

Процедура ДобавитьИлиОбновитьПараметрОтчета(Параметры, Имя, Представление, Тип, Required, DefaultValue)

	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Существующий Из Параметры Цикл
		Если ВРег(Существующий.name) = ВРег(Имя) Тогда
			Если ПустаяСтрока(ПолучитьПолеСтруктуры(Существующий, "presentation", "")) И НЕ ПустаяСтрока(Представление) Тогда
				Существующий.presentation = Представление;
			КонецЕсли;
			Если ПустаяСтрока(ПолучитьПолеСтруктуры(Существующий, "type", "")) И НЕ ПустаяСтрока(Тип) Тогда
				Существующий.Вставить("type", Тип);
				Существующий.Вставить("type_description", Тип);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Стр = Новый Структура;
	Стр.Вставить("name", Имя);
	Стр.Вставить("presentation", ?(ПустаяСтрока(Представление), Имя, Представление));
	Стр.Вставить("type", Тип);
	Стр.Вставить("type_description", Тип);
	Стр.Вставить("required", Required);
	Стр.Вставить("default_value", DefaultValue);
	Стр.Вставить("default", DefaultValue);
	Стр.Вставить("allowed_values", Новый Массив);
	Параметры.Добавить(Стр);

КонецПроцедуры

Функция ПолучитьПолеСтруктуры(СтруктураЗначений, ИмяПоля, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если СтруктураЗначений.Свойство(ИмяПоля, Значение) Тогда
			Если Значение = Null Тогда
				Возврат ЗначениеПоУмолчанию;
			КонецЕсли;
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ВыполнитьОтчет(ПолноеИмя, Вариант, ПараметрыОтчета, OutputFormat, Лимит, TimeoutSeconds, IncludeTotals, Курсор = "") Экспорт

	ПолноеИмя = ПолноеИмяОтчета(ПолноеИмя);
	Если НЕ ОтчетРазрешен(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(),
			"Отчёт запрещён: " + ПолноеИмя);
	КонецЕсли;
	ИмяВарианта = ИмяВариантаИлиОсновной(Вариант);
	Если НЕ MCP_Security.ВариантОтчетаРазрешен(ПолноеИмя, ИмяВарианта) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(),
			"Вариант отчёта запрещён: " + ИмяВарианта);
	КонецЕсли;
	Если ИмяВарианта <> "Основной" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportVariantNotFound(),
			"Выполнение варианта отчёта пока не реализовано универсальным адаптером: " + ИмяВарианта);
	КонецЕсли;

	ИмяОтчета = MCP_Security.ИмяОбъектаИзПолногоИмени(ПолноеИмя);
	ОМД = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не найден: " + ПолноеИмя);
	КонецЕсли;

	Если ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Отчёт не поддерживает СКД и не имеет адаптера: " + ПолноеИмя);
	КонецЕсли;

	Схема = ПолучитьОсновнуюСхемуСКД(ОМД, ИмяОтчета);
	Если Схема = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportNotFound(),
			"Не удалось получить схему отчёта: " + ПолноеИмя);
	КонецЕсли;

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	// НастройкиПоУмолчанию могут отсутствовать у схемы — пропускаем загрузку,
	// иначе ЗагрузитьНастройки(Неопределено) выбросит исключение.
	Если Схема.НастройкиПоУмолчанию <> Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	КонецЕсли;

	УстановитьПараметрыКомпоновщика(Компоновщик, ПараметрыОтчета);

	Старт = ТекущиеМиллисекундыUTC();
	Попытка
		Макет = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = Макет.Выполнить(Схема, Компоновщик.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		ТЗ = Новый ТаблицаЗначений;
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(МакетКомпоновки);

		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(ТЗ);
		Вывод.Вывести(Процессор);
		Длительность = ТекущиеМиллисекундыUTC() - Старт;
	Исключение
		Длительность = ТекущиеМиллисекундыUTC() - Старт;
		Возврат РезультатНеподдержанногоВыводаОтчета(
			ПолноеИмя, ИмяВарианта, OutputFormat, IncludeTotals, Длительность, ОписаниеОшибки());
	КонецПопытки;

	ПорогTimeout = ?(TimeoutSeconds = Неопределено, MCP_Config.Лимиты().report_timeout_seconds, TimeoutSeconds);
	Если Длительность / 1000 > ПорогTimeout Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ReportTimeout(),
			"Отчёт выполнялся слишком долго: " + Длительность + " мс");
	КонецЕсли;

	МаксСтрок = Мин(?(Лимит = Неопределено, MCP_Config.Лимиты().max_report_rows, Лимит), MCP_Config.Лимиты().max_report_rows);
	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	// Кодируем только колонки и строки текущей страницы, чтобы не тратить память
	// и не упираться в max_result_json_bytes на больших отчётах.
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Колонки = Новый Массив;
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		КС = Новый Структура;
		КС.Вставить("name", Колонка.Имя);
		КС.Вставить("type_description", Строка(Колонка.ТипЗначения));
		Колонки.Добавить(КС);
	КонецЦикла;

	ВсегоСтрок = ТЗ.Количество();
	Конец = Мин(Смещение + МаксСтрок, ВсегоСтрок);
	Строки = Новый Массив;
	Для Индекс = Смещение По Конец - 1 Цикл
		СтрокаТаблицы = ТЗ[Индекс];
		СтрокаJSON = Новый Соответствие;
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			СтрокаJSON.Вставить(Колонка.Имя, MCP_Values.Кодировать(СтрокаТаблицы[Колонка.Имя], ОпцииВалью));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
	КонецЦикла;

	NextCursor = Null;
	Если Конец < ВсегоСтрок Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", ПолноеИмя);
	// Возвращаем фактически выполненный вариант, а не пользовательский ввод:
	// если клиент передал Null/пустую строку, он должен видеть, что отчёт
	// выполнен под именем "Основной".
	Результат.Вставить("variant", ИмяВарианта);
	Результат.Вставить("execution_supported", Истина);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("row_count", Строки.Количество());
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("total_estimated", ВсегоСтрок);
	Результат.Вставить("duration_ms", Длительность);
	Предупреждения = Новый Массив;
	Если OutputFormat <> Неопределено И OutputFormat <> "table" И OutputFormat <> "json" Тогда
		Предупреждения.Добавить("output_format=" + OutputFormat + " не реализован, возвращены табличные данные.");
	КонецЕсли;
	Если IncludeTotals Тогда
		// Параметр принят, но итоги пока не извлекаются — фиксируем явно, чтобы клиент
		// не считал, что totals=пустая структура означает "итогов нет".
		Предупреждения.Добавить("include_totals=true пока не поддержан: итоги отчёта не извлекаются.");
	КонецЕсли;
	Результат.Вставить("warnings", Предупреждения);
	Возврат Результат;

КонецФункции

Функция РезультатНеподдержанногоВыводаОтчета(ПолноеИмя, ИмяВарианта, OutputFormat, IncludeTotals, Длительность, ТекстОшибки)

	Предупреждения = Новый Массив;
	Предупреждения.Добавить(
		"Отчёт не может быть выведен в коллекцию значений универсальным адаптером. "
		+ "Чаще всего причина в таблицах/диаграммах СКД. Нужен отдельный адаптер отчёта "
		+ "или fallback в ТабличныйДокумент.");
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Предупреждения.Добавить("raw_exception: " + ТекстОшибки);
	КонецЕсли;
	Если OutputFormat <> Неопределено И OutputFormat <> "table" И OutputFormat <> "json" Тогда
		Предупреждения.Добавить("output_format=" + OutputFormat + " не реализован, табличные данные не сформированы.");
	КонецЕсли;
	Если IncludeTotals Тогда
		Предупреждения.Добавить("include_totals=true пока не поддержан: итоги отчёта не извлекаются.");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", ПолноеИмя);
	Результат.Вставить("variant", ИмяВарианта);
	Результат.Вставить("execution_supported", Ложь);
	Результат.Вставить("columns", Новый Массив);
	Результат.Вставить("rows", Новый Массив);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("row_count", 0);
	Результат.Вставить("truncated", Ложь);
	Результат.Вставить("next_cursor", Null);
	Результат.Вставить("total_estimated", 0);
	Результат.Вставить("duration_ms", Длительность);
	Результат.Вставить("warnings", Предупреждения);
	Возврат Результат;

КонецФункции

Функция ПолучитьОсновнуюСхемуСКД(ОМД, ИмяОтчета)

	Если ОМД = Неопределено ИЛИ ОМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяМакета = ОМД.ОсновнаяСхемаКомпоновкиДанных.Имя;

	// В обычной конфигурации макет отчёта получает менеджер Отчеты[Имя],
	// а не объект метаданных. Старый путь оставлен fallback'ом для совместимости.
	Попытка
		Возврат Отчеты[ИмяОтчета].ПолучитьМакет(ИмяМакета);
	Исключение
	КонецПопытки;

	Попытка
		Возврат Отчеты[ИмяОтчета].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
	КонецПопытки;

	Попытка
		Возврат ОМД.ПолучитьМакет(ИмяМакета);
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ИмяЯвногоВарианта(Вариант)

	Если Вариант = Неопределено ИЛИ Вариант = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Вариант));

КонецФункции

Функция ИмяВариантаИлиОсновной(Вариант)

	Имя = ИмяЯвногоВарианта(Вариант);
	Если ПустаяСтрока(Имя) Тогда
		Возврат "Основной";
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ПолноеИмяОтчета(ИмяОтчета)

	Имя = СокрЛП(Строка(ИмяОтчета));
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(Имя, ".") = 0 Тогда
		Возврат "Отчет." + Имя;
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ОтчетРазрешен(ИмяОтчета)

	ПолноеИмя = ПолноеИмяОтчета(ИмяОтчета);
	Если НЕ СтрНачинаетсяС(ВРег(ПолноеИмя), ВРег("Отчет.")) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат MCP_Security.ТипРазрешен(ПолноеИмя);

КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Процедура УстановитьПараметрыКомпоновщика(Компоновщик, ПараметрыОтчета)

	Если ПараметрыОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// ПрочитатьJSON может вернуть и Структуру, и Соответствие в зависимости от настроек.
	// Поэтому обрабатываем оба варианта одинаково.
	ТипКонтейнера = ТипЗнч(ПараметрыОтчета);
	Если ТипКонтейнера <> Тип("Структура")
		И ТипКонтейнера <> Тип("ФиксированнаяСтруктура")
		И ТипКонтейнера <> Тип("Соответствие")
		И ТипКонтейнера <> Тип("ФиксированноеСоответствие") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КЗ Из ПараметрыОтчета Цикл
		ИмяПараметра = Строка(КЗ.Ключ);
		Если ПустаяСтрока(ИмяПараметра) Тогда
			Продолжить;
		КонецЕсли;
		Значение = MCP_Values.ДекодироватьПараметр(КЗ.Значение);
		ЗначениеПараметра = Компоновщик.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
		Если ЗначениеПараметра <> Неопределено Тогда
			ЗначениеПараметра.Значение = Значение;
			ЗначениеПараметра.Использование = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ТекущиеМиллисекундыUTC()
	Возврат (ТекущаяУниверсальнаяДата() - '19700101') * 1000;
КонецФункции
