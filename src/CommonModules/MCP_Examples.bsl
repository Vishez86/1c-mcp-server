// MCP_Examples.bsl
// ====================================================================
// Самообучение на успешных запросах run_1c_query.
// Запись обезличенных шаблонов в журнал регистрации (событие
// "MCP.QueryExample", уровень Информация) и их чтение/ранжирование для
// read-only tool get_query_examples.
//
// Хранилище — только ЖР; расширение не добавляет собственных объектов данных.
// Классификация: operational metadata write (постоянные бизнес-данные 1С
// не изменяются). Feature строго opt-in (MCP_Config.QueryExamplesВключены).
//
// Конвейер обезличивания (§6 ТЗ):
//   1) срез комментариев + замена литералов/параметров плейсхолдерами;
//   2) СхемаЗапроса: валидация, сбор tables, канонизация идентификаторов,
//      регенерация текста (skeleton = ПолучитьТекстЗапроса());
//   3) SHA-256 от НРег(skeleton).
//
// Fail-closed: любой сбой на стадии СхемаЗапроса => пример НЕ записывается
// (недостоверные tables/частично обезличенный текст недопустимы). Обращения к
// объектной модели НЕ оборачиваются в локальные Попытка — исключение доходит
// до внешнего catch в ЗаписатьПример, который пишет диагностику skip.
// ====================================================================

// --------------------------------------------------------------------
// 1. Публичный интерфейс
// --------------------------------------------------------------------

// Записать шаблон успешного запроса. Вызывается из MCP_Tools_Impl.Run1CQuery
// после успешного возврата MCP_Query.ВыполнитьЗапросСОграничениями и только
// при пустом cursor (первая страница). Сбой записи не должен ронять run_1c_query.
Процедура ЗаписатьПример(Знач ТекстЗапроса, Знач Результат, Знач CorrelationID = "") Экспорт

	Попытка
		Если НЕ MCP_Config.QueryExamplesВключены() Тогда
			Возврат;
		КонецЕсли;

		Настройки = MCP_Config.НастройкиQueryExamples();
		Диаг = Новый Структура("reason", "");
		Шаблон = ПостроитьШаблон(ТекстЗапроса, Настройки.max_skeleton_chars, Диаг);
		Если Шаблон = Неопределено Тогда
			// Мягкий пропуск (необойдённый ВЫБРАТЬ / нет таблиц / неподдерж. конструкция / длинно).
			// В debug-режиме пишем КАТЕГОРИЮ причины (без пользовательских данных) — канал отладки
			// покрытия токен-парсера при слепой верификации на контуре.
			Если Настройки.debug_skip Тогда
				ЗаписатьПропуск(CorrelationID, "soft :: " + Диаг.reason);
			КонецЕсли;
			Возврат;
		КонецЕсли;

		КоличествоСтрок = ЦелоеИзПоля(Результат, "row_count", 0);
		Комментарий = КомментарийСобытия(Шаблон, КоличествоСтрок, CorrelationID);
		ЗаписьЖурналаРегистрации(
			"MCP.QueryExample",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			Комментарий);
	Исключение
		// Жёсткий сбой (в т.ч. на стадии СхемаЗапроса): пример не записывается,
		// пишем только диагностику. Никогда не пробрасываем — run_1c_query не должен упасть.
		ЗаписатьПропуск(CorrelationID, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Прочитать и ранжировать шаблоны для tool get_query_examples.
// Аргументы уже нормализованы вызывающим (MCP_Tools_Impl.GetQueryExamples).
// Возвращает голую Структуру ответа (поле ok добавит диспетчер).
Функция ПолучитьПримеры(Знач ОбъектИмя, Знач Лимит, Знач ДнейНазад, Знач ТолькоСоСтроками) Экспорт

	Предупреждения = Новый Массив;
	Результат = Новый Структура;

	// §5.1: object нормализуется и проверяется ДО любого обращения к ЖР.
	КаноническоеИмя = "";
	Если ЗначениеЗаполнено(ОбъектИмя) Тогда
		ОМД = Метаданные.НайтиПоПолномуИмени(ОбъектИмя);
		Если ОМД = Неопределено Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
				"Объект метаданных не найден: " + ОбъектИмя);
		КонецЕсли;
		КаноническоеИмя = ОМД.ПолноеИмя();
		// Запрещённый/недоступный тип — стандартный отказ доступа (возбуждает исключение).
		MCP_Security.ПроверитьДоступКТипу(КаноническоеИмя);
	КонецЕсли;

	Сейчас = ТекущаяДатаСеанса();
	ДатаНачала = Сейчас - ДнейНазад * 86400;

	Результат.Вставить("object", КаноническоеИмя);
	Результат.Вставить("period", Новый Структура("from, to",
		Формат(ДатаНачала, "ДФ=yyyy-MM-dd"), Формат(Сейчас, "ДФ=yyyy-MM-dd")));
	Результат.Вставить("examples", Новый Массив);
	Результат.Вставить("scanned_events", 0);
	Результат.Вставить("scan_truncated", Ложь);
	Результат.Вставить("warnings", Предупреждения);

	// §7.3: feature выключен — enabled:false + source_available:false + query_examples_disabled.
	Если НЕ MCP_Config.QueryExamplesВключены() Тогда
		Результат.Вставить("enabled", Ложь);
		Результат.Вставить("source_available", Ложь);
		Предупреждения.Добавить("query_examples_disabled");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("enabled", Истина);

	// §7.1: нет права ПросмотрЖурналаРегистрации — деградация как в get_object_history.
	Если НЕ ПросмотрЖурналаДоступен() Тогда
		Результат.Вставить("source_available", Ложь);
		Предупреждения.Добавить("event_log_not_available");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("source_available", Истина);

	Настройки = MCP_Config.НастройкиQueryExamples();
	Выгрузка = ПрочитатьСобытияПримеров(ДатаНачала, Настройки.scan_cap);
	Результат.scanned_events = Выгрузка.count;
	Если Выгрузка.truncated Тогда
		Результат.scan_truncated = Истина;
		Предупреждения.Добавить("scan_truncated: часть окна не отсканирована, уменьшите days_back");
	КонецЕсли;

	Группы = СгруппироватьИОтфильтровать(Выгрузка.события, КаноническоеИмя, ТолькоСоСтроками);

	// §8: фильтрация по правам читателя — пример виден, только если каждая таблица разрешена.
	Разрешённые = Новый Массив;
	Для Каждого Гр Из Группы Цикл
		Если ТаблицыРазрешены(Гр.tables) Тогда
			Разрешённые.Добавить(Гр);
		КонецЕсли;
	КонецЦикла;

	Отсортированные = ОтсортироватьГруппы(Разрешённые);
	Для Каждого Гр Из Отсортированные Цикл
		Если Результат.examples.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Результат.examples.Добавить(ФорматироватьГруппу(Гр));
	КонецЦикла;

	// Read-only диагностика (dev-only, по умолчанию выключена): единственный
	// доступный способ прочитать skip-события, т.к. ЖР-by-event ридера среди tools нет.
	Если Настройки.debug_skip Тогда
		Результат.Вставить("diagnostics", ПрочитатьДиагностикуПропусков(ДатаНачала, Настройки.scan_cap));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// --------------------------------------------------------------------
// 2. Построение шаблона (обезличивание, §6)
// --------------------------------------------------------------------

// Возвращает Структуру {skeleton, skeleton_hash, tables, columns} либо
// Неопределено при мягком пропуске (нет реальных таблиц / необойдённый ВЫБРАТЬ /
// неподдерживаемая конструкция / skeleton длиннее лимита).
// Возбуждает исключение при жёстком сбое (ошибка стадии валидации/нормализации/хеша).
//
// РЕДИЗАЙН §6.4/§6.5 (объектная модель СхемаЗапроса на контуре недоступна):
//   - сбор tables и канонизация псевдонимов/ВТ/колонок выполняются ТОКЕН-парсером
//     (РазобратьЗапрос), платформо-независимо;
//   - СхемаЗапроса используется ТОЛЬКО для ВАЛИДАЦИИ (УстановитьТекстЗапроса — при
//     ошибке синтаксиса исключение => жёсткий пропуск) и НОРМАЛИЗАЦИИ текста
//     (ПолучитьТекстЗапроса — стабильное форматирование для детерминированного SHA-256 §6.6).
Функция ПостроитьШаблон(Знач ТекстЗапроса, Знач МаксСимволов, Диаг = Неопределено)

	// Стадия 1-2: срез комментариев + плейсхолдеры литералов/параметров (чистые строки).
	ТекстСПлейсхолдерами = ЗаменитьЛитералыИКомментарии(ТекстЗапроса);

	// Стадия 3 (§6.4/§6.5): токен-парсер — tables + канонизация идентификаторов.
	// Возвращает Неопределено при любом мягком пропуске (fail-closed); причину кладёт в Диаг.
	Разбор = РазобратьЗапрос(ТекстСПлейсхолдерами, Диаг);
	Если Разбор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Стадия 3b (§6.6): валидация + нормализация канонизированного текста через СхемаЗапроса.
	// Побочно самопроверка: если токен-переименование нарушило синтаксис — УстановитьТекстЗапроса
	// возбудит исключение => жёсткий пропуск (пример не пишется).
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(Разбор.canonical);
		Скелет = Схема.ПолучитьТекстЗапроса();
	Исключение
		ВызватьИсключение "QueryExample stage=schema :: " + ОписаниеОшибки();
	КонецПопытки;

	Если СтрДлина(Скелет) > МаксСимволов Тогда
		УстановитьПричину(Диаг, "too_long");
		Возврат Неопределено;
	КонецЕсли;

	// Стадия 4: хеш.
	Попытка
		Хеш = ХешСкелета(Скелет);
	Исключение
		ВызватьИсключение "QueryExample stage=hash :: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Новый Структура("skeleton, skeleton_hash, tables, columns",
		Скелет, Хеш, Разбор.tables, Разбор.columns);

КонецФункции

// §6.1-6.3: срез комментариев и замена литералов/имён параметров плейсхолдерами.
// Токенизатор (не regex): строковые литералы 1С содержат "" внутри строк.
Функция ЗаменитьЛитералыИКомментарии(Знач Текст)

	Токены = Токенизировать(Текст);

	Части = Новый Массив;
	СоотвСтрока = Новый Соответствие;
	СоотвДата = Новый Соответствие;
	СоотвЧисло = Новый Соответствие;
	СоотвПарам = Новый Соответствие;
	Счётчики = Новый Структура("строка, дата, число, парам", 0, 0, 0, 0);

	ПредЗначащий = Неопределено;     // Структура("текст, междуИ")
	ПредПредЗначащий = Неопределено; // значащий токен перед ПредЗначащий (для унарного знака)
	МеждуОжидает = Ложь;
	СтекСкобок = Новый Массив; // Массив булево: истина = скобка списка В (…)

	Всего = Токены.Количество();
	Индекс = 0;
	Пока Индекс < Всего Цикл
		Токен = Токены[Индекс];

		Если Токен.вид = "пробел" Тогда
			Части.Добавить(Токен.значение);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		// ДАТАВРЕМЯ(...) — свернуть в &Дата<N>.
		Если Токен.вид = "идент"
			И (ВРег(Токен.значение) = "ДАТАВРЕМЯ" ИЛИ ВРег(Токен.значение) = "DATETIME") Тогда
			КонецГруппы = НайтиКонецВызова(Токены, Индекс);
			Если КонецГруппы > Индекс Тогда
				Ключ = ВРег(СоединитьЗначения(Токены, Индекс, КонецГруппы));
				Части.Добавить(Плейсхолдер(СоотвДата, Счётчики, "дата", "&Дата", Ключ));
				СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Дата", Ложь));
				Индекс = КонецГруппы + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если Токен.вид = "строка" Тогда
			Если СтрДлина(Токен.значение) <= 2 Тогда
				// Пустой строковый литерал "" — оставляем как есть.
				Части.Добавить(Токен.значение);
			Иначе
				Части.Добавить(Плейсхолдер(СоотвСтрока, Счётчики, "строка", "&Строка", Токен.значение));
			КонецЕсли;
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Строка", Ложь));

		ИначеЕсли Токен.вид = "параметр" Тогда
			// §6.2: имена параметров канонизируются (канал утечки: &ИНН_123).
			Части.Добавить(Плейсхолдер(СоотвПарам, Счётчики, "парам", "&Парам", ВРег(Токен.значение)));
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Парам", Ложь));

		ИначеЕсли Токен.вид = "число" Тогда
			// Назад: операнд справа/список (Сумма > 100, В (…), МЕЖДУ …); вперёд: реверс-операнд (100 = Сумма).
			Если ЧислоВПозицииЗначения(ПредЗначащий, ПредПредЗначащий, СтекСкобок)
				ИЛИ СледующийТокенСравнение(Токены, Индекс) Тогда
				Части.Добавить(Плейсхолдер(СоотвЧисло, Счётчики, "число", "&Число", Токен.значение));
			Иначе
				Части.Добавить(Токен.значение);
			КонецЕсли;
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Число", Ложь));

		Иначе
			// идент / оператор / символ — переносится дословно.
			Части.Добавить(Токен.значение);

			МеждуИ = Ложь;
			Если Токен.вид = "идент" Тогда
				ВР = ВРег(Токен.значение);
				Если ВР = "МЕЖДУ" ИЛИ ВР = "BETWEEN" Тогда
					МеждуОжидает = Истина;
				ИначеЕсли (ВР = "И" ИЛИ ВР = "AND") И МеждуОжидает Тогда
					МеждуИ = Истина;
					МеждуОжидает = Ложь;
				КонецЕсли;
			КонецЕсли;

			Если Токен.значение = "(" Тогда
				СтекСкобок.Добавить(ПередСкобкойОжидаетсяЗначение(ПредЗначащий, ПредПредЗначащий));
			ИначеЕсли Токен.значение = ")" Тогда
				Если СтекСкобок.Количество() > 0 Тогда
					СтекСкобок.Удалить(СтекСкобок.Количество() - 1);
				КонецЕсли;
			КонецЕсли;

			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен(Токен.значение, МеждуИ));
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Сдвиг двухуровневого окна значащих токенов (BSL передаёт первые два параметра по ссылке).
Процедура СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, Знач НовыйТокен)
	ПредПредЗначащий = ПредЗначащий;
	ПредЗначащий = НовыйТокен;
КонецПроцедуры

Функция ЗначащийТокен(Знач Текст, Знач МеждуИ)
	Возврат Новый Структура("текст, междуИ", Текст, МеждуИ);
КонецФункции

// Истина, если после этого значащего токена ожидается операнд-значение:
// оператор сравнения, МЕЖДУ, соединительное И внутри МЕЖДУ, либо В/IN.
Функция ТокенОжидаетЗначение(Знач Токен)
	Если Токен = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = Токен.текст;
	Если Т = "=" ИЛИ Т = "<>" ИЛИ Т = "<" ИЛИ Т = ">" ИЛИ Т = "<=" ИЛИ Т = ">=" Тогда
		Возврат Истина;
	КонецЕсли;
	ВР = ВРег(Т);
	Если ВР = "МЕЖДУ" ИЛИ ВР = "BETWEEN" Тогда
		Возврат Истина;
	КонецЕсли;
	Если (ВР = "И" ИЛИ ВР = "AND") И Токен.междуИ Тогда
		Возврат Истина;
	КонецЕсли;
	Если ВР = "В" ИЛИ ВР = "IN" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Предыдущий значащий токен с просмотром через ведущий унарный знак -/+
// ("Сумма > -100", "= -5"): эффективным считаем токен ПЕРЕД знаком.
Функция ЭффективныйПред(Знач ПредЗначащий, Знач ПредПредЗначащий)
	Если ПредЗначащий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если (ПредЗначащий.текст = "-" ИЛИ ПредЗначащий.текст = "+") И ПредПредЗначащий <> Неопределено Тогда
		Возврат ПредПредЗначащий;
	КонецЕсли;
	Возврат ПредЗначащий;
КонецФункции

// Рамка открывающей скобки: истина, если "(" открывает список/скобку значения
// (В (…), = (…), МЕЖДУ (…), И (…) внутри МЕЖДУ) — тогда числа внутри — значения.
Функция ПередСкобкойОжидаетсяЗначение(Знач ПредЗначащий, Знач ПредПредЗначащий)
	Возврат ТокенОжидаетЗначение(ЭффективныйПред(ПредЗначащий, ПредПредЗначащий));
КонецФункции

// §6.3: число (по предыдущему токену) — операнд справа от сравнения/МЕЖДУ/В,
// либо элемент скобки/списка, ожидающих значение.
Функция ЧислоВПозицииЗначения(Знач ПредЗначащий, Знач ПредПредЗначащий, Знач СтекСкобок)

	Эффективный = ЭффективныйПред(ПредЗначащий, ПредПредЗначащий);
	Если Эффективный = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТокенОжидаетЗначение(Эффективный) Тогда
		Возврат Истина;
	КонецЕсли;

	// ( или , внутри скобки, ожидающей значение (В (…), = (…), МЕЖДУ (…) …).
	Т = Эффективный.текст;
	Если (Т = "(" ИЛИ Т = ",")
		И СтекСкобок.Количество() > 0
		И СтекСкобок[СтекСкобок.Количество() - 1] = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Следующий значащий (не пробельный) токен после Индекс, либо Неопределено.
Функция СледующийЗначащий(Знач Токены, Знач Индекс)
	Результат = Индекс + 1;
	Пока Результат < Токены.Количество() Цикл
		Если Токены[Результат].вид <> "пробел" Тогда
			Возврат Токены[Результат];
		КонецЕсли;
		Результат = Результат + 1;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Реверс-операнд: за числом сразу идёт оператор сравнения (100 = Сумма).
Функция СледующийТокенСравнение(Знач Токены, Знач Индекс)
	След = СледующийЗначащий(Токены, Индекс);
	Если След = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = След.значение;
	Возврат Т = "=" ИЛИ Т = "<>" ИЛИ Т = "<" ИЛИ Т = ">" ИЛИ Т = "<=" ИЛИ Т = ">=";
КонецФункции

Функция Плейсхолдер(Соотв, Счётчики, Знач ИмяСчётчика, Знач Префикс, Знач Ключ)
	Существующий = Соотв.Получить(Ключ);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Счётчики[ИмяСчётчика] = Счётчики[ИмяСчётчика] + 1;
	Значение = Префикс + Счётчики[ИмяСчётчика];
	Соотв.Вставить(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Индекс закрывающей ")" для вызова вида ИМЯ( ... ), начиная с индекса имени.
// Возвращает индекс ")" либо -1, если "(" сразу не найдена.
Функция НайтиКонецВызова(Знач Токены, Знач ИндексИмени)
	Всего = Токены.Количество();
	Результат = ИндексИмени + 1;
	Пока Результат < Всего И Токены[Результат].вид = "пробел" Цикл
		Результат = Результат + 1;
	КонецЦикла;
	Если Результат >= Всего ИЛИ Токены[Результат].значение <> "(" Тогда
		Возврат -1;
	КонецЕсли;
	Глубина = 0;
	Пока Результат < Всего Цикл
		Значение = Токены[Результат].значение;
		Если Значение = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Значение = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + 1;
	КонецЦикла;
	Возврат -1;
КонецФункции

Функция СоединитьЗначения(Знач Токены, Знач От, Знач До)
	Части = Новый Массив;
	Для Результат = От По До Цикл
		Если Токены[Результат].вид <> "пробел" Тогда
			Части.Добавить(Токены[Результат].значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// --------------------------------------------------------------------
// 3. Токенизатор
// --------------------------------------------------------------------

Функция Токенизировать(Знач Текст)

	Токены = Новый Массив;
	Длина = СтрДлина(Текст);
	П = 1;

	Пока П <= Длина Цикл
		С = Сред(Текст, П, 1);
		След = ?(П < Длина, Сред(Текст, П + 1, 1), "");

		Если ЭтоПробельный(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоПробельный(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Строчный комментарий // …
		Если С = "/" И След = "/" Тогда
			Пока П <= Длина Цикл
				Ткщ = Сред(Текст, П, 1);
				Если Ткщ = Символы.ПС ИЛИ Ткщ = Символы.ВК Тогда
					Прервать;
				КонецЕсли;
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", " ");
			Продолжить;
		КонецЕсли;

		// Блочный комментарий /* … */ (язык запросов не поддерживает — срезаем на будущее).
		Если С = "/" И След = "*" Тогда
			П = П + 2;
			Пока П <= Длина Цикл
				Если Сред(Текст, П, 1) = "*" И Сред(Текст, П + 1, 1) = "/" Тогда
					П = П + 2;
					Прервать;
				КонецЕсли;
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", " ");
			Продолжить;
		КонецЕсли;

		// Строковый литерал "…" с экранированием "".
		Если С = """" Тогда
			Старт = П;
			П = П + 1;
			Пока П <= Длина Цикл
				Ткщ = Сред(Текст, П, 1);
				Если Ткщ = """" Тогда
					Если Сред(Текст, П + 1, 1) = """" Тогда
						П = П + 2;
						Продолжить;
					Иначе
						П = П + 1;
						Прервать;
					КонецЕсли;
				Иначе
					П = П + 1;
				КонецЕсли;
			КонецЦикла;
			ДобавитьТокен(Токены, "строка", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Параметр &Имя.
		Если С = "&" Тогда
			Старт = П;
			П = П + 1;
			Пока П <= Длина И ЭтоСимволИдентификатора(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "параметр", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Число (с опциональной дробной частью).
		Если ЭтоЦифра(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоЦифра(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			Если П <= Длина И Сред(Текст, П, 1) = "." И ЭтоЦифра(Сред(Текст, П + 1, 1)) Тогда
				П = П + 1;
				Пока П <= Длина И ЭтоЦифра(Сред(Текст, П, 1)) Цикл
					П = П + 1;
				КонецЦикла;
			КонецЕсли;
			ДобавитьТокен(Токены, "число", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Идентификатор / ключевое слово.
		Если ЭтоНачалоИдентификатора(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоСимволИдентификатора(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "идент", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Многосимвольные операторы.
		Пара = С + След;
		Если Пара = "<=" ИЛИ Пара = ">=" ИЛИ Пара = "<>" Тогда
			ДобавитьТокен(Токены, "оператор", Пара);
			П = П + 2;
			Продолжить;
		КонецЕсли;

		// Одиночный символ.
		Если С = "=" ИЛИ С = "<" ИЛИ С = ">" Тогда
			ДобавитьТокен(Токены, "оператор", С);
		Иначе
			ДобавитьТокен(Токены, "символ", С);
		КонецЕсли;
		П = П + 1;
	КонецЦикла;

	Возврат Токены;

КонецФункции

Процедура ДобавитьТокен(Токены, Знач Вид, Знач Значение)
	Токены.Добавить(Новый Структура("вид, значение", Вид, Значение));
КонецПроцедуры

Функция ЭтоПробельный(Знач С)
	Возврат С = " " ИЛИ С = Символы.Таб ИЛИ С = Символы.ПС ИЛИ С = Символы.ВК ИЛИ С = Символы.НПП;
КонецФункции

Функция ЭтоЦифра(Знач С)
	Если ПустаяСтрока(С) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(С);
	Возврат Код >= 48 И Код <= 57;
КонецФункции

Функция ЭтоНачалоИдентификатора(Знач С)
	Возврат ЭтоБуква(С) ИЛИ С = "_";
КонецФункции

Функция ЭтоСимволИдентификатора(Знач С)
	Возврат ЭтоБуква(С) ИЛИ С = "_" ИЛИ ЭтоЦифра(С);
КонецФункции

Функция ЭтоБуква(Знач С)
	Если ПустаяСтрока(С) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(С);
	// Латиница.
	Если (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122) Тогда
		Возврат Истина;
	КонецЕсли;
	// Кириллица А-я + Ё/ё.
	Если (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// --------------------------------------------------------------------
// 4. Токен-парсер: tables (§6.4) + канонизация псевдонимов/ВТ/колонок (§6.5)
// --------------------------------------------------------------------
// Платформо-независимая замена обхода объектной модели СхемаЗапроса (на контуре
// объектная модель — .Пакеты/.Операторы/.Источники — недоступна: объект хранит только
// текст). Рекурсивный спуск по токенам. Fail-closed: любая неподдерживаемая конструкция
// => Контекст.пропуск = Истина => РазобратьЗапрос возвращает Неопределено (пример не пишется).
//
// Покрытие: пакеты (разделены ";"), операнды ОБЪЕДИНИТЬ, источники ИЗ/СОЕДИНЕНИЕ, вложенные
// запросы-источники ИЗ (рекурсивно), временные таблицы (ПОМЕСТИТЬ/ИЗ/УНИЧТОЖИТЬ), виртуальные
// таблицы (.Остатки/.СрезПоследних/…: в tables кладётся базовый объект, суффикс и параметры
// остаются). Подзапросы в списке ВЫБРАТЬ и в ГДЕ НЕ обходятся — их наличие ловит инвариант
// «обойдено = всегоВыбрать» => мягкий пропуск (иначе говорящие псевдонимы/имена ВТ вложенного
// подзапроса могли бы утечь, а его таблицы не попали бы в фильтрацию по правам §8).
//
// Канонизация консистентна: псевдонимы источников -> Т<N> (сквозной счётчик по запросу),
// псевдонимы колонок результата -> Поле<N> (в пределах тела запроса), имена ВТ -> ВТ<N>.
// Авто-псевдоним сохраняется (§6.5): для источника — если совпадает с последним сегментом
// имени объекта метаданных; для колонки — если совпадает с последним сегментом выражения поля.
// Ссылки на колонки ВТ/подзапросов, переименованные при их формировании, переписываются в
// потребителях через карту колонок (fields) — эквивалент консистентной регенерации объектной
// модели. Результат отдаётся в ПостроитьШаблон, где СхемаЗапроса валидирует и нормализует текст.

// Разобрать текст запроса (после §6.1-6.3). Возвращает Структуру
// {canonical, tables, columns} либо Неопределено (мягкий пропуск / fail-closed).
Функция РазобратьЗапрос(Знач Текст, Диаг = Неопределено)

	К = НовыйКонтекстРазбора(Текст);
	ПостроитьКартуВТ(К);

	К.Поз = 0;
	Пока Тек(К) <> Неопределено И НЕ К.пропуск Цикл
		РазобратьОператорПакета(К);
		Если К.пропуск Тогда
			УстановитьПричину(Диаг, "unhandled_construct");
			Возврат Неопределено;
		КонецЕсли;
		Если Тек(К) <> Неопределено И Тек(К).значение = ";" Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Если Тек(К) <> Неопределено Тогда
			// Неожиданный токен между операторами пакета.
			УстановитьПричину(Диаг, "unexpected_token");
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Если К.пропуск Тогда
		УстановитьПричину(Диаг, "unhandled_construct");
		Возврат Неопределено;
	КонецЕсли;
	// Инвариант: каждый ВЫБРАТЬ обойдён (иначе есть необойдённый подзапрос — не пишем).
	Если К.обойдено <> К.всегоВыбрать Тогда
		УстановитьПричину(Диаг, "select_count_mismatch:" + К.обойдено + "/" + К.всегоВыбрать);
		Возврат Неопределено;
	КонецЕсли;
	// §6.4: реальных источников не осталось — не пишем.
	Если К.Таблицы.Количество() = 0 Тогда
		УстановитьПричину(Диаг, "no_tables");
		Возврат Неопределено;
	КонецЕсли;

	Колонки = ?(К.финальныеКолонки = Неопределено, Новый Массив, К.финальныеКолонки);
	Возврат Новый Структура("canonical, tables, columns",
		СобратьТекст(К), К.Таблицы, Колонки);

КонецФункции

// Записать категорию причины мягкого пропуска в диагностический холдер (если передан).
// Категории не содержат пользовательских данных — только тип конструкции/счётчики.
Процедура УстановитьПричину(Диаг, Знач Причина)
	Если Диаг <> Неопределено Тогда
		Диаг.reason = Причина;
	КонецЕсли;
КонецПроцедуры

Функция НовыйКонтекстРазбора(Знач Текст)

	Токены = Токенизировать(Текст);

	Сиг = Новый Массив; // значащие токены: Структура{ри, вид, значение}
	Индекс = 0;
	Для Каждого Т Из Токены Цикл
		Если Т.вид <> "пробел" Тогда
			Сиг.Добавить(Новый Структура("ри, вид, значение", Индекс, Т.вид, Т.значение));
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Всего = 0;
	Для Каждого С Из Сиг Цикл
		Если С.вид = "идент" И (ВРег(С.значение) = "ВЫБРАТЬ" ИЛИ ВРег(С.значение) = "SELECT") Тогда
			Всего = Всего + 1;
		КонецЕсли;
	КонецЦикла;

	К = Новый Структура;
	К.Вставить("Токены", Токены);
	К.Вставить("Сиг", Сиг);
	К.Вставить("Поз", 0);
	К.Вставить("Переименования", Новый Соответствие); // ри(число) -> новое значение(строка)
	К.Вставить("Таблицы", Новый Массив);
	К.Вставить("Видимые", Новый Соответствие);        // НРег(база) -> Истина
	К.Вставить("КартаВТ", Новый Соответствие);        // НРег(имя ВТ) -> "ВТ<N>"
	К.Вставить("КолонкиВТ", Новый Соответствие);      // "ВТ<N>" -> Соответствие(НРег(внешнее имя) -> эффективное)
	К.Вставить("тАлиас", 0);
	К.Вставить("обойдено", 0);
	К.Вставить("всегоВыбрать", Всего);
	К.Вставить("финальныеКолонки", Неопределено);
	К.Вставить("пропуск", Ложь);
	К.Вставить("ТипыМД", НаборТиповМетаданных());
	Возврат К;

КонецФункции

// Позиционные помощники (Сиг — массив значащих токенов, К.Поз — курсор).
Функция Тек(Знач К)
	Возврат ?(К.Поз >= 0 И К.Поз < К.Сиг.Количество(), К.Сиг[К.Поз], Неопределено);
КонецФункции

Функция Впер(Знач К, Знач Смещение)
	Инд = К.Поз + Смещение;
	Возврат ?(Инд >= 0 И Инд < К.Сиг.Количество(), К.Сиг[Инд], Неопределено);
КонецФункции

Функция Пред(Знач К)
	Возврат Впер(К, -1);
КонецФункции

Функция Съесть(К)
	Т = К.Сиг[К.Поз];
	К.Поз = К.Поз + 1;
	Возврат Т;
КонецФункции

Процедура Переименовать(К, Знач ри, Знач Значение)
	К.Переименования.Вставить(ри, Значение);
КонецПроцедуры

// Первый проход: имена временных таблиц из ПОМЕСТИТЬ <имя> -> ВТ<N> (по порядку появления).
Процедура ПостроитьКартуВТ(К)
	Н = 0;
	Для Индекс = 0 По К.Сиг.Количество() - 1 Цикл
		Т = К.Сиг[Индекс];
		Если Т.вид = "идент" И (ВРег(Т.значение) = "ПОМЕСТИТЬ" ИЛИ ВРег(Т.значение) = "INTO") Тогда
			Если Индекс + 1 < К.Сиг.Количество() Тогда
				Имя = К.Сиг[Индекс + 1];
				Если Имя.вид = "идент" Тогда
					Н = Н + 1;
					Канон = "ВТ" + Н;
					К.КартаВТ.Вставить(НРег(Имя.значение), Канон);
					Переименовать(К, Имя.ри, Канон);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура РазобратьОператорПакета(К)
	Т = Тек(К);
	Если Т = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоВЫБРАТЬ(Т) Тогда
		Рез = РазобратьОператорВыбора(К);
		Если К.пропуск Тогда
			Возврат;
		КонецЕсли;
		// финальные колонки = колонки последнего оператора-результата (без ПОМЕСТИТЬ).
		Если НЕ Рез.hadPlacement Тогда
			К.финальныеКолонки = Рез.columns;
		ИначеЕсли К.финальныеКолонки = Неопределено Тогда
			К.финальныеКолонки = Рез.columns;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ЭтоУНИЧТОЖИТЬ(Т) Тогда
		РазобратьУничтожить(К);
		Возврат;
	КонецЕсли;
	К.пропуск = Истина;
КонецПроцедуры

Процедура РазобратьУничтожить(К)
	Съесть(К); // УНИЧТОЖИТЬ
	Пока Истина Цикл
		Имя = Тек(К);
		Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
			К.пропуск = Истина;
			Возврат;
		КонецЕсли;
		Канон = К.КартаВТ.Получить(НРег(Имя.значение));
		Если Канон <> Неопределено Тогда
			Переименовать(К, Имя.ри, Канон);
		КонецЕсли;
		Съесть(К);
		Если Тек(К) <> Неопределено И Тек(К).значение = "," Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецПроцедуры

// Оператор ВЫБРАТЬ + операнды ОБЪЕДИНИТЬ. Возвращает {columns, hadPlacement}.
Функция РазобратьОператорВыбора(К)
	Колонки = Новый Массив;
	hadPlacement = Ложь;
	опИндекс = 0;
	Пока Истина Цикл
		Тело = РазобратьТелоВыбора(К, Ложь);
		Если К.пропуск Тогда
			Возврат Новый Структура("columns, hadPlacement", Новый Массив, hadPlacement);
		КонецЕсли;
		Если опИндекс = 0 Тогда
			Колонки = Тело.columns; // 1С: имена колонок берутся от первого операнда
		КонецЕсли;
		Если Тело.hadPlacement Тогда
			hadPlacement = Истина;
		КонецЕсли;
		опИндекс = опИндекс + 1;
		Если ЭтоОБЪЕДИНИТЬ(Тек(К)) Тогда
			Съесть(К);
			Если ЭтоВСЕ(Тек(К)) Тогда
				Съесть(К);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Возврат Новый Структура("columns, hadPlacement", Колонки, hadPlacement);
КонецФункции

Функция ПустоеТело()
	Возврат Новый Структура("columns, colMap, hadPlacement", Новый Массив, Новый Соответствие, Ложь);
КонецФункции

// Разобрать одно тело ВЫБРАТЬ (операнд). ЭтоПодзапрос: вложенный запрос-источник ИЗ.
// Возвращает {columns, colMap, hadPlacement}.
Функция РазобратьТелоВыбора(К, Знач ЭтоПодзапрос)

	Если НЕ ЭтоВЫБРАТЬ(Тек(К)) Тогда
		К.пропуск = Истина;
		Возврат ПустоеТело();
	КонецЕсли;
	Съесть(К); // ВЫБРАТЬ
	К.обойдено = К.обойдено + 1;
	Если ЭтоРАЗРЕШЕННЫЕ(Тек(К)) Тогда Съесть(К); КонецЕсли;
	Если ЭтоРАЗЛИЧНЫЕ(Тек(К)) Тогда Съесть(К); КонецЕсли;
	Если ЭтоПЕРВЫЕ(Тек(К)) Тогда
		Съесть(К);
		Пока Тек(К) <> Неопределено И (Тек(К).вид = "число" ИЛИ Тек(К).значение = ",") Цикл
			Съесть(К);
		КонецЦикла;
	КонецЕсли;

	Область = Новый Соответствие;    // НРег(псевдоним) -> Структура{canon, fields}
	ТочечныеСсылки = Новый Массив;   // Структура{ри, name, f2ri, f2name}
	СсылкиНаКолонки = Новый Массив;  // Структура{ри, name} — голые в УПОРЯДОЧИТЬ/СГРУППИРОВАТЬ/ИТОГИ
	ИнфоКолонок = Новый Массив;      // Структура{alias, simple, lastSegRi, lastSegName, star}

	РазобратьСписокВыбора(К, ТочечныеСсылки, ИнфоКолонок);
	Если К.пропуск Тогда Возврат ПустоеТело(); КонецЕсли;

	hadPlacement = Ложь;
	КанонВТ = Неопределено;
	Если ЭтоПОМЕСТИТЬ(Тек(К)) Тогда
		Съесть(К);
		Имя = Тек(К);
		Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
			К.пропуск = Истина;
			Возврат ПустоеТело();
		КонецЕсли;
		КанонВТ = К.КартаВТ.Получить(НРег(Имя.значение)); // уже переименовано в первом проходе
		Съесть(К);
		hadPlacement = Истина;
	КонецЕсли;

	Если ЭтоИЗ(Тек(К)) Тогда
		Съесть(К);
		РазобратьИсточники(К, Область, ТочечныеСсылки);
		Если К.пропуск Тогда Возврат ПустоеТело(); КонецЕсли;
	КонецЕсли;

	РазобратьХвостовыеСекции(К, ТочечныеСсылки, СсылкиНаКолонки);
	Если К.пропуск Тогда Возврат ПустоеТело(); КонецЕсли;

	// ---- резолв переименований тела ----
	// 1) точечные префиксы (+ сегмент поля для источников-ВТ/подзапросов).
	Для Каждого С Из ТочечныеСсылки Цикл
		Запись = Область.Получить(НРег(С.name));
		Если Запись <> Неопределено Тогда
			Переименовать(К, С.ри, Запись.canon);
			Если С.f2ri >= 0 Тогда
				НовоеПоле = Запись.fields.Получить(НРег(С.f2name));
				Если НовоеПоле <> Неопределено Тогда
					Переименовать(К, С.f2ri, НовоеПоле);
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		// Не псевдоним: допустим только заголовок имени метаданных (Справочник.Товары),
		// иначе — пропущенный псевдоним/коррелированная ссылка => fail-closed.
		Если К.ТипыМД.Получить(ВРег(С.name)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		К.пропуск = Истина;
		Возврат ПустоеТело();
	КонецЦикла;

	// 2) колонки -> resultCols + colMap (внешнее имя -> эффективное имя).
	КолОбласть = Новый Соответствие; // НРег(псевдоним колонки) -> "Поле<N>"
	colMap = Новый Соответствие;
	колН = 0;
	РезКолонки = Новый Массив;
	Для Каждого Инфо Из ИнфоКолонок Цикл
		Если Инфо.star Тогда
			// Источник (подзапрос/ПОМЕСТИТЬ) не должен раскрывать '*': нельзя сопоставить
			// внешние ссылки на его колонки. Конечный результат '*' допустим.
			Если ЭтоПодзапрос ИЛИ hadPlacement Тогда
				К.пропуск = Истина;
				Возврат ПустоеТело();
			КонецЕсли;
			РезКолонки.Добавить("*");
			Продолжить;
		КонецЕсли;
		эфф = Неопределено;
		Если Инфо.simple Тогда
			Перепис = К.Переименования.Получить(Инфо.lastSegRi);
			эфф = ?(Перепис <> Неопределено, Перепис, Инфо.lastSegName);
		КонецЕсли;
		Если Инфо.alias <> Неопределено Тогда
			АвтоП = (эфф <> Неопределено И ВРег(Инфо.alias.name) = ВРег(эфф));
			Если АвтоП Тогда
				РезКолонки.Добавить(Инфо.alias.name); // == эфф, безопасно
			Иначе
				колН = колН + 1;
				Канон = "Поле" + колН;
				Переименовать(К, Инфо.alias.ри, Канон);
				КолОбласть.Вставить(НРег(Инфо.alias.name), Канон);
				colMap.Вставить(НРег(Инфо.alias.name), Канон);
				РезКолонки.Добавить(Канон);
			КонецЕсли;
		Иначе
			Если эфф = Неопределено ИЛИ НЕ ЗначениеЗаполнено(эфф) Тогда
				// Не простое поле без КАК (или пустое выражение) — некорректно/непонятно => пропуск.
				К.пропуск = Истина;
				Возврат ПустоеТело();
			КонецЕсли;
			РезКолонки.Добавить(эфф);
			// Проброс поля с переименованным сегментом меняет внешнее имя колонки.
			Если Инфо.simple И ЗначениеЗаполнено(Инфо.lastSegName) И ВРег(эфф) <> ВРег(Инфо.lastSegName) Тогда
				colMap.Вставить(НРег(Инфо.lastSegName), эфф);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// 3) ссылки на псевдонимы колонок в УПОРЯДОЧИТЬ/СГРУППИРОВАТЬ/ИТОГИ.
	Для Каждого Р Из СсылкиНаКолонки Цикл
		Канон = КолОбласть.Получить(НРег(Р.name));
		Если Канон <> Неопределено Тогда
			Переименовать(К, Р.ри, Канон);
		КонецЕсли;
	КонецЦикла;

	Если hadPlacement И КанонВТ <> Неопределено Тогда
		К.КолонкиВТ.Вставить(КанонВТ, colMap);
	КонецЕсли;

	Возврат Новый Структура("columns, colMap, hadPlacement", РезКолонки, colMap, hadPlacement);

КонецФункции

// Список выбора: колонки, разделённые запятыми уровня 0, до стоп-ключевого/;/).
Процедура РазобратьСписокВыбора(К, ТочечныеСсылки, ИнфоКолонок)
	Пока Истина Цикл
		Кол = РазобратьВыражениеКолонки(К, ТочечныеСсылки);
		Если К.пропуск Тогда Возврат; КонецЕсли;
		Псевдоним = Неопределено;
		Если ЭтоКАК(Тек(К)) Тогда
			Съесть(К);
			Имя = Тек(К);
			Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
				К.пропуск = Истина;
				Возврат;
			КонецЕсли;
			Псевдоним = Новый Структура("ри, name", Имя.ри, Имя.значение);
			Съесть(К);
		КонецЕсли;
		ИнфоКолонок.Добавить(Новый Структура("alias, simple, lastSegRi, lastSegName, star",
			Псевдоним, Кол.simple, Кол.lastSegRi, Кол.lastSegName, Кол.star));
		Если Тек(К) <> Неопределено И Тек(К).значение = "," Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецПроцедуры

// Обойти одно выражение колонки; собрать точечные ссылки; определить простой путь поля.
Функция РазобратьВыражениеКолонки(К, ТочечныеСсылки)
	Глубина = 0;
	Прост = Истина; // всё выражение — идент(.идент)*
	ПоследнийРи = -1;
	ПоследнееИмя = "";
	Стар = Ложь;
	Пока Истина Цикл
		Т = Тек(К);
		Если Т = Неопределено Тогда Прервать; КонецЕсли;
		Если Глубина = 0 Тогда
			Если Т.значение = "," ИЛИ Т.значение = ";" ИЛИ Т.значение = ")" Тогда Прервать; КонецЕсли;
			Если ЭтоКАК(Т) ИЛИ ЭтоСтопКлючевоеТела(Т) Тогда Прервать; КонецЕсли;
		КонецЕсли;
		Если Т.значение = "(" Тогда
			Глубина = Глубина + 1; Прост = Ложь; Съесть(К); Продолжить;
		КонецЕсли;
		Если Т.значение = ")" Тогда
			Глубина = Глубина - 1; Съесть(К); Продолжить;
		КонецЕсли;
		Если Т.вид = "идент" Тогда
			СобратьТочечную(К, Т, ТочечныеСсылки);
			ПоследнийРи = Т.ри; ПоследнееИмя = Т.значение;
		ИначеЕсли Т.значение = "." Тогда
			// разделитель пути поля
		ИначеЕсли Т.значение = "*" И Глубина = 0 Тогда
			Стар = Истина; Прост = Ложь;
		Иначе
			Прост = Ложь;
		КонецЕсли;
		Съесть(К);
	КонецЦикла;
	Возврат Новый Структура("simple, lastSegRi, lastSegName, star",
		Прост, ?(Прост, ПоследнийРи, -1), ?(Прост, ПоследнееИмя, ""), Стар);
КонецФункции

// Определить роль идентификатора и, если это голова точечной цепочки, записать ссылку.
// Возвращает "head" / "bare" / "field". Вызывать когда К.Поз указывает на Т.
Функция СобратьТочечную(К, Знач Т, ТочечныеСсылки)
	пд = (Пред(К) <> Неопределено И Пред(К).значение = ".");
	След = Впер(К, 1);
	нд = (След <> Неопределено И След.значение = ".");
	Если нд И НЕ пд Тогда
		ф2 = Впер(К, 2);
		ЕстьФ2 = (ф2 <> Неопределено И ф2.вид = "идент");
		ТочечныеСсылки.Добавить(Новый Структура("ри, name, f2ri, f2name",
			Т.ри, Т.значение, ?(ЕстьФ2, ф2.ри, -1), ?(ЕстьФ2, ф2.значение, "")));
		Возврат "head";
	КонецЕсли;
	Если НЕ нд И НЕ пд Тогда
		Возврат "bare";
	КонецЕсли;
	Возврат "field";
КонецФункции

Процедура РазобратьИсточники(К, Область, ТочечныеСсылки)
	Пока Истина Цикл
		РазобратьЭлементИсточника(К, Область);
		Если К.пропуск Тогда Возврат; КонецЕсли;
		Пока ЭтоНачалоСоединения(К) Цикл
			РазобратьСоединение(К, Область, ТочечныеСсылки);
			Если К.пропуск Тогда Возврат; КонецЕсли;
		КонецЦикла;
		Если Тек(К) <> Неопределено И Тек(К).значение = "," Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоНачалоСоединения(К)
	Т = Тек(К);
	Если Т = Неопределено ИЛИ Т.вид <> "идент" Тогда
		Возврат Ложь;
	КонецЕсли;
	С = ВРег(Т.значение);
	Возврат ЭтоВедущееСоединения(С) ИЛИ С = "СОЕДИНЕНИЕ" ИЛИ С = "JOIN";
КонецФункции

Процедура РазобратьСоединение(К, Область, ТочечныеСсылки)
	Соед = Ложь;
	Пока Тек(К) <> Неопределено И Тек(К).вид = "идент" Цикл
		С = ВРег(Тек(К).значение);
		Если ЭтоВедущееСоединения(С) ИЛИ С = "ВНЕШНЕЕ" ИЛИ С = "OUTER" Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Если С = "СОЕДИНЕНИЕ" ИЛИ С = "JOIN" Тогда
			Съесть(К);
			Соед = Истина;
			Прервать;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если НЕ Соед Тогда
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;
	РазобратьЭлементИсточника(К, Область);
	Если К.пропуск Тогда Возврат; КонецЕсли;
	Если ЭтоПО(Тек(К)) Тогда
		Съесть(К);
		ОбойтиВыражениеСекции(К, ТочечныеСсылки, Неопределено, Истина);
	КонецЕсли;
КонецПроцедуры

// Один источник (таблица / ВТ / подзапрос) + необязательный КАК <псевдоним>.
Процедура РазобратьЭлементИсточника(К, Область)

	Т = Тек(К);
	Если Т = Неопределено Тогда
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;

	Если Т.значение = "(" Тогда
		Если ЭтоВЫБРАТЬ(Впер(К, 1)) Тогда
			Съесть(К); // (
			Тело = РазобратьТелоВыбора(К, Истина);
			Если К.пропуск Тогда Возврат; КонецЕсли;
			Если Тек(К) = Неопределено ИЛИ Тек(К).значение <> ")" Тогда
				К.пропуск = Истина;
				Возврат;
			КонецЕсли;
			Съесть(К); // )
			Если НЕ ЭтоКАК(Тек(К)) Тогда // подзапрос-источник обязан иметь псевдоним
				К.пропуск = Истина;
				Возврат;
			КонецЕсли;
			Съесть(К);
			Имя = Тек(К);
			Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
				К.пропуск = Истина;
				Возврат;
			КонецЕсли;
			К.тАлиас = К.тАлиас + 1;
			Канон = "Т" + К.тАлиас;
			Переименовать(К, Имя.ри, Канон);
			Область.Вставить(НРег(Имя.значение), Новый Структура("canon, fields", Канон, Тело.colMap));
			Съесть(К);
			Возврат;
		КонецЕсли;
		// Скобочная группа источников / иное — не поддерживаем.
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;

	Если Т.вид <> "идент" Тогда
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;

	Сегменты = ПрочитатьТочечноеИмя(К);
	Если Сегменты = Неопределено Тогда
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;

	Если Сегменты.Количество() = 1 Тогда
		// Ссылка на временную таблицу (должна быть объявлена через ПОМЕСТИТЬ).
		Канон = К.КартаВТ.Получить(НРег(Сегменты[0].значение));
		Если Канон = Неопределено Тогда
			// Необъявленный одиночный источник — успешный запрос так не выглядит => fail-closed.
			К.пропуск = Истина;
			Возврат;
		КонецЕсли;
		Переименовать(К, Сегменты[0].ри, Канон);
		Поля = К.КолонкиВТ.Получить(Канон);
		Если Поля = Неопределено Тогда
			Поля = Новый Соответствие;
		КонецЕсли;
		Если ЭтоКАК(Тек(К)) Тогда
			Съесть(К);
			Имя = Тек(К);
			Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
				К.пропуск = Истина;
				Возврат;
			КонецЕсли;
			К.тАлиас = К.тАлиас + 1;
			Псевд = "Т" + К.тАлиас;
			Переименовать(К, Имя.ри, Псевд);
			Область.Вставить(НРег(Имя.значение), Новый Структура("canon, fields", Псевд, Поля));
			Съесть(К);
		Иначе
			// Ссылки идут по собственному (каноническому) имени ВТ.
			Область.Вставить(НРег(Сегменты[0].значение), Новый Структура("canon, fields", Канон, Поля));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Источник-метаданные (2+ сегмента): базовый объект в tables, суффикс ВТ остаётся.
	СписокИмён = Новый Массив;
	Для Каждого Сег Из Сегменты Цикл
		СписокИмён.Добавить(Сег.значение);
	КонецЦикла;
	База = БазовыйОбъектТаблицы(СтрСоединить(СписокИмён, "."));
	Если База = Неопределено Тогда
		// Источник успешного запроса обязан резолвиться.
		К.пропуск = Истина;
		Возврат;
	КонецЕсли;
	Если К.Видимые.Получить(НРег(База)) = Неопределено Тогда
		К.Видимые.Вставить(НРег(База), Истина);
		К.Таблицы.Добавить(База);
	КонецЕсли;
	Если Тек(К) <> Неопределено И Тек(К).значение = "(" Тогда
		СъестьСбалансированныеСкобки(К); // параметры виртуальной таблицы
	КонецЕсли;
	Если ЭтоКАК(Тек(К)) Тогда
		Съесть(К);
		Имя = Тек(К);
		Если Имя = Неопределено ИЛИ Имя.вид <> "идент" Тогда
			К.пропуск = Истина;
			Возврат;
		КонецЕсли;
		Если ВРег(Имя.значение) = ВРег(ПоследнийСегмент(База)) Тогда
			// Авто-псевдоним (== последний сегмент имени метаданных): сохраняем, регистрируем на себя.
			Область.Вставить(НРег(Имя.значение), Новый Структура("canon, fields", Имя.значение, Новый Соответствие));
		Иначе
			К.тАлиас = К.тАлиас + 1;
			Псевд = "Т" + К.тАлиас;
			Переименовать(К, Имя.ри, Псевд);
			Область.Вставить(НРег(Имя.значение), Новый Структура("canon, fields", Псевд, Новый Соответствие));
		КонецЕсли;
		Съесть(К);
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьТочечноеИмя(К)
	Первый = Тек(К);
	Если Первый = Неопределено ИЛИ Первый.вид <> "идент" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сегменты = Новый Массив;
	Сегменты.Добавить(Съесть(К));
	Пока Тек(К) <> Неопределено И Тек(К).значение = "."
		И Впер(К, 1) <> Неопределено И Впер(К, 1).вид = "идент" Цикл
		Съесть(К); // точка
		Сегменты.Добавить(Съесть(К));
	КонецЦикла;
	Возврат Сегменты;
КонецФункции

Процедура СъестьСбалансированныеСкобки(К)
	Если Тек(К) = Неопределено ИЛИ Тек(К).значение <> "(" Тогда
		Возврат;
	КонецЕсли;
	Глубина = 0;
	Пока Истина Цикл
		Т = Тек(К);
		Если Т = Неопределено Тогда
			К.пропуск = Истина;
			Возврат;
		КонецЕсли;
		Если Т.значение = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Т.значение = ")" Тогда
			Глубина = Глубина - 1;
			Съесть(К);
			Если Глубина = 0 Тогда
				Возврат;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Съесть(К);
	КонецЦикла;
КонецПроцедуры

Процедура РазобратьХвостовыеСекции(К, ТочечныеСсылки, СсылкиНаКолонки)
	Пока Истина Цикл
		Т = Тек(К);
		Если Т = Неопределено Тогда Возврат; КонецЕсли;
		Если Т.значение = ";" ИЛИ Т.значение = ")" Тогда Возврат; КонецЕсли;
		Если ЭтоОБЪЕДИНИТЬ(Т) Тогда Возврат; КонецЕсли;
		Если ЭтоГДЕ(Т) ИЛИ ЭтоИМЕЮЩИЕ(Т) Тогда
			Съесть(К);
			ОбойтиВыражениеСекции(К, ТочечныеСсылки, Неопределено, Ложь);
			Если К.пропуск Тогда Возврат; КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЭтоСГРУППИРОВАТЬ(Т) ИЛИ ЭтоУПОРЯДОЧИТЬ(Т) Тогда
			Съесть(К);
			Если ЭтоПО(Тек(К)) Тогда Съесть(К); КонецЕсли;
			ОбойтиВыражениеСекции(К, ТочечныеСсылки, СсылкиНаКолонки, Ложь);
			Если К.пропуск Тогда Возврат; КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЭтоИТОГИ(Т) Тогда
			Съесть(К);
			ОбойтиВыражениеСекции(К, ТочечныеСсылки, СсылкиНаКолонки, Ложь);
			Если К.пропуск Тогда Возврат; КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЭтоАВТОУПОРЯДОЧИВАНИЕ(Т) Тогда
			Съесть(К);
			Продолжить;
		КонецЕсли;
		Если ЭтоДЛЯ(Т) Тогда // ДЛЯ ИЗМЕНЕНИЯ …
			Пока Тек(К) <> Неопределено И Тек(К).значение <> ";" И Тек(К).значение <> ")"
				И НЕ ЭтоОБЪЕДИНИТЬ(Тек(К)) Цикл
				Съесть(К);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		// Неизвестный токен на уровне тела.
		К.пропуск = Истина;
		Возврат;
	КонецЦикла;
КонецПроцедуры

// Обойти выражение секции до стоп-границы тела; собрать точечные головы и голые
// ссылки на псевдонимы колонок (только если СсылкиНаКолонки <> Неопределено).
Процедура ОбойтиВыражениеСекции(К, ТочечныеСсылки, СсылкиНаКолонки, Знач СтопНаСоединении)
	Глубина = 0;
	Пока Истина Цикл
		Т = Тек(К);
		Если Т = Неопределено Тогда Возврат; КонецЕсли;
		Если Глубина = 0 Тогда
			Если Т.значение = ";" ИЛИ Т.значение = ")" Тогда Возврат; КонецЕсли;
			Если ЭтоСтопКлючевоеТела(Т) Тогда Возврат; КонецЕсли;
			Если СтопНаСоединении И (ЭтоНачалоСоединения(К) ИЛИ Т.значение = ",") Тогда Возврат; КонецЕсли;
		КонецЕсли;
		Если Т.значение = "(" Тогда
			Глубина = Глубина + 1; Съесть(К); Продолжить;
		КонецЕсли;
		Если Т.значение = ")" Тогда
			Глубина = Глубина - 1; Съесть(К); Продолжить;
		КонецЕсли;
		Если Т.вид = "идент" Тогда
			Роль = СобратьТочечную(К, Т, ТочечныеСсылки);
			Если Роль = "bare" И СсылкиНаКолонки <> Неопределено Тогда
				СсылкиНаКолонки.Добавить(Новый Структура("ри, name", Т.ри, Т.значение));
			КонецЕсли;
		КонецЕсли;
		Съесть(К);
	КонецЦикла;
КонецПроцедуры

// Собрать итоговый текст: значения токенов с применёнными переименованиями (ключ — индекс токена).
Функция СобратьТекст(К)
	Части = Новый Массив;
	Для Индекс = 0 По К.Токены.Количество() - 1 Цикл
		Новое = К.Переименования.Получить(Индекс);
		Если Новое <> Неопределено Тогда
			Части.Добавить(Новое);
		Иначе
			Части.Добавить(К.Токены[Индекс].значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// --- ключевые слова (русский + английский регистронезависимо) ---
Функция Слово(Знач Токен)
	Если Токен = Неопределено ИЛИ Токен.вид <> "идент" Тогда Возврат ""; КонецЕсли;
	Возврат ВРег(Токен.значение);
КонецФункции

Функция ЭтоВЫБРАТЬ(Знач Т)
	С = Слово(Т); Возврат С = "ВЫБРАТЬ" ИЛИ С = "SELECT";
КонецФункции
Функция ЭтоОБЪЕДИНИТЬ(Знач Т)
	С = Слово(Т); Возврат С = "ОБЪЕДИНИТЬ" ИЛИ С = "UNION";
КонецФункции
Функция ЭтоВСЕ(Знач Т)
	С = Слово(Т); Возврат С = "ВСЕ" ИЛИ С = "ALL";
КонецФункции
Функция ЭтоРАЗЛИЧНЫЕ(Знач Т)
	С = Слово(Т); Возврат С = "РАЗЛИЧНЫЕ" ИЛИ С = "DISTINCT";
КонецФункции
Функция ЭтоПЕРВЫЕ(Знач Т)
	С = Слово(Т); Возврат С = "ПЕРВЫЕ" ИЛИ С = "TOP";
КонецФункции
Функция ЭтоРАЗРЕШЕННЫЕ(Знач Т)
	С = Слово(Т); Возврат С = "РАЗРЕШЕННЫЕ" ИЛИ С = "ALLOWED";
КонецФункции
Функция ЭтоПОМЕСТИТЬ(Знач Т)
	С = Слово(Т); Возврат С = "ПОМЕСТИТЬ" ИЛИ С = "INTO";
КонецФункции
Функция ЭтоИЗ(Знач Т)
	С = Слово(Т); Возврат С = "ИЗ" ИЛИ С = "FROM";
КонецФункции
Функция ЭтоКАК(Знач Т)
