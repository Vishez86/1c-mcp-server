// MCP_Examples.bsl
// ====================================================================
// Самообучение на успешных запросах run_1c_query.
// Запись обезличенных шаблонов в журнал регистрации (событие
// "MCP.QueryExample", уровень Информация) и их чтение/ранжирование для
// read-only tool get_query_examples.
//
// Хранилище — только ЖР; расширение не добавляет собственных объектов данных.
// Классификация: operational metadata write (постоянные бизнес-данные 1С
// не изменяются). Feature строго opt-in (MCP_Config.QueryExamplesВключены).
//
// Конвейер обезличивания (§6 ТЗ):
//   1) срез комментариев + замена литералов/параметров плейсхолдерами;
//   2) СхемаЗапроса: валидация, сбор tables, канонизация идентификаторов,
//      регенерация текста (skeleton = ПолучитьТекстЗапроса());
//   3) SHA-256 от НРег(skeleton).
//
// Fail-closed: любой сбой на стадии СхемаЗапроса => пример НЕ записывается
// (недостоверные tables/частично обезличенный текст недопустимы). Обращения к
// объектной модели НЕ оборачиваются в локальные Попытка — исключение доходит
// до внешнего catch в ЗаписатьПример, который пишет диагностику skip.
// ====================================================================

// --------------------------------------------------------------------
// 1. Публичный интерфейс
// --------------------------------------------------------------------

// Записать шаблон успешного запроса. Вызывается из MCP_Tools_Impl.Run1CQuery
// после успешного возврата MCP_Query.ВыполнитьЗапросСОграничениями и только
// при пустом cursor (первая страница). Сбой записи не должен ронять run_1c_query.
Процедура ЗаписатьПример(Знач ТекстЗапроса, Знач Результат, Знач CorrelationID = "") Экспорт

	Попытка
		Если НЕ MCP_Config.QueryExamplesВключены() Тогда
			Возврат;
		КонецЕсли;

		Настройки = MCP_Config.НастройкиQueryExamples();
		Шаблон = ПостроитьШаблон(ТекстЗапроса, Настройки.max_skeleton_chars);
		Если Шаблон = Неопределено Тогда
			// Мягкий пропуск: нет реальных таблиц либо skeleton слишком длинный.
			Возврат;
		КонецЕсли;

		КоличествоСтрок = ЦелоеИзПоля(Результат, "row_count", 0);
		Комментарий = КомментарийСобытия(Шаблон, КоличествоСтрок, CorrelationID);
		ЗаписьЖурналаРегистрации(
			"MCP.QueryExample",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			Комментарий);
	Исключение
		// Жёсткий сбой (в т.ч. на стадии СхемаЗапроса): пример не записывается,
		// пишем только диагностику. Никогда не пробрасываем — run_1c_query не должен упасть.
		ЗаписатьПропуск(CorrelationID, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Прочитать и ранжировать шаблоны для tool get_query_examples.
// Аргументы уже нормализованы вызывающим (MCP_Tools_Impl.GetQueryExamples).
// Возвращает голую Структуру ответа (поле ok добавит диспетчер).
Функция ПолучитьПримеры(Знач ОбъектИмя, Знач Лимит, Знач ДнейНазад, Знач ТолькоСоСтроками) Экспорт

	Предупреждения = Новый Массив;
	Результат = Новый Структура;

	// §5.1: object нормализуется и проверяется ДО любого обращения к ЖР.
	КаноническоеИмя = "";
	Если ЗначениеЗаполнено(ОбъектИмя) Тогда
		ОМД = Метаданные.НайтиПоПолномуИмени(ОбъектИмя);
		Если ОМД = Неопределено Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
				"Объект метаданных не найден: " + ОбъектИмя);
		КонецЕсли;
		КаноническоеИмя = ОМД.ПолноеИмя();
		// Запрещённый/недоступный тип — стандартный отказ доступа (возбуждает исключение).
		MCP_Security.ПроверитьДоступКТипу(КаноническоеИмя);
	КонецЕсли;

	Сейчас = ТекущаяДатаСеанса();
	ДатаНачала = Сейчас - ДнейНазад * 86400;

	Результат.Вставить("object", КаноническоеИмя);
	Результат.Вставить("period", Новый Структура("from, to",
		Формат(ДатаНачала, "ДФ=yyyy-MM-dd"), Формат(Сейчас, "ДФ=yyyy-MM-dd")));
	Результат.Вставить("examples", Новый Массив);
	Результат.Вставить("scanned_events", 0);
	Результат.Вставить("scan_truncated", Ложь);
	Результат.Вставить("warnings", Предупреждения);

	// §7.3: feature выключен — enabled:false + source_available:false + query_examples_disabled.
	Если НЕ MCP_Config.QueryExamplesВключены() Тогда
		Результат.Вставить("enabled", Ложь);
		Результат.Вставить("source_available", Ложь);
		Предупреждения.Добавить("query_examples_disabled");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("enabled", Истина);

	// §7.1: нет права ПросмотрЖурналаРегистрации — деградация как в get_object_history.
	Если НЕ ПросмотрЖурналаДоступен() Тогда
		Результат.Вставить("source_available", Ложь);
		Предупреждения.Добавить("event_log_not_available");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("source_available", Истина);

	Настройки = MCP_Config.НастройкиQueryExamples();
	Выгрузка = ПрочитатьСобытияПримеров(ДатаНачала, Настройки.scan_cap);
	Результат.scanned_events = Выгрузка.count;
	Если Выгрузка.truncated Тогда
		Результат.scan_truncated = Истина;
		Предупреждения.Добавить("scan_truncated: часть окна не отсканирована, уменьшите days_back");
	КонецЕсли;

	Группы = СгруппироватьИОтфильтровать(Выгрузка.события, КаноническоеИмя, ТолькоСоСтроками);

	// §8: фильтрация по правам читателя — пример виден, только если каждая таблица разрешена.
	Разрешённые = Новый Массив;
	Для Каждого Гр Из Группы Цикл
		Если ТаблицыРазрешены(Гр.tables) Тогда
			Разрешённые.Добавить(Гр);
		КонецЕсли;
	КонецЦикла;

	Отсортированные = ОтсортироватьГруппы(Разрешённые);
	Для Каждого Гр Из Отсортированные Цикл
		Если Результат.examples.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Результат.examples.Добавить(ФорматироватьГруппу(Гр));
	КонецЦикла;

	// Read-only диагностика (dev-only, по умолчанию выключена): единственный
	// доступный способ прочитать skip-события, т.к. ЖР-by-event ридера среди tools нет.
	Если Настройки.debug_skip Тогда
		Результат.Вставить("diagnostics", ПрочитатьДиагностикуПропусков(ДатаНачала, Настройки.scan_cap));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// --------------------------------------------------------------------
// 2. Построение шаблона (обезличивание, §6)
// --------------------------------------------------------------------

// Возвращает Структуру {skeleton, skeleton_hash, tables, columns} либо
// Неопределено при мягком пропуске (нет реальных таблиц / skeleton длиннее лимита).
// Возбуждает исключение при жёстком сбое (ошибка стадии СхемаЗапроса/хеша).
Функция ПостроитьШаблон(Знач ТекстЗапроса, Знач МаксСимволов)

	// Стадия 1-2: срез комментариев + плейсхолдеры литералов/параметров (чистые строки).
	ТекстСПлейсхолдерами = ЗаменитьЛитералыИКомментарии(ТекстЗапроса);

	// Стадия 3: СхемаЗапроса — валидация, tables, канонизация, регенерация.
	Попытка
		Разбор = ПрименитьСхему(ТекстСПлейсхолдерами);
	Исключение
		ВызватьИсключение "QueryExample stage=schema :: " + ОписаниеОшибки();
	КонецПопытки;

	Если Разбор = Неопределено Тогда
		// Мягкий пропуск: в skeleton остался необойдённый ВЫБРАТЬ (подзапрос вне FROM) —
		// его идентификаторы/таблицы не канонизированы и не собраны (§6.4/§6.5/§8), не записываем.
		Возврат Неопределено;
	КонецЕсли;

	Если Разбор.tables.Количество() = 0 Тогда
		// §6.4: реальных источников не осталось — не записываем.
		Возврат Неопределено;
	КонецЕсли;

	Скелет = Разбор.skeleton;
	Если СтрДлина(Скелет) > МаксСимволов Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Стадия 4: хеш.
	Попытка
		Хеш = ХешСкелета(Скелет);
	Исключение
		ВызватьИсключение "QueryExample stage=hash :: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Новый Структура("skeleton, skeleton_hash, tables, columns",
		Скелет, Хеш, Разбор.tables, Разбор.columns);

КонецФункции

// §6.1-6.3: срез комментариев и замена литералов/имён параметров плейсхолдерами.
// Токенизатор (не regex): строковые литералы 1С содержат "" внутри строк.
Функция ЗаменитьЛитералыИКомментарии(Знач Текст)

	Токены = Токенизировать(Текст);

	Части = Новый Массив;
	СоотвСтрока = Новый Соответствие;
	СоотвДата = Новый Соответствие;
	СоотвЧисло = Новый Соответствие;
	СоотвПарам = Новый Соответствие;
	Счётчики = Новый Структура("строка, дата, число, парам", 0, 0, 0, 0);

	ПредЗначащий = Неопределено;     // Структура("текст, междуИ")
	ПредПредЗначащий = Неопределено; // значащий токен перед ПредЗначащий (для унарного знака)
	МеждуОжидает = Ложь;
	СтекСкобок = Новый Массив; // Массив булево: истина = скобка списка В (…)

	Всего = Токены.Количество();
	Индекс = 0;
	Пока Индекс < Всего Цикл
		Токен = Токены[Индекс];

		Если Токен.вид = "пробел" Тогда
			Части.Добавить(Токен.значение);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		// ДАТАВРЕМЯ(...) — свернуть в &Дата<N>.
		Если Токен.вид = "идент"
			И (ВРег(Токен.значение) = "ДАТАВРЕМЯ" ИЛИ ВРег(Токен.значение) = "DATETIME") Тогда
			КонецГруппы = НайтиКонецВызова(Токены, Индекс);
			Если КонецГруппы > Индекс Тогда
				Ключ = ВРег(СоединитьЗначения(Токены, Индекс, КонецГруппы));
				Части.Добавить(Плейсхолдер(СоотвДата, Счётчики, "дата", "&Дата", Ключ));
				СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Дата", Ложь));
				Индекс = КонецГруппы + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если Токен.вид = "строка" Тогда
			Если СтрДлина(Токен.значение) <= 2 Тогда
				// Пустой строковый литерал "" — оставляем как есть.
				Части.Добавить(Токен.значение);
			Иначе
				Части.Добавить(Плейсхолдер(СоотвСтрока, Счётчики, "строка", "&Строка", Токен.значение));
			КонецЕсли;
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Строка", Ложь));

		ИначеЕсли Токен.вид = "параметр" Тогда
			// §6.2: имена параметров канонизируются (канал утечки: &ИНН_123).
			Части.Добавить(Плейсхолдер(СоотвПарам, Счётчики, "парам", "&Парам", ВРег(Токен.значение)));
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Парам", Ложь));

		ИначеЕсли Токен.вид = "число" Тогда
			// Назад: операнд справа/список (Сумма > 100, В (…), МЕЖДУ …); вперёд: реверс-операнд (100 = Сумма).
			Если ЧислоВПозицииЗначения(ПредЗначащий, ПредПредЗначащий, СтекСкобок)
				ИЛИ СледующийТокенСравнение(Токены, Индекс) Тогда
				Части.Добавить(Плейсхолдер(СоотвЧисло, Счётчики, "число", "&Число", Токен.значение));
			Иначе
				Части.Добавить(Токен.значение);
			КонецЕсли;
			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен("&Число", Ложь));

		Иначе
			// идент / оператор / символ — переносится дословно.
			Части.Добавить(Токен.значение);

			МеждуИ = Ложь;
			Если Токен.вид = "идент" Тогда
				ВР = ВРег(Токен.значение);
				Если ВР = "МЕЖДУ" ИЛИ ВР = "BETWEEN" Тогда
					МеждуОжидает = Истина;
				ИначеЕсли (ВР = "И" ИЛИ ВР = "AND") И МеждуОжидает Тогда
					МеждуИ = Истина;
					МеждуОжидает = Ложь;
				КонецЕсли;
			КонецЕсли;

			Если Токен.значение = "(" Тогда
				СтекСкобок.Добавить(ПередСкобкойОжидаетсяЗначение(ПредЗначащий, ПредПредЗначащий));
			ИначеЕсли Токен.значение = ")" Тогда
				Если СтекСкобок.Количество() > 0 Тогда
					СтекСкобок.Удалить(СтекСкобок.Количество() - 1);
				КонецЕсли;
			КонецЕсли;

			СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, ЗначащийТокен(Токен.значение, МеждуИ));
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Сдвиг двухуровневого окна значащих токенов (BSL передаёт первые два параметра по ссылке).
Процедура СдвинутьПредЗначащий(ПредПредЗначащий, ПредЗначащий, Знач НовыйТокен)
	ПредПредЗначащий = ПредЗначащий;
	ПредЗначащий = НовыйТокен;
КонецПроцедуры

Функция ЗначащийТокен(Знач Текст, Знач МеждуИ)
	Возврат Новый Структура("текст, междуИ", Текст, МеждуИ);
КонецФункции

// Истина, если после этого значащего токена ожидается операнд-значение:
// оператор сравнения, МЕЖДУ, соединительное И внутри МЕЖДУ, либо В/IN.
Функция ТокенОжидаетЗначение(Знач Токен)
	Если Токен = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = Токен.текст;
	Если Т = "=" ИЛИ Т = "<>" ИЛИ Т = "<" ИЛИ Т = ">" ИЛИ Т = "<=" ИЛИ Т = ">=" Тогда
		Возврат Истина;
	КонецЕсли;
	ВР = ВРег(Т);
	Если ВР = "МЕЖДУ" ИЛИ ВР = "BETWEEN" Тогда
		Возврат Истина;
	КонецЕсли;
	Если (ВР = "И" ИЛИ ВР = "AND") И Токен.междуИ Тогда
		Возврат Истина;
	КонецЕсли;
	Если ВР = "В" ИЛИ ВР = "IN" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Предыдущий значащий токен с просмотром через ведущий унарный знак -/+
// ("Сумма > -100", "= -5"): эффективным считаем токен ПЕРЕД знаком.
Функция ЭффективныйПред(Знач ПредЗначащий, Знач ПредПредЗначащий)
	Если ПредЗначащий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если (ПредЗначащий.текст = "-" ИЛИ ПредЗначащий.текст = "+") И ПредПредЗначащий <> Неопределено Тогда
		Возврат ПредПредЗначащий;
	КонецЕсли;
	Возврат ПредЗначащий;
КонецФункции

// Рамка открывающей скобки: истина, если "(" открывает список/скобку значения
// (В (…), = (…), МЕЖДУ (…), И (…) внутри МЕЖДУ) — тогда числа внутри — значения.
Функция ПередСкобкойОжидаетсяЗначение(Знач ПредЗначащий, Знач ПредПредЗначащий)
	Возврат ТокенОжидаетЗначение(ЭффективныйПред(ПредЗначащий, ПредПредЗначащий));
КонецФункции

// §6.3: число (по предыдущему токену) — операнд справа от сравнения/МЕЖДУ/В,
// либо элемент скобки/списка, ожидающих значение.
Функция ЧислоВПозицииЗначения(Знач ПредЗначащий, Знач ПредПредЗначащий, Знач СтекСкобок)

	Эффективный = ЭффективныйПред(ПредЗначащий, ПредПредЗначащий);
	Если Эффективный = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТокенОжидаетЗначение(Эффективный) Тогда
		Возврат Истина;
	КонецЕсли;

	// ( или , внутри скобки, ожидающей значение (В (…), = (…), МЕЖДУ (…) …).
	Т = Эффективный.текст;
	Если (Т = "(" ИЛИ Т = ",")
		И СтекСкобок.Количество() > 0
		И СтекСкобок[СтекСкобок.Количество() - 1] = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Следующий значащий (не пробельный) токен после Индекс, либо Неопределено.
Функция СледующийЗначащий(Знач Токены, Знач Индекс)
	Результат = Индекс + 1;
	Пока Результат < Токены.Количество() Цикл
		Если Токены[Результат].вид <> "пробел" Тогда
			Возврат Токены[Результат];
		КонецЕсли;
		Результат = Результат + 1;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Реверс-операнд: за числом сразу идёт оператор сравнения (100 = Сумма).
Функция СледующийТокенСравнение(Знач Токены, Знач Индекс)
	След = СледующийЗначащий(Токены, Индекс);
	Если След = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = След.значение;
	Возврат Т = "=" ИЛИ Т = "<>" ИЛИ Т = "<" ИЛИ Т = ">" ИЛИ Т = "<=" ИЛИ Т = ">=";
КонецФункции

Функция Плейсхолдер(Соотв, Счётчики, Знач ИмяСчётчика, Знач Префикс, Знач Ключ)
	Существующий = Соотв.Получить(Ключ);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Счётчики[ИмяСчётчика] = Счётчики[ИмяСчётчика] + 1;
	Значение = Префикс + Счётчики[ИмяСчётчика];
	Соотв.Вставить(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Индекс закрывающей ")" для вызова вида ИМЯ( ... ), начиная с индекса имени.
// Возвращает индекс ")" либо -1, если "(" сразу не найдена.
Функция НайтиКонецВызова(Знач Токены, Знач ИндексИмени)
	Всего = Токены.Количество();
	Результат = ИндексИмени + 1;
	Пока Результат < Всего И Токены[Результат].вид = "пробел" Цикл
		Результат = Результат + 1;
	КонецЦикла;
	Если Результат >= Всего ИЛИ Токены[Результат].значение <> "(" Тогда
		Возврат -1;
	КонецЕсли;
	Глубина = 0;
	Пока Результат < Всего Цикл
		Значение = Токены[Результат].значение;
		Если Значение = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Значение = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + 1;
	КонецЦикла;
	Возврат -1;
КонецФункции

Функция СоединитьЗначения(Знач Токены, Знач От, Знач До)
	Части = Новый Массив;
	Для Результат = От По До Цикл
		Если Токены[Результат].вид <> "пробел" Тогда
			Части.Добавить(Токены[Результат].значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// --------------------------------------------------------------------
// 3. Токенизатор
// --------------------------------------------------------------------

Функция Токенизировать(Знач Текст)

	Токены = Новый Массив;
	Длина = СтрДлина(Текст);
	П = 1;

	Пока П <= Длина Цикл
		С = Сред(Текст, П, 1);
		След = ?(П < Длина, Сред(Текст, П + 1, 1), "");

		Если ЭтоПробельный(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоПробельный(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Строчный комментарий // …
		Если С = "/" И След = "/" Тогда
			Пока П <= Длина Цикл
				Ткщ = Сред(Текст, П, 1);
				Если Ткщ = Символы.ПС ИЛИ Ткщ = Символы.ВК Тогда
					Прервать;
				КонецЕсли;
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", " ");
			Продолжить;
		КонецЕсли;

		// Блочный комментарий /* … */ (язык запросов не поддерживает — срезаем на будущее).
		Если С = "/" И След = "*" Тогда
			П = П + 2;
			Пока П <= Длина Цикл
				Если Сред(Текст, П, 1) = "*" И Сред(Текст, П + 1, 1) = "/" Тогда
					П = П + 2;
					Прервать;
				КонецЕсли;
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "пробел", " ");
			Продолжить;
		КонецЕсли;

		// Строковый литерал "…" с экранированием "".
		Если С = """" Тогда
			Старт = П;
			П = П + 1;
			Пока П <= Длина Цикл
				Ткщ = Сред(Текст, П, 1);
				Если Ткщ = """" Тогда
					Если Сред(Текст, П + 1, 1) = """" Тогда
						П = П + 2;
						Продолжить;
					Иначе
						П = П + 1;
						Прервать;
					КонецЕсли;
				Иначе
					П = П + 1;
				КонецЕсли;
			КонецЦикла;
			ДобавитьТокен(Токены, "строка", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Параметр &Имя.
		Если С = "&" Тогда
			Старт = П;
			П = П + 1;
			Пока П <= Длина И ЭтоСимволИдентификатора(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "параметр", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Число (с опциональной дробной частью).
		Если ЭтоЦифра(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоЦифра(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			Если П <= Длина И Сред(Текст, П, 1) = "." И ЭтоЦифра(Сред(Текст, П + 1, 1)) Тогда
				П = П + 1;
				Пока П <= Длина И ЭтоЦифра(Сред(Текст, П, 1)) Цикл
					П = П + 1;
				КонецЦикла;
			КонецЕсли;
			ДобавитьТокен(Токены, "число", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Идентификатор / ключевое слово.
		Если ЭтоНачалоИдентификатора(С) Тогда
			Старт = П;
			Пока П <= Длина И ЭтоСимволИдентификатора(Сред(Текст, П, 1)) Цикл
				П = П + 1;
			КонецЦикла;
			ДобавитьТокен(Токены, "идент", Сред(Текст, Старт, П - Старт));
			Продолжить;
		КонецЕсли;

		// Многосимвольные операторы.
		Пара = С + След;
		Если Пара = "<=" ИЛИ Пара = ">=" ИЛИ Пара = "<>" Тогда
			ДобавитьТокен(Токены, "оператор", Пара);
			П = П + 2;
			Продолжить;
		КонецЕсли;

		// Одиночный символ.
		Если С = "=" ИЛИ С = "<" ИЛИ С = ">" Тогда
			ДобавитьТокен(Токены, "оператор", С);
		Иначе
			ДобавитьТокен(Токены, "символ", С);
		КонецЕсли;
		П = П + 1;
	КонецЦикла;

	Возврат Токены;

КонецФункции

Процедура ДобавитьТокен(Токены, Знач Вид, Знач Значение)
	Токены.Добавить(Новый Структура("вид, значение", Вид, Значение));
КонецПроцедуры

Функция ЭтоПробельный(Знач С)
	Возврат С = " " ИЛИ С = Символы.Таб ИЛИ С = Символы.ПС ИЛИ С = Символы.ВК ИЛИ С = Символы.НПП;
КонецФункции

Функция ЭтоЦифра(Знач С)
	Если ПустаяСтрока(С) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(С);
	Возврат Код >= 48 И Код <= 57;
КонецФункции

Функция ЭтоНачалоИдентификатора(Знач С)
	Возврат ЭтоБуква(С) ИЛИ С = "_";
КонецФункции

Функция ЭтоСимволИдентификатора(Знач С)
	Возврат ЭтоБуква(С) ИЛИ С = "_" ИЛИ ЭтоЦифра(С);
КонецФункции

Функция ЭтоБуква(Знач С)
	Если ПустаяСтрока(С) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(С);
	// Латиница.
	Если (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122) Тогда
		Возврат Истина;
	КонецЕсли;
	// Кириллица А-я + Ё/ё.
	Если (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// --------------------------------------------------------------------
// 4. СхемаЗапроса: tables (§6.4) + канонизация (§6.5) + регенерация
// --------------------------------------------------------------------
// ВНИМАНИЕ: имена свойств/типов объектной модели СхемаЗапроса в кодовой базе
// прецедента не имеют и не подтверждаются встроенной документацией сервера.
// Проверяются эмпирически после деплоя (skip-диагностика покажет неверное имя).
// Локальные Попытка здесь НЕ используются намеренно (fail-closed, без утечки).

Функция ПрименитьСхему(Знач ТекстСПлейсхолдерами)

	Схема = Новый СхемаЗапроса;
	Схема.УстановитьТекстЗапроса(ТекстСПлейсхолдерами);

	Таблицы = Новый Массив;
	Видимые = Новый Соответствие;                        // ВРег(полное имя) -> Истина (дедуп tables)
	КартаВТ = Новый Соответствие;                        // ВРег(старое имя ВТ) -> "ВТ<N>"
	Счётчики = Новый Структура("т, вт, операторы", 0, 0, 0); // сквозные счётчики + число обойдённых операторов
	КолонкиРезультата = Новый Массив;

	// Элемент коллекции Схема.Пакеты САМ является объектом-запросом (канонический идиом
	// Схема.Пакеты[N].Операторы[M] / .Колонки / .ТаблицаДляПомещения) — промежуточного
	// свойства .Запрос у пакета нет. Пакеты УНИЧТОЖИТЬ (нет .ТаблицаДляПомещения/.Колонки)
	// редки и здесь приводят к исключению -> внешний catch в ЗаписатьПример -> пример не
	// пишется (fail-closed, без утечки). Точные имена типов пакетов не используются намеренно.

	// Проход 1: собрать и переименовать имена временных таблиц (ПОМЕСТИТЬ) -> ВТ<N>.
	Для Каждого Пакет Из Схема.Пакеты Цикл
		ИмяВТ = Строка(Пакет.ТаблицаДляПомещения);
		Если ЗначениеЗаполнено(ИмяВТ) Тогда
			Счётчики.вт = Счётчики.вт + 1;
			Новое = "ВТ" + Счётчики.вт;
			КартаВТ.Вставить(ВРег(ИмяВТ), Новое);
			Пакет.ТаблицаДляПомещения = Новое;
		КонецЕсли;
	КонецЦикла;

	// Проход 2: колонки результата + операторы/источники (сбор tables, канонизация, ссылки на ВТ).
	Для Каждого Пакет Из Схема.Пакеты Цикл
		КолонкиРезультата = КанонизироватьКолонки(Пакет);
		Для Каждого Оператор Из Пакет.Операторы Цикл
			ОбойтиИсточникиОператора(Оператор, Таблицы, Видимые, Счётчики, КартаВТ);
		КонецЦикла;
	КонецЦикла;

	Скелет = Схема.ПолучитьТекстЗапроса();

	// Инвариант §6.4/§6.5/§8: в skeleton не должно остаться ни одного ВЫБРАТЬ, который мы НЕ обошли.
	// Обход канонизирует источники/псевдонимы/ВТ и собирает tables только в позиции FROM (и во
	// вложенных запросах-источниках FROM). Подзапросы в списке ВЫБРАТЬ и в ГДЕ канонизация не
	// достаёт: их говорящие псевдонимы/имена ВТ регенерировались бы дословно (утечка), а их таблицы
	// не попали бы в tables (обход прав §8 неполный). Каждый обойдённый оператор ~ один ВЫБРАТЬ;
	// если в тексте ВЫБРАТЬ больше — есть необойдённый подзапрос, пример не записываем (Неопределено).
	Если ЧислоВыбратьВТексте(Скелет) > Счётчики.операторы Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("skeleton, tables, columns", Скелет, Таблицы, КолонкиРезультата);

КонецФункции

// Канонизировать псевдонимы колонок результата запроса -> Поле<N>. Возвращает
// массив итоговых псевдонимов (для последнего пакета это columns результата).
// §6.5: авто-псевдоним (совпадает с последним сегментом выражения поля) сохраняется —
// он уже присутствует в запросе как имя метаданных и данных не несёт.
Функция КанонизироватьКолонки(Запрос)
	Псевдонимы = Новый Массив;
	Ном = 0;
	Для Каждого Колонка Из Запрос.Колонки Цикл
		Если АвтоПсевдонимКолонки(Колонка) Тогда
			Псевдонимы.Добавить(Строка(Колонка.Псевдоним));
		Иначе
			Ном = Ном + 1;
			Псевд = "Поле" + Ном;
			Колонка.Псевдоним = Псевд;
			Псевдонимы.Добавить(Псевд);
		КонецЕсли;
	КонецЦикла;
	Возврат Псевдонимы;
КонецФункции

// Истина, если псевдоним колонки без учёта регистра равен последнему сегменту выражения
// поля (авто-псевдоним, напр. Т1.СуммаОстаток КАК СуммаОстаток). Чтение выражения обёрнуто
// в Попытку с безопасным откатом: неизвестное имя свойства -> Ложь -> колонка канонизируется
// в Поле<N> (сторона большей маскировки, не утечка), поэтому эта неопределённость API не
// нарушает fail-closed и не роняет запись примера.
Функция АвтоПсевдонимКолонки(Знач Колонка)
	Попытка
		Псевд = Строка(Колонка.Псевдоним);
		Выражение = Строка(Колонка.Выражение);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Псевд) ИЛИ НЕ ЗначениеЗаполнено(Выражение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НРег(ПоследнийСегмент(Выражение)) = НРег(Псевд);
КонецФункции

Процедура ОбойтиИсточникиОператора(Оператор, Таблицы, Видимые, Счётчики, КартаВТ)
	// Один оператор ~ один ВЫБРАТЬ. Считаем ВСЕ обойдённые операторы (включая операнды ОБЪЕДИНИТЬ
	// и операторы вложенных запросов-источников FROM) для инварианта в ПрименитьСхему.
	Счётчики.операторы = Счётчики.операторы + 1;
	Для Каждого ИсточникЗапроса Из Оператор.Источники Цикл
		ОбработатьОписаниеИсточника(ИсточникЗапроса.Источник, Таблицы, Видимые, Счётчики, КартаВТ);
		Для Каждого Соединение Из ИсточникЗапроса.Соединения Цикл
			ОбработатьОписаниеИсточника(Соединение.Источник, Таблицы, Видимые, Счётчики, КартаВТ);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработатьОписаниеИсточника(Описание, Таблицы, Видимые, Счётчики, КартаВТ)

	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица = Описание.Таблица;

	Если ТипЗнч(Таблица) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		// Подзапрос-источник: канонизировать его псевдоним и рекурсивно обойти.
		КанонизироватьПсевдонимИсточника(Описание, "", Счётчики);
		ВложенныйЗапрос = Таблица.Запрос;
		КанонизироватьКолонки(ВложенныйЗапрос);
		Для Каждого Оператор Из ВложенныйЗапрос.Операторы Цикл
			ОбойтиИсточникиОператора(Оператор, Таблицы, Видимые, Счётчики, КартаВТ);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Таблица) = Тип("ТаблицаСхемыЗапроса") Тогда
		ИмяТаблицы = Строка(Таблица.ИмяТаблицы);

		// Ссылка на временную таблицу — переименовать по карте, в tables не кладём.
		Новое = КартаВТ.Получить(ВРег(ИмяТаблицы));
		Если Новое <> Неопределено Тогда
			Таблица.ИмяТаблицы = Новое;
			КанонизироватьПсевдонимИсточника(Описание, "", Счётчики);
			Возврат;
		КонецЕсли;

		База = БазовыйОбъектТаблицы(ИмяТаблицы);
		Если База <> Неопределено Тогда
			Если Видимые.Получить(ВРег(База)) = Неопределено Тогда
				Видимые.Вставить(ВРег(База), Истина);
				Таблицы.Добавить(База);
			КонецЕсли;
			КанонизироватьПсевдонимИсточника(Описание, ПоследнийСегмент(База), Счётчики);
		Иначе
			// Не резолвится и не в карте ВТ (напр. ссылка на ВТ из МенеджерВТ) — канонизируем псевдоним.
			КанонизироватьПсевдонимИсточника(Описание, "", Счётчики);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Прочие типы источников (таблица-выражение &Параметр и т.п.) — только псевдоним.
	КанонизироватьПсевдонимИсточника(Описание, "", Счётчики);

КонецПроцедуры

// §6.5: псевдоним источника -> Т<N>, кроме случая, когда он без учёта регистра
// совпадает с именем объекта метаданных (авто-псевдоним, данных не несёт).
Процедура КанонизироватьПсевдонимИсточника(Описание, Знач ИмяОбъекта, Счётчики)
	Текущий = Строка(Описание.Псевдоним);
	Если ЗначениеЗаполнено(ИмяОбъекта) И НРег(Текущий) = НРег(ИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;
	Счётчики.т = Счётчики.т + 1;
	Описание.Псевдоним = "Т" + Счётчики.т;
КонецПроцедуры

// "РегистрБухгалтерии.Хозрасчетный.Остатки" -> "РегистрБухгалтерии.Хозрасчетный",
// если 2-сегментный префикс резолвится как объект метаданных; иначе Неопределено.
Функция БазовыйОбъектТаблицы(Знач ИмяТаблицы)
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сегменты = СтрРазделить(ИмяТаблицы, ".", Истина);
	Если Сегменты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Кандидат = Сегменты[0] + "." + Сегменты[1];
	ОМД = Неопределено;
	Попытка
		ОМД = Метаданные.НайтиПоПолномуИмени(Кандидат);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ОМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОМД.ПолноеИмя();
КонецФункции

Функция ПоследнийСегмент(Знач ПолноеИмя)
	Сегменты = СтрРазделить(ПолноеИмя, ".", Истина);
	Возврат ?(Сегменты.Количество() > 0, Сегменты[Сегменты.Количество() - 1], ПолноеИмя);
КонецФункции

// Число ключевых слов ВЫБРАТЬ/SELECT в тексте (через токенизатор, чтобы не считать
// вхождения внутри строк/комментариев; в skeleton литералы уже плейсхолдеры, но токенизатор
// корректен в общем случае). Используется инвариантом полноты канонизации в ПрименитьСхему.
Функция ЧислоВыбратьВТексте(Знач Текст)
	Счёт = 0;
	Для Каждого Токен Из Токенизировать(Текст) Цикл
		Если Токен.вид = "идент" Тогда
			ВР = ВРег(Токен.значение);
			Если ВР = "ВЫБРАТЬ" ИЛИ ВР = "SELECT" Тогда
				Счёт = Счёт + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Счёт;
КонецФункции

// --------------------------------------------------------------------
// 5. Хеширование (§6.6)
// --------------------------------------------------------------------

Функция ХешСкелета(Знач Скелет)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(НРег(Скелет)));
	ДвоичныеДанные = Хеширование.ХешСумма;
	Попытка
		Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные));
	Исключение
		// Если Hex-функция недоступна — стабильный base64 (внутренний ключ, формат не критичен).
		Возврат Base64Строка(ДвоичныеДанные);
	КонецПопытки;
КонецФункции

// --------------------------------------------------------------------
// 6. Формирование комментария события
// --------------------------------------------------------------------

Функция КомментарийСобытия(Знач Шаблон, Знач КоличествоСтрок, Знач CorrelationID)
	Стр = Новый Структура;
	Стр.Вставить("v", 1);
	Стр.Вставить("skeleton", Шаблон.skeleton);
	Стр.Вставить("skeleton_hash", Шаблон.skeleton_hash);
	Стр.Вставить("tables", Шаблон.tables);
	Стр.Вставить("columns", Шаблон.columns);
	Стр.Вставить("row_count", КоличествоСтрок);
	Стр.Вставить("has_rows", КоличествоСтрок > 0);
	Стр.Вставить("configuration_name", Строка(Метаданные.Имя));
	Стр.Вставить("configuration_version", Строка(Метаданные.Версия));
	Стр.Вставить("correlation_id", Строка(CorrelationID));
	Возврат ВСтрокуJSON(Стр);
КонецФункции

Процедура ЗаписатьПропуск(Знач CorrelationID, Знач ТекстОшибки)
	Попытка
		Настройки = MCP_Config.НастройкиQueryExamples();
		Стр = Новый Структура;
		Стр.Вставить("v", 1);
		Стр.Вставить("correlation_id", Строка(CorrelationID));
		Если Настройки.debug_skip Тогда
			// ВНИМАНИЕ: платформенный ОписаниеОшибки() при сбое стадии СхемаЗапроса цитирует
			// фрагмент запроса, а идентификаторы (говорящие псевдонимы, имена ВТ типа ВТ_ИНН123,
			// имена колонок) на этой стадии ЕЩЁ НЕ канонизированы (§6.5). То есть при debug_skip
			// сырые идентификаторы могут попасть в событие. Это осознанный dev/test-only компромисс
			// ради отладки объектной модели СхемаЗапроса; в проде debug_skip обязан быть false
			// (см. INSTALL.md, раздел query_examples).
			Стр.Вставить("error", Лев(Строка(ТекстОшибки), 2000));
		КонецЕсли;
		ЗаписьЖурналаРегистрации(
			"MCP.QueryExample.skip",
			УровеньЖурналаРегистрации.Примечание,
			,
			,
			ВСтрокуJSON(Стр));
	Исключение
		// Диагностика не должна ничего ронять.
	КонецПопытки;
КонецПроцедуры

// --------------------------------------------------------------------
// 7. Чтение и ранжирование (§7)
// --------------------------------------------------------------------

Функция ПросмотрЖурналаДоступен()
	Попытка
		Возврат ПравоДоступа("ПросмотрЖурналаРегистрации", Метаданные);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ПрочитатьСобытияПримеров(Знач ДатаНачала, Знач Потолок)

	События = Новый Массив;
	Отсканировано = 0;
	Усечено = Ложь;

	Попытка
		СписокСобытий = Новый Массив;
		СписокСобытий.Добавить("MCP.QueryExample");

		Отбор = Новый Структура;
		Отбор.Вставить("Событие", СписокСобытий);
		Отбор.Вставить("ДатаНачала", ДатаНачала);
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Информация);

		ТЗ = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТЗ, Отбор, , , Потолок);
		Отсканировано = ТЗ.Количество();
		Если Отсканировано >= Потолок Тогда
			// Порядок и отрезаемый конец окна платформой не гарантируются.
			Усечено = Истина;
		КонецЕсли;

		ТЗ.Сортировать("Дата Убыв");
		Для Каждого Строка Из ТЗ Цикл
			Данные = ИзСтрокиJSON(Строка.Комментарий);
			Если Данные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			События.Добавить(Новый Структура("Дата, Данные", Строка.Дата, Данные));
		КонецЦикла;
	Исключение
		// Журнал недоступен — деградация как в get_object_history.
	КонецПопытки;

	Возврат Новый Структура("события, count, truncated", События, Отсканировано, Усечено);

КонецФункции

Функция СгруппироватьИОтфильтровать(Знач События, Знач КаноническоеИмя, Знач ТолькоСоСтроками)

	ТекущееИмя = Строка(Метаданные.Имя);
	ТекущаяВерсия = Строка(Метаданные.Версия);

	Группы = Новый Соответствие; // hash -> группа
	Порядок = Новый Массив;      // порядок появления hash

	Для Каждого Событие Из События Цикл
		Д = Событие.Данные;

		Если ЦелоеИзJSON(ЗначПоле(Д, "v", 0)) <> 1 Тогда
			Продолжить;
		КонецЕсли;

		ИмяКонфиг = Строка(ЗначПоле(Д, "configuration_name", ""));
		Если НРег(ИмяКонфиг) <> НРег(ТекущееИмя) Тогда
			Продолжить; // §7.2: отсекаем шаблоны прежней конфигурации.
		КонецЕсли;

		Таблицы = ЗначПоле(Д, "tables", Неопределено);
		Если ТипЗнч(Таблицы) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(КаноническоеИмя) И НЕ СодержитБезРегистра(Таблицы, КаноническоеИмя) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьСтроки = (ЗначПоле(Д, "has_rows", Ложь) = Истина);
		Если ТолькоСоСтроками И НЕ ЕстьСтроки Тогда
			Продолжить; // §7.2: has_rows=false исключаются до группировки.
		КонецЕсли;

		Хеш = Строка(ЗначПоле(Д, "skeleton_hash", ""));
		Если ПустаяСтрока(Хеш) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоСтрок = ЦелоеИзJSON(ЗначПоле(Д, "row_count", 0));
		ЭтоТекущая = (Строка(ЗначПоле(Д, "configuration_version", "")) = ТекущаяВерсия);

		Группа = Группы.Получить(Хеш);
		Если Группа = Неопределено Тогда
			Группа = НоваяГруппа(Хеш);
			Группы.Вставить(Хеш, Группа);
			Порядок.Добавить(Хеш);
		КонецЕсли;

		Группа.uses = Группа.uses + 1;
		Если ЭтоТекущая Тогда
			Группа.uses_current_config = Группа.uses_current_config + 1;
		КонецЕсли;
		Если Событие.Дата > Группа.last_used Тогда
			Группа.last_used = Событие.Дата;
		КонецЕсли;
		Если КоличествоСтрок > Группа.row_count_max Тогда
			Группа.row_count_max = КоличествоСтрок;
		КонецЕсли;

		// Представитель (§5.2): свежайшее событие текущей версии, иначе свежайшее.
		// События идут по Дата УБЫВ, поэтому первый подходящий и есть свежайший.
		Если ЭтоТекущая И Группа.repr_current = Ложь Тогда
			ЗаполнитьПредставителя(Группа, Д, Таблицы);
			Группа.repr_current = Истина;
		ИначеЕсли НЕ Группа.repr_current И НЕ Группа.repr_any Тогда
			ЗаполнитьПредставителя(Группа, Д, Таблицы);
			Группа.repr_any = Истина;
		КонецЕсли;
	КонецЦикла;

	Список = Новый Массив;
	Для Каждого Хеш Из Порядок Цикл
		Список.Добавить(Группы.Получить(Хеш));
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция НоваяГруппа(Знач Хеш)
	Группа = Новый Структура;
	Группа.Вставить("hash", Хеш);
	Группа.Вставить("uses", 0);
	Группа.Вставить("uses_current_config", 0);
	Группа.Вставить("last_used", '00010101');
	Группа.Вставить("row_count_max", 0);
	Группа.Вставить("skeleton", "");
	Группа.Вставить("tables", Новый Массив);
	Группа.Вставить("columns", Новый Массив);
	Группа.Вставить("repr_current", Ложь);
	Группа.Вставить("repr_any", Ложь);
	Возврат Группа;
КонецФункции

Процедура ЗаполнитьПредставителя(Группа, Знач Данные, Знач Таблицы)
	Группа.skeleton = Строка(ЗначПоле(Данные, "skeleton", ""));
	Группа.tables = Таблицы;
	Колонки = ЗначПоле(Данные, "columns", Неопределено);
	Группа.columns = ?(ТипЗнч(Колонки) = Тип("Массив"), Колонки, Новый Массив);
КонецПроцедуры

Функция ОтсортироватьГруппы(Знач Список)
	// §5.2: config_version_match УБЫВ, uses УБЫВ, last_used УБЫВ.
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("группа");
	ТЗ.Колонки.Добавить("config_match", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("uses", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("last_used", Новый ОписаниеТипов("Дата"));
	Для Каждого Группа Из Список Цикл
		Строка = ТЗ.Добавить();
		Строка.группа = Группа;
		Строка.config_match = ?(Группа.uses_current_config > 0, 1, 0);
		Строка.uses = Группа.uses;
		Строка.last_used = Группа.last_used;
	КонецЦикла;
	ТЗ.Сортировать("config_match Убыв, uses Убыв, last_used Убыв");
	Результат = Новый Массив;
	Для Каждого Строка Из ТЗ Цикл
		Результат.Добавить(Строка.группа);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ФорматироватьГруппу(Знач Группа)
	Элемент = Новый Структура;
	Элемент.Вставить("skeleton", Группа.skeleton);
	Элемент.Вставить("tables", Группа.tables);
	Элемент.Вставить("uses", Группа.uses);
	Элемент.Вставить("uses_current_config", Группа.uses_current_config);
	Элемент.Вставить("last_used", Формат(Группа.last_used, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Элемент.Вставить("row_count_max", Группа.row_count_max);
	Элемент.Вставить("columns", Группа.columns);
	Элемент.Вставить("config_version_match", Группа.uses_current_config > 0);
	Возврат Элемент;
КонецФункции

// §8: пример виден, только если каждая таблица разрешена текущему пользователю.
Функция ТаблицыРазрешены(Знач Таблицы)
	Если ТипЗнч(Таблицы) <> Тип("Массив") ИЛИ Таблицы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Таблица Из Таблицы Цикл
		Доступ = Неопределено;
		Попытка
			Доступ = MCP_Security.ДоступКТипу(Строка(Таблица), "read");
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Разрешено = Ложь;
		Если ТипЗнч(Доступ) = Тип("Структура") И Доступ.Свойство("allowed") Тогда
			Разрешено = (Доступ.allowed = Истина);
		КонецЕсли;
		Если НЕ Разрешено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПрочитатьДиагностикуПропусков(Знач ДатаНачала, Знач Потолок)
	Записи = Новый Массив;
	Попытка
		СписокСобытий = Новый Массив;
		СписокСобытий.Добавить("MCP.QueryExample.skip");
		Отбор = Новый Структура;
		Отбор.Вставить("Событие", СписокСобытий);
		Отбор.Вставить("ДатаНачала", ДатаНачала);
		ТЗ = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТЗ, Отбор, , , Потолок);
		ТЗ.Сортировать("Дата Убыв");
		Счётчик = 0;
		Для Каждого Строка Из ТЗ Цикл
			Если Счётчик >= 50 Тогда
				Прервать;
			КонецЕсли;
			Данные = ИзСтрокиJSON(Строка.Комментарий);
			Запись = Новый Структура;
			Запись.Вставить("at", Формат(Строка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Запись.Вставить("error", ?(Данные = Неопределено, "", ЗначПоле(Данные, "error", "")));
			Записи.Добавить(Запись);
			Счётчик = Счётчик + 1;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Записи;
КонецФункции

// --------------------------------------------------------------------
// 8. Вспомогательные (JSON, доступ к полям)
// --------------------------------------------------------------------

Функция ВСтрокуJSON(Знач Значение)
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Значение);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;
КонецФункции

Функция ИзСтрокиJSON(Знач Текст)
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Значение = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Значение;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЗначПоле(Знач Контейнер, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Контейнер) = Тип("Соответствие")
		ИЛИ ТипЗнч(Контейнер) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Контейнер.Получить(Имя);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	КонецЕсли;
	Если ТипЗнч(Контейнер) = Тип("Структура")
		ИЛИ ТипЗнч(Контейнер) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Возврат ?(Контейнер.Свойство(Имя, Значение), Значение, ПоУмолчанию);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЦелоеИзJSON(Знач Значение)
	Попытка
		Возврат Цел(Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ЦелоеИзПоля(Знач Контейнер, Знач Имя, Знач ПоУмолчанию)
	Возврат ЦелоеИзJSON(ЗначПоле(Контейнер, Имя, ПоУмолчанию));
КонецФункции

Функция СодержитБезРегистра(Знач Массив, Знач Значение)
	Цель = НРег(Строка(Значение));
	Для Каждого Элемент Из Массив Цикл
		Если НРег(Строка(Элемент)) = Цель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции
