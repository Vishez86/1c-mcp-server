// Создаёт исключение с MCP-кодом ошибки.
Процедура ВозбудитьОшибку(Код, Сообщение, Детали = Неопределено) Экспорт

	ТекстОшибки = "[" + Код + "] " + Строка(Сообщение);
	Если Детали <> Неопределено Тогда
		ТекстОшибки = ТекстОшибки + " | " + ДеталиВСтроку(Детали);
	КонецЕсли;
	ВызватьИсключение ТекстОшибки;

КонецПроцедуры

// Из строки исключения вытаскивает структуру ошибки {code, message, details}.
//
// 1С оборачивает текст исключения префиксами вроде "{ОбщийМодуль.MCP_Errors.Модуль(76)}: ",
// поэтому "[code]" может находиться не в начале строки. Ищем первый "[" и проверяем,
// что внутри скобок лежит только идентификатор-код (буквы/цифры/подчёркивание).
//
// Диагностический режим: возвращаем клиенту полный текст исключения 1С.
Функция РазобратьИсключение(ТекстИсключения, CorrelationID) Экспорт

	Код = "";
	Сообщение = "";
	Детали = Новый Структура;

	ПозОткрытия = НайтиМаркерКода(ТекстИсключения);
	Если ПозОткрытия > 0 Тогда
		ПозЗакрытия = СтрНайти(ТекстИсключения, "]", , ПозОткрытия + 1);
		Если ПозЗакрытия > ПозОткрытия + 1 Тогда
			Кандидат = Сред(ТекстИсключения, ПозОткрытия + 1, ПозЗакрытия - ПозОткрытия - 1);
			Если ВыглядитКакКодОшибки(Кандидат) Тогда
				Код = Кандидат;
				Остаток = СокрЛП(Сред(ТекстИсключения, ПозЗакрытия + 1));
				ПозРазделителя = СтрНайти(Остаток, " | ");
				Если ПозРазделителя > 0 Тогда
					Сообщение = Лев(Остаток, ПозРазделителя - 1);
					ДеталиТекст = Сред(Остаток, ПозРазделителя + 3);
					Детали = ДеталиИзСтроки(ДеталиТекст);
				Иначе
					Сообщение = Остаток;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Код) И ЭтоОтказДоступаПлатформы(ТекстИсключения) Тогда
		Код = Код_AccessDenied();
		Сообщение = "Недостаточно прав текущей учетной записи 1С для выполнения операции.";
		Детали = ДеталиОтказаДоступаПлатформы(ТекстИсключения);
	КонецЕсли;

	Если ПустаяСтрока(Код) Тогда
		Попытка
			ЗаписьЖурналаРегистрации("MCP.tool.unhandled_exception",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"correlation_id=" + Строка(CorrelationID) + " | " + ТекстИсключения);
		Исключение
		КонецПопытки;
		Код = Код_InternalError();
		Сообщение = ТекстИсключения;
	КонецЕсли;

	Детали = ДеталиСДиагностикой(Детали, ТекстИсключения, CorrelationID);

	Результат = Новый Структура;
	Результат.Вставить("code", Код);
	Результат.Вставить("message", Сообщение);
	Результат.Вставить("details", Детали);
	Результат.Вставить("correlation_id", Строка(CorrelationID));
	Возврат Результат;

КонецФункции

Функция ЭтоОтказДоступаПлатформы(ТекстИсключения) Экспорт

	Текст = НРег(Строка(ТекстИсключения));
	Возврат СтрНайти(Текст, "недостаточно прав") > 0
		ИЛИ СтрНайти(Текст, "отсутствуют права") > 0
		ИЛИ СтрНайти(Текст, "нет прав") > 0
		ИЛИ СтрНайти(Текст, "право доступа") > 0
		ИЛИ СтрНайти(Текст, "доступ запрещ") > 0
		ИЛИ СтрНайти(Текст, "access denied") > 0
		ИЛИ СтрНайти(Текст, "permission denied") > 0
		ИЛИ СтрНайти(Текст, "insufficient rights") > 0;

КонецФункции

Функция ДеталиОтказаДоступаПлатформы(ТекстИсключения)

	Авторизация = Новый Структура;
	Авторизация.Вставить("reason_code", "1c_access_denied");
	Авторизация.Вставить("denied_operation", "platform_operation");
	Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	Авторизация.Вставить("platform_message", Строка(ТекстИсключения));

	Детали = Новый Структура;
	Детали.Вставить("authorization", Авторизация);
	Детали.Вставить("raw_exception", Строка(ТекстИсключения));
	Возврат Детали;

КонецФункции

Функция ДеталиСДиагностикой(Детали, ТекстИсключения, CorrelationID)

	Результат = Новый Структура;
	Результат.Вставить("diagnostic_mode", Истина);
	Результат.Вставить("correlation_id", Строка(CorrelationID));
	Результат.Вставить("raw_exception", ТекстИсключения);
	Если Детали <> Неопределено Тогда
		Результат.Вставить("parsed_details", Детали);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает позицию первого "[" — потенциального начала маркера [code].
// Пропускаем "[" внутри фигурных скобок 1С-префикса "{...}", чтобы не подцепить
// квадратные скобки, встречающиеся внутри описания модуля.
Функция НайтиМаркерКода(Текст)

	Длина = СтрДлина(Текст);
	Глубина = 0;
	Для П = 1 По Длина Цикл
		С = Сред(Текст, П, 1);
		Если С = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли С = "}" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
		ИначеЕсли С = "[" И Глубина = 0 Тогда
			Возврат П;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция ВыглядитКакКодОшибки(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Длина = СтрДлина(Текст);
	Если Длина > 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для П = 1 По Длина Цикл
		Код = КодСимвола(Сред(Текст, П, 1));
		Допустим = (Код >= КодСимвола("a") И Код <= КодСимвола("z"))
			ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
			ИЛИ (Код >= КодСимвола("0") И Код <= КодСимвола("9"))
			ИЛИ Код = КодСимвола("_");
		Если НЕ Допустим Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ДеталиВСтроку(Детали)

	Если ТипЗнч(Детали) = Тип("Строка") Тогда
		Возврат Детали;
	КонецЕсли;

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Детали);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Детали);
	КонецПопытки;

КонецФункции

Функция ДеталиИзСтроки(Текст)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Структ = Новый Структура;
		Структ.Вставить("raw", Текст);
		Возврат Структ;
	КонецПопытки;

КонецФункции
