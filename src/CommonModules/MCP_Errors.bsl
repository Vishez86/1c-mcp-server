// Создаёт исключение с MCP-кодом ошибки.
Процедура ВозбудитьОшибку(Код, Сообщение, Детали = Неопределено) Экспорт

	ТекстОшибки = "[" + Код + "] " + Строка(Сообщение);
	Если Детали <> Неопределено Тогда
		ТекстОшибки = ТекстОшибки + " | " + ДеталиВСтроку(Детали);
	КонецЕсли;
	ВызватьИсключение ТекстОшибки;

КонецПроцедуры

// Из строки исключения вытаскивает структуру ошибки {code, message, details}.
Функция РазобратьИсключение(ТекстИсключения, CorrelationID) Экспорт

	Код = Код_InternalError();
	Сообщение = ТекстИсключения;
	Детали = Новый Структура;

	// Формат "[code] message | details"
	Если Лев(ТекстИсключения, 1) = "[" Тогда
		ПозЗакрытия = СтрНайти(ТекстИсключения, "]");
		Если ПозЗакрытия > 0 Тогда
			Код = Сред(ТекстИсключения, 2, ПозЗакрытия - 2);
			Остаток = СокрЛП(Сред(ТекстИсключения, ПозЗакрытия + 1));
			ПозРазделителя = СтрНайти(Остаток, " | ");
			Если ПозРазделителя > 0 Тогда
				Сообщение = Лев(Остаток, ПозРазделителя - 1);
				ДеталиТекст = Сред(Остаток, ПозРазделителя + 3);
				Детали = ДеталиИзСтроки(ДеталиТекст);
			Иначе
				Сообщение = Остаток;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("code", Код);
	Результат.Вставить("message", Сообщение);
	Результат.Вставить("details", Детали);
	Результат.Вставить("correlation_id", Строка(CorrelationID));
	Возврат Результат;

КонецФункции

Функция ДеталиВСтроку(Детали)

	Если ТипЗнч(Детали) = Тип("Строка") Тогда
		Возврат Детали;
	КонецЕсли;

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Детали);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Детали);
	КонецПопытки;

КонецФункции

Функция ДеталиИзСтроки(Текст)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Структ = Новый Структура;
		Структ.Вставить("raw", Текст);
		Возврат Структ;
	КонецПопытки;

КонецФункции
