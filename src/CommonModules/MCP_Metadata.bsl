// MCP_Metadata.bsl
// ====================================================================
// Работа с метаданными конфигурации 1С.
// Обход видов метаданных, описания структуры объектов, разрешение менеджеров.
// ====================================================================

Функция ПолучитьВсеОбъектыМетаданных() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид");
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("ПолноеИмя");
	Таблица.Колонки.Добавить("Синоним");
	Таблица.Колонки.Добавить("Комментарий");
	Таблица.Колонки.Добавить("SupportsRef");
	Таблица.Колонки.Добавить("SupportsQuery");

	ДобавитьКоллекцию(Таблица, Метаданные.Справочники, "Справочник", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Документы, "Документ", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Константы, "Константа", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Перечисления, "Перечисление", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыСведений, "РегистрСведений", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыНакопления, "РегистрНакопления", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыРасчета, "РегистрРасчета", Ложь, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.ПланыСчетов, "ПланСчетов", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыОбмена, "ПланОбмена", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.БизнесПроцессы, "БизнесПроцесс", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Задачи, "Задача", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.Отчеты, "Отчет", Ложь, Ложь);
	ДобавитьКоллекцию(Таблица, Метаданные.Обработки, "Обработка", Ложь, Ложь);

	Возврат Таблица;

КонецФункции

Процедура ДобавитьКоллекцию(Таблица, Коллекция, Вид, SupportsRef, SupportsQuery)

	Для Каждого ОМД Из Коллекция Цикл
		Стр = Таблица.Добавить();
		Стр.Вид = Вид;
		Стр.Имя = ОМД.Имя;
		Стр.ПолноеИмя = Вид + "." + ОМД.Имя;
		Стр.Синоним = ОМД.Синоним;
		Попытка
			Стр.Комментарий = ОМД.Комментарий;
		Исключение
			Стр.Комментарий = "";
		КонецПопытки;
		Стр.SupportsRef = SupportsRef;
		Стр.SupportsQuery = SupportsQuery;
	КонецЦикла;

КонецПроцедуры

Функция ОбъектМетаданныхПоПолномуИмени(ПолноеИмя) Экспорт

	Возврат Метаданные.НайтиПоПолномуИмени(ПолноеИмя);

КонецФункции

Функция ВидПоОбъектуМетаданных(ОМД) Экспорт

	Если ОМД = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПолноеИмя = ПолноеИмяОбъектаМетаданных(ОМД);
	ВидИзИмени = ВидИзПолногоИмени(ПолноеИмя);
	Если НЕ ПустаяСтрока(ВидИзИмени) Тогда
		Возврат ВидИзИмени;
	КонецЕсли;

	ВидИзКоллекции = ВидПоИмениВКоллекциях(ОМД);
	Если НЕ ПустаяСтрока(ВидИзКоллекции) Тогда
		Возврат ВидИзКоллекции;
	КонецЕсли;

	Родитель = ОМД.Родитель();
	Если Родитель = Метаданные.Справочники Тогда
		Возврат "Справочник";
	КонецЕсли;
	Если Родитель = Метаданные.Документы Тогда
		Возврат "Документ";
	КонецЕсли;
	Если Родитель = Метаданные.Перечисления Тогда
		Возврат "Перечисление";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыСведений Тогда
		Возврат "РегистрСведений";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыНакопления Тогда
		Возврат "РегистрНакопления";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыБухгалтерии Тогда
		Возврат "РегистрБухгалтерии";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыРасчета Тогда
		Возврат "РегистрРасчета";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыСчетов Тогда
		Возврат "ПланСчетов";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыВидовХарактеристик Тогда
		Возврат "ПланВидовХарактеристик";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыВидовРасчета Тогда
		Возврат "ПланВидовРасчета";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыОбмена Тогда
		Возврат "ПланОбмена";
	КонецЕсли;
	Если Родитель = Метаданные.БизнесПроцессы Тогда
		Возврат "БизнесПроцесс";
	КонецЕсли;
	Если Родитель = Метаданные.Задачи Тогда
		Возврат "Задача";
	КонецЕсли;
	Если Родитель = Метаданные.Отчеты Тогда
		Возврат "Отчет";
	КонецЕсли;
	Если Родитель = Метаданные.Обработки Тогда
		Возврат "Обработка";
	КонецЕсли;
	Если Родитель = Метаданные.Константы Тогда
		Возврат "Константа";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ВидПоИмениВКоллекциях(ОМД)

	Попытка
		Имя = ОМД.Имя;
	Исключение
		Возврат "";
	КонецПопытки;

	Если Метаданные.Справочники.Найти(Имя) <> Неопределено Тогда Возврат "Справочник"; КонецЕсли;
	Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда Возврат "Документ"; КонецЕсли;
	Если Метаданные.Перечисления.Найти(Имя) <> Неопределено Тогда Возврат "Перечисление"; КонецЕсли;
	Если Метаданные.РегистрыСведений.Найти(Имя) <> Неопределено Тогда Возврат "РегистрСведений"; КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Имя) <> Неопределено Тогда Возврат "РегистрНакопления"; КонецЕсли;
	Если Метаданные.РегистрыБухгалтерии.Найти(Имя) <> Неопределено Тогда Возврат "РегистрБухгалтерии"; КонецЕсли;
	Если Метаданные.РегистрыРасчета.Найти(Имя) <> Неопределено Тогда Возврат "РегистрРасчета"; КонецЕсли;
	Если Метаданные.ПланыСчетов.Найти(Имя) <> Неопределено Тогда Возврат "ПланСчетов"; КонецЕсли;
	Если Метаданные.ПланыВидовХарактеристик.Найти(Имя) <> Неопределено Тогда Возврат "ПланВидовХарактеристик"; КонецЕсли;
	Если Метаданные.ПланыВидовРасчета.Найти(Имя) <> Неопределено Тогда Возврат "ПланВидовРасчета"; КонецЕсли;
	Если Метаданные.ПланыОбмена.Найти(Имя) <> Неопределено Тогда Возврат "ПланОбмена"; КонецЕсли;
	Если Метаданные.БизнесПроцессы.Найти(Имя) <> Неопределено Тогда Возврат "БизнесПроцесс"; КонецЕсли;
	Если Метаданные.Задачи.Найти(Имя) <> Неопределено Тогда Возврат "Задача"; КонецЕсли;
	Если Метаданные.Отчеты.Найти(Имя) <> Неопределено Тогда Возврат "Отчет"; КонецЕсли;
	Если Метаданные.Обработки.Найти(Имя) <> Неопределено Тогда Возврат "Обработка"; КонецЕсли;
	Если Метаданные.Константы.Найти(Имя) <> Неопределено Тогда Возврат "Константа"; КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолноеИмяОбъектаМетаданных(ОМД) Экспорт

	Если ОМД = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ОМД.ПолноеИмя();
	Исключение
		// На старых/особых объектах метаданных метода может не быть.
	КонецПопытки;

	Возврат "";

КонецФункции

Функция МенеджерПоТипу(ПолноеИмя) Экспорт

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоОбъектуМетаданных(ОМД);
	Если ПустаяСтрока(Вид) Тогда
		Вид = ВидИзПолногоИмени(ПолноеИмя);
	КонецЕсли;
	Имя = ОМД.Имя;

	Попытка
		Если Вид = "Справочник" Тогда
			Возврат Справочники[Имя];
		ИначеЕсли Вид = "Документ" Тогда
			Возврат Документы[Имя];
		ИначеЕсли Вид = "Перечисление" Тогда
			Возврат Перечисления[Имя];
		ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
			Возврат ПланыВидовХарактеристик[Имя];
		ИначеЕсли Вид = "ПланСчетов" Тогда
			Возврат ПланыСчетов[Имя];
		ИначеЕсли Вид = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[Имя];
		ИначеЕсли Вид = "ПланОбмена" Тогда
			Возврат ПланыОбмена[Имя];
		ИначеЕсли Вид = "БизнесПроцесс" Тогда
			Возврат БизнесПроцессы[Имя];
		ИначеЕсли Вид = "Задача" Тогда
			Возврат Задачи[Имя];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ВидИзПолногоИмени(ПолноеИмя) Экспорт
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Поз - 1);
КонецФункции

Функция ИмяИзПолногоИмени(ПолноеИмя) Экспорт
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Сред(ПолноеИмя, Поз + 1);
КонецФункции

// ---- Структура объекта --------------------------------------------

Функция СтруктураОбъекта(ПолноеИмя, Опции) Экспорт

	ОМД = ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоОбъектуМетаданных(ОМД);

	Результат = Новый Структура;
	Результат.Вставить("kind", Вид);
	Результат.Вставить("name", ОМД.Имя);
	Результат.Вставить("full_name", ПолноеИмя);
	Результат.Вставить("synonym", ОМД.Синоним);
	Попытка
		Результат.Вставить("comment", ОМД.Комментарий);
	Исключение
		Результат.Вставить("comment", "");
	КонецПопытки;
	Результат.Вставить("query_table", ПолноеИмя);
	Результат.Вставить("supports_ref", ПоддерживаетСсылку(Вид));
	Результат.Вставить("hierarchical", ЯвляетсяИерархическим(ОМД, Вид));

	Атрибуты = Новый Массив;
	СтандартныеАтрибуты = Новый Массив;
	Если Опции.include_standard_attributes Тогда
		ЗаполнитьСтандартныеАтрибуты(ОМД, Вид, СтандартныеАтрибуты);
	КонецЕсли;
	Если Опции.include_attributes Тогда
		ЗаполнитьАтрибуты(ОМД, Вид, Атрибуты, ПолноеИмя, Опции);
	КонецЕсли;

	ТабличныеЧасти = Новый Массив;
	Если Опции.include_tabular_sections Тогда
		ЗаполнитьТабличныеЧасти(ОМД, ТабличныеЧасти, ПолноеИмя, Опции);
	КонецЕсли;

	РегистрСхема = Неопределено;
	Если Вид = "РегистрСведений" ИЛИ Вид = "РегистрНакопления"
		ИЛИ Вид = "РегистрБухгалтерии" ИЛИ Вид = "РегистрРасчета" Тогда
		РегистрСхема = СхемаРегистра(ОМД, Вид, ПолноеИмя, Опции);
	КонецЕсли;

	Результат.Вставить("attributes", Атрибуты);
	Результат.Вставить("standard_attributes", СтандартныеАтрибуты);
	Результат.Вставить("tabular_sections", ТабличныеЧасти);
	Результат.Вставить("register_schema", РегистрСхема);

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьАтрибуты(ОМД, Вид, Атрибуты, ПолноеИмя, Опции)

	Попытка
		КоллекцияРеквизитов = ОМД.Реквизиты;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Р Из КоллекцияРеквизитов Цикл
		Атрибуты.Добавить(КодироватьРеквизит(Р, ПолноеИмя, Опции));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтандартныеАтрибуты(ОМД, Вид, Список)

	Попытка
		Коллекция = ОМД.СтандартныеРеквизиты;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Р Из Коллекция Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", Р.Имя);
		Стр.Вставить("synonym", Р.Синоним);
		Стр.Вставить("type_description", Строка(Р.Тип));
		Список.Добавить(Стр);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТабличныеЧасти(ОМД, ТабличныеЧасти, ПолноеИмя, Опции)

	Попытка
		Коллекция = ОМД.ТабличныеЧасти;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого ТЧ Из Коллекция Цикл
		Реквизиты = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Реквизиты.Добавить(КодироватьРеквизит(Р, ПолноеИмя + "." + ТЧ.Имя, Опции));
		КонецЦикла;
		Стр = Новый Структура;
		Стр.Вставить("name", ТЧ.Имя);
		Стр.Вставить("synonym", ТЧ.Синоним);
		Стр.Вставить("attributes", Реквизиты);
		ТабличныеЧасти.Добавить(Стр);
	КонецЦикла;

КонецПроцедуры

Функция КодироватьРеквизит(Р, КонтекстПолноеИмя, Опции)

	Стр = Новый Структура;
	Стр.Вставить("name", Р.Имя);
	Стр.Вставить("synonym", Р.Синоним);
	Стр.Вставить("type_description", Строка(Р.Тип));
	ТипыЗначений = Новый Массив;
	Для Каждого Т Из Р.Тип.Типы() Цикл
		ТипыЗначений.Добавить(Строка(Т));
	КонецЦикла;
	Стр.Вставить("value_types", ТипыЗначений);

	Разрешено = MCP_Security.ПолеРазрешено(КонтекстПолноеИмя, Р.Имя);
	Стр.Вставить("allowed", Разрешено);
	Стр.Вставить("sensitive", НЕ Разрешено);

	// Searchable: входит ли в search_fields allowlist.
	ПоляПоиска = MCP_Security.ПоляПоискаПоУмолчанию(КонтекстПолноеИмя);
	Searchable = Ложь;
	Для Каждого П Из ПоляПоиска Цикл
		Если ВРег(П) = ВРег(Р.Имя) Тогда
			Searchable = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Стр.Вставить("searchable", Searchable);
	Стр.Вставить("query_name", Р.Имя);

	Возврат Стр;

КонецФункции

Функция СхемаРегистра(ОМД, Вид, ПолноеИмя, Опции)

	Стр = Новый Структура;
	Стр.Вставить("type", Вид);
	Стр.Вставить("periodicity", ПериодичностьРегистраСведений(ОМД, Вид));

	Измерения = Новый Массив;
	Попытка
		Для Каждого Изм Из ОМД.Измерения Цикл
			Измерения.Добавить(КодироватьРеквизит(Изм, ПолноеИмя + ".Измерения", Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("dimensions", Измерения);

	Ресурсы = Новый Массив;
	Попытка
		Для Каждого Рес Из ОМД.Ресурсы Цикл
			Ресурсы.Добавить(КодироватьРеквизит(Рес, ПолноеИмя + ".Ресурсы", Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("resources", Ресурсы);

	Реквизиты = Новый Массив;
	Попытка
		Для Каждого Р Из ОМД.Реквизиты Цикл
			Реквизиты.Добавить(КодироватьРеквизит(Р, ПолноеИмя, Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("attributes", Реквизиты);
	Если ПолучитьБулевоОпции(Опции, "include_virtual_tables", Истина) Тогда
		Стр.Вставить("virtual_tables", ВиртуальныеТаблицыРегистра(ОМД, Вид, ПолноеИмя));
	КонецЕсли;

	Возврат Стр;

КонецФункции

Функция ВиртуальныеТаблицыРегистра(ОМД, Вид, ПолноеИмя)

	Результат = Новый Массив;
	Если Вид = "РегистрНакопления" Тогда
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Обороты",
			ПолноеИмя + ".Обороты(&ПериодНачало, &ПериодКонец)",
			"turnovers",
			"Обороты за период с учётом знака движений.",
			Неопределено,
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));
		Если РегистрНакопленияХранитОстатки(ОМД) Тогда
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"Остатки",
				ПолноеИмя + ".Остатки(&Период)",
				"balance",
				"Остатки на дату.",
				Неопределено,
				ПараметрыВиртуальнойТаблицы("Период")));
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"ОстаткиИОбороты",
				ПолноеИмя + ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)",
				"balance_and_turnovers",
				"Остатки и обороты за период.",
				Неопределено,
				ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));
		КонецЕсли;
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		ПоляОстатков = Новый Массив;
		ДобавитьСтроки(ПоляОстатков,
			"Счет,Субконто1,Субконто2,Субконто3,СуммаОстаток,ВалютнаяСуммаОстаток,КоличествоОстаток,СуммаНУОстаток,СуммаПРОстаток,СуммаВРОстаток");
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Остатки",
			ПолноеИмя + ".Остатки(&Период)",
			"balance",
			"Остатки по счетам и субконто на дату. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ПоляОстатков,
			ПараметрыВиртуальнойТаблицы("Период")));

		ПоляОборотов = Новый Массив;
		ДобавитьСтроки(ПоляОборотов,
			"Счет,Субконто1,Субконто2,Субконто3,СуммаОборот,ВалютнаяСуммаОборот,КоличествоОборот,СуммаНУОборот,СуммаПРОборот,СуммаВРОборот");
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Обороты",
			ПолноеИмя + ".Обороты(&ПериодНачало, &ПериодКонец)",
			"turnovers",
			"Обороты по счету и субконто. Для аналитики субконто используйте эту таблицу, а не основную таблицу движений. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ПоляОборотов,
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));

		ПоляДтКт = Новый Массив;
		ДобавитьСтроки(ПоляДтКт,
			"СчетДт,СчетКт,СубконтоДт1,СубконтоДт2,СубконтоДт3,СубконтоКт1,СубконтоКт2,СубконтоКт3,СуммаОборот,ВалютнаяСуммаОборот,КоличествоОборот,СуммаНУОборот,СуммаПРОборот,СуммаВРОборот");
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"ОборотыДтКт",
			ПолноеИмя + ".ОборотыДтКт(&ПериодНачало, &ПериодКонец)",
			"turnovers_debit_credit",
			"Корреспонденция Дт/Кт с отдельными полями СубконтоДт1..3 и СубконтоКт1..3. Соответствие позиции и вида аналитики определяется настройками счёта Дт/Кт в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоДтN/СубконтоКтN).",
			ПоляДтКт,
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));

		ПоляОстатковИОборотов = Новый Массив;
		ДобавитьСтроки(ПоляОстатковИОборотов,
			"Счет,Субконто1,Субконто2,Субконто3,СуммаНачальныйОстаток,СуммаОборот,СуммаКонечныйОстаток,ВалютнаяСуммаНачальныйОстаток,ВалютнаяСуммаОборот,ВалютнаяСуммаКонечныйОстаток,КоличествоНачальныйОстаток,КоличествоОборот,КоличествоКонечныйОстаток,СуммаНУНачальныйОстаток,СуммаНУОборот,СуммаНУКонечныйОстаток,СуммаПРНачальныйОстаток,СуммаПРОборот,СуммаПРКонечныйОстаток,СуммаВРНачальныйОстаток,СуммаВРОборот,СуммаВРКонечныйОстаток");
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"ОстаткиИОбороты",
			ПолноеИмя + ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)",
			"balance_and_turnovers",
			"Начальные/конечные остатки и обороты по счетам и субконто за период. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ПоляОстатковИОборотов,
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Если РегистрИмеетПериодМД(ОМД) Тогда
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"СрезПервых",
				ПолноеИмя + ".СрезПервых(&Период)",
				"slice_first",
				"Первый срез периодического регистра сведений.",
				Неопределено,
				ПараметрыВиртуальнойТаблицы("Период")));
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"СрезПоследних",
				ПолноеИмя + ".СрезПоследних(&Период)",
				"slice_last",
				"Последний срез периодического регистра сведений.",
				Неопределено,
				ПараметрыВиртуальнойТаблицы("Период")));
		КонецЕсли;
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Результат.Добавить(ОписаниеНеподдержанныхВиртуальныхТаблиц(
			"Виртуальные таблицы регистров расчёта пока не описываются универсальным MCP-сервером. Используйте records или прямой запрос к таблице, если точная виртуальная таблица известна."));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОписаниеВиртуальнойТаблицы(Имя, QueryTable, Mode, Описание, Поля = Неопределено, Параметры = Неопределено)

	Стр = Новый Структура;
	Стр.Вставить("name", Имя);
	Стр.Вставить("query_table", QueryTable);
	Стр.Вставить("mode", Mode);
	Стр.Вставить("description", Описание);
	Если Параметры = Неопределено Тогда
		Параметры = Новый Массив;
	КонецЕсли;
	Стр.Вставить("parameters", Параметры);
	Стр.Вставить("common_fields", ?(Поля = Неопределено, Новый Массив, Поля));
	Возврат Стр;

КонецФункции

Функция ОписаниеНеподдержанныхВиртуальныхТаблиц(Описание)

	Стр = Новый Структура;
	Стр.Вставить("name", "unsupported");
	Стр.Вставить("unsupported", Истина);
	Стр.Вставить("description", Описание);
	Стр.Вставить("parameters", Новый Массив);
	Стр.Вставить("common_fields", Новый Массив);
	Возврат Стр;

КонецФункции

Функция ПараметрыВиртуальнойТаблицы(CSV)

	Параметры = Новый Массив;
	ДобавитьСтроки(Параметры, CSV);
	Возврат Параметры;

КонецФункции

Процедура ДобавитьСтроки(Массив, CSV)

	Для Каждого Значение Из СтрРазделить(CSV, ",", Ложь) Цикл
		Значение = СокрЛП(Значение);
		Если НЕ ПустаяСтрока(Значение) Тогда
			Массив.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция РегистрНакопленияХранитОстатки(ОМД)

	Попытка
		Возврат СтрНайти(ВРег(Строка(ОМД.ВидРегистра)), "ОСТАТ") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция РегистрИмеетПериодМД(ОМД)

	Попытка
		Возврат ОМД.СтандартныеРеквизиты.Найти("Период") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПериодичностьРегистраСведений(ОМД, Вид)

	Если Вид <> "РегистрСведений" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если ОМД.Периодичность <> Неопределено Тогда
			Возврат Строка(ОМД.Периодичность);
		КонецЕсли;
	Исключение
		// В некоторых версиях/типах регистра свойство недоступно.
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПоддерживаетСсылку(Вид)
	Возврат Вид = "Справочник" ИЛИ Вид = "Документ" ИЛИ Вид = "Перечисление"
		ИЛИ Вид = "ПланВидовХарактеристик" ИЛИ Вид = "ПланСчетов"
		ИЛИ Вид = "ПланВидовРасчета" ИЛИ Вид = "ПланОбмена"
		ИЛИ Вид = "БизнесПроцесс" ИЛИ Вид = "Задача";
КонецФункции

Функция ЯвляетсяИерархическим(ОМД, Вид)
	Если Вид = "Справочник" Тогда
		Попытка
			Возврат ОМД.Иерархический;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьБулевоОпции(Опции, Имя, ПоУмолчанию)

	Если Опции = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Опции) = Тип("Структура")
		ИЛИ ТипЗнч(Опции) = Тип("ФиксированнаяСтруктура"))
		И Опции.Свойство(Имя, Значение) Тогда
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	ИначеЕсли ТипЗнч(Опции) = Тип("Соответствие")
		ИЛИ ТипЗнч(Опции) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Опции.Получить(Имя);
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

// Опции по умолчанию для СтруктураОбъекта.
Функция ОпцииСтруктурыПоУмолчанию() Экспорт

	Стр = Новый Структура;
	Стр.Вставить("include_standard_attributes", Истина);
	Стр.Вставить("include_attributes", Истина);
	Стр.Вставить("include_tabular_sections", Истина);
	Стр.Вставить("include_forms", Ложь);
	Стр.Вставить("include_commands", Ложь);
	Стр.Вставить("include_query_names", Истина);
	Стр.Вставить("include_sensitive_flags", Истина);
	Стр.Вставить("include_virtual_tables", Истина);
	Возврат Стр;

КонецФункции
