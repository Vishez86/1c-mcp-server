// MCP_Tools_Impl.bsl
// ====================================================================
// Реализация всех 17 read-only tools MCP-сервера.
// Каждый Tool_* возвращает Структуру с прикладными данными.
// Поле "ok" добавляется в MCP_Tools.Выполнить, не здесь.
// ====================================================================

#Область Tools

// ----------------------------------------------------------------------
// 1. list_metadata_objects
// ----------------------------------------------------------------------
Функция ListMetadataObjects(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);

	Виды = Получить(Аргументы, "kinds", Новый Массив);
	ПоисковыйЗапрос = Получить(Аргументы, "query", "");
	IncludeNotAllowed = Получить(Аргументы, "include_not_allowed", Ложь);
	Если IncludeNotAllowed И НЕ MCP_Security.ЯвляетсяАдминомMCP() Тогда
		IncludeNotAllowed = Ложь;
	КонецЕсли;
	IncludeDetails = Получить(Аргументы, "include_details", Ложь);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 200, MCP_Config.Лимиты().max_limit);
	Курсор = Получить(Аргументы, "cursor", "");

	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Все.Сортировать("ПолноеИмя");

	Подходящие = Новый Массив;
	Для Каждого Стр Из Все Цикл
		// Фильтр по виду.
		Если ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого В Из Виды Цикл
				Если ВРег(В) = ВРег(Стр.Вид) Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// Фильтр по строке.
		Если НЕ ПустаяСтрока(ПоисковыйЗапрос) Тогда
			ВЗ = ВРег(ПоисковыйЗапрос);
			ПодходитПоПоиску = СтрНайти(ВРег(Стр.Имя), ВЗ) > 0
				ИЛИ СтрНайти(ВРег(Стр.Синоним), ВЗ) > 0
				ИЛИ СтрНайти(ВРег(Стр.Комментарий), ВЗ) > 0;
			Если НЕ ПодходитПоПоиску Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Разрешен = MCP_Security.ТипРазрешен(Стр.ПолноеИмя);
		Если НЕ Разрешен И НЕ IncludeNotAllowed Тогда
			Продолжить;
		КонецЕсли;

		Подходящие.Добавить(Стр);
	КонецЦикла;

	// Пагинация.
	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Конец = Мин(Смещение + Лимит, Подходящие.Количество());

	Объекты = Новый Массив;
	Для Индекс = Смещение По Конец - 1 Цикл
		Стр = Подходящие[Индекс];
		Об = Новый Структура;
		Об.Вставить("kind", Стр.Вид);
		Об.Вставить("name", Стр.Имя);
		Об.Вставить("full_name", Стр.ПолноеИмя);
		Об.Вставить("synonym", Стр.Синоним);
		Если IncludeDetails Тогда
			Об.Вставить("comment", Стр.Комментарий);
		КонецЕсли;
		Об.Вставить("allowed", MCP_Security.ТипРазрешен(Стр.ПолноеИмя));
		Об.Вставить("readable", Об.allowed);
		Об.Вставить("searchable", MCP_Security.ПоляПоискаПоУмолчанию(Стр.ПолноеИмя).Количество() > 0);
		Об.Вставить("supports_ref", Стр.SupportsRef);
		Об.Вставить("supports_query", Стр.SupportsQuery);
		Об.Вставить("resource_uri", "1c://metadata/" + Стр.ПолноеИмя);
		Объекты.Добавить(Об);
	КонецЦикла;

	NextCursor = Null;
	Если Конец < Подходящие.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("objects", Объекты);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("total_estimated", Подходящие.Количество());
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 2. get_metadata_structure
// ----------------------------------------------------------------------
Функция GetMetadataStructure(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	Если ПустаяСтрока(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан type.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Тип запрещён: " + Тип);
	КонецЕсли;

	Опции = MCP_Metadata.ОпцииСтруктурыПоУмолчанию();
	Опции.include_standard_attributes = Получить(Аргументы, "include_standard_attributes", Истина);
	Опции.include_tabular_sections = Получить(Аргументы, "include_tabular_sections", Истина);
	Опции.include_forms = Получить(Аргументы, "include_forms", Ложь);
	Опции.include_commands = Получить(Аргументы, "include_commands", Ложь);
	Опции.include_query_names = Получить(Аргументы, "include_query_names", Истина);
	Опции.include_sensitive_flags = Получить(Аргументы, "include_sensitive_flags", Истина);

	Структура = MCP_Metadata.СтруктураОбъекта(Тип, Опции);
	Если Структура = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "Объект метаданных не найден: " + Тип);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("metadata", Структура);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 3. run_1c_query
// ----------------------------------------------------------------------
Функция Run1CQuery(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	ТекстЗапроса = Получить(Аргументы, "query", "");
	Параметры = Получить(Аргументы, "parameters", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);
	ValidateBeforeRun = Получить(Аргументы, "validate_before_run", Истина);

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан текст запроса.");
	КонецЕсли;

	Если ValidateBeforeRun Тогда
		Валидация = MCP_Query.Валидировать(ТекстЗапроса, Параметры, Истина, Истина);
		Если НЕ Валидация.valid Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryValidationFailed(),
				"Запрос не прошёл проверку.", Валидация.errors);
		КонецЕсли;
	КонецЕсли;

	Возврат MCP_Query.Выполнить(ТекстЗапроса, Параметры, Лимит);

КонецФункции

// ----------------------------------------------------------------------
// 4. validate_1c_query
// ----------------------------------------------------------------------
Функция Validate1CQuery(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	ТекстЗапроса = Получить(Аргументы, "query", "");
	Параметры = Получить(Аргументы, "parameters", Неопределено);
	Строгий = Получить(Аргументы, "strict", Истина);
	Объяснить = Получить(Аргументы, "explain", Истина);

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан текст запроса.");
	КонецЕсли;

	Возврат MCP_Query.Валидировать(ТекстЗапроса, Параметры, Строгий, Объяснить);

КонецФункции

// ----------------------------------------------------------------------
// 5. get_object_by_ref
// ----------------------------------------------------------------------
Функция GetObjectByRef(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	UUID = Получить(Аргументы, "uuid", "");
	Поля = Получить(Аргументы, "fields", Неопределено);
	IncludeStandard = Получить(Аргументы, "include_standard_fields", Истина);
	IncludeTS = Получить(Аргументы, "include_tabular_sections", Ложь);
	TSImena = Получить(Аргументы, "tabular_sections", Неопределено);
	TSLimit = ЦелоеИзАргумента(Аргументы, "tabular_section_row_limit", 100, MCP_Config.Лимиты().max_tabular_section_rows);
	IncludeNav = Получить(Аргументы, "include_navigation_url", Истина);

	Если ПустаяСтрока(Тип) ИЛИ ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Требуются type и uuid.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Тип запрещён: " + Тип);
	КонецЕсли;

	Ссылка = MCP_Values.СсылкаПоТипуИUUID(Тип, UUID);
	Если Ссылка = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ObjectNotFound(), "Объект не найден.");
	КонецЕсли;

	// Проверка существования через запрос.
	ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Существует ИЗ " + Тип + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Существует = НЕ Запрос.Выполнить().Пустой();

	Результат = Новый Структура;
	Результат.Вставить("found", Существует);

	Если НЕ Существует Тогда
		Результат.Вставить("object", Неопределено);
		Возврат Результат;
	КонецЕсли;

	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = IncludeNav;

	Об = Новый Структура;
	Об.Вставить("ref", MCP_Values.Кодировать(Ссылка, ОпцииВалью));

	StandardFields = Новый Структура;
	Fields = Новый Структура;
	TabularSections = Новый Структура;

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда

		ОМД = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Если IncludeStandard Тогда
			Попытка
				Для Каждого СА Из ОМД.СтандартныеРеквизиты Цикл
					Если MCP_Security.ПолеРазрешено(Тип, СА.Имя) Тогда
						Значение = Объект[СА.Имя];
						StandardFields.Вставить(СА.Имя, MCP_Values.Кодировать(Значение, ОпцииВалью));
					КонецЕсли;
				КонецЦикла;
			Исключение
				// Стандартные реквизиты могут быть недоступны.
			КонецПопытки;
		КонецЕсли;

		// Поля.
		СписокПолей = Поля;
		Если СписокПолей = Неопределено ИЛИ ТипЗнч(СписокПолей) <> Тип("Массив") ИЛИ СписокПолей.Количество() = 0 Тогда
			СписокПолей = MCP_Security.ПоляПоУмолчанию(Тип);
		КонецЕсли;

		Для Каждого ИмяПоля Из СписокПолей Цикл
			Если НЕ MCP_Security.ПолеРазрешено(Тип, ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Fields.Вставить(ИмяПоля, MCP_Values.Кодировать(Объект[ИмяПоля], ОпцииВалью));
			Исключение
				// Поле не существует — пропускаем.
			КонецПопытки;
		КонецЦикла;

		// Табличные части.
		Если IncludeTS Тогда
			Попытка
				Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
					Если TSImena <> Неопределено И ТипЗнч(TSImena) = Тип("Массив") И TSImena.Количество() > 0 Тогда
						Подходит = Ложь;
						Для Каждого И Из TSImena Цикл
							Если И = ТЧ.Имя Тогда
								Подходит = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если НЕ Подходит Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					Если НЕ MCP_Security.ПолеРазрешено(Тип, ТЧ.Имя) Тогда
						Продолжить;
					КонецЕсли;
					СтрокиТЧ = Новый Массив;
					Счетчик = 0;
					Для Каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
						Если Счетчик >= TSLimit Тогда
							Прервать;
						КонецЕсли;
						С = Новый Структура;
						Для Каждого Р Из ТЧ.Реквизиты Цикл
							С.Вставить(Р.Имя, MCP_Values.Кодировать(СтрокаТЧ[Р.Имя], ОпцииВалью));
						КонецЦикла;
						СтрокиТЧ.Добавить(С);
						Счетчик = Счетчик + 1;
					КонецЦикла;
					TabularSections.Вставить(ТЧ.Имя, СтрокиТЧ);
				КонецЦикла;
			Исключение
				// Нет ТЧ.
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Об.Вставить("standard_fields", StandardFields);
	Об.Вставить("fields", Fields);
	Об.Вставить("tabular_sections", TabularSections);

	Результат.Вставить("object", Об);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 6. find_object_by_id
// ----------------------------------------------------------------------
Функция FindObjectByID(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	UUID = Получить(Аргументы, "uuid", "");
	Типы = Получить(Аргументы, "types", Неопределено);
	Виды = Получить(Аргументы, "kinds", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 10, 100);

	Если ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан UUID.");
	КонецЕсли;

	// Собираем список разрешённых ссылочных типов для перебора.
	КандидатыТипов = Новый Массив;
	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если НЕ Стр.SupportsRef Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		// Перечисления имеют ссылки, но UUID-based поиск к ним не применим.
		Если Стр.Вид = "Перечисление" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Типы) = Тип("Массив") И Типы.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого Т Из Типы Цикл
				Если ВРег(Т) = ВРег(Стр.ПолноеИмя) Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого В Из Виды Цикл
				Если ВРег(В) = ВРег(Стр.Вид) Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		КандидатыТипов.Добавить(Стр.ПолноеИмя);
	КонецЦикла;

	МаксТипов = MCP_Config.Лимиты().max_searched_types_per_call;
	Если КандидатыТипов.Количество() > МаксТипов Тогда
		Усеченные = Новый Массив;
		Для Индекс = 0 По МаксТипов - 1 Цикл
			Усеченные.Добавить(КандидатыТипов[Индекс]);
		КонецЦикла;
		КандидатыТипов = Усеченные;
	КонецЕсли;

	Совпадения = Новый Массив;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Усечено = Ложь;

	Для Каждого ПолноеИмя Из КандидатыТипов Цикл
		Если Совпадения.Количество() >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		Попытка
			Ссылка = MCP_Values.СсылкаПоТипуИUUID(ПолноеИмя, UUID);
			ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
			Запрос = Новый Запрос(ЗапросТекст);
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				Совпадение = Новый Структура;
				Совпадение.Вставить("ref", MCP_Values.Кодировать(Выборка.Ссылка, ОпцииВалью));

				// Стандартные поля.
				StandardFields = Новый Структура;
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					ОМД = Метаданные.НайтиПоТипу(ТипЗнч(Выборка.Ссылка));
					Попытка
						Для Каждого СА Из ОМД.СтандартныеРеквизиты Цикл
							Если СА.Имя = "Код" ИЛИ СА.Имя = "Наименование" ИЛИ СА.Имя = "Номер" ИЛИ СА.Имя = "Дата" Тогда
								StandardFields.Вставить(СА.Имя, MCP_Values.Кодировать(Объект[СА.Имя], ОпцииВалью));
							КонецЕсли;
						КонецЦикла;
					Исключение
					КонецПопытки;
				КонецЕсли;
				Совпадение.Вставить("standard_fields", StandardFields);
				Совпадения.Добавить(Совпадение);
			КонецЕсли;
		Исключение
			// Невалидный UUID для типа — пропускаем.
		КонецПопытки;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("found", Совпадения.Количество() > 0);
	Результат.Вставить("matches", Совпадения);
	Результат.Вставить("searched_types_count", КандидатыТипов.Количество());
	Результат.Вставить("truncated", Усечено);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 7. search_objects
// ----------------------------------------------------------------------
Функция SearchObjects(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	ПоисковыйЗапрос = Получить(Аргументы, "query", "");
	Типы = Получить(Аргументы, "types", Неопределено);
	Виды = Получить(Аргументы, "kinds", Неопределено);
	ПоисковыеПоля = Получить(Аргументы, "search_fields", Неопределено);
	DateFrom = Получить(Аргументы, "date_from", Неопределено);
	DateTo = Получить(Аргументы, "date_to", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 20, 100);
	IncludeDeleted = Получить(Аргументы, "include_deleted", Ложь);
	IncludeFields = Получить(Аргументы, "include_fields", Неопределено);
	MatchMode = Получить(Аргументы, "match_mode", "auto");

	Если ПустаяСтрока(ПоисковыйЗапрос) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан query.");
	КонецЕсли;

	// Собираем список целевых типов.
	ЦелевыеТипы = СформироватьЦелевыеТипы(Типы, Виды);

	Совпадения = Новый Массив;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();

	Для Каждого ПолноеИмя Из ЦелевыеТипы Цикл
		Если Совпадения.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		ПоляДляТипа = ПоисковыеПоля;
		Если ПоляДляТипа = Неопределено ИЛИ ТипЗнч(ПоляДляТипа) <> Тип("Массив") ИЛИ ПоляДляТипа.Количество() = 0 Тогда
			ПоляДляТипа = MCP_Security.ПоляПоискаПоУмолчанию(ПолноеИмя);
		КонецЕсли;
		Если ПоляДляТипа.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Условия = Новый Массив;
		ТекстПодстановки = ПодготовитьПодстановку(ПоисковыйЗапрос, MatchMode);
		Для Каждого Поле Из ПоляДляТипа Цикл
			Если НЕ MCP_Security.ПолеРазрешено(ПолноеИмя, Поле) Тогда
				Продолжить;
			КонецЕсли;
			Условия.Добавить("Т." + Поле + " ПОДОБНО &Шаблон");
		КонецЦикла;
		Если Условия.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ПолноеУсловие = СтрСоединить(Условия, " ИЛИ ");

		// Период для документов.
		Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
			Если DateFrom <> Неопределено Тогда
				ПолноеУсловие = ПолноеУсловие + " И Т.Дата >= &DateFrom";
			КонецЕсли;
			Если DateTo <> Неопределено Тогда
				ПолноеУсловие = ПолноеУсловие + " И Т.Дата <= &DateTo";
			КонецЕсли;
		КонецЕсли;

		Если НЕ IncludeDeleted И СтрНачинаетсяС(ПолноеИмя, "Справочник.") Тогда
			ПолноеУсловие = "(" + ПолноеУсловие + ") И НЕ Т.ПометкаУдаления";
		КонецЕсли;

		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Лимит + " Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ " + ПолноеУсловие;
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Шаблон", ТекстПодстановки);
		Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
			Если DateFrom <> Неопределено Тогда
				Запрос.УстановитьПараметр("DateFrom", MCP_Values.ДекодироватьПараметр(СтруктураDate(DateFrom)));
			КонецЕсли;
			Если DateTo <> Неопределено Тогда
				Запрос.УстановитьПараметр("DateTo", MCP_Values.ДекодироватьПараметр(СтруктураDate(DateTo)));
			КонецЕсли;
		КонецЕсли;

		Попытка
			Результат = Запрос.Выполнить();
		Исключение
			Продолжить;
		КонецПопытки;

		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() И Совпадения.Количество() < Лимит Цикл
			М = Новый Структура;
			М.Вставить("ref", MCP_Values.Кодировать(Выборка.Ссылка, ОпцииВалью));
			М.Вставить("score", 0.7);
			Поля = Новый Массив;
			Для Каждого П Из ПоляДляТипа Цикл
				Поля.Добавить(П);
			КонецЦикла;
			М.Вставить("matched_fields", Поля);
			М.Вставить("fields", ПолучитьПоляОбъекта(Выборка.Ссылка, ПолноеИмя, IncludeFields, ОпцииВалью));
			Совпадения.Добавить(М);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("matches", Совпадения);
	Результат.Вставить("truncated", Совпадения.Количество() >= Лимит);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. get_link_of_object
// ----------------------------------------------------------------------
Функция GetLinkOfObject(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	UUID = Получить(Аргументы, "uuid", "");
	BaseURL = Получить(Аргументы, "base_url", "");
	LinkType = Получить(Аргументы, "link_type", "auto");
	IncludePresentation = Получить(Аргументы, "include_presentation", Истина);

	Если ПустаяСтрока(Тип) ИЛИ ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Требуются type и uuid.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Тип запрещён: " + Тип);
	КонецЕсли;
	Если НЕ ПустаяСтрока(BaseURL) И НЕ MCP_Security.BaseURLРазрешен(BaseURL) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(), "base_url не входит в allowlist.");
	КонецЕсли;

	Ссылка = MCP_Values.СсылкаПоТипуИUUID(Тип, UUID);

	Существует = НЕ Ссылка.Пустая();

	Ссылки = Новый Массив;

	// e1cib
	Попытка
		E1 = ПолучитьНавигационнуюСсылку(Ссылка);
		Если НЕ ПустаяСтрока(E1) Тогда
			Стр = Новый Структура;
			Стр.Вставить("type", "e1cib");
			Стр.Вставить("url", E1);
			Стр.Вставить("description", "Навигационная ссылка 1С");
			Ссылки.Добавить(Стр);
		КонецЕсли;
	Исключение
	КонецПопытки;

	// web_client
	Если НЕ ПустаяСтрока(BaseURL) Тогда
		Стр = Новый Структура;
		Стр.Вставить("type", "web_client");
		Стр.Вставить("url", BaseURL + "/#" + СтрШаблонСсылки(Тип, UUID));
		Стр.Вставить("description", "Ссылка для web-клиента");
		Ссылки.Добавить(Стр);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("found", Существует);
	Результат.Вставить("ref", MCP_Values.Кодировать(Ссылка));
	Результат.Вставить("links", Ссылки);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 9. find_references_to_object
// ----------------------------------------------------------------------
Функция FindReferencesToObject(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Target = Получить(Аргументы, "target", Неопределено);
	Если Target = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан target.");
	КонецЕсли;
	Target = НормализоватьСтруктуру(Target);

	ТипЦели = Получить(Target, "type", "");
	UUIDЦели = Получить(Target, "uuid", "");
	Если ПустаяСтрока(ТипЦели) ИЛИ ПустаяСтрока(UUIDЦели) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "target.type и target.uuid обязательны.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(ТипЦели) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Цель запрещена: " + ТипЦели);
	КонецЕсли;

	SearchInTypes = Получить(Аргументы, "search_in_types", Неопределено);
	SearchInKinds = Получить(Аргументы, "search_in_kinds", Неопределено);
	LimitPerType = ЦелоеИзАргумента(Аргументы, "limit_per_type", 20, 100);
	MaxTypes = ЦелоеИзАргумента(Аргументы, "max_types", 50, 200);
	IncludeCounts = Получить(Аргументы, "include_counts", Истина);
	IncludeSamples = Получить(Аргументы, "include_samples", Истина);

	СсылкаЦели = MCP_Values.СсылкаПоТипуИUUID(ТипЦели, UUIDЦели);

	// Используем штатный механизм 1С: НайтиПоСсылкам.
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(СсылкаЦели);

	НайденныеСсылки = Новый Массив;
	Попытка
		НайденныеСсылки = НайтиПоСсылкам(МассивСсылок);
	Исключение
		// Метод недоступен в HTTP-сервисе без прав — fallback на ручной перебор.
		НайденныеСсылки = ПоискСсылокЗапросами(СсылкаЦели, SearchInTypes, SearchInKinds, MaxTypes, LimitPerType);
	КонецПопытки;

	// Группируем по source_type + поле.
	Группы = Новый Соответствие;
	Для Каждого СтрокаНаход Из НайденныеСсылки Цикл
		ИсточникСсылка = СтрокаНаход[0];
		МетаОписание = СтрокаНаход[1];
		ТипИсточника = MCP_Values.Кодировать(ИсточникСсылка);
		Если ТипИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяТипа = ТипИсточника.type;

		Если SearchInTypes <> Неопределено И ТипЗнч(SearchInTypes) = Тип("Массив") И SearchInTypes.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого Т Из SearchInTypes Цикл
				Если ВРег(Т) = ВРег(ИмяТипа) Тогда Найден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда Продолжить; КонецЕсли;
		КонецЕсли;

		Ключ = ИмяТипа + "|" + Строка(МетаОписание);
		Запись = Группы.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура;
			Запись.Вставить("source_type", ИмяТипа);
			Запись.Вставить("field_path", Строка(МетаОписание));
			Запись.Вставить("count", 0);
			Запись.Вставить("samples", Новый Массив);
			Запись.Вставить("truncated", Ложь);
			Группы.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.count = Запись.count + 1;
		Если IncludeSamples И Запись.samples.Количество() < LimitPerType Тогда
			Стр = Новый Структура;
			Стр.Вставить("ref", ТипИсточника);
			Запись.samples.Добавить(Стр);
		ИначеЕсли Запись.samples.Количество() >= LimitPerType Тогда
			Запись.truncated = Истина;
		КонецЕсли;
	КонецЦикла;

	Ссылки = Новый Массив;
	Для Каждого КЗ Из Группы Цикл
		Ссылки.Добавить(КЗ.Значение);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("target", MCP_Values.Кодировать(СсылкаЦели));
	Результат.Вставить("references", Ссылки);
	Результат.Вставить("searched_types_count", Ссылки.Количество());
	Результат.Вставить("truncated", Ссылки.Количество() >= MaxTypes);
	Возврат Результат;

КонецФункции

Функция ПоискСсылокЗапросами(СсылкаЦели, SearchInTypes, SearchInKinds, MaxTypes, LimitPerType)

	// Fallback: ничего глубокого, возвращаем пустой массив.
	Возврат Новый Массив;

КонецФункции

// ----------------------------------------------------------------------
// 10. get_enum_values
// ----------------------------------------------------------------------
Функция GetEnumValues(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	IncludeOrder = Получить(Аргументы, "include_order", Истина);
	IncludeEmpty = Получить(Аргументы, "include_empty", Ложь);

	Если ПустаяСтрока(Тип) ИЛИ НЕ СтрНачинаетсяС(Тип, "Перечисление.") Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Ожидается тип Перечисление.<Имя>.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Перечисление запрещено: " + Тип);
	КонецЕсли;

	ИмяПеречисления = MCP_Security.ИмяОбъектаИзПолногоИмени(Тип);
	ОМД = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "Перечисление не найдено: " + Тип);
	КонецЕсли;

	Значения = Новый Массив;
	Порядок = 0;
	Для Каждого Зн Из ОМД.ЗначенияПеречисления Цикл
		Порядок = Порядок + 1;
		Стр = Новый Структура;
		Стр.Вставить("name", Зн.Имя);
		Стр.Вставить("presentation", Зн.Синоним);
		Если IncludeOrder Тогда
			Стр.Вставить("order", Порядок);
		КонецЕсли;
		Значения.Добавить(Стр);
	КонецЦикла;

	Если IncludeEmpty Тогда
		Пустое = Новый Структура;
		Пустое.Вставить("name", "ПустаяСсылка");
		Пустое.Вставить("presentation", "");
		Пустое.Вставить("order", 0);
		Значения.Вставить(0, Пустое);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("type", Тип);
	Результат.Вставить("values", Значения);
	Возврат Результат;

КонецФункции

