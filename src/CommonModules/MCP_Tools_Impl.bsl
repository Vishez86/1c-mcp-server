// ----------------------------------------------------------------------
// 10. get_enum_values
// ----------------------------------------------------------------------
Функция GetEnumValues(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	IncludeOrder = Получить(Аргументы, "include_order", Истина);
	IncludeEmpty = Получить(Аргументы, "include_empty", Ложь);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 1000, 1000);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда
		Курсор = 0;
	КонецЕсли;

	Если ПустаяСтрока(Тип) ИЛИ НЕ СтрНачинаетсяС(Тип, "Перечисление.") Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Ожидается тип Перечисление.<Имя>.");
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Перечисление запрещено: " + Тип);
	КонецЕсли;

	ИмяПеречисления = MCP_Security.ИмяОбъектаИзПолногоИмени(Тип);
	ОМД = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "Перечисление не найдено: " + Тип);
	КонецЕсли;

	Значения = Новый Массив;
	Порядок = 0;
	Для Каждого Зн Из ОМД.ЗначенияПеречисления Цикл
		Порядок = Порядок + 1;
		Стр = Новый Структура;
		Стр.Вставить("name", Зн.Имя);
		Стр.Вставить("presentation", Зн.Синоним);
		Если IncludeOrder Тогда
			Стр.Вставить("order", Порядок);
		КонецЕсли;
		Значения.Добавить(Стр);
	КонецЦикла;

	Если IncludeEmpty Тогда
		Пустое = Новый Структура;
		Пустое.Вставить("name", "ПустаяСсылка");
		Пустое.Вставить("presentation", "");
		Пустое.Вставить("order", 0);
		Значения.Вставить(0, Пустое);
	КонецЕсли;

	СтраницаЗначений = Новый Массив;
	Конец = Мин(Курсор + Лимит, Значения.Количество());
	Если Курсор < Значения.Количество() Тогда
		Для Индекс = Курсор По Конец - 1 Цикл
			СтраницаЗначений.Добавить(Значения[Индекс]);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если Конец < Значения.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("type", Тип);
	Результат.Вставить("values", СтраницаЗначений);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("total_estimated", Значения.Количество());
	Возврат Результат;

