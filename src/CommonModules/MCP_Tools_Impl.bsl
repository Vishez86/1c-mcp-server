// ----------------------------------------------------------------------
// 17. get_current_user_context
// ----------------------------------------------------------------------
Функция GetCurrentUserContext(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	IncludeRoles = Получить(Аргументы, "include_roles", Истина);
	IncludeLimits = Получить(Аргументы, "include_limits", Истина);
	IncludeSummary = Получить(Аргументы, "include_allowed_metadata_summary", Истина);
	IncludeServer = Получить(Аргументы, "include_server_info", Истина);

	Результат = Новый Структура;

	// Пользователь.
	User = Новый Структура;
	Попытка
		ТП = ПользователиИнформационнойБазы.ТекущийПользователь();
		User.Вставить("name", ?(ТП = Неопределено, "", ТП.Имя));
		User.Вставить("full_name", ?(ТП = Неопределено, "", ТП.ПолноеИмя));
		Если IncludeRoles Тогда
			Роли = Новый Массив;
			Если ТП <> Неопределено Тогда
				Для Каждого Р Из ТП.Роли Цикл
					Роли.Добавить(Р.Имя);
				КонецЦикла;
			КонецЕсли;
			User.Вставить("roles", Роли);
		КонецЕсли;
	Исключение
		User.Вставить("name", "system");
		User.Вставить("full_name", "");
	КонецПопытки;
	Результат.Вставить("user", User);

	// Инфобаза.
	Infobase = Новый Структура;
	Попытка
		Infobase.Вставить("name", Метаданные.Имя);
		Infobase.Вставить("synonym", Метаданные.Синоним);
		Infobase.Вставить("configuration_name", Метаданные.Имя);
		Infobase.Вставить("configuration_version", Метаданные.Версия);
		Infobase.Вставить("platform_version", ВерсияПлатформы());
		Infobase.Вставить("host", ИмяКомпьютера());
	Исключение
	КонецПопытки;
	Результат.Вставить("infobase", Infobase);

	// Сервер.
	Если IncludeServer Тогда
		MCPServer = Новый Структура;
		MCPServer.Вставить("name", MCP_Config.ИмяСервера());
		MCPServer.Вставить("version", MCP_Config.ВерсияСервера());
		MCPServer.Вставить("read_only", MCP_Config.СерверReadOnly());
		Tools = Новый Массив;
		Для Каждого T Из MCP_Tools.СписокTools() Цикл
			Tools.Добавить(T.name);
		КонецЦикла;
		MCPServer.Вставить("tools", Tools);
		Результат.Вставить("mcp_server", MCPServer);
	КонецЕсли;

	// Лимиты.
	Если IncludeLimits Тогда
		Результат.Вставить("limits", MCP_Config.Лимиты());
	КонецЕсли;

	// Summary allowlist.
	Если IncludeSummary Тогда
		Сводка = Новый Структура;
		Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
		ПоВидам = Новый Соответствие;
		Подсчет = 0;
		Для Каждого Стр Из Все Цикл
			Если MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
				Подсчет = Подсчет + 1;
				ТекущКоличество = ПоВидам.Получить(Стр.Вид);
				Если ТекущКоличество = Неопределено Тогда
					ТекущКоличество = 0;
				КонецЕсли;
				ПоВидам.Вставить(Стр.Вид, ТекущКоличество + 1);
			КонецЕсли;
		КонецЦикла;
		Сводка.Вставить("objects_count", Подсчет);
		Виды = Новый Структура;
		Для Каждого КЗ Из ПоВидам Цикл
			Виды.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
		КонецЦикла;
		Сводка.Вставить("kinds", Виды);
		Результат.Вставить("allowed_metadata_summary", Сводка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Helpers

Функция НормализоватьСтруктуру(Знач Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Структура;
		Для Каждого КЗ Из Значение Цикл
			Попытка
				Результат.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
			Исключение
				// Ключ не подходит под идентификатор Структуры — пропускаем,
				// чтобы один невалидный ключ не валил весь tool-вызов.
			КонецПопытки;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Новый Структура;

КонецФункции

Функция Получить(Аргументы, ИмяПоля, ЗначениеПоУмолчанию) Экспорт

	Если Аргументы = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Аргументы) = Тип("Структура")
		ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированнаяСтруктура"))
		И Аргументы.Свойство(ИмяПоля, Значение) Тогда
		Если Значение = Неопределено ИЛИ Значение = Null Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Аргументы) = Тип("Соответствие")
		ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Аргументы.Получить(ИмяПоля);
		Если Значение = Неопределено ИЛИ Значение = Null Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ЦелоеИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию, Максимум)

	Значение = Получить(Аргументы, ИмяПоля, ПоУмолчанию);
	Попытка
		Ц = Цел(Число(Значение));
	Исключение
		Ц = ПоУмолчанию;
	КонецПопытки;
	Если Ц < 1 Тогда
		Ц = ПоУмолчанию;
	КонецЕсли;
	Если Ц > Максимум Тогда
		Ц = Максимум;
	КонецЕсли;
	Возврат Ц;

КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция СтрНачинаетсяС(Знач Строка, Знач Префикс)
	Если СтрДлина(Строка) < СтрДлина(Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Лев(Строка, СтрДлина(Префикс)) = Префикс;
КонецФункции

Функция ПодготовитьПодстановку(Знач Текст, Знач MatchMode)

	Текст = СокрЛП(Текст);
	Если MatchMode = "exact" Тогда
		Возврат Текст;
	ИначеЕсли MatchMode = "prefix" Тогда
		Возврат Текст + "%";
	ИначеЕсли MatchMode = "contains" ИЛИ MatchMode = "auto" Тогда
		Возврат "%" + Текст + "%";
	КонецЕсли;
	Возврат "%" + Текст + "%";

КонецФункции

Функция СформироватьЦелевыеТипы(Типы, Виды)

	Результат = Новый Массив;
	Если ТипЗнч(Типы) = Тип("Массив") И Типы.Количество() > 0 Тогда
		Для Каждого Т Из Типы Цикл
			Если MCP_Security.ТипРазрешен(Т) Тогда
				Результат.Добавить(Т);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если НЕ Стр.SupportsRef ИЛИ НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.Вид = "Перечисление" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого В Из Виды Цикл
				Если ВРег(В) = ВРег(Стр.Вид) Тогда Найден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Стр.ПолноеИмя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьПоляОбъекта(Ссылка, ПолноеИмя, IncludeFields, ОпцииВалью)

	Поля = Новый Структура;
	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Возврат Поля;
	КонецЕсли;

	Список = IncludeFields;
	Если Список = Неопределено ИЛИ ТипЗнч(Список) <> Тип("Массив") ИЛИ Список.Количество() = 0 Тогда
		Список = MCP_Security.ПоляПоУмолчанию(ПолноеИмя);
	КонецЕсли;
	Если Список.Количество() = 0 Тогда
		Возврат Поля;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Возврат Поля;
	КонецПопытки;

	Если Объект = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	Для Каждого П Из Список Цикл
		Если НЕ MCP_Security.ПолеРазрешено(ПолноеИмя, П) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Поля.Вставить(П, MCP_Values.Кодировать(Объект[П], ОпцииВалью));
		Исключение
			// Поле может отсутствовать в стандартных реквизитах.
		КонецПопытки;
	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция СтруктураDate(Знач Значение)

	// Если значение уже в виде {kind, value} — пропускаем без повторного оборачивания,
	// иначе Строка(Структура/Соответствия) вернёт текст-описание и парсинг даты сломается.
	// JSON-объекты могут прийти как Структура или как Соответствие — учитываем оба варианта.
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Запас = Неопределено;
		Если Значение.Свойство("kind", Запас) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Если Значение.Получить("kind") <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("kind", "datetime");
	Стр.Вставить("value", Строка(Значение));
	Возврат Стр;

КонецФункции

Функция СсылкаСуществует(Ссылка, ПолноеИмя)

	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
		Запрос = Новый Запрос(ЗапросТекст);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Возврат НЕ Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция НормализоватьBaseURL(BaseURL)

	BaseURL = СокрЛП(Строка(BaseURL));
	Пока СтрДлина(BaseURL) > СтрДлина("https://") И Прав(BaseURL, 1) = "/" Цикл
		BaseURL = Лев(BaseURL, СтрДлина(BaseURL) - 1);
	КонецЦикла;
	Возврат BaseURL;

КонецФункции

Функция СтрШаблонСсылки(Тип, UUID)
	Возврат "/" + СтрЗаменить(Тип, ".", "/") + "/" + UUID;
КонецФункции

Функция ВерсияПлатформы()
	Попытка
		СистемнаяИнформация = Новый СистемнаяИнформация;
		Возврат Строка(СистемнаяИнформация.ВерсияПриложения);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

#КонецОбласти
