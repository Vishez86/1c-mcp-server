// HR-01 (фаза B): жёстко закрытые поля типа для предвалидатора запросов.
// Возвращает массив канонических имён полей; текстовое вхождение любого из
// них в запрос, среди источников которого есть этот тип, — отказ до
// выполнения. Проверка по вхождению текста сознательно грубая (одноимённые
// поля других источников тоже отклоняются — безопасная сторона ошибки);
// точное разрешение полей по источникам — фаза C.
Функция ЖесткоЗакрытыеПоляPrivacy(ПолноеИмяТипа) Экспорт

	Индекс = Новый Соответствие;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	МаскиТипов = MCP_Config.МаскиПолейТиповLLM();
	Запись = МаскиТипов.entries.Получить(НормТип);
	Если Запись <> Неопределено И Запись.mode = "deny" Тогда
		Для Каждого ИмяПоля Из Запись.field_names Цикл
			Индекс.Вставить(ИмяПоля, Истина);
		КонецЦикла;
		Если Запись.mask_presentation Тогда
			// Среди закрытых полей есть имя-подобное: закрываем весь ряд имён,
			// иначе НаименованиеПолное запрещено, а Наименование открыто.
			ДобавитьИмяПодобныеПоляPrivacy(Индекс);
		КонецЕсли;
	КонецЕсли;

	ПсевдонимыТипов = MCP_Config.ПсевдонимыТиповLLM();
	ЗаписьАлиаса = ПсевдонимыТипов.entries.Получить(НормТип);
	Если ЗаписьАлиаса <> Неопределено И ЗаписьАлиаса.mode = "deny" Тогда
		// Для псевдонимов deny закрывает только имена: работа со ссылками
		// остаётся разрешённой, названия возвращаются стабильными кодами.
		ДобавитьИмяПодобныеПоляPrivacy(Индекс);
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого КЗ Из Индекс Цикл
		Поля.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Поля;

КонецФункции

// ---- HR-05: privacy-gate на параметры инструментов ----
//
// Единая точка решения (NFR-05): вызывается из MCP_Tools.ВыполнитьИнструмент до
// вызова реализации. Возвращает "" — запрет не сработал, либо текст причины
// отказа с разрешённой альтернативой. Правило одно: поиск, отбор, сортировка и
// группировка по закрытому полю закрытого типа запрещены, работа по ссылке и
// uuid разрешена, вывод закрывает второй эшелон (маскирование).
Функция ЗапретPrivacyДляИнструмента(ИмяТула, Аргументы) Экспорт

	Если НЕ ЕстьЖесткиеЗапретыPrivacy() Тогда
		Возврат "";
	КонецЕсли;

	Если ИмяТула = "search_objects" Тогда
		// types не задан — поиск идёт по всем разрешённым типам, включая закрытые.
		Возврат ЗапретPrivacyПоискаПоИмени(Аргументы, "query", "types", "");
	ИначеЕсли ИмяТула = "get_inventory_balances_by_item" Тогда
		// item_ref задаёт объект ссылкой — это разрешённый путь, item_query
		// ищет по наименованию и является оракулом.
		Если ЗначениеАргументаPrivacy(Аргументы, "item_ref") <> Неопределено Тогда
			Возврат "";
		КонецЕсли;
		// У инструмента есть тип по умолчанию, поэтому пустой item_type не
		// означает «все типы»: иначе закрытый Справочник.Контрагенты отклонял бы
		// поиск номенклатуры, которую никто не закрывал.
		Возврат ЗапретPrivacyПоискаПоИмени(Аргументы, "item_query", "item_type",
			"Справочник.Номенклатура");
	ИначеЕсли ИмяТула = "get_register_records" Тогда
		ПолноеИмя = СтрокаАргументаPrivacy(Аргументы, "register_type")
			+ "." + СтрокаАргументаPrivacy(Аргументы, "register");
		Возврат ЗапретPrivacyПолейИнструмента(Аргументы, ПолноеИмя);
	ИначеЕсли ИмяТула = "get_accounting_balances"
		ИЛИ ИмяТула = "get_accounting_entries"
		ИЛИ ИмяТула = "get_accounting_balances_by_subconto_age"
		ИЛИ ИмяТула = "compare_accounting_balances_by_subconto" Тогда
		Возврат ЗапретPrivacyПолейИнструмента(Аргументы,
			СтрокаАргументаPrivacy(Аргументы, "accounting_register"));
	ИначеЕсли ИмяТула = "run_1c_report" Тогда
		Возврат ЗапретPrivacyПараметровОтчета(Аргументы);
	КонецЕсли;

	Возврат "";

КонецФункции

// Поиск по строке-наименованию в закрытом типе восстанавливает закрытое
// название по факту совпадения, даже когда вывод замаскирован. Если типы не
// заданы явно, в область поиска попадают все разрешённые типы, включая
// закрытые, — отказ с указанием, какие типы исключить.
Функция ЗапретPrivacyПоискаПоИмени(Аргументы, ИмяПараметраЗапроса, ИмяПараметраТипов, ТипПоУмолчанию)

	СтрокаПоиска = СтрокаАргументаPrivacy(Аргументы, ИмяПараметраЗапроса);
	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат "";
	КонецЕсли;

	ЗакрытыеТипы = ЖесткоЗакрытыеТипыPrivacy();
	ТипыПоиска = МассивСтрокАргументаPrivacy(Аргументы, ИмяПараметраТипов);
	Если ТипыПоиска.Количество() = 0 И НЕ ПустаяСтрока(ТипПоУмолчанию) Тогда
		ТипыПоиска.Добавить(ТипПоУмолчанию);
	КонецЕсли;

	Если ТипыПоиска.Количество() = 0 Тогда
		Перечисление = Новый Массив;
		Для Каждого ИмяТипа Из ЗакрытыеТипы Цикл
			Если ПоискПоИменамЗакрытPrivacy(ИмяТипа) Тогда
				Перечисление.Добавить(ИмяТипа);
			КонецЕсли;
		КонецЦикла;
		Если Перечисление.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат "Поиск по наименованию затрагивает типы, закрытые privacy-политикой (mode: deny): "
			+ СтрСоединить(Перечисление, ", ")
			+ ". Укажите " + ИмяПараметраТипов + " явно, без этих типов,"
			+ " либо ищите по uuid (find_object_by_id).";
	КонецЕсли;

	Для Каждого ИмяТипа Из ТипыПоиска Цикл
		Если ПоискПоИменамЗакрытPrivacy(ИмяТипа) Тогда
			Возврат "Поиск по наименованию закрыт privacy-политикой (mode: deny) для типа "
				+ ИмяТипа + ". Работайте со ссылками: uuid, find_object_by_id, get_object_by_ref;"
				+ " названия возвращаются стабильными псевдонимами.";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Закрыт ли для типа поиск по именам: закрыто имя-подобное поле либо выдан
// жёсткий запрет на псевдонимы этого типа.
Функция ПоискПоИменамЗакрытPrivacy(ПолноеИмяТипа)

	Если ПредставлениеЖесткоЗакрытоPrivacy(ПолноеИмяТипа) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Поле Из ЖесткоЗакрытыеПоляPrivacy(ПолноеИмяТипа) Цикл
		Если MCP_Config.ПолеИмениОбъектаPrivacy(MCP_Config.НормализоватьКлючPrivacy(Поле)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Отборы, сортировки, группировки и списки полей инструмента: имя закрытого
// поля в любом из них — отказ. Разыменование в имени поля (Измерение.Поле)
// проверяется по хвосту: закрыто ли поле у типа-владельца хвоста.
Функция ЗапретPrivacyПолейИнструмента(Аргументы, ПолноеИмяТипа)

	Если ПустаяСтрока(ПолноеИмяТипа) ИЛИ СтрНайти(ПолноеИмяТипа, ".") = 0 Тогда
		Возврат "";
	КонецЕсли;

	ИменаПараметров = Новый Массив;
	ИменаПараметров.Добавить("filters");
	ИменаПараметров.Добавить("order_by");
	ИменаПараметров.Добавить("group_by");
	ИменаПараметров.Добавить("dimensions");
	ИменаПараметров.Добавить("fields");

	Для Каждого ИмяПараметра Из ИменаПараметров Цикл
		Для Каждого ИмяПоля Из ИменаПолейАргументаPrivacy(Аргументы, ИмяПараметра) Цикл
			ЗакрытоеПоле = ЗакрытоеПолеИзВыраженияPrivacy(ПолноеИмяТипа, ИмяПоля);
			Если НЕ ПустаяСтрока(ЗакрытоеПоле) Тогда
				Возврат "Параметр " + ИмяПараметра + " обращается к полю, закрытому"
					+ " privacy-политикой (mode: deny): " + ЗакрытоеПоле
					+ ". Отбор, сортировка и группировка по ссылке разрешены;"
					+ " названия возвращаются стабильными псевдонимами.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

// Имя поля или путь разыменования: возвращает "<Тип>.<Поле>" первого закрытого
// звена либо "". Сегменты разбираются по метаданным, поэтому отбор по самой
// ссылке (Контрагент) остаётся разрешённым, а Контрагент.Наименование — нет.
Функция ЗакрытоеПолеИзВыраженияPrivacy(ПолноеИмяИсточника, Выражение)

	Сегменты = СтрРазделить(СокрЛП(Строка(Выражение)), ".", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекущийТип = ПолноеИмяИсточника;
	Для Индекс = 0 По Сегменты.Количество() - 1 Цикл
		Сегмент = СокрЛП(Сегменты[Индекс]);
		Если ПустаяСтрока(Сегмент) ИЛИ ПустаяСтрока(ТекущийТип) Тогда
			Прервать;
		КонецЕсли;
		Если ПолеЖесткоЗакрытоPrivacy(ТекущийТип, Сегмент) Тогда
			Возврат ТекущийТип + "." + Сегмент;
		КонецЕсли;
		Если Индекс = Сегменты.Количество() - 1 Тогда
			Прервать;
		КонецЕсли;
		ТекущийТип = ТипСсылочногоПоляPrivacy(ТекущийТип, Сегмент);
	КонецЦикла;

	Возврат "";

КонецФункции

// Полное имя типа ссылочного поля (первый ссылочный тип). "" — не разрешено.
Функция ТипСсылочногоПоляPrivacy(ПолноеИмяТипа, ИмяПоля)

	Попытка
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
		Если ОбъектМД = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Реквизит = РеквизитДляPrivacy(ОбъектМД, ИмяПоля);
		Если Реквизит = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл
			ОМДТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
			Если ОМДТипа <> Неопределено Тогда
				Возврат ОМДТипа.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

// Реквизит, измерение или ресурс объекта по имени. Отсутствующие у вида
// коллекции пропускаются.
Функция РеквизитДляPrivacy(ОбъектМД, ИмяПоля)

	Коллекции = Новый Массив;
	Попытка
		Коллекции.Добавить(ОбъектМД.Реквизиты);
	Исключение
	КонецПопытки;
	Попытка
		Коллекции.Добавить(ОбъектМД.Измерения);
	Исключение
	КонецПопытки;

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Реквизит Из Коллекция Цикл
			Если MCP_Config.НормализоватьКлючPrivacy(Реквизит.Имя) = НормПоле Тогда
				Возврат Реквизит;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Параметры СКД-отчёта: имя параметра, совпавшее с закрытым полем закрытого
// типа, — отбор по названию. Состав полей варианта отчёта до выполнения
// недоступен, поэтому вывод отчёта закрывает второй эшелон (см. §8.3 ТЗ).
Функция ЗапретPrivacyПараметровОтчета(Аргументы)

	Параметры = ЗначениеАргументаPrivacy(Аргументы, "parameters");
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипПараметров = ТипЗнч(Параметры);
	Если ТипПараметров <> Тип("Структура") И ТипПараметров <> Тип("ФиксированнаяСтруктура")
		И ТипПараметров <> Тип("Соответствие") И ТипПараметров <> Тип("ФиксированноеСоответствие") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого КЗ Из Параметры Цикл
		ИмяПараметра = Строка(КЗ.Ключ);
		Для Каждого ИмяТипа Из ЖесткоЗакрытыеТипыPrivacy() Цикл
			Если ПолеЖесткоЗакрытоPrivacy(ИмяТипа, ИмяПараметра) Тогда
				Возврат "Параметр отчёта " + ИмяПараметра + " совпадает с полем, закрытым"
					+ " privacy-политикой (mode: deny) у типа " + ИмяТипа
					+ ". Передавайте отбор ссылкой, а не названием.";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

// ---- Чтение аргументов инструмента (Структура или Соответствие) ----

Функция ЗначениеАргументаPrivacy(Аргументы, Имя)

	Если Аргументы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипАргументов = ТипЗнч(Аргументы);
	Значение = Неопределено;
	Если ТипАргументов = Тип("Структура") ИЛИ ТипАргументов = Тип("ФиксированнаяСтруктура") Тогда
		Если НЕ Аргументы.Свойство(Имя, Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ТипАргументов = Тип("Соответствие") ИЛИ ТипАргументов = Тип("ФиксированноеСоответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;

	Если Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция СтрокаАргументаPrivacy(Аргументы, Имя)

	Значение = ЗначениеАргументаPrivacy(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);

КонецФункции

Функция МассивСтрокАргументаPrivacy(Аргументы, Имя)

	Результат = Новый Массив;
	Значение = ЗначениеАргументаPrivacy(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Если НЕ ПустаяСтрока(Значение) Тогда
			Результат.Добавить(СокрЛП(Значение));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Строка") И НЕ ПустаяСтрока(Элемент) Тогда
				Результат.Добавить(СокрЛП(Элемент));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имена полей из параметра: массив строк (order_by, group_by, fields) либо
// ключи структуры отборов (filters).
Функция ИменаПолейАргументаPrivacy(Аргументы, Имя)

	Значение = ЗначениеАргументаPrivacy(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Массив;
		Для Каждого КЗ Из Значение Цикл
			Результат.Добавить(Строка(КЗ.Ключ));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат МассивСтрокАргументаPrivacy(Аргументы, Имя);

КонецФункции

// Есть ли в политике хотя бы одна deny-запись. Нужно для быстрого выхода:
// при отсутствии жёстких запретов предвалидатор не выполняет новых проверок
// (NFR-03).
Функция ЕстьЖесткиеЗапретыPrivacy() Экспорт

	// Дешёвый отсев до полного разбора политики: см. комментарий у
	// ЕстьПризнакDenyВНастройкахPrivacy.
	Если НЕ MCP_Config.ЕстьПризнакDenyВНастройкахPrivacy() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Запись Из MCP_Config.МаскиПолейТиповLLM().list Цикл
		Если Запись.mode = "deny" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из MCP_Config.ПсевдонимыТиповLLM().list Цикл
		Если Запись.mode = "deny" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Полные имена типов, закрытых жёстким запретом. Нужны для консервативного
// отказа: если текст запроса разобрать не удалось, но закрытый тип в нём
// упомянут, отказ выдаётся до выполнения (HR-02).
Функция ЖесткоЗакрытыеТипыPrivacy() Экспорт

	Типы = Новый Массив;
	Найдено = Новый Соответствие;

	Для Каждого Запись Из MCP_Config.МаскиПолейТиповLLM().list Цикл
		Если Запись.mode = "deny" И Найдено.Получить(Запись.type) = Неопределено Тогда
			Найдено.Вставить(Запись.type, Истина);
			Типы.Добавить(Запись.type);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из MCP_Config.ПсевдонимыТиповLLM().list Цикл
		Если Запись.mode = "deny" И Найдено.Получить(Запись.type) = Неопределено Тогда
			Найдено.Вставить(Запись.type, Истина);
			Типы.Добавить(Запись.type);
		КонецЕсли;
	КонецЦикла;

	Возврат Типы;

КонецФункции

// Закрыто ли конкретное поле конкретного типа жёстким запретом (HR-01).
// Сравнение нормализованное: регистр, пробелы, `_`, `-`, `Ё` не важны.
Функция ПолеЖесткоЗакрытоPrivacy(ПолноеИмяТипа, ИмяПоля) Экспорт

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Если ПустаяСтрока(НормПоле) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ЗакрытоеПоле Из ЖесткоЗакрытыеПоляPrivacy(ПолноеИмяТипа) Цикл
		Если MCP_Config.НормализоватьКлючPrivacy(ЗакрытоеПоле) = НормПоле Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Закрыто ли представление объектов типа (HR-04): вычисление
// ПРЕДСТАВЛЕНИЕ()/ПРЕДСТАВЛЕНИЕССЫЛКИ() над ссылкой такого типа даёт плоскую
// строку с названием, которую второй эшелон опознать не может.
// Поля типа, которые подменяются в ответе, независимо от режима записи.
// Отличие от ЖесткоЗакрытыеПоляPrivacy — та отбирает только mode = "deny" и
// служит блокировке; здесь режим не важен: mask тоже обязан подменять, просто
// без отказа. Возвращает Массив имён полей.
Функция ЗакрытыеПоляТипаPrivacy(ПолноеИмяТипа, Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);
	Индекс = Новый Соответствие;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	Запись = Политика.маски_типов.entries.Получить(НормТип);
	Если Запись <> Неопределено Тогда
		Для Каждого ИмяПоля Из Запись.field_names Цикл
			Индекс.Вставить(ИмяПоля, Истина);
		КонецЦикла;
		Если Запись.mask_presentation Тогда
			ДобавитьИмяПодобныеПоляPrivacy(Индекс);
		КонецЕсли;
	КонецЕсли;

	Если Политика.типы.entries.Получить(НормТип) <> Неопределено Тогда
		// Псевдоним типа закрывает имена объекта: сама ссылка остаётся, её
		// заменяет стабильный код.
		ДобавитьИмяПодобныеПоляPrivacy(Индекс);
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого КЗ Из Индекс Цикл
		Поля.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Поля;

КонецФункции

// Полное имя указывает на табличную часть, а не на объект. Проверка обязательна
// перед легаси-правилами: типы персон опознаются по ПРЕФИКСУ нормализованного
// имени, и «Справочник.ФизическиеЛица.ТабличнаяЧасть.КонтактнаяИнформация» иначе
// сошёл бы за сам справочник — представление контактной информации маскировалось
// бы как ФИО владельца.
Функция ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа)

	Возврат СтрНайти(ВРег(СокрЛП(Строка(ПолноеИмяТипа))), ".ТАБЛИЧНАЯЧАСТЬ.") > 0;

КонецФункции

// Безопасная маска значения на случай сбоя подмены: строка → XXXXXXX, дата →
// 1900-01-01T00:00:00, число и булево → null. Вызывающая сторона обязана
// применять её вместо открытого значения, если подстановку вычислить не удалось.
Функция МаскаЗначенияPrivacy(ИмяПоля, Значение) Экспорт

	Возврат МаскаПоляДляLLM(ИмяПоля, Значение);

КонецФункции

// Подменяется ли представление объекта этого типа — независимо от режима.
Функция ПредставлениеЗакрытоPrivacy(ПолноеИмяТипа, Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	Если ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Политика) Тогда
		Возврат Истина;
	КонецЕсли;

	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	Если Политика.типы.entries.Получить(НормТип) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаписьМаски = Политика.маски_типов.entries.Получить(НормТип);
	Возврат ЗаписьМаски <> Неопределено И ЗаписьМаски.mask_presentation;

КонецФункции

// Поле типа подменяется в ответе (режим не важен).
Функция ПолеЗакрытоPrivacy(ПолноеИмяТипа, ИмяПоля, Снимок = Неопределено) Экспорт

	ВерхИмя = ВРег(СокрЛП(Строка(ИмяПоля)));
	Если ПустаяСтрока(ВерхИмя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ЗакрытоеПоле Из ЗакрытыеПоляТипаPrivacy(ПолноеИмяТипа, Снимок) Цикл
		Если ВРег(ЗакрытоеПоле) = ВерхИмя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ПолеЗакрытоЛегасиПсевдонимомPrivacy(ПолноеИмяТипа, ИмяПоля, Снимок);

КонецФункции

// Снимок политики на один вызов инструмента (M-05). НастройкиСервера() читает
// константу и парсит JSON при каждом обращении — межвызовного кеша в проекте нет
// осознанно. Предикаты закрытости вызываются на каждую колонку и на каждую
// ячейку, поэтому без снимка тысяча строк на три помеченных колонки давала бы
// три тысячи разборов JSON на один запрос.
Функция СнимокПолитикиPrivacy() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("типы", MCP_Config.ПсевдонимыТиповLLM());
	Результат.Вставить("маски_типов", MCP_Config.МаскиПолейТиповLLM());
	// Легаси-секции обязаны быть в снимке: решение по персонам принимается на
	// каждой ячейке зарплатного контура, и без снимка каждая читала бы константу
	// заново — тот самый разбор JSON на ячейку, ради которого снимок и вводится.
	Результат.Вставить("персоны", MCP_Config.ПсевдонимыПерсонLLM());
	Результат.Вставить("организации", MCP_Config.ПсевдонимыОрганизацийLLM());
	Возврат Результат;

КонецФункции

// Есть ли в политике хоть один закрытый тип. Дешёвый ранний выход: без политики
// разбирать запрос ради пометки колонок не нужно вовсе. Легаси-псевдонимы персон
// и организаций учтены — они закрывают типы без записи в политике.
Функция ЕстьЗакрытыеТипыPrivacy(Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);
	Возврат Политика.типы.enabled
		ИЛИ Политика.маски_типов.enabled
		ИЛИ Политика.персоны.enabled
		ИЛИ Политика.организации.enabled;

КонецФункции

// Тип анонимизируют легаси-псевдонимы персон и организаций. Перечислить их поля
// списком нельзя: у этого механизма нет записи в политике, состав закрытых полей
// он определяет по именам (ФИО, паспорт, ИНН, СНИЛС, дата рождения), поэтому
// решение принимается парой «тип + имя поля», а не через ЗакрытыеПоляТипаPrivacy.
Функция ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Снимок = Неопределено)

	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	Если ЭтоТипПерсоныLLM(ПолноеИмяТипа) Тогда
		Возврат Политика.персоны.enabled;
	КонецЕсли;
	Если ЭтоТипОрганизацииLLM(ПолноеИмяТипа) Тогда
		Возврат Политика.организации.enabled;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Поле закрыто легаси-псевдонимом: те же правила по именам, что применяет
// маскирование готового ответа, — иначе плоская выборка ФИО остаётся открытой
// при любой политике, потому что физлиц и сотрудников в type_aliases класть
// запрещено (ТипПокрытЛегасиПсевдонимамиLLM).
Функция ПолеЗакрытоЛегасиПсевдонимомPrivacy(ПолноеИмяТипа, ИмяПоля, Снимок = Неопределено)

	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	Если ЭтоТипПерсоныLLM(ПолноеИмяТипа) Тогда
		Если НЕ Политика.персоны.enabled Тогда
			Возврат Ложь;
		КонецЕсли;
		// Владелец поля — сам тип персоны, поэтому общее Наименование тоже её имя.
		Возврат ПолеПохожеНаИмяПерсоныLLM(ИмяПоля, "", Истина)
			ИЛИ ПолеНужноМаскироватьПерсональныеДанныеLLM(ИмяПоля, "", Политика.персоны, "");
	КонецЕсли;

	Если ЭтоТипОрганизацииLLM(ПолноеИмяТипа) Тогда
		Возврат Политика.организации.enabled
			И ПолеПохожеНаНазваниеОрганизацииLLM(ИмяПоля, "", Истина);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Значение подмены для колонки закрытого типа. Ссылка объекта в строке известна
// → стабильный код от uuid, тот же, что у ссылочных значений, поэтому строки
// сопоставимы между собой и между ответами. Ссылки нет → <Префикс>скрыто.
// Нет и псевдонима у типа (тип только в масках полей) → строковая маска.
Функция ПодменаЗначенияPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	Если ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Политика) Тогда
		Возврат ПодменаЛегасиПсевдонимаPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Политика);
	КонецЕсли;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);
	Запись = Политика.типы.entries.Получить(НормТип);
	// Код псевдонима подставляется вместо ИМЕНИ объекта. Прочие закрытые поля —
	// номер документа, идентификатор, дата — именем не являются: строка в
	// колонке-дате и в числовой ломает типизацию у клиента, поэтому им положена
	// обычная маска. Тот же принцип уже соблюдён в МаскаПоляТипаДляLLM.
	Если Запись = Неопределено ИЛИ НЕ ПолеИмениОбъектаДляПодменыPrivacy(ИмяПоля) Тогда
		Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
	КонецЕсли;

	Если НЕ ПустаяСтрока(UUID) Тогда
		Возврат Запись.prefix + КодПсевдонимаТипаLLM(ПолноеИмяТипа, UUID);
	КонецЕсли;

	Возврат Запись.hidden_alias;

КонецФункции

// Подменяется имя объекта, а не прочее закрытое поле. Пустое имя означает
// представление объекта — это тоже его имя.
Функция ПолеИмениОбъектаДляПодменыPrivacy(ИмяПоля)

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Возврат ПустаяСтрока(НормПоле) ИЛИ MCP_Config.ПолеИмениОбъектаPrivacy(НормПоле);

КонецФункции

// Подстановка для типа, закрытого легаси-псевдонимами. Псевдоним заменяет только
// имя объекта и его представление — как в МаскироватьПерсонуДляLLM; паспорт,
// СНИЛС и дата рождения именем не являются и получают обычную маску, иначе в
// колонке даты оказалась бы строка вида «ФЛ-123456».
Функция ПодменаЛегасиПсевдонимаPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Политика)

	ЭтоИмя = ПустаяСтрока(СокрЛП(Строка(ИмяПоля)));

	Если ЭтоТипПерсоныLLM(ПолноеИмяТипа) Тогда
		ПсевдонимыПерсон = Политика.персоны;
		Если НЕ ЭтоИмя И НЕ ПолеПохожеНаИмяПерсоныLLM(ИмяПоля, "", Истина) Тогда
			Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
		КонецЕсли;
		Если ПустаяСтрока(UUID) Тогда
			Возврат ПсевдонимыПерсон.hidden_alias;
		КонецЕсли;
		Возврат ПсевдонимПерсоныLLM(ПолноеИмяТипа, UUID, ПсевдонимыПерсон);
	КонецЕсли;

	ПсевдонимыОрганизаций = Политика.организации;
	Если НЕ ЭтоИмя И НЕ ПолеПохожеНаНазваниеОрганизацииLLM(ИмяПоля, "", Истина) Тогда
		Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
	КонецЕсли;
	Если ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимыОрганизаций.hidden_alias;
	КонецЕсли;
	Возврат ПсевдонимОрганизацииLLM(ПолноеИмяТипа, UUID, ПсевдонимыОрганизаций.prefix);

КонецФункции

Функция ПредставлениеЖесткоЗакрытоPrivacy(ПолноеИмяТипа) Экспорт

	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	ЗаписьАлиаса = MCP_Config.ПсевдонимыТиповLLM().entries.Получить(НормТип);
	Если ЗаписьАлиаса <> Неопределено И ЗаписьАлиаса.mode = "deny" Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаписьМаски = MCP_Config.МаскиПолейТиповLLM().entries.Получить(НормТип);
	Если ЗаписьМаски <> Неопределено
		И ЗаписьМаски.mode = "deny"
		И ЗаписьМаски.mask_presentation Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Платформенные имя-подобные поля для жёсткого запрета. Представление —
// не поле метаданных, но слово ПРЕДСТАВЛЕНИЕ в тексте закрывает и функцию
// ПРЕДСТАВЛЕНИЕ() над закрытым источником (грубое приближение HR-04).
Процедура ДобавитьИмяПодобныеПоляPrivacy(Индекс)

	Индекс.Вставить("Наименование", Истина);
	Индекс.Вставить("НаименованиеПолное", Истина);
	Индекс.Вставить("ПолноеНаименование", Истина);
	Индекс.Вставить("КраткоеНаименование", Истина);
	Индекс.Вставить("Код", Истина);
	Индекс.Вставить("Представление", Истина);

КонецПроцедуры

// Типы, которые анонимизирует легаси-механизм организаций и персон.
// privacy.type_aliases для них отклоняется: второй псевдоним перезатирал
// бы уже выданный легаси-код, нарушая стабильность кодов между ответами.
Функция ТипПокрытЛегасиПсевдонимамиLLM(ПолноеИмяТипа) Экспорт

	Возврат ЭтоТипОрганизацииLLM(ПолноеИмяТипа)
		ИЛИ ЭтоТипПерсоныLLM(ПолноеИмяТипа);

КонецФункции

Функция ПсевдонимОрганизацииLLM(ТипСсылки, UUID, Prefix)

	Возврат Prefix + КодПсевдонимаLLM(ТипСсылки, UUID);

КонецФункции

Функция КодПсевдонимаLLM(ТипСсылки, UUID)

	Текст = ВРег(СокрЛП(Строка(ТипСсылки))) + "|" + ВРег(СокрЛП(Строка(UUID)));
	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Хеш = Хеш * 33 + КодСимвола(Сред(Текст, Позиция, 1));
		Хеш = Хеш - Цел(Хеш / 1000000) * 1000000;
	КонецЦикла;

	Код = Строка(Хеш);
	Пока СтрДлина(Код) < 6 Цикл
		Код = "0" + Код;
	КонецЦикла;

	Возврат Код;

КонецФункции

Функция ПсевдонимПерсоныLLM(ТипСсылки, UUID, ПсевдонимыПерсон)

	Если ЭтоТипСотрудникаLLM(ТипСсылки) Тогда
		Prefix = ПсевдонимыПерсон.employee_prefix;
	ИначеЕсли ЭтоТипПользователяLLM(ТипСсылки) Тогда
		Prefix = ПсевдонимыПерсон.user_prefix;
	Иначе
		Prefix = ПсевдонимыПерсон.physical_person_prefix;
	КонецЕсли;
	Возврат Prefix + КодПсевдонимаLLM(ТипСсылки, UUID);

КонецФункции

Функция ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, РазрешитьОбщееНаименование)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч)
		ИЛИ ПолеПохожеНаТехническийКлючОрганизацииLLM(НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если РазрешитьОбщееНаименование
		И (НормКлюч = "name"
			ИЛИ НормКлюч = "presentation"
			ИЛИ СтрНайти(НормКлюч, "наименование") > 0
			ИЛИ СтрНайти(НормКлюч, "fullname") > 0
			ИЛИ СтрНайти(НормКлюч, "fulltitle") > 0) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормКлюч, "organization") > 0
		ИЛИ СтрНайти(НормКлюч, "организац") > 0
		ИЛИ СтрНайти(НормПуть, "organizationname") > 0
		ИЛИ СтрНайти(НормПуть, "организациянаименование") > 0
		ИЛИ СтрНайти(НормПуть, "наименованиеорганизац") > 0;

КонецФункции

Функция ПолеПохожеНаТехническийКлючОрганизацииLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "uuid") > 0
		ИЛИ СтрНайти(НормИмя, "идентификатор") > 0
		ИЛИ СтрНайти(НормИмя, "navigationurl") > 0
		ИЛИ СтрНайти(НормИмя, "url") > 0
		ИЛИ СтрНайти(НормИмя, "ref") > 0
		ИЛИ СтрНайти(НормИмя, "ссылка") > 0
		ИЛИ СтрНайти(НормИмя, "type") > 0
		ИЛИ СтрНайти(НормИмя, "тип") > 0
		ИЛИ СтрНайти(НормИмя, "inn") > 0
		ИЛИ СтрНайти(НормИмя, "инн") > 0
		ИЛИ СтрНайти(НормИмя, "kpp") > 0
		ИЛИ СтрНайти(НормИмя, "кпп") > 0;

КонецФункции

Функция ПолеНужноМаскироватьПерсональныеДанныеLLM(Ключ, Путь, ПсевдонимыПерсон, ПсевдонимПерсоны)

	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат Ложь;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Истина) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПолеПохожеНаПаспортныеДанныеLLM(НормКлюч)
		ИЛИ ПолеПохожеНаПаспортныеДанныеLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаПерсональныйНомерLLM(НормКлюч)
		ИЛИ ПолеПохожеНаПерсональныйНомерLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаСтраховойНомерLLM(НормКлюч)
		ИЛИ ПолеПохожеНаСтраховойНомерLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаДатуРожденияLLM(НормКлюч)
		ИЛИ ПолеПохожеНаДатуРожденияLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, РазрешитьОбщееИмя)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч)
		ИЛИ ПолеПохожеНаТехническийКлючОрганизацииLLM(НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НормКлюч = "фио"
		ИЛИ НормКлюч = "fullname"
		ИЛИ НормКлюч = "fulltitle"
		ИЛИ НормКлюч = "фамилия"
		ИЛИ НормКлюч = "surname"
		ИЛИ НормКлюч = "lastname"
		ИЛИ НормКлюч = "отчество"
		ИЛИ НормКлюч = "отчетство"
		ИЛИ НормКлюч = "patronymic"
		ИЛИ НормКлюч = "middlename" Тогда
		Возврат Истина;
	КонецЕсли;

	Если РазрешитьОбщееИмя
		И (НормКлюч = "name"
			ИЛИ НормКлюч = "presentation"
			ИЛИ НормКлюч = "наименование"
			ИЛИ НормКлюч = "имя") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормКлюч, "физлиц") > 0
		ИЛИ СтрНайти(НормКлюч, "физическоелиц") > 0
		ИЛИ СтрНайти(НормКлюч, "сотрудник") > 0
		ИЛИ СтрНайти(НормКлюч, "employee") > 0
		ИЛИ СтрНайти(НормКлюч, "person") > 0
		ИЛИ СтрНайти(НормПуть, "физлиц") > 0
		ИЛИ СтрНайти(НормПуть, "физическоелиц") > 0
		ИЛИ СтрНайти(НормПуть, "сотрудник") > 0
		ИЛИ СтрНайти(НормПуть, "employee") > 0
		ИЛИ СтрНайти(НормПуть, "person") > 0;

КонецФункции

Функция ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть)

	Возврат СтрНайти(НормПуть, "privacy") > 0
		ИЛИ СтрНайти(НормПуть, "personaliases") > 0
		ИЛИ СтрНайти(НормПуть, "organizationaliases") > 0
		ИЛИ НормКлюч = "personaliases"
		ИЛИ НормКлюч = "organizationaliases"
		ИЛИ СтрНайти(НормКлюч, "prefix") > 0
		ИЛИ СтрНайти(НормКлюч, "alias") > 0;

КонецФункции

Функция ПолеПохожеНаПаспортныеДанныеLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "паспорт") > 0
		ИЛИ СтрНайти(НормИмя, "passport") > 0;

КонецФункции

Функция ПолеПохожеНаПерсональныйНомерLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "индивидуальныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "идентификационныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "персональныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "personalnumber") > 0
		ИЛИ СтрНайти(НормИмя, "individualnumber") > 0
		ИЛИ СтрНайти(НормИмя, "identificationnumber") > 0
		ИЛИ СтрНайти(НормИмя, "иннфиз") > 0;

КонецФункции

Функция ПолеПохожеНаСтраховойНомерLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "страховойномер") > 0
		ИЛИ СтрНайти(НормИмя, "снилс") > 0
		ИЛИ СтрНайти(НормИмя, "snils") > 0
		ИЛИ СтрНайти(НормИмя, "insurancenumber") > 0;

КонецФункции

Функция ПолеПохожеНаДатуРожденияLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "датарождения") > 0
		ИЛИ СтрНайти(НормИмя, "birthday") > 0
		ИЛИ СтрНайти(НормИмя, "birthdate") > 0
		ИЛИ СтрНайти(НормИмя, "dateofbirth") > 0;

КонецФункции

Функция ЭтоJSONОбъект(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ПолеОбъекта(Объект, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Для Каждого КЗ Из Объект Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ВРег(Имя) Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Для Каждого КЗ Из Объект Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ВРег(Имя) Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолеТехническихМетаданныхLLM(Ключ, Путь)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если НормКлюч = "type"
		ИЛИ НормКлюч = "тип"
		ИЛИ НормКлюч = "kind"
		ИЛИ НормКлюч = "вид"
		ИЛИ НормКлюч = "fullname"
		ИЛИ НормКлюч = "qualifiedname"
		ИЛИ НормКлюч = "typedescription"
		ИЛИ НормКлюч = "valuetypes"
		ИЛИ НормКлюч = "querytable"
		ИЛИ НормКлюч = "resourceuri"
		ИЛИ НормКлюч = "register"
		ИЛИ НормКлюч = "registertype"
		ИЛИ НормКлюч = "accountingregister"
		ИЛИ НормКлюч = "chart"
		ИЛИ НормКлюч = "plan"
		ИЛИ НормКлюч = "report"
		ИЛИ НормКлюч = "sourcetype"
		ИЛИ НормКлюч = "documenttype"
		ИЛИ НормКлюч = "itemtype"
		ИЛИ НормКлюч = "targettype" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормПуть, "metadata") > 0
		И (НормКлюч = "name"
			ИЛИ НормКлюч = "synonym"
			ИЛИ НормКлюч = "description"
			ИЛИ НормКлюч = "comment"
			ИЛИ НормКлюч = "presentation"
			ИЛИ НормКлюч = "category");

КонецФункции

Функция СтроковоеПоле(Объект, Имя)

	Значение = ПолеОбъекта(Объект, Имя);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ПолеНужноМаскироватьLLM(Ключ, Путь, Индекс)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	Если НЕ ПустаяСтрока(НормКлюч) И Индекс.Получить(НормКлюч) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Возврат НЕ ПустаяСтрока(НормПуть) И Индекс.Получить(НормПуть) <> Неопределено;

КонецФункции

Функция МаскаПоляДляLLM(Ключ, Значение)

	// Пустое значение остаётся пустым: маскировать нечего, а повторное
	// маскирование не должно превращать уже выданный null в XXXXXXX.
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата")
		ИЛИ ИмяПоляПохожеНаДатуLLM(Ключ)
		ИЛИ СтрокаПохожаНаДатуLLM(Значение) Тогда
		Возврат "1900-01-01T00:00:00";
	КонецЕсли;

	// Число и булево не подменяем строкой: строка в числовой колонке ломает
	// типизацию у клиента. null честно означает "значение скрыто".
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат "XXXXXXX";

КонецФункции

Функция НовыйПутьМаскированияLLM(Путь, Ключ)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат Путь + "." + Ключ;

КонецФункции

Функция НормализоватьИмяПоляДляМаскированияLLM(Имя)

	Текст = НРег(СокрЛП(Строка(Имя)));
	ПозДубликата = СтрНайти(Текст, "#");
	Если ПозДубликата > 1 Тогда
		Текст = Лев(Текст, ПозДубликата - 1);
	КонецЕсли;

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Текст = СтрЗаменить(Текст, "_", "");
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, ".", "");
	Возврат Текст;

КонецФункции

Функция ИмяПоляПохожеНаДатуLLM(Ключ)

	Текст = НРег(Строка(Ключ));
	Возврат СтрНайти(Текст, "дата") > 0
		ИЛИ СтрНайти(Текст, "date") > 0
		ИЛИ СтрНайти(Текст, "birth") > 0
		ИЛИ СтрНайти(Текст, "рожд") > 0;

КонецФункции

Функция СтрокаПохожаНаДатуLLM(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-")
		ИЛИ (Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = ".");

КонецФункции

// ---- Безопасность динамических запросов ---------------------------

Функция ИмяБезопасноДляЗапроса(Имя) Экспорт

	Имя = Строка(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Идентификатор не может начинаться с цифры.
	Первый = Лев(Имя, 1);
	КодПервого = КодСимвола(Первый);
	Если КодПервого >= КодСимвола("0") И КодПервого <= КодСимвола("9") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Имя) Цикл
		С = Сред(Имя, Позиция, 1);
		Если НЕ ЯвляетсяСимволомИдентификатора(С) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Экспорт

	ПолноеИмя = Строка(ПолноеИмя);
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз <= 1 ИЛИ Поз = СтрДлина(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(Сред(ПолноеИмя, Поз + 1), ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяБезопасноДляЗапроса(Лев(ПолноеИмя, Поз - 1))
		И ИмяБезопасноДляЗапроса(Сред(ПолноеИмя, Поз + 1));

КонецФункции

Функция ЯвляетсяСимволомИдентификатора(С)

	Если С = "_" ИЛИ С = "Ё" ИЛИ С = "ё" Тогда
		Возврат Истина;
	КонецЕсли;

	Код = КодСимвола(С);
	Возврат (Код >= КодСимвола("0") И Код <= КодСимвола("9"))
		ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
		ИЛИ (Код >= КодСимвола("a") И Код <= КодСимвола("z"))
		ИЛИ (Код >= КодСимвола("А") И Код <= КодСимвола("я"));

КонецФункции

// ---- Утилиты ------------------------------------------------------

Функция ПолучитьКонфигурациюТипа(ПолноеИмяТипа) Экспорт

	Allowlist = MCP_Config.Allowlist();
	AM = Allowlist.allowed_metadata;
	Если AM = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(AM) = Тип("Соответствие")
		ИЛИ ТипЗнч(AM) = Тип("ФиксированноеСоответствие") Тогда
		Значение = AM.Получить(ПолноеИмяТипа);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		ИскомоеИмя = ВРег(Строка(ПолноеИмяТипа));
		Для Каждого КЗ Из AM Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ИскомоеИмя Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(AM) = Тип("Структура")
		ИЛИ ТипЗнч(AM) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Если AM.Свойство(ПолноеИмяТипа, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		ИскомоеИмя = ВРег(Строка(ПолноеИмяТипа));
		Для Каждого КЗ Из AM Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ИскомоеИмя Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ПолноеИмяОбъектаИзКонтекста(ПолноеИмя) Экспорт

	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Хвост = Сред(ПолноеИмя, Поз + 1);
	ПозВторойТочки = СтрНайти(Хвост, ".");
	Если ПозВторойТочки = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Возврат Лев(ПолноеИмя, Поз + ПозВторойТочки - 1);

КонецФункции

Функция ВидМетаданныхИзПолногоИмени(ПолноеИмя) Экспорт

	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Поз - 1);

КонецФункции

Функция ИмяОбъектаИзПолногоИмени(ПолноеИмя) Экспорт

	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Сред(ПолноеИмя, Поз + 1);

КонецФункции

Функция ОграниченияДанныхОтключены(Allowlist)

	Возврат НЕ ПолучитьБулево(Allowlist, "restrict_data_access", Ложь);

КонецФункции

Функция ПолучитьМассив(Стр, ИмяСвойства)

	Если Стр = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Стр) = Тип("Структура")
		ИЛИ ТипЗнч(Стр) = Тип("ФиксированнаяСтруктура"))
		И Стр.Свойство(ИмяСвойства, Значение) Тогда
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Стр) = Тип("Соответствие")
		ИЛИ ТипЗнч(Стр) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Стр.Получить(ИмяСвойства);
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

Функция ПолучитьБулево(Стр, ИмяСвойства, ПоУмолчанию)

	Если Стр = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Стр) = Тип("Структура")
		ИЛИ ТипЗнч(Стр) = Тип("ФиксированнаяСтруктура"))
		И Стр.Свойство(ИмяСвойства, Значение) Тогда
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	ИначеЕсли ТипЗнч(Стр) = Тип("Соответствие")
		ИЛИ ТипЗнч(Стр) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Стр.Получить(ИмяСвойства);
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция ИмяТекущегоПользователя() Экспорт

	Попытка
		ТП = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТП = Неопределено Тогда
			Возврат "system";
		КонецЕсли;
		Возврат ТП.Имя;
	Исключение
		Возврат "unknown";
	КонецПопытки;

КонецФункции

Функция НормализоватьURLДляСравнения(URL)

	URL = СокрЛП(Строка(URL));
	Пока СтрДлина(URL) > СтрДлина("https://") И Прав(URL, 1) = "/" Цикл
		URL = Лев(URL, СтрДлина(URL) - 1);
	КонецЦикла;
	Возврат URL;

КонецФункции
