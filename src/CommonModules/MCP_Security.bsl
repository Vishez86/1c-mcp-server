Функция НормализоватьURLДляСравнения(URL)

	URL = СокрЛП(Строка(URL));
	Пока СтрДлина(URL) > СтрДлина("https://") И Прав(URL, 1) = "/" Цикл
		URL = Лев(URL, СтрДлина(URL) - 1);
	КонецЦикла;
	Возврат URL;

КонецФункции
