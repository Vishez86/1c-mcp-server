// MCP_Security.bsl
// ====================================================================
// Слой безопасности MCP-сервера.
// Проверяет allowlist/denylist типов и полей, права 1С и роль администратора MCP.
// ====================================================================

// ---- Тип / Вид ------------------------------------------------------

Функция ТипРазрешен(ПолноеИмяТипа) Экспорт

	Allowlist = MCP_Config.Allowlist();

	// Denied list.
	Для Каждого ЗапрещенныйТип Из Allowlist.denied_objects Цикл
		Если ВРег(ЗапрещенныйТип) = ВРег(ПолноеИмяТипа) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	// Если есть explicit разрешение.
	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа <> Неопределено Тогда
		Если КонфигТипа.Свойство("read") И ТипЗнч(КонфигТипа.read) = Тип("Булево") И КонфигТипа.read Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	// Default policy.
	Если ВРег(Allowlist.default_policy) = "ALLOW" Тогда
		// Проверим, что вид метаданных в allowed_kinds.
		Вид = ВидМетаданныхИзПолногоИмени(ПолноеИмяТипа);
		Для Каждого РазрешенныйВид Из Allowlist.allowed_kinds Цикл
			Если ВРег(РазрешенныйВид) = ВРег(Вид) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ВидРазрешен(Вид) Экспорт

	Allowlist = MCP_Config.Allowlist();
	Для Каждого Р Из Allowlist.allowed_kinds Цикл
		Если ВРег(Р) = ВРег(Вид) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Поля ----------------------------------------------------------

Функция ПолеРазрешено(ПолноеИмяТипа, ИмяПоля) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат ТипРазрешен(ПолноеИмяТипа);
	КонецЕсли;

	HiddenFields = ПолучитьМассив(КонфигТипа, "hidden_fields");
	Для Каждого H Из HiddenFields Цикл
		Если ВРег(H) = ВРег(ИмяПоля) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПоляПоискаПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат ПоляПоискаЗаглушка(ПолноеИмяТипа);
	КонецЕсли;

	Возврат ПолучитьМассив(КонфигТипа, "search_fields");

КонецФункции

Функция ПоляПоискаЗаглушка(ПолноеИмяТипа)

	Массив = Новый Массив;
	Если СтрНачинаетсяС(ПолноеИмяТипа, "Справочник.") Тогда
		Массив.Добавить("Код");
		Массив.Добавить("Наименование");
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяТипа, "Документ.") Тогда
		Массив.Добавить("Номер");
	КонецЕсли;
	Возврат Массив;

КонецФункции

Функция ПоляПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "default_fields");

КонецФункции

Функция СкрытыеПоля(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "hidden_fields");

КонецФункции

// ---- Tools ---------------------------------------------------------

Функция ToolРазрешен(ИмяТула, Контекст = Неопределено) Экспорт

	// Все 17 tools по умолчанию доступны, но некоторые опции — только админу MCP.
	Возврат Истина;

КонецФункции

Функция ЯвляетсяАдминомMCP() Экспорт

	Имя = ИмяТекущегоПользователя();
	Allowlist = MCP_Config.Allowlist();
	Для Каждого A Из Allowlist.admin_users Цикл
		Если ВРег(A) = ВРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- BaseURL ------------------------------------------------------

Функция BaseURLРазрешен(BaseURL) Экспорт

	Если ПустаяСтрока(BaseURL) Тогда
		Возврат Истина;
	КонецЕсли;

	Allowlist = MCP_Config.Allowlist();
	Для Каждого ДопустимыйURL Из Allowlist.allowed_base_urls Цикл
		Если СтрНачинаетсяС(ВРег(BaseURL), ВРег(ДопустимыйURL)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Утилиты ------------------------------------------------------

Функция ПолучитьКонфигурациюТипа(ПолноеИмяТипа) Экспорт

	Allowlist = MCP_Config.Allowlist();
	AM = Allowlist.allowed_metadata;
	Если AM = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(AM) = Тип("Соответствие") Тогда
		Возврат AM.Получить(ПолноеИмяТипа);
	КонецЕсли;
	Если ТипЗнч(AM) = Тип("Структура") И AM.Свойство(ПолноеИмяТипа) Тогда
		Возврат AM[ПолноеИмяТипа];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ВидМетаданныхИзПолногоИмени(ПолноеИмя) Экспорт

	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Поз - 1);

КонецФункции

Функция ИмяОбъектаИзПолногоИмени(ПолноеИмя) Экспорт

	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Сред(ПолноеИмя, Поз + 1);

КонецФункции

Функция ПолучитьМассив(Стр, ИмяСвойства)

	Если Стр = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Стр) = Тип("Структура") И Стр.Свойство(ИмяСвойства, Значение) Тогда
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Стр) = Тип("Соответствие") Тогда
		Значение = Стр.Получить(ИмяСвойства);
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

Функция ИмяТекущегоПользователя() Экспорт

	Попытка
		ТП = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТП = Неопределено Тогда
			Возврат "system";
		КонецЕсли;
		Возврат ТП.Имя;
	Исключение
		Возврат "unknown";
	КонецПопытки;

КонецФункции

Функция СтрНачинаетсяС(Знач Строка, Знач Префикс)
	Если СтрДлина(Строка) < СтрДлина(Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Лев(Строка, СтрДлина(Префикс)) = Префикс;
КонецФункции
