// MCP_Security.bsl
// ====================================================================
// Слой безопасности MCP-сервера.
// Проверяет allowlist/denylist типов и полей, права 1С и роль администратора MCP.
// ====================================================================

// ---- Тип / Вид ------------------------------------------------------

Функция ТипРазрешен(ПолноеИмяТипа) Экспорт

	Возврат ДоступКТипу(ПолноеИмяТипа).allowed;

КонецФункции

Функция ДоступКТипу(ПолноеИмяТипа, Операция = "read") Экспорт

	Результат = РезультатДоступа(Ложь, MCP_Errors.Код_TypeNotAllowed(),
		"mcp_type_not_allowed", "Тип запрещён политикой MCP: " + Строка(ПолноеИмяТипа),
		ПолноеИмяТипа, Операция);

	Если НЕ ПолноеИмяБезопасноДляЗапроса(ПолноеИмяТипа) Тогда
		Результат.code = MCP_Errors.Код_InvalidArguments();
		Результат.reason_code = "invalid_type_name";
		Результат.message = "Некорректное имя типа: " + Строка(ПолноеИмяТипа);
		Возврат Результат;
	КонецЕсли;

	Если НЕ ТипРазрешенПолитикойMCP(ПолноеИмяТипа) Тогда
		Возврат Результат;
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
	Если ОМД = Неопределено Тогда
		Результат.code = MCP_Errors.Код_MetadataNotFound();
		Результат.reason_code = "metadata_not_found";
		Результат.message = "Объект метаданных не найден: " + ПолноеИмяТипа;
		Возврат Результат;
	КонецЕсли;

	Право = ПравоДоступаДляТипа(ПолноеИмяТипа, Операция);
	Если НЕ ПустаяСтрока(Право) Тогда
		Попытка
			Если НЕ ПравоДоступа(Право, ОМД) Тогда
				Результат.code = MCP_Errors.Код_AccessDenied();
				Результат.reason_code = "1c_access_denied";
				Результат.message = "Недостаточно прав 1С на " + Право + ": " + ПолноеИмяТипа;
				Результат.platform_right = Право;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
				Результат.code = MCP_Errors.Код_AccessDenied();
				Результат.reason_code = "1c_access_denied";
				Результат.message = "Недостаточно прав 1С на " + Право + ": " + ПолноеИмяТипа;
				Результат.platform_right = Право;
				Результат.platform_message = ОписаниеОшибки();
				Возврат Результат;
			КонецЕсли;
			// Если конкретная платформа/тип метаданных не поддерживает ПравоДоступа,
			// не блокируем discovery: фактическая операция всё равно поймает отказ.
		КонецПопытки;
	КонецЕсли;

	Результат.allowed = Истина;
	Результат.code = "";
	Результат.reason_code = "";
	Результат.message = "";
	Возврат Результат;

КонецФункции

Процедура ПроверитьДоступКТипу(ПолноеИмяТипа, Операция = "read") Экспорт

	Доступ = ДоступКТипу(ПолноеИмяТипа, Операция);
	Если Доступ.allowed Тогда
		Возврат;
	КонецЕсли;

	Если Доступ.code = MCP_Errors.Код_InvalidArguments()
		ИЛИ Доступ.code = MCP_Errors.Код_MetadataNotFound() Тогда
		Детали = Новый Структура;
		Детали.Вставить("type", Доступ.type);
		Детали.Вставить("operation", Доступ.operation);
		MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, Детали);
	КонецЕсли;

	MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, ДеталиОтказаДоступа(Доступ));

КонецПроцедуры

Функция ТипРазрешенПолитикойMCP(ПолноеИмяТипа)

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	// Denied list.
	Для Каждого ЗапрещенныйТип Из Allowlist.denied_objects Цикл
		Если ВРег(Строка(ЗапрещенныйТип)) = ВРег(ПолноеИмяТипа) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	// Если есть explicit разрешение.
	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа <> Неопределено Тогда
		Возврат ПолучитьБулево(КонфигТипа, "read", Ложь);
	КонецЕсли;

	// Default policy.
	Если ВРег(Allowlist.default_policy) = "ALLOW" Тогда
		// Проверим, что вид метаданных в allowed_kinds.
		Вид = ВидМетаданныхИзПолногоИмени(ПолноеИмяТипа);
		Для Каждого РазрешенныйВид Из Allowlist.allowed_kinds Цикл
			Если ВРег(РазрешенныйВид) = ВРег(Вид) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция РезультатДоступа(Allowed, Код, ReasonCode, Сообщение, ПолноеИмяТипа, Операция)

	Результат = Новый Структура;
	Результат.Вставить("allowed", Allowed);
	Результат.Вставить("code", Код);
	Результат.Вставить("reason_code", ReasonCode);
	Результат.Вставить("message", Сообщение);
	Результат.Вставить("type", Строка(ПолноеИмяТипа));
	Результат.Вставить("operation", Строка(Операция));
	Результат.Вставить("platform_right", "");
	Результат.Вставить("platform_message", "");
	Возврат Результат;

КонецФункции

Функция ДеталиОтказаДоступа(Доступ) Экспорт

	Авторизация = Новый Структура;
	Авторизация.Вставить("reason_code", Доступ.reason_code);
	Авторизация.Вставить("denied_operation", Доступ.operation);
	Авторизация.Вставить("denied_type", Доступ.type);
	Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	Если НЕ ПустаяСтрока(Доступ.platform_right) Тогда
		Авторизация.Вставить("platform_right", Доступ.platform_right);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Доступ.platform_message) Тогда
		Авторизация.Вставить("platform_message", Доступ.platform_message);
	КонецЕсли;

	Детали = Новый Структура;
	Детали.Вставить("authorization", Авторизация);
	Детали.Вставить("type", Доступ.type);
	Детали.Вставить("operation", Доступ.operation);
	Возврат Детали;

КонецФункции

Функция ПравоДоступаДляТипа(ПолноеИмяТипа, Операция)

	Вид = ВидМетаданныхИзПолногоИмени(ПолноеИмяТипа);
	Если Вид = "Отчет" ИЛИ Вид = "Обработка" Тогда
		Возврат "Использование";
	КонецЕсли;
	Возврат "Чтение";

КонецФункции

Функция ВидРазрешен(Вид) Экспорт

	Allowlist = MCP_Config.Allowlist();
	Для Каждого Р Из Allowlist.allowed_kinds Цикл
		Если ВРег(Р) = ВРег(Вид) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Поля ----------------------------------------------------------

Функция ПолеРазрешено(ПолноеИмяТипа, ИмяПоля) Экспорт

	ПроверяемыйТип = ПолноеИмяОбъектаИзКонтекста(ПолноеИмяТипа);

	// HR-05, страховочный слой: жёсткий запрет privacy действует независимо от
	// allowlist и покрывает все точки, которые спрашивают разрешение поля —
	// отборы и сортировки регистров, списки полей, измерения и ресурсы. Явную
	// диагностику отказа выдаёт gate инструментов (ЗапретPrivacyДляИнструмента),
	// здесь важно, чтобы закрытое поле не дошло до запроса ни одним путём.
	Если ЕстьЖесткиеЗапретыPrivacy()
		И ПолеЖесткоЗакрытоPrivacy(ПроверяемыйТип, ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат ТипРазрешен(ПроверяемыйТип);
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПроверяемыйТип);
	Если КонфигТипа = Неопределено Тогда
		Возврат ТипРазрешен(ПроверяемыйТип);
	КонецЕсли;

	КонтекстныйПуть = "";
	Если ВРег(ПолноеИмяТипа) <> ВРег(ПроверяемыйТип) Тогда
		КонтекстныйПуть = Сред(ПолноеИмяТипа, СтрДлина(ПроверяемыйТип) + 2) + "." + ИмяПоля;
	КонецЕсли;

	HiddenFields = ПолучитьМассив(КонфигТипа, "hidden_fields");
	Для Каждого H Из HiddenFields Цикл
		Если ВРег(H) = ВРег(ИмяПоля)
			ИЛИ (НЕ ПустаяСтрока(КонтекстныйПуть) И ВРег(H) = ВРег(КонтекстныйПуть)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПоляПоискаПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат ПоляПоискаЗаглушка(ПолноеИмяТипа);
	КонецЕсли;

	Возврат ПолучитьМассив(КонфигТипа, "search_fields");

КонецФункции

Функция ПоляПоискаЗаглушка(ПолноеИмяТипа)

	Массив = Новый Массив;
	Если СтрНачинаетсяС(ПолноеИмяТипа, "Справочник.") Тогда
		Массив.Добавить("Код");
		Массив.Добавить("Наименование");
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяТипа, "Документ.") Тогда
		Массив.Добавить("Номер");
	КонецЕсли;
	Возврат Массив;

КонецФункции

Функция ПоляПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "default_fields");

КонецФункции

Функция СкрытыеПоля(ПолноеИмяТипа) Экспорт

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "hidden_fields");

КонецФункции

// ---- Tools ---------------------------------------------------------

Функция ToolРазрешен(ИмяТула, Контекст = Неопределено) Экспорт

	// Все read-only tools по умолчанию доступны, но некоторые опции — только админу MCP.
	Возврат Истина;

КонецФункции

Функция ВариантОтчетаРазрешен(ПолноеИмяОтчета, Вариант) Экспорт

	Если НЕ ТипРазрешен(ПолноеИмяОтчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяОтчета);
	Если КонфигТипа = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	AllowedVariants = ПолучитьМассив(КонфигТипа, "allowed_variants");
	Если AllowedVariants.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяВарианта = "";
	Если Вариант <> Неопределено И Вариант <> Null Тогда
		ИмяВарианта = Строка(Вариант);
	КонецЕсли;
	Если ПустаяСтрока(ИмяВарианта) Тогда
		ИмяВарианта = "Основной";
	КонецЕсли;

	Для Каждого РазрешенныйВариант Из AllowedVariants Цикл
		Если Строка(РазрешенныйВариант) = "*"
			ИЛИ ВРег(Строка(РазрешенныйВариант)) = ВРег(ИмяВарианта) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЯвляетсяАдминомMCP() Экспорт

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	Имя = ИмяТекущегоПользователя();
	Для Каждого A Из Allowlist.admin_users Цикл
		Если ВРег(A) = ВРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- BaseURL ------------------------------------------------------

Функция BaseURLРазрешен(BaseURL) Экспорт

	Если ПустаяСтрока(BaseURL) Тогда
		Возврат Истина;
	КонецЕсли;

	НормСхема = НРег(СокрЛП(Строка(BaseURL)));
	Если НЕ СтрНачинаетсяС(НормСхема, "https://")
		И НЕ СтрНачинаетсяС(НормСхема, "http://") Тогда
		Возврат Ложь;
	КонецЕсли;

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	НормBaseURL = ВРег(НормализоватьURLДляСравнения(BaseURL));
	Для Каждого ДопустимыйURL Из Allowlist.allowed_base_urls Цикл
		НормДопустимыйURL = ВРег(НормализоватьURLДляСравнения(ДопустимыйURL));
		Если ПустаяСтрока(НормДопустимыйURL) Тогда
			Продолжить;
		КонецЕсли;
		Если НормBaseURL = НормДопустимыйURL
			ИЛИ СтрНачинаетсяС(НормBaseURL, НормДопустимыйURL + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Маскирование данных для LLM -----------------------------------

Функция МаскироватьПоляДляLLM(Значение) Экспорт

	Поля = MCP_Config.ПоляМаскированияLLM();
	ПсевдонимыОрганизаций = MCP_Config.ПсевдонимыОрганизацийLLM();
	ПсевдонимыПерсон = MCP_Config.ПсевдонимыПерсонLLM();
	ПсевдонимыТипов = MCP_Config.ПсевдонимыТиповLLM();
	МаскиТипов = MCP_Config.МаскиПолейТиповLLM();

	Индекс = ИндексПоляМаскированияLLM(Поля);
	Если Индекс.Количество() = 0
		И НЕ ПсевдонимыОрганизаций.enabled
		И НЕ ПсевдонимыПерсон.enabled
		И НЕ ПсевдонимыТипов.enabled
		И НЕ МаскиТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("индекс", Индекс);
	Настройки.Вставить("организации", ПсевдонимыОрганизаций);
	Настройки.Вставить("персоны", ПсевдонимыПерсон);
	Настройки.Вставить("типы", ПсевдонимыТипов);
	Настройки.Вставить("маски_типов", МаскиТипов);
	// Префиксы собираются один раз на вызов: проверка «значение уже подменено»
	// идёт на каждое поле каждой строки, и сборка массива внутри неё стоила бы
	// столько же обходов политики, сколько в ответе полей.
	Настройки.Вставить("префиксы_подстановок", Новый Массив);
	ЗаполнитьПрефиксыПодстановокPrivacy(Настройки);

	Возврат МаскироватьПоляДляLLMРекурсивно(
		Значение, Настройки, "", КонтекстМаскированияLLM("", "", "", ""));

КонецФункции

// Значение уже подменено при сборке строк результата (M-03.4) — трогать его
// нельзя. Форма проверяется строго: «начинается с префикса» недостаточно, иначе
// под защиту попало бы настоящее наименование, начинающееся так же. Код
// псевдонима — 8 разрядов base36 у типов и 6 цифр у легаси-псевдонимов персон и
// организаций; кроме кодов подстановками являются hidden_alias и обычные маски.
Функция ЗначениеУжеПодмененоPrivacy(Значение, Настройки) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Значение = "XXXXXXX" ИЛИ Значение = "1900-01-01T00:00:00" Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Префикс Из Настройки.префиксы_подстановок Цикл
		Если ПустаяСтрока(Префикс) ИЛИ Лев(Значение, СтрДлина(Префикс)) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Значение, СтрДлина(Префикс) + 1);
		Если Остаток = "скрыто" Тогда
			Возврат Истина;
		КонецЕсли;
		Если (СтрДлина(Остаток) = 8 ИЛИ СтрДлина(Остаток) = 6)
			И ЭтоКодПсевдонимаPrivacy(Остаток) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Префиксы всех включённых секций подстановок — один раз на вызов.
Процедура ЗаполнитьПрефиксыПодстановокPrivacy(Настройки)

	Результат = Настройки.префиксы_подстановок;

	Если Настройки.типы.enabled Тогда
		Для Каждого КЗ Из Настройки.типы.entries Цикл
			Результат.Добавить(КЗ.Значение.prefix);
		КонецЦикла;
	КонецЕсли;
	Если Настройки.персоны.enabled Тогда
		Результат.Добавить(Настройки.персоны.physical_person_prefix);
		Результат.Добавить(Настройки.персоны.employee_prefix);
		Результат.Добавить(Настройки.персоны.user_prefix);
	КонецЕсли;
	Если Настройки.организации.enabled Тогда
		Результат.Добавить(Настройки.организации.prefix);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоКодПсевдонимаPrivacy(Текст)

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Алфавит, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция ИндексПоляМаскированияLLM(Поля)

	Индекс = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		НормИмя = НормализоватьИмяПоляДляМаскированияLLM(Поле);
		Если НЕ ПустаяСтрока(НормИмя) Тогда
			Индекс.Вставить(НормИмя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Функция МаскироватьПоляДляLLMРекурсивно(Значение, Настройки, Путь, Контекст)

	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			РезультатМассив.Добавить(МаскироватьПоляДляLLMРекурсивно(
				Элемент, Настройки, Путь, Контекст));
		КонецЦикла;
		Возврат РезультатМассив;
	КонецЕсли;

	ЭтоСтруктура = (ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура"));
	ЭтоСоответствие = (ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие"));
	Если НЕ ЭтоСтруктура И НЕ ЭтоСоответствие Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСтруктура Тогда
		Результат = Новый Структура;
	Иначе
		Результат = Новый Соответствие;
	КонецЕсли;

	// Контекст объекта: псевдонимы организации/персоны, полное имя типа и
	// псевдоним этого типа. Ссылка другого типа контекст родителя сбрасывает,
	// иначе поля вложенного объекта получили бы чужой псевдоним.
	КонтекстОбъекта = КонтекстОбъектаМаскированияLLM(Значение, Настройки, Контекст);
	ЭтоСсылкаОрганизации = Настройки.организации.enabled И СтруктураЭтоСсылкаОрганизации(Значение);
	ЭтоСсылкаПерсоны = Настройки.персоны.enabled И СтруктураЭтоСсылкаПерсоны(Значение);
	ЭтоСсылкаТипаПсевдонима = СтруктураЭтоСсылкаТипаПсевдонимаLLM(Значение, Настройки.типы);

	Для Каждого КЗ Из Значение Цикл
		Ключ = Строка(КЗ.Ключ);
		НовыйПуть = НовыйПутьМаскированияLLM(Путь, Ключ);
		Если ПолеТехническихМетаданныхLLM(Ключ, НовыйПуть) Тогда
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли ЗначениеУжеПодмененоPrivacy(КЗ.Значение, Настройки) Тогда
			// Значение уже подменено при сборке строк запроса (M-03.4), и код в нём
			// принадлежит владельцу поля. Здесь контекст строки берётся первой
			// найденной ссылкой настроенного типа и может быть ДРУГИМ объектом:
			// маскировщики ниже перезаписали бы код чужим, и клиент соединил бы
			// разные объекты в один. Проверка стоит до всего ветвления — маска по
			// типу и маска по имени поля идут выше псевдонимов и затирают код так же.
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли ПолеНужноМаскироватьLLM(Ключ, НовыйПуть, Настройки.индекс)
			ИЛИ ПолеНужноМаскироватьПерсональныеДанныеLLM(
				Ключ, НовыйПуть, Настройки.персоны, КонтекстОбъекта.персона) Тогда
			Результат.Вставить(Ключ, МаскаПоляДляLLM(Ключ, КЗ.Значение));
		ИначеЕсли ПолеНужноМаскироватьПоТипуLLM(
			Ключ, НовыйПуть, КонтекстОбъекта.тип, Настройки.маски_типов) Тогда
			Результат.Вставить(Ключ, МаскаПоляТипаДляLLM(Ключ, КЗ.Значение, КонтекстОбъекта));
		Иначе
			ЗначениеПоля = МаскироватьПоляДляLLMРекурсивно(
				КЗ.Значение, Настройки, НовыйПуть, КонтекстОбъекта);
			// Маска по имени типа идёт первой, псевдонимы ниже её перекрывают:
			// код информативнее XXXXXXX, а порядок делает результат
			// идемпотентным (повторное маскирование не меняет значение).
			ЗначениеПоля = МаскироватьПоИмениТипаМаскиLLM(
				Ключ, НовыйПуть, ЗначениеПоля, Настройки.маски_типов);
			ЗначениеПоля = МаскироватьОрганизациюДляLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.организация,
				ЭтоСсылкаОрганизации, Настройки.организации);
			ЗначениеПоля = МаскироватьПерсонуДляLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.персона,
				ЭтоСсылкаПерсоны, Настройки.персоны);
			ЗначениеПоля = МаскироватьПоПсевдонимуТипаLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.псевдоним_типа,
				ЭтоСсылкаТипаПсевдонима, Настройки.типы);
			Результат.Вставить(Ключ, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КонтекстМаскированияLLM(ПсевдонимОрганизации, ПсевдонимПерсоны, ТипОбъекта, ПсевдонимТипа)

	Контекст = Новый Структура;
	Контекст.Вставить("организация", ПсевдонимОрганизации);
	Контекст.Вставить("персона", ПсевдонимПерсоны);
	Контекст.Вставить("тип", ТипОбъекта);
	Контекст.Вставить("псевдоним_типа", ПсевдонимТипа);
	Возврат Контекст;

КонецФункции

Функция КонтекстОбъектаМаскированияLLM(Значение, Настройки, Контекст)

	Возврат КонтекстМаскированияLLM(
		ПсевдонимОрганизацииДляОбъекта(Значение, Настройки.организации, Контекст.организация),
		ПсевдонимПерсоныДляОбъекта(Значение, Настройки.персоны, Контекст.персона),
		ТипОбъектаДляМаскированияLLM(Значение, Настройки, Контекст.тип),
		ПсевдонимТипаДляОбъекта(Значение, Настройки.типы, Контекст.псевдоним_типа));

КонецФункции

Функция МаскироватьОрганизациюДляLLM(Ключ, Путь, Значение, ПсевдонимОрганизации, ЭтоСсылкаОрганизации, ПсевдонимыОрганизаций)

	Если НЕ ПсевдонимыОрганизаций.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСсылкаОрганизации И НормализоватьИмяПоляДляМаскированияLLM(Ключ) = "presentation" Тогда
		Возврат ПсевдонимОрганизации;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимОрганизации)
		И ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, Истина) Тогда
		Возврат ПсевдонимОрганизации;
	КонецЕсли;

	Если ПустаяСтрока(ПсевдонимОрганизации)
		И ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, Ложь) Тогда
		Возврат ПсевдонимыОрганизаций.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция МаскироватьПерсонуДляLLM(Ключ, Путь, Значение, ПсевдонимПерсоны, ЭтоСсылкаПерсоны, ПсевдонимыПерсон)

	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСсылкаПерсоны И НормализоватьИмяПоляДляМаскированияLLM(Ключ) = "presentation" Тогда
		Возврат ПсевдонимПерсоны;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Истина) Тогда
		Возврат ПсевдонимПерсоны;
	КонецЕсли;

	Если ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Ложь) Тогда
		Возврат ПсевдонимыПерсон.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПсевдонимОрганизацииДляОбъекта(Значение, ПсевдонимыОрганизаций, ПсевдонимОрганизации)

	Если НЕ ПсевдонимыОрганизаций.enabled Тогда
		Возврат "";
	КонецЕсли;

	Если СтруктураЭтоСсылкаДругогоТипа(Значение) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимОрганизацииLLM(ТипСсылки, UUID, ПсевдонимыОрганизаций.prefix);
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "ref", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "Организация", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "organization", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	Возврат ПсевдонимОрганизации;

КонецФункции

Функция ПсевдонимПерсоныДляОбъекта(Значение, ПсевдонимыПерсон, ПсевдонимПерсоны)

	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат "";
	КонецЕсли;

	Если СтруктураЭтоСсылкаДругогоТипаПерсоны(Значение) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ЭтоТипПерсоныLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимПерсоныLLM(ТипСсылки, UUID, ПсевдонимыПерсон);
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимПерсоныИзПоля(Значение, "ref", ПсевдонимыПерсон);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПоляСсылок = Новый Массив;
	ПоляСсылок.Добавить("ФизическоеЛицо");
	ПоляСсылок.Добавить("ФизЛицо");
	ПоляСсылок.Добавить("ФизическиеЛица");
	ПоляСсылок.Добавить("Сотрудник");
	ПоляСсылок.Добавить("employee");
	ПоляСсылок.Добавить("person");
	ПоляСсылок.Добавить("physical_person");
	Для Каждого ИмяПоля Из ПоляСсылок Цикл
		ПсевдонимИзСсылки = ПсевдонимПерсоныИзПоля(Значение, ИмяПоля, ПсевдонимыПерсон);
		Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
			Возврат ПсевдонимИзСсылки;
		КонецЕсли;
	КонецЦикла;

	Возврат ПсевдонимПерсоны;

КонецФункции

// ---- Privacy по типам (privacy.type_aliases / privacy.type_field_masks) ----

// Полное имя типа текущего объекта. Порядок источников: сам объект — ссылка,
// объект содержит ссылку в "ref", объект — результат по регистру ("register").
// Если ничего не нашлось, наследуется тип родителя: поля и строки объекта
// принадлежат тому же типу, что и сам объект.
Функция ТипОбъектаДляМаскированияLLM(Значение, Настройки, ТипРодителя)

	Если НЕ Настройки.типы.enabled И НЕ Настройки.маски_типов.enabled Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если НЕ ПустаяСтрока(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ТипСсылки;
	КонецЕсли;

	// Ключи-носители контекста — из собственного JSON-контракта сервера, а не из
	// конкретной конфигурации: register у get_register_records и
	// get_document_movements, accounting_register у бухгалтерских инструментов,
	// ref/target/item у объектных.
	ИменаРегистра = Новый Массив;
	ИменаРегистра.Добавить("register");
	ИменаРегистра.Добавить("accounting_register");
	Для Каждого ИмяПоля Из ИменаРегистра Цикл
		ИмяРегистра = СтроковоеПоле(Значение, ИмяПоля);
		Если СтрНайти(ИмяРегистра, ".") > 0 Тогда
			Возврат СокрЛП(ИмяРегистра);
		КонецЕсли;
	КонецЦикла;

	ИменаСсылки = Новый Массив;
	ИменаСсылки.Добавить("ref");
	ИменаСсылки.Добавить("target");
	ИменаСсылки.Добавить("item");
	Для Каждого ИмяПоля Из ИменаСсылки Цикл
		Реф = ПолеОбъекта(Значение, ИмяПоля);
		Если НЕ ЭтоJSONОбъект(Реф) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(Реф, "type");
		UUIDРеф = СтроковоеПоле(Реф, "uuid");
		Если НЕ ПустаяСтрока(ТипРеф) И НЕ ПустаяСтрока(UUIDРеф) Тогда
			Возврат ТипРеф;
		КонецЕсли;
	КонецЦикла;

	// Строка результата run_1c_query: имя колонки со ссылкой задаёт автор
	// запроса («ВЫБРАТЬ К.Ссылка КАК Ссылка»), ключей контракта в ней нет.
	// Проверено на контуре: без этого шага маски по типу и псевдонимы к плоским
	// колонкам строки не применялись вообще, работал только ref/target/item.
	РефПоля = СсылкаИзЛюбогоПоляPrivacy(Значение,
		Настройки.маски_типов.entries, Настройки.типы.entries);
	Если РефПоля <> Неопределено Тогда
		Возврат РефПоля.type;
	КонецЕсли;

	Возврат ТипРодителя;

КонецФункции

Функция ПсевдонимТипаДляОбъекта(Значение, ПсевдонимыТипов, ПсевдонимРодителя)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если НЕ ПустаяСтрока(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		// Ссылка настроенного типа даёт свой псевдоним, ссылка любого другого
		// типа сбрасывает унаследованный.
		Возврат ПсевдонимТипаLLM(ТипСсылки, UUID, ПсевдонимыТипов);
	КонецЕсли;

	ИменаСсылки = Новый Массив;
	ИменаСсылки.Добавить("ref");
	ИменаСсылки.Добавить("target");
	ИменаСсылки.Добавить("item");
	Для Каждого ИмяПоля Из ИменаСсылки Цикл
		Реф = ПолеОбъекта(Значение, ИмяПоля);
		Если НЕ ЭтоJSONОбъект(Реф) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(Реф, "type");
		UUIDРеф = СтроковоеПоле(Реф, "uuid");
		Если НЕ ПустаяСтрока(ТипРеф) И НЕ ПустаяСтрока(UUIDРеф) Тогда
			Возврат ПсевдонимТипаLLM(ТипРеф, UUIDРеф, ПсевдонимыТипов);
		КонецЕсли;
	КонецЦикла;

	// Ключи контракта покрывают объектные ответы, но в строке run_1c_query
	// колонка со ссылкой называется так, как её назвал автор запроса (обычно
	// Ссылка). Без разбора произвольных ключей строка выборки оставалась без
	// псевдонима, и поля названия рядом со ссылкой уходили открытыми.
	РефПоля = СсылкаИзЛюбогоПоляPrivacy(Значение, ПсевдонимыТипов.entries, Неопределено);
	Если РефПоля <> Неопределено Тогда
		Возврат ПсевдонимТипаLLM(РефПоля.type, РефПоля.uuid, ПсевдонимыТипов);
	КонецЕсли;

	Возврат ПсевдонимРодителя;

КонецФункции

// Первая ссылка НАСТРОЕННОГО в политике типа среди значений произвольных
// ключей. Ссылка незакрытого типа осознанно игнорируется: строка регистра
// содержит ссылки-измерения (например Физлицо), и если бы контекст доставался
// им, строка теряла бы унаследованный от ответа тип регистра — маски полей
// регистра переставали работать. Проверено на контуре: именно так и вышло,
// когда функция возвращала первую попавшуюся ссылку.
//
// Неоднозначность при нескольких закрытых типах решается порядком обхода
// ключей — как и для ключей контракта.
Функция СсылкаИзЛюбогоПоляPrivacy(Значение, Ключи1, Ключи2)

	Для Каждого КЗ Из Значение Цикл
		Если НЕ ЭтоJSONОбъект(КЗ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(КЗ.Значение, "type");
		UUIDРеф = СтроковоеПоле(КЗ.Значение, "uuid");
		Если ПустаяСтрока(ТипРеф) ИЛИ ПустаяСтрока(UUIDРеф) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = MCP_Config.НормализоватьКлючPrivacy(ТипРеф);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Настроен = (Ключи1 <> Неопределено И Ключи1.Получить(Ключ) <> Неопределено)
			ИЛИ (Ключи2 <> Неопределено И Ключи2.Получить(Ключ) <> Неопределено);
		Если НЕ Настроен Тогда
			Продолжить;
		КонецЕсли;

		Ссылка = Новый Структура;
		Ссылка.Вставить("type", ТипРеф);
		Ссылка.Вставить("uuid", UUIDРеф);
		Возврат Ссылка;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПсевдонимТипаLLM(ТипСсылки, UUID, ПсевдонимыТипов)

	Запись = ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов);
	Если Запись = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Запись.prefix + КодПсевдонимаТипаLLM(ТипСсылки, UUID);

КонецФункции

// Код псевдонима типа: 8 символов base36 от хеша "тип|uuid". Шесть
// десятичных цифр давали бы коллизию с вероятностью ~50% уже на ~1200
// объектах одного типа. Функция отдельная: легаси-коды организаций и
// персон (6 цифр) менять нельзя — они уже выданы клиентам.
Функция КодПсевдонимаТипаLLM(ТипСсылки, UUID)

	Текст = ВРег(СокрЛП(Строка(ТипСсылки))) + "|" + ВРег(СокрЛП(Строка(UUID)));
	Модуль = 2821109907456; // 36^8
	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Хеш = Хеш * 33 + КодСимвола(Сред(Текст, Позиция, 1));
		Хеш = Хеш - Цел(Хеш / Модуль) * Модуль;
	КонецЦикла;

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Код = "";
	Для Разряд = 1 По 8 Цикл
		Остаток = Хеш - Цел(Хеш / 36) * 36;
		Код = Сред(Алфавит, Остаток + 1, 1) + Код;
		Хеш = Цел(Хеш / 36);
	КонецЦикла;

	Возврат Код;

КонецФункции

Функция ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = MCP_Config.НормализоватьКлючPrivacy(ТипСсылки);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПсевдонимыТипов.entries.Получить(Ключ);

КонецФункции

Функция СтруктураЭтоСсылкаТипаПсевдонимаLLM(Значение, ПсевдонимыТипов)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ПустаяСтрока(ТипСсылки) ИЛИ ПустаяСтрока(UUID) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов) <> Неопределено;

КонецФункции

Функция МаскироватьПоПсевдонимуТипаLLM(Ключ, Путь, Значение, ПсевдонимТипа, ЭтоСсылкаТипа, ПсевдонимыТипов)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч) Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСсылкаТипа И НормКлюч = "presentation" И НЕ ПустаяСтрока(ПсевдонимТипа) Тогда
		Возврат ПсевдонимТипа;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Если НЕ ПустаяСтрока(ПсевдонимТипа)
		И MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат ПсевдонимТипа;
	КонецЕсли;

	// Запрос вернул только строку с названием, без ссылки (частый случай:
	// в выборке рядом с Субконто1 лежит плоская колонка Контрагент). Стабильный
	// код построить не из чего, но отдавать название нельзя.
	Запись = ЗаписьТипаПоИмениПоляLLM(Ключ, Путь, ПсевдонимыТипов);
	Если Запись <> Неопределено Тогда
		Возврат Запись.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Тот же случай для конфигурации без псевдонимов: если у типа скрыто
// имя-подобное поле, плоская строка с названием этого типа тоже не должна
// уходить клиенту, иначе маска обходится одним переименованием колонки.
Функция МаскироватьПоИмениТипаМаскиLLM(Ключ, Путь, Значение, МаскиТипов)

	Если НЕ МаскиТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	// Правило рассчитано на плоскую строку с названием. Ссылку целиком прятать
	// нельзя: вместе с ней исчезли бы uuid и navigation_url для расшифровки.
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч) Тогда
		Возврат Значение;
	КонецЕсли;

	Запись = ЗаписьМаскиПоИмениПоляLLM(Ключ, Путь, МаскиТипов);
	Если Запись = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат МаскаПоляДляLLM(Ключ, Значение);

КонецФункции

Функция ЗаписьМаскиПоИмениПоляLLM(Ключ, Путь, МаскиТипов)

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если СтрНайти(НормПуть, "metadata") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Для Каждого Запись Из МаскиТипов.list Цикл
		Если НЕ Запись.mask_presentation Тогда
			// Имя объекта скрывают только те записи, где скрыто имя-подобное поле.
			Продолжить;
		КонецЕсли;
		Если ИмяПоляСоответствуетТипуLLM(КлючПоля, Запись.object_key) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	// Имя-подобный ключ с именем типа в сегменте пути (Контрагент.Наименование)
	// закрывается так же, как для псевдонимов: без этого вложенная структура
	// обходила бы маску при конфигурации из одних type_field_masks.
	Если НЕ MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(Строка(Путь), ".", Ложь);
	Для Каждого Сегмент Из Сегменты Цикл
		КлючСегмента = MCP_Config.НормализоватьКлючPrivacy(Сегмент);
		Для Каждого Запись Из МаскиТипов.list Цикл
			Если НЕ Запись.mask_presentation Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяПоляСоответствуетТипуLLM(КлючСегмента, Запись.object_key) Тогда
				Возврат Запись;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищет настроенный тип по имени поля: сначала по самому ключу, затем — для
// имя-подобного ключа — по сегментам пути (вложенная структура вида
// Контрагент.Наименование). Схему метаданных не трогаем.
Функция ЗаписьТипаПоИмениПоляLLM(Ключ, Путь, ПсевдонимыТипов)

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если СтрНайти(НормПуть, "metadata") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Для Каждого Запись Из ПсевдонимыТипов.list Цикл
		Если ИмяПоляСоответствуетТипуLLM(КлючПоля, Запись.object_key) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Если НЕ MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(Строка(Путь), ".", Ложь);
	Для Каждого Сегмент Из Сегменты Цикл
		КлючСегмента = MCP_Config.НормализоватьКлючPrivacy(Сегмент);
		Для Каждого Запись Из ПсевдонимыТипов.list Цикл
			Если ИмяПоляСоответствуетТипуLLM(КлючСегмента, Запись.object_key) Тогда
				Возврат Запись;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Имя поля считается названием объекта настроенного типа, если совпадает с
// именем объекта из конфига по достаточно длинному общему началу: колонка
// «Контрагент» относится к «Контрагенты», «КонтрагентНаименование» — тоже,
// а «Контр» уже нет. Правило работает на любой конфигурации: имя объекта
// берётся из самой privacy-настройки, а не из зашитого списка.
Функция ИмяПоляСоответствуетТипуLLM(КлючПоля, ИмяОбъекта)

	Если ПустаяСтрока(КлючПоля) ИЛИ ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ИмяОбъекта) < 5 Тогда
		// Короткое имя объекта дало бы слишком много ложных совпадений.
		Возврат Ложь;
	КонецЕсли;

	Порог = СтрДлина(ИмяОбъекта) - 3;
	Если Порог < 5 Тогда
		Порог = 5;
	КонецЕсли;
	Возврат ДлинаОбщегоНачалаLLM(КлючПоля, ИмяОбъекта) >= Порог;

КонецФункции

Функция ДлинаОбщегоНачалаLLM(Первая, Вторая)

	Предел = Мин(СтрДлина(Первая), СтрДлина(Вторая));
	Длина = 0;
	Для Позиция = 1 По Предел Цикл
		Если Сред(Первая, Позиция, 1) <> Сред(Вторая, Позиция, 1) Тогда
			Прервать;
		КонецЕсли;
		Длина = Длина + 1;
	КонецЦикла;
	Возврат Длина;

КонецФункции

Функция ПолеНужноМаскироватьПоТипуLLM(Ключ, Путь, ТипОбъекта, МаскиТипов)

	Если НЕ МаскиТипов.enabled ИЛИ ПустаяСтрока(ТипОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = МаскиТипов.entries.Получить(MCP_Config.НормализоватьКлючPrivacy(ТипОбъекта));
	Если Запись = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПустаяСтрока(НормКлюч)
		ИЛИ ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Явно перечисленное поле маскируется без дополнительных эвристик:
	// список полей задал администратор, угадывать за него нечего.
	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Если Запись.fields.Получить(КлючПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Запись.mask_presentation
		И (КлючПоля = "presentation" ИЛИ КлючПоля = "представление");

КонецФункции

Функция МаскаПоляТипаДляLLM(Ключ, Значение, КонтекстОбъекта)

	// Если для типа настроен и псевдоним, отдаём его вместо XXXXXXX: код
	// информативнее и позволяет сопоставлять строки между ответами.
	Если НЕ ПустаяСтрока(КонтекстОбъекта.псевдоним_типа)
		И MCP_Config.ПолеИмениОбъектаPrivacy(MCP_Config.НормализоватьКлючPrivacy(Ключ)) Тогда
		Возврат КонтекстОбъекта.псевдоним_типа;
	КонецЕсли;

	Возврат МаскаПоляДляLLM(Ключ, Значение);

КонецФункции

Функция ПсевдонимОрганизацииИзПоля(Объект, ИмяПоля, ПсевдонимыОрганизаций)

	ЗначениеПоля = ПолеОбъекта(Объект, ИмяПоля);
	Если НЕ ЭтоJSONОбъект(ЗначениеПоля) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(ЗначениеПоля, "type");
	UUID = СтроковоеПоле(ЗначениеПоля, "uuid");
	Если ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимОрганизацииLLM(ТипСсылки, UUID, ПсевдонимыОрганизаций.prefix);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПсевдонимПерсоныИзПоля(Объект, ИмяПоля, ПсевдонимыПерсон)

	ЗначениеПоля = ПолеОбъекта(Объект, ИмяПоля);
	Если НЕ ЭтоJSONОбъект(ЗначениеПоля) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(ЗначениеПоля, "type");
	UUID = СтроковоеПоле(ЗначениеПоля, "uuid");
	Если ЭтоТипПерсоныLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимПерсоныLLM(ТипСсылки, UUID, ПсевдонимыПерсон);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СтруктураЭтоСсылкаОрганизации(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID);

КонецФункции

Функция СтруктураЭтоСсылкаПерсоны(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат ЭтоТипПерсоныLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID);

КонецФункции

Функция СтруктураЭтоСсылкаДругогоТипа(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат НЕ ПустаяСтрока(ТипСсылки)
		И НЕ ПустаяСтрока(UUID)
		И НЕ ЭтоТипОрганизацииLLM(ТипСсылки);

КонецФункции

Функция СтруктураЭтоСсылкаДругогоТипаПерсоны(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат НЕ ПустаяСтрока(ТипСсылки)
		И НЕ ПустаяСтрока(UUID)
		И НЕ ЭтоТипПерсоныLLM(ТипСсылки);

КонецФункции

Функция ЭтоТипОрганизацииLLM(ТипСсылки)

	Возврат ВРег(СокрЛП(Строка(ТипСсылки))) = "СПРАВОЧНИК.ОРГАНИЗАЦИИ";

КонецФункции

Функция ЭтоТипПерсоныLLM(ТипСсылки)

	Возврат ЭтоТипФизическогоЛицаLLM(ТипСсылки)
		ИЛИ ЭтоТипСотрудникаLLM(ТипСсылки)
		ИЛИ ЭтоТипПользователяLLM(ТипСсылки);

КонецФункции

Функция ЭтоТипФизическогоЛицаLLM(ТипСсылки)

