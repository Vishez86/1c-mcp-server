// MCP_Config.bsl
// ====================================================================
// Конфигурация и лимиты Universal 1C MCP Server.
// Загружает allowlist и серверные лимиты из констант / по умолчанию.
// Все функции read-only и могут вызываться из любого серверного контекста.
// ====================================================================

Функция ИмяСервера() Экспорт
	Возврат "universal-1c-mcp";
КонецФункции

Функция ВерсияСервера() Экспорт
	Возврат "0.1.0";
КонецФункции

Функция ВерсияПротоколаMCP() Экспорт
	Возврат "2025-11-25";
КонецФункции

Функция ПоддерживаемыеВерсииПротоколаMCP() Экспорт

	Версии = Новый Массив;
	Версии.Добавить("2025-11-25");
	Версии.Добавить("2025-06-18");
	Версии.Добавить("2025-03-26");
	Возврат Версии;

КонецФункции

Функция ВерсияПротоколаMCPПоддерживается(Версия) Экспорт

	Для Каждого ПоддерживаемаяВерсия Из ПоддерживаемыеВерсииПротоколаMCP() Цикл
		Если Строка(ПоддерживаемаяВерсия) = Строка(Версия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СогласоватьВерсиюПротоколаMCP(ВерсияКлиента) Экспорт

	Если ВерсияКлиента <> Неопределено
		И ВерсияКлиента <> Null
		И ВерсияПротоколаMCPПоддерживается(ВерсияКлиента) Тогда
		Возврат Строка(ВерсияКлиента);
	КонецЕсли;

	Возврат ВерсияПротоколаMCP();

КонецФункции

Функция СерверReadOnly() Экспорт
	Возврат Истина;
КонецФункции

Функция LegacyFullJSONContent() Экспорт
	Возврат БулевоИзНастройки("compatibility", "legacy_full_json_content", Ложь);
КонецФункции

Функция IncludeFullAuthContextByDefault() Экспорт
	Возврат БулевоИзНастройки("response", "include_full_auth_context_by_default", Ложь);
КонецФункции

Функция ToolResultMode() Экспорт

	Режим = "text_only";
	Попытка
		JSON = НастройкиСервера();
		Response = ЗначениеJSON(JSON, "response", Неопределено);
		Если ЭтоJSONОбъект(Response) Тогда
			Режим = НРег(СокрЛП(Строка(ЗначениеJSON(Response, "tool_result_mode", Режим))));
		КонецЕсли;
	Исключение
		Режим = "text_only";
	КонецПопытки;

	Если Режим <> "text_only" И Режим <> "structured_only" И Режим <> "both" Тогда
		Режим = "text_only";
	КонецЕсли;

	Возврат Режим;

КонецФункции

Функция БулевоИзНастройки(Раздел, ИмяПоля, ПоУмолчанию)

	Попытка
		JSON = НастройкиСервера();
		Контейнер = JSON;
		Если НЕ ПустаяСтрока(Раздел) Тогда
			Контейнер = ЗначениеJSON(JSON, Раздел, Неопределено);
		КонецЕсли;
		Если ЭтоJSONОбъект(Контейнер) Тогда
			Возврат БулевоИзЗначения(ЗначениеJSON(Контейнер, ИмяПоля, ПоУмолчанию), ПоУмолчанию);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Функция РазрешенныеOriginsMCP() Экспорт

	Результат = Новый Массив;

	Попытка
		HTTP = НастройкиHTTP();
		Origins = ЗначениеJSON(HTTP, "allowed_origins", Неопределено);
		Если ТипЗнч(Origins) = Тип("Массив") Тогда
			Возврат Origins;
		КонецЕсли;
	Исключение
		// Если настройки недоступны, не блокируем server-to-server MCP-клиентов.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция БазовыйURLWebКлиента() Экспорт

	Результат = "";

	Попытка
		JSON = НастройкиСервера();
		WebClient = ЗначениеJSON(JSON, "web_client", Неопределено);
		Если ЭтоJSONОбъект(WebClient) Тогда
			BaseURL = ЗначениеJSON(WebClient, "base_url", "");
			Если BaseURL <> Неопределено И BaseURL <> Null Тогда
				Результат = СокрЛП(Строка(BaseURL));
			КонецЕсли;
		КонецЕсли;

		// Совместимый короткий вариант для простых конфигов.
		Если ПустаяСтрока(Результат) Тогда
			BaseURL = ЗначениеJSON(JSON, "web_client_base_url", "");
			Если BaseURL <> Неопределено И BaseURL <> Null Тогда
				Результат = СокрЛП(Строка(BaseURL));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = "";
	КонецПопытки;

	Возврат НормализоватьBaseURLКонфигурации(Результат);

КонецФункции

Функция ПоляМаскированияLLM() Экспорт

	Результат = Новый Массив;

	Попытка
		// Источник — политика справочника MCP_Маскирование (M-6). Fallback
		// llm_masked_fields из корня server-config удалён вместе с переездом:
		// состав политики в константе больше не живёт.
		Поля = СекцияPrivacy("masked_fields");

		Если ТипЗнч(Поля) = Тип("Массив") Тогда
			Для Каждого Поле Из Поля Цикл
				Если Поле = Неопределено ИЛИ Поле = Null Тогда
					Продолжить;
				КонецЕсли;
				ИмяПоля = СокрЛП(Строка(Поле));
				Если НЕ ПустаяСтрока(ИмяПоля) Тогда
					Результат.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Ошибка privacy-настроек не должна ломать read-only tools.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ИнформацияМаскированияLLM() Экспорт

	// Рубильник privacy.enabled из MCP_ServerConfig (M-4, §3.2) стоит поверх
	// всего: выключен — маскирование не применяется, включая аварийный режим.
	Рубильник = МаскированиеВключено();
	Поля = ПоляМаскированияLLM();
	ПсевдонимыТипов = ПсевдонимыТиповLLM();
	МаскиТипов = МаскиПолейТиповLLM();
	// Аварийный режим считается включённым маскированием, хотя применённых
	// записей нет ни одной: закрыто как раз максимально. Иначе guidance сообщил
	// бы «маскирование отключено» ровно в тот момент, когда оно наиболее строгое.
	Авария = ПсевдонимыТипов.emergency ИЛИ МаскиТипов.emergency;
	Включено = Рубильник
		И (Авария
			ИЛИ Поля.Количество() > 0
			ИЛИ ПсевдонимыТипов.enabled
			ИЛИ МаскиТипов.enabled);

	Результат = Новый Структура;
	Результат.Вставить("enabled", Включено);
	Результат.Вставить("masked_fields", Поля);
	Результат.Вставить("string_mask", "XXXXXXX");
	Результат.Вставить("date_mask", "1900-01-01T00:00:00");
	Результат.Вставить("type_aliases", ИнформацияПсевдонимовТиповLLM(ПсевдонимыТипов));
	Результат.Вставить("type_field_masks", ИнформацияМасокПолейТиповLLM(МаскиТипов));

	// Ошибки privacy-настроек не глушим молча: неприменённая запись означает
	// незамаскированные данные, и клиент обязан узнать об этом из ответа.
	Предупреждения = Новый Массив;
	Для Каждого Предупреждение Из ПсевдонимыТипов.warnings Цикл
		Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	Для Каждого Предупреждение Из МаскиТипов.warnings Цикл
		Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	// HR-06: подчинённые справочники закрытых типов, не указанные в политике.
	Для Каждого Предупреждение Из ПредупрежденияПодчиненныхСправочниковPrivacy() Цикл
		Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	// M-2: упразднённые ключи в политике справочника — признак недоехавшей миграции.
	Для Каждого Предупреждение Из ПредупрежденияУпраздненныхКлючейPrivacy() Цикл
		Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	// M-12: состав политики, оставшийся в MCP_ServerConfig, игнорируется — страж
	// от рассинхрона после миграции.
	Для Каждого Предупреждение Из ПредупрежденияСоставаPrivacyВКонстанте() Цикл
		Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	Результат.Вставить("config_warnings", Предупреждения);

	// Причины аварийного режима: секцию политики прочитать не удалось, состав
	// закрытых типов неизвестен, поэтому действует максимальная маска. Инструменты
	// при этом работают и данные возвращают — отказа нет ни в одной форме.
	Ошибки = Новый Массив;
	Для Каждого Ошибка Из ПсевдонимыТипов.errors Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Для Каждого Ошибка Из МаскиТипов.errors Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Результат.Вставить("config_errors", Ошибки);

	// Ревизия privacy-движка. Публикуется всегда, чтобы после деплоя можно было
	// доказать данными, какая сборка отвечает: три инцидента подряд «смерджено,
	// но наблюдается старое поведение» различались только косвенными признаками.
	// Инкрементируется при каждом изменении поведения маскирования или запретов.
	Результат.Вставить("engine_revision", РевизияPrivacyДвижка());

	Если НЕ Рубильник Тогда
		// Выключенный рубильник — осознанный административный акт (§3.2), и
		// guidance называет его прямо, чтобы отличаться от «политика пуста».
		Результат.Вставить("guidance", "Маскирование отключено настройкой privacy.enabled в MCP_ServerConfig;"
			+ " значения возвращаются согласно allowlist и правам пользователя.");
	ИначеЕсли Включено Тогда
		Результат.Вставить("guidance", ОписаниеМаскированияLLM());
	Иначе
		Результат.Вставить("guidance", "Privacy-маскирование отключено; значения полей возвращаются согласно allowlist и правам пользователя.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// M-2. Упразднённые ключи organization_aliases / person_aliases в политике
// справочника не имеют читателей, и молча игнорировать их нельзя: это признак
// недоехавшей миграции — режимы, которые они включали, больше не существуют,
// а типы, которые они закрывали, требуют явных записей type_aliases /
// type_field_masks. Ошибки чтения политики здесь глушатся: аварию уже объявили
// errors секционных читателей, второй раз о ней говорить не надо.
Функция ПредупрежденияУпраздненныхКлючейPrivacy()

	Предупреждения = Новый Массив;
	Попытка
		Для Каждого Ключ Из СтрРазделить("organization_aliases,person_aliases", ",", Ложь) Цикл
			Если СекцияPrivacy(Ключ) <> Неопределено Тогда
				Предупреждения.Добавить("privacy." + Ключ + ": ключ упразднён, записи не применяются;"
					+ " используйте type_aliases/type_field_masks.");
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Политика нечитаема — причина уже в config_errors.
	КонецПопытки;
	Возврат Предупреждения;

КонецФункции

// M-12. Состав политики в секции privacy константы MCP_ServerConfig больше не
// читается — источник состава один, справочник MCP_Маскирование. Законный ключ
// секции ровно один: enabled (рубильник, §3.2). Оставленные ключи состава —
// след недоделанной миграции, и о них предупреждается одним сообщением с
// перечислением найденных.
Функция ПредупрежденияСоставаPrivacyВКонстанте()

	Предупреждения = Новый Массив;
	Попытка
		JSON = НастройкиСервера();
		Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
		Если НЕ ЭтоJSONОбъект(Privacy) Тогда
			Возврат Предупреждения;
		КонецЕсли;

		Найденные = Новый Массив;
		Для Каждого Ключ Из СтрРазделить(
			"masked_fields,type_aliases,type_field_masks,publish_details,organization_aliases,person_aliases",
			",", Ложь) Цикл
			Если ЗначениеJSON(Privacy, Ключ, Неопределено) <> Неопределено Тогда
				Найденные.Добавить(Ключ);
			КонецЕсли;
		КонецЦикла;

		Если Найденные.Количество() > 0 Тогда
			Предупреждения.Добавить("privacy в MCP_ServerConfig: ключи "
				+ СтрСоединить(Найденные, ", ")
				+ " игнорируются; состав политики — в справочнике MCP_Маскирование."
				+ " В константе остаётся только рубильник privacy.enabled.");
		КонецЕсли;
	Исключение
		// Нечитаемый MCP_ServerConfig не имеет отношения к политике справочника.
	КонецПопытки;
	Возврат Предупреждения;

КонецФункции

Функция ОписаниеМаскированияLLM() Экспорт

	Поля = ПоляМаскированияLLM();
	ПсевдонимыТипов = ПсевдонимыТиповLLM();
	МаскиТипов = МаскиПолейТиповLLM();
	Части = Новый Массив;

	// Аварийный режим объявляется первым: он перекрывает всё остальное, и клиент
	// должен понимать, почему у него закрыты названия типов, которых нет в
	// политике. Причина — в config_errors.
	Если ПсевдонимыТипов.emergency ИЛИ МаскиТипов.emergency Тогда
		Части.Добавить("Политику маскирования прочитать не удалось, поэтому действует максимальная маска:"
			+ " у ВСЕХ ссылочных типов закрыты представление и поля названий (наименование, код)."
			+ " Данные при этом возвращаются полностью, отказов нет; аналитика по названиям на это время"
			+ " недоступна. Причина — в privacy.config_errors, снимается исправлением политики"
			+ " в справочнике MCP_Маскирование (обработка «Настройка маскирования MCP»).");
	КонецЕсли;

	Если Поля.Количество() > 0 Тогда
		Части.Добавить("Активно privacy-маскирование. Эти поля намеренно недоступны LLM-клиентам: "
			+ СтрСоединить(Поля, ", ")
			+ ". Значения заменяются на XXXXXXX, даты — на 1900-01-01T00:00:00.");
	КонецЕсли;

	ПубликоватьДетали = PrivacyPublishDetails();

	Если ПсевдонимыТипов.enabled Тогда
		ОписанияТипов = Новый Массив;
		Для Каждого Запись Из ПсевдонимыТипов.list Цикл
			ОписанияТипов.Добавить(Запись.type + " → " + Запись.prefix + "XXXXXXXX");
		КонецЦикла;
		Части.Добавить("Активны privacy-псевдонимы отдельных типов: названия объектов этих типов не передаются в чат, вместо них возвращаются стабильные коды — "
			+ СтрСоединить(ОписанияТипов, "; ")
			+ ". Для расшифровки пользователь открывает navigation_url в web-клиенте 1С, если настроен web_client.base_url, иначе в 1С.");
	КонецЕсли;

	Если МаскиТипов.enabled Тогда
		ОписанияМасок = Новый Массив;
		Для Каждого Запись Из МаскиТипов.list Цикл
			Если ПубликоватьДетали Тогда
				ОписаниеМаски = Запись.type + ": " + СтрСоединить(Запись.field_names, ", ");
			Иначе
				// publish_details=false: не раскрываем карту чувствительности —
				// перечень полей остаётся у администратора (§8, З-36).
				ОписаниеМаски = Запись.type;
			КонецЕсли;
			ОписанияМасок.Добавить(ОписаниеМаски);
		КонецЦикла;
		Части.Добавить("Активны privacy-маски полей по типам — эти поля недоступны LLM-клиентам только у указанных типов, у остальных объектов те же поля возвращаются как есть: "
			+ СтрСоединить(ОписанияМасок, "; ")
			+ ". Строки заменяются на XXXXXXX, даты — на 1900-01-01T00:00:00. Числа и булево не закрываются: значение возвращается как есть.");
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Формулировка — просьба, а не гарантия (R-5). Прежнее «Не пытайтесь обходить»
	// звучало как заявление о контроле, которого у сервера нет: подмена работает по
	// разбору текста запроса, и формы, которые разобрать не удалось, закрываются
	// консервативно, но состав и порядок строк подменой не закрываются вовсе.
	Возврат СтрСоединить(Части, " ")
		+ " Просьба не искать обходных формулировок запроса: подмена сделана по"
		+ " разбору текста, поэтому обход не столько раскрывает данные, сколько"
		+ " портит ответ — вместо названия придёт маска.";

КонецФункции

// ---- Privacy по типам (privacy.type_aliases / privacy.type_field_masks) ----
//
// Плоский masked_fields скрывает поле во всех объектах сразу; секции ниже
// задают закрытость адресно: для конкретного полного имени типа, включая
// регистры. Спецрежимы организаций и персон упразднены (решение 11.08.2026):
// организации и физлица закрываются такими же записями type_aliases /
// type_field_masks, создаваемыми миграцией из обработки настройки. Имена
// типов и полей сравниваются нормализованно (регистр, пробелы, `_`, `-`,
// `.` и `Ё` не важны), поэтому настройка не привязана к конкретной
// конфигурации 1С. Источник текста политики — предопределённый элемент
// НастройкиМаскирования справочника MCP_Маскирование (M-3), а не константа.

// Возврат: Структура
//   enabled   — есть хотя бы одна применённая запись;
//   entries   — Соответствие: нормализованный тип → Структура(type, prefix);
//   list      — Массив Структур(type, prefix) в порядке конфигурации;
//   warnings  — Массив строк о проигнорированных записях;
//   errors    — Массив строк о причинах аварийного режима (секция не прочитана);
//   emergency — секция не прочитана: состав закрытых типов неизвестен, работает
//               максимальная маска. Отказа нет — данные возвращаются.
Функция ПсевдонимыТиповLLM() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("enabled", Ложь);
	Результат.Вставить("entries", Новый Соответствие);
	Результат.Вставить("list", Новый Массив);
	Результат.Вставить("warnings", Новый Массив);
	Результат.Вставить("errors", Новый Массив);
	Результат.Вставить("emergency", Ложь);

	Попытка
		Записи = СекцияPrivacy("type_aliases");
		Если ТипЗнч(Записи) <> Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;

		Для Каждого Запись Из Записи Цикл
			Если НЕ ЭтоJSONОбъект(Запись) Тогда
				Результат.warnings.Добавить("privacy.type_aliases: запись не является объектом; проигнорирована.");
				Продолжить;
			КонецЕсли;

			ИмяТипа = СтрокаPrivacy(ЗначениеJSON(Запись, "type", ""));
			ПредупредитьОРежимеЗаписиPrivacy(Запись, "privacy.type_aliases", ИмяТипа, Результат.warnings);

			Если ПустаяСтрока(ИмяТипа) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: запись без type проигнорирована.");
				Продолжить;
			КонецЕсли;

			Prefix = СтрокаPrivacy(ЗначениеJSON(Запись, "prefix", ""));
			Если ПустаяСтрока(Prefix) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: у типа " + ИмяТипа
					+ " не задан prefix; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			ПроблемаПрефикса = ПроблемаПрефиксаPrivacy(Prefix, Результат.list);
			Если НЕ ПустаяСтрока(ПроблемаПрефикса) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: у типа " + ИмяТипа
					+ " " + ПроблемаПрефикса + "; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			Вид = ВидИзПолногоИмениТипаPrivacy(ИмяТипа);
			Если ПустаяСтрока(Вид) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: " + ИмяТипа
					+ " не является полным именем типа вида <ВидМетаданных>.<Имя>; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			Если НЕ ВидСоСсылкойPrivacy(Вид) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: у записей вида " + Вид
					+ " нет ссылки с uuid, стабильный псевдоним построить не из чего (" + ИмяТипа
					+ "); для скрытия их полей используйте privacy.type_field_masks.");
				Продолжить;
			КонецЕсли;

			Если Метаданные.НайтиПоПолномуИмени(ИмяТипа) = Неопределено Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_aliases: тип " + ИмяТипа
					+ " не найден в метаданных; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			Ключ = НормализоватьКлючPrivacy(ИмяТипа);
			Если Результат.entries.Получить(Ключ) <> Неопределено Тогда
				Результат.warnings.Добавить("privacy.type_aliases: тип " + ИмяТипа
					+ " указан повторно; применена первая запись.");
				Продолжить;
			КонецЕсли;

			ЗаписьТипа = Новый Структура;
			ЗаписьТипа.Вставить("type", ИмяТипа);
			ЗаписьТипа.Вставить("prefix", Prefix);
			// hidden_alias закрывает случай, когда запрос вернул только строку с
			// названием, без ссылки: стабильный код построить не из чего, но и
			// отдавать название нельзя. Так же работают псевдонимы организаций.
			ЗаписьТипа.Вставить("hidden_alias", Prefix + "скрыто");
			ЗаписьТипа.Вставить("object_key", НормализоватьКлючPrivacy(ИмяОбъектаИзПолногоИмениPrivacy(ИмяТипа)));
			Результат.entries.Вставить(Ключ, ЗаписьТипа);
			Результат.list.Добавить(ЗаписьТипа);
			Результат.enabled = Истина;
		КонецЦикла;
	Исключение
		// Секция не прочитана — аварийный режим, а не отказ: состав закрытых типов
		// неизвестен, поэтому закрывается максимум (имена и представление у всех
		// ссылочных типов), данные при этом возвращаются. Причина уходит клиенту
		// в privacy.config_errors.
		Результат.emergency = Истина;
		Результат.errors.Добавить("privacy.type_aliases: секция не прочитана ("
			+ ОписаниеОшибки() + "); действует максимальная маска —"
			+ " у всех ссылочных типов закрыты имена и представление.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Поле mode записи политики больше не влияет ни на что: состояний два —
// подмена включена или выключена, отказов нет ни в одной форме (решение
// 05.08.2026). Значение принимается и игнорируется: живые политики хранят
// "mode": "mask" на каждой записи, и отвергать такие записи нельзя — политика
// рассыпалась бы целиком. Молчать тоже нельзя: администратор, написавший deny,
// обязан узнать, что запрета не будет.
Процедура ПредупредитьОРежимеЗаписиPrivacy(Запись, ИмяСекции, ИмяТипа, Предупреждения)

	Режим = НРег(СтрокаPrivacy(ЗначениеJSON(Запись, "mode", "")));
	Если ПустаяСтрока(Режим) ИЛИ Режим = "mask" Тогда
		Возврат;
	КонецЕсли;

	ОписаниеТипа = ?(ПустаяСтрока(ИмяТипа), "<без type>", ИмяТипа);
	Если Режим = "deny" Тогда
		Предупреждения.Добавить(ИмяСекции + ": у типа " + ОписаниеТипа
			+ " значение mode ""deny"" больше не поддерживается —"
			+ " запись применена как маска, отказа не будет.");
	Иначе
		Предупреждения.Добавить(ИмяСекции + ": у типа " + ОписаниеТипа
			+ " неизвестное значение mode """ + Режим + """;"
			+ " поле игнорируется, запись применена как маска.");
	КонецЕсли;

КонецПроцедуры

// Проблема записи — всегда предупреждение: работа продолжается, запись просто
// не применена. Отказа за неверную настройку больше нет.
Процедура ДобавитьПроблемуPrivacy(Результат, Текст)

	Результат.warnings.Добавить(Текст);

КонецПроцедуры

// Ограничения префикса (§5.1): длина 1..20, без пробелов и управляющих
// символов, уникальность среди настроенных префиксов, не является началом
// другого префикса (иначе коды двух типов неразличимы). Легаси-префиксы
// организаций и персон из проверки ушли вместе с самими режимами: их типы
// теперь закрываются обычными записями type_aliases.
Функция ПроблемаПрефиксаPrivacy(Prefix, СписокЗаписей)

	Если СтрДлина(Prefix) > 20 Тогда
		Возврат "prefix длиннее 20 символов";
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Prefix) Цикл
		Если КодСимвола(Сред(Prefix, Позиция, 1)) <= 32 Тогда
			Возврат "prefix содержит пробел или управляющий символ";
		КонецЕсли;
	КонецЦикла;

	Известные = Новый Массив;
	Для Каждого Запись Из СписокЗаписей Цикл
		Известные.Добавить(Запись.prefix);
	КонецЦикла;

	НормПрефикс = НРег(Prefix);
	Для Каждого Известный Из Известные Цикл
		НормИзвестный = НРег(СтрокаPrivacy(Известный));
		Если ПустаяСтрока(НормИзвестный) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(НормПрефикс, НормИзвестный) = 1 ИЛИ СтрНайти(НормИзвестный, НормПрефикс) = 1 Тогда
			Возврат "prefix """ + Prefix + """ совпадает с другим настроенным или легаси-префиксом"
				+ " либо является его началом";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возврат: Структура
//   enabled   — есть хотя бы одна применённая запись;
//   entries   — Соответствие: нормализованный тип → Структура(type, fields,
//               mask_presentation, mask_person_name),
//               где fields — Соответствие нормализованное имя поля → Истина;
//   list      — Массив Структур(type, fields) в порядке конфигурации;
//   warnings  — Массив строк о проигнорированных и о недействующих записях;
//   errors    — Массив строк о причинах аварийного режима (секция не прочитана);
//   emergency — секция не прочитана: работает максимальная маска.
Функция МаскиПолейТиповLLM() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("enabled", Ложь);
	Результат.Вставить("entries", Новый Соответствие);
	Результат.Вставить("list", Новый Массив);
	Результат.Вставить("warnings", Новый Массив);
	Результат.Вставить("errors", Новый Массив);
	Результат.Вставить("emergency", Ложь);

	Попытка
		Записи = СекцияPrivacy("type_field_masks");
		Если ТипЗнч(Записи) <> Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;

		Для Каждого Запись Из Записи Цикл
			Если НЕ ЭтоJSONОбъект(Запись) Тогда
				Результат.warnings.Добавить("privacy.type_field_masks: запись не является объектом; проигнорирована.");
				Продолжить;
			КонецЕсли;

			ИмяТипа = СтрокаPrivacy(ЗначениеJSON(Запись, "type", ""));
			ПредупредитьОРежимеЗаписиPrivacy(Запись, "privacy.type_field_masks", ИмяТипа, Результат.warnings);

			Если ПустаяСтрока(ИмяТипа) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: запись без type проигнорирована.");
				Продолжить;
			КонецЕсли;

			Вид = ВидИзПолногоИмениТипаPrivacy(ИмяТипа);
			Если ПустаяСтрока(Вид) Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: " + ИмяТипа
					+ " не является полным именем типа вида <ВидМетаданных>.<Имя>; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			ОМД = Метаданные.НайтиПоПолномуИмени(ИмяТипа);
			Если ОМД = Неопределено Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: тип " + ИмяТипа
					+ " не найден в метаданных; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			ПоляЗаписи = ЗначениеJSON(Запись, "fields", Неопределено);
			Если ТипЗнч(ПоляЗаписи) <> Тип("Массив") Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: у типа " + ИмяТипа
					+ " поле fields не является массивом; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			// Поля типа собираются ОДИН раз на запись: проверка идёт по каждому
			// имени из fields, а обход метаданных внутри неё стоил бы столько
			// обходов, сколько в записи полей.
			ПоляОМД = ПоляТипаPrivacy(ОМД);

			ИменаПолей = Новый Массив;
			ИндексПолей = Новый Соответствие;
			МаскироватьПредставление = Ложь;
			МаскироватьИмяПерсоны = Ложь;
			Для Каждого Поле Из ПоляЗаписи Цикл
				ИмяПоля = СтрокаPrivacy(Поле);
				Если ПустаяСтрока(ИмяПоля) Тогда
					Продолжить;
				КонецЕсли;
				НормПоле = НормализоватьКлючPrivacy(ИмяПоля);
				Если ПустаяСтрока(НормПоле) Тогда
					Продолжить;
				КонецЕсли;
				// Опечатка в имени поля создаёт ложное ощущение защиты: маска по
				// несуществующему имени никогда не сработает. Имя-подобные поля и
				// субконто освобождены: presentation и СубконтоДт/Кт — ключи
				// JSON-контракта сервера, а не реквизиты метаданных.
				Если НЕ ПолеИмениОбъектаPrivacy(НормПоле)
					И СтрНайти(НормПоле, "субконто") <> 1
					И ПоляОМД.Получить(НормПоле) = Неопределено Тогда
					ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: у типа " + ИмяТипа
						+ " поле " + ИмяПоля + " не найдено в метаданных; поле проигнорировано.");
					Продолжить;
				КонецЕсли;
				// Числовое и булево поле маской не закрывается: подмены, которая не
				// искажает, для них нет, а null — стирание значения. Запись остаётся
				// в политике, но защиты не даёт — молчать об этом нельзя, иначе это
				// ровно тот же дефект, что список, который никто не читает.
				Если ПолеЧисловоеИлиБулевоPrivacy(ПоляОМД, НормПоле) Тогда
					ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: у типа " + ИмяТипа
						+ " поле " + ИмяПоля + " числовое или булево — маска на него не действует,"
						+ " значение возвращается как есть; числа и булево не закрываются.");
				КонецЕсли;
				ИменаПолей.Добавить(ИмяПоля);
				ИндексПолей.Вставить(НормПоле, Истина);
				// Пометка ИМЕНИ поднимает признак закрытия представления: оно несёт
				// то же название. Пометка `Код` — не поднимает (решение 14.08): код
				// не имя, и представление объекта его не содержит.
				Если ПолеПодКодПсевдонимаPrivacy(НормПоле) Тогда
					МаскироватьПредставление = Истина;
				КонецЕсли;
				// Пометка имени персоны (ФИО) закрывает весь класс имени объекта:
				// у справочника людей Наименование, НаименованиеПолное и ФИО — одна
				// и та же строка, и закрыть ФИО, оставив Наименование, значит не
				// закрыть ничего. Замер трёх контуров 11.08: политика из
				// ФИО/Фамилия/Имя/Отчество/ИНН/СНИЛС отдавала ФИО открытым в
				// Наименовании, в ПРЕДСТАВЛЕНИЕ(Ссылка) и в presentation ссылки.
				// Обратной силы правило не имеет: пометка Наименования не закрывает
				// ФИО — это отдельный реквизит, и метится он отдельно.
				Если РольКлючаPrivacy(НормПоле) = "имя_персоны" Тогда
					МаскироватьИмяПерсоны = Истина;
				КонецЕсли;
			КонецЦикла;

			Если ИменаПолей.Количество() = 0 Тогда
				ДобавитьПроблемуPrivacy(Результат, "privacy.type_field_masks: у типа " + ИмяТипа
					+ " список fields пуст; запись проигнорирована.");
				Продолжить;
			КонецЕсли;

			Ключ = НормализоватьКлючPrivacy(ИмяТипа);
			ЗаписьТипа = Результат.entries.Получить(Ключ);
			Если ЗаписьТипа <> Неопределено Тогда
				// Повтор типа не игнорируем: молча потерянные поля означают
				// незамаскированные данные. Списки объединяются.
				Результат.warnings.Добавить("privacy.type_field_masks: тип " + ИмяТипа
					+ " указан повторно; списки полей объединены.");
				Для Каждого КЗ Из ИндексПолей Цикл
					ЗаписьТипа.fields.Вставить(КЗ.Ключ, Истина);
				КонецЦикла;
				Для Каждого ИмяПоля Из ИменаПолей Цикл
					ЗаписьТипа.field_names.Добавить(ИмяПоля);
				КонецЦикла;
				ЗаписьТипа.mask_presentation = ЗаписьТипа.mask_presentation ИЛИ МаскироватьПредставление;
				ЗаписьТипа.mask_person_name = ЗаписьТипа.mask_person_name ИЛИ МаскироватьИмяПерсоны;
				Продолжить;
			КонецЕсли;

			ЗаписьТипа = Новый Структура;
			ЗаписьТипа.Вставить("type", ИмяТипа);
			ЗаписьТипа.Вставить("fields", ИндексПолей);
			ЗаписьТипа.Вставить("field_names", ИменаПолей);
			ЗаписьТипа.Вставить("mask_presentation", МаскироватьПредставление);
			ЗаписьТипа.Вставить("mask_person_name", МаскироватьИмяПерсоны);
			ЗаписьТипа.Вставить("object_key", НормализоватьКлючPrivacy(ИмяОбъектаИзПолногоИмениPrivacy(ИмяТипа)));
			Результат.entries.Вставить(Ключ, ЗаписьТипа);
			Результат.list.Добавить(ЗаписьТипа);
			Результат.enabled = Истина;
		КонецЦикла;
	Исключение
		// Секция не прочитана — аварийный режим, а не отказ (см. ПсевдонимыТиповLLM).
		Результат.emergency = Истина;
		Результат.errors.Добавить("privacy.type_field_masks: секция не прочитана ("
			+ ОписаниеОшибки() + "); действует максимальная маска —"
			+ " у всех ссылочных типов закрыты имена и представление.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// HR-06 (текст переписан по поправке §4.14). Риск подчинённого справочника —
// не наследование имени владельца, а СОБСТВЕННЫЕ данные подчинённого объекта:
// наименование родственника — это ФИО родственника, то есть ПДн третьего лица,
// включая несовершеннолетних. После упразднения R-12 (автозакрытия подчинённых
// типам персон) ЛЮБОЙ подчинённый закрытого типа требует явной записи политики,
// и это предупреждение — единственный страж: перечень закрытых типов берётся
// из type_aliases/type_field_masks, а не из зашитых типов персон. Возвращает
// предупреждения о подчинённых справочниках закрытых типов, которые в политике
// не перечислены.
Функция ПредупрежденияПодчиненныхСправочниковPrivacy() Экспорт

	Предупреждения = Новый Массив;

	Попытка
		ПсевдонимыТипов = ПсевдонимыТиповLLM();
		МаскиТипов = МаскиПолейТиповLLM();
		Если НЕ ПсевдонимыТипов.enabled И НЕ МаскиТипов.enabled Тогда
			Возврат Предупреждения;
		КонецЕсли;

		// Ключи настроенных типов: и владельцы, и уже закрытые подчинённые.
		// Тип, заданный сразу в обеих секциях, в списке должен быть один раз:
		// иначе он дважды попадёт в текст предупреждения.
		Настроенные = Новый Соответствие;
		Закрытые = Новый Массив;
		Для Каждого Запись Из ПсевдонимыТипов.list Цикл
			КлючТипа = НормализоватьКлючPrivacy(Запись.type);
			Если Настроенные.Получить(КлючТипа) = Неопределено Тогда
				Настроенные.Вставить(КлючТипа, Истина);
				Закрытые.Добавить(Запись.type);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Запись Из МаскиТипов.list Цикл
			КлючТипа = НормализоватьКлючPrivacy(Запись.type);
			Если Настроенные.Получить(КлючТипа) = Неопределено Тогда
				Настроенные.Вставить(КлючТипа, Истина);
				Закрытые.Добавить(Запись.type);
			КонецЕсли;
		КонецЦикла;

		Для Каждого Справочник Из Метаданные.Справочники Цикл
			ПолноеИмяПодчиненного = Справочник.ПолноеИмя();
			Если Настроенные.Получить(НормализоватьКлючPrivacy(ПолноеИмяПодчиненного)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИменаВладельцев = Новый Массив;
			Для Каждого Владелец Из Справочник.Владельцы Цикл
				ИмяВладельца = ПолноеИмяВладельцаPrivacy(Владелец);
				Если ПустаяСтрока(ИмяВладельца) Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого ИмяЗакрытого Из Закрытые Цикл
					Если НормализоватьКлючPrivacy(ИмяЗакрытого) = НормализоватьКлючPrivacy(ИмяВладельца) Тогда
						ИменаВладельцев.Добавить(ИмяЗакрытого);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;

			Если ИменаВладельцев.Количество() > 0 Тогда
				Предупреждения.Добавить("privacy: справочник " + ПолноеИмяПодчиненного
					+ " подчинён закрытому типу (" + СтрСоединить(ИменаВладельцев, ", ")
					+ "), но в политике не указан; строки подчинённого несут собственные"
					+ " данные — для родственников и контактных лиц это персональные данные"
					+ " третьих лиц, включая несовершеннолетних. Автозакрытия по подчинённости"
					+ " больше нет — закройте справочник записью политики.");
			КонецЕсли;
		КонецЦикла;
	Исключение
		Предупреждения.Добавить("privacy: проверка подчинённых справочников не выполнена ("
			+ ОписаниеОшибки() + ").");
	КонецПопытки;

	Возврат Предупреждения;

КонецФункции

// Элемент коллекции Владельцы — объект метаданных; у старых платформ мог
// приходить как имя. Обе формы приводим к полному имени.
Функция ПолноеИмяВладельцаPrivacy(Владелец)

	Попытка
		Возврат Владелец.ПолноеИмя();
	Исключение
	КонецПопытки;

	Имя = СокрЛП(Строка(Владелец));
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(Имя, ".") > 0 Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат "Справочник." + Имя;

КонецФункции

// Причины аварийного режима privacy: секции политики, которые прочитать не
// удалось. Непустой результат означает максимальную маску, а не отказ —
// инструменты работают, строки возвращаются, причина видна клиенту в
// privacy.config_errors.
Функция ОшибкиКонфигурацииPrivacy() Экспорт

	Ошибки = Новый Массив;
	Для Каждого Ошибка Из ПсевдонимыТиповLLM().errors Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Для Каждого Ошибка Из МаскиПолейТиповLLM().errors Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

Функция ИнформацияПсевдонимовТиповLLM(ПсевдонимыТипов = Неопределено) Экспорт

	Если ПсевдонимыТипов = Неопределено Тогда
		ПсевдонимыТипов = ПсевдонимыТиповLLM();
	КонецЕсли;

	Записи = Новый Массив;
	Для Каждого Запись Из ПсевдонимыТипов.list Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("type", Запись.type);
		Элемент.Вставить("prefix", Запись.prefix);
		Записи.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("enabled", ПсевдонимыТипов.enabled);
	Результат.Вставить("entries", Записи);
	Результат.Вставить("resolution", "open_navigation_url_in_1c");
	Возврат Результат;

КонецФункции

Функция ИнформацияМасокПолейТиповLLM(МаскиТипов = Неопределено) Экспорт

	Если МаскиТипов = Неопределено Тогда
		МаскиТипов = МаскиПолейТиповLLM();
	КонецЕсли;

	Записи = Новый Массив;
	Для Каждого Запись Из МаскиТипов.list Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("type", Запись.type);
		Элемент.Вставить("fields", Запись.field_names);
		Записи.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("enabled", МаскиТипов.enabled);
	Результат.Вставить("entries", Записи);
	Возврат Результат;

КонецФункции

// Поля типа: нормализованное имя → Структура("Тип") с описанием типов поля.
// Отсутствие ключа = поля у типа нет.
//
// Состав коллекций обязан совпадать с тем, что обработка настройки выводит в
// правую панель (таблица видов А.9 ТЗ каталога): пользователь ставит галку на
// поле, которое видит, и запись обязана примениться. Раньше проверка знала лишь
// Реквизиты/Измерения/Ресурсы/СтандартныеРеквизиты — поле ТАБЛИЧНОЙ ЧАСТИ
// отвергалось как «не найдено в метаданных», то есть пометка молча не работала.
//
// Имена полей ТЧ хранятся в политике ПЛОСКО (M-21): движок применяет маску по
// ключу строки ответа, а он плоский. Поэтому поле ТЧ, одноимённое полю шапки,
// закрывает оба — обработка предупреждает об этом при пометке. Шапка обходится
// первой: её описание типов приоритетно при совпадении имён.
Функция ПоляТипаPrivacy(ОМД)

	Результат = Новый Соответствие;

	// Скалярные коллекции: шапка объекта, поля регистра, признаки учёта плана
	// счетов, реквизиты адресации задачи.
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("СтандартныеРеквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	ИменаКоллекций.Добавить("РеквизитыАдресации");
	ИменаКоллекций.Добавить("ПризнакиУчета");
	ИменаКоллекций.Добавить("ПризнакиУчетаСубконто");

	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		ДобавитьПоляКоллекцииPrivacy(Результат, ОМД, ИмяКоллекции);
	КонецЦикла;

	// Табличные части: обходятся реквизиты и стандартные реквизиты каждой ТЧ.
	Для Каждого ИмяКоллекцииЧастей Из СтрРазделить("ТабличныеЧасти,СтандартныеТабличныеЧасти", ",", Ложь) Цикл
		Попытка
			Части = ОМД[ИмяКоллекцииЧастей];
		Исключение
			Продолжить;
		КонецПопытки;
		Если Части = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Части Цикл
			ДобавитьПоляКоллекцииPrivacy(Результат, Часть, "Реквизиты");
			ДобавитьПоляКоллекцииPrivacy(Результат, Часть, "СтандартныеРеквизиты");
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поля одной коллекции в накопитель. Коллекция, отсутствующая у вида объекта,
// пропускается: набор свойств у справочника, регистра и задачи разный, и
// проверять его наличие заранее дороже, чем перехватить.
Процедура ДобавитьПоляКоллекцииPrivacy(Накопитель, Владелец, ИмяКоллекции)

	Попытка
		Коллекция = Владелец[ИмяКоллекции];
	Исключение
		Возврат;
	КонецПопытки;
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Для Каждого Поле Из Коллекция Цикл
			НормИмя = НормализоватьКлючPrivacy(Поле.Имя);
			Если ПустаяСтрока(НормИмя) ИЛИ Накопитель.Получить(НормИмя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОписаниеПоля = Новый Структура;
			Попытка
				ОписаниеПоля.Вставить("Тип", Поле.Тип);
			Исключение
				// У поля нет описания типов (например ТЧ-подобный элемент) —
				// само поле при этом существует, и запись политики законна.
				ОписаниеПоля.Вставить("Тип", Неопределено);
			КонецПопытки;
			Накопитель.Вставить(НормИмя, ОписаниеПоля);
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Поле объекта хранит только числа и/или булево. Такое поле маской не
// закрывается: подмены, которая не искажает, для чисел нет, а null — стирание.
// Составной тип с числом среди прочих здесь НЕ считается числовым: строковая
// часть закрывается как обычно, поэтому предупреждать не о чем.
// Ложь при любом сомнении — предупреждение не должно возникать на пустом месте.
Функция ПолеЧисловоеИлиБулевоPrivacy(ПоляОМД, НормПоле)

	ОписаниеПоля = ПоляОМД.Получить(НормПоле);
	Если ОписаниеПоля = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеТипов = ОписаниеПоля.Тип;
	Если ОписаниеТипов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Типы = ОписаниеТипов.Типы();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Типы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Т Из Типы Цикл
		Если Т <> Тип("Число") И Т <> Тип("Булево") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Тип адресуется ссылкой с uuid: вид взят из полного имени, метаданные не
// читаются. Нужен аварийному режиму — там закрываются имена у всех таких типов
// сразу, потому что перечня закрытых типов в этот момент нет.
Функция ЭтоСсылочныйВидТипаPrivacy(ПолноеИмяТипа) Экспорт

	Вид = ВидИзПолногоИмениТипаPrivacy(ПолноеИмяТипа);
	Возврат НЕ ПустаяСтрока(Вид) И ВидСоСсылкойPrivacy(Вид);

КонецФункции

// Ревизия privacy-движка: строка вида <дата>.<номер>. Правило сопровождения —
// менять значение В ТОМ ЖЕ коммите, который меняет поведение маскирования.
// «2026-08-05.3» = четыре дефекта живой приёмки: аварийный режим переживает
// битый JSON константы (R-6), выражение над колонкой ВТ закрывается по
// операндам (R-7), ссылка в строке не переопределяет тип строки — паспортные
// маски и физлицо закрываются одновременно (R-8), Представление наследует
// закрытость от закрытых реквизитов (R-9).
// «2026-08-11.1» = каталог политики: состав читается из справочника
// MCP_Маскирование, рубильник privacy.enabled в MCP_ServerConfig, спецрежимы
// организаций/персон и автозакрытие подчинённых (R-12) упразднены — их
// поведение воспроизводится явными записями политики, созданными миграцией.
// «2026-08-11.2» = решение заказчика «маскируется только помеченное»: сняты все
// автоматические расширения состава — ядро идентифицирующих полей (R-13) с его
// белым списком, наследование представления от закрытого реквизита (R-9),
// закрытие полей строки табличной части по владельцу (R-11). Из следствий
// пометки сохранено одно: `presentation` закрывается, когда помечено
// имя-подобное поле, — иначе то же название уходит через ссылку в той же строке.
Функция РевизияPrivacyДвижка() Экспорт

	// `2026-08-17.2` — доделан запрет данных в журнале регистрации (хвост волны
	// .14.3): четыре последних места, писавших сырой текст исключения, переведены
	// на метрики. MCP.query.domain_guidance_unavailable — стадия и длина (текст
	// клиенту в warnings); MCP.audit.failed (обе ветки) — стадия, correlation_id,
	// длина; MCP.http_audit.failed — стадия, метод, код состояния, длина;
	// MCP.QueryExample.skip — категория причины и длина, ветка сырого текста под
	// debug_skip удалена целиком (решение владельца 17.08: запрет безусловный, не
	// зависящий от настройки). skeleton в MCP.QueryExample ОСТАВЛЕН тем же
	// решением: это хранилище механизма примеров, данных в нём нет по построению.
	//
	// `2026-08-17.1` — правило антиомоглифа temporary_table_identifier_mixed_script
	// снято с сервера (#145, решение заказчика 13.08: класс «стиль» уезжает во
	// внешний чекер, ТЗ tz_validator_rule_classes R-3). Имя объекта конфигурации
	// (Справочник.MCP_Маскирование) автор запроса изменить не может, а латинская
	// серия MCP целиком из букв-двойников — правило делало объект недостижимым,
	// включая чтение политики маскирования администратором. Правило остаётся в
	// query_style_check.mjs и судит рукописные имена; имена объектов метаданных
	// оно там больше не судит — их существование проверяет сервер
	// (metadata_not_found).
	//
	// `2026-08-14.8` — решение о допуске поля разделено на «контекст объекта» и
	// «поле в контексте». Всё, что не зависит от имени поля (allowlist,
	// конфигурация типа, hidden_fields), считается один раз на объект, а не на
	// каждое поле: MCP_Config.Allowlist() читает константу и разбирает JSON при
	// каждом обращении, и построение списка полей для показа на широком объекте
	// стоило столько же разборов. Замер 17.08 на ERP: путь отказа pre-flight
	// 1207 мс, из них порядка 1100 — эти повторы.
	//
	// `2026-08-14.7` — путь ОТКАЗА pre-flight перестал платить за вторую
	// интроспекцию: список для показа строится из уже полученного оракула. В .6
	// диагностика запрашивала полный набор заново, и отказ стоил дороже успеха
	// (1372 мс против 767 на Справочник.Номенклатура).
	//
	// `2026-08-14.6` — pre-flight источников перестал строить список полей для
	// показа на успешном пути. Список (available_fields, did_you_mean) собирается
	// через MCP_Security.ПолеРазрешено на КАЖДОЕ поле, а тот разбирает константу
	// allowlist при каждом вызове — на широком объекте это сотни разборов конфига.
	// Проверке существования поля список не нужен: он запрашивается только когда
	// поле не найдено, то есть в диагностике отказа. Замер 14.08: стадия
	// q_preflight_sources 332 мс из 1120 мс вызова, самая дорогая после снятия
	// privacy с первого места.
	//
	// `2026-08-14.5` — маскирование только по данным обработки плюс цена вызова.
	// Сняты производные закрытия: псевдоним типа больше не закрывает `Код` и
	// пометка `Код` не поднимает mask_presentation (A4); снято закрытие по
	// СХОДСТВУ имени колонки с именем типа, включая сегменты пути (B1/B2).
	// Производные, оставленные по решению владельца: mask_presentation,
	// mask_person_name, заимствование типа у ссылки в строке, наследование типа
	// родителя, аварийный режим.
	// Цена вызова: первый эшелон считает пометки колонок один раз на результат,
	// а не на каждую ячейку (R-7); второй эшелон не пересобирает контейнер, в
	// котором ничего не изменилось, склеивает путь после первой отсечки и не
	// зовёт дорогие предикаты, которым нечего отвечать (R-8).
	//
	// `2026-08-14.4` — ранний выход маскирования по составу ответа (R-2) и снятие
	// служебного ключа privacy_column_decisions на выходе (#164). Второй эшелон
	// больше не пересобирает ответ, в котором политике нечего закрывать: замеры
	// 13–14.08 давали на таких ответах 65–68 % времени вызова. Предпроверка
	// fail-closed — ловит надмножество правил закрытия, решение по значению
	// по-прежнему за обходом. Наблюдаемый признак ревизии — стадия `masking` в
	// событии аудита падает до единиц миллисекунд на ответе без закрытых типов.
	//
	// `2026-08-14.3` — запрет данных в журнале регистрации. В события аудита
	// больше не пишутся аргументы вызова (текст запроса с литералами, значения
	// параметров, поисковые строки) и тексты ошибок: остались метрики
	// `{keys, query_chars, param_count}` и один код ошибки. Тексты исключений
	// убраны и из событий мимо аудита — они цитируют фрагмент упавшего запроса.
	// Ревизия поднята ради МАРКЕРА: снаружи правка не наблюдается вовсе
	// (get_audit_log аргументы не отдавал и раньше), и без номера отличить новую
	// сборку от старой было бы нечем. Пара к маркеру — просмотр журнала изнутри 1С.
	//
	// `2026-08-14.2` — из ответа ОБОИХ паспортов убран полный состав
	// privacy.config_warnings: остаются счётчик `config_warnings_count` и указатель
	// `config_warnings_source` на get_current_user_context, где состав сохранён
	// пофамильно. Решение владельца 14.08 по замеру: предупреждения адресованы
	// администратору (подчинённые справочники персон HR-06, легаси-ключи M-12), LLM по
	// ним действий не предпринимает, а стоят они 789 токенов из 1 509 в ответе паспорта
	// на ERP. config_errors не сжимается — это про безопасность. Остальные инструменты
	// переводятся на счётчик отдельным PR (R-5), здесь список именной.
	//
	// `2026-08-14.1` — паспорт базы пересобран: два инструмента вместо одного, и НИ
	// ОДИН не обращается к данным. `get_database_passport` отдаёт название базы,
	// версии и указатели (порядка 300 символов, потолок контракта 10 000);
	// `get_database_passport_full` — перепись метаданных счётчиками по 11 видам,
	// два числа на вид: total (всего в конфигурации) и allowed (доступно по
	// allowlist и правам 1С). Имён объектов и их полей не отдаёт ни один.
	//
	// Прежний метод удалён целиком вместе с замкнутым на нём кластером (27 функций):
	// пробы регистров, сборщик организаций, закрытые периоды, кэш паспорта. Что
	// ушло из ответа безвозвратно и почему это не флаг, а решение:
	// organizations — отбор брал значение поля, не сверяя фактический тип, и на ERP
	// давал 87 % мусора (склады и партнёры под именем организаций); data_period —
	// сшивался из двух разных регистров и потому был неверен; has_data/total_entries
	// и closed_periods — данные, а данные спрашиваются запросом. Тяжёлых секций
	// больше нет, поэтому нет и стража их комбинации: отклонять нечего.
	//
	// Наблюдаемый признак публикации ПАРНЫЙ и дешёвый (в отличие от прежней правки
	// паспорта, где проверка стоила минуты): в tools/list появляется
	// get_database_passport_full, а сокращённый паспорт отвечает без секций
	// organizations/data_period. Оба условия — мгновенные вызовы без данных.
	//
	// `2026-08-13.4` — паспорт запрашивается ТРЕМЯ вызовами. Секции регистров
	// сведений и накопления тяжёлые (замер ERP: 33,6 с и 46,3 с сверх базовой
	// части), вместе с остальными флагами вызов превышал таймаут публикации и
	// обрывался шлюзом HTML-страницей 504 — без структурированной ошибки,
	// correlation_id и записи в журнале. Теперь комбинация обоих флагов
	// отклоняется сразу кодом invalid_arguments с указанием, как разнести вызовы,
	// а описание инструмента предписывает разделение заранее.
	//
	// `2026-08-13.3` — паспорт базы больше не блокируется собственным правилом
	// сервера. Запросы паспорта к основной таблице регистра несут объявленное
	// исключение base_register_table_without_vt_check с обоснованием по существу
	// (у непериодического регистра сведений виртуальных таблиц нет вовсе), само
	// правило не ослаблено. Предупреждения инструментов несут причину и коды
	// сработавших правил, а не весь payload валидации с query_guidance. Текст
	// правила разделён по виду регистра: регистру сведений больше не советуются
	// Обороты, ДвиженияССубконто и субконто, которых у него нет.
	//
	// `2026-08-13.2` — замер стадий доведён до устойчивости к частичной публикации
	// (ТЗ stage_timing_hardening). Фолбэк HTTP-аудита ветвится ТОЛЬКО по признаку
	// версии модуля: до этого условие включало локально считанную длину ответа,
	// на основном пути POST не выполнялось никогда, и со старым MCP_Audit терялась
	// ВСЯ запись MCP.http_request, а не только её разбивка. Ранние отказы POST
	// (origin, версия протокола, пустое тело) теперь несут накопленные стадии —
	// это же и наблюдаемый маркер публикации. Служебный ключ _perf вставляется в
	// результат, только если снять его есть кому (проба MCP_Tools):
	// пара MCP_Query+MCP_Tools защищена по конструкции, а не одним правилом.
	// Контракт ответа инструментов не менялся.
	//
	// `2026-08-13.1` — профилирование обвязки вызова (ТЗ perf_tool_overhead R-6):
	// события аудита MCP.<tool>.* и MCP.http_request несут разбивку по стадиям
	// (stages, мс) и счётчики (counters: ячейки, ячейки-ссылки, цена чтения их
	// представлений). get_audit_log отдаёт разбивку наружу. duration_ms события
	// инструмента теперь включает и сериализацию ответа (результат собирается до
	// записи аудита). Контракт ответа инструментов не менялся: служебный ключ
	// _perf удаляется в MCP_Tools до маскирования и сериализации.
	//
	// `2026-08-12.3` — записи аудита стали читаемы снаружи: tool `get_audit_log`
	// отдаёт duration_ms вызовов и HTTP-запросов из журнала регистрации. Аргументы
	// вызовов и тексты ошибок наружу не идут: маскирование покрывает результат, а
	// не аргументы, и текст запроса из журнала обошёл бы маску.
	//
	// `2026-08-12.2` — сквозной аудит HTTP и tool-вызовов измеряет фактические
	// миллисекунды: ТекущаяУниверсальнаяДатаВМиллисекундах вместо разности дат,
	// которая давала только кратные 1000. Имя функции историческое — маркер
	// проверяет полноту всей поставки, а не только privacy.
	//
	// `2026-08-12.1` — рубильник privacy.enabled гасит ОБА эшелона. До этого
	// проверка стояла только во втором (МаскироватьПоляДляLLM), а первый — пометка
	// колонок и подмена при сборке строк — брал политику из снимка, который
	// рубильник не спрашивал: замер BUH 12.08 при выключенном рубильнике и одной
	// записи политики вернул `Наименование` как XXXXXXX, хотя guidance обещал
	// открытые значения.
	//
	// `.3` (11.08) — пометка имени персоны (ФИО) закрывает представление объекта:
	// замер трёх контуров показал, что политика из ФИО/Фамилия/Имя/Отчество
	// оставляла ФИО открытым в Наименовании, ПРЕДСТАВЛЕНИЕ(Ссылка) и presentation
	// ссылки. Производное закрытие представления уступает псевдониму типа, чтобы
	// код оставался различимым.
	Возврат "2026-08-17.2";

КонецФункции

// privacy.publish_details: публиковать ли в guidance полный перечень
// закрытых полей. По умолчанию Истина; Ложь оставляет в guidance только
// типы — карта чувствительности не раскрывается клиенту.
//
// R-6 (Д-1): единственный читатель настройки без Попытки. При синтаксически
// битом JSON политики исключение отсюда роняло ВЕСЬ сервис в -32603 — через
// guidance каждого tool-result (ДобавитьИнформациюОМаскированииLLM) и через
// описания инструментов в tools/list (_Tool) — вместо обещанной максимальной
// маски. Дефолт Истина — как у соседних читателей настройки.
//
// Оборачивать НЕЛЬЗЯ ни СекцияPrivacy, ни ТекстПолитикиМаскирования: обе
// privacy-секции опознают аварию ИМЕННО по исключению из них. Увидев вместо
// исключения пустоту, они решат «политики нет» и не закроют ничего — полный
// отказ превратился бы в полную утечку. Попытка обязана оставаться здесь,
// на листе.
Функция PrivacyPublishDetails() Экспорт

	Попытка
		Возврат БулевоИзЗначения(СекцияPrivacy("publish_details"), Истина);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// M-5. Источник секций политики — текст справочника MCP_Маскирование, не
// константа. Контракт сохранён: исключение наружу = авария (битый JSON,
// недоступный справочник), пустой текст и отсутствующая секция = пустая
// политика без аварии.
Функция СекцияPrivacy(ИмяСекции)

	Текст = ТекстПолитикиМаскирования();
	Если ПустаяСтрока(Текст) Тогда
		// Пустое Значение — законное состояние «ничего не настроено» (M-1).
		Возврат Неопределено;
	КонецЕсли;

	JSON = ПрочитатьJSONИзСтроки(Текст);
	Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
	Если НЕ ЭтоJSONОбъект(Privacy) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗначениеJSON(Privacy, ИмяСекции, Неопределено);

КонецФункции

// M-3. Текст политики маскирования: реквизит Значение предопределённого
// элемента НастройкиМаскирования справочника MCP_Маскирование. Чтение в
// привилегированном режиме — права и RLS сервисного пользователя на защиту
// влиять не должны. Справочник не найден в конфигурации или элемент
// недоступен → ИСКЛЮЧЕНИЕ: для читателей секций это и есть сигнал аварии
// (максимальная маска). Оборачивать в Попытку нельзя — см. комментарий перед
// PrivacyPublishDetails. Пустое Значение → пустая строка без исключения.
Функция ТекстПолитикиМаскирования() Экспорт

	ИмяСправочника = "MCP_Маскирование";
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		ВызватьИсключение "Справочник " + ИмяСправочника
			+ " не найден в конфигурации; политика маскирования недоступна.";
	КонецЕсли;

	// Привилегированный режим ОБЯЗАН быть снят до выхода — и на пути успеха, и
	// на пути исключения: снимок политики читается ДО выполнения пользовательского
	// запроса, и оставленный включённым режим означал бы выполнение этого запроса
	// в обход RLS. Попытка здесь НЕ гасит исключение (контракт «исключение наружу
	// = авария», см. PrivacyPublishDetails) — только восстанавливает режим и
	// пробрасывает дальше.
	БылПривилегированный = ПривилегированныйРежим();
	Если НЕ БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Текст = "";
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 "
			+ "Т.Значение КАК Значение "
			+ "ИЗ Справочник." + ИмяСправочника + " КАК Т "
			+ "ГДЕ Т.ИмяПредопределенныхДанных = &ИмяЭлемента";
		Запрос.УстановитьПараметр("ИмяЭлемента", "НастройкиМаскирования");
		Выборка = Запрос.Выполнить().Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			ВызватьИсключение "Предопределённый элемент НастройкиМаскирования справочника "
				+ ИмяСправочника + " недоступен; политика маскирования не прочитана.";
		КонецЕсли;
		Текст = Строка(Выборка.Значение);
	Исключение
		Если НЕ БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если НЕ БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// M-4 (§3.2). Рубильник маскирования — булев ключ privacy.enabled в
// СУЩЕСТВУЮЩЕЙ константе MCP_ServerConfig; новых констант не заводится.
// Ключа/секции/константы нет или JSON нечитаем → Истина: выключить защиту
// может только явно записанная false. Аварийный выход осознанно живёт не в
// справочнике политики: если его JSON испорчен, маскирование выключается
// правкой константы, без восстановления испорченного артефакта.
// Функция обязана быть дешёвой и НЕ обращаться к справочнику: её зовёт
// МаскироватьПоляДляLLM на каждый tool-result (M-15).
Функция МаскированиеВключено() Экспорт

	Попытка
		JSON = НастройкиСервера();
		Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
		Если НЕ ЭтоJSONОбъект(Privacy) Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат БулевоИзЗначения(ЗначениеJSON(Privacy, "enabled", Истина), Истина);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция СтрокаPrivacy(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ВидИзПолногоИмениТипаPrivacy(ИмяТипа)

	Части = СтрРазделить(СокрЛП(Строка(ИмяТипа)), ".", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Если ПустаяСтрока(Части[0]) ИЛИ ПустаяСтрока(Части[1]) Тогда
		Возврат "";
	КонецЕсли;

	НормВид = НормализоватьКлючPrivacy(Части[0]);
	Для Каждого Вид Из СтандартныеВидыМетаданных() Цикл
		Если НормализоватьКлючPrivacy(Вид) = НормВид Тогда
			Возврат Вид;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИмяОбъектаИзПолногоИмениPrivacy(ИмяТипа)

	Части = СтрРазделить(СокрЛП(Строка(ИмяТипа)), ".", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Части[1]);

КонецФункции

// Псевдоним строится из uuid ссылки. Виды без ссылок (регистры) и
// перечисления, у ссылки которых uuid нет, псевдонимы не поддерживают.
Функция ВидСоСсылкойPrivacy(Вид)

	Виды = Новый Массив;
	Виды.Добавить("Справочник");
	Виды.Добавить("Документ");
	Виды.Добавить("ПланСчетов");
	Виды.Добавить("ПланВидовХарактеристик");
	Виды.Добавить("ПланВидовРасчета");
	Виды.Добавить("ПланОбмена");
	Виды.Добавить("БизнесПроцесс");
	Виды.Добавить("Задача");

	НормВид = НормализоватьКлючPrivacy(Вид);
	Для Каждого Элемент Из Виды Цикл
		Если НормализоватьКлючPrivacy(Элемент) = НормВид Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Имя-подобное поле в списке масок распространяет маску на presentation
// ссылки этого типа: иначе название утекало бы через любую ссылку из
// другого объекта.
// P-1. ЕДИНЫЙ СЛОВАРЬ ИМЁН — единственное место, где имя ключа превращается в
// ПОНЯТИЕ. До него один факт «как зовут объект» описывали четыре словаря: линия
// масок сверялась русскими именами, линия персон своим перечнем, технический белый
// список третьим, ядро R-13 подстрокой по-русски. Ни один не был полон, и это дало
// измеренные дефекты: `presentation` закрыт, а `Представление` открыт; `inn`/`kpp`
// открыты при `ПолеЗакрытоPrivacy(тип, ИНН) = Да`; `full_name` открыт везде.
//
// Возвращается КАНОНИЧЕСКОЕ ПОНЯТИЕ, а не грубая роль, и это осознанно. Политика
// называет конкретное поле («ИНН»), а роль «идентификатор субъекта» закрыла бы по
// этой записи ещё и КПП, которого администратор не перечислял, — то есть «закрыто
// лишнее» в обмен на «закрыто недостающее». Роль там, где нужна именно роль,
// собирается из понятий (РольКлючаPrivacy).
//
// Двуязычие симметрично ПО ПОСТРОЕНИЮ: оба варианта отображаются в одно понятие, и
// добавить вариант можно только парой. Перечислением обходится любой словарь, но
// здесь перечисляются СИНОНИМЫ ОДНОГО ПОНЯТИЯ, а не поля, подлежащие закрытию:
// какие понятия закрыты, решает политика и роли, а не этот список.
//
// Вход нормализуется здесь же: и НормализоватьКлючPrivacy, и
// НормализоватьИмяПоляДляМаскированияLLM снимают «_», поэтому `full_name` и
// `fullname` приходят одной строкой.
Функция КанонПоляPrivacy(Ключ) Экспорт

	НормПоле = НормализоватьКлючPrivacy(Ключ);
	Если ПустаяСтрока(НормПоле) Тогда
		Возврат "";
	КонецЕсли;

	Если НормПоле = "наименование" ИЛИ НормПоле = "name" Тогда
		Возврат "наименование";
	КонецЕсли;
	Если НормПоле = "наименованиеполное" ИЛИ НормПоле = "полноенаименование"
		ИЛИ НормПоле = "fullname" ИЛИ НормПоле = "fulltitle" Тогда
		Возврат "наименованиеполное";
	КонецЕсли;
	Если НормПоле = "краткоенаименование" ИЛИ НормПоле = "shortname" Тогда
		Возврат "краткоенаименование";
	КонецЕсли;
	Если НормПоле = "представление" ИЛИ НормПоле = "presentation" Тогда
		Возврат "представление";
	КонецЕсли;
	Если НормПоле = "код" ИЛИ НормПоле = "code" Тогда
		Возврат "код";
	КонецЕсли;
	Если НормПоле = "инн" ИЛИ НормПоле = "inn" Тогда
		Возврат "инн";
	КонецЕсли;
	Если НормПоле = "кпп" ИЛИ НормПоле = "kpp" Тогда
		Возврат "кпп";
	КонецЕсли;
	Если НормПоле = "снилс" ИЛИ НормПоле = "snils" Тогда
		Возврат "снилс";
	КонецЕсли;
	Если НормПоле = "огрн" ИЛИ НормПоле = "ogrn" Тогда
		Возврат "огрн";
	КонецЕсли;
	Если НормПоле = "фио" ИЛИ НормПоле = "fio" Тогда
		Возврат "фио";
	КонецЕсли;

	Возврат НормПоле;

КонецФункции

// P-1. Роль понятия — там, где решение принимается по КЛАССУ ключа, а не по
// конкретному полю: «этой колонке годится код псевдонима» (имя объекта) против
// «этой не годится» (идентификатор субъекта — код склеил бы разные объекты).
//
// Пустая роль означает «понятие вне словаря»: НаименованиеБанка,
// НаименованиеНалоговогоОргана, НаименованиеОКВЭД сюда не попадают и остаются
// открытыми — это замеренная цена (проба П14), и она обязана сохраниться.
Функция РольКлючаPrivacy(Ключ) Экспорт

	Канон = КанонПоляPrivacy(Ключ);
	Если Канон = "наименование" ИЛИ Канон = "наименованиеполное"
		ИЛИ Канон = "краткоенаименование" Тогда
		Возврат "имя_объекта";
	КонецЕсли;
	Если Канон = "представление" Тогда
		Возврат "представление";
	КонецЕсли;
	Если Канон = "код" Тогда
		Возврат "служебный_код";
	КонецЕсли;
	Если Канон = "инн" ИЛИ Канон = "кпп" ИЛИ Канон = "снилс" ИЛИ Канон = "огрн" Тогда
		Возврат "идентификатор_субъекта";
	КонецЕсли;
	Если Канон = "фио" Тогда
		Возврат "имя_персоны";
	КонецЕсли;

	Возврат "";

КонецФункции

// Ключ роли «имя объекта», его представление ИЛИ служебный код. Используется там,
// где состав закрытых полей неизвестен (аварийный режим) и где проверяется само
// существование поля у источника. Для псевдонима типа брать НЕЛЬЗЯ — см.
// ПолеПодКодПсевдонимаPrivacy ниже.
Функция ПолеИмениОбъектаPrivacy(НормПоле) Экспорт

	Роль = РольКлючаPrivacy(НормПоле);
	Возврат Роль = "имя_объекта" ИЛИ Роль = "представление" ИЛИ Роль = "служебный_код";

КонецФункции

// Ключ, который ЗАМЕНЯЕТСЯ кодом псевдонима: имя объекта и его представление.
// `Код` сюда НЕ входит (решение 14.08.2026).
//
// Прежде входил, и включение одного флажка «Псевдоним» закрывало шесть полей,
// из которых администратор не отмечал ни одного, включая `Код`. Это
// противоречило собственному правилу проекта о различимости: `Код` не имя, он
// стабильный идентификатор, и через него обезличенные строки остаются
// различимыми и связываемыми между запросами. В ветке масок полей он уже был
// оставлен открытым (решение 11.08) — псевдоним оставался единственным местом,
// где он закрывался, то есть асимметрией, а не замыслом.
//
// Различимость при включённом псевдониме от этого не страдает, а усиливается:
// имя заменяется стабильным кодом псевдонима, а собственный `Код` объекта
// остаётся на месте.
Функция ПолеПодКодПсевдонимаPrivacy(НормПоле) Экспорт

	Роль = РольКлючаPrivacy(НормПоле);
	Возврат Роль = "имя_объекта" ИЛИ Роль = "представление";

КонецФункции

// Алгоритм обязан совпадать с НормализоватьКлючPrivacy в MCP_Security:
// именами типов и полей из конфига сравниваются ключи ответа.
Функция НормализоватьКлючPrivacy(Имя) Экспорт

	Текст = НРег(СокрЛП(Строка(Имя)));
	ПозДубликата = СтрНайти(Текст, "#");
	Если ПозДубликата > 1 Тогда
		Текст = Лев(Текст, ПозДубликата - 1);
	КонецЕсли;

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Текст = СтрЗаменить(Текст, "_", "");
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, ".", "");
	Текст = СтрЗаменить(Текст, "ё", "е");
	Возврат Текст;

КонецФункции

// ---- Лимиты ----------------------------------------------------------

Функция Лимиты() Экспорт

	Кеш = ПолучитьИзКеша("limits");
	Если Кеш <> Неопределено Тогда
		Возврат Кеш;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("max_limit", 1000);
	Результат.Вставить("max_query_rows", 1000);
	Результат.Вставить("max_report_rows", 5000);
	Результат.Вставить("max_tabular_section_rows", 100);
	Результат.Вставить("max_register_rows", 1000);
	Результат.Вставить("query_timeout_seconds", 15);
	Результат.Вставить("report_timeout_seconds", 60);
	// T-6, пункт 2. Потолок аргумента timeout_seconds у run_1c_query. Отдельный
	// ключ, а не привязка к report-потолку: отчёт СКД и запрос — разная природа
	// нагрузки, и подъём одного бюджета не должен молча поднимать другой.
	// Выбор зафиксирован словами по требованию ТЗ («решить в PR»).
	//
	// Потолки подняты до жёсткого предела (3600): дефолты исполнения остаются
	// 15/60, но клиент вправе попросить аргументом больше, а администратор —
	// сузить потолок константой (секция limits), не трогая код.
	Результат.Вставить("query_timeout_max_seconds", ЖесткийПределБюджетаВремениСекунд());
	Результат.Вставить("report_timeout_max_seconds", ЖесткийПределБюджетаВремениСекунд());
	Результат.Вставить("max_result_json_bytes", 5 * 1024 * 1024);
	Результат.Вставить("max_searched_types_per_call", 100);
	Результат.Вставить("max_string_length_in_response", 10000);

	ПрименитьПереопределенияЛимитов(Результат);

	ПоложитьВКеш("limits", Результат);
	Возврат Результат;

КонецФункции

// T-6. Эффективный потолок бюджета времени: настроенный потолок, но не ниже
// настроенного дефолта и не выше жёсткого предела.
//
// «Не ниже дефолта» — потому что дефолт задаёт администратор осознанно, и
// потолок ниже него сделал бы собственный дефолт недостижимым: ЦелоеИзАргумента
// обрезает по максимуму И значение аргумента, И значение по умолчанию. Ровно
// это и есть дефект T-6 п. 2 — после подъёма дефолта до 60 при потолке 60
// аргументом нельзя было попросить ни больше, ни осмысленно меньше.
//
// «Не выше жёсткого предела» — ограничение сверху обязательно и снятию
// настройкой не подлежит: таймаут постфактум (запрос дорабатывает до конца), а
// значения выше HTTP-таймаута публикации веб-сервера дают обрыв транспорта
// вместо ответа.
Функция ПотолокБюджетаВремени(Настроенный, Дефолт, ЖесткийПредел) Экспорт

	Результат = Настроенный;
	Если Результат < Дефолт Тогда
		Результат = Дефолт;
	КонецЕсли;
	Если Результат > ЖесткийПредел Тогда
		Результат = ЖесткийПредел;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Жёсткий предел бюджета времени — один на запросы и отчёты, единственный
// источник для схем инструментов и хендлеров: литерал в четырёх местах уже
// разъезжался (у отчёта потолок не читал конфиг вовсе).
//
// 3600 — час. Значение обязано быть не выше HTTP-таймаута публикации
// веб-сервера: таймаут здесь постфактум (запрос дорабатывает до конца и лишь
// потом сверяется с бюджетом), и если веб-сервер рвёт соединение раньше,
// клиент получает обрыв транспорта вместо ответа. Поднимая предел — поднимите
// Timeout/ProxyTimeout публикации и таймаут MCP-клиента.
Функция ЖесткийПределБюджетаВремениСекунд() Экспорт

	Возврат 3600;

КонецФункции

Процедура ПрименитьПереопределенияЛимитов(Лимиты)

	// Если в конфигурации есть константа MCP_ServerConfig — читаем JSON оттуда.
	Попытка
		JSON = НастройкиСервера();
		LimitsJSON = ЗначениеJSON(JSON, "limits", Неопределено);
		Если ЭтоJSONОбъект(LimitsJSON) Тогда
			Для Каждого КЗ Из LimitsJSON Цикл
				Если Лимиты.Свойство(КЗ.Ключ) Тогда
					Лимиты.Вставить(КЗ.Ключ, КЗ.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Молча игнорируем — используем значения по умолчанию.
	КонецПопытки;

КонецПроцедуры

