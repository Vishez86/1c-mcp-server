// ---- Кеш в течение сеанса -------------------------------------------
//
// В универсальной поставке ни сессионный параметр MCP_Cache, ни модуль
// "Использование возвращаемых значений" не гарантированы. Без работающего
// хранилища попытки кеширования в ПараметрыСеанса либо молча мимо проходят,
// либо приводили к разным экземплярам Соответствия в разных вызовах.
// Поэтому функции оставлены, но кеш по умолчанию выключен — лимиты и
// allowlist пересчитываются при каждом обращении. Если конфигурация
// объявляет общий модуль MCP_Cache с включённым кешированием возвращаемых
// значений или сессионный параметр MCP_Cache (тип ХранилищеЗначения /
// произвольный), функция ПолучитьХранилище может быть переопределена
// в расширении.

Функция ПолучитьИзКеша(Ключ)
	Возврат Неопределено;
КонецФункции

Процедура ПоложитьВКеш(Ключ, Значение)
	// no-op: см. комментарий выше.
КонецПроцедуры

Функция НастройкиСервера()

	ИмяКонстанты = "MCP_ServerConfig";
	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Значение = Константы[ИмяКонстанты].Получить();
	Если ПустаяСтрока(Значение) Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Возврат ПрочитатьJSONИзСтроки(Значение);

КонецФункции

Функция НастройкиHTTP()

	JSON = НастройкиСервера();
	HTTP = ЗначениеJSON(JSON, "http", Неопределено);
	Если ЭтоJSONОбъект(HTTP) Тогда
		Возврат HTTP;
	КонецЕсли;

	Возврат Новый Структура;

КонецФункции

Функция ПрочитатьJSONИзСтроки(Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

Функция ЭтоJSONОбъект(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ЗначениеJSON(Объект, Имя, ПоУмолчанию = Неопределено)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция БулевоИзЗначения(Значение, ПоУмолчанию)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если Текст = "TRUE" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "1" ИЛИ Текст = "YES" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Текст = "FALSE" ИЛИ Текст = "ЛОЖЬ" ИЛИ Текст = "0" ИЛИ Текст = "NO" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции
