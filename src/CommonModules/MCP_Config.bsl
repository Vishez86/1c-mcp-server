// MCP_Config.bsl
// ====================================================================
// Конфигурация и лимиты Universal 1C MCP Server.
// Загружает allowlist и серверные лимиты из константы / регистра / по умолчанию.
// Все функции read-only и могут вызываться из любого серверного контекста.
// ====================================================================

Функция ИмяСервера() Экспорт
	Возврат "universal-1c-mcp";
КонецФункции

Функция ВерсияСервера() Экспорт
	Возврат "0.1.0";
КонецФункции

Функция ВерсияПротоколаMCP() Экспорт
	Возврат "2025-11-25";
КонецФункции

Функция СерверReadOnly() Экспорт
	Возврат Истина;
КонецФункции

// ---- Лимиты ----------------------------------------------------------

Функция Лимиты() Экспорт

	Кеш = ПолучитьИзКеша("limits");
	Если Кеш <> Неопределено Тогда
		Возврат Кеш;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("default_limit", 50);
	Результат.Вставить("max_limit", 1000);
	Результат.Вставить("max_query_rows", 1000);
	Результат.Вставить("max_report_rows", 5000);
	Результат.Вставить("max_tabular_section_rows", 100);
	Результат.Вставить("max_register_rows", 1000);
	Результат.Вставить("query_timeout_seconds", 15);
	Результат.Вставить("report_timeout_seconds", 60);
	Результат.Вставить("metadata_cache_ttl_seconds", 300);
	Результат.Вставить("max_result_json_bytes", 5 * 1024 * 1024);
	Результат.Вставить("max_searched_types_per_call", 100);
	Результат.Вставить("max_string_length_in_response", 10000);

	ПрименитьПереопределенияЛимитов(Результат);

	ПоложитьВКеш("limits", Результат);
	Возврат Результат;

КонецФункции

Процедура ПрименитьПереопределенияЛимитов(Лимиты)

	// Если в конфигурации есть константа MCP_ServerConfig — читаем JSON оттуда.
	Попытка
		ИмяКонстанты = "MCP_ServerConfig";
		Если Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено Тогда
			Значение = Константы[ИмяКонстанты].Получить();
			Если НЕ ПустаяСтрока(Значение) Тогда
				JSON = ПрочитатьJSONИзСтроки(Значение);
				Если ТипЗнч(JSON) = Тип("Структура") И JSON.Свойство("limits") Тогда
					Для Каждого КЗ Из JSON.limits Цикл
						Если Лимиты.Свойство(КЗ.Ключ) Тогда
							Лимиты.Вставить(КЗ.Ключ, КЗ.Значение);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Молча игнорируем — используем значения по умолчанию.
	КонецПопытки;

КонецПроцедуры

// ---- Allowlist -------------------------------------------------------

Функция Allowlist() Экспорт

	Кеш = ПолучитьИзКеша("allowlist");
	Если Кеш <> Неопределено Тогда
		Возврат Кеш;
	КонецЕсли;

	// Базовая конфигурация: deny by default.
	Результат = Новый Структура;
	Результат.Вставить("default_policy", "deny");
	Результат.Вставить("admin_users", Новый Массив);
	Результат.Вставить("allowed_kinds", СтандартныеВидыМетаданных());
	Результат.Вставить("denied_objects", Новый Массив);
	Результат.Вставить("allowed_metadata", Новый Соответствие);
	Результат.Вставить("allowed_base_urls", Новый Массив);

	// Попытка загрузить из константы MCP_Allowlist.
	Попытка
		ИмяКонстанты = "MCP_Allowlist";
		Если Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено Тогда
			Значение = Константы[ИмяКонстанты].Получить();
			Если НЕ ПустаяСтрока(Значение) Тогда
				JSON = ПрочитатьJSONИзСтроки(Значение);
				ОбъединитьAllowlist(Результат, JSON);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Безопасный fallback.
	КонецПопытки;

	ПоложитьВКеш("allowlist", Результат);
	Возврат Результат;

КонецФункции

Процедура ОбъединитьAllowlist(Результат, JSON)

	Если ТипЗнч(JSON) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если JSON.Свойство("default_policy") Тогда
		Результат.default_policy = Строка(JSON.default_policy);
	КонецЕсли;

	Если JSON.Свойство("admin_users") И ТипЗнч(JSON.admin_users) = Тип("Массив") Тогда
		Результат.admin_users = JSON.admin_users;
	КонецЕсли;

	Если JSON.Свойство("allowed_kinds") И ТипЗнч(JSON.allowed_kinds) = Тип("Массив") Тогда
		Результат.allowed_kinds = JSON.allowed_kinds;
	КонецЕсли;

	Если JSON.Свойство("denied_objects") И ТипЗнч(JSON.denied_objects) = Тип("Массив") Тогда
		Результат.denied_objects = JSON.denied_objects;
	КонецЕсли;

	Если JSON.Свойство("allowed_metadata") Тогда
		Соответствие = Новый Соответствие;
		// JSON-объект приходит как Структура.
		Если ТипЗнч(JSON.allowed_metadata) = Тип("Структура") Тогда
			Для Каждого КЗ Из JSON.allowed_metadata Цикл
				Соответствие.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЦикла;
		КонецЕсли;
		Результат.allowed_metadata = Соответствие;
	КонецЕсли;

	Если JSON.Свойство("allowed_base_urls") И ТипЗнч(JSON.allowed_base_urls) = Тип("Массив") Тогда
		Результат.allowed_base_urls = JSON.allowed_base_urls;
	КонецЕсли;

КонецПроцедуры

Функция СтандартныеВидыМетаданных() Экспорт

	Массив = Новый Массив;
	Массив.Добавить("Справочник");
	Массив.Добавить("Документ");
	Массив.Добавить("Перечисление");
	Массив.Добавить("РегистрСведений");
	Массив.Добавить("РегистрНакопления");
	Массив.Добавить("РегистрБухгалтерии");
	Массив.Добавить("РегистрРасчета");
	Массив.Добавить("ПланСчетов");
	Массив.Добавить("ПланВидовХарактеристик");
	Массив.Добавить("ПланВидовРасчета");
	Массив.Добавить("БизнесПроцесс");
	Массив.Добавить("Задача");
	Массив.Добавить("Отчет");
	Массив.Добавить("Обработка");
	Возврат Массив;

КонецФункции

// ---- Кеш в течение сеанса -------------------------------------------
//
// В универсальной поставке ни сессионный параметр MCP_Cache, ни модуль
// "Использование возвращаемых значений" не гарантированы. Без работающего
// хранилища попытки кеширования в ПараметрыСеанса либо молча мимо проходят,
// либо приводили к разным экземплярам Соответствия в разных вызовах.
// Поэтому функции оставлены, но кеш по умолчанию выключен — лимиты и
// allowlist пересчитываются при каждом обращении. Если конфигурация
// объявляет общий модуль MCP_Cache с включённым кешированием возвращаемых
// значений или сессионный параметр MCP_Cache (тип ХранилищеЗначения /
// произвольный), функция ПолучитьХранилище может быть переопределена
// в расширении.

Функция ПолучитьИзКеша(Ключ)
	Возврат Неопределено;
КонецФункции

Процедура ПоложитьВКеш(Ключ, Значение)
	// no-op: см. комментарий выше.
КонецПроцедуры

Функция ПрочитатьJSONИзСтроки(Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции
