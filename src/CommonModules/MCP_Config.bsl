// MCP_Config.bsl
// ====================================================================
// Конфигурация и лимиты Universal 1C MCP Server.
// Загружает allowlist и серверные лимиты из констант / по умолчанию.
// Все функции read-only и могут вызываться из любого серверного контекста.
// ====================================================================

Функция ИмяСервера() Экспорт
	Возврат "universal-1c-mcp";
КонецФункции

Функция ВерсияСервера() Экспорт
	Возврат "0.1.0";
КонецФункции

Функция ВерсияПротоколаMCP() Экспорт
	Возврат "2025-11-25";
КонецФункции

Функция ПоддерживаемыеВерсииПротоколаMCP() Экспорт

	Версии = Новый Массив;
	Версии.Добавить("2025-11-25");
	Версии.Добавить("2025-06-18");
	Версии.Добавить("2025-03-26");
	Возврат Версии;

КонецФункции

Функция ВерсияПротоколаMCPПоддерживается(Версия) Экспорт

	Для Каждого ПоддерживаемаяВерсия Из ПоддерживаемыеВерсииПротоколаMCP() Цикл
		Если Строка(ПоддерживаемаяВерсия) = Строка(Версия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СогласоватьВерсиюПротоколаMCP(ВерсияКлиента) Экспорт

	Если ВерсияКлиента <> Неопределено
		И ВерсияКлиента <> Null
		И ВерсияПротоколаMCPПоддерживается(ВерсияКлиента) Тогда
		Возврат Строка(ВерсияКлиента);
	КонецЕсли;

	Возврат ВерсияПротоколаMCP();

КонецФункции

Функция СерверReadOnly() Экспорт
	Возврат Истина;
КонецФункции

Функция РазрешенныеOriginsMCP() Экспорт

	Результат = Новый Массив;

	Попытка
		HTTP = НастройкиHTTP();
		Origins = ЗначениеJSON(HTTP, "allowed_origins", Неопределено);
		Если ТипЗнч(Origins) = Тип("Массив") Тогда
			Возврат Origins;
		КонецЕсли;
	Исключение
		// Если настройки недоступны, не блокируем server-to-server MCP-клиентов.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция БазовыйURLWebКлиента() Экспорт

	Результат = "";

	Попытка
		JSON = НастройкиСервера();
		WebClient = ЗначениеJSON(JSON, "web_client", Неопределено);
		Если ЭтоJSONОбъект(WebClient) Тогда
			BaseURL = ЗначениеJSON(WebClient, "base_url", "");
			Если BaseURL <> Неопределено И BaseURL <> Null Тогда
				Результат = СокрЛП(Строка(BaseURL));
			КонецЕсли;
		КонецЕсли;

		// Совместимый короткий вариант для простых конфигов.
		Если ПустаяСтрока(Результат) Тогда
			BaseURL = ЗначениеJSON(JSON, "web_client_base_url", "");
			Если BaseURL <> Неопределено И BaseURL <> Null Тогда
				Результат = СокрЛП(Строка(BaseURL));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = "";
	КонецПопытки;

	Возврат НормализоватьBaseURLКонфигурации(Результат);

КонецФункции

Функция ПоляМаскированияLLM() Экспорт

	Результат = Новый Массив;

	Попытка
		JSON = НастройкиСервера();
		Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
		Поля = Неопределено;
		Если ЭтоJSONОбъект(Privacy) Тогда
			Поля = ЗначениеJSON(Privacy, "masked_fields", Неопределено);
		КонецЕсли;

		// Совместимый fallback для конфигов, где список положили в корень JSON.
		Если ТипЗнч(Поля) <> Тип("Массив") Тогда
			Поля = ЗначениеJSON(JSON, "llm_masked_fields", Неопределено);
		КонецЕсли;

		Если ТипЗнч(Поля) = Тип("Массив") Тогда
			Для Каждого Поле Из Поля Цикл
				Если Поле = Неопределено ИЛИ Поле = Null Тогда
					Продолжить;
				КонецЕсли;
				ИмяПоля = СокрЛП(Строка(Поле));
				Если НЕ ПустаяСтрока(ИмяПоля) Тогда
					Результат.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Ошибка privacy-настроек не должна ломать read-only tools.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ИнформацияМаскированияLLM() Экспорт

	Поля = ПоляМаскированияLLM();
	ПсевдонимыОрганизаций = ПсевдонимыОрганизацийLLM();
	ПсевдонимыПерсон = ПсевдонимыПерсонLLM();
	Включено = Поля.Количество() > 0 ИЛИ ПсевдонимыОрганизаций.enabled ИЛИ ПсевдонимыПерсон.enabled;

	Результат = Новый Структура;
	Результат.Вставить("enabled", Включено);
	Результат.Вставить("masked_fields", Поля);
	Результат.Вставить("string_mask", "XXXXXXX");
	Результат.Вставить("date_mask", "1900-01-01T00:00:00");
	Результат.Вставить("organization_aliases", ИнформацияПсевдонимовОрганизацийLLM(ПсевдонимыОрганизаций));
	Результат.Вставить("person_aliases", ИнформацияПсевдонимовПерсонLLM(ПсевдонимыПерсон));
	Если Включено Тогда
		Результат.Вставить("guidance", ОписаниеМаскированияLLM());
	Иначе
		Результат.Вставить("guidance", "Privacy-маскирование отключено; значения полей возвращаются согласно allowlist и правам пользователя.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ОписаниеМаскированияLLM() Экспорт

	Поля = ПоляМаскированияLLM();
	ПсевдонимыОрганизаций = ПсевдонимыОрганизацийLLM();
	ПсевдонимыПерсон = ПсевдонимыПерсонLLM();
	Части = Новый Массив;

	Если Поля.Количество() > 0 Тогда
		Части.Добавить("Активно privacy-маскирование. Эти поля намеренно недоступны LLM-клиентам: "
			+ СтрСоединить(Поля, ", ")
			+ ". Значения заменяются на XXXXXXX, даты — на 1900-01-01T00:00:00.");
	КонецЕсли;

	Если ПсевдонимыОрганизаций.enabled Тогда
		Части.Добавить("Активны privacy-псевдонимы организаций: полные названия организаций не передаются в чат, вместо них возвращаются стабильные коды вида "
			+ ПсевдонимыОрганизаций.prefix
			+ "XXXXXX. Для расшифровки пользователь открывает navigation_url в web-клиенте 1С, если настроен web_client.base_url, иначе в 1С.");
	КонецЕсли;

	Если ПсевдонимыПерсон.enabled Тогда
		Части.Добавить("Активны privacy-псевдонимы физических лиц и сотрудников: ФИО и чувствительные персональные реквизиты не передаются в чат, вместо ссылок возвращаются стабильные коды вида "
			+ ПсевдонимыПерсон.physical_person_prefix
			+ "XXXXXX или "
			+ ПсевдонимыПерсон.employee_prefix
			+ "XXXXXX. Для расшифровки пользователь открывает navigation_url в web-клиенте 1С, если настроен web_client.base_url, иначе в 1С.");
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрСоединить(Части, " ")
		+ " Не пытайтесь обходить эту политику альтернативными запросами.";

КонецФункции

Функция ПсевдонимыОрганизацийLLM() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("enabled", Ложь);
	Результат.Вставить("prefix", "Орг-");
	Результат.Вставить("include_navigation_url", Истина);
	Результат.Вставить("hidden_alias", "Орг-скрыто");
	Результат.Вставить("resolution", "open_navigation_url_in_1c");

	Попытка
		JSON = НастройкиСервера();
		Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
		Если НЕ ЭтоJSONОбъект(Privacy) Тогда
			Возврат Результат;
		КонецЕсли;

		Aliases = ЗначениеJSON(Privacy, "organization_aliases", Неопределено);
		Если НЕ ЭтоJSONОбъект(Aliases) Тогда
			Возврат Результат;
		КонецЕсли;

		Результат.enabled = БулевоИзЗначения(ЗначениеJSON(Aliases, "enabled", Ложь), Ложь);
		PrefixValue = ЗначениеJSON(Aliases, "prefix", Результат.prefix);
		Если PrefixValue = Неопределено ИЛИ PrefixValue = Null Тогда
			Prefix = "";
		Иначе
			Prefix = СокрЛП(Строка(PrefixValue));
		КонецЕсли;
		Если НЕ ПустаяСтрока(Prefix) Тогда
			Результат.prefix = Prefix;
			Результат.hidden_alias = Prefix + "скрыто";
		КонецЕсли;
		Результат.include_navigation_url = БулевоИзЗначения(
			ЗначениеJSON(Aliases, "include_navigation_url", Истина), Истина);
	Исключение
		// Ошибка privacy-настроек не должна ломать read-only tools.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ИнформацияПсевдонимовОрганизацийLLM(ПсевдонимыОрганизаций = Неопределено) Экспорт

	Если ПсевдонимыОрганизаций = Неопределено Тогда
		ПсевдонимыОрганизаций = ПсевдонимыОрганизацийLLM();
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("enabled", ПсевдонимыОрганизаций.enabled);
	Результат.Вставить("prefix", ПсевдонимыОрганизаций.prefix);
	Результат.Вставить("hidden_alias", ПсевдонимыОрганизаций.hidden_alias);
	Результат.Вставить("include_navigation_url", ПсевдонимыОрганизаций.include_navigation_url);
	Результат.Вставить("resolution", ПсевдонимыОрганизаций.resolution);
	Возврат Результат;

КонецФункции

Функция ПсевдонимыПерсонLLM() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("enabled", Ложь);
	Результат.Вставить("physical_person_prefix", "ФЛ-");
	Результат.Вставить("employee_prefix", "Сотр-");
	Результат.Вставить("include_navigation_url", Истина);
	Результат.Вставить("hidden_alias", "ФЛ-скрыто");
	Результат.Вставить("resolution", "open_navigation_url_in_1c");
	ЧувствительныеПоля = Новый Массив;
	ЧувствительныеПоля.Добавить("Фамилия");
	ЧувствительныеПоля.Добавить("Имя");
	ЧувствительныеПоля.Добавить("Отчество");
	ЧувствительныеПоля.Добавить("СерияПаспорта");
	ЧувствительныеПоля.Добавить("НомерПаспорта");
	ЧувствительныеПоля.Добавить("ИндивидуальныйНомер");
	ЧувствительныеПоля.Добавить("СтраховойНомер");
	ЧувствительныеПоля.Добавить("ДатаРождения");
	Результат.Вставить("sensitive_fields", ЧувствительныеПоля);

	Попытка
		JSON = НастройкиСервера();
		Privacy = ЗначениеJSON(JSON, "privacy", Неопределено);
		Если НЕ ЭтоJSONОбъект(Privacy) Тогда
			Возврат Результат;
		КонецЕсли;

		Aliases = ЗначениеJSON(Privacy, "person_aliases", Неопределено);
		Если НЕ ЭтоJSONОбъект(Aliases) Тогда
			Возврат Результат;
		КонецЕсли;

		Результат.enabled = БулевоИзЗначения(ЗначениеJSON(Aliases, "enabled", Ложь), Ложь);
		PhysicalPrefix = НепустойПрефиксПсевдонима(Aliases, "physical_person_prefix", Результат.physical_person_prefix);
		EmployeePrefix = НепустойПрефиксПсевдонима(Aliases, "employee_prefix", Результат.employee_prefix);
		Если НЕ ПустаяСтрока(PhysicalPrefix) Тогда
			Результат.physical_person_prefix = PhysicalPrefix;
			Результат.hidden_alias = PhysicalPrefix + "скрыто";
		КонецЕсли;
		Если НЕ ПустаяСтрока(EmployeePrefix) Тогда
			Результат.employee_prefix = EmployeePrefix;
		КонецЕсли;
		Результат.include_navigation_url = БулевоИзЗначения(
			ЗначениеJSON(Aliases, "include_navigation_url", Истина), Истина);
	Исключение
		// Ошибка privacy-настроек не должна ломать read-only tools.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ИнформацияПсевдонимовПерсонLLM(ПсевдонимыПерсон = Неопределено) Экспорт

	Если ПсевдонимыПерсон = Неопределено Тогда
		ПсевдонимыПерсон = ПсевдонимыПерсонLLM();
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("enabled", ПсевдонимыПерсон.enabled);
	Результат.Вставить("physical_person_prefix", ПсевдонимыПерсон.physical_person_prefix);
	Результат.Вставить("employee_prefix", ПсевдонимыПерсон.employee_prefix);
	Результат.Вставить("hidden_alias", ПсевдонимыПерсон.hidden_alias);
	Результат.Вставить("include_navigation_url", ПсевдонимыПерсон.include_navigation_url);
	Результат.Вставить("sensitive_fields", ПсевдонимыПерсон.sensitive_fields);
	Результат.Вставить("resolution", ПсевдонимыПерсон.resolution);
	Возврат Результат;

КонецФункции

Функция НепустойПрефиксПсевдонима(Aliases, ИмяПоля, ПоУмолчанию)

	ЗначениеПоля = ЗначениеJSON(Aliases, ИмяПоля, ПоУмолчанию);
	Если ЗначениеПоля = Неопределено ИЛИ ЗначениеПоля = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ЗначениеПоля));

КонецФункции

// ---- Лимиты ----------------------------------------------------------

Функция Лимиты() Экспорт

	Кеш = ПолучитьИзКеша("limits");
	Если Кеш <> Неопределено Тогда
		Возврат Кеш;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("max_limit", 1000);
	Результат.Вставить("max_query_rows", 1000);
	Результат.Вставить("max_report_rows", 5000);
	Результат.Вставить("max_tabular_section_rows", 100);
	Результат.Вставить("max_register_rows", 1000);
	Результат.Вставить("query_timeout_seconds", 15);
	Результат.Вставить("report_timeout_seconds", 60);
	Результат.Вставить("max_result_json_bytes", 5 * 1024 * 1024);
	Результат.Вставить("max_searched_types_per_call", 100);
	Результат.Вставить("max_string_length_in_response", 10000);

	ПрименитьПереопределенияЛимитов(Результат);

	ПоложитьВКеш("limits", Результат);
	Возврат Результат;

КонецФункции

Процедура ПрименитьПереопределенияЛимитов(Лимиты)

	// Если в конфигурации есть константа MCP_ServerConfig — читаем JSON оттуда.
	Попытка
		JSON = НастройкиСервера();
		LimitsJSON = ЗначениеJSON(JSON, "limits", Неопределено);
		Если ЭтоJSONОбъект(LimitsJSON) Тогда
			Для Каждого КЗ Из LimitsJSON Цикл
				Если Лимиты.Свойство(КЗ.Ключ) Тогда
					Лимиты.Вставить(КЗ.Ключ, КЗ.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Молча игнорируем — используем значения по умолчанию.
	КонецПопытки;

КонецПроцедуры

// ---- Allowlist -------------------------------------------------------

Функция Allowlist() Экспорт

	Источник = ТекстКонстантыAllowlist();

	// Базовая конфигурация для тестового MCP: разрешаем все стандартные виды.
	// При необходимости ограничения задаются явно через константу MCP_Allowlist.
	Результат = Новый Структура;
	Результат.Вставить("restrict_data_access", Ложь);
	Результат.Вставить("default_policy", "allow");
	Результат.Вставить("config_warnings", Новый Массив);
	Результат.Вставить("admin_users", Новый Массив);
	Результат.Вставить("allowed_kinds", СтандартныеВидыМетаданных());
	Результат.Вставить("denied_objects", Новый Массив);
	Результат.Вставить("allowed_metadata", Новый Соответствие);
	Результат.Вставить("allowed_base_urls", Новый Массив);

	// Попытка загрузить из константы MCP_Allowlist.
	Попытка
		Если НЕ ПустаяСтрока(Источник) Тогда
			JSON = ПрочитатьJSONИзСтроки(Источник);
			ОбъединитьAllowlist(Результат, JSON);
		КонецЕсли;
	Исключение
		// Безопасный fallback.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ТекстКонстантыAllowlist()

	Попытка
		ИмяКонстанты = "MCP_Allowlist";
		Если Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено Тогда
			Возврат Строка(Константы[ИмяКонстанты].Получить());
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

Процедура ОбъединитьAllowlist(Результат, JSON)

	Если НЕ ЭтоJSONОбъект(JSON) Тогда
		Возврат;
	КонецЕсли;

	DefaultPolicy = ЗначениеJSON(JSON, "default_policy", Неопределено);
	Если DefaultPolicy <> Неопределено И DefaultPolicy <> Null Тогда
		Policy = НормализоватьDefaultPolicy(DefaultPolicy);
		Если ПустаяСтрока(Policy) Тогда
			Результат.config_warnings.Добавить("default_policy должен быть allow или deny; значение проигнорировано: " + Строка(DefaultPolicy));
		Иначе
			Результат.default_policy = Policy;
		КонецЕсли;
	КонецЕсли;

	RestrictDataAccess = ЗначениеJSON(JSON, "restrict_data_access", Неопределено);
	Если RestrictDataAccess <> Неопределено И RestrictDataAccess <> Null Тогда
		Результат.restrict_data_access = БулевоИзЗначения(RestrictDataAccess, Ложь);
	КонецЕсли;

	AdminUsers = ЗначениеJSON(JSON, "admin_users", Неопределено);
	Если ТипЗнч(AdminUsers) = Тип("Массив") Тогда
		Результат.admin_users = AdminUsers;
	КонецЕсли;

	AllowedKinds = ЗначениеJSON(JSON, "allowed_kinds", Неопределено);
	Если ТипЗнч(AllowedKinds) = Тип("Массив") Тогда
		Результат.allowed_kinds = AllowedKinds;
	КонецЕсли;

	DeniedObjects = ЗначениеJSON(JSON, "denied_objects", Неопределено);
	Если ТипЗнч(DeniedObjects) = Тип("Массив") Тогда
		Результат.denied_objects = DeniedObjects;
	КонецЕсли;

	AllowedMetadata = ЗначениеJSON(JSON, "allowed_metadata", Неопределено);
	Если ЭтоJSONОбъект(AllowedMetadata) Тогда
		Соответствие = Новый Соответствие;
		// Ключи metadata часто содержат точку, поэтому JSON может прийти как Соответствие.
		Для Каждого КЗ Из AllowedMetadata Цикл
			Соответствие.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		Результат.allowed_metadata = Соответствие;
	КонецЕсли;

	AllowedBaseURLs = ЗначениеJSON(JSON, "allowed_base_urls", Неопределено);
	Если ТипЗнч(AllowedBaseURLs) = Тип("Массив") Тогда
		Результат.allowed_base_urls = AllowedBaseURLs;
	КонецЕсли;

КонецПроцедуры

