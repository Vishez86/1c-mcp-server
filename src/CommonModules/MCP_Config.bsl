Процедура ПрименитьПереопределенияQueryExamples(Настройки)

	Попытка
		JSON = НастройкиСервера();
		Секция = ЗначениеJSON(JSON, "query_examples", Неопределено);
		Если НЕ ЭтоJSONОбъект(Секция) Тогда
			Возврат;
		КонецЕсли;
