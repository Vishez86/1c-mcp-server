// MCP_JSONRPC.bsl
// ====================================================================
// JSON-RPC 2.0 + MCP dispatcher.
// Точка входа из HTTP-сервиса. Разбирает JSON-RPC запрос и маршрутизирует на:
//   - initialize
//   - tools/list
//   - tools/call
//   - resources/list
//   - resources/read
//   - ping
// ====================================================================

Функция ОбработатьЗапрос(ТекстТелаЗапроса) Экспорт

	Попытка
		Запрос = РазобратьJSON(ТекстТелаЗапроса);
	Исключение
		Детали = Новый Структура;
		Детали.Вставить("stage", "json_parse");
		Детали.Вставить("raw_exception", ОписаниеОшибки());
		Детали.Вставить("request_body", ТекстТелаЗапроса);
		Возврат СохранитьJSON(ОшибкаJSONRPC(Null, -32700, "Parse error: " + ОписаниеОшибки(), Детали));
	КонецПопытки;

	// Если массив — batch.
	Если ТипЗнч(Запрос) = Тип("Массив") Тогда
		// JSON-RPC 2.0: пустой массив — Invalid Request с единственным error-объектом.
		Если Запрос.Количество() = 0 Тогда
			Возврат СохранитьJSON(ОшибкаJSONRPC(Null, -32600, "Invalid Request: empty batch", Неопределено));
		КонецЕсли;
		Ответы = Новый Массив;
		Для Каждого Эл Из Запрос Цикл
			Ответ = ОбработатьОдинЗапрос(Эл);
			// Уведомления (без id) не получают ответа в JSON-RPC 2.0.
			Если Ответ <> Неопределено Тогда
				Ответы.Добавить(Ответ);
			КонецЕсли;
		КонецЦикла;
		Если Ответы.Количество() = 0 Тогда
			// Batch только из уведомлений — пустое тело.
			Возврат "";
		КонецЕсли;
		Возврат СохранитьJSON(Ответы);
	КонецЕсли;

	Ответ = ОбработатьОдинЗапрос(Запрос);
	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СохранитьJSON(Ответ);

КонецФункции

Функция ОбработатьОдинЗапрос(Запрос)

	Если НЕ ЭтоJSONОбъект(Запрос) Тогда
		Возврат ОшибкаJSONRPC(Null, -32600, "Invalid Request", Неопределено);
	КонецЕсли;

	// id: согласно JSON-RPC 2.0 отсутствие свойства означает уведомление,
	// тогда как Null/строка/число — это ответный id.
	ЕстьID = СвойствоПрисутствует(Запрос, "id");
	ID = ?(ЕстьID, ЗначениеJSON(Запрос, "id", Null), Null);
	ВерсияJSONRPC = ЗначениеJSON(Запрос, "jsonrpc", "");
	Method = ЗначениеJSON(Запрос, "method", "");
	Параметры = ЗначениеJSON(Запрос, "params", Неопределено);

	Если ТипЗнч(ВерсияJSONRPC) <> Тип("Строка") ИЛИ ВерсияJSONRPC <> "2.0" Тогда
		// Это уже не валидная notification: возвращаем Invalid Request с id=null,
		// если корректный id невозможно определить.
		Возврат ОшибкаJSONRPC(?(ЕстьID, ID, Null), -32600, "Invalid Request: jsonrpc must be 2.0", Неопределено);
	КонецЕсли;

	Если ЭтоJSONRPCОтвет(Запрос) Тогда
		// Streamable HTTP допускает входящие JSON-RPC responses от клиента.
		// Сервер сейчас не отправляет клиенту requests, поэтому response просто принимаем.
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Method) <> Тип("Строка") ИЛИ ПустаяСтрока(Method) Тогда
		// Без method объект не является валидной notification, поэтому отвечаем
		// Invalid Request даже при отсутствии id.
		Возврат ОшибкаJSONRPC(?(ЕстьID, ID, Null), -32600, "Missing method", Неопределено);
	КонецЕсли;

	Если НЕ МетодПоддерживается(Method) Тогда
		Возврат ?(ЕстьID, ОшибкаJSONRPC(ID, -32601, "Method not found: " + Method, Неопределено), Неопределено);
	КонецЕсли;

	Если Method = "resources/read" И НЕ ПараметрыResourcesReadКорректны(Параметры) Тогда
		Возврат ?(ЕстьID, ОшибкаJSONRPC(ID, -32602, "Invalid params: missing uri", Неопределено), Неопределено);
	КонецЕсли;

	Попытка
		Результат = МаршрутизироватьМетод(Method, Параметры);
		Возврат ?(ЕстьID, УспехJSONRPC(ID, Результат), Неопределено);
	Исключение
		// Прикладные tool errors уже завёрнуты в Result, сюда попадают только сбои протокола.
		ТекстОшибкиJSONRPC = ОписаниеОшибки();
		Попытка
			ЗаписьЖурналаРегистрации("MCP.jsonrpc.error",
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибкиJSONRPC);
		Исключение
		КонецПопытки;
		Детали = Новый Структура;
		Детали.Вставить("stage", "jsonrpc_route");
		Детали.Вставить("method", Method);
		Детали.Вставить("params", Параметры);
		Детали.Вставить("raw_exception", ТекстОшибкиJSONRPC);
		Возврат ?(ЕстьID, ОшибкаJSONRPC(ID, -32603, "Internal error: " + ТекстОшибкиJSONRPC, Детали), Неопределено);
	КонецПопытки;

КонецФункции

Функция СвойствоПрисутствует(Объект, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Объект.Свойство(Имя, Значение);
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из Объект Цикл
			Если КЗ.Ключ = Имя Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ПараметрыResourcesReadКорректны(Параметры)

	Если НЕ ЭтоJSONОбъект(Параметры) Тогда
		Возврат Ложь;
	КонецЕсли;

	URI = ЗначениеJSON(Параметры, "uri", "");
	Если ТипЗнч(URI) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ПустаяСтрока(URI);

КонецФункции

Функция МетодПоддерживается(Method)

	Возврат Method = "initialize"
		ИЛИ Method = "notifications/initialized"
		ИЛИ Method = "tools/list"
		ИЛИ Method = "tools/call"
		ИЛИ Method = "resources/list"
		ИЛИ Method = "resources/read"
		ИЛИ Method = "ping";

КонецФункции

Функция МаршрутизироватьМетод(Method, Параметры)

	Если Method = "initialize" Тогда
		Возврат Initialize(Параметры);
	ИначеЕсли Method = "notifications/initialized" Тогда
		Возврат Новый Структура;
	ИначеЕсли Method = "tools/list" Тогда
		Возврат ToolsList(Параметры);
	ИначеЕсли Method = "tools/call" Тогда
		Возврат ToolsCall(Параметры);
	ИначеЕсли Method = "resources/list" Тогда
		Возврат ResourcesList(Параметры);
	ИначеЕсли Method = "resources/read" Тогда
		Возврат ResourcesRead(Параметры);
	ИначеЕсли Method = "ping" Тогда
		Возврат Новый Структура;
	КонецЕсли;

	ВызватьИсключение "Unknown method: " + Method;

КонецФункции

// ---- MCP-методы --------------------------------------------------

Функция Initialize(Параметры)

	ВерсияКлиента = Неопределено;
	Если ЭтоJSONОбъект(Параметры) Тогда
		ВерсияКлиента = ЗначениеJSON(Параметры, "protocolVersion", Неопределено);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", MCP_Config.СогласоватьВерсиюПротоколаMCP(ВерсияКлиента));

	Capabilities = Новый Структура;
	Capabilities.Вставить("tools", Новый Структура);
	Capabilities.Вставить("resources", Новый Структура);
	Результат.Вставить("capabilities", Capabilities);

	ServerInfo = Новый Структура;
	ServerInfo.Вставить("name", MCP_Config.ИмяСервера());
	ServerInfo.Вставить("version", MCP_Config.ВерсияСервера());
	Результат.Вставить("serverInfo", ServerInfo);

	Возврат Результат;

КонецФункции

Функция ToolsList(Параметры)

	Результат = Новый Структура;
	Результат.Вставить("tools", MCP_Tools.СписокTools());
	ОписаниеМаскирования = MCP_Config.ОписаниеМаскированияLLM();
	Если НЕ ПустаяСтрока(ОписаниеМаскирования) Тогда
		Подсказки = Новый Массив;
		Подсказки.Добавить(ОписаниеМаскирования);
		Результат.Вставить("server_hints", Подсказки);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ToolsCall(Параметры)

	ИмяТула = "";
	Аргументы = Неопределено;
	Если ЭтоJSONОбъект(Параметры) Тогда
		ИмяТула = ЗначениеJSON(Параметры, "name", "");
		Аргументы = ЗначениеJSON(Параметры, "arguments", Неопределено);
	КонецЕсли;

	Если ПустаяСтрока(ИмяТула) Тогда
		Возврат MCP_Tools.СформироватьОшибкуРезультата(
			MCP_Errors.Код_InvalidArguments(),
			"Не указано имя tool (params.name).",
			Неопределено,
			Строка(Новый УникальныйИдентификатор));
	КонецЕсли;

	Возврат MCP_Tools.ВыполнитьИнструмент(ИмяТула, Аргументы);

КонецФункции

Функция ResourcesList(Параметры)

	Ресурсы = Новый Массив;

	Стр1 = Новый Структура;
	Стр1.Вставить("uri", "1c://metadata");
	Стр1.Вставить("name", "Metadata index");
	Стр1.Вставить("mimeType", "application/json");
	Ресурсы.Добавить(Стр1);

	Стр2 = Новый Структура;
	Стр2.Вставить("uri", "1c://context/current-user");
	Стр2.Вставить("name", "Current user context");
	Стр2.Вставить("mimeType", "application/json");
	Ресурсы.Добавить(Стр2);

	Для Каждого РесурсЗнаний Из MCP_Knowledge.СписокРесурсов() Цикл
		Ресурсы.Добавить(РесурсЗнаний);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("resources", Ресурсы);
	Возврат Результат;

КонецФункции

Функция ResourcesRead(Параметры)

	URI = "";
	Если ЭтоJSONОбъект(Параметры) Тогда
		URI = ЗначениеJSON(Параметры, "uri", "");
	КонецЕсли;

	Если ПустаяСтрока(URI) Тогда
		ВызватьИсключение "Не указан uri ресурса.";
	КонецЕсли;

	Результат = Новый Структура;
	Содержимое = Новый Массив;

	Если URI = "1c://metadata" Тогда
		// Возвращаем только разрешённые объекты, чтобы статичный ресурс не светил allowlist-нарушения.
		ТЗ = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
		Видимые = Новый Массив;
		Для Каждого Стр Из ТЗ Цикл
			Если MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
				Запись = Новый Структура;
				Запись.Вставить("Вид", Стр.Вид);
				Запись.Вставить("Имя", Стр.Имя);
				Запись.Вставить("ПолноеИмя", Стр.ПолноеИмя);
				Запись.Вставить("Синоним", Стр.Синоним);
				Видимые.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		Блок = Новый Структура;
		Блок.Вставить("uri", URI);
		Блок.Вставить("mimeType", "application/json");
		Блок.Вставить("text", СохранитьJSON(MCP_Security.МаскироватьПоляДляLLM(Видимые)));
		Содержимое.Добавить(Блок);
	ИначеЕсли URI = "1c://context/current-user" Тогда
		Результат_Тула = MCP_Tools_Impl.GetCurrentUserContext(Новый Структура);
		Блок = Новый Структура;
		Блок.Вставить("uri", URI);
		Блок.Вставить("mimeType", "application/json");
		Блок.Вставить("text", СохранитьJSON(MCP_Security.МаскироватьПоляДляLLM(Результат_Тула)));
		Содержимое.Добавить(Блок);
	ИначеЕсли MCP_Knowledge.ЭтоРесурсЗнаний(URI) Тогда
		Блок = Новый Структура;
		Блок.Вставить("uri", URI);
		Блок.Вставить("mimeType", "text/markdown");
		Блок.Вставить("text", MCP_Knowledge.ПрочитатьРесурс(URI));
		Содержимое.Добавить(Блок);
	Иначе
		ВызватьИсключение "Resource not found: " + URI;
	КонецЕсли;

	Результат.Вставить("contents", Содержимое);
	Возврат Результат;

КонецФункции

// ---- JSON-RPC helpers -------------------------------------------

Функция УспехJSONRPC(ID, Результат)

	Стр = Новый Структура;
	Стр.Вставить("jsonrpc", "2.0");
	Стр.Вставить("id", ?(ID = Неопределено, Null, ID));
	Стр.Вставить("result", Результат);
	Возврат Стр;

КонецФункции

Функция ОшибкаJSONRPC(ID, Код, Сообщение, Данные)

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Если Данные <> Неопределено Тогда
		Ошибка.Вставить("data", MCP_Security.МаскироватьПоляДляLLM(Данные));
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("jsonrpc", "2.0");
	Стр.Вставить("id", ?(ID = Неопределено, Null, ID));
	Стр.Вставить("error", Ошибка);
	Возврат Стр;

КонецФункции

Функция РазобратьJSON(Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция СохранитьJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ПодготовитьКЗаписиJSON(Значение));
	Возврат Запись.Закрыть();
КонецФункции

Функция ПодготовитьКЗаписиJSON(Значение)

	Если Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			РезультатМассив.Добавить(ПодготовитьКЗаписиJSON(Элемент));
		КонецЦикла;
		Возврат РезультатМассив;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗначения = Тип("Соответствие")
		ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		РезультатСтруктура = Новый Структура;
		НомерПоля = 0;
		Для Каждого КЗ Из Значение Цикл
			Ключ = Строка(КЗ.Ключ);
			ПодготовленноеЗначение = ПодготовитьКЗаписиJSON(КЗ.Значение);
			Попытка
				РезультатСтруктура.Вставить(Ключ, ПодготовленноеЗначение);
			Исключение
				РезультатСтруктура.Вставить("_field_" + НомерПоля, ПодготовленноеЗначение);
			КонецПопытки;
			НомерПоля = НомерПоля + 1;
		КонецЦикла;
		Возврат РезультатСтруктура;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ЭтоJSONОбъект(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ЭтоJSONRPCОтвет(Запрос)

	Если НЕ СвойствоПрисутствует(Запрос, "id") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СвойствоПрисутствует(Запрос, "method") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СвойствоПрисутствует(Запрос, "result")
		ИЛИ СвойствоПрисутствует(Запрос, "error");

КонецФункции

Функция ЗначениеJSON(Объект, Имя, ПоУмолчанию = Неопределено)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции
