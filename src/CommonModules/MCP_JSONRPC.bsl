// MCP_JSONRPC.bsl
// ====================================================================
// JSON-RPC 2.0 + MCP dispatcher.
// Точка входа из HTTP-сервиса. Разбирает JSON-RPC запрос и маршрутизирует на:
//   - initialize
//   - tools/list
//   - tools/call
//   - resources/list
//   - resources/read
//   - ping
// ====================================================================

Функция ОбработатьЗапрос(ТекстТелаЗапроса) Экспорт

	Попытка
		Запрос = РазобратьJSON(ТекстТелаЗапроса);
	Исключение
		Возврат СохранитьJSON(ОшибкаJSONRPC(Null, -32700, "Parse error", ОписаниеОшибки()));
	КонецПопытки;

	// Если массив — batch.
	Если ТипЗнч(Запрос) = Тип("Массив") Тогда
		Ответы = Новый Массив;
		Для Каждого Эл Из Запрос Цикл
			Ответы.Добавить(ОбработатьОдинЗапрос(Эл));
		КонецЦикла;
		Возврат СохранитьJSON(Ответы);
	КонецЕсли;

	Ответ = ОбработатьОдинЗапрос(Запрос);
	Возврат СохранитьJSON(Ответ);

КонецФункции

Функция ОбработатьОдинЗапрос(Запрос)

	Если ТипЗнч(Запрос) <> Тип("Структура") Тогда
		Возврат ОшибкаJSONRPC(Null, -32600, "Invalid Request", Неопределено);
	КонецЕсли;

	ID = Неопределено;
	Запрос.Свойство("id", ID);

	Method = "";
	Запрос.Свойство("method", Method);

	Параметры = Неопределено;
	Запрос.Свойство("params", Параметры);

	Если ТипЗнч(Method) <> Тип("Строка") Тогда
		Возврат ОшибкаJSONRPC(ID, -32600, "Missing method", Неопределено);
	КонецЕсли;

	Если ПустаяСтрока(Method) Тогда
		Возврат ОшибкаJSONRPC(ID, -32600, "Missing method", Неопределено);
	КонецЕсли;

	Если НЕ МетодПоддерживается(Method) Тогда
		Возврат ОшибкаJSONRPC(ID, -32601, "Method not found: " + Method, Неопределено);
	КонецЕсли;

	Если Method = "resources/read" И НЕ ПараметрыResourcesReadКорректны(Параметры) Тогда
		Возврат ОшибкаJSONRPC(ID, -32602, "Invalid params: missing uri", Неопределено);
	КонецЕсли;

	Попытка
		Результат = МаршрутизироватьМетод(Method, Параметры);
		Возврат УспехJSONRPC(ID, Результат);
	Исключение
		ТекстОш = ОписаниеОшибки();
		// Прикладные tool errors уже завёрнуты в Result, сюда попадают только сбои протокола.
		Возврат ОшибкаJSONRPC(ID, -32603, "Internal error", ТекстОш);
	КонецПопытки;

КонецФункции

Функция ПараметрыResourcesReadКорректны(Параметры)

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URI = "";
	Параметры.Свойство("uri", URI);
	Если ТипЗнч(URI) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ПустаяСтрока(URI);

КонецФункции

Функция МетодПоддерживается(Method)

	Возврат Method = "initialize"
		ИЛИ Method = "tools/list"
		ИЛИ Method = "tools/call"
		ИЛИ Method = "resources/list"
		ИЛИ Method = "resources/read"
		ИЛИ Method = "ping";

КонецФункции

Функция МаршрутизироватьМетод(Method, Параметры)

	Если Method = "initialize" Тогда
		Возврат Initialize(Параметры);
	ИначеЕсли Method = "tools/list" Тогда
		Возврат ToolsList(Параметры);
	ИначеЕсли Method = "tools/call" Тогда
		Возврат ToolsCall(Параметры);
	ИначеЕсли Method = "resources/list" Тогда
		Возврат ResourcesList(Параметры);
	ИначеЕсли Method = "resources/read" Тогда
		Возврат ResourcesRead(Параметры);
	ИначеЕсли Method = "ping" Тогда
		Возврат Новый Структура;
	КонецЕсли;

	ВызватьИсключение "Unknown method: " + Method;

КонецФункции

// ---- MCP-методы --------------------------------------------------

Функция Initialize(Параметры)

	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", MCP_Config.ВерсияПротоколаMCP());

	Capabilities = Новый Структура;
	Capabilities.Вставить("tools", Новый Структура);
	Capabilities.Вставить("resources", Новый Структура);
	Результат.Вставить("capabilities", Capabilities);

	ServerInfo = Новый Структура;
	ServerInfo.Вставить("name", MCP_Config.ИмяСервера());
	ServerInfo.Вставить("version", MCP_Config.ВерсияСервера());
	Результат.Вставить("serverInfo", ServerInfo);

	Возврат Результат;

КонецФункции

Функция ToolsList(Параметры)

	Результат = Новый Структура;
	Результат.Вставить("tools", MCP_Tools.СписокTools());
	Возврат Результат;

КонецФункции

Функция ToolsCall(Параметры)

	ИмяТула = "";
	Аргументы = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Параметры.Свойство("name", ИмяТула);
		Параметры.Свойство("arguments", Аргументы);
	КонецЕсли;

	Если ПустаяСтрока(ИмяТула) Тогда
		Возврат MCP_Tools.СформироватьОшибкуРезультата(
			MCP_Errors.Код_InvalidArguments(),
			"Не указано имя tool (params.name).",
			Неопределено,
			Строка(Новый УникальныйИдентификатор));
	КонецЕсли;

	Возврат MCP_Tools.Выполнить(ИмяТула, Аргументы);

КонецФункции

Функция ResourcesList(Параметры)

	Ресурсы = Новый Массив;

	Стр1 = Новый Структура;
	Стр1.Вставить("uri", "1c://metadata");
	Стр1.Вставить("name", "Metadata index");
	Стр1.Вставить("mimeType", "application/json");
	Ресурсы.Добавить(Стр1);

	Стр2 = Новый Структура;
	Стр2.Вставить("uri", "1c://context/current-user");
	Стр2.Вставить("name", "Current user context");
	Стр2.Вставить("mimeType", "application/json");
	Ресурсы.Добавить(Стр2);

	Результат = Новый Структура;
	Результат.Вставить("resources", Ресурсы);
	Возврат Результат;

КонецФункции

Функция ResourcesRead(Параметры)

	URI = "";
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Параметры.Свойство("uri", URI);
	КонецЕсли;

	Если ПустаяСтрока(URI) Тогда
		ВызватьИсключение "Не указан uri ресурса.";
	КонецЕсли;

	Результат = Новый Структура;
	Содержимое = Новый Массив;

	Если URI = "1c://metadata" Тогда
		Текст = СохранитьJSON(MCP_Metadata.ПолучитьВсеОбъектыМетаданных().Выгрузить(, "Вид,Имя,ПолноеИмя,Синоним"));
		Блок = Новый Структура;
		Блок.Вставить("uri", URI);
		Блок.Вставить("mimeType", "application/json");
		Блок.Вставить("text", Текст);
		Содержимое.Добавить(Блок);
	ИначеЕсли URI = "1c://context/current-user" Тогда
		Результат_Тула = MCP_Tools_Impl.GetCurrentUserContext(Новый Структура);
		Блок = Новый Структура;
		Блок.Вставить("uri", URI);
		Блок.Вставить("mimeType", "application/json");
		Блок.Вставить("text", СохранитьJSON(Результат_Тула));
		Содержимое.Добавить(Блок);
	Иначе
		ВызватьИсключение "Resource not found: " + URI;
	КонецЕсли;

	Результат.Вставить("contents", Содержимое);
	Возврат Результат;

КонецФункции

// ---- JSON-RPC helpers -------------------------------------------

Функция УспехJSONRPC(ID, Результат)

	Стр = Новый Структура;
	Стр.Вставить("jsonrpc", "2.0");
	Стр.Вставить("id", ID);
	Стр.Вставить("result", Результат);
	Возврат Стр;

КонецФункции

Функция ОшибкаJSONRPC(ID, Код, Сообщение, Данные)

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Если Данные <> Неопределено Тогда
		Ошибка.Вставить("data", Данные);
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("jsonrpc", "2.0");
	Стр.Вставить("id", ID);
	Стр.Вставить("error", Ошибка);
	Возврат Стр;

КонецФункции

Функция РазобратьJSON(Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция СохранитьJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции
