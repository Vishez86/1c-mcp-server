// MCP_Query.bsl
// ====================================================================
// Безопасное выполнение и валидация запросов 1С.
// Запрос всегда read-only для постоянных данных: разрешены временные таблицы
// ПОМЕСТИТЬ/ИНДЕКСИРОВАТЬ ПО/УНИЧТОЖИТЬ, запрещены изменения прикладных данных.
// Всегда применяется server-side limit.
// ====================================================================

// Валидация запроса перед выполнением.
//
// Возвращает структуру { valid, errors[], warnings[], detected_objects[], detected_parameters[], estimated_risk }
//
Функция Валидировать(ТекстЗапроса, Параметры, Строгий = Истина, Объяснить = Истина,
	КешДиагностики = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("valid", Истина);
	Результат.Вставить("errors", Новый Массив);
	Результат.Вставить("warnings", Новый Массив);
	Результат.Вставить("detected_objects", Новый Массив);
	Результат.Вставить("detected_parameters", Новый Массив);
	Результат.Вставить("estimated_risk", "low");

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ДобавитьОшибку(Результат, "empty_query", "Текст запроса пуст.", Неопределено);
		Возврат Результат;
	КонецЕсли;

	// Запрещённые конструкции.
	ЗапрещенныеКлючевыеСлова = Новый Массив;
	ЗапрещенныеКлючевыеСлова.Добавить("ИЗМЕНИТЬ");
	ЗапрещенныеКлючевыеСлова.Добавить("ДЛЯ ИЗМЕНЕНИЯ");
	ЗапрещенныеКлючевыеСлова.Добавить("ПРАВА ДОСТУПА");
	ЗапрещенныеКлючевыеСлова.Добавить("UPDATE");
	ЗапрещенныеКлючевыеСлова.Добавить("INSERT");
	ЗапрещенныеКлючевыеСлова.Добавить("DELETE");
	// DROP в этом списке нет: в языке запросов 1С это англ. эквивалент
	// УНИЧТОЖИТЬ — read-only очистка временной таблицы внутри пакета (issue #61).
	// Безусловный запрет отклонял легитимный пакет, тогда как кириллический
	// УНИЧТОЖИТЬ в той же позиции проходил. Вместо запрета по токену —
	// контекстная проверка ДобавитьОшибкуУничтоженияНеВременнойТаблицы ниже.
	ЗапрещенныеКлючевыеСлова.Добавить("FOR UPDATE");
	ЗапрещенныеКлючевыеСлова.Добавить("GRANT");

	ВерхнийТекст = ВРег(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	НормализованныйВерхнийТекст = НормализоватьТекстДляПоиска(ВерхнийТекст);
	ТекстДляПоиска = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	ПозицияSelect = НайтиПозициюВнешнегоSelect(ТекстДляПоиска);
	Если ПозицияSelect = 0 Тогда
		ДобавитьОшибку(Результат, "select_required",
			"Разрешены только запросы, начинающиеся с ВЫБРАТЬ/SELECT.", Неопределено);
	ИначеЕсли ПозицияSelect <> ПропуститьПробелы(ТекстДляПоиска, 1) Тогда
		ДобавитьОшибку(Результат, "select_required",
			"Запрос должен начинаться с ВЫБРАТЬ/SELECT после пробелов и комментариев.", Неопределено);
	КонецЕсли;

	Для Каждого КС Из ЗапрещенныеКлючевыеСлова Цикл
		Если СтрНайти(НормализованныйВерхнийТекст, " " + ВРег(КС) + " ") > 0 Тогда
			ДобавитьОшибку(Результат, "forbidden_keyword",
				"Запрещённая конструкция: " + КС, КС);
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(НормализованныйВерхнийТекст, " ИМЕЯ ") > 0 Тогда
		ДобавитьОшибку(Результат, "invalid_1c_query_keyword",
			"ИМЕЯ не является ключевым словом языка запросов 1С. Для условий по агрегатам используйте ИМЕЮЩИЕ.",
			"ИМЕЯ");
	КонецЕсли;

	Если СодержитWildcardSelect(НормализованныйВерхнийТекст) Тогда
		ДобавитьОшибку(Результат, "wildcard_select_forbidden",
			"ВЫБРАТЬ * запрещён: перечислите разрешённые поля явно.", "*");
	КонецЕсли;

	ПакетныйЗапрос = СодержитПакетныеЗапросы(ТекстДляПоиска);
	ИспользуютсяВременныеТаблицы = ИспользуетВременныеТаблицы(НормализованныйВерхнийТекст);
	Если ИспользуютсяВременныеТаблицы И НЕ ПакетныйЗапрос Тогда
		ДобавитьОшибку(Результат, "temporary_table_package_required",
			"Временные таблицы должны использоваться в пакетном запросе с финальным SELECT/ВЫБРАТЬ, чтобы сервер вернул табличный результат.", "ПОМЕСТИТЬ");
	ИначеЕсли ПакетныйЗапрос И НЕ ИспользуютсяВременныеТаблицы Тогда
		ДобавитьОшибку(Результат, "batch_query_forbidden",
			"Пакетные запросы разрешены только для создания, индексации, чтения или уничтожения временных таблиц.", ";");
	ИначеЕсли ПакетныйЗапрос И НЕ ПоследняяКомандаПакетаНачинаетсяСSelect(ТекстДляПоиска) Тогда
		ДобавитьОшибку(Результат, "batch_query_final_select_required",
			"Последняя команда пакетного запроса должна быть SELECT/ВЫБРАТЬ: сервер возвращает только финальный табличный результат.", ";");
	КонецЕсли;

	ВременныеТаблицы = ИменаВременныхТаблиц(ТекстДляПоиска);
	ДобавитьОшибкуУничтоженияНеВременнойТаблицы(Результат, ТекстДляПоиска, ВременныеТаблицы);

	// HR-07 fail-closed: ошибочная privacy-политика с deny-записями блокирует
	// запросы до исправления настройки — молча продолжить значило бы оставить
	// защищаемый тип открытым.
	Для Каждого ОшибкаPrivacy Из MCP_Config.ОшибкиКонфигурацииPrivacy() Цикл
		ДобавитьОшибку(Результат, "privacy_config_error", ОшибкаPrivacy, "privacy");
	КонецЦикла;

	// Поиск используемых таблиц метаданных. Проверяем именно источники после
	// ИЗ/FROM/СОЕДИНЕНИЕ/JOIN: иначе неизвестный источник мог пройти мимо
	// allowlist, если рядом в запросе упоминался разрешённый тип.
	ИсточникиЗапроса = НайтиИсточникиЗапроса(ТекстДляПоиска);
	ИспользуемыеТипы = Новый Массив;
	НайденныеТипы = Новый Соответствие;
	Для Каждого Источник Из ИсточникиЗапроса Цикл
		Если ПустаяСтрока(Источник.full_name) Тогда
			Если ВременнаяТаблицаРазрешена(ВременныеТаблицы, Источник.raw) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьОшибку(Результат, "unknown_query_source",
				"Источник запроса не является разрешённым объектом метаданных: " + Источник.raw,
				Источник.raw);
			Продолжить;
		КонецЕсли;
		Если НайденныеТипы.Получить(Источник.full_name) = Неопределено Тогда
			НайденныеТипы.Вставить(Источник.full_name, Истина);
			ИспользуемыеТипы.Добавить(Источник.full_name);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Т Из ИспользуемыеТипы Цикл
		Результат.detected_objects.Добавить(Т);
		Если Метаданные.НайтиПоПолномуИмени(Т) = Неопределено Тогда
			ДобавитьОшибку(Результат, "metadata_not_found",
				"Объект метаданных не найден: " + Т, Т, ПодсказкаОбъектаДругогоВида(Т));
		ИначеЕсли НЕ MCP_Security.ТипРазрешен(Т) Тогда
			ДобавитьОшибку(Результат, "type_not_allowed",
				"Тип запрещён allowlist: " + Т, Т);
		Иначе
			Для Каждого СкрытоеПоле Из MCP_Security.СкрытыеПоля(Т) Цикл
				Если ПолеВстречаетсяВТексте(ВерхнийТекст, НормализованныйВерхнийТекст, СкрытоеПоле) Тогда
					ДобавитьОшибку(Результат, "field_not_allowed",
						"Запрос обращается к скрытому полю: " + Т + "." + СкрытоеПоле,
						Т + "." + СкрытоеПоле);
				КонецЕсли;
			КонецЦикла;
			// HR-01 проверяется отдельно, после цикла: принадлежность поля
			// закрытому типу разрешается по псевдонимам источников и
			// разыменованию, а не по вхождению имени в текст запроса.
		КонецЕсли;
	КонецЦикла;
	// HR-01/HR-02/HR-03/HR-04: жёсткие запреты privacy по разрешённой
	// принадлежности поля, включая разыменование и функции представления.
	Для Каждого Нарушение Из ЗакрытыеОбращенияPrivacy(ТекстДляПоиска) Цикл
		ДобавитьОшибку(Результат, "privacy_denied_field",
			"Обращение закрыто privacy-политикой (mode: deny): " + Нарушение.type + "." + Нарушение.field + ".",
			Нарушение.path,
			"Работайте через Ссылку: выбор, соединение, отбор и группировка по ссылке разрешены, названия возвращаются стабильными псевдонимами.");
	КонецЦикла;

	ДобавитьОшибкиСубконтоДтКтОсновнойТаблицы(Результат, ИсточникиЗапроса, ТекстДляПоиска);
	ДобавитьОшибкиРазыменованияВПараметрахБухгалтерскихОстатков(Результат, ТекстДляПоиска);
	ДобавитьОшибкиСигнатурВиртуальныхТаблиц(Результат, ТекстДляПоиска);
	ДобавитьОшибкиИдентификаторовЗапроса(Результат, ТекстДляПоиска);
	ДобавитьОшибкуИнлайнМассиваСубконто(Результат, ТекстДляПоиска);
	ДобавитьОшибкуНеподдерживаемойФункцииЗапроса(Результат, ТекстДляПоиска);
	ДобавитьОшибкуПрямогоСоединенияСВиртуальнойТаблицей(Результат, ТекстДляПоиска);
	ДобавитьОшибкуОтбораПоВТвоВнешнемГде(Результат, ТекстДляПоиска);
	// Второй аргумент — ИСХОДНЫЙ текст: объявленное исключение живёт в комментарии,
	// а в ТекстДляПоиска комментарии уже заменены пробелами.
	ДобавитьОшибкуОсновнойТаблицыРегистра(Результат, ТекстДляПоиска, ТекстЗапроса);
	ДобавитьОшибкуПоляВнешнегоСоединенияБезЕстьNull(Результат, ТекстДляПоиска);
	ДобавитьОшибкуПустойСсылкиБезПроверки(Результат, ИсточникиЗапроса, ТекстДляПоиска);
	ДобавитьПредупрежденияJOINТабличнойЧастиСРегистр(Результат, ИсточникиЗапроса, ТекстДляПоиска);
	ДобавитьПредупрежденияJOINСубконтоРегистра(Результат, ИсточникиЗапроса, ТекстДляПоиска);
	ДобавитьПредупрежденияКоллизииПсевдонимаСТабличнойЧастью(Результат, ТекстДляПоиска, КешДиагностики);

	// Параметры.
	НайденныеПараметры = НайтиПараметры(ТекстДляПоиска);
	Результат.detected_parameters = НайденныеПараметры;

	Если Параметры = Неопределено Тогда
		Для Каждого ИмяП Из НайденныеПараметры Цикл
			Результат.warnings.Добавить("Параметр &" + ИмяП + " не передан.");
		КонецЦикла;
	Иначе
		Для Каждого ИмяП Из НайденныеПараметры Цикл
			Если НЕ ПараметрПередан(Параметры, ИмяП) Тогда
				Результат.warnings.Добавить("Параметр &" + ИмяП + " не передан.");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Проверка наличия лимита.
	ЯвныйЛимит = ОписаниеЯвногоЛимита(ТекстЗапроса);
	Если ЯвныйЛимит.present Тогда
		Если НЕ ЯвныйЛимит.numeric Тогда
			ДобавитьОшибку(Результат, "explicit_limit_not_numeric",
				"Явное ограничение ПЕРВЫЕ/TOP должно быть числовым литералом.", ЯвныйЛимит.keyword);
		ИначеЕсли ЯвныйЛимит.value > MCP_Config.Лимиты().max_query_rows Тогда
			ДобавитьОшибку(Результат, "explicit_limit_too_high",
				"Явное ограничение превышает server-side максимум " + MCP_Config.Лимиты().max_query_rows + ".", ЯвныйЛимит.keyword);
		КонецЕсли;
		Если ЯвныйЛимит.Свойство("digits_follow") И ЯвныйЛимит.digits_follow Тогда
			Результат.warnings.Добавить(
				"После ограничения " + ЯвныйЛимит.keyword + " " + Строка(ЯвныйЛимит.value)
				+ " идёт ещё одно число. Если это разделитель тысяч, лимит фактически равен "
				+ Строка(ЯвныйЛимит.value) + "; если это числовая константа списка выборки — всё верно.");
		КонецЕсли;
	ИначеЕсли НайтиПозициюВнешнегоSelect(ТекстДляПоиска) > 0 Тогда
		Результат.warnings.Добавить(
			"Запрос не содержит явного ограничения ПЕРВЫЕ N. Будет применён server-side limit.");
	КонецЕсли;

	Если Объяснить Тогда
		ПодсказкиЗапроса = MCP_Knowledge.ПодсказкиДляЗапроса(ТекстЗапроса);
		Если ПодсказкиЗапроса.Количество() > 0 Тогда
			Результат.Вставить("query_guidance", ПодсказкиЗапроса);
		КонецЕсли;
		БезопасноПрисоединитьДоменныеПодсказки(Результат, ТекстЗапроса);
	КонецЕсли;

	// Оценка риска.
	Если Результат.errors.Количество() > 0 Тогда
		Результат.valid = Ложь;
		Результат.estimated_risk = "blocked";
	ИначеЕсли Результат.warnings.Количество() > 0 Тогда
		Результат.estimated_risk = "medium";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выполняет запрос с лимитом и таймаутом.
// Возвращает { columns, rows, row_count, truncated, next_cursor, duration_ms, warnings, validation? }
Функция ВыполнитьЗапросСОграничениями(
	ТекстЗапроса, Параметры, Лимит, TimeoutSeconds = Неопределено, Курсор = "",
	IncludeNavigationURL = Ложь, IncludeValidation = Ложь, IncludeGuidance = Ложь,
	CorrelationID = "", ValidateBeforeRun = Истина) Экспорт

	ИсходныйТекстЗапроса = ТекстЗапроса;
	PreFlight = ПодготовитьЗапросПередВыполнением(ТекстЗапроса, Параметры);
	ТекстЗапроса = PreFlight.query;
	Параметры = PreFlight.parameters;

	// Кеш интроспекции метаданных на время одного запроса: общий для валидации,
	// pre-flight проверок и post-error диагностики. Межвызовного кеша нет —
	// MCP_Config.ПолучитьИзКеша осознанно no-op, состояние в модуле запрещено.
	КешДиагностики = Новый Соответствие;

	// Проверка безопасности находится внутри execution path, чтобы её нельзя было
	// обойти прямым вызовом модуля или клиентским флагом validate_before_run=false.
	Валидация = Валидировать(ТекстЗапроса, Параметры, Истина, Истина, КешДиагностики);
	Если НЕ Валидация.valid Тогда
		ДеталиВалидации = Новый Структура;
		ДеталиВалидации.Вставить("validation_errors", Валидация.errors);
		ДеталиВалидации.Вставить("validation_warnings", Валидация.warnings);
		ДеталиВалидации.Вставить("detected_objects", Валидация.detected_objects);
		ДеталиВалидации.Вставить("detected_parameters", Валидация.detected_parameters);
		ДеталиВалидации.Вставить("estimated_risk", Валидация.estimated_risk);
		Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
			ДеталиВалидации.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
			ДеталиВалидации.Вставить("query_original", ИсходныйТекстЗапроса);
			ДеталиВалидации.Вставить("query_effective", ТекстЗапроса);
		КонецЕсли;
		QueryGuidance = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidance) Тогда
			ДеталиВалидации.Вставить("query_guidance", QueryGuidance);
		КонецЕсли;
		DomainGuidance = Неопределено;
		Если Валидация.Свойство("domain_guidance", DomainGuidance) Тогда
			ДеталиВалидации.Вставить("domain_guidance", DomainGuidance);
		КонецЕсли;
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryValidationFailed(),
			"Запрос не прошёл проверку.", ДеталиВалидации);
	КонецЕсли;

	// Pre-flight проверка полей виртуальных таблиц (A-01: внутри execution path, до
	// Запрос.Выполнить(); её нельзя обойти флагом validate_before_run=false).
	// Кеш разделяется с post-error диагностикой (F-08, A-03).
	ДиагностикаPreFlight = Неопределено;
	Попытка
		ДиагностикаPreFlight = ПроверитьПоляВиртуальныхТаблицПередВыполнением(
			ТекстЗапроса, Валидация, КешДиагностики);
	Исключение
		// A-06: сбой интроспекции/парсинга НЕ должен ронять run_1c_query — деградация на движок.
		Валидация.warnings.Добавить(
			"Pre-flight проверка полей виртуальных таблиц пропущена из-за внутренней ошибки: " + ОписаниеОшибки());
		ДиагностикаPreFlight = Неопределено;
	КонецПопытки;
	Если ДиагностикаPreFlight <> Неопределено Тогда
		ДеталиPreFlight = Новый Структура;
		ДеталиPreFlight.Вставить("stage", "pre_flight_virtual_table_field");
		ДеталиPreFlight.Вставить("query_original", ИсходныйТекстЗапроса);
		ДеталиPreFlight.Вставить("query_effective", ТекстЗапроса);
		ДеталиPreFlight.Вставить("validation_warnings", Валидация.warnings);
		Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
			ДеталиPreFlight.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
		КонецЕсли;
		QueryGuidancePF = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidancePF) Тогда
			ДеталиPreFlight.Вставить("query_guidance", QueryGuidancePF);
		КонецЕсли;
		DomainGuidancePF = Неопределено;
		Если Валидация.Свойство("domain_guidance", DomainGuidancePF) Тогда
			ДеталиPreFlight.Вставить("domain_guidance", DomainGuidancePF);
		КонецЕсли;
		// F6-fix: если клиент передал validate_before_run=false, а pre-flight всё равно
		// отклонил запрос — явно сообщаем, что флаг проигнорирован (A-01: pre-flight
		// нельзя отключить флагом). Блокировка при этом сохраняется.
		Если НЕ ValidateBeforeRun Тогда
			ПредупрежденияPF = Новый Массив;
			ПредупрежденияPF.Добавить(
				"validate_before_run=false проигнорирован: pre-flight-проверка полей виртуальных таблиц обязательна и не отключается флагом.");
			ДиагностикаPreFlight.Вставить("warnings", ПредупрежденияPF);
		КонецЕсли;
		ДеталиPreFlight.Вставить("diagnostics", ДиагностикаPreFlight);
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ValidationFailedBeforeRun(),
			"Запрос отклонён до выполнения: поле виртуальной таблицы не существует.", ДеталиPreFlight);
	КонецЕсли;

	// Pre-flight проверка источников и полей обычных таблиц (F-01…F-03): та же
	// точка блокировки и та же деградация, что у проверки виртуальных таблиц.
	ДиагностикаИсточников = Неопределено;
	Попытка
		ДиагностикаИсточников = ПроверитьИсточникиИПоляПередВыполнением(
			ТекстЗапроса, Валидация, КешДиагностики);
	Исключение
		// Сбой интроспекции/разбора НЕ должен ронять run_1c_query — деградация на движок.
		Валидация.warnings.Добавить(
			"Pre-flight проверка источников и полей пропущена из-за внутренней ошибки: " + ОписаниеОшибки());
		ДиагностикаИсточников = Неопределено;
	КонецПопытки;
	Если ДиагностикаИсточников <> Неопределено Тогда
		ДеталиИсточников = Новый Структура;
		ДеталиИсточников.Вставить("stage", "validation");
		ДеталиИсточников.Вставить("pre_flight_stage", "pre_flight_source_field");
		ДеталиИсточников.Вставить("query_original", ИсходныйТекстЗапроса);
		ДеталиИсточников.Вставить("query_effective", ТекстЗапроса);
		ДеталиИсточников.Вставить("validation_warnings", Валидация.warnings);
		Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
			ДеталиИсточников.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
		КонецЕсли;
		QueryGuidanceSF = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidanceSF) Тогда
			ДеталиИсточников.Вставить("query_guidance", QueryGuidanceSF);
		КонецЕсли;
		DomainGuidanceSF = Неопределено;
		Если Валидация.Свойство("domain_guidance", DomainGuidanceSF) Тогда
			ДеталиИсточников.Вставить("domain_guidance", DomainGuidanceSF);
		КонецЕсли;
		Если НЕ ValidateBeforeRun Тогда
			ПредупрежденияSF = Новый Массив;
			ПредупрежденияSF.Добавить(
				"validate_before_run=false проигнорирован: pre-flight-проверка источников и полей обязательна и не отключается флагом.");
			ДиагностикаИсточников.Вставить("warnings", ПредупрежденияSF);
		КонецЕсли;
		ДеталиИсточников.Вставить("diagnostics", ДиагностикаИсточников);
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ValidationFailedBeforeRun(),
			СообщениеОтказаPreFlightИсточника(ДиагностикаИсточников), ДеталиИсточников);
	КонецЕсли;

	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;
	Если Лимит > MCP_Config.Лимиты().max_query_rows Тогда
		Лимит = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	ЛимитВыборки = Смещение + Лимит + 1;
	Если ЛимитВыборки > MCP_Config.Лимиты().max_query_rows Тогда
		ЛимитВыборки = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	// Гарантируем server-side limit, если в запросе нет ПЕРВЫЕ.
	ТекстЗапросаLimited = ПрименитьЛимит(ТекстЗапроса, ЛимитВыборки);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаLimited;
	УстановитьПараметрыЗапроса(Запрос, Параметры);

	Старт = ТекущиеМиллисекундыUTC();

	Попытка
		Если СодержитПакетныеЗапросы(ТекстБезСтрокИКомментариев(ТекстЗапросаLimited)) Тогда
			РезультатыПакета = Запрос.ВыполнитьПакет();
			Если РезультатыПакета.Количество() = 0 Тогда
				MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InternalError(),
					"Пакетный запрос не вернул табличный результат.");
			КонецЕсли;
			РезультатЗапроса = РезультатыПакета[РезультатыПакета.Количество() - 1];
		Иначе
			РезультатЗапроса = Запрос.Выполнить();
		КонецЕсли;
	Исключение
		// Запрос уже прошёл синтаксическую и allowlist-валидацию: здесь падение —
		// это ошибка выполнения (несуществующий реквизит, deadlock, право доступа и т.п.).
		ТекстОшибкиВыполнения = ОписаниеОшибки();
		Попытка
			ЗаписьЖурналаРегистрации("MCP.query.execute_failed",
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибкиВыполнения);
		Исключение
		КонецПопытки;
		Детали = Новый Структура;
		Детали.Вставить("stage", "query_execute");
		Детали.Вставить("raw_exception", ТекстОшибкиВыполнения);
		Детали.Вставить("query_original", ИсходныйТекстЗапроса);
		Детали.Вставить("query_effective", ТекстЗапросаLimited);
		Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
			Детали.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
		КонецЕсли;
		Детали.Вставить("limit", Лимит);
		Детали.Вставить("fetch_limit", ЛимитВыборки);
		Детали.Вставить("cursor", Курсор);
		// F-04: предупреждение о коллизии псевдонима должно доходить до клиента и
		// при падении в движке — это вероятная причина отказа.
		Детали.Вставить("validation_warnings", Валидация.warnings);
		QueryGuidance = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidance) Тогда
			Детали.Вставить("query_guidance", QueryGuidance);
		КонецЕсли;
		DomainGuidance = Неопределено;
		Если Валидация.Свойство("domain_guidance", DomainGuidance) Тогда
			Детали.Вставить("domain_guidance", DomainGuidance);
		КонецЕсли;
		Диагностика = ДиагностикаОшибкиВыполнения(
			ТекстОшибкиВыполнения, Валидация, ТекстЗапроса, CorrelationID, КешДиагностики);
		Детали.Вставить("diagnostics", Диагностика);
		// F-06.3: код выводится из стадии. Падение в движке — это стадия
		// query_execute, поэтому базовый код query_execute_error, а не
		// internal_error и тем более не код со словом validation.
		КодОшибки = MCP_Errors.Код_QueryExecuteError();
		Если MCP_Errors.ЭтоОтказДоступаПлатформы(ТекстОшибкиВыполнения) Тогда
			Авторизация = Новый Структура;
			Авторизация.Вставить("reason_code", "1c_access_denied");
			Авторизация.Вставить("denied_operation", "query_execute");
			Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
			Авторизация.Вставить("platform_message", ТекстОшибкиВыполнения);
			Детали.Вставить("authorization", Авторизация);
			КодОшибки = MCP_Errors.Код_AccessDenied();
		КонецЕсли;
		ДиагностическийКод = Неопределено;
		Если КодОшибки <> MCP_Errors.Код_AccessDenied()
			И Диагностика.Свойство("error_code", ДиагностическийКод) Тогда
			Если ДиагностическийКод = "field_not_found"
				ИЛИ ДиагностическийКод = "subconto_wrong_table"
				ИЛИ ДиагностическийКод = "resource_field_in_where" Тогда
				КодОшибки = MCP_Errors.Код_FieldNotFound();
			КонецЕсли;
			// Диагностики syntax_imeyuschie, forbidden_polozhit, batch_query_forbidden,
			// table_not_found, grouping_error, vt_param_field_error,
			// aggregate_function_name раньше подменяли код на query_validation_failed.
			// Это и есть дефект соответствия кода и стадии: запрос УЖЕ был отправлен
			// в движок, значит стадия query_execute, и код валидации здесь неуместен.
			// Конкретика по-прежнему доступна в diagnostics.error_code.
		КонецЕсли;
		// F-06.3: комбинация stage=query_execute с кодом, содержащим "validation",
		// является дефектом. Страховка на случай будущих правок маппинга выше.
		Если СтрНайти(НРег(КодОшибки), "validation") > 0 Тогда
			КодОшибки = MCP_Errors.Код_QueryExecuteError();
		КонецЕсли;
		MCP_Errors.ВозбудитьОшибку(КодОшибки,
			"Ошибка выполнения запроса 1С: " + ТекстОшибкиВыполнения, Детали);
	КонецПопытки;

	Длительность = ТекущиеМиллисекундыUTC() - Старт;

	// Постфактум-таймаут: запрос уже выполнен, но мы сигнализируем клиенту, что
	// он превысил бюджет, чтобы тот не вёл такие запросы в цикл. Реальная отмена
	// потребовала бы РегламентногоЗадания/фоновых заданий.
	ПорогTimeout = ?(TimeoutSeconds = Неопределено, MCP_Config.Лимиты().query_timeout_seconds, TimeoutSeconds);
	Если Длительность / 1000 > ПорогTimeout Тогда
		ДеталиТаймаута = Новый Структура;
		ДеталиТаймаута.Вставить("stage", "query_timeout");
		ДеталиТаймаута.Вставить("query_original", ИсходныйТекстЗапроса);
		ДеталиТаймаута.Вставить("query_effective", ТекстЗапросаLimited);
		Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
			ДеталиТаймаута.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
		КонецЕсли;
		ДеталиТаймаута.Вставить("duration_ms", Длительность);
		ДеталиТаймаута.Вставить("validation_warnings", Валидация.warnings);
		QueryGuidance = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidance) Тогда
			ДеталиТаймаута.Вставить("query_guidance", QueryGuidance);
		КонецЕсли;
		DomainGuidance = Неопределено;
		Если Валидация.Свойство("domain_guidance", DomainGuidance) Тогда
			ДеталиТаймаута.Вставить("domain_guidance", DomainGuidance);
		КонецЕсли;
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryTimeout(),
			"Запрос выполнялся слишком долго: " + Длительность + " мс", ДеталиТаймаута);
	КонецЕсли;

	// Кодируем результат. У РезультатЗапроса нет коллекции Колонки; колонки и
	// строки доступны после выгрузки в ТаблицаЗначений.
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Колонки = Новый Массив;
	Для Каждого К Из ТаблицаРезультата.Колонки Цикл
		КС = Новый Структура;
		КС.Вставить("name", К.Имя);
		КС.Вставить("type_description", Строка(К.ТипЗначения));
		Колонки.Добавить(КС);
	КонецЦикла;

	Строки = Новый Массив;
	Усечено = Ложь;
	Счетчик = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = IncludeNavigationURL;
	КонецСтраницы = Мин(Смещение + Лимит, ТаблицаРезультата.Количество());
	Если Смещение < ТаблицаРезультата.Количество() Тогда
		Для Индекс = Смещение По КонецСтраницы - 1 Цикл
			СтрокаТаблицы = ТаблицаРезультата[Индекс];
			СтрокаJSON = Новый Структура;
			Для Каждого К Из ТаблицаРезультата.Колонки Цикл
				СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(СтрокаТаблицы[К.Имя], ОпцииВалью));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаРезультата.Количество() > Смещение + Счетчик Тогда
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
		КонецЕсли;
	КонецЕсли;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("row_count", Счетчик);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("duration_ms", Длительность);
	Результат.Вставить("warnings", Новый Массив);
	Если PreFlight.pre_flight_resolutions.Количество() > 0 Тогда
		Результат.Вставить("pre_flight_resolutions", PreFlight.pre_flight_resolutions);
		Результат.Вставить("query_effective", ТекстЗапросаLimited);
	КонецЕсли;
	Для Каждого ПредупреждениеВалидации Из Валидация.warnings Цикл
		Результат.warnings.Добавить(ПредупреждениеВалидации);
	КонецЦикла;
	ДобавитьПредупреждениеНулевогоБухгалтерскогоСубконто(Результат, ТекстЗапроса, Счетчик);
	ВозвращатьGuidance = IncludeGuidance;
	Если Счетчик = 0 И НЕ ЕстьЯвныйЛимит(ТекстЗапроса) Тогда
		Результат.warnings.Добавить("Запрос вернул 0 строк и не содержит явного ограничения ПЕРВЫЕ N; возвращены query_guidance/domain_guidance для диагностики.");
		ВозвращатьGuidance = Истина;
	КонецЕсли;
	Если IncludeValidation Тогда
		Результат.Вставить("validation", ВалидацияДляОтвета(Валидация, ВозвращатьGuidance));
	КонецЕсли;
	Если ВозвращатьGuidance Тогда
		БезопасноПрисоединитьДоменныеПодсказки(Результат, ТекстЗапроса);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// CR-A: Необязательное и неблокирующее присоединение domain_guidance.
// Присоединение доменных подсказок — вспомогательный шаг. Его сбой (в том числе
// рассинхрон версии MCP_Knowledge при частичной публикации) не должен ронять весь
// ответ инструмента: полезная нагрузка (rows, диагностика field_not_found /
// resource_field_in_where / pre_flight_resolutions) обязана возвращаться.
// При исключении добавляем предупреждение в warnings и продолжаем.
// Защита размещена в вызывающей стороне (стабильный модуль MCP_Query), что корректно
// для класса отказа «callee рассинхронизирован»; вызывается также из MCP_Tools_Impl.
Процедура БезопасноПрисоединитьДоменныеПодсказки(Результат, Контекст) Экспорт

	Попытка
		MCP_Knowledge.ДобавитьДоменныеПодсказки(Результат, Контекст);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если НЕ Результат.Свойство("warnings") Тогда
			Результат.Вставить("warnings", Новый Массив);
		КонецЕсли;
		Результат.warnings.Добавить(
			"domain_guidance временно недоступен (несогласованная версия MCP_Knowledge): " + ТекстОшибки);
		Попытка
			ЗаписьЖурналаРегистрации("MCP.query.domain_guidance_unavailable",
				УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

Процедура ДобавитьПредупреждениеНулевогоБухгалтерскогоСубконто(Результат, ТекстЗапроса, КоличествоСтрок)

	Если КоличествоСтрок <> 0 Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ТекстПохожНаНулевойЗапросПоПозиционномуСубконто(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Результат.warnings.Добавить(
		"Запрос вернул 0 строк и использует позиционные поля Субконто1/2/3 бухгалтерского регистра. "
		+ "Возможная причина — выбранная позиция субконто не совпадает с настройкой счета в ПланСчетов.<Имя>.ВидыСубконто. "
		+ "Проверьте позицию через get_accounting_accounts_map с account_code_prefix или используйте профильный бухгалтерский shortcut.");

КонецПроцедуры

Функция ТекстПохожНаНулевойЗапросПоПозиционномуСубконто(ТекстЗапроса)

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = КомпактныйВерхнийТекст(ТекстЗапроса);
	Если СтрНайти(Текст, "РЕГИСТРБУХГАЛТЕРИИ.") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(Текст, ".ОСТАТКИ") = 0
		И СтрНайти(Текст, ".ОБОРОТЫ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(Текст, "СУБКОНТО1") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТО2") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТО3") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОДТ1") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОДТ2") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОДТ3") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОКТ1") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОКТ2") > 0
		ИЛИ СтрНайти(Текст, "СУБКОНТОКТ3") > 0;

КонецФункции

Функция ВалидацияДляОтвета(Валидация, IncludeGuidance = Ложь)

	Результат = Новый Структура;
	Результат.Вставить("ok", Валидация.valid);
	Результат.Вставить("valid", Валидация.valid);
	Результат.Вставить("errors", Валидация.errors);
	Результат.Вставить("warnings", Валидация.warnings);
	Результат.Вставить("detected_objects", Валидация.detected_objects);
	Результат.Вставить("detected_parameters", Валидация.detected_parameters);
	Результат.Вставить("estimated_risk", Валидация.estimated_risk);
	Если IncludeGuidance Тогда
		QueryGuidance = Неопределено;
		Если Валидация.Свойство("query_guidance", QueryGuidance) Тогда
			Результат.Вставить("query_guidance", QueryGuidance);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Параметры) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипКонтейнера = ТипЗнч(Параметры);
	Если ТипКонтейнера = Тип("Структура") ИЛИ ТипКонтейнера = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипКонтейнера = Тип("Соответствие") ИЛИ ТипКонтейнера = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из Параметры Цикл
			Значение = MCP_Values.ДекодироватьПараметр(КЗ.Значение);
			Запрос.УстановитьПараметр(Строка(КЗ.Ключ), Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьЗапросПередВыполнением(ТекстЗапроса, Параметры)

	Результат = Новый Структура;
	Результат.Вставить("query", ТекстЗапроса);
	Результат.Вставить("parameters", КопияПараметровЗапроса(Параметры));
	Результат.Вставить("pre_flight_resolutions", Новый Массив);

	ТекстДляПоиска = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	ВерхнийТекст = ВРег(ТекстДляПоиска);
	Позиция = 1;
	ПоследняяПозиция = 1;
	НовыйТекст = "";
	ЛокальныйКеш = Новый Соответствие;

	Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
		ПозицияЗначение = СтрНайти(ВерхнийТекст, "ЗНАЧЕНИЕ", , Позиция);
		Если ПозицияЗначение = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияСкобки = ПропуститьПробелы(ВерхнийТекст, ПозицияЗначение + СтрДлина("ЗНАЧЕНИЕ"));
		Если ПозицияСкобки > СтрДлина(ВерхнийТекст)
			ИЛИ Сред(ВерхнийТекст, ПозицияСкобки, 1) <> "(" Тогда
			Позиция = ПозицияЗначение + СтрДлина("ЗНАЧЕНИЕ");
			Продолжить;
		КонецЕсли;
		ПозицияЗакрытия = НайтиЗакрывающуюСкобку(ВерхнийТекст, ПозицияСкобки);
		Если ПозицияЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;

		Выражение = Сред(ТекстЗапроса, ПозицияЗначение, ПозицияЗакрытия - ПозицияЗначение + 1);
		Внутри = СокрЛП(Сред(ТекстЗапроса, ПозицияСкобки + 1, ПозицияЗакрытия - ПозицияСкобки - 1));
		ЗначениеПС = РазобратьЗначениеПланаСчетов(Внутри);
		Если ЗначениеПС <> Неопределено И ПохожеНаКодСчета(ЗначениеПС.account_code) Тогда
			КлючКеша = ЗначениеПС.chart + ":" + ЗначениеПС.account_code;
			НайденныйСчет = ЛокальныйКеш.Получить(КлючКеша);
			CacheHit = НайденныйСчет <> Неопределено;
			Если НайденныйСчет = Неопределено Тогда
				НайденныйСчет = НайтиСчетПланаСчетовПоКоду(ЗначениеПС.chart, ЗначениеПС.account_code);
				ЛокальныйКеш.Вставить(КлючКеша, НайденныйСчет);
			КонецЕсли;

			Если НЕ НайденныйСчет.found Тогда
				ВыброситьОшибкуСчетНеНайден(Выражение, ЗначениеПС.chart, ЗначениеПС.account_code,
					НайденныйСчет.suggestion, Результат.pre_flight_resolutions, ТекстЗапроса);
			КонецЕсли;

			ИмяПараметра = УникальноеИмяResolvedПараметра(Результат.parameters, ЗначениеПС.account_code,
				Результат.pre_flight_resolutions.Количество() + 1);
			ПараметрRef = Новый Структура;
			ПараметрRef.Вставить("kind", "ref");
			ПараметрRef.Вставить("type", ЗначениеПС.chart);
			ПараметрRef.Вставить("uuid", НайденныйСчет.uuid);
			Результат.parameters.Вставить(ИмяПараметра, ПараметрRef);

			Запись = Новый Структура;
			Запись.Вставить("original", Выражение);
			Запись.Вставить("resolved_to_param", ИмяПараметра);
			Запись.Вставить("account_code", ЗначениеПС.account_code);
			Запись.Вставить("uuid", НайденныйСчет.uuid);
			Запись.Вставить("chart", ЗначениеПС.chart);
			Запись.Вставить("cache_hit", CacheHit);
			Результат.pre_flight_resolutions.Добавить(Запись);

			НовыйТекст = НовыйТекст + Сред(ТекстЗапроса, ПоследняяПозиция, ПозицияЗначение - ПоследняяПозиция)
				+ "&" + ИмяПараметра;
			ПоследняяПозиция = ПозицияЗакрытия + 1;
		КонецЕсли;

		Позиция = ПозицияЗакрытия + 1;
	КонецЦикла;

	Если Результат.pre_flight_resolutions.Количество() > 0 Тогда
		Результат.query = НовыйТекст + Сред(ТекстЗапроса, ПоследняяПозиция);
		ЗаписатьЛогPreFlight(Результат.pre_flight_resolutions);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция КопияПараметровЗапроса(Параметры)

	Результат = Новый Структура;
	Если Параметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ТипКонтейнера = ТипЗнч(Параметры);
	Если ТипКонтейнера = Тип("Структура") ИЛИ ТипКонтейнера = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипКонтейнера = Тип("Соответствие") ИЛИ ТипКонтейнера = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из Параметры Цикл
			Результат.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазобратьЗначениеПланаСчетов(Внутри)

	Префикс = "ПланСчетов.";
	Если НЕ СтрНачинаетсяС(ВРег(Внутри), ВРег(Префикс)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Внутри, СтрДлина(Префикс) + 1);
	ПозицияТочки = СтрНайти(Остаток, ".");
	Если ПозицияТочки <= 1 ИЛИ ПозицияТочки = СтрДлина(Остаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяПлана = Лев(Остаток, ПозицияТочки - 1);
	КодСчета = СокрЛП(Сред(Остаток, ПозицияТочки + 1));
	Если НЕ MCP_Security.ИмяБезопасноДляЗапроса(ИмяПлана) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("chart", "ПланСчетов." + ИмяПлана);
	Результат.Вставить("account_code", КодСчета);
	Возврат Результат;

КонецФункции

Функция ПохожеНаКодСчета(Значение)

	Код = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Код) ИЛИ СтрДлина(Код) > 30 Тогда
		Возврат Ложь;
	КонецЕсли;
	ЕстьЦифра = Ложь;
	Для Индекс = 1 По СтрДлина(Код) Цикл
		С = Сред(Код, Индекс, 1);
		Если СтрНайти("0123456789", С) > 0 Тогда
			ЕстьЦифра = Истина;
		ИначеЕсли СтрНайти(".-/", С) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьЦифра;

КонецФункции

Функция УникальноеИмяResolvedПараметра(Параметры, КодСчета, Номер)

	Основа = "_resolved_" + СтрокаДляИмениПараметра(КодСчета);
	Если ПустаяСтрока(Основа) ИЛИ Основа = "_resolved_" Тогда
		Основа = "_resolved_account";
	КонецЕсли;
	Имя = Основа;
	Индекс = Номер;
	Пока ПараметрПередан(Параметры, Имя) Цикл
		Имя = Основа + "_" + Строка(Индекс);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Имя;

КонецФункции

Функция СтрокаДляИмениПараметра(Значение)

	Результат = "";
	Текст = Строка(Значение);
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		С = Сред(Текст, Индекс, 1);
		Если ЯвляетсяСимволомИдентификатора(С) Тогда
			Результат = Результат + С;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НайтиСчетПланаСчетовПоКоду(Chart, КодСчета)

	Результат = Новый Структура;
	Результат.Вставить("found", Ложь);
	Результат.Вставить("uuid", "");
	Результат.Вставить("code", КодСчета);
	Результат.Вставить("name", "");
	Результат.Вставить("suggestion", Новый Массив);

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(Chart)
		ИЛИ Метаданные.НайтиПоПолномуИмени(Chart) = Неопределено
		ИЛИ НЕ MCP_Security.ТипРазрешен(Chart) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 "
		+ "Счета.Код КАК Код, "
		+ "Счета.Наименование КАК Наименование, "
		+ "УникальныйИдентификатор(Счета.Ссылка) КАК UUIDСчета "
		+ "ИЗ " + Chart + " КАК Счета "
		+ "ГДЕ Счета.Код = &Код";
	Запрос.УстановитьПараметр("Код", КодСчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.found = Истина;
		Результат.uuid = Строка(Выборка.UUIDСчета);
		Результат.code = Строка(Выборка.Код);
		Результат.name = Строка(Выборка.Наименование);
		Возврат Результат;
	КонецЕсли;

	Результат.suggestion = БлижайшиеСчетаПланаСчетов(Chart, КодСчета);
	Возврат Результат;

КонецФункции

Функция БлижайшиеСчетаПланаСчетов(Chart, КодСчета)

	Результат = Новый Массив;
	Префикс = Лев(КодСчета, 1);
	Если ПустаяСтрока(Префикс) Тогда
		Префикс = "%";
	Иначе
		Префикс = Префикс + "%";
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5 "
			+ "Счета.Код КАК Код, "
			+ "Счета.Наименование КАК Наименование, "
			+ "УникальныйИдентификатор(Счета.Ссылка) КАК UUIDСчета "
			+ "ИЗ " + Chart + " КАК Счета "
			+ "ГДЕ Счета.Код ПОДОБНО &Префикс "
			+ "УПОРЯДОЧИТЬ ПО Счета.Код";
		Запрос.УстановитьПараметр("Префикс", Префикс);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = Новый Структура;
			Стр.Вставить("code", Строка(Выборка.Код));
			Стр.Вставить("name", Строка(Выборка.Наименование));
			Стр.Вставить("uuid", Строка(Выборка.UUIDСчета));
			Результат.Добавить(Стр);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ВыброситьОшибкуСчетНеНайден(Выражение, Chart, КодСчета, Suggestion, Resolutions, ИсходныйТекстЗапроса)

	Диагностика = Новый Структура;
	Диагностика.Вставить("error_code", "account_not_found");
	Диагностика.Вставить("error", "account_not_found");
	Диагностика.Вставить("message", "Счёт с кодом '" + КодСчета + "' не найден в " + Chart + ".");
	Диагностика.Вставить("original_expression", Выражение);
	Диагностика.Вставить("chart", Chart);
	Диагностика.Вставить("account_code", КодСчета);
	Диагностика.Вставить("suggestion", Suggestion);
	Диагностика.Вставить("hint", "Передайте счёт как параметр {""kind"":""ref"",""type"":""" + Chart + """,""uuid"":""<uuid>""} и используйте &ИмяПараметра в запросе.");

	Детали = Новый Структура;
	Детали.Вставить("stage", "query_pre_flight");
	Детали.Вставить("query_original", ИсходныйТекстЗапроса);
	Детали.Вставить("diagnostics", Диагностика);
	Детали.Вставить("pre_flight_resolutions", Resolutions);
	MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryValidationFailed(),
		"Счёт с кодом '" + КодСчета + "' не найден в " + Chart + ".", Детали);

КонецПроцедуры

Процедура ЗаписатьЛогPreFlight(Resolutions)

	Для Каждого Resolution Из Resolutions Цикл
		Попытка
			ЗаписьЖурналаРегистрации("MCP.query.pre_flight_resolution",
				УровеньЖурналаРегистрации.Информация, , ,
				"cr_id=CR-02 original_expression=" + Resolution.original
				+ " resolved=true cache_hit=" + Строка(Resolution.cache_hit));
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция ЦелоеДляТекстаЗапроса(Значение) Экспорт
	Текст = Формат(Цел(Число(Значение)), "ЧГ=0");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символ(8239), "");
	Возврат Текст;
КонецФункции

Функция ПрименитьЛимит(ТекстЗапроса, Лимит)

	Если ЕстьЯвныйЛимит(ТекстЗапроса) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ТекстДляПоиска = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	// ТекстБезСтрокИКомментариев сохраняет позиции (заменяет содержимое строк/комментариев
	// на пробелы), поэтому смещения, найденные в нём, валидны и для исходного текста.
	// Для пакетов с временными таблицами лимит применяем к финальному SELECT.
	ИндексTopSelect = НайтиПозициюПоследнегоВнешнегоSelect(ТекстДляПоиска);
	Если ИндексTopSelect = 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ВерхХвост = ВРег(Сред(ТекстДляПоиска, ИндексTopSelect));
	ДлинаКлюча = 0;
	КлючЛимита = "ПЕРВЫЕ";
	Если СтрНачинаетсяС(ВерхХвост, "ВЫБРАТЬ") Тогда
		ДлинаКлюча = СтрДлина("ВЫБРАТЬ");
	ИначеЕсли СтрНачинаетсяС(ВерхХвост, "SELECT") Тогда
		ДлинаКлюча = СтрДлина("SELECT");
		КлючЛимита = "TOP";
	Иначе
		Возврат ТекстЗапроса;
	КонецЕсли;

	// Учитываем модификаторы РАЗРЕШЕННЫЕ/РАЗЛИЧНЫЕ/ALLOWED/DISTINCT, чтобы ПЕРВЫЕ не попало между ними.
	ПозицияПослеКлюча = ИндексTopSelect + ДлинаКлюча;
	Для Каждого Модификатор Из СтрРазделить("РАЗРЕШЕННЫЕ,РАЗЛИЧНЫЕ,ALLOWED,DISTINCT", ",", Истина) Цикл
		Следующий = ПропуститьПробелы(ТекстДляПоиска, ПозицияПослеКлюча);
		Если ВРег(Сред(ТекстДляПоиска, Следующий, СтрДлина(Модификатор))) = Модификатор Тогда
			ПозицияПослеКлюча = Следующий + СтрДлина(Модификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(ТекстЗапроса, ПозицияПослеКлюча - 1)
		+ " " + КлючЛимита + " " + ЦелоеДляТекстаЗапроса(Лимит) + " "
		+ Сред(ТекстЗапроса, ПозицияПослеКлюча);

КонецФункции

Функция ОписаниеЯвногоЛимита(ТекстЗапроса)

	Результат = Новый Структура;
	Результат.Вставить("present", Ложь);
	Результат.Вставить("numeric", Ложь);
	Результат.Вставить("value", 0);
	Результат.Вставить("keyword", "");

	ТекстДляПоиска = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	ПозицияПослеКлюча = ПозицияПослеПоследнегоВнешнегоSelectИМодификаторов(ТекстДляПоиска);
	Если ПозицияПослеКлюча = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Позиция = ПропуститьПробелы(ТекстДляПоиска, ПозицияПослеКлюча);
	Если СовпадаетКлючСлово(ТекстДляПоиска, Позиция, "ПЕРВЫЕ") Тогда
		Результат.present = Истина;
		Результат.keyword = "ПЕРВЫЕ";
		Позиция = Позиция + СтрДлина("ПЕРВЫЕ");
	ИначеЕсли СовпадаетКлючСлово(ТекстДляПоиска, Позиция, "TOP") Тогда
		Результат.present = Истина;
		Результат.keyword = "TOP";
		Позиция = Позиция + СтрДлина("TOP");
	Иначе
		Возврат Результат;
	КонецЕсли;

	Позиция = ПропуститьПробелы(ТекстДляПоиска, Позиция);
	ЧислоСтрокой = "";
	Пока Позиция <= СтрДлина(ТекстДляПоиска) Цикл
		С = Сред(ТекстДляПоиска, Позиция, 1);
		Если НЕ ЭтоЦифра(С) Тогда
			Прервать;
		КонецЕсли;
		ЧислоСтрокой = ЧислоСтрокой + С;
		Позиция = Позиция + 1;
	КонецЦикла;

	Если ПустаяСтрока(ЧислоСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;

	// Вторая группа цифр после лимита — НЕ признак нечислового лимита. «ПЕРВЫЕ 1 1 КАК
	// ЕстьДанные» это лимит 1 и числовая константа 1 в списке выборки: штатная проба
	// существования записей, которой пользуется в том числе сам сервер. Отличить её от
	// разделителя тысяч («ПЕРВЫЕ 1 000») синтаксически нельзя — обе формы законны и
	// разбираются платформой одинаково, поэтому здесь только пометка для вызывающего,
	// а лимит считается числовым.
	Результат.Вставить("digits_follow", Ложь);
	СледующаяПозиция = ПропуститьПробелы(ТекстДляПоиска, Позиция);
	Если СледующаяПозиция <= СтрДлина(ТекстДляПоиска)
		И ЭтоЦифра(Сред(ТекстДляПоиска, СледующаяПозиция, 1)) Тогда
		Результат.digits_follow = Истина;
	КонецЕсли;

	Попытка
		Результат.value = Число(ЧислоСтрокой);
		Результат.numeric = Истина;
	Исключение
		Результат.numeric = Ложь;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ПозицияПослеВнешнегоSelectИМодификаторов(ТекстДляПоиска)

	ИндексTopSelect = НайтиПозициюВнешнегоSelect(ТекстДляПоиска);
	Возврат ПозицияПослеSelectИМодификаторов(ТекстДляПоиска, ИндексTopSelect);

КонецФункции

Функция ПозицияПослеПоследнегоВнешнегоSelectИМодификаторов(ТекстДляПоиска)

	ИндексTopSelect = НайтиПозициюПоследнегоВнешнегоSelect(ТекстДляПоиска);
	Возврат ПозицияПослеSelectИМодификаторов(ТекстДляПоиска, ИндексTopSelect);

КонецФункции

Функция ПозицияПослеSelectИМодификаторов(ТекстДляПоиска, ИндексTopSelect)

	Если ИндексTopSelect = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ВерхХвост = ВРег(Сред(ТекстДляПоиска, ИндексTopSelect));
	ДлинаКлюча = 0;
	Если СтрНачинаетсяС(ВерхХвост, "ВЫБРАТЬ") Тогда
		ДлинаКлюча = СтрДлина("ВЫБРАТЬ");
	ИначеЕсли СтрНачинаетсяС(ВерхХвост, "SELECT") Тогда
		ДлинаКлюча = СтрДлина("SELECT");
	Иначе
		Возврат 0;
	КонецЕсли;

	ПозицияПослеКлюча = ИндексTopSelect + ДлинаКлюча;
	Для Каждого Модификатор Из СтрРазделить("РАЗРЕШЕННЫЕ,РАЗЛИЧНЫЕ,ALLOWED,DISTINCT", ",", Истина) Цикл
		Следующий = ПропуститьПробелы(ТекстДляПоиска, ПозицияПослеКлюча);
		Если ВРег(Сред(ТекстДляПоиска, Следующий, СтрДлина(Модификатор))) = Модификатор Тогда
			ПозицияПослеКлюча = Следующий + СтрДлина(Модификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат ПозицияПослеКлюча;

КонецФункции

Функция ПропуститьПробелы(Текст, СтартПозиция)

	Длина = СтрДлина(Текст);
	П = СтартПозиция;
	Пока П <= Длина И СтрНайти(" " + Символы.ПС + Символы.ВК + Символы.Таб, Сред(Текст, П, 1)) > 0 Цикл
		П = П + 1;
	КонецЦикла;
	Возврат П;

КонецФункции

Функция НайтиПозициюВнешнегоSelect(Знач Текст)

	Длина = СтрДлина(Текст);
	Глубина = 0;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		С = Сред(Текст, Позиция, 1);
		Если С = "(" Тогда
			Глубина = Глубина + 1;
			Позиция = Позиция + 1;
			Продолжить;
		ИначеЕсли С = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Слово начинается, только если предыдущий символ — разделитель.
		ПредС = ?(Позиция > 1, Сред(Текст, Позиция - 1, 1), " ");
		Если Глубина = 0 И НЕ ЯвляетсяСимволомИдентификатора(ПредС) Тогда
			Если СовпадаетКлючСлово(Текст, Позиция, "ВЫБРАТЬ") ИЛИ СовпадаетКлючСлово(Текст, Позиция, "SELECT") Тогда
				Возврат Позиция;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция НайтиПозициюПоследнегоВнешнегоSelect(Знач Текст)

	Длина = СтрДлина(Текст);
	Глубина = 0;
	Позиция = 1;
	ПоследняяПозиция = 0;
	Пока Позиция <= Длина Цикл
		С = Сред(Текст, Позиция, 1);
		Если С = "(" Тогда
			Глубина = Глубина + 1;
			Позиция = Позиция + 1;
			Продолжить;
		ИначеЕсли С = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		ПредС = ?(Позиция > 1, Сред(Текст, Позиция - 1, 1), " ");
		Если Глубина = 0 И НЕ ЯвляетсяСимволомИдентификатора(ПредС) Тогда
			Если СовпадаетКлючСлово(Текст, Позиция, "ВЫБРАТЬ") ИЛИ СовпадаетКлючСлово(Текст, Позиция, "SELECT") Тогда
				ПоследняяПозиция = Позиция;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат ПоследняяПозиция;

КонецФункции

Функция СовпадаетКлючСлово(Знач Текст, Знач Позиция, Знач Ключ)

	Если ВРег(Сред(Текст, Позиция, СтрДлина(Ключ))) <> Ключ Тогда
		Возврат Ложь;
	КонецЕсли;
	// За ключевым словом должен идти не-идентификаторный символ.
	СледПоз = Позиция + СтрДлина(Ключ);
	Если СледПоз > СтрДлина(Текст) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат НЕ ЯвляетсяСимволомИдентификатора(Сред(Текст, СледПоз, 1));

КонецФункции

Функция НайтиИсточникиЗапроса(ТекстЗапроса)

	Результат = Новый Массив;
	Найдено = Новый Соответствие;
	Лексемы = ЛексемыИсточников(ТекстЗапроса);
	ОжидаемИсточник = Ложь;
	ВРазделеИсточников = Ложь;
	Глубина = 0;

	Для Каждого Л Из Лексемы Цикл
		Токен = СокрЛП(Л);
		Если ПустаяСтрока(Токен) Тогда
			Продолжить;
		КонецЕсли;

		ТокенВРег = ВРег(Токен);

		Если Токен = "(" Тогда
			Глубина = Глубина + 1;
			Продолжить;
		ИначеЕсли Токен = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Токен = ";" Тогда
			ВРазделеИсточников = Ложь;
			ОжидаемИсточник = Ложь;
			Продолжить;
		ИначеЕсли Токен = "," Тогда
			Если ВРазделеИсточников И Глубина = 0 Тогда
				ОжидаемИсточник = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Глубина = 0 И КонецРазделаИсточников(ТокенВРег) Тогда
			ВРазделеИсточников = Ложь;
			ОжидаемИсточник = Ложь;
		КонецЕсли;

		Если ОжидаемИсточник Тогда
			Если ТокенВРег = "ВЫБРАТЬ" ИЛИ ТокенВРег = "SELECT" Тогда
				ОжидаемИсточник = Ложь;
			Иначе
				ДобавитьИсточникЗапроса(Результат, Найдено, Токен);
				ОжидаемИсточник = Ложь;
			КонецЕсли;
		КонецЕсли;

		Если ТокенВРег = "ИЗ"
			ИЛИ ТокенВРег = "FROM"
			ИЛИ ТокенВРег = "СОЕДИНЕНИЕ"
			ИЛИ ТокенВРег = "JOIN" Тогда
			ВРазделеИсточников = Истина;
			ОжидаемИсточник = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛексемыИсточников(Текст)

	Подготовленный = Текст;
	Разделители = Новый Массив;
	Разделители.Добавить("(");
	Разделители.Добавить(")");
	Разделители.Добавить(",");
	Разделители.Добавить(";");
	Для Каждого Разделитель Из Разделители Цикл
		Подготовленный = СтрЗаменить(Подготовленный, Разделитель, " " + Разделитель + " ");
	КонецЦикла;
	Подготовленный = СтрЗаменить(Подготовленный, Символы.ПС, " ");
	Подготовленный = СтрЗаменить(Подготовленный, Символы.ВК, " ");
	Подготовленный = СтрЗаменить(Подготовленный, Символы.Таб, " ");
	Возврат СтрРазделить(Подготовленный, " ", Ложь);

КонецФункции

Функция КонецРазделаИсточников(ТокенВРег)

	Возврат ТокенВРег = "ГДЕ"
		ИЛИ ТокенВРег = "WHERE"
		ИЛИ ТокенВРег = "СГРУППИРОВАТЬ"
		ИЛИ ТокенВРег = "GROUP"
		ИЛИ ТокенВРег = "УПОРЯДОЧИТЬ"
		ИЛИ ТокенВРег = "ORDER"
		ИЛИ ТокенВРег = "ИМЕЮЩИЕ"
		ИЛИ ТокенВРег = "HAVING"
		ИЛИ ТокенВРег = "ОБЪЕДИНИТЬ"
		ИЛИ ТокенВРег = "UNION"
		ИЛИ ТокенВРег = "ИТОГИ"
		ИЛИ ТокенВРег = "TOTALS"
		// issue #60: без этих терминаторов запятая в «ИНДЕКСИРОВАТЬ ПО Поле1, Поле2»
		// читается как разделитель источников, и Поле2 диагностируется как
		// неизвестный объект метаданных. Все три конструкции возможны только на
		// уровне команды пакета, то есть внутри списка источников не встречаются.
		ИЛИ ТокенВРег = "ИНДЕКСИРОВАТЬ"
		ИЛИ ТокенВРег = "INDEX"
		ИЛИ ТокенВРег = "ПОМЕСТИТЬ"
		ИЛИ ТокенВРег = "INTO"
		ИЛИ ТокенВРег = "УНИЧТОЖИТЬ"
		ИЛИ ТокенВРег = "DROP";

КонецФункции

Процедура ДобавитьИсточникЗапроса(Результат, Найдено, Токен)

	Если СтрНачинаетсяС(Токен, "&") Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмя = ПолноеИмяМетаданныхИзЛексемы(Токен);
	Ключ = Токен + "|" + ПолноеИмя;
	Если Найдено.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Источник = Новый Структура;
	Источник.Вставить("raw", Токен);
	Источник.Вставить("full_name", ПолноеИмя);
	Результат.Добавить(Источник);
	Найдено.Вставить(Ключ, Истина);

КонецПроцедуры

Функция ПолноеИмяМетаданныхИзЛексемы(Лексема)

	Поз = СтрНайти(Лексема, ".");
	Если Поз <= 1 ИЛИ Поз = СтрДлина(Лексема) Тогда
		Возврат "";
	КонецЕсли;

	Префикс = Лев(Лексема, Поз - 1);
	Вид = КаноническийВидМетаданных(Префикс);
	Если ПустаяСтрока(Вид) Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Лексема, Поз + 1);
	ПозТочки = СтрНайти(Хвост, ".");
	Если ПозТочки > 0 Тогда
		Хвост = Лев(Хвост, ПозТочки - 1);
	КонецЕсли;

	Возврат Вид + "." + Хвост;

КонецФункции

Функция КаноническийВидМетаданных(Префикс)

	ПрефиксВРег = ВРег(Префикс);
	Если ПрефиксВРег = ВРег("Справочник") Тогда Возврат "Справочник"; КонецЕсли;
	Если ПрефиксВРег = ВРег("Документ") Тогда Возврат "Документ"; КонецЕсли;
	Если ПрефиксВРег = ВРег("Константа") Тогда Возврат "Константа"; КонецЕсли;
	Если ПрефиксВРег = ВРег("Перечисление") Тогда Возврат "Перечисление"; КонецЕсли;
	Если ПрефиксВРег = ВРег("РегистрСведений") Тогда Возврат "РегистрСведений"; КонецЕсли;
	Если ПрефиксВРег = ВРег("РегистрНакопления") Тогда Возврат "РегистрНакопления"; КонецЕсли;
	Если ПрефиксВРег = ВРег("РегистрБухгалтерии") Тогда Возврат "РегистрБухгалтерии"; КонецЕсли;
	Если ПрефиксВРег = ВРег("РегистрРасчета") Тогда Возврат "РегистрРасчета"; КонецЕсли;
	Если ПрефиксВРег = ВРег("ПланСчетов") Тогда Возврат "ПланСчетов"; КонецЕсли;
	Если ПрефиксВРег = ВРег("ПланВидовХарактеристик") Тогда Возврат "ПланВидовХарактеристик"; КонецЕсли;
	Если ПрефиксВРег = ВРег("ПланВидовРасчета") Тогда Возврат "ПланВидовРасчета"; КонецЕсли;
	Если ПрефиксВРег = ВРег("ПланОбмена") Тогда Возврат "ПланОбмена"; КонецЕсли;
	Если ПрефиксВРег = ВРег("БизнесПроцесс") Тогда Возврат "БизнесПроцесс"; КонецЕсли;
	Если ПрефиксВРег = ВРег("Задача") Тогда Возврат "Задача"; КонецЕсли;
	Возврат "";

КонецФункции

Функция НайтиПараметры(ТекстЗапроса)

	Результат = Новый Массив;
	Найдено = Новый Соответствие;
	Длина = СтрДлина(ТекстЗапроса);
	Поз = 1;

	Пока Поз <= Длина Цикл
		Симв = Сред(ТекстЗапроса, Поз, 1);
		Если Симв = "&" Тогда
			Имя = "";
			Поз = Поз + 1;
			Пока Поз <= Длина Цикл
				С = Сред(ТекстЗапроса, Поз, 1);
				Если ЯвляетсяСимволомИдентификатора(С) Тогда
					Имя = Имя + С;
					Поз = Поз + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ПустаяСтрока(Имя) И Найдено.Получить(Имя) = Неопределено Тогда
				Найдено.Вставить(Имя, Истина);
				Результат.Добавить(Имя);
			КонецЕсли;
		Иначе
			Поз = Поз + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьОшибкиСубконтоДтКтОсновнойТаблицы(Результат, ИсточникиЗапроса, ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	Для Каждого Источник Из ИсточникиЗапроса Цикл
		Если НЕ СтрНачинаетсяС(Источник.full_name, "РегистрБухгалтерии.") Тогда
			Продолжить;
		КонецЕсли;
		// Виртуальные таблицы вроде РегистрБухгалтерии.<Имя>.ОборотыДтКт имеют
		// те же detected_objects, но raw содержит суффикс после имени регистра.
		// Поля СубконтоДт/Кт в них корректны, блокируем только основную таблицу.
		Если ВРег(Источник.raw) <> ВРег(Источник.full_name) Тогда
			Продолжить;
		КонецЕсли;

		Алиасы = АлиасыИсточника(ТекстЗапроса, Источник.raw);
		Алиасы.Добавить(Источник.raw);
		Если Алиасы.Количество() = 0 Тогда
			Алиасы.Добавить(ПоследнийСегментИмени(Источник.full_name));
		КонецЕсли;

		Для Каждого Алиас Из Алиасы Цикл
			Для Номер = 1 По 3 Цикл
				Если ПолеСубконтоДтКтОсновнойТаблицыВстречается(ВерхнийТекст, Алиас, "СУБКОНТОДТ" + Строка(Номер))
					ИЛИ ПолеСубконтоДтКтОсновнойТаблицыВстречается(ВерхнийТекст, Алиас, "СУБКОНТОКТ" + Строка(Номер)) Тогда
					ДобавитьОшибку(Результат, "subconto_wrong_table",
						"Поля СубконтоДт1/2/3 и СубконтоКт1/2/3 недоступны в основной таблице " + Источник.full_name
						+ ". Используйте " + Источник.full_name + ".Субконто с полями Период, Регистратор, НомерСтроки, ВидДвижения, Вид, Значение, "
						+ "или виртуальную таблицу бухгалтерского регистра. Для определения позиций аналитик сначала вызовите get_accounting_accounts_map.",
						Источник.full_name + ".Субконто");
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Текст запроса без содержимого строковых литералов и без комментариев.
// Нужен правилам, которые проверяют ИДЕНТИФИКАТОРЫ: внутри литерала «Ё» и
// латиница допустимы, это данные, а не имена (см. стандарты §4.3).
// Литералы вырезаются построчно: в языке запросов строка не переносится без
// явной склейки, поэтому построчный разбор безопаснее сквозного.
Функция ТекстЗапросаБезЛитералов(ТекстЗапроса)

	Результат = "";
	Строки = СтрРазделить(ТекстЗапроса, Символы.ПС, Истина);

	Для Каждого Строка Из Строки Цикл
		Очищенная = "";
		ВКавычках = Ложь;
		Для Индекс = 1 По СтрДлина(Строка) Цикл
			Символ = Сред(Строка, Индекс, 1);
			Если Символ = """" Тогда
				ВКавычках = НЕ ВКавычках;
				Очищенная = Очищенная + " ";
			ИначеЕсли ВКавычках Тогда
				Очищенная = Очищенная + " ";
			Иначе
				Очищенная = Очищенная + Символ;
			КонецЕсли;
		КонецЦикла;

		// Комментарий гасится пробелами, а не обрезается: длина строки обязана
		// сохраниться. Позиции, найденные в этом тексте, используются для нумерации
		// строк в ИСХОДНОМ тексте (НомерСтрокиПоПозиции), и укорачивание строки
		// сдвигало номер назад — объявленное исключение
		// // СТАНДАРТ-ИСКЛЮЧЕНИЕ могло не признаваться, если перед источником шёл
		// длинный комментарий.
		ПозицияКомментария = СтрНайти(Очищенная, "//");
		Если ПозицияКомментария > 0 Тогда
			Очищенная = Лев(Очищенная, ПозицияКомментария - 1)
				+ СтрокаПробелов(СтрДлина(Очищенная) - ПозицияКомментария + 1);
		КонецЕсли;

		Результат = Результат + Очищенная + Символы.ПС;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// §4.3: буква «Ё» в тексте запроса и латиница в идентификаторах.
// Причина запрета — гомоглифы: кириллические А,В,Е,К,М,Н,О,Р,С,Т,Х визуально
// неотличимы от латинских, а платформенные поля пишутся через «Е»
// (СчетДт, не СчётДт). Разрешённые латинские токены — только NULL и UUID.
Процедура ДобавитьОшибкиИдентификаторовЗапроса(Результат, ТекстЗапроса)

	БезЛитералов = ТекстЗапросаБезЛитералов(ТекстЗапроса);

	Если СтрНайти(БезЛитералов, "Ё") > 0 ИЛИ СтрНайти(БезЛитералов, "ё") > 0 Тогда
		ДобавитьОшибку(Результат, "style_yo_letter_forbidden",
			"Буква «Ё» в тексте запроса запрещена — использовать «Е». Платформенные имена полей "
			+ "пишутся через «Е» (например СчетДт, а не СчётДт): написание с «Ё» проходит "
			+ "синтаксическую проверку, но при исполнении даёт «Поле не найдено» без видимой причины. "
			+ "Правило общее и распространяется в том числе на псевдонимы, где «Ё» формально "
			+ "допустима: единое написание исключает саму возможность такой ошибки. "
			+ "Внутри строковых литералов «Ё» разрешена — это данные, а не имена.",
			"Ё");
	КонецЕсли;

	СмешанныйИдентификатор = ПервыйСмешанныйИдентификатор(БезЛитералов);
	Если НЕ ПустаяСтрока(СмешанныйИдентификатор) Тогда
		ДобавитьОшибку(Результат, "temporary_table_identifier_mixed_script",
			"Латинская вставка «" + ПодозрительнаяЛатинскаяСерия(СмешанныйИдентификатор)
			+ "» внутри кириллического идентификатора «" + СмешанныйИдентификатор
			+ "». Кириллические А,В,Е,К,М,Н,О,Р,С,Т,Х,У визуально неотличимы от латинских, "
			+ "поэтому такая вставка почти всегда опечатка и даёт «Поле не найдено» без видимой "
			+ "причины. Допустимы токены NULL, UUID, ID и любые слова от трёх символов, "
			+ "В КОТОРЫХ ЕСТЬ хотя бы одна буква без кириллического двойника "
			+ "(ЕСТЬNULL, ДокументUUID): они читаются однозначно.",
			СмешанныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

// Первый идентификатор, где кириллица смешана с латиницей сверх разрешённых
// токенов. Ключевые слова латиницей (SELECT, FROM, LEFT JOIN) не являются
// смешанными и правилом не затрагиваются.
Функция ПервыйСмешанныйИдентификатор(БезЛитералов)

	Слово = "";
	Позиция = 1;
	Предел = СтрДлина(БезЛитералов) + 1;

	Пока Позиция <= Предел Цикл
		Если Позиция = Предел Тогда
			Символ = " ";
		Иначе
			Символ = Сред(БезЛитералов, Позиция, 1);
		КонецЕсли;

		Если СимволИдентификатора(Символ) Тогда
			Слово = Слово + Символ;
		Иначе
			Если НЕ ПустаяСтрока(Слово) И ИдентификаторСмешанный(Слово) Тогда
				Возврат Слово;
			КонецЕсли;
			Слово = "";
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция СимволИдентификатора(Символ)

	Если Символ = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти("АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
		+ "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
		+ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", Символ) > 0;

КонецФункции

// Различаются два случая, и нарушением считается только первый:
//   ОПЕЧАТКА  — латинская серия внутри кириллического слова, которую не видно
//               глазом: «Cчет» с латинской C, «СчетDт», «ОCTATKИ». Даёт
//               «Поле не найдено» или «таблица не найдена» без видимой причины.
//   ОСОЗНАННО — целый латинский токен: ЕСТЬNULL, ДокументUUID, КонтрагентID,
//               ПозицияSelect. Читается однозначно, ловушки не создаёт.
Функция ИдентификаторСмешанный(Слово)

	Если НЕ СодержитКириллицу(Слово) Тогда
		// чисто латинское слово — ключевое слово языка, не идентификатор запроса
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ПустаяСтрока(ПодозрительнаяЛатинскаяСерия(Слово));

КонецФункции

// Первая латинская серия, похожая на опечатку. Критерий — в СерияПохожаНаОпечатку.
Функция ПодозрительнаяЛатинскаяСерия(Слово)

	Серия = "";
	Позиция = 1;
	Предел = СтрДлина(Слово) + 1;

	Пока Позиция <= Предел Цикл
		Если Позиция = Предел Тогда
			Символ = " ";
		Иначе
			Символ = Сред(Слово, Позиция, 1);
		КонецЕсли;

		Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", Символ) > 0 Тогда
			Серия = Серия + Символ;
		Иначе
			Если НЕ ПустаяСтрока(Серия) И СерияПохожаНаОпечатку(Серия) Тогда
				Возврат Серия;
			КонецЕсли;
			Серия = "";
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция СерияПохожаНаОпечатку(Серия)

	Верх = ВРег(Серия);
	Если Верх = "NULL" ИЛИ Верх = "UUID" ИЛИ Верх = "ID" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Признак 1: серия целиком из букв-двойников. Длина роли не играет —
	// «ОCTATKИ» набрано латиницей на пять букв подряд и от «ОСТАТКИ»
	// неотличимо, а проверка по одной длине такое пропускала.
	Если СерияИзБуквДвойников(Серия) Тогда
		Возврат Истина;
	КонецЕсли;

	// Признак 2: один-два символа легко задеть при переключённой раскладке,
	// осмысленное английское слово почти всегда длиннее.
	Возврат СтрДлина(Серия) <= 2;

КонецФункции

// Латинские буквы, визуально неотличимые от кириллических А,В,С,Е,Н,К,М,О,Р,Т,Х,У.
// Строчные b,h,k,m,t в список не входят: от кириллических в,н,к,м,т они
// отличаются начертанием и в глаза бросаются.
Функция СерияИзБуквДвойников(Серия)

	Для Индекс = 1 По СтрДлина(Серия) Цикл
		Если СтрНайти("ABCEHKMOPTXYacepxyo", Сред(Серия, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СодержитКириллицу(Слово)

	Для Индекс = 1 По СтрДлина(Слово) Цикл
		Если СтрНайти("АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя",
			Сред(Слово, Индекс, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// §2 п.3: массив видов субконто, заданный инлайн-литералом в параметрах ВТ.
// Такая форма проходит проверку, но при исполнении даёт «Неверные параметры»:
// массив передаётся только именованным параметром запроса.
// Функции встроенного языка, которых НЕТ в языке запросов. Список закрытый и
// подтверждённый: отклонять любую незнакомую функцию нельзя — язык запросов допускает
// платформенные функции и функции конфигурации, и ложный отказ хуже пропуска (§4.3).
// Пополнять только после подтверждения документацией и живой пробой, не «по памяти».
//
// АБС/ABS подтверждена живьём (БП КОРП 3.0.192.25): предвалидатор её пропускал, а
// исполнение падало синтаксической ошибкой на первом же вызове.
Функция НеподдерживаемыеФункцииЗапроса()

	Результат = Новый Массив;
	Результат.Добавить("АБС");
	Результат.Добавить("ABS");
	Возврат Результат;

КонецФункции

// Возвращает имя первой найденной неподдерживаемой функции или пустую строку.
// Ищется именно ВЫЗОВ: имя-токен и открывающая скобка за ним. Поле с таким именем
// или подстрока внутри длинного идентификатора вызовом не являются.
Функция ВызовНеподдерживаемойФункцииЗапроса(ТекстЗапроса)

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат "";
	КонецЕсли;

	ВерхТекст = ВРег(ТекстЗапросаБезЛитералов(ТекстЗапроса));
	Для Каждого Имя Из НеподдерживаемыеФункцииЗапроса() Цикл
		Позиция = 0;
		Пока Истина Цикл
			Позиция = СтрНайти(ВерхТекст, Имя, НаправлениеПоиска.СНачала, Позиция + 1);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;
			Если ЭтоВызовФункцииВПозиции(ВерхТекст, Позиция, Имя) Тогда
				Возврат Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЭтоВызовФункцииВПозиции(ВерхТекст, Позиция, Имя)

	// Слева — не часть идентификатора (иначе это ТабАБС, ЗначениеABS и подобное) и не
	// точка: Алиас.АБС(...) — обращение к полю, а не вызов функции языка запросов.
	Если Позиция > 1 Тогда
		СимволСлева = Сред(ВерхТекст, Позиция - 1, 1);
		Если СимволИдентификатора(СимволСлева) ИЛИ СимволСлева = "." Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Справа — только пробелы до открывающей скобки: без неё это не вызов.
	Индекс = Позиция + СтрДлина(Имя);
	Пока Индекс <= СтрДлина(ВерхТекст) Цикл
		Символ = Сред(ВерхТекст, Индекс, 1);
		Если Символ = "(" Тогда
			Возврат Истина;
		ИначеЕсли Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК Тогда
			Индекс = Индекс + 1;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЗаменаНеподдерживаемойФункцииЗапроса(Имя)

	Если ВРег(Строка(Имя)) = "АБС" ИЛИ ВРег(Строка(Имя)) = "ABS" Тогда
		Возврат "Замените " + Имя + "(X) на ВЫБОР КОГДА X < 0 ТОГДА -X ИНАЧЕ X КОНЕЦ."
			+ " При вложенности выражение повторяется целиком: сослаться на псевдоним"
			+ " той же строки ВЫБРАТЬ нельзя.";
	КонецЕсли;
	Возврат "Функции " + Имя + " в языке запросов 1С нет — перепишите выражение"
		+ " конструкциями языка запросов.";

КонецФункции

Функция ПодсказкаНеподдерживаемойФункцииЗапроса(Имя)

	Возврат "Функции " + Имя + " в языке запросов 1С нет: это функция встроенного языка."
		+ " " + ЗаменаНеподдерживаемойФункцииЗапроса(Имя);

КонецФункции

// Пропуск такого вызова предвалидатором — это отказ движка на исполнении, то есть
// потраченный запрос и сырая синтаксическая ошибка вместо готовой замены.
Процедура ДобавитьОшибкуНеподдерживаемойФункцииЗапроса(Результат, ТекстЗапроса)

	Имя = ВызовНеподдерживаемойФункцииЗапроса(ТекстЗапроса);
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьОшибку(Результат, "unsupported_query_function",
		ПодсказкаНеподдерживаемойФункцииЗапроса(Имя), Имя + "(");

КонецПроцедуры

Процедура ДобавитьОшибкуИнлайнМассиваСубконто(Результат, ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстЗапросаБезЛитералов(ТекстЗапроса));
	Позиция = СтрНайти(ВерхнийТекст, "(ЗНАЧЕНИЕ(ПЛАНВИДОВХАРАКТЕРИСТИК.");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	// инлайн-массив — это как минимум два ЗНАЧЕНИЕ() подряд внутри одной скобки
	ПозицияЗакрытия = НайтиЗакрывающуюСкобку(ВерхнийТекст, Позиция);
	Если ПозицияЗакрытия = 0 Тогда
		Возврат;
	КонецЕсли;

	Фрагмент = Сред(ВерхнийТекст, Позиция, ПозицияЗакрытия - Позиция + 1);
	Если ЧислоВхождений(Фрагмент, "ЗНАЧЕНИЕ(ПЛАНВИДОВХАРАКТЕРИСТИК.") < 2 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьОшибку(Результат, "subconto_inline_literal_instead_of_array_param",
		"Массив видов субконто задан инлайн-литералом в параметрах виртуальной таблицы. "
		+ "Такая форма проходит предварительную проверку, но при исполнении даёт "
		+ "«Неверные параметры». Передавать именованным параметром запроса со значением "
		+ "типа массив ссылок на ПланВидовХарактеристик.",
		"ЗНАЧЕНИЕ(ПланВидовХарактеристик....)");

КонецПроцедуры

// §5.2/§5.3: «ЕСТЬ НЕ NULL» для ссылочного поля без парной проверки пустой ссылки.
//
// Пустая ссылка НЕ равна NULL: незаполненный реквизит хранится как пустая ссылка
// и такой фильтр проходит. Ошибка особенно опасна в контрольных запросах — по их
// результату делается вывод о полноте данных источника.
//
// Правило применимо ТОЛЬКО к ссылочным полям, поэтому тип определяется по
// метаданным, а не угадывается по тексту: «Док.Проведен ЕСТЬ НЕ NULL» — булево,
// и требовать там проверку пустой ссылки бессмысленно.
//
// Fail-open: если тип поля определить не удалось (псевдоним не разрешён, объект
// или реквизит не найден, интроспекция дала сбой) — правило молчит. Ложная
// блокировка корректного запроса хуже пропуска: клиентский чекер всё равно
// предупредит.
Процедура ДобавитьОшибкуПустойСсылкиБезПроверки(Результат, ИсточникиЗапроса, ТекстЗапроса)

	ОчищенныйТекст = ТекстЗапросаБезЛитералов(ТекстЗапроса);
	Верх = ВРег(ОчищенныйТекст);

	// Явная проверка пустой ссылки где-либо в запросе снимает подозрение целиком.
	Если СтрНайти(Верх, "ПУСТАЯССЫЛКА") > 0 Тогда
		Возврат;
	КонецЕсли;

	АлиасыВнешних = АлиасыВнешнихСоединений(ОчищенныйТекст);
	Позиция = 1;

	Пока Позиция <= СтрДлина(Верх) Цикл
		ПозицияПроверки = СтрНайти(Верх, "ЕСТЬ НЕ NULL", , Позиция);
		Если ПозицияПроверки = 0 Тогда
			Прервать;
		КонецЕсли;

		ПолноеПоле = ПолеПередПроверкойNull(ОчищенныйТекст, ПозицияПроверки);
		Позиция = ПозицияПроверки + СтрДлина("ЕСТЬ НЕ NULL");

		Части = СтрРазделить(ПолноеПоле, ".", Ложь);
		Если Части.Количество() <> 2 Тогда
			// без префикса псевдонима или с цепочкой разыменования — не наш случай
			Продолжить;
		КонецЕсли;

		Алиас = Части[0];
		ИмяПоля = Части[1];

		// §4.4: у внешнего соединения «ЕСТЬ НЕ NULL» — индикатор совпадения пары,
		// а не проверка пустоты ссылки.
		Если АлиасОтноситсяКВнешнемуСоединению(АлиасыВнешних, Алиас) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПолеЯвляетсяСсылочным(ИсточникиЗапроса, ОчищенныйТекст, Алиас, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьОшибку(Результат, "empty_reference_not_filtered",
			"Поле «" + ПолноеПоле + "» ссылочное, и «ЕСТЬ НЕ NULL» для него недостаточно: "
			+ "пустая ссылка не равна NULL. Незаполненный реквизит хранится как пустая ссылка "
			+ "и такой фильтр проходит — строка попадёт в результат, хотя аналитика не заполнена. "
			+ "Добавить парную проверку: И " + ПолноеПоле + " <> ЗНАЧЕНИЕ(<Тип>.ПустаяСсылка). "
			+ "Для контрольных запросов о полноте данных это критично: без неё делается вывод "
			+ "«поле заполнено» по строкам с пустыми ссылками.",
			ПолноеПоле);
		Возврат;
	КонецЦикла;

КонецПроцедуры

Функция АлиасОтноситсяКВнешнемуСоединению(АлиасыВнешних, Алиас)

	Для Каждого Внешний Из АлиасыВнешних Цикл
		Если ВРег(Внешний) = ВРег(Алиас) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Полное имя поля, стоящее непосредственно перед «ЕСТЬ НЕ NULL».
Функция ПолеПередПроверкойNull(Текст, ПозицияПроверки)

	Конец = ПозицияПроверки - 1;
	Пока Конец >= 1 И Сред(Текст, Конец, 1) = " " Цикл
		Конец = Конец - 1;
	КонецЦикла;

	Начало = Конец;
	Пока Начало >= 1 Цикл
		Символ = Сред(Текст, Начало, 1);
		Если ЯвляетсяСимволомИдентификатора(Символ) ИЛИ Символ = "." Тогда
			Начало = Начало - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(Текст, Начало + 1, Конец - Начало);

КонецФункции

// Ссылочность поля по метаданным. Любая неудача разрешения даёт Ложь (fail-open).
Функция ПолеЯвляетсяСсылочным(ИсточникиЗапроса, ОчищенныйТекст, Алиас, ИмяПоля)

	Результат = Ложь;

	Попытка
		ПолноеИмяИсточника = ИсточникПоАлиасу(ИсточникиЗапроса, ОчищенныйТекст, Алиас);
		Если ПустаяСтрока(ПолноеИмяИсточника) Тогда
			Возврат Ложь;
		КонецЕсли;

		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяИсточника);
		Если ОбъектМД = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Реквизит = РеквизитОбъектаПоИмени(ОбъектМД, ИмяПоля);
		Если Реквизит = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл
			Если Метаданные.НайтиПоТипу(ТипРеквизита) <> Неопределено Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Интроспекция метаданных не должна ронять валидацию: молчим.
		Результат = Ложь;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ИсточникПоАлиасу(ИсточникиЗапроса, ОчищенныйТекст, Алиас)

	Для Каждого Источник Из ИсточникиЗапроса Цикл
		Если ПустаяСтрока(Источник.full_name) Тогда
			Продолжить;
		КонецЕсли;
		Алиасы = АлиасыИсточника(ОчищенныйТекст, Источник.raw);
		Для Каждого Кандидат Из Алиасы Цикл
			Если ВРег(Кандидат) = ВРег(Алиас) Тогда
				Возврат Источник.full_name;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

// Обращение к .Реквизиты прямое: у объектов метаданных нет метода Свойство()
// (это метод Структуры), а коллекция есть не у всех видов объектов. Вызывающая
// сторона выполняет обход внутри Попытка, поэтому отсутствие коллекции просто
// приводит к fail-open, как и любая другая неудача разрешения.
Функция РеквизитОбъектаПоИмени(ОбъектМД, ИмяПоля)

	Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
		Если ВРег(Реквизит.Имя) = ВРег(ИмяПоля) Тогда
			Возврат Реквизит;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// §1: основная (физическая) таблица регистра вместо виртуальной.
//
// Основная таблица отдаёт сырые проводки без агрегации и без аналитики субконто.
// Почти всегда нужное уже есть в виртуальной таблице: Обороты не содержит
// Регистратор, но ДвиженияССубконто содержит и его, и субконто обеих сторон.
//
// Законные случаи существуют, поэтому предусмотрен выход — маркер в тексте
// запроса непосредственно перед источником:
//   // СТАНДАРТ-ИСКЛЮЧЕНИЕ: base_register_table_without_vt_check — <обоснование>
// Обоснование обязано называть конкретное недостающее поле или свойство.
//
// Двух текстов не избежать. Источники ищутся в ТекстБезКомментариев, иначе имя
// регистра, упомянутое в комментарии, было бы принято за источник. Само же
// объявленное исключение живёт ИМЕННО в комментарии, поэтому проверять его нужно
// по исходному тексту: в ТекстБезКомментариев маркер уже заменён пробелами и не
// находится никогда — обход, описанный в AGENTS.md и в тексте этой же ошибки, не
// работал вообще.
//
// Нумерация строк совпадает в обоих текстах: ТекстБезСтрокИКомментариев гасит
// комментарии пробелами и сохраняет переводы строк, длина не меняется.
Процедура ДобавитьОшибкуОсновнойТаблицыРегистра(Результат, ТекстБезКомментариев, ИсходныйТекст = Неопределено)

	ТекстЗапроса = ТекстБезКомментариев;
	ТекстДляИсключений = ?(ИсходныйТекст = Неопределено, ТекстБезКомментариев, ИсходныйТекст);
	ВерхнийТекст = ВРег(ТекстЗапросаБезЛитералов(ТекстЗапроса));
	ВидыРегистров = Новый Массив;
	ВидыРегистров.Добавить("РЕГИСТРБУХГАЛТЕРИИ");
	ВидыРегистров.Добавить("РЕГИСТРНАКОПЛЕНИЯ");
	ВидыРегистров.Добавить("РЕГИСТРСВЕДЕНИЙ");

	Для Каждого ВидРегистра Из ВидыРегистров Цикл
		Позиция = 1;
		Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
			ПозицияРегистра = СтрНайти(ВерхнийТекст, ВидРегистра + ".", , Позиция);
			Если ПозицияРегистра = 0 Тогда
				Прервать;
			КонецЕсли;

			// Если третьим сегментом идёт виртуальная таблица — это не основная таблица.
			Если НЕ ПустаяСтрока(ИмяВиртуальнойТаблицыПослеИсточника(ВерхнийТекст, ПозицияРегистра, ВидРегистра)) Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			// Соединение с компаньоном <Регистр>.Субконто — документированный паттерн
			// (§1.1 стандартов): выбрать субконто ПО ВИДУ можно только так, а таблица
			// движений здесь якорь соединения, а не обход виртуальных таблиц. Сам
			// компаньон в §1.1 перечислен среди виртуальных таблиц регистра, поэтому
			// требовать для него объявленное исключение — требовать его за
			// использование виртуальной таблицы.
			Если СоединениеСКомпаньономСубконто(ВерхнийТекст, ВидРегистра) Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			НомерСтроки = НомерСтрокиПоПозиции(ТекстДляИсключений, ПозицияРегистра);
			Если ИсключениеОбъявлено(ТекстДляИсключений, "base_register_table_without_vt_check", НомерСтроки) Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			ДобавитьОшибку(Результат, "base_register_table_without_vt_check",
				"Используется основная (физическая) таблица регистра вида "
				+ ВидРегистраДляСообщения(ВидРегистра)
				+ ". Она отдаёт сырые записи без агрегации и без аналитики субконто. "
				+ "Допустима только после перебора ВСЕХ виртуальных таблиц этого регистра. "
				+ "Частая ошибка — остановиться на том, что Обороты не содержит Регистратор: "
				+ "ДвиженияССубконто содержит и его, и субконто обеих сторон. "
				+ "Если ни одна виртуальная таблица не подходит, объявить исключение "
				+ "комментарием перед источником: // СТАНДАРТ-ИСКЛЮЧЕНИЕ: "
				+ "base_register_table_without_vt_check — <какое поле недоступно в ВТ>.",
				ВидРегистраДляСообщения(ВидРегистра));
			Возврат;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Номер строки (с единицы), в которой находится позиция символа.
Функция НомерСтрокиПоПозиции(Текст, Позиция)

	Номер = 1;
	Предел = Мин(Позиция, СтрДлина(Текст));
	Для Индекс = 1 По Предел Цикл
		Если Сред(Текст, Индекс, 1) = Символы.ПС Тогда
			Номер = Номер + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Номер;

КонецФункции

// Объявлено ли документированное исключение для правила рядом с указанной
// строкой. Маркер действует на свою строку и следующие за ней две: обоснование
// может занимать вторую строку комментария, за ней идёт сам источник.
// Обоснование обязательно и должно быть содержательным — иначе исключение
// превращается в штамп и правило перестаёт работать.
Функция ИсключениеОбъявлено(ТекстЗапроса, КодПравила, НомерСтрокиИсточника)

	Строки = СтрРазделить(ТекстЗапроса, Символы.ПС, Истина);

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Строка = СокрЛП(Строки[Индекс]);
		Если СтрНайти(Строка, "//") <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ВРег(Строка), ВРег("СТАНДАРТ-ИСКЛЮЧЕНИЕ")) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Строка, КодПравила) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НомерМаркера = Индекс + 1;
		Если НомерСтрокиИсточника < НомерМаркера ИЛИ НомерСтрокиИсточника > НомерМаркера + 2 Тогда
			Продолжить;
		КонецЕсли;

		Если ОбоснованиеСодержательно(Строки, Индекс, КодПравила) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Обоснование собирается со строки маркера и продолжающих строк-комментариев.
Функция ОбоснованиеСодержательно(Строки, ИндексМаркера, КодПравила)

	Строка = СокрЛП(Строки[ИндексМаркера]);
	ПозицияКода = СтрНайти(Строка, КодПравила);
	Обоснование = СокрЛП(Сред(Строка, ПозицияКода + СтрДлина(КодПравила)));
	Обоснование = СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(Обоснование, "—", ""), "–", ""), "-", ""));

	Для Индекс = ИндексМаркера + 1 По Строки.Количество() - 1 Цикл
		Следующая = СокрЛП(Строки[Индекс]);
		Если СтрНайти(Следующая, "//") <> 1 Тогда
			Прервать;
		КонецЕсли;
		Если СтрНайти(ВРег(Следующая), ВРег("СТАНДАРТ-ИСКЛЮЧЕНИЕ")) > 0 Тогда
			Прервать;
		КонецЕсли;
		Обоснование = СокрЛП(Обоснование + " " + СокрЛП(Сред(Следующая, 3)));
	КонецЦикла;

	Если СтрДлина(Обоснование) < 15 Тогда
		Возврат Ложь;
	КонецЕсли;

	Верх = ВРег(Обоснование);
	Если Верх = ВРег("так удобнее") ИЛИ СтрНайти(Верх, ВРег("не подошл")) = 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// §4.4: поле внешне присоединённой таблицы без ЕСТЬNULL.
//
// При ЛЕВОМ/ПРАВОМ/ПОЛНОМ соединении любое поле присоединяемой таблицы может
// оказаться NULL по факту несовпадения пары. Условие ГДЕ со значением NULL
// считается НЕВЫПОЛНЕННЫМ — строка исчезает молча, без ошибки. Арифметика с
// NULL тоже даёт NULL.
//
// Исключение: поле-индикатор совпадения («<Псевдоним>.<Поле> ЕСТЬ NULL») —
// обёртка уничтожила бы саму проверку.
//
// Область действия псевдонима — свой оператор пакета. Одно и то же имя в разных
// операторах означает разные таблицы, поэтому разбор идёт по операторам, а набор
// внешних псевдонимов применяется только внутри того оператора, где они
// объявлены. Глобальный поиск по всему тексту давал ложный отказ: псевдоним,
// внешне присоединённый в одном операторе, требовал ЕСТЬNULL и в другом, где он
// был обычным единственным источником. Хуже того, отказ приходил ВМЕСТО
// настоящего замечания: проверка останавливается на первой ошибке.
Процедура ДобавитьОшибкуПоляВнешнегоСоединенияБезЕстьNull(Результат, ТекстЗапроса)

	ОчищенныйТекст = ТекстЗапросаБезЛитералов(ТекстЗапроса);

	// Первая найденная ошибка прекращает проверку, как и в прежней реализации,
	// поэтому достаточно следить за наполнением errors.
	КоличествоОшибокДо = Результат.errors.Количество();
	Для Каждого Оператор Из СтрРазделить(ОчищенныйТекст, ";", Истина) Цикл
		ПроверитьПоляВнешнегоСоединенияОператора(Результат, Оператор);
		Если Результат.errors.Количество() > КоличествоОшибокДо Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверка одного оператора пакета. Позиции внутри — позиции этого оператора;
// имя поля для сообщения берётся из него же, поэтому пересчёт в абсолютные
// позиции не нужен.
Процедура ПроверитьПоляВнешнегоСоединенияОператора(Результат, ТекстОператора)

	Алиасы = АлиасыВнешнихСоединений(ТекстОператора);
	Если Алиасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОчищенныйТекст = ТекстОператора;
	Верх = ВРег(ОчищенныйТекст);

	Для Каждого Алиас Из Алиасы Цикл
		Префикс = ВРег(Алиас) + ".";
		Позиция = 1;
		Пока Позиция <= СтрДлина(Верх) Цикл
			ПозицияПоля = СтрНайти(Верх, Префикс, , Позиция);
			Если ПозицияПоля = 0 Тогда
				Прервать;
			КонецЕсли;

			// начало слова: перед псевдонимом не должно быть символа идентификатора
			Если ПозицияПоля > 1
				И ЯвляетсяСимволомИдентификатора(Сред(Верх, ПозицияПоля - 1, 1)) Тогда
				Позиция = ПозицияПоля + СтрДлина(Префикс);
				Продолжить;
			КонецЕсли;

			Если ОбращениеЗащищеноЕстьNull(Верх, ПозицияПоля)
				ИЛИ ОбращениеЭтоИндикаторСовпадения(Верх, ПозицияПоля)
				ИЛИ ОбращениеВУсловииСоединения(Верх, ПозицияПоля) Тогда
				Позиция = ПозицияПоля + СтрДлина(Префикс);
				Продолжить;
			КонецЕсли;

			ДобавитьОшибку(Результат, "outer_join_field_without_isnull",
				"Поле «" + ПолноеИмяПоляВПозиции(ОчищенныйТекст, ПозицияПоля)
				+ "» относится к нулевой стороне внешнего соединения и взято без ЕСТЬNULL. "
				+ "Нулевая сторона определяется видом соединения, а не позицией в тексте: "
				+ "при ЛЕВОМ — присоединяемая (правая), при ПРАВОМ — левая, при ПОЛНОМ — обе, "
				+ "в цепочке соединений — все источники левее ПРАВОГО или ПОЛНОГО, потому что "
				+ "левый операнд такого соединения есть весь накопленный результат цепочки. "
				+ "При несовпадении пары поле равно NULL: условие ГДЕ или ИМЕЮЩИЕ со значением "
				+ "NULL считается НЕВЫПОЛНЕННЫМ и строка исчезает молча, арифметика с NULL даёт "
				+ "NULL, агрегат по колонке из NULL даёт NULL. Обернуть в ЕСТЬNULL со значением "
				+ "ТОГО ЖЕ типа: число — 0, строка — пустая строка, дата — ДАТАВРЕМЯ(1,1,1), "
				+ "булево — ЛОЖЬ, ссылка — ЗНАЧЕНИЕ(<Тип>.ПустаяСсылка). Значение другого типа "
				+ "создаёт колонку составного типа. Исключение — поле-индикатор совпадения "
				+ "(<Псевдоним>.<Поле> ЕСТЬ NULL), его оборачивать нельзя.",
				ПолноеИмяПоляВПозиции(ОчищенныйТекст, ПозицияПоля));
			Возврат;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Псевдонимы, поля которых могут оказаться NULL. Сторона определяется ВИДОМ
// соединения, а не позицией источника в тексте:
//   ЛЕВОЕ  — нулевая правая сторона (псевдоним после слова СОЕДИНЕНИЕ);
//   ПРАВОЕ — нулевая ЛЕВАЯ сторона (псевдоним источника перед видом соединения);
//   ПОЛНОЕ — нулевые ОБЕ стороны.
// Прежняя реализация всегда брала псевдоним после слова СОЕДИНЕНИЕ, поэтому при
// ПРАВОЕ проверяла не ту сторону: требовала ЕСТЬNULL там, где NULL невозможен, и
// пропускала настоящее нарушение на действительно нулевой стороне.
Функция АлиасыВнешнихСоединений(ОчищенныйТекст)

	Результат = Новый Массив;
	Верх = ВРег(ОчищенныйТекст);
	Виды = Новый Массив;
	Виды.Добавить("ЛЕВОЕ");
	Виды.Добавить("ПРАВОЕ");
	Виды.Добавить("ПОЛНОЕ");

	Для Каждого Вид Из Виды Цикл
		Позиция = 1;
		Пока Позиция <= СтрДлина(Верх) Цикл
			ПозицияВида = СтрНайти(Верх, Вид, , Позиция);
			Если ПозицияВида = 0 Тогда
				Прервать;
			КонецЕсли;

			ПозицияСоединения = СтрНайти(Верх, "СОЕДИНЕНИЕ", , ПозицияВида);
			Если ПозицияСоединения = 0 Тогда
				Прервать;
			КонецЕсли;

			// Правая сторона нулевая при ЛЕВОМ и ПОЛНОМ соединении.
			Если Вид = "ЛЕВОЕ" ИЛИ Вид = "ПОЛНОЕ" Тогда
				ПозицияКАК = СтрНайти(Верх, " КАК ", , ПозицияСоединения);
				Если ПозицияКАК > 0 Тогда
					Алиас = СледующееСловоПослеПозиции(ОчищенныйТекст, ПозицияКАК + СтрДлина(" КАК "));
					Если НЕ ПустаяСтрока(Алиас) Тогда
						Результат.Добавить(Алиас);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			// Левая сторона нулевая при ПРАВОМ и ПОЛНОМ соединении. Левый операнд —
			// это ВЕСЬ уже накопленный результат цепочки, а не последний источник:
			// в «(К ЛЕВОЕ СОЕДИНЕНИЕ Д) ПРАВОЕ СОЕДИНЕНИЕ О» нулевыми становятся и К,
			// и Д. Прежний «последний псевдоним до позиции» терял К, и поле
			// К.Наименование без ЕСТЬNULL проходило как валидное — при исполнении
			// строка со NULL исчезала из ГДЕ молча (issue #83, доказано счётом строк:
			// 75 всего = 74 прошедших + 1 потерянная).
			Если Вид = "ПРАВОЕ" ИЛИ Вид = "ПОЛНОЕ" Тогда
				Для Каждого Алиас Из ПсевдонимыИсточниковДоПозиции(ОчищенныйТекст, ПозицияВида) Цикл
					Результат.Добавить(Алиас);
				КонецЦикла;
			КонецЕсли;

			Позиция = ПозицияСоединения + СтрДлина("СОЕДИНЕНИЕ");
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все псевдонимы ИСТОЧНИКОВ, объявленные до позиции, — накопленная левая сторона
// цепочки соединений. Учитываются только «КАК» из раздела источников (после токена
// «ИЗ») и на нулевой глубине скобок: псевдонимы колонок из списка ВЫБРАТЬ стоят до
// «ИЗ» и не попадают, псевдонимы внутри подзапросов — глубже нуля, подзапрос
// участвует одним своим внешним псевдонимом. Границы токенов проверяются посимвольно,
// а не поиском « КАК » с пробелами: таб или перевод строки перед словом уже давал
// пропуск в правиле про «ПО» (FR-12), второй раз на те же грабли не наступаем.
Функция ПсевдонимыИсточниковДоПозиции(ОчищенныйТекст, Позиция)

	Результат = Новый Массив;
	Верх = ВРег(ОчищенныйТекст);

	// Начало раздела источников: первый токен ИЗ на нулевой глубине.
	НачалоИсточников = 0;
	Глубина = 0;
	Для Индекс = 1 По СтрДлина(Верх) - 2 Цикл
		Символ = Сред(Верх, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
		ИначеЕсли Глубина = 0 И Сред(Верх, Индекс, 2) = "ИЗ"
			И (Индекс = 1 ИЛИ НЕ ЯвляетсяСимволомИдентификатора(Сред(Верх, Индекс - 1, 1)))
			И НЕ ЯвляетсяСимволомИдентификатора(Сред(Верх, Индекс + 2, 1)) Тогда
			НачалоИсточников = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НачалоИсточников = 0 ИЛИ НачалоИсточников >= Позиция Тогда
		Возврат Результат;
	КонецЕсли;

	Глубина = 0;
	Индекс = НачалоИсточников;
	Пока Индекс < Позиция Цикл
		Символ = Сред(Верх, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
		ИначеЕсли Глубина = 0 И Сред(Верх, Индекс, 3) = "КАК"
			И НЕ ЯвляетсяСимволомИдентификатора(Сред(Верх, Индекс - 1, 1))
			И НЕ ЯвляетсяСимволомИдентификатора(Сред(Верх, Индекс + 3, 1)) Тогда
			Алиас = СледующееСловоПослеПозиции(ОчищенныйТекст, Индекс + 3);
			Если НЕ ПустаяСтрока(Алиас) Тогда
				Результат.Добавить(Алиас);
			КонецЕсли;
			Индекс = Индекс + 3;
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СледующееСловоПослеПозиции(Текст, Позиция)

	Слово = "";
	Для Индекс = Позиция По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЯвляетсяСимволомИдентификатора(Символ) Тогда
			Слово = Слово + Символ;
		ИначеЕсли НЕ ПустаяСтрока(Слово) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Слово;

КонецФункции

Функция ПолноеИмяПоляВПозиции(Текст, ПозицияНачала)

	Имя = "";
	Для Индекс = ПозицияНачала По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЯвляетсяСимволомИдентификатора(Символ) ИЛИ Символ = "." Тогда
			Имя = Имя + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Имя;

КонецФункции

// Обращение находится внутри вызова ЕСТЬNULL(...).
Функция ОбращениеЗащищеноЕстьNull(Верх, ПозицияПоля)

	Позиция = 1;
	Пока Позиция <= СтрДлина(Верх) Цикл
		ПозицияФункции = СтрНайти(Верх, "ЕСТЬNULL", , Позиция);
		Если ПозицияФункции = 0 ИЛИ ПозицияФункции > ПозицияПоля Тогда
			Прервать;
		КонецЕсли;

		ПозицияСкобки = СтрНайти(Верх, "(", , ПозицияФункции);
		Если ПозицияСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияЗакрытия = НайтиЗакрывающуюСкобку(Верх, ПозицияСкобки);
		Если ПозицияЗакрытия > ПозицияПоля Тогда
			Возврат Истина;
		КонецЕсли;

		Позиция = ПозицияФункции + СтрДлина("ЕСТЬNULL");
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Сразу после поля идёт «ЕСТЬ NULL» или «ЕСТЬ НЕ NULL» — это проверка факта
// совпадения пары, а не использование значения.
Функция ОбращениеЭтоИндикаторСовпадения(Верх, ПозицияПоля)

	Хвост = СокрЛП(Сред(Верх, ПозицияПоля + СтрДлина(ПолноеИмяПоляВПозиции(Верх, ПозицияПоля))));
	Возврат СтрНайти(Хвост, "ЕСТЬ NULL") = 1 ИЛИ СтрНайти(Хвост, "ЕСТЬ НЕ NULL") = 1;

КонецФункции

// Обращение внутри условия соединения «ПО ...»: там сравнение и строит пару,
// обёртка не нужна.
//
// Ключевое слово ищется как ОТДЕЛЬНОЕ СЛОВО при любом окружающем пробельном
// символе. Прежняя реализация искала подстроку " ПО " с пробелом, поэтому ПО на
// отдельной строке с отступом табуляцией не распознавалось: исключение не
// применялось и законный запрос отклонялся. Табуляция — обычный отступ в 1С.
Функция ОбращениеВУсловииСоединения(Верх, ПозицияПоля)

	ПозицияПО = ПоследнееКлючевоеСловоДоПозиции(Верх, "ПО", ПозицияПоля);
	Если ПозицияПО = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// секция ПО заканчивается на ближайшем ключевом слове верхнего уровня
	КонецСекции = СтрДлина(Верх) + 1;
	КлючевыеСлова = СтрРазделить("ГДЕ,СГРУППИРОВАТЬ,УПОРЯДОЧИТЬ,ИМЕЮЩИЕ,ВЫБРАТЬ,ПОМЕСТИТЬ,ИНДЕКСИРОВАТЬ,ЛЕВОЕ,ПРАВОЕ,ПОЛНОЕ,ВНУТРЕННЕЕ,ОБЪЕДИНИТЬ", ",", Истина);
	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		Найдено = ПервоеКлючевоеСловоОтПозиции(Верх, КлючевоеСлово, ПозицияПО + СтрДлина("ПО"));
		Если Найдено > 0 И Найдено < КонецСекции Тогда
			КонецСекции = Найдено;
		КонецЕсли;
	КонецЦикла;

	Возврат ПозицияПоля < КонецСекции;

КонецФункции

// Слово считается отдельным, если соседние символы не являются символами
// идентификатора. Так «ПО» не путается с «ПОМЕСТИТЬ»/«ПОДОБНО», а отступ
// табуляцией или переводом строки распознаётся так же, как пробел.
Функция КлючевоеСловоНаПозиции(Верх, Слово, Позиция)

	Если Позиция > 1
		И ЯвляетсяСимволомИдентификатора(Сред(Верх, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияПосле = Позиция + СтрДлина(Слово);
	Если ПозицияПосле <= СтрДлина(Верх)
		И ЯвляетсяСимволомИдентификатора(Сред(Верх, ПозицияПосле, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПоследнееКлючевоеСловоДоПозиции(Верх, Слово, ПозицияГраницы)

	Результат = 0;
	Поиск = 1;
	Пока Поиск <= СтрДлина(Верх) Цикл
		Найдено = СтрНайти(Верх, Слово, , Поиск);
		Если Найдено = 0 ИЛИ Найдено > ПозицияГраницы Тогда
			Прервать;
		КонецЕсли;
		Если КлючевоеСловоНаПозиции(Верх, Слово, Найдено) Тогда
			Результат = Найдено;
		КонецЕсли;
		Поиск = Найдено + СтрДлина(Слово);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПервоеКлючевоеСловоОтПозиции(Верх, Слово, ПозицияОт)

	Поиск = ПозицияОт;
	Пока Поиск <= СтрДлина(Верх) Цикл
		Найдено = СтрНайти(Верх, Слово, , Поиск);
		Если Найдено = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Если КлючевоеСловоНаПозиции(Верх, Слово, Найдено) Тогда
			Возврат Найдено;
		КонецЕсли;
		Поиск = Найдено + СтрДлина(Слово);
	КонецЦикла;

	Возврат 0;

КонецФункции

// §2: отбор по полю виртуальной таблицы, вынесенный во внешний ГДЕ.
//
// Правило общее и не зависит от замеров времени: параметры ВТ применяются ДО
// агрегации, внешний ГДЕ — ПОСЛЕ, поэтому речь о корректности агрегации, а не
// только о скорости. Документация языка запросов отдельно отмечает, что
// «ЛЕВОЕ СОЕДИНЕНИЕ с ВТ + ГДЕ на поле правой таблицы» превращает левое
// соединение во внутреннее — то есть меняет состав результата.
//
// Не пересекается с resource_field_in_where: та диагностика срабатывает только
// когда источника-ВТ в запросе НЕТ и читается основная таблица регистра.
Процедура ДобавитьОшибкуОтбораПоВТвоВнешнемГде(Результат, ТекстЗапроса)

	ОчищенныйТекст = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	ИсточникВТ = НайтиИсточникВиртуальнойТаблицыВЗапросе(ТекстЗапроса);
	Если ИсточникВТ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Алиасы = АлиасыИсточникаВиртуальнойТаблицы(ОчищенныйТекст, ИсточникВТ.raw);
	Если Алиасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СекцияГде = СекцияГдеЗапроса(ОчищенныйТекст);
	Если ПустаяСтрока(СекцияГде) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Алиас Из Алиасы Цикл
		Если ПустаяСтрока(Алиас) Тогда
			Продолжить;
		КонецЕсли;
		// Отбор по РЕСУРСУ во внешнем ГДЕ законен и неизбежен: позиции параметров
		// виртуальной таблицы принимают условия по счёту, субконто и измерениям, но не
		// по суммам и количествам. «ГДЕ Остатки.СуммаОстаток <> 0» — нормальная форма,
		// и правило её отклонять не должно.
		ПолеОтбора = ПервоеПолеАлиасаВСекции(СекцияГде, Алиас);
		Если ПустаяСтрока(ПолеОтбора) Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеЯвляетсяРесурсомРегистра(ИсточникВТ.object_name, ПолеОтбора) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьОшибку(Результат, "vt_filter_in_external_where",
			"Отбор по полю виртуальной таблицы (" + Алиас + "." + ПолеОтбора + ") вынесен во внешний ГДЕ. "
			+ "Параметры виртуальной таблицы применяются ДО агрегации, внешний ГДЕ — ПОСЛЕ: "
			+ "это влияет на корректность результата, а не только на скорость. "
			+ "Перенести отбор в параметры " + ИсточникВТ.source_table
			+ ": отбор по счёту — в позицию условия по счёту, виды субконто — в позицию Субконто, "
			+ "отборы по значению — в последнюю позицию (общее условие). "
			+ "Проверку типа записывать как ТИПЗНАЧЕНИЯ(Поле) = ТИПЗНАЧЕНИЯ(ЗНАЧЕНИЕ(<Тип>.ПустаяСсылка)).",
			Алиас);
		Возврат;
	КонецЦикла;

КонецПроцедуры

// В запросе присутствует соединение с таблицей-компаньоном <Регистр>.Субконто.
// Только бухгалтерский регистр имеет такой компаньон, поэтому для остальных видов
// проверка всегда отрицательна.
Функция СоединениеСКомпаньономСубконто(ВерхнийТекст, ВидРегистра)

	Если ВидРегистра <> "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Возврат Ложь;
	КонецЕсли;

	Позиция = 1;
	Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
		Найдено = СтрНайти(ВерхнийТекст, ".СУБКОНТО", , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		// Отсечь СубконтоN, СубконтоДт, ДвиженияССубконто: за именем компаньона идёт
		// не идентификаторный символ.
		СледПоз = Найдено + СтрДлина(".СУБКОНТО");
		Если СледПоз > СтрДлина(ВерхнийТекст)
			ИЛИ НЕ ЯвляетсяСимволомИдентификатора(Сред(ВерхнийТекст, СледПоз, 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СледПоз;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Первое поле, к которому обращаются через данный псевдоним в секции ГДЕ.
// Нужно, чтобы отличить отбор по измерению (нарушение) от отбора по ресурсу
// (законная форма: параметры ВТ суммы и количества не принимают).
Функция ПервоеПолеАлиасаВСекции(СекцияГде, Алиас)

	Верх = ВРег(СекцияГде);
	Искомое = ВРег(Алиас) + ".";
	Позиция = СтрНайти(Верх, Искомое);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	НачалоПоля = Позиция + СтрДлина(Искомое);
	Результат = "";
	Для Индекс = НачалоПоля По СтрДлина(СекцияГде) Цикл
		Символ = Сред(СекцияГде, Индекс, 1);
		Если НЕ ЯвляетсяСимволомИдентификатора(Символ) Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поле виртуальной таблицы образовано от ресурса регистра, если начинается с имени
// ресурса: ресурс Сумма даёт СуммаОстаток/СуммаОборотДт, Количество —
// КоличествоОстаток и т.д. Состав ресурсов берётся из метаданных, а не из списка
// имён, поэтому правило не зависит от конфигурации.
Функция ПолеЯвляетсяРесурсомРегистра(ПолноеИмяРегистра, ИмяПоля)

	Попытка
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяРегистра);
		Если ОбъектМД = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ВерхнееПоле = ВРег(ИмяПоля);
		Для Каждого Ресурс Из ОбъектМД.Ресурсы Цикл
			Если СтрНачинаетсяС(ВерхнееПоле, ВРег(Ресурс.Имя)) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Регистр без коллекции Ресурсы (например регистр сведений без ресурсов) —
		// считаем поле не ресурсом, правило продолжит проверку.
		Возврат Ложь;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Текст секции ГДЕ до ближайшего следующего ключевого слова верхнего уровня.
Функция СекцияГдеЗапроса(ОчищенныйТекст)

	Верх = ВРег(ОчищенныйТекст);
	ПозицияГде = СтрНайти(Верх, "ГДЕ");
	Если ПозицияГде = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозицияКонца = СтрДлина(Верх) + 1;
	КлючевыеСлова = СтрРазделить("СГРУППИРОВАТЬ ПО,ИМЕЮЩИЕ,УПОРЯДОЧИТЬ ПО,ОБЪЕДИНИТЬ,ИНДЕКСИРОВАТЬ ПО,ИТОГИ", ",", Истина);
	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		ПозицияКлюча = СтрНайти(Верх, КлючевоеСлово, , ПозицияГде + 1);
		Если ПозицияКлюча > 0 И ПозицияКлюча < ПозицияКонца Тогда
			ПозицияКонца = ПозицияКлюча;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(ОчищенныйТекст, ПозицияГде, ПозицияКонца - ПозицияГде);

КонецФункции

// Подсчёт вхождений подстроки. Реализован через СтрНайти намеренно: платформенная
// СтрЧислоВхождений в этом модуле нигде больше не используется, и её доступность
// не подтверждена прецедентом — а СтрНайти применяется по всему модулю.
Функция ЧислоВхождений(Текст, Подстрока)

	Если ПустаяСтрока(Подстрока) Тогда
		Возврат 0;
	КонецЕсли;

	Количество = 0;
	Позиция = СтрНайти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Позиция = СтрНайти(Текст, Подстрока, , Позиция + СтрДлина(Подстрока));
	КонецЦикла;

	Возврат Количество;

КонецФункции

// §4.1: виртуальная таблица не участвует в СОЕДИНЕНИЕ напрямую. Обязательная
// последовательность — отборы в параметрах ВТ, ПОМЕСТИТЬ, ИНДЕКСИРОВАТЬ ПО,
// и только затем соединение: иначе СУБД не может оптимизировать соединение.
Процедура ДобавитьОшибкуПрямогоСоединенияСВиртуальнойТаблицей(Результат, ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстЗапросаБезЛитералов(ТекстЗапроса));
	Позиция = 1;

	Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
		ПозицияСоединения = СтрНайти(ВерхнийТекст, "СОЕДИНЕНИЕ", , Позиция);
		Если ПозицияСоединения = 0 Тогда
			Прервать;
		КонецЕсли;

		Хвост = Сред(ВерхнийТекст, ПозицияСоединения + СтрДлина("СОЕДИНЕНИЕ"));
		ИмяВТ = ВиртуальнаяТаблицаВНачалеФрагмента(Хвост);
		Если НЕ ПустаяСтрока(ИмяВТ) Тогда
			ДобавитьОшибку(Результат, "direct_join_with_virtual_table",
				"Виртуальная таблица " + ИмяВиртуальнойТаблицыДляСообщения(ИмяВТ)
				+ " участвует в СОЕДИНЕНИЕ напрямую. Это документированный антипаттерн "
				+ "производительности языка запросов («СУБД не может оптимизировать»), "
				+ "см. справку: query-syntax, раздел «Антипаттерны производительности». "
				+ "Запрос при этом исполним, но отклоняется до выполнения — как и ВЫБРАТЬ *. "
				+ "Последовательность обязательна: наложить отборы в параметрах ВТ, ПОМЕСТИТЬ во "
				+ "временную таблицу, ИНДЕКСИРОВАТЬ ПО полям будущего соединения, и только затем СОЕДИНЕНИЕ.",
				ИмяВиртуальнойТаблицыДляСообщения(ИмяВТ));
			Возврат;
		КонецЕсли;

		Позиция = ПозицияСоединения + СтрДлина("СОЕДИНЕНИЕ");
	КонецЦикла;

КонецПроцедуры

// Возвращает имя виртуальной таблицы, если фрагмент начинается с источника вида
// «<ВидРегистра>.<Имя>.<ВТ>(» — то есть ВТ стоит непосредственно в соединении.
Функция ВиртуальнаяТаблицаВНачалеФрагмента(Фрагмент)

	Очищенный = СокрЛП(СтрЗаменить(СтрЗаменить(Фрагмент, Символы.ПС, " "), Символы.Таб, " "));
	ПозицияСкобки = СтрНайти(Очищенный, "(");
	Если ПозицияСкобки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Голова = Лев(Очищенный, ПозицияСкобки - 1);
	Если СтрНайти(Голова, " ") > 0 Тогда
		// между СОЕДИНЕНИЕ и скобкой есть пробел — это не «источник(» вплотную
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(Голова, ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;

	ВидРегистра = Части[0];
	Если ВидРегистра <> "РЕГИСТРБУХГАЛТЕРИИ"
		И ВидРегистра <> "РЕГИСТРНАКОПЛЕНИЯ"
		И ВидРегистра <> "РЕГИСТРСВЕДЕНИЙ" Тогда
		Возврат "";
	КонецЕсли;

	ИмяВТ = Части[2];
	Если ИмяВТ = "ОСТАТКИ" ИЛИ ИмяВТ = "ОБОРОТЫ" ИЛИ ИмяВТ = "ОСТАТКИИОБОРОТЫ"
		ИЛИ ИмяВТ = "ОБОРОТЫДТКТ" ИЛИ ИмяВТ = "СРЕЗПОСЛЕДНИХ" ИЛИ ИмяВТ = "СРЕЗПЕРВЫХ"
		ИЛИ ИмяВТ = "ДВИЖЕНИЯССУБКОНТО" Тогда
		Возврат ИмяВТ;
	КонецЕсли;

	Возврат "";

КонецФункции

// Сигнатуры виртуальных таблиц: число позиций и назначение позиции условия по
// счёту. Позиции фиксированы платформой и не зависят от конфигурации, поэтому
// проверяются статически, без обращения к метаданным.
//
// ВАЖНО: одно и то же имя ВТ имеет РАЗНУЮ сигнатуру у разных видов регистра
// (Остатки — 4 позиции у регистра бухгалтерии и 2 у регистра накопления).
// Регистр расчёта намеренно не проверяется: наличие и сигнатура его виртуальных
// таблиц не гарантированы платформой и зависят от настройки конкретного регистра.
Процедура ДобавитьОшибкиСигнатурВиртуальныхТаблиц(Результат, ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстЗапроса);
	ВидыРегистров = Новый Массив;
	ВидыРегистров.Добавить("РЕГИСТРБУХГАЛТЕРИИ");
	ВидыРегистров.Добавить("РЕГИСТРНАКОПЛЕНИЯ");
	ВидыРегистров.Добавить("РЕГИСТРСВЕДЕНИЙ");

	Для Каждого ВидРегистра Из ВидыРегистров Цикл
		Позиция = 1;
		Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
			ПозицияРегистра = СтрНайти(ВерхнийТекст, ВидРегистра + ".", , Позиция);
			Если ПозицияРегистра = 0 Тогда
				Прервать;
			КонецЕсли;

			ИмяВТ = ИмяВиртуальнойТаблицыПослеИсточника(ВерхнийТекст, ПозицияРегистра, ВидРегистра);
			Если ПустаяСтрока(ИмяВТ) Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			ЧислоПозиций = ЧислоПозицийВиртуальнойТаблицы(ВидРегистра, ИмяВТ);
			Если ЧислоПозиций = 0 Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			ПозицияОткрытия = ПозицияОткрытияВиртуальнойТаблицы(ВерхнийТекст, ПозицияРегистра, ИмяВТ);
			Если ПозицияОткрытия = 0 Тогда
				Позиция = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
				Продолжить;
			КонецЕсли;

			ПозицияЗакрытия = НайтиЗакрывающуюСкобку(ВерхнийТекст, ПозицияОткрытия);
			Если ПозицияЗакрытия = 0 Тогда
				Позиция = ПозицияОткрытия + 1;
				Продолжить;
			КонецЕсли;

			ПараметрыВТ = Сред(ВерхнийТекст, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1);
			Аргументы = РазобратьПозицииПараметровВТ(ПараметрыВТ);

			// Висящая запятая перед закрывающей скобкой допустима: пустой последний
			// аргумент не считается заданной позицией.
			ФактическихПозиций = Аргументы.Количество();
			Если ФактическихПозиций > 0
				И ПустаяСтрока(Аргументы[ФактическихПозиций - 1]) Тогда
				ФактическихПозиций = ФактическихПозиций - 1;
			КонецЕсли;

			Если ФактическихПозиций = 0 Тогда
				Позиция = ПозицияЗакрытия + 1;
				Продолжить;
			КонецЕсли;

			Если ФактическихПозиций > ЧислоПозиций Тогда
				ДобавитьОшибку(Результат, "vt_signature_too_many_positions",
					"Виртуальная таблица " + ИмяВиртуальнойТаблицыДляСообщения(ИмяВТ)
					+ " регистра вида " + ВидРегистраДляСообщения(ВидРегистра)
					+ " принимает " + Строка(ЧислоПозиций) + " позиц. ("
					+ ИменаПозицийВиртуальнойТаблицы(ВидРегистра, ИмяВТ)
					+ "), передано " + Строка(ФактическихПозиций)
					+ ". Лишние аргументы дают ошибку «Неверные параметры». "
					+ "Учтите: одно и то же имя виртуальной таблицы имеет разную сигнатуру у разных видов регистра.",
					ИмяВиртуальнойТаблицыДляСообщения(ИмяВТ));
				Позиция = ПозицияЗакрытия + 1;
				Продолжить;
			КонецЕсли;

			ДобавитьОшибкуСубконтоВПозицииУсловияСчета(
				Результат, ВидРегистра, ИмяВТ, Аргументы, ФактическихПозиций);

			Позиция = ПозицияЗакрытия + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Условие по ЗНАЧЕНИЮ субконто, ошибочно помещённое в позицию условия по счёту.
// Исторически самая дорогая ошибка проекта: платформа отвечает «Поле не найдено
// Субконто1», что провоцирует ложный вывод о платформенном ограничении.
Процедура ДобавитьОшибкуСубконтоВПозицииУсловияСчета(Результат, ВидРегистра, ИмяВТ, Аргументы, ФактическихПозиций)

	ПозицииСчета = ПозицииУсловияСчетаВиртуальнойТаблицы(ВидРегистра, ИмяВТ);
	Если ПозицииСчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПозицияУсловия = ПозицияОбщегоУсловияВиртуальнойТаблицы(ВидРегистра, ИмяВТ);

	Для Каждого Индекс Из ПозицииСчета Цикл
		Если Индекс >= ФактическихПозиций Тогда
			Продолжить;
		КонецЕсли;
		Аргумент = Аргументы[Индекс];
		НайденноеПоле = ПервоеПолеСубконтоВТексте(Аргумент);
		Если ПустаяСтрока(НайденноеПоле) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьОшибку(Результат, "vt_subconto_condition_in_account_position",
			"«" + НайденноеПоле + "» указано в позиции " + Строка(Индекс + 1)
			+ " (условие по счёту), которая видит только поля счёта. Отсюда ошибка «Поле не найдено "
			+ НайденноеПоле + "». Условия по ЗНАЧЕНИЮ субконто помещаются в позицию "
			+ Строка(ПозицияУсловия + 1) + " (общее условие).",
			НайденноеПоле);
		Возврат;
	КонецЦикла;

КонецПроцедуры

// Разбор аргументов вызова на позиции по запятым нулевого уровня вложенности.
// Строковые литералы пропускаются: запятая внутри кавычек не разделяет позиции.
Функция РазобратьПозицииПараметровВТ(ПараметрыВТ)

	Позиции = Новый Массив;
	Глубина = 0;
	ВКавычках = Ложь;
	Начало = 1;

	Для Индекс = 1 По СтрДлина(ПараметрыВТ) Цикл
		Символ = Сред(ПараметрыВТ, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
		ИначеЕсли ВКавычках Тогда
			// внутри литерала разделители не учитываются
		ИначеЕсли Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Позиции.Добавить(СокрЛП(Сред(ПараметрыВТ, Начало, Индекс - Начало)));
			Начало = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Позиции.Добавить(СокрЛП(Сред(ПараметрыВТ, Начало)));

	Возврат Позиции;

КонецФункции

// Имя виртуальной таблицы сразу после «<ВидРегистра>.<Имя>.» — третий сегмент.
Функция ИмяВиртуальнойТаблицыПослеИсточника(ВерхнийТекст, ПозицияРегистра, ВидРегистра)

	Курсор = ПозицияРегистра + СтрДлина(ВидРегистра) + 1;
	ТочкаПослеИмени = СтрНайти(ВерхнийТекст, ".", , Курсор);
	Если ТочкаПослеИмени = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Между источником и его виртуальной таблицей не может быть пробела или скобки:
	// такой разрыв означает, что третьего сегмента нет.
	ИмяИсточника = Сред(ВерхнийТекст, Курсор, ТочкаПослеИмени - Курсор);
	Если ПустаяСтрока(ИмяИсточника)
		ИЛИ СтрНайти(ИмяИсточника, " ") > 0
		ИЛИ СтрНайти(ИмяИсточника, "(") > 0
		ИЛИ СтрНайти(ИмяИсточника, ")") > 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Индекс = ТочкаПослеИмени + 1 По СтрДлина(ВерхнийТекст) Цикл
		Символ = Сред(ВерхнийТекст, Индекс, 1);
		Если Символ = "(" ИЛИ Символ = " " ИЛИ Символ = Символы.ПС
			ИЛИ Символ = Символы.ВК ИЛИ Символ = Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЧислоПозицийВиртуальнойТаблицы(ВидРегистра, ИмяВТ)

	Если ВидРегистра = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Если ИмяВТ = "ОСТАТКИ" Тогда Возврат 4; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫ" Тогда Возврат 8; КонецЕсли;
		Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда Возврат 7; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫДТКТ" Тогда Возврат 8; КонецЕсли;
	ИначеЕсли ВидРегистра = "РЕГИСТРНАКОПЛЕНИЯ" Тогда
		Если ИмяВТ = "ОСТАТКИ" Тогда Возврат 2; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫ" Тогда Возврат 4; КонецЕсли;
		Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда Возврат 5; КонецЕсли;
	ИначеЕсли ВидРегистра = "РЕГИСТРСВЕДЕНИЙ" Тогда
		Если ИмяВТ = "СРЕЗПОСЛЕДНИХ" Тогда Возврат 2; КонецЕсли;
		Если ИмяВТ = "СРЕЗПЕРВЫХ" Тогда Возврат 2; КонецЕсли;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ИменаПозицийВиртуальнойТаблицы(ВидРегистра, ИмяВТ)

	Если ВидРегистра = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Если ИмяВТ = "ОСТАТКИ" Тогда
			Возврат "Период, УсловиеСчета, Субконто, Условие";
		КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫ" Тогда
			Возврат "НачалоПериода, КонецПериода, Периодичность, УсловиеСчета, Субконто, Условие, УсловиеКорСчета, КорСубконто";
		КонецЕсли;
		Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда
			Возврат "НачалоПериода, КонецПериода, Периодичность, МетодДополнения, УсловиеСчета, Субконто, Условие";
		КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫДТКТ" Тогда
			Возврат "НачалоПериода, КонецПериода, Периодичность, УсловиеСчетаДт, СубконтоДт, УсловиеСчетаКт, СубконтоКт, Условие";
		КонецЕсли;
	ИначеЕсли ВидРегистра = "РЕГИСТРНАКОПЛЕНИЯ" Тогда
		Если ИмяВТ = "ОСТАТКИ" Тогда Возврат "Период, Условие"; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫ" Тогда
			Возврат "НачалоПериода, КонецПериода, Периодичность, Условие";
		КонецЕсли;
		Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда
			Возврат "НачалоПериода, КонецПериода, Периодичность, МетодДополнения, Условие";
		КонецЕсли;
	ИначеЕсли ВидРегистра = "РЕГИСТРСВЕДЕНИЙ" Тогда
		Возврат "Период, Условие";
	КонецЕсли;

	Возврат "";

КонецФункции

// Индексы позиций (от нуля), которые видят только поля счёта.
Функция ПозицииУсловияСчетаВиртуальнойТаблицы(ВидРегистра, ИмяВТ)

	Результат = Новый Массив;
	Если ВидРегистра <> "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Возврат Результат;
	КонецЕсли;

	Если ИмяВТ = "ОСТАТКИ" Тогда
		Результат.Добавить(1);
	ИначеЕсли ИмяВТ = "ОБОРОТЫ" Тогда
		Результат.Добавить(3);
	ИначеЕсли ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда
		Результат.Добавить(4);
	ИначеЕсли ИмяВТ = "ОБОРОТЫДТКТ" Тогда
		Результат.Добавить(3);
		Результат.Добавить(5);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Индекс позиции (от нуля) общего условия, куда помещаются отборы по значению.
Функция ПозицияОбщегоУсловияВиртуальнойТаблицы(ВидРегистра, ИмяВТ)

	Если ВидРегистра = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Если ИмяВТ = "ОСТАТКИ" Тогда Возврат 3; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫ" Тогда Возврат 5; КонецЕсли;
		Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда Возврат 6; КонецЕсли;
		Если ИмяВТ = "ОБОРОТЫДТКТ" Тогда Возврат 7; КонецЕсли;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Первое вхождение поля вида СубконтоN / СубконтоДтN / СубконтоКтN.
Функция ПервоеПолеСубконтоВТексте(Аргумент)

	Основы = Новый Массив;
	Основы.Добавить("СУБКОНТОДТ");
	Основы.Добавить("СУБКОНТОКТ");
	Основы.Добавить("СУБКОНТО");

	Для Каждого Основа Из Основы Цикл
		Для Номер = 1 По 3 Цикл
			Образец = Основа + Строка(Номер);
			Если СтрНайти(Аргумент, Образец) > 0 Тогда
				Возврат ИмяПоляСубконтоДляСообщения(Основа) + Строка(Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИмяПоляСубконтоДляСообщения(Основа)

	Если Основа = "СУБКОНТОДТ" Тогда
		Возврат "СубконтоДт";
	ИначеЕсли Основа = "СУБКОНТОКТ" Тогда
		Возврат "СубконтоКт";
	КонецЕсли;
	Возврат "Субконто";

КонецФункции

Функция ИмяВиртуальнойТаблицыДляСообщения(ИмяВТ)

	Если ИмяВТ = "ОСТАТКИ" Тогда Возврат "Остатки"; КонецЕсли;
	Если ИмяВТ = "ОБОРОТЫ" Тогда Возврат "Обороты"; КонецЕсли;
	Если ИмяВТ = "ОСТАТКИИОБОРОТЫ" Тогда Возврат "ОстаткиИОбороты"; КонецЕсли;
	Если ИмяВТ = "ОБОРОТЫДТКТ" Тогда Возврат "ОборотыДтКт"; КонецЕсли;
	Если ИмяВТ = "СРЕЗПОСЛЕДНИХ" Тогда Возврат "СрезПоследних"; КонецЕсли;
	Если ИмяВТ = "СРЕЗПЕРВЫХ" Тогда Возврат "СрезПервых"; КонецЕсли;
	Возврат ИмяВТ;

КонецФункции

Функция ВидРегистраДляСообщения(ВидРегистра)

	Если ВидРегистра = "РЕГИСТРБУХГАЛТЕРИИ" Тогда Возврат "РегистрБухгалтерии"; КонецЕсли;
	Если ВидРегистра = "РЕГИСТРНАКОПЛЕНИЯ" Тогда Возврат "РегистрНакопления"; КонецЕсли;
	Если ВидРегистра = "РЕГИСТРСВЕДЕНИЙ" Тогда Возврат "РегистрСведений"; КонецЕсли;
	Возврат ВидРегистра;

КонецФункции

Процедура ДобавитьОшибкиРазыменованияВПараметрахБухгалтерскихОстатков(Результат, ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстЗапроса);
	Позиция = 1;
	Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
		ПозицияРегистра = СтрНайти(ВерхнийТекст, "РЕГИСТРБУХГАЛТЕРИИ.", , Позиция);
		Если ПозицияРегистра = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияОткрытия = ПозицияОткрытияБухгалтерскойТаблицыОстатков(ВерхнийТекст, ПозицияРегистра);
		Если ПозицияОткрытия = 0 Тогда
			Позиция = ПозицияРегистра + СтрДлина("РЕГИСТРБУХГАЛТЕРИИ.");
			Продолжить;
		КонецЕсли;

		ПозицияЗакрытия = НайтиЗакрывающуюСкобку(ВерхнийТекст, ПозицияОткрытия);
		Если ПозицияЗакрытия = 0 Тогда
			Позиция = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;

		ПараметрыВТ = Сред(ТекстЗапроса, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1);
		Разыменование = ПервоеРазыменованиеВПараметрахВТ(ПараметрыВТ);
		Если НЕ ПустаяСтрока(Разыменование) Тогда
			ДобавитьОшибку(Результат, "vt_param_field_error",
				"В параметрах виртуальной таблицы Остатки/ОстаткиИОбороты нельзя использовать разыменование через точку: " + Разыменование
				+ ". Передайте счёт ссылкой/ЗНАЧЕНИЕ(...) или перенесите условия по .Код/.Наименование в секцию ГДЕ внешнего запроса.",
				Разыменование);
			Возврат;
		КонецЕсли;

		Позиция = ПозицияЗакрытия + 1;
	КонецЦикла;

КонецПроцедуры

Функция ПозицияОткрытияБухгалтерскойТаблицыОстатков(ВерхнийТекст, ПозицияРегистра)

	ПозицияОстатки = ПозицияОткрытияВиртуальнойТаблицы(ВерхнийТекст, ПозицияРегистра, "ОСТАТКИ");
	ПозицияОстаткиИОбороты = ПозицияОткрытияВиртуальнойТаблицы(ВерхнийТекст, ПозицияРегистра, "ОСТАТКИИОБОРОТЫ");
	Если ПозицияОстатки = 0 Тогда
		Возврат ПозицияОстаткиИОбороты;
	КонецЕсли;
	Если ПозицияОстаткиИОбороты = 0 Тогда
		Возврат ПозицияОстатки;
	КонецЕсли;
	Возврат Мин(ПозицияОстатки, ПозицияОстаткиИОбороты);

КонецФункции

Функция ПозицияОткрытияВиртуальнойТаблицы(ВерхнийТекст, ПозицияРегистра, ИмяВТ)

	ПозицияИмени = СтрНайти(ВерхнийТекст, "." + ИмяВТ, , ПозицияРегистра);
	Если ПозицияИмени = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ПозицияПослеИмени = ПозицияИмени + СтрДлина("." + ИмяВТ);
	Если ПозицияПослеИмени <= СтрДлина(ВерхнийТекст)
		И ЯвляетсяСимволомИдентификатора(Сред(ВерхнийТекст, ПозицияПослеИмени, 1)) Тогда
		Возврат 0;
	КонецЕсли;
	ПозицияСкобки = ПропуститьПробелы(ВерхнийТекст, ПозицияПослеИмени);
	Если ПозицияСкобки <= СтрДлина(ВерхнийТекст)
		И Сред(ВерхнийТекст, ПозицияСкобки, 1) = "(" Тогда
		Возврат ПозицияСкобки;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция НайтиЗакрывающуюСкобку(Текст, ПозицияОткрытия)

	Глубина = 0;
	Для Позиция = ПозицияОткрытия По СтрДлина(Текст) Цикл
		С = Сред(Текст, Позиция, 1);
		Если С = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли С = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Позиция;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция ПервоеРазыменованиеВПараметрахВТ(ПараметрыВТ)

	Текст = УдалитьКонструкторыЗначение(ПараметрыВТ);
	Текст = УдалитьИменаТиповВУсловии(Текст);
	Если СтрДлина(Текст) < 3 Тогда
		Возврат "";
	КонецЕсли;
	Для Позиция = 2 По СтрДлина(Текст) - 1 Цикл
		Если Сред(Текст, Позиция, 1) <> "." Тогда
			Продолжить;
		КонецЕсли;
		Если ЯвляетсяСимволомИдентификатора(Сред(Текст, Позиция - 1, 1))
			И ЯвляетсяСимволомИдентификатора(Сред(Текст, Позиция + 1, 1)) Тогда
			Возврат ЛексемаСРазыменованием(Текст, Позиция);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция УдалитьКонструкторыЗначение(Текст)

	Результат = УдалитьКонструкторПоИмени(Текст, "ЗНАЧЕНИЕ");
	Возврат УдалитьКонструкторПоИмени(Результат, "VALUE");

КонецФункции

Функция УдалитьКонструкторПоИмени(Текст, Знач ИмяКонструктора)

	Результат = Текст;
	ВерхнийТекст = ВРег(Текст);
	Позиция = 1;
	Пока Позиция <= СтрДлина(ВерхнийТекст) Цикл
		ПозицияЗначение = СтрНайти(ВерхнийТекст, ИмяКонструктора, , Позиция);
		Если ПозицияЗначение = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияСкобки = ПропуститьПробелы(ВерхнийТекст, ПозицияЗначение + СтрДлина(ИмяКонструктора));
		Если ПозицияСкобки > СтрДлина(ВерхнийТекст)
			ИЛИ Сред(ВерхнийТекст, ПозицияСкобки, 1) <> "(" Тогда
			Позиция = ПозицияЗначение + СтрДлина(ИмяКонструктора);
			Продолжить;
		КонецЕсли;
		ПозицияЗакрытия = НайтиЗакрывающуюСкобку(ВерхнийТекст, ПозицияСкобки);
		Если ПозицияЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, ПозицияЗначение - 1)
			+ СтрокаПробелов(ПозицияЗакрытия - ПозицияЗначение + 1)
			+ Сред(Результат, ПозицияЗакрытия + 1);
		ВерхнийТекст = ВРег(Результат);
		Позиция = ПозицияЗакрытия + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Гасит квалифицированные имена ТИПОВ в условии, чтобы точка в имени типа не
// была принята за разыменование поля (issue #62). Точка в «Справочник.Контрагенты»
// после ССЫЛКА/REFS, внутри ТИП(...)/TYPE(...) и после КАК/AS в ВЫРАЗИТЬ —
// часть имени типа, а не обращение к реквизиту.
//
// Затирается пробелами, а не вырезается: вызывающий код (ЛексемаСРазыменованием)
// работает по позициям исходной строки, длина обязана сохраниться.
//
// После КАК/AS гасится только имя С ТОЧКОЙ: псевдоним никогда не квалифицирован,
// поэтому обычные «КАК Алиас» остаются нетронутыми.
Функция УдалитьИменаТиповВУсловии(Текст)

	Результат = Текст;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Результат) Цикл
		Ключ = КлючевоеСловоИмениТипа(Результат, Позиция);
		Если ПустаяСтрока(Ключ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		НачалоОперанда = ПропуститьПробелы(Результат, Позиция + СтрДлина(Ключ));
		КонецОперанда = 0;
		Если Ключ = "ТИП" ИЛИ Ключ = "TYPE" Тогда
			Если НачалоОперанда <= СтрДлина(Результат)
				И Сред(Результат, НачалоОперанда, 1) = "(" Тогда
				КонецОперанда = НайтиЗакрывающуюСкобку(Результат, НачалоОперанда);
			КонецЕсли;
		Иначе
			КонецОперанда = КонецКвалифицированногоИмени(Результат, НачалоОперанда);
		КонецЕсли;

		Если КонецОперанда = 0 Тогда
			Позиция = Позиция + СтрДлина(Ключ);
			Продолжить;
		КонецЕсли;

		Результат = Лев(Результат, НачалоОперанда - 1)
			+ СтрокаПробелов(КонецОперанда - НачалоОперанда + 1)
			+ Сред(Результат, КонецОперанда + 1);
		Позиция = КонецОперанда + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает ключевое слово, начинающееся в этой позиции, либо пустую строку.
// ТИП внутри ТИПЗНАЧЕНИЯ не совпадает: СовпадаетКлючСлово требует
// не-идентификаторный символ после ключа.
Функция КлючевоеСловоИмениТипа(Знач Текст, Знач Позиция)

	Если Позиция > 1
		И ЯвляетсяСимволомИдентификатора(Сред(Текст, Позиция - 1, 1)) Тогда
		Возврат "";
	КонецЕсли;

	Ключи = Новый Массив;
	Ключи.Добавить("ССЫЛКА");
	Ключи.Добавить("REFS");
	Ключи.Добавить("ТИПЗНАЧЕНИЯ");
	Ключи.Добавить("VALUETYPE");
	Ключи.Добавить("ТИП");
	Ключи.Добавить("TYPE");
	Ключи.Добавить("КАК");
	Ключи.Добавить("AS");

	Для Каждого Ключ Из Ключи Цикл
		Если СовпадаетКлючСлово(Текст, Позиция, Ключ) Тогда
			// ТИПЗНАЧЕНИЯ/VALUETYPE принимают ПОЛЕ, не имя типа: их операнд гасить
			// нельзя, иначе разыменование ТИПЗНАЧЕНИЯ(Поле.Реквизит) пройдёт мимо
			// проверки. Слова нужны только чтобы ТИП не совпал с их хвостом.
			Если Ключ = "ТИПЗНАЧЕНИЯ" ИЛИ Ключ = "VALUETYPE" Тогда
				Возврат "";
			КонецЕсли;
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Конец квалифицированного имени вида Идентификатор.Идентификатор[.Идентификатор…].
// Возвращает 0, если в этой позиции имя без точки (псевдоним, поле, параметр).
Функция КонецКвалифицированногоИмени(Знач Текст, Знач Начало)

	Длина = СтрДлина(Текст);
	Если Начало > Длина
		ИЛИ НЕ ЯвляетсяСимволомИдентификатора(Сред(Текст, Начало, 1)) Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = Начало;
	ЕстьТочка = Ложь;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЯвляетсяСимволомИдентификатора(Символ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = "."
			И Позиция < Длина
			И ЯвляетсяСимволомИдентификатора(Сред(Текст, Позиция + 1, 1)) Тогда
			ЕстьТочка = Истина;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если НЕ ЕстьТочка Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Позиция - 1;

КонецФункции

Функция СтрокаПробелов(Количество)

	Результат = "";
	Для Индекс = 1 По Количество Цикл
		Результат = Результат + " ";
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЛексемаСРазыменованием(Текст, ПозицияТочки)

	Начало = ПозицияТочки - 1;
	Пока Начало > 1 И ЯвляетсяСимволомИдентификатора(Сред(Текст, Начало - 1, 1)) Цикл
		Начало = Начало - 1;
	КонецЦикла;
	КонецЛексемы = ПозицияТочки + 1;
	Пока КонецЛексемы < СтрДлина(Текст) И ЯвляетсяСимволомИдентификатора(Сред(Текст, КонецЛексемы + 1, 1)) Цикл
		КонецЛексемы = КонецЛексемы + 1;
	КонецЦикла;
	Возврат Сред(Текст, Начало, КонецЛексемы - Начало + 1);

КонецФункции

Процедура ДобавитьПредупрежденияJOINТабличнойЧастиСРегистр(Результат, ИсточникиЗапроса, ТекстЗапроса)

	ТабличныеЧастиДокументов = Новый Массив;
	Регистры = Новый Массив;
	Для Каждого Источник Из ИсточникиЗапроса Цикл
		Если ИсточникЯвляетсяТабличнойЧастьюДокумента(Источник.raw) Тогда
			ТабличныеЧастиДокументов.Добавить(Источник);
		ИначеЕсли ИсточникЯвляетсяРегистромДвижений(Источник.full_name) Тогда
			Регистры.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;

	Если ТабличныеЧастиДокументов.Количество() = 0 ИЛИ Регистры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КомпактныйТекст = КомпактныйВерхнийТекст(ТекстЗапроса);
	Для Каждого ТабличнаяЧасть Из ТабличныеЧастиДокументов Цикл
		АлиасыТЧ = АлиасыИсточникаСЗапасными(ТекстЗапроса, ТабличнаяЧасть);
		Для Каждого Регистр Из Регистры Цикл
			АлиасыРегистра = АлиасыИсточникаСЗапасными(ТекстЗапроса, Регистр);
			Для Каждого АлиасТЧ Из АлиасыТЧ Цикл
				Для Каждого АлиасРегистра Из АлиасыРегистра Цикл
					Если JOINРегистратораССылкой(КомпактныйТекст, АлиасРегистра, АлиасТЧ)
						И НЕ ЕстьУточняющаяСвязьСтроки(КомпактныйТекст, АлиасРегистра, АлиасТЧ) Тогда
						Результат.warnings.Добавить(
							"Риск умножения строк: табличная часть " + ТабличнаяЧасть.raw
							+ " соединяется с регистром " + Регистр.raw
							+ " по Регистратор = Ссылка. Если затем суммируются поля табличной части (Количество, Сумма), "
							+ "они могут умножиться на число движений регистра по документу. Используйте РАЗЛИЧНЫЕ регистраторы, "
							+ "СУЩЕСТВУЕТ/В для проверки наличия движения, либо связывайте движение с конкретной строкой/аналитикой.");
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПредупрежденияJOINСубконтоРегистра(Результат, ИсточникиЗапроса, ТекстЗапроса)

	КомпактныйТекст = КомпактныйВерхнийТекст(ТекстЗапроса);
	Для Каждого Источник Из ИсточникиЗапроса Цикл
		Если НЕ ИсточникЯвляетсяТаблицейСубконтоРегистра(Источник.raw) Тогда
			Продолжить;
		КонецЕсли;
		Алиасы = АлиасыИсточникаСЗапасными(ТекстЗапроса, Источник);
		Для Каждого Алиас Из Алиасы Цикл
			Если НЕ ЕстьУсловиеПоПолюСубконто(КомпактныйТекст, Алиас, "ВИД") Тогда
				Результат.warnings.Добавить(
					"Риск умножения строк: " + Источник.raw
					+ " используется без отбора по Вид. В .Субконто у одной проводки обычно несколько строк аналитик; JOIN по Регистратор/НомерСтроки без Вид размножает строку по Контрагентам, Договорам, Документам расчетов и другим видам. Добавьте "
					+ Алиас + ".Вид = &ВидСубконто или группируйте также по " + Алиас + ".Вид.");
			КонецЕсли;
			Если НЕ ЕстьУсловиеПоПолюСубконто(КомпактныйТекст, Алиас, "ВИДДВИЖЕНИЯ") Тогда
				Результат.warnings.Добавить(
					"Риск смешения дебета и кредита: " + Источник.raw
					+ " используется без отбора по ВидДвижения. При соединении с проводками добавьте "
					+ Алиас + ".ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет/Кредит).");
			КонецЕсли;
			Возврат;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ИсточникЯвляетсяТабличнойЧастьюДокумента(ИмяИсточника)

	Части = СтрРазделить(Строка(ИмяИсточника), ".", Ложь);
	Возврат Части.Количество() >= 3 И ВРег(Части[0]) = ВРег("Документ");

КонецФункции

Функция ИсточникЯвляетсяТаблицейСубконтоРегистра(ИмяИсточника)

	Верх = ВРег(Строка(ИмяИсточника));
	Возврат СтрНачинаетсяС(Верх, ВРег("РегистрБухгалтерии."))
		И СтрНайти(Верх, ".СУБКОНТО") > 0;

КонецФункции

Функция ИсточникЯвляетсяРегистромДвижений(ПолноеИмя)

	Верх = ВРег(Строка(ПолноеИмя));
	Возврат СтрНачинаетсяС(Верх, ВРег("РегистрБухгалтерии."))
		ИЛИ СтрНачинаетсяС(Верх, ВРег("РегистрНакопления."))
		ИЛИ СтрНачинаетсяС(Верх, ВРег("РегистрСведений."))
		ИЛИ СтрНачинаетсяС(Верх, ВРег("РегистрРасчета."));

КонецФункции

Функция АлиасыИсточникаСЗапасными(ТекстЗапроса, Источник)

	Результат = АлиасыИсточника(ТекстЗапроса, Источник.raw);
	Результат.Добавить(Источник.raw);
	Если НЕ ПустаяСтрока(Источник.full_name) Тогда
		Результат.Добавить(Источник.full_name);
		Результат.Добавить(ПоследнийСегментИмени(Источник.full_name));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция JOINРегистратораССылкой(КомпактныйТекст, АлиасРегистра, АлиасТЧ)

	Рег = ВРег(Строка(АлиасРегистра));
	ТЧ = ВРег(Строка(АлиасТЧ));
	Если ПустаяСтрока(Рег) ИЛИ ПустаяСтрока(ТЧ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(КомпактныйТекст, Рег + ".РЕГИСТРАТОР=" + ТЧ + ".ССЫЛКА") > 0
		ИЛИ СтрНайти(КомпактныйТекст, ТЧ + ".ССЫЛКА=" + Рег + ".РЕГИСТРАТОР") > 0;

КонецФункции

Функция ЕстьУточняющаяСвязьСтроки(КомпактныйТекст, АлиасРегистра, АлиасТЧ)

	Рег = ВРег(Строка(АлиасРегистра));
	ТЧ = ВРег(Строка(АлиасТЧ));
	Если ПустаяСтрока(Рег) ИЛИ ПустаяСтрока(ТЧ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(КомпактныйТекст, Рег + ".НОМЕРСТРОКИ=" + ТЧ + ".НОМЕРСТРОКИ") > 0
		ИЛИ СтрНайти(КомпактныйТекст, ТЧ + ".НОМЕРСТРОКИ=" + Рег + ".НОМЕРСТРОКИ") > 0;

КонецФункции

Функция КомпактныйВерхнийТекст(Текст)

	Результат = ВРег(ТекстБезСтрокИКомментариев(Текст));
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Возврат Результат;

КонецФункции

Функция ЕстьУсловиеПоПолюСубконто(КомпактныйТекст, Алиас, Поле)

	Имя = ВРег(Строка(Алиас));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Префикс = Имя + "." + ВРег(Поле);
	Возврат СтрНайти(КомпактныйТекст, Префикс + "=") > 0
		ИЛИ СтрНайти(КомпактныйТекст, Префикс + "В(") > 0
		ИЛИ СтрНайти(КомпактныйТекст, Префикс + "В&") > 0
		ИЛИ СтрНайти(КомпактныйТекст, Префикс + "IN(") > 0
		ИЛИ СтрНайти(КомпактныйТекст, Префикс + "IN&") > 0;

КонецФункции

Функция АлиасыИсточника(ТекстЗапроса, ИмяИсточника)

	Результат = Новый Массив;
	Лексемы = ЛексемыИсточников(ТекстЗапроса);
	Для Индекс = 0 По Лексемы.Количество() - 1 Цикл
		Если ВРег(Лексемы[Индекс]) <> ВРег(ИмяИсточника) Тогда
			Продолжить;
		КонецЕсли;
		СледующийИндекс = Индекс + 1;
		Если СледующийИндекс < Лексемы.Количество()
			И (ВРег(Лексемы[СледующийИндекс]) = "КАК" ИЛИ ВРег(Лексемы[СледующийИндекс]) = "AS") Тогда
			СледующийИндекс = СледующийИндекс + 1;
		КонецЕсли;
		Если СледующийИндекс < Лексемы.Количество() Тогда
			Кандидат = Лексемы[СледующийИндекс];
			Если ВыглядитКакАлиасИсточника(Кандидат) Тогда
				Результат.Добавить(Кандидат);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВыглядитКакАлиасИсточника(Токен)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	Верх = ВРег(Токен);
	Возврат НЕ (Верх = "ГДЕ" ИЛИ Верх = "WHERE" ИЛИ Верх = "СГРУППИРОВАТЬ"
		ИЛИ Верх = "GROUP" ИЛИ Верх = "УПОРЯДОЧИТЬ" ИЛИ Верх = "ORDER"
		ИЛИ Верх = "ИМЕЮЩИЕ" ИЛИ Верх = "HAVING" ИЛИ Верх = "СОЕДИНЕНИЕ"
		ИЛИ Верх = "JOIN" ИЛИ Верх = "ЛЕВОЕ" ИЛИ Верх = "LEFT"
		ИЛИ Верх = "ПРАВОЕ" ИЛИ Верх = "RIGHT" ИЛИ Верх = "," ИЛИ Верх = ";"
		ИЛИ Верх = "(" ИЛИ Верх = ")");

КонецФункции

Функция ПолеСубконтоДтКтОсновнойТаблицыВстречается(ВерхнийТекст, Алиас, Поле)

	Возврат СтрНайти(ВерхнийТекст, ВРег(Алиас) + "." + Поле) > 0;

КонецФункции

Функция ЯвляетсяСимволомИдентификатора(С)
	Если С = "_" ИЛИ С = "Ё" ИЛИ С = "ё" Тогда
		Возврат Истина;
	КонецЕсли;
	Код = КодСимвола(С);
	Возврат (Код >= КодСимвола("0") И Код <= КодСимвола("9"))
		ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
		ИЛИ (Код >= КодСимвола("a") И Код <= КодСимвола("z"))
		ИЛИ (Код >= КодСимвола("А") И Код <= КодСимвола("я"));
КонецФункции

Функция ЭтоЦифра(С)
	Код = КодСимвола(С);
	Возврат Код >= КодСимвола("0") И Код <= КодСимвола("9");
КонецФункции

Функция ЕстьЯвныйЛимит(ТекстЗапроса) Экспорт

	НормализованныйТекст = НормализоватьТекстДляПоиска(ВРег(ТекстБезСтрокИКомментариев(ТекстЗапроса)));
	ЗаголовокВыбора = ЗаголовокПоследнегоВыбора(НормализованныйТекст);
	Возврат СтрНайти(ЗаголовокВыбора, " ПЕРВЫЕ ") > 0
		ИЛИ СтрНайти(ЗаголовокВыбора, " TOP ") > 0;

КонецФункции

Функция ЗаголовокПоследнегоВыбора(НормализованныйТекст)

	Позиция = НайтиПозициюПоследнегоВнешнегоSelect(НормализованныйТекст);
	Если Позиция = 0 Тогда
		Возврат НормализованныйТекст;
	КонецЕсли;

	Если СовпадаетКлючСлово(НормализованныйТекст, Позиция, "SELECT") Тогда
		Начало = Позиция + СтрДлина("SELECT");
	Иначе
		Начало = Позиция + СтрДлина("ВЫБРАТЬ");
	КонецЕсли;

	Остаток = Сред(НормализованныйТекст, Начало);
	ПозИз = СтрНайти(Остаток, " ИЗ ");
	ПозFrom = СтрНайти(Остаток, " FROM ");
	ПозКонца = ПерваяПоложительнаяПозиция(ПозИз, ПозFrom);
	Если ПозКонца > 0 Тогда
		Возврат " " + Лев(Остаток, ПозКонца - 1) + " ";
	КонецЕсли;

	Возврат " " + Остаток + " ";

КонецФункции

Функция ПерваяПоложительнаяПозиция(Позиция1, Позиция2)

	Если Позиция1 <= 0 Тогда
		Возврат Позиция2;
	КонецЕсли;
	Если Позиция2 <= 0 Тогда
		Возврат Позиция1;
	КонецЕсли;
	Возврат Мин(Позиция1, Позиция2);

КонецФункции

Функция СодержитWildcardSelect(НормализованныйВерхнийТекст)

	Возврат СтрНайти(НормализованныйВерхнийТекст, " ВЫБРАТЬ * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " ВЫБРАТЬ РАЗРЕШЕННЫЕ * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " ВЫБРАТЬ РАЗЛИЧНЫЕ * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " SELECT * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " SELECT ALLOWED * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " SELECT DISTINCT * ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, ".*") > 0;

КонецФункции

Функция СодержитПакетныеЗапросы(ТекстДляПоиска)

	Позиция = СтрНайти(ТекстДляПоиска, ";");
	Пока Позиция > 0 Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Сред(ТекстДляПоиска, Позиция + 1))) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(ТекстДляПоиска, ";", , Позиция + 1);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ИспользуетВременныеТаблицы(НормализованныйВерхнийТекст)

	// issue #61: английские эквиваленты — INTO и DROP, не PLACE/DESTROY. С PLACE
	// англоязычный пакет не распознавался как работа с временными таблицами и
	// отклонялся как batch_query_forbidden. Таблица алиасов совпадает с
	// токен-парсером MCP_Examples (ЭтоПОМЕСТИТЬ/ЭтоУНИЧТОЖИТЬ).
	Возврат СтрНайти(НормализованныйВерхнийТекст, " ПОМЕСТИТЬ ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " INTO ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " ИНДЕКСИРОВАТЬ ПО ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " INDEX BY ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " УНИЧТОЖИТЬ ") > 0
		ИЛИ СтрНайти(НормализованныйВерхнийТекст, " DROP ") > 0;

КонецФункции

Функция ПоследняяКомандаПакетаНачинаетсяСSelect(ТекстДляПоиска)

	ПоследняяКоманда = "";
	Для Каждого Часть Из СтрРазделить(ТекстДляПоиска, ";", Ложь) Цикл
		Команда = СокрЛП(Часть);
		Если НЕ ПустаяСтрока(Команда) Тогда
			ПоследняяКоманда = Команда;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ПоследняяКоманда) Тогда
		Возврат Ложь;
	КонецЕсли;

	Позиция = ПропуститьПробелы(ПоследняяКоманда, 1);
	Возврат СовпадаетКлючСлово(ПоследняяКоманда, Позиция, "ВЫБРАТЬ")
		ИЛИ СовпадаетКлючСлово(ПоследняяКоманда, Позиция, "SELECT");

КонецФункции

Функция ИменаВременныхТаблиц(ТекстДляПоиска)

	Результат = Новый Соответствие;
	ОжидаемИмя = Ложь;
	Лексемы = ЛексемыИсточников(ТекстДляПоиска);
	Для Каждого Л Из Лексемы Цикл
		Токен = СокрЛП(Л);
		Если ПустаяСтрока(Токен) Тогда
			Продолжить;
		КонецЕсли;

		ТокенВРег = ВРег(Токен);
		Если ОжидаемИмя Тогда
			Если ЭтоИмяВременнойТаблицы(Токен) Тогда
				Результат.Вставить(ТокенВРег, Истина);
			КонецЕсли;
			ОжидаемИмя = Ложь;
			Продолжить;
		КонецЕсли;

		// issue #61: англ. эквивалент ПОМЕСТИТЬ — INTO (не PLACE).
		Если ТокенВРег = "ПОМЕСТИТЬ" ИЛИ ТокенВРег = "INTO" Тогда
			ОжидаемИмя = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВременнаяТаблицаРазрешена(ВременныеТаблицы, ИмяИсточник)

	Возврат ВременныеТаблицы.Получить(ВРег(Строка(ИмяИсточник))) <> Неопределено;

КонецФункции

// issue #61: УНИЧТОЖИТЬ/DROP допустимы только для временной таблицы, объявленной
// в этом же пакете. Безусловный запрет токена DROP отклонял легитимную английскую
// форму очистки, тогда как кириллический УНИЧТОЖИТЬ в той же позиции проходил.
// Контекстная проверка сохраняет защиту от DDL: DROP TABLE <что-либо> и
// УНИЧТОЖИТЬ <объект метаданных> по-прежнему отклоняются, потому что их операнд
// не объявлен через ПОМЕСТИТЬ/INTO.
Процедура ДобавитьОшибкуУничтоженияНеВременнойТаблицы(Результат, ТекстДляПоиска, ВременныеТаблицы)

	Лексемы = ЛексемыИсточников(ТекстДляПоиска);
	ОжидаемИмя = Ложь;

	Для Каждого Л Из Лексемы Цикл
		Токен = СокрЛП(Л);
		Если ПустаяСтрока(Токен) Тогда
			Продолжить;
		КонецЕсли;

		ТокенВРег = ВРег(Токен);

		Если ОжидаемИмя Тогда
			ОжидаемИмя = Ложь;
			Если ВременныеТаблицы.Получить(ТокенВРег) = Неопределено Тогда
				ДобавитьОшибку(Результат, "drop_target_not_temporary_table",
					"УНИЧТОЖИТЬ/DROP допустимы только для временной таблицы, созданной в этом же пакете. "
					+ Токен + " не объявлена через ПОМЕСТИТЬ/INTO.",
					Токен);
				Возврат;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТокенВРег = "УНИЧТОЖИТЬ" ИЛИ ТокенВРег = "DROP" Тогда
			ОжидаемИмя = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоИмяВременнойТаблицы(Токен)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Токен = "(" ИЛИ Токен = ")" ИЛИ Токен = "," ИЛИ Токен = ";" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНачинаетсяС(Токен, "&") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПолноеИмяМетаданныхИзЛексемы(Токен) = "";

КонецФункции

Функция ПолеВстречаетсяВТексте(ВерхнийТекст, НормализованныйВерхнийТекст, ИмяПоля)

	ВерхнееИмяПоля = ВРег(Строка(ИмяПоля));
	Если ПустаяСтрока(ВерхнееИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Поиск ИмяПоля как отдельного токена — без word boundary "Сумма" ловит "СуммаНДС".
	// Слева границей служит точка (доступ по реквизиту) или пробел в нормализованном тексте,
	// справа — любой не-идентификаторный символ.
	Если СодержитТокен(НормализованныйВерхнийТекст, " " + ВерхнееИмяПоля) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СодержитТокен(ВерхнийТекст, "." + ВерхнееИмяПоля);

КонецФункции

// Истина, если в Тексте есть вхождение Префикс+<граница>, где Префикс заканчивается
// последним символом имени поля, а сразу за ним идёт не-идентификаторный символ
// (или конец строки). Это эквивалент word boundary справа.
Функция СодержитТокен(Текст, Префикс)

	ПозицияНачала = 1;
	Длина = СтрДлина(Текст);
	ДлинаПрефикса = СтрДлина(Префикс);
	Если ДлинаПрефикса = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Пока Истина Цикл
		Поз = СтрНайти(Текст, Префикс, , ПозицияНачала);
		Если Поз = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		СледующаяПозиция = Поз + ДлинаПрефикса;
		Если СледующаяПозиция > Длина Тогда
			Возврат Истина;
		КонецЕсли;
		Если НЕ ЯвляетсяСимволомИдентификатора(Сред(Текст, СледующаяПозиция, 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		ПозицияНачала = Поз + 1;
	КонецЦикла;

КонецФункции

Функция НормализоватьТекстДляПоиска(Текст)

	Результат = СтрЗаменить(Текст, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, "(", " ");
	Результат = СтрЗаменить(Результат, ")", " ");
	Результат = СтрЗаменить(Результат, ",", " ");
	Результат = СтрЗаменить(Результат, ";", " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат " " + СокрЛП(Результат) + " ";

КонецФункции

Функция ТекстБезСтрокИКомментариев(Текст)

	Результат = "";
	Длина = СтрДлина(Текст);
	Позиция = 1;
	ВСтроке = Ложь;
	СимволСтроки = "";
	ВОднострочномКомментарии = Ложь;
	ВМногострочномКомментарии = Ложь;

	Пока Позиция <= Длина Цикл
		С = Сред(Текст, Позиция, 1);
		Следующий = ?(Позиция < Длина, Сред(Текст, Позиция + 1, 1), "");

		Если ВОднострочномКомментарии Тогда
			Если С = Символы.ПС ИЛИ С = Символы.ВК Тогда
				ВОднострочномКомментарии = Ложь;
				Результат = Результат + С;
			Иначе
				Результат = Результат + " ";
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если ВМногострочномКомментарии Тогда
			Если С = "*" И Следующий = "/" Тогда
				ВМногострочномКомментарии = Ложь;
				Результат = Результат + "  ";
				Позиция = Позиция + 2;
			Иначе
				Результат = Результат + ?(С = Символы.ПС ИЛИ С = Символы.ВК, С, " ");
				Позиция = Позиция + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ВСтроке Тогда
			Результат = Результат + " ";
			Если С = СимволСтроки Тогда
				Если Следующий = СимволСтроки Тогда
					Результат = Результат + " ";
					Позиция = Позиция + 2;
				Иначе
					ВСтроке = Ложь;
					Позиция = Позиция + 1;
				КонецЕсли;
			Иначе
				Позиция = Позиция + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если С = "/" И Следующий = "/" Тогда
			ВОднострочномКомментарии = Истина;
			Результат = Результат + "  ";
			Позиция = Позиция + 2;
		ИначеЕсли С = "/" И Следующий = "*" Тогда
			ВМногострочномКомментарии = Истина;
			Результат = Результат + "  ";
			Позиция = Позиция + 2;
		ИначеЕсли С = "'" ИЛИ С = """" Тогда
			ВСтроке = Истина;
			СимволСтроки = С;
			Результат = Результат + " ";
			Позиция = Позиция + 1;
		Иначе
			Результат = Результат + С;
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДиагностикаОшибкиВыполнения(
	ТекстОшибки, Валидация, ТекстЗапроса = "", CorrelationID = "", КешДиагностики = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("kind", "query_execute");
	Результат.Вставить("platform_message", ТекстОшибки);
	Если КешДиагностики = Неопределено Тогда
		КешДиагностики = Новый Соответствие;
	КонецЕсли;

	Suggestions = Новый Массив;
	ВерхОшибка = ВРег(Строка(ТекстОшибки));
	Если СтрНайти(ВерхОшибка, "ИМЕЯ") > 0 Тогда
		Результат.Вставить("error_code", "syntax_imeyuschie");
		Результат.Вставить("error", "syntax_imeyuschie");
		Результат.Вставить("hint", "В языке запросов 1С правильное ключевое слово для условий по агрегатам — ИМЕЮЩИЕ, не ИМЕЯ и не HAVING.");
		Результат.Вставить("see_also", "query_guidance:grouping-and-having");
		Suggestions.Добавить("Замените ИМЕЯ на ИМЕЮЩИЕ и убедитесь, что все неагрегированные поля из ВЫБРАТЬ перечислены в СГРУППИРОВАТЬ ПО.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	// Функция модуля числа в языке запросов отсутствует: АБС/ABS — функция встроенного
	// языка, а не языка запросов. Классификация идёт по ТЕКСТУ ЗАПРОСА, а не по тексту
	// платформенного сообщения: сообщение о синтаксической ошибке не обязано повторять
	// имя функции, и опираться на это нельзя.
	Если (СтрНайти(ВерхОшибка, "СИНТАКСИЧЕСК") > 0 ИЛИ СтрНайти(ВерхОшибка, "SYNTAX") > 0)
		И ВызовНеподдерживаемойФункцииЗапроса(ТекстЗапроса) <> "" Тогда
		ИмяФункции = ВызовНеподдерживаемойФункцииЗапроса(ТекстЗапроса);
		Результат.Вставить("error_code", "unsupported_query_function");
		Результат.Вставить("error", "unsupported_query_function");
		Результат.Вставить("hint", ПодсказкаНеподдерживаемойФункцииЗапроса(ИмяФункции));
		Результат.Вставить("see_also", "query_guidance:functions");
		Suggestions.Добавить(ЗаменаНеподдерживаемойФункцииЗапроса(ИмяФункции));
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	Если (СтрНайти(ВерхОшибка, "СИНТАКСИЧЕСК") > 0
		ИЛИ СтрНайти(ВерхОшибка, "SYNTAX") > 0)
		И (СтрНайти(ВерхОшибка, "МИН") > 0 ИЛИ СтрНайти(ВерхОшибка, "МАКС") > 0) Тогда
		Результат.Вставить("error_code", "aggregate_function_name");
		Результат.Вставить("error", "aggregate_function_name");
		Результат.Вставить("hint", "В языке запросов 1С агрегаты называются МИНИМУМ и МАКСИМУМ. Полный список: СУММА, КОЛИЧЕСТВО, СРЕДНЕЕ, МАКСИМУМ, МИНИМУМ.");
		Результат.Вставить("see_also", "query_guidance:functions");
		Suggestions.Добавить("Замените SQL-сокращения MIN/MAX на МИНИМУМ/МАКСИМУМ.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	Если СтрНайти(ВерхОшибка, "ПОМЕСТИТЬ") > 0 И СтрНайти(ВерхОшибка, "ЗАПРЕЩ") > 0 Тогда
		Результат.Вставить("error_code", "forbidden_polozhit");
		Результат.Вставить("error", "forbidden_polozhit");
		Результат.Вставить("hint", "ПОМЕСТИТЬ разрешён только внутри пакетного запроса. Финальная команда пакета должна быть ВЫБРАТЬ. Разделитель команд в пакете — ;.");
		Результат.Вставить("see_also", "query_guidance:temporary-tables");
		Suggestions.Добавить("Проверьте, что пакет содержит ПОМЕСТИТЬ/ИНДЕКСИРОВАТЬ ПО только для временных таблиц и завершается SELECT/ВЫБРАТЬ.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	Если СтрНайти(ВерхОшибка, "ПАКЕТН") > 0 И СтрНайти(ВерхОшибка, "ЗАПРЕЩ") > 0 Тогда
		Результат.Вставить("error_code", "batch_query_forbidden");
		Результат.Вставить("error", "batch_query_forbidden");
		Результат.Вставить("hint", "Пакетные запросы через ; разрешены только при использовании временных таблиц через ПОМЕСТИТЬ. Финальная команда пакета — ВЫБРАТЬ.");
		Результат.Вставить("see_also", "query_guidance:temporary-tables");
		Suggestions.Добавить("Если пакет нужен, создайте временную таблицу через ПОМЕСТИТЬ и завершите пакет ВЫБРАТЬ из временной таблицы.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	Если СтрНайти(ВерхОшибка, "ТАБЛИЦ") > 0 И СтрНайти(ВерхОшибка, "НЕ НАЙД") > 0 Тогда
		Результат.Вставить("error_code", "table_not_found");
		Результат.Вставить("error", "table_not_found");
		Результат.Вставить("hint", "Проверьте точное имя объекта через list_metadata_objects перед написанием запроса. Имена чувствительны к регистру; не выдумывайте имена таблиц и виртуальных таблиц.");
		Результат.Вставить("see_also", "list_metadata_objects");
		Suggestions.Добавить("Сначала получите список доступных объектов метаданных, затем используйте full_name/query_table из ответа.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;
	Если СтрНайти(ВерхОшибка, "НЕ ВХОДИТ В ГРУПП") > 0 Тогда
		Результат.Вставить("error_code", "grouping_error");
		Результат.Вставить("error", "grouping_error");
		Результат.Вставить("hint", "Все неагрегированные поля из ВЫБРАТЬ должны быть перечислены в СГРУППИРОВАТЬ ПО. Для условий по агрегатам используйте ИМЕЮЩИЕ, а не ГДЕ.");
		Результат.Вставить("see_also", "query_guidance:grouping-and-having");
		Suggestions.Добавить("Добавьте поле в СГРУППИРОВАТЬ ПО или оберните его агрегатной функцией.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;

	// «Неоднозначное поле» — поле СУЩЕСТВУЕТ, но имя разрешается более чем в один
	// источник, поэтому общий field_not_found здесь дезинформирует. Частая причина —
	// псевдоним совпал с именем табличной части другой таблицы запроса (её ловит
	// предупреждение F-04 в validation_warnings).
	Если СтрНайти(ВерхОшибка, "НЕОДНОЗНАЧН") > 0 Тогда
		ПолноеПолеНеодн = ИзвлечьПолеИзОшибкиПлатформы(ТекстОшибки);
		Результат.Вставить("error_code", "ambiguous_field");
		Результат.Вставить("error", "ambiguous_field");
		Если НЕ ПустаяСтрока(ПолноеПолеНеодн) Тогда
			Результат.Вставить("field_path", ПолноеПолеНеодн);
			Результат.Вставить("field", ПоследнийСегментИмени(ПолноеПолеНеодн));
		КонецЕсли;
		Результат.Вставить("hint", "1С не может однозначно разрешить обращение "
			+ ?(ПустаяСтрока(ПолноеПолеНеодн), "к полю", "'" + ПолноеПолеНеодн + "'")
			+ ": имя перед точкой соответствует более чем одному источнику запроса."
			+ " Само поле существует — переименуйте псевдоним, а не меняйте имя поля."
			+ " Частая причина: псевдоним источника совпадает с именем табличной части"
			+ " другой таблицы этого же запроса; см. validation_warnings.");
		Результат.Вставить("see_also", "query_guidance:aliases");
		Suggestions.Добавить("Переименуйте псевдоним источника так, чтобы он не совпадал с именем табличной части или другого источника запроса.");
		Suggestions.Добавить("Квалифицируйте все обращения к полям уникальными псевдонимами: каждый источник в ИЗ/СОЕДИНЕНИЕ должен иметь собственное имя.");
		Результат.Вставить("suggestions", Suggestions);
		Возврат Результат;
	КонецЕсли;

	ОшибкаПоля = СтрНайти(ВерхОшибка, "ПОЛЕ") > 0
		ИЛИ СтрНайти(ВерхОшибка, "РЕКВИЗИТ") > 0
		ИЛИ СтрНайти(ВерхОшибка, "НЕ НАЙДЕН") > 0
		ИЛИ СтрНайти(ВерхОшибка, "НЕ ОБНАРУЖ") > 0;
	Если ОшибкаПоля Тогда
		ПолноеПоле = ИзвлечьПолеИзОшибкиПлатформы(ТекстОшибки);
		ИмяПоля = ПоследнийСегментИмени(ПолноеПоле);
		ОбъектОшибки = ОбъектДляДиагностикиПоля(ПолноеПоле, Валидация);
		ЭтоСубконтоДтКт = ПолеПохожеНаСубконтоДтКт(ИмяПоля);
		ЭтоОшибкаПараметраВТ = ПолеПохожеНаРазыменованиеВиртуальнойТаблицы(ПолноеПоле, ТекстЗапроса);
		Если ЭтоСубконтоДтКт Тогда
			Результат.Вставить("error_code", "subconto_wrong_table");
			Результат.Вставить("error", "subconto_wrong_table");
		ИначеЕсли ЭтоОшибкаПараметраВТ Тогда
			Результат.Вставить("error_code", "vt_param_field_error");
			Результат.Вставить("error", "vt_param_field_error");
		Иначе
			Результат.Вставить("error_code", "field_not_found");
			Результат.Вставить("error", "field_not_found");
		КонецЕсли;
		Результат.Вставить("field", ?(ПустаяСтрока(ИмяПоля), Null, ИмяПоля));
		Результат.Вставить("field_path", ?(ПустаяСтрока(ПолноеПоле), Null, ПолноеПоле));
		Результат.Вставить("object", ?(ПустаяСтрока(ОбъектОшибки), Null, ОбъектОшибки));
		Suggestions.Добавить("Проверьте имена полей через get_metadata_structure для каждого detected_objects. Не используйте поля, которых нет в metadata structure.");
		Suggestions.Добавить("Для табличных частей используйте query table вида <Тип>.<ТабличнаяЧасть> и имена колонок из tabular_sections.");
		Suggestions.Добавить("Для бухгалтерских субконто сначала получите карту плана счетов через get_accounting_accounts_map или табличную часть ВидыСубконто.");
		Если ЭтоОшибкаПараметраВТ Тогда
			Suggestions.Добавить("Перенесите условие с разыменованием через точку из параметров виртуальной таблицы в секцию ГДЕ внешнего запроса.");
			Результат.Вставить("hint", "В параметрах виртуальной таблицы (внутри скобок после имени) нельзя использовать разыменование через точку. Перенесите условие Организация.Наименование ПОДОБНО ... в секцию ГДЕ внешнего запроса.");
			Результат.Вставить("see_also", "query_guidance:virtual-tables");
		ИначеЕсли ЭтоСубконтоДтКт ИЛИ ТекстПохожНаБухгалтерскиеСубконто(ПолноеПоле + " " + ОбъектОшибки) Тогда
			Suggestions.Добавить("Если поле СубконтоДт/Кт не найдено в основной таблице бухгалтерского регистра, используйте табличную часть РегистрБухгалтерии.<Имя>.Субконто с полями Период, Регистратор, НомерСтроки, ВидДвижения, Вид, Значение; соединяйте с основной таблицей по Регистратор и НомерСтроки.");
			Результат.Вставить("hint",
				"Субконто регистра бухгалтерии хранятся в отдельной физической таблице РегистрБухгалтерии.<Имя>.Субконто. Поля этой таблицы: Период, Регистратор, НомерСтроки, ВидДвижения, Вид, Значение. Обращение к СубконтоДт1/Кт1 из основной таблицы движений невозможно — их там нет. Соединяйте с основной таблицей по Регистратор и НомерСтроки.");
			Если НЕ ПустаяСтрока(ОбъектОшибки) Тогда
				Результат.Вставить("see_also", ОбъектОшибки + ".Субконто");
			Иначе
				Результат.Вставить("see_also", "РегистрБухгалтерии.<Имя>.Субконто");
			КонецЕсли;
		Иначе
			Результат.Вставить("hint", "Поле не найдено в выбранном источнике запроса. Получите структуру объекта через get_metadata_structure и используйте одно из доступных полей.");
			Результат.Вставить("see_also", "get_metadata_structure");
		КонецЕсли;
	Иначе
		Результат.Вставить("error_code", "query_execute_error");
		Результат.Вставить("error", "query_execute_error");
		Suggestions.Добавить("Запрос прошёл предварительную проверку, но упал при выполнении в 1С. Проверьте точные поля, типы выражений и параметры виртуальных таблиц.");
	КонецЕсли;
	Результат.Вставить("suggestions", Suggestions);

	ДоступныеПоля = Новый Массив;
	Если Валидация <> Неопределено Тогда
		Попытка
			СчетчикОбъектов = 0;
			Для Каждого ПолноеИмя Из Валидация.detected_objects Цикл
				Если СчетчикОбъектов >= 3 Тогда
					Прервать;
				КонецЕсли;
				ПоляОбъекта = ПоляОбъектаДляДиагностики(ПолноеИмя, 40, КешДиагностики);
				Если ПоляОбъекта <> Неопределено Тогда
					ДоступныеПоля.Добавить(ПоляОбъекта);
					СчетчикОбъектов = СчетчикОбъектов + 1;
				КонецЕсли;
			КонецЦикла;
		Исключение
			// Диагностика не должна скрывать исходную ошибку выполнения.
		КонецПопытки;
	КонецЕсли;
	Результат.Вставить("available_fields_sample", ДоступныеПоля);
	Если ДоступныеПоля.Количество() > 0 Тогда
		Результат.Вставить("available_fields", ДоступныеПоля[0].fields);
		КодДиагностики = "";
		Попытка
			Результат.Свойство("error_code", КодДиагностики);
		Исключение
			КодДиагностики = "";
		КонецПопытки;
		Если КодДиагностики = "field_not_found" Тогда
			Результат.Вставить("hint", "Доступные поля объекта " + ДоступныеПоля[0].type + ": "
				+ СтрСоединить(ДоступныеПоля[0].fields, ", ") + ".");
		КонецЕсли;
	КонецЕсли;
	ОбогатитьДиагностикуПоляПоТекстуЗапроса(
		Результат, ИмяПоля, ПолноеПоле, ТекстЗапроса,
		Валидация, КешДиагностики, CorrelationID);

	Возврат Результат;

КонецФункции

Функция ИзвлечьПолеИзОшибкиПлатформы(ТекстОшибки)

	Маркеры = Новый Массив;
	Маркеры.Добавить("Поле не найдено """);
	Маркеры.Добавить("Реквизит не найден """);
	Маркеры.Добавить("Не найдено поле """);
	Для Каждого Маркер Из Маркеры Цикл
		Поз = СтрНайти(ТекстОшибки, Маркер);
		Если Поз > 0 Тогда
			Начало = Поз + СтрДлина(Маркер);
			Конец = СтрНайти(ТекстОшибки, """", , Начало);
			Если Конец > Начало Тогда
				Возврат Сред(ТекстОшибки, Начало, Конец - Начало);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПоследнийСегментИмени(ПолноеИмя)

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Части[Части.Количество() - 1];

КонецФункции

Функция ОбъектДляДиагностикиПоля(ПолноеПоле, Валидация)

	Если Валидация = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Кандидаты = Валидация.detected_objects;
	Если Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0];
	КонецЕсли;
	ВерхПоле = ВРег(ПолноеПоле);
	Для Каждого ПолноеИмя Из Кандидаты Цикл
		Если СтрНайти(ВерхПоле, ВРег(ПоследнийСегментИмени(ПолноеИмя))) > 0 Тогда
			Возврат ПолноеИмя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПолеПохожеНаСубконтоДтКт(ИмяПоля)

	Верх = ВРег(Строка(ИмяПоля));
	Возврат СтрНачинаетсяС(Верх, "СУБКОНТОДТ")
		ИЛИ СтрНачинаетсяС(Верх, "СУБКОНТОКТ");

КонецФункции

Функция ПолеПохожеНаРазыменованиеВиртуальнойТаблицы(ПолноеПоле, ТекстЗапроса)

	Если ПустаяСтрока(ПолноеПоле) ИЛИ ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
	ЧастиПоля = СтрРазделить(ПолноеПоле, ".", Ложь);
	Если ЧастиПоля.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	ВерхТекст = ВРег(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	Если НЕ (СтрНайти(ВерхТекст, ".ОСТАТКИ") > 0
		ИЛИ СтрНайти(ВерхТекст, ".ОБОРОТЫ") > 0
		ИЛИ СтрНайти(ВерхТекст, ".ОСТАТКИИОБОРОТЫ") > 0
		ИЛИ СтрНайти(ВерхТекст, ".ОБОРОТЫДТКТ") > 0
		ИЛИ СтрНайти(ВерхТекст, ".СРЕЗПОСЛЕДНИХ") > 0
		ИЛИ СтрНайти(ВерхТекст, ".СРЕЗПЕРВЫХ") > 0) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВерхПоле = ВРег(ПолноеПоле);
	Если СтрНайти(ВерхТекст, ВерхПоле) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЧастиПоля.Количество() >= 2 Тогда
		ХвостПоля = ВРег(ЧастиПоля[ЧастиПоля.Количество() - 2] + "." + ЧастиПоля[ЧастиПоля.Количество() - 1]);
		Возврат СтрНайти(ВерхТекст, ХвостПоля) > 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ПоляОбъектаДляДиагностики(ПолноеИмя, МаксимумПолей, КешДиагностики = Неопределено)

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтруктураОбъекта = СтруктураОбъектаДляДиагностики(ПолноеИмя, КешДиагностики);
	Если СтруктураОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Новый Массив;
	ДобавитьИменаПолейДиагностики(Поля, СтруктураОбъекта.standard_attributes, МаксимумПолей);
	ДобавитьИменаПолейДиагностики(Поля, СтруктураОбъекта.attributes, МаксимумПолей);
	Если СтруктураОбъекта.register_schema <> Неопределено Тогда
		ДобавитьИменаПолейДиагностики(Поля, СтруктураОбъекта.register_schema.dimensions, МаксимумПолей);
		ДобавитьИменаПолейДиагностики(Поля, СтруктураОбъекта.register_schema.resources, МаксимумПолей);
		ДобавитьИменаПолейДиагностики(Поля, СтруктураОбъекта.register_schema.attributes, МаксимумПолей);
	КонецЕсли;

	ТабличныеЧасти = Новый Массив;
	Для Каждого ТЧ Из СтруктураОбъекта.tabular_sections Цикл
		СтрТЧ = Новый Структура;
		СтрТЧ.Вставить("name", ТЧ.name);
		ПоляТЧ = Новый Массив;
		ДобавитьИменаПолейДиагностики(ПоляТЧ, ТЧ.attributes, 30);
		СтрТЧ.Вставить("fields", ПоляТЧ);
		ТабличныеЧасти.Добавить(СтрТЧ);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("type", ПолноеИмя);
	Результат.Вставить("fields", Поля);
	Результат.Вставить("tabular_sections", ТабличныеЧасти);
	Возврат Результат;

КонецФункции

Функция СтруктураОбъектаДляДиагностики(ПолноеИмя, КешДиагностики = Неопределено)

	КлючКеша = "metadata_structure:" + НРег(ПолноеИмя);
	Если КешДиагностики <> Неопределено Тогда
		СтруктураОбъекта = КешДиагностики.Получить(КлючКеша);
		Если СтруктураОбъекта <> Неопределено Тогда
			Возврат СтруктураОбъекта;
		КонецЕсли;
	КонецЕсли;

	Опции = MCP_Metadata.ОпцииСтруктурыПоУмолчанию();
	Опции.include_standard_attributes = Истина;
	Опции.include_attributes = Истина;
	Опции.include_tabular_sections = Истина;
	Опции.include_virtual_tables = Истина;
	СтруктураОбъекта = MCP_Metadata.СтруктураОбъекта(ПолноеИмя, Опции);
	Если КешДиагностики <> Неопределено И СтруктураОбъекта <> Неопределено Тогда
		КешДиагностики.Вставить(КлючКеша, СтруктураОбъекта);
	КонецЕсли;
	Возврат СтруктураОбъекта;

КонецФункции

Процедура ДобавитьИменаПолейДиагностики(Поля, Реквизиты, МаксимумПолей)

	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Поля.Количество() >= МаксимумПолей Тогда
			Возврат;
		КонецЕсли;
		Попытка
			Если Реквизит.allowed Тогда
				Поля.Добавить(Реквизит.name);
			КонецЕсли;
		Исключение
			// Нестандартная структура описания поля.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ОбогатитьДиагностикуПоляПоТекстуЗапроса(
	Результат, ИмяПоля, ПолноеПоле, ТекстЗапроса,
	Валидация, КешДиагностики, CorrelationID)

	КодДиагностики = "";
	Если НЕ Результат.Свойство("error_code", КодДиагностики)
		ИЛИ КодДиагностики <> "field_not_found" Тогда
		Возврат;
	КонецЕсли;

	Если ОбогатитьОшибкуВиртуальнойТаблицы(
		Результат, ИмяПоля, ТекстЗапроса,
		Валидация, КешДиагностики, CorrelationID) Тогда
		Возврат;
	КонецЕсли;

	ОбогатитьОшибкуРесурсаРегистраВГде(Результат, ИмяПоля, ПолноеПоле, ТекстЗапроса);

КонецПроцедуры

Функция ОбогатитьОшибкуВиртуальнойТаблицы(
	Результат, ИмяПоля, ТекстЗапроса,
	Валидация, КешДиагностики, CorrelationID)

	ИсточникВТ = НайтиИсточникВиртуальнойТаблицыВЗапросе(ТекстЗапроса);
	Если ИсточникВТ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеПолейВТ = ПоляВиртуальнойТаблицыДляДиагностики(
		ИсточникВТ.object_name, ИсточникВТ.virtual_table, КешДиагностики);
	ПоляВТ = ДанныеПолейВТ.fields;
	Если ПоляВТ.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ОписаниеПолей = Новый Структура;
	ОписаниеПолей.Вставить("type", ИсточникВТ.source_table);
	ОписаниеПолей.Вставить("fields", ПоляВТ);
	ОписаниеПолей.Вставить("tabular_sections", Новый Массив);
	ДоступныеПоля = Новый Массив;
	ДоступныеПоля.Добавить(ОписаниеПолей);

	Результат.Вставить("source_table", ИсточникВТ.source_table);
	Результат.Вставить("available_fields", ПоляВТ);
	Результат.Вставить("available_fields_source", "virtual_table");
	Результат.Вставить("available_fields_sample", ДоступныеПоля);
	Результат.Вставить("hint", ПодсказкаЗаменыПоляВиртуальнойТаблицы(
		ИмяПоля, ИсточникВТ.object_name, ИсточникВТ.virtual_table, ПоляВТ));
	Результат.Вставить("see_also", ИсточникВТ.source_table);
	ЗаписатьЛогCR01(ИсточникВТ, ИмяПоля, ДанныеПолейВТ.cache_hit, CorrelationID);
	Возврат Истина;

КонецФункции

// ====================================================================
// Карта псевдонимов запроса. Общая основа для pre-flight проверки источников и
// полей обычных таблиц (F-01…F-03) и для детекта коллизии псевдонима (F-04).
//
// Отличия от НайтиИсточникиЗапроса: сохраняются все вхождения источников без
// дедупликации (она теряет привязку псевдонима к источнику), распознаётся группа
// параметров виртуальной таблицы и полный набор форм соединений.
//
// Структура результата:
//   bindings  — Соответствие ВРег(псевдоним) → привязка (только однозначные)
//   sources   — Массив всех привязок в порядке вхождения
//   conflicts — псевдонимы, снятые из-за неоднозначности
//   gave_up   — текст не разобран однозначно: вся проверка отключается (NF-02)
//
// Привязка: { raw, alias, implicit_alias, full_name, kind, third_segment,
//             resolution, source_table }, где resolution:
//   object_table  — основная таблица объекта (<Вид>.<Имя>)
//   tabular_part  — таблица табличной части (<Вид>.<Имя>.<ИмяТЧ>), заявленная
//                   по форме имени; существование ТЧ проверяет F-01
//   virtual_table — виртуальная таблица регистра (владелец — pre-flight ВТ)
//   unresolved    — временная таблица, подзапрос, неизвестный вид, служебная
//                   таблица платформы: проверять нечего, пропускаем на движок
// ====================================================================
Функция КартаАлиасовЗапроса(ОчищенныйТекст)

	Результат = Новый Структура;
	Результат.Вставить("bindings", Новый Соответствие);
	Результат.Вставить("sources", Новый Массив);
	Результат.Вставить("conflicts", Новый Массив);
	Результат.Вставить("gave_up", Ложь);
	Результат.Вставить("reason", "");

	Лексемы = ЛексемыИсточников(ОчищенныйТекст);
	ВременныеТаблицы = ИменаВременныхТаблиц(ОчищенныйТекст);
	Глубина = 0;
	ОжидаемИсточник = Ложь;
	ВРазделеИсточников = Ложь;
	ЕстьРазделИсточников = Ложь;
	Индекс = 0;

	Пока Индекс < Лексемы.Количество() Цикл
		Токен = СокрЛП(Лексемы[Индекс]);
		Если ПустаяСтрока(Токен) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		ТокенВРег = ВРег(Токен);

		Если Токен = "(" Тогда
			Глубина = Глубина + 1;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Токен = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина < 0 Тогда
				Результат.gave_up = Истина;
				Результат.reason = "unbalanced_parentheses";
				Возврат Результат;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Токен = ";" Тогда
			ВРазделеИсточников = Ложь;
			ОжидаемИсточник = Ложь;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Токен = "," Тогда
			Если ВРазделеИсточников И Глубина = 0 Тогда
				ОжидаемИсточник = Истина;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если Глубина = 0 И КонецРазделаИсточников(ТокенВРег) Тогда
			ВРазделеИсточников = Ложь;
			ОжидаемИсточник = Ложь;
		КонецЕсли;

		Если ОжидаемИсточник Тогда
			ОжидаемИсточник = Ложь;
			Если ТокенВРег = "ВЫБРАТЬ" ИЛИ ТокенВРег = "SELECT" Тогда
				// Подзапрос-источник: состав полей известен только из его текста.
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Индекс = ДобавитьПривязкуИсточника(Результат, Лексемы, Индекс, Токен, ВременныеТаблицы);
			Продолжить;
		КонецЕсли;

		Если ТокенВРег = "ИЗ"
			ИЛИ ТокенВРег = "FROM"
			ИЛИ ТокенВРег = "СОЕДИНЕНИЕ"
			ИЛИ ТокенВРег = "JOIN" Тогда
			ВРазделеИсточников = Истина;
			ОжидаемИсточник = Истина;
			ЕстьРазделИсточников = Истина;
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Если Глубина <> 0 Тогда
		Результат.gave_up = Истина;
		Результат.reason = "unbalanced_parentheses";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЕстьРазделИсточников ИЛИ Результат.sources.Количество() = 0 Тогда
		Результат.gave_up = Истина;
		Результат.reason = "no_sources_detected";
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разбирает один источник, начиная с его токена, и возвращает индекс следующего
// необработанного токена.
Функция ДобавитьПривязкуИсточника(Карта, Лексемы, ИндексИсточника, RawИсточника, ВременныеТаблицы)

	Индекс = ИндексИсточника + 1;

	// Сбалансированная группа параметров виртуальной таблицы (...): псевдоним
	// вводится после закрывающей скобки.
	Если Индекс < Лексемы.Количество() И СокрЛП(Лексемы[Индекс]) = "(" Тогда
		Глубина = 0;
		Пока Индекс < Лексемы.Количество() Цикл
			Текущий = СокрЛП(Лексемы[Индекс]);
			Если Текущий = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Текущий = ")" Тогда
				Глубина = Глубина - 1;
				Если Глубина = 0 Тогда
					Индекс = Индекс + 1;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;

	// Необязательное КАК/AS.
	Если Индекс < Лексемы.Количество() Тогда
		СледВРег = ВРег(СокрЛП(Лексемы[Индекс]));
		Если СледВРег = "КАК" ИЛИ СледВРег = "AS" Тогда
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЕсли;

	Псевдоним = "";
	Если Индекс < Лексемы.Количество() Тогда
		Кандидат = СокрЛП(Лексемы[Индекс]);
		Если НЕ ПустаяСтрока(Кандидат)
			И НЕ ЭтоКлючевоеСловоРазделаИсточников(ВРег(Кандидат))
			И СтрНайти(Кандидат, ".") = 0
			И НЕ СтрНачинаетсяС(Кандидат, "&") Тогда
			Псевдоним = Кандидат;
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЕсли;

	Привязка = РазрешитьИсточникЗапроса(RawИсточника, Псевдоним);
	Карта.sources.Добавить(Привязка);
	ЗарегистрироватьПривязкуПсевдонима(Карта, Привязка, ВременныеТаблицы);
	Возврат Индекс;

КонецФункции

Функция РазрешитьИсточникЗапроса(RawИсточника, Псевдоним)

	Привязка = Новый Структура;
	Привязка.Вставить("raw", RawИсточника);
	Привязка.Вставить("alias", ?(ПустаяСтрока(Псевдоним), RawИсточника, Псевдоним));
	Привязка.Вставить("implicit_alias", ПустаяСтрока(Псевдоним));
	Привязка.Вставить("full_name", "");
	Привязка.Вставить("kind", "");
	Привязка.Вставить("third_segment", "");
	Привязка.Вставить("resolution", "unresolved");
	Привязка.Вставить("source_table", RawИсточника);

	Если СтрНачинаетсяС(RawИсточника, "&") Тогда
		Возврат Привязка;
	КонецЕсли;

	ПолноеИмя = ПолноеИмяМетаданныхИзЛексемы(RawИсточника);
	Если ПустаяСтрока(ПолноеИмя) Тогда
		// Временная таблица, неизвестный вид метаданных (ЖурналДокументов,
		// КритерийОтбора и подобные) — проверять нечего.
		Возврат Привязка;
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено ИЛИ НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		// Отсутствие объекта и запрет allowlist — зона Валидировать, не наша.
		Возврат Привязка;
	КонецЕсли;

	Привязка.full_name = ПолноеИмя;
	Привязка.kind = MCP_Metadata.ВидПоОбъектуМетаданных(ОМД);
	Привязка.source_table = ПолноеИмя;

	Если НЕ ПустаяСтрока(ИмяВиртуальнойТаблицыИзRaw(RawИсточника)) Тогда
		Привязка.resolution = "virtual_table";
		Возврат Привязка;
	КонецЕсли;

	Части = СтрРазделить(RawИсточника, ".", Ложь);
	Если Части.Количество() = 2 Тогда
		Привязка.resolution = "object_table";
	ИначеЕсли Части.Количество() = 3 Тогда
		Привязка.third_segment = Части[2];
		Привязка.resolution = "tabular_part";
		Привязка.source_table = ПолноеИмя + "." + Части[2];
	КонецЕсли;

	Возврат Привязка;

КонецФункции

Процедура ЗарегистрироватьПривязкуПсевдонима(Карта, Привязка, ВременныеТаблицы)

	Ключ = ВРег(СокрЛП(Строка(Привязка.alias)));
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;
	Если ПолеЕстьВНаборе(Ключ, Карта.conflicts) Тогда
		Возврат;
	КонецЕсли;

	Существующая = Карта.bindings.Получить(Ключ);
	Если Существующая <> Неопределено Тогда
		Если ВРег(Существующая.raw) <> ВРег(Привязка.raw) Тогда
			// Один псевдоним привязан к разным источникам (разные пакеты или
			// подзапросы) — состав полей неоднозначен, псевдоним снимается.
			Карта.bindings.Удалить(Ключ);
			Карта.conflicts.Добавить(Привязка.alias);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ПолеЕстьВНаборе(Ключ, ВременныеТаблицы) Тогда
		Возврат;
	КонецЕсли;

	// Псевдоним, совпадающий с именем вида метаданных, ломает текстовый скан:
	// ВЫРАЗИТЬ(... КАК Справочник.Организации), ССЫЛКА Справочник.X,
	// ЗНАЧЕНИЕ(Перечисление.X.Y) дали бы фантомные «поля».
	Если НЕ ПустаяСтрока(КаноническийВидМетаданных(Привязка.alias)) Тогда
		Карта.conflicts.Добавить(Привязка.alias);
		Возврат;
	КонецЕсли;

	Карта.bindings.Вставить(Ключ, Привязка);

КонецПроцедуры

// Полный стоп-список: токен, который не может быть псевдонимом источника.
// Базовая ВыглядитКакАлиасИсточника не знает форм соединений и при опущенном КАК
// вернула бы «ЛЕВОЕ» как псевдоним.
Функция ЭтоКлючевоеСловоРазделаИсточников(ТокенВРег)

	Возврат ТокенВРег = "ЛЕВОЕ" ИЛИ ТокенВРег = "LEFT"
		ИЛИ ТокенВРег = "ПРАВОЕ" ИЛИ ТокенВРег = "RIGHT"
		ИЛИ ТокенВРег = "ПОЛНОЕ" ИЛИ ТокенВРег = "FULL"
		ИЛИ ТокенВРег = "ВНУТРЕННЕЕ" ИЛИ ТокенВРег = "INNER"
		ИЛИ ТокенВРег = "ВНЕШНЕЕ" ИЛИ ТокенВРег = "OUTER"
		ИЛИ ТокенВРег = "СОЕДИНЕНИЕ" ИЛИ ТокенВРег = "JOIN"
		ИЛИ ТокенВРег = "ПО" ИЛИ ТокенВРег = "ON"
		ИЛИ ТокенВРег = "ГДЕ" ИЛИ ТокенВРег = "WHERE"
		ИЛИ ТокенВРег = "СГРУППИРОВАТЬ" ИЛИ ТокенВРег = "GROUP"
		ИЛИ ТокенВРег = "УПОРЯДОЧИТЬ" ИЛИ ТокенВРег = "ORDER"
		ИЛИ ТокенВРег = "ИМЕЮЩИЕ" ИЛИ ТокенВРег = "HAVING"
		ИЛИ ТокенВРег = "ОБЪЕДИНИТЬ" ИЛИ ТокенВРег = "UNION"
		ИЛИ ТокенВРег = "ВСЕ" ИЛИ ТокенВРег = "ALL"
		ИЛИ ТокенВРег = "ИТОГИ" ИЛИ ТокенВРег = "TOTALS"
		ИЛИ ТокенВРег = "ПОМЕСТИТЬ" ИЛИ ТокенВРег = "INTO"
		ИЛИ ТокенВРег = "ИНДЕКСИРОВАТЬ" ИЛИ ТокенВРег = "INDEX"
		ИЛИ ТокенВРег = "УНИЧТОЖИТЬ" ИЛИ ТокенВРег = "DROP"
		ИЛИ ТокенВРег = "ИЗ" ИЛИ ТокенВРег = "FROM"
		ИЛИ ТокенВРег = "КАК" ИЛИ ТокенВРег = "AS"
		ИЛИ ТокенВРег = "ВЫБРАТЬ" ИЛИ ТокенВРег = "SELECT"
		ИЛИ ТокенВРег = "И" ИЛИ ТокенВРег = "AND"
		ИЛИ ТокенВРег = "ИЛИ" ИЛИ ТокенВРег = "OR"
		ИЛИ ТокенВРег = "НЕ" ИЛИ ТокенВРег = "NOT"
		ИЛИ ТокенВРег = "ДЛЯ" ИЛИ ТокенВРег = "FOR"
		ИЛИ ТокенВРег = "АВТОУПОРЯДОЧИВАНИЕ" ИЛИ ТокенВРег = "AUTOORDER"
		ИЛИ ТокенВРег = "(" ИЛИ ТокенВРег = ")"
		ИЛИ ТокенВРег = "," ИЛИ ТокенВРег = ";";

КонецФункции

// F-04: предупреждение о совпадении псевдонима с именем табличной части другой
// таблицы того же запроса. Не блокирует: есть конструкции, где 1С разрешает
// такое обращение корректно, а ложный отказ хуже пропущенной проверки.
Процедура ДобавитьПредупрежденияКоллизииПсевдонимаСТабличнойЧастью(Результат, ТекстЗапроса, КешДиагностики)

	Попытка
		Карта = КартаАлиасовЗапроса(ТекстЗапроса);
		Если Карта.gave_up Тогда
			Возврат;
		КонецЕсли;

		Псевдонимы = Новый Массив;
		Для Каждого Привязка Из Карта.sources Цикл
			Если НЕ Привязка.implicit_alias Тогда
				Псевдонимы.Добавить(Привязка.alias);
			КонецЕсли;
		КонецЦикла;
		Если Псевдонимы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		Выданные = Новый Соответствие;
		Для Каждого Привязка Из Карта.sources Цикл
			Если Привязка.resolution <> "object_table" Тогда
				Продолжить;
			КонецЕсли;
			ДанныеТЧ = ТабличныеЧастиКэшированные(Привязка.full_name, КешДиагностики);
			Если НЕ ДанныеТЧ.supported Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Псевдоним Из Псевдонимы Цикл
				Если ВРег(Псевдоним) = ВРег(Привязка.alias) Тогда
					// Псевдоним самой этой таблицы — коллизии нет.
					Продолжить;
				КонецЕсли;
				ИмяТЧ = НайтиИмяБезУчетаРегистра(ДанныеТЧ.names, Псевдоним);
				Если ПустаяСтрока(ИмяТЧ) Тогда
					ИмяТЧ = НайтиИмяБезУчетаРегистра(ДанныеТЧ.standard_names, Псевдоним);
				КонецЕсли;
				Если ПустаяСтрока(ИмяТЧ) Тогда
					Продолжить;
				КонецЕсли;
				Ключ = ВРег(Псевдоним) + "|" + ВРег(Привязка.full_name) + "|" + ВРег(ИмяТЧ);
				Если Выданные.Получить(Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если Выданные.Количество() >= 5 Тогда
					Возврат;
				КонецЕсли;
				Выданные.Вставить(Ключ, Истина);
				Результат.warnings.Добавить(
					"Псевдоним '" + Псевдоним + "' совпадает с именем табличной части '" + ИмяТЧ
					+ "' таблицы " + Привязка.full_name + ", участвующей в этом же запросе."
					+ " 1С может счесть обращения к '" + Псевдоним + ".' неоднозначными."
					+ " Переименуйте псевдоним.");
			КонецЦикла;
		КонецЦикла;
	Исключение
		// Детект коллизии — вспомогательная подсказка: её сбой не должен влиять
		// на валидацию запроса.
	КонецПопытки;

КонецПроцедуры

// Возвращает имя из списка в его исходном написании либо "" — сравнение без
// учёта регистра.
Функция НайтиИмяБезУчетаРегистра(Список, Имя)

	Если Список = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ИскомоеИмя = ВРег(СокрЛП(Строка(Имя)));
	Если ПустаяСтрока(ИскомоеИмя) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Элемент Из Список Цикл
		Если ВРег(СокрЛП(Строка(Элемент))) = ИскомоеИмя Тогда
			Возврат Строка(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Кеш состава табличных частей на время одного запроса. Ключ tabular_parts:<имя>.
Функция ТабличныеЧастиКэшированные(ПолноеИмя, КешДиагностики)

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("names", Новый Массив);
	Результат.Вставить("standard_names", Новый Массив);
	Результат.Вставить("has_collection", Ложь);
	Результат.Вставить("kind", "");
	Результат.Вставить("reason", "");
	Результат.Вставить("cache_hit", Ложь);

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Результат.reason = "empty_name";
		Возврат Результат;
	КонецЕсли;

	КлючКеша = "tabular_parts:" + НРег(ПолноеИмя);
	Если КешДиагностики <> Неопределено Тогда
		Кешированное = КешДиагностики.Получить(КлючКеша);
		Если Кешированное <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат, Кешированное);
			Результат.cache_hit = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Набор = MCP_Metadata.ТабличныеЧастиТаблицыЗапроса(ПолноеИмя);
	ЗаполнитьЗначенияСвойств(Результат, Набор);
	Если КешДиагностики <> Неопределено Тогда
		КешДиагностики.Вставить(КлючКеша, Набор);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Кеш состава полей обычной таблицы на время одного запроса.
// Ключ table_fields_full:<имя>[.<табличная часть>].
Функция НаборПолейТаблицыКэшированный(ПолноеИмя, ИмяТабличнойЧасти, КешДиагностики) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("public_fields", Новый Массив);
	Результат.Вставить("reason", "");
	Результат.Вставить("table_kind", "");
	Результат.Вставить("cache_hit", Ложь);

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Результат.reason = "empty_name";
		Возврат Результат;
	КонецЕсли;

	КлючКеша = "table_fields_full:" + НРег(ПолноеИмя);
	Если НЕ ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		КлючКеша = КлючКеша + "." + НРег(ИмяТабличнойЧасти);
	КонецЕсли;
	Если КешДиагностики <> Неопределено Тогда
		Кешированное = КешДиагностики.Получить(КлючКеша);
		Если Кешированное <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат, Кешированное);
			Результат.cache_hit = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Набор = MCP_Metadata.ПолныйНаборПолейТаблицыЗапроса(ПолноеИмя, ИмяТабличнойЧасти);
	ЗаполнитьЗначенияСвойств(Результат, Набор);
	Если КешДиагностики <> Неопределено Тогда
		КешДиагностики.Вставить(КлючКеша, Набор);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ====================================================================
// HR-02/HR-03/HR-04 (фаза C): точные жёсткие запреты privacy.
//
// Фаза B отклоняла запрос по текстовому вхождению имени закрытого поля, из-за
// чего одноимённое поле незакрытого источника (Номенклатура.Наименование рядом
// с закрытыми Контрагентами) гибло зря. Здесь принадлежность поля разрешается
// по псевдонимам источников, а разыменование — по метаданным.
//
// Возвращает Массив Структур(type, field, path): пустой — нарушений нет.
// ====================================================================
// СтрНайти с начальной позицией больше длины строки возбуждает исключение
// «Недопустимое значение параметра (параметр номер 4)». В циклах поиска
// вхождений позиция после последнего совпадения становится равной длине плюс
// один, поэтому следующая итерация роняла всю проверку privacy: запрос,
// оканчивающийся закрытым полем («УПОРЯДОЧИТЬ ПО Т.НаименованиеПолное»),
// возвращал internal_error вместо внятного отказа.
Функция НайтиСПозицииPrivacy(Текст, Подстрока, Позиция)

	Если Позиция > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СтрНайти(Текст, Подстрока, , Позиция);

КонецФункции

Функция ЗакрытыеОбращенияPrivacy(ОчищенныйТекст) Экспорт

	Нарушения = Новый Массив;
	Если НЕ MCP_Security.ЕстьЖесткиеЗапретыPrivacy() Тогда
		Возврат Нарушения;
	КонецЕсли;

	Карта = КартаАлиасовЗапроса(ОчищенныйТекст);
	Найдено = Новый Соответствие;

	// HR-02, консервативный отказ: текст разобрать не удалось, но закрытый тип
	// в нём упомянут — принадлежность полей не проверить, а пропустить нельзя.
	Если Карта.gave_up Тогда
		Для Каждого ИмяЗакрытогоТипа Из ТипыЗакрытыеВТекстеPrivacy(ОчищенныйТекст) Цикл
			ДобавитьНарушениеPrivacy(Нарушения, Найдено, ИмяЗакрытогоТипа,
				"<структура запроса не разобрана>", ИмяЗакрытогоТипа);
		КонецЦикла;
		Возврат Нарушения;
	КонецЕсли;

	// Квалифицированные обращения: <псевдоним>.<поле>[.<поле>...].
	//
	// Обходим sources, а не bindings: bindings снимает псевдоним, привязанный к
	// разным источникам в разных пакетах или подзапросах, и такой запрос ушёл бы
	// без проверки. Здесь путь проверяется у каждого источника с этим
	// псевдонимом — при неоднозначности отказ возможен по чужому источнику, но
	// §3 ставит отсутствие утечки выше отсутствия ложных срабатываний.
	// Источники вложенных запросов и объединений в sources попадают: раздел
	// ИЗ/СОЕДИНЕНИЕ распознаётся на любой глубине вложенности.
	Для Каждого Привязка Из Карта.sources Цикл
		Если ПустаяСтрока(Привязка.full_name) ИЛИ ПустаяСтрока(Привязка.alias) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Путь Из ПутиАдресованныеАлиасуPrivacy(ОчищенныйТекст, Привязка.alias) Цикл
			ПроверитьПутьPrivacy(Привязка.full_name, Путь, Нарушения, Найдено);
		КонецЦикла;
	КонецЦикла;

	// Обращения без псевдонима (ВЫБРАТЬ Наименование ИЗ Справочник.Контрагенты):
	// принадлежность не выражена в тексте, поэтому имя проверяется у каждого
	// источника запроса. Квалифицированные вхождения здесь не участвуют — их
	// уже разобрал блок выше, и одноимённое чужое поле не пострадает.
	Для Каждого Привязка Из Карта.sources Цикл
		Если ПустаяСтрока(Привязка.full_name) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЗакрытоеПоле Из MCP_Security.ЖесткоЗакрытыеПоляPrivacy(Привязка.full_name) Цикл
			Если ПолеВстречаетсяБезПсевдонимаPrivacy(ОчищенныйТекст, ЗакрытоеПоле) Тогда
				ДобавитьНарушениеPrivacy(Нарушения, Найдено, Привязка.full_name, ЗакрытоеПоле, ЗакрытоеПоле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ДобавитьНарушенияПредставленияPrivacy(ОчищенныйТекст, Карта, Нарушения, Найдено);
	ДобавитьНарушенияПриведенияТипаPrivacy(ОчищенныйТекст, Нарушения, Найдено);

	Возврат Нарушения;

КонецФункции

// Закрытые типы, упомянутые в тексте запроса: по полному имени либо по имени
// объекта как отдельному идентификатору (источник мог быть записан
// сокращённо или через временную таблицу).
Функция ТипыЗакрытыеВТекстеPrivacy(ОчищенныйТекст)

	Результат = Новый Массив;
	ВерхТекст = ВРег(ОчищенныйТекст);

	Для Каждого ИмяТипа Из MCP_Security.ЖесткоЗакрытыеТипыPrivacy() Цикл
		Если СтрНайти(ВерхТекст, ВРег(ИмяТипа)) > 0 Тогда
			Результат.Добавить(ИмяТипа);
			Продолжить;
		КонецЕсли;
		ИмяОбъекта = ИмяОбъектаИзПолногоИмениPrivacyQuery(ИмяТипа);
		Если НЕ ПустаяСтрока(ИмяОбъекта)
			И ПолеВстречаетсяБезПсевдонимаPrivacy(ОчищенныйТекст, ИмяОбъекта) Тогда
			Результат.Добавить(ИмяТипа);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяОбъектаИзПолногоИмениPrivacyQuery(ИмяТипа)

	Части = СтрРазделить(СокрЛП(Строка(ИмяТипа)), ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Части[1]);

КонецФункции

// Обход пути от типа источника: каждый сегмент проверяется у текущего набора
// типов, затем набор заменяется ссылочными типами этого сегмента. Составной
// тип закрыт, если закрыт хотя бы один из составляющих (HR-03).
// ОписаниеВыражения — необязательный текст для причины отказа, когда путь сам
// по себе не самоочевиден (разыменование после ВЫРАЗИТЬ/CAST).
Процедура ПроверитьПутьPrivacy(ПолноеИмяИсточника, Путь, Нарушения, Найдено, ОписаниеВыражения = "")

	ТекущиеТипы = Новый Массив;
	ТекущиеТипы.Добавить(ПолноеИмяИсточника);

	Для Индекс = 0 По Путь.Количество() - 1 Цикл
		Сегмент = Путь[Индекс];
		Для Каждого ИмяТипа Из ТекущиеТипы Цикл
			Если MCP_Security.ПолеЖесткоЗакрытоPrivacy(ИмяТипа, Сегмент) Тогда
				ДобавитьНарушениеPrivacy(Нарушения, Найдено, ИмяТипа, Сегмент,
					?(ПустаяСтрока(ОписаниеВыражения), СтрСоединить(Путь, "."), ОписаниеВыражения));
			КонецЕсли;
		КонецЦикла;

		Если Индекс = Путь.Количество() - 1 Тогда
			Прервать;
		КонецЕсли;

		СледующиеТипы = Новый Массив;
		Для Каждого ИмяТипа Из ТекущиеТипы Цикл
			Для Каждого СсылочныйТип Из СсылочныеТипыПоляPrivacy(ИмяТипа, Сегмент) Цикл
				СледующиеТипы.Добавить(СсылочныйТип);
			КонецЦикла;
		КонецЦикла;
		Если СледующиеТипы.Количество() = 0 Тогда
			// Тип сегмента не разрешён: дальше идти не по чему. Несуществующее
			// поле отклонит pre-flight F-02, ложный отказ здесь не нужен.
			Прервать;
		КонецЕсли;
		ТекущиеТипы = СледующиеТипы;
	КонецЦикла;

КонецПроцедуры

// Полные имена ссылочных типов поля по метаданным. Любая неудача — пустой
// массив (обход пути останавливается).
Функция СсылочныеТипыПоляPrivacy(ПолноеИмяТипа, ИмяПоля)

	Результат = Новый Массив;

	Попытка
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
		Если ОбъектМД = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Реквизит = РеквизитОбъектаПоИмени(ОбъектМД, ИмяПоля);
		Если Реквизит = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл
			ОМДТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
			Если ОМДТипа <> Неопределено Тогда
				Результат.Добавить(ОМДТипа.ПолноеИмя());
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Интроспекция метаданных не должна ронять валидацию.
		Возврат Новый Массив;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// HR-04: ПРЕДСТАВЛЕНИЕ()/ПРЕДСТАВЛЕНИЕССЫЛКИ() над ссылкой закрытого типа.
// Запрет полей такой запрос не ловит: в тексте упомянута только Ссылка.
Процедура ДобавитьНарушенияПредставленияPrivacy(ОчищенныйТекст, Карта, Нарушения, Найдено)

	Функции = Новый Массив;
	Функции.Добавить("ПРЕДСТАВЛЕНИЕССЫЛКИ");
	Функции.Добавить("ПРЕДСТАВЛЕНИЕ");
	Функции.Добавить("REFPRESENTATION");
	Функции.Добавить("PRESENTATION");

	ВерхТекст = ВРег(ОчищенныйТекст);
	Для Каждого ИмяФункции Из Функции Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			Поз = НайтиСПозицииPrivacy(ВерхТекст, ИмяФункции + "(", ПозицияПоиска);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозицияПоиска = Поз + СтрДлина(ИмяФункции);
			Если Поз > 1 И ЯвляетсяСимволомИдентификатора(Сред(ОчищенныйТекст, Поз - 1, 1)) Тогда
				// ПРЕДСТАВЛЕНИЕССЫЛКИ уже обработано отдельным именем.
				Продолжить;
			КонецЕсли;
			Аргумент = АргументФункцииPrivacy(ОчищенныйТекст, Поз + СтрДлина(ИмяФункции));
			Если ПустаяСтрока(Аргумент) Тогда
				Аргумент = "<выражение>";
			КонецЕсли;

			Если Аргумент <> "<выражение>"
				И ПроверитьАргументПредставленияPrivacy(Аргумент, Карта, Нарушения, Найдено) Тогда
				Продолжить;
			КонецЕсли;

			// Тип аргумента разрешить не удалось (поле временной таблицы,
			// выражение, подзапрос). Если в запросе участвует закрытый тип,
			// представление может оказаться его названием — отказ (HR-02).
			Для Каждого ИмяЗакрытогоТипа Из ТипыЗакрытыеВТекстеPrivacy(ОчищенныйТекст) Цикл
				Если MCP_Security.ПредставлениеЖесткоЗакрытоPrivacy(ИмяЗакрытогоТипа) Тогда
					ДобавитьНарушениеPrivacy(Нарушения, Найдено, ИмяЗакрытогоТипа,
						"ПРЕДСТАВЛЕНИЕ() с неразрешимым типом аргумента", Аргумент);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Тип аргумента функции представления: <псевдоним>.<путь> либо голая ссылка
// при единственном источнике. Возвращает Истину, если тип аргумента удалось
// разрешить хотя бы у одного источника: иначе вызывающая сторона выдаёт
// консервативный отказ (HR-02).
Функция ПроверитьАргументПредставленияPrivacy(Аргумент, Карта, Нарушения, Найдено)

	Сегменты = СтрРазделить(СокрЛП(Аргумент), ".", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешен = Ложь;

	Для Каждого Привязка Из Карта.sources Цикл
		Если ПустаяСтрока(Привязка.full_name) Тогда
			Продолжить;
		КонецЕсли;

		ИмяТипа = Привязка.full_name;
		НачальныйИндекс = 0;
		Если Сегменты.Количество() > 1 И ВРег(Сегменты[0]) = ВРег(Привязка.alias) Тогда
			НачальныйИндекс = 1;
		ИначеЕсли Сегменты.Количество() > 1 Тогда
			// Аргумент адресован другому источнику.
			Продолжить;
		КонецЕсли;

		// Хвост после псевдонима: Ссылка даёт сам тип источника, реквизит —
		// свой ссылочный тип.
		Для Индекс = НачальныйИндекс По Сегменты.Количество() - 1 Цикл
			Сегмент = Сегменты[Индекс];
			Если ВРег(Сегмент) = "ССЫЛКА" ИЛИ ВРег(Сегмент) = "REF" Тогда
				Продолжить;
			КонецЕсли;
			ТипыСегмента = СсылочныеТипыПоляPrivacy(ИмяТипа, Сегмент);
			Если ТипыСегмента.Количество() = 0 Тогда
				ИмяТипа = "";
				Прервать;
			КонецЕсли;
			ИмяТипа = ТипыСегмента[0];
		КонецЦикла;

		Если ПустаяСтрока(ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;

		Разрешен = Истина;
		Если MCP_Security.ПредставлениеЖесткоЗакрытоPrivacy(ИмяТипа) Тогда
			ДобавитьНарушениеPrivacy(Нарушения, Найдено, ИмяТипа, "ПРЕДСТАВЛЕНИЕ()",
				СокрЛП(Аргумент));
		КонецЕсли;
	КонецЦикла;

	Возврат Разрешен;

КонецФункции

// Текст первого аргумента функции, начиная с открывающей скобки.
Функция АргументФункцииPrivacy(Текст, ПозицияСкобки)

	Индекс = ПропуститьПробелы(Текст, ПозицияСкобки);
	Если Индекс > СтрДлина(Текст) ИЛИ Сред(Текст, Индекс, 1) <> "(" Тогда
		Возврат "";
	КонецЕсли;

	Индекс = Индекс + 1;
	Результат = "";
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = ")" ИЛИ Символ = "," ИЛИ Символ = "(" Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;

	Если СтрНайти(Результат, " ") > 0 Тогда
		// Выражение, а не путь: разрешать нечем.
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Результат);

КонецФункции

// Разыменование после приведения типа (#105): путь внутри скобок привязан к
// псевдониму и проверяется отдельно, имя типа после КАК — указание типа, а
// сегменты за закрывающей скобкой не принадлежали ни одному псевдониму и в
// разбор не попадали вообще — ВЫРАЗИТЬ отмывал запрещённое разыменование.
// Здесь цепочка за скобкой проверяется от типа приведения через
// ПроверитьПутьPrivacy: HR-01 на первом сегменте, HR-03 на всей глубине.
// Приведение без разыменования остаётся разрешённым: это сужение составного
// типа до ссылки, ссылку псевдонимизирует второй эшелон.
Процедура ДобавитьНарушенияПриведенияТипаPrivacy(ОчищенныйТекст, Нарушения, Найдено)

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("ВЫРАЗИТЬ");
	КлючевыеСлова.Добавить("CAST");

	ВерхТекст = ВРег(ОчищенныйТекст);
	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			Поз = НайтиСПозицииPrivacy(ВерхТекст, КлючевоеСлово, ПозицияПоиска);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозицияПоиска = Поз + СтрДлина(КлючевоеСлово);
			Если Поз > 1 И ЯвляетсяСимволомИдентификатора(Сред(ОчищенныйТекст, Поз - 1, 1)) Тогда
				Продолжить;
			КонецЕсли;
			ПозицияСкобки = ПропуститьПробелы(ОчищенныйТекст, Поз + СтрДлина(КлючевоеСлово));
			Если ПозицияСкобки > СтрДлина(ОчищенныйТекст)
				ИЛИ Сред(ОчищенныйТекст, ПозицияСкобки, 1) <> "(" Тогда
				// Часть чужого идентификатора либо не вызов функции.
				Продолжить;
			КонецЕсли;
			ПроверитьРазыменованиеПриведенияPrivacy(ОчищенныйТекст, ПозицияСкобки, Нарушения, Найдено);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Разбор одного вхождения ВЫРАЗИТЬ(...)/CAST(...) от открывающей скобки.
// АргументФункцииPrivacy не годится — останавливается на вложенной скобке,
// поэтому парная закрывающая ищется подсчётом глубины. Литералов во входном
// тексте нет: сюда приходит ТекстБезСтрокИКомментариев, скобка в строке-данных
// сканер не собьёт.
Процедура ПроверитьРазыменованиеПриведенияPrivacy(Текст, ПозицияСкобки, Нарушения, Найдено)

	Длина = СтрДлина(Текст);
	Глубина = 0;
	ПозицияЗакрытия = 0;
	ПозицияПослеКАК = 0;
	Индекс = ПозицияСкобки;

	Пока Индекс <= Длина Цикл
		С = Сред(Текст, Индекс, 1);
		Если С = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли С = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				ПозицияЗакрытия = Индекс;
				Прервать;
			КонецЕсли;
		ИначеЕсли Глубина = 1 И ЯвляетсяСимволомИдентификатора(С) Тогда
			// Токены на нулевой глубине вложенности аргумента: интересует
			// последнее КАК/AS — за ним стоит имя типа приведения.
			Слово = ПрочитатьИдентификатор(Текст, Индекс);
			Если ВРег(Слово) = "КАК" ИЛИ ВРег(Слово) = "AS" Тогда
				ПозицияПослеКАК = Индекс + СтрДлина(Слово);
			КонецЕсли;
			Индекс = Индекс + СтрДлина(Слово);
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Если ПозицияЗакрытия = 0 ИЛИ ПозицияПослеКАК = 0 Тогда
		Возврат;
	КонецЕсли;

	// Имя типа после последнего КАК. Принимается только квалифицированное
	// (Справочник.Контрагенты): приведение к примитиву (СТРОКА(50), ЧИСЛО(15,2))
	// точки не содержит и отсекается без отдельного списка исключений.
	ЛексемаТипа = "";
	Индекс = ПропуститьПробелы(Текст, ПозицияПослеКАК);
	Пока Индекс < ПозицияЗакрытия Цикл
		Сегмент = ПрочитатьИдентификатор(Текст, Индекс);
		Если ПустаяСтрока(Сегмент) Тогда
			Прервать;
		КонецЕсли;
		ЛексемаТипа = ЛексемаТипа + ?(ПустаяСтрока(ЛексемаТипа), "", ".") + Сегмент;
		Индекс = Индекс + СтрДлина(Сегмент);
		Если Индекс >= ПозицияЗакрытия ИЛИ Сред(Текст, Индекс, 1) <> "." Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если СтрНайти(ЛексемаТипа, ".") = 0 Тогда
		Возврат;
	КонецЕсли;

	ИмяТипаПриведения = ПолноеИмяМетаданныхИзЛексемы(ЛексемаТипа);
	Если ПустаяСтрока(ИмяТипаПриведения) Тогда
		ИмяТипаПриведения = ЛексемаТипа;
	КонецЕсли;

	Путь = Новый Массив;
	Индекс = ПропуститьПробелы(Текст, ПозицияЗакрытия + 1);
	Пока Индекс <= Длина И Сред(Текст, Индекс, 1) = "." Цикл
		ИмяСегмента = ПрочитатьИдентификатор(Текст, Индекс + 1);
		Если ПустаяСтрока(ИмяСегмента) Тогда
			Прервать;
		КонецЕсли;
		Путь.Добавить(ИмяСегмента);
		Индекс = Индекс + 1 + СтрДлина(ИмяСегмента);
	КонецЦикла;

	Если Путь.Количество() = 0 Тогда
		// Приведение без разыменования — разрешено (§4.4 ТЗ).
		Возврат;
	КонецЕсли;

	ПроверитьПутьPrivacy(ИмяТипаПриведения, Путь, Нарушения, Найдено,
		"ВЫРАЗИТЬ(... КАК " + ИмяТипаПриведения + ")." + СтрСоединить(Путь, "."));

КонецПроцедуры

// Полные пути после псевдонима: Т.Поставщик.Наименование → массив сегментов.
// Массив путей, каждый путь — Массив имён сегментов.
Функция ПутиАдресованныеАлиасуPrivacy(Текст, Алиас)

	Результат = Новый Массив;
	АлиасДлина = СтрДлина(Алиас);
	Если АлиасДлина = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ВерхТекст = ВРег(Текст);
	Шаблон = ВРег(Алиас) + ".";
	ПозицияПоиска = 1;

	Пока Истина Цикл
		Поз = НайтиСПозицииPrivacy(ВерхТекст, Шаблон, ПозицияПоиска);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияПоиска = Поз + АлиасДлина + 1;

		Пропустить = Ложь;
		Если Поз > 1 Тогда
			ПредСимвол = Сред(Текст, Поз - 1, 1);
			Если ЯвляетсяСимволомИдентификатора(ПредСимвол)
				ИЛИ ПредСимвол = "."
				ИЛИ ПредСимвол = "&" Тогда
				Пропустить = Истина;
			ИначеЕсли ПредшествуетКлючевоеСловоКАК(Текст, Поз) Тогда
				// Указание типа (ВЫРАЗИТЬ(... КАК Справочник.X)), не обращение.
				Пропустить = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;

		Путь = Новый Массив;
		Индекс = Поз + АлиасДлина + 1;
		Пока Истина Цикл
			ИмяСегмента = ПрочитатьИдентификатор(Текст, Индекс);
			Если ПустаяСтрока(ИмяСегмента) Тогда
				Прервать;
			КонецЕсли;
			Путь.Добавить(ИмяСегмента);
			Индекс = Индекс + СтрДлина(ИмяСегмента);
			Если Индекс > СтрДлина(Текст) ИЛИ Сред(Текст, Индекс, 1) <> "." Тогда
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;

		Если Путь.Количество() > 0 Тогда
			Результат.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вхождение имени поля как самостоятельного идентификатора, не после точки:
// голое обращение (ВЫБРАТЬ Наименование) ловится, квалифицированное
// (Номенклатура.Наименование) — нет, его разбирает проверка по псевдонимам.
Функция ПолеВстречаетсяБезПсевдонимаPrivacy(Текст, ИмяПоля)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВерхТекст = ВРег(Текст);
	ВерхПоле = ВРег(ИмяПоля);
	Длина = СтрДлина(ВерхПоле);
	ПозицияПоиска = 1;

	Пока Истина Цикл
		Поз = НайтиСПозицииPrivacy(ВерхТекст, ВерхПоле, ПозицияПоиска);
		Если Поз = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		ПозицияПоиска = Поз + Длина;

		ГраницаСлева = Истина;
		Если Поз > 1 Тогда
			ПредСимвол = Сред(Текст, Поз - 1, 1);
			Если ЯвляетсяСимволомИдентификатора(ПредСимвол)
				ИЛИ ПредСимвол = "."
				ИЛИ ПредСимвол = "&" Тогда
				ГраницаСлева = Ложь;
			ИначеЕсли ПредшествуетКлючевоеСловоКАК(Текст, Поз) Тогда
				// Псевдоним колонки или указание типа, а не обращение к полю:
				// ВЫБРАТЬ К.Ссылка КАК Наименование. Само выражение слева от КАК
				// проверяется отдельно, поэтому утечку это не открывает.
				ГраницаСлева = Ложь;
			КонецЕсли;
		КонецЕсли;

		ГраницаСправа = Истина;
		Если Поз + Длина <= СтрДлина(Текст) Тогда
			СледСимвол = Сред(Текст, Поз + Длина, 1);
			Если ЯвляетсяСимволомИдентификатора(СледСимвол) Тогда
				ГраницаСправа = Ложь;
			КонецЕсли;
		КонецЕсли;

		Если ГраницаСлева И ГраницаСправа Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьНарушениеPrivacy(Нарушения, Найдено, ИмяТипа, ИмяПоля, Путь)

	Ключ = ВРег(ИмяТипа + "|" + ИмяПоля + "|" + Путь);
	Если Найдено.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Найдено.Вставить(Ключ, Истина);

	Нарушение = Новый Структура;
	Нарушение.Вставить("type", ИмяТипа);
	Нарушение.Вставить("field", ИмяПоля);
	Нарушение.Вставить("path", Путь);
	Нарушения.Добавить(Нарушение);

КонецПроцедуры

// ====================================================================
// Pre-flight валидация источников и полей обычных таблиц (до Запрос.Выполнить()).
//
// F-01 — существование табличной части в источнике <Вид>.<Имя>.<ИмяТЧ>;
// F-02 — существование поля, адресованного псевдонимом (первый сегмент пути);
// F-03 — у таблицы константы допустимо только поле Значение.
//
// Возвращает Неопределено, когда блокировать нечего; структуру-диагностику при
// доказанно отсутствующем имени — вызывающая сторона возбуждает
// validation_failed_before_run. Все неоднозначные конструкции пропускаются на
// движок (NF-02): ложный отказ валидного запроса хуже пропущенной проверки.
// ====================================================================
Функция ПроверитьИсточникиИПоляПередВыполнением(ТекстЗапроса, Валидация, КешДиагностики) Экспорт

	ОчищенныйТекст = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	Карта = КартаАлиасовЗапроса(ОчищенныйТекст);
	Если Карта.gave_up Тогда
		Возврат Неопределено;
	КонецЕсли;

	// F-01: сначала источники — несуществующая табличная часть делает бессмысленной
	// любую проверку полей по ней.
	Для Каждого Привязка Из Карта.sources Цикл
		Диагностика = ПроверитьТабличнуюЧастьИсточника(Привязка, КешДиагностики);
		Если Диагностика <> Неопределено Тогда
			Возврат Диагностика;
		КонецЕсли;
	КонецЦикла;

	// F-02/F-03: поля, адресованные однозначно разрешённым псевдонимам.
	Для Каждого КЗ Из Карта.bindings Цикл
		Диагностика = ПроверитьПоляПривязки(КЗ.Значение, ОчищенныйТекст, КешДиагностики);
		Если Диагностика <> Неопределено Тогда
			Возврат Диагностика;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// F-01. Отклоняем только при выполнении ВСЕХ условий, иначе fail-open.
Функция ПроверитьТабличнуюЧастьИсточника(Привязка, КешДиагностики)

	Если Привязка.resolution <> "tabular_part" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяТЧ = Привязка.third_segment;
	Если ПустаяСтрока(ИмяТЧ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Таблицы платформы, а не табличные части: Изменения, ТочкаМаршрута,
	// ВидыСубконто, Субконто, ДанныеГрафика и подобные.
	Если ПолеЕстьВНаборе(ИмяТЧ, MCP_Metadata.ПлатформенныеПодтаблицыОбъекта()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеТЧ = ТабличныеЧастиКэшированные(Привязка.full_name, КешДиагностики);
	Если НЕ ДанныеТЧ.supported ИЛИ НЕ ДанныеТЧ.has_collection Тогда
		// Вид без табличных частей либо коллекция недоступна: третий сегмент может
		// быть служебной таблицей платформы, которую мы не перечисляем.
		Возврат Неопределено;
	КонецЕсли;
	Если ДанныеТЧ.names.Количество() = 0 Тогда
		// Объект без табличных частей вообще не участвует в проверке. Плата за
		// безопасность: зато available_tabular_parts в ошибке никогда не пуст.
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ПустаяСтрока(НайтиИмяБезУчетаРегистра(ДанныеТЧ.names, ИмяТЧ))
		ИЛИ НЕ ПустаяСтрока(НайтиИмяБезУчетаРегистра(ДанныеТЧ.standard_names, ИмяТЧ)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СформироватьДиагностикуPreFlightТабличнойЧасти(
		Привязка.full_name, ИмяТЧ, ДанныеТЧ, ДанныеТЧ.cache_hit);

КонецФункции

// F-02/F-03. Проверяется только первый сегмент пути после псевдонима: глубокое
// разыменование (Т.Ссылка.Дата) требует резолва типов и вне объёма.
Функция ПроверитьПоляПривязки(Привязка, ОчищенныйТекст, КешДиагностики)

	Если Привязка.resolution <> "object_table" И Привязка.resolution <> "tabular_part" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяТЧ = ?(Привязка.resolution = "tabular_part", Привязка.third_segment, "");
	Набор = НаборПолейТаблицыКэшированный(Привязка.full_name, ИмяТЧ, КешДиагностики);
	Если НЕ Набор.supported ИЛИ Набор.fields.Количество() = 0 Тогда
		// Вид не покрыт оракулом (регистр бухгалтерии, регистр расчёта,
		// перечисление, стандартная табличная часть) — проверку не выполняем.
		Возврат Неопределено;
	КонецЕсли;

	Алиасы = Новый Массив;
	Алиасы.Добавить(Привязка.alias);
	АдресованныеПоля = ПоляАдресованныеИсточникуВТ(ОчищенныйТекст, Алиасы);

	Для Каждого Поле Из АдресованныеПоля Цикл
		Если ПолеГарантированоПлатформой(Привязка, Поле) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПолеЕстьВНаборе(Поле, Набор.fields) Тогда
			Возврат СформироватьДиагностикуPreFlightПоляТаблицы(Привязка, Поле, Набор);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Поля, существование которых гарантировано платформой для данной формы таблицы,
// независимо от того, что вернула интроспекция. Инвариант обязан проверяться в точке
// решения об отказе, а не только наполнять оракул: иначе любой сбой или расхождение
// в источнике набора превращается в ложный отказ валидного запроса (NF-02).
//
// Таблица табличной части всегда имеет Ссылка и НомерСтроки, но в ТЧ.Реквизиты их нет.
Функция ПолеГарантированоПлатформой(Привязка, Поле)

	Если Привязка.resolution <> "tabular_part" Тогда
		Возврат Ложь;
	КонецЕсли;
	ВерхПоле = ВРег(СокрЛП(Строка(Поле)));
	Возврат ВерхПоле = "ССЫЛКА" ИЛИ ВерхПоле = "НОМЕРСТРОКИ";

КонецФункции

Функция СформироватьДиагностикуPreFlightТабличнойЧасти(ПолноеИмя, ИмяТЧ, ДанныеТЧ, CacheHit)

	ИсточникТаблица = ПолноеИмя + "." + ИмяТЧ;
	ДоступныеТЧ = Новый Массив;
	Для Каждого Имя Из ДанныеТЧ.names Цикл
		ДоступныеТЧ.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из ДанныеТЧ.standard_names Цикл
		ДоступныеТЧ.Добавить(Имя);
	КонецЦикла;

	Варианты = ВариантыПохожихПолей(ИмяТЧ, ДоступныеТЧ, 3);
	Подсказка = "Табличная часть '" + ИмяТЧ + "' не существует у объекта " + ПолноеИмя
		+ ". Доступные табличные части: " + СтрСоединить(ДоступныеТЧ, ", ") + ".";
	Если Варианты.Количество() > 0 Тогда
		Подсказка = Подсказка + " Возможная замена: " + СтрСоединить(Варианты, " или ") + ".";
	КонецЕсли;

	Suggestions = Новый Массив;
	Suggestions.Добавить("Источник отклонён до выполнения (движок 1С не вызывался)."
		+ " Используйте одну из available_tabular_parts или вызовите get_metadata_structure"
		+ " для объекта " + ПолноеИмя + ".");

	Результат = Новый Структура;
	Результат.Вставить("kind", "pre_flight_tabular_part");
	Результат.Вставить("error_code", "tabular_part_not_found");
	Результат.Вставить("error", "tabular_part_not_found");
	Результат.Вставить("object", ПолноеИмя);
	Результат.Вставить("tabular_part", ИмяТЧ);
	Результат.Вставить("source_table", ИсточникТаблица);
	Результат.Вставить("available_tabular_parts", ДоступныеТЧ);
	Результат.Вставить("did_you_mean", Варианты);
	Результат.Вставить("hint", Подсказка);
	Результат.Вставить("see_also", ПолноеИмя);
	Результат.Вставить("suggestions", Suggestions);
	ЗаписатьЛогPreFlightИсточника("tabular_part", ИсточникТаблица, ИмяТЧ, CacheHit);
	Возврат Результат;

КонецФункции

Функция СформироватьДиагностикуPreFlightПоляТаблицы(Привязка, ИмяПоля, Набор)

	// did_you_mean считается по ПОЛНОМУ разрешённому набору, а не по усечённому
	// списку для показа: иначе кандидат-исправление не находится, когда реальное
	// поле не попало в срез (DEF-02).
	ПолныйНаборПолей = Набор.public_fields;
	Варианты = ВариантыПохожихПолей(ИмяПоля, ПолныйНаборПолей, 3);
	ПубличныеПоля = ОграничитьСписокПолейДляПоказа(ПолныйНаборПолей);
	ЭтоКонстанта = (Набор.table_kind = "Константа");

	Если ЭтоКонстанта Тогда
		// F-03: правило платформенное и стопроцентное, поэтому подсказка фиксированная.
		ИсточникПолей = "constant";
		Подсказка = "У таблицы константы единственное содержательное поле — Значение."
			+ " Используйте " + Привязка.alias + ".Значение.";
	Иначе
		ИсточникПолей = ?(Привязка.resolution = "tabular_part", "tabular_part", "metadata_object");
		Подсказка = "Поле '" + ИмяПоля + "' не существует в таблице " + Привязка.source_table + ".";
		Если ПубличныеПоля.Количество() > 0 Тогда
			Подсказка = Подсказка + " Доступные поля: " + СтрСоединить(ПубличныеПоля, ", ") + ".";
		КонецЕсли;
		Если Варианты.Количество() > 0 Тогда
			Подсказка = Подсказка + " Возможная замена: " + СтрСоединить(Варианты, " или ") + ".";
		КонецЕсли;
	КонецЕсли;

	ОписаниеПолей = Новый Структура;
	ОписаниеПолей.Вставить("type", Привязка.source_table);
	ОписаниеПолей.Вставить("fields", ПубличныеПоля);
	ОписаниеПолей.Вставить("tabular_sections", Новый Массив);
	Sample = Новый Массив;
	Sample.Добавить(ОписаниеПолей);

	Suggestions = Новый Массив;
	Suggestions.Добавить("Поле отклонено до выполнения (движок 1С не вызывался)."
		+ " Используйте одно из available_fields или вызовите get_metadata_structure"
		+ " для источника " + Привязка.source_table + ".");

	Результат = Новый Структура;
	Результат.Вставить("kind", ?(ЭтоКонстанта, "pre_flight_constant_field", "pre_flight_object_field"));
	Результат.Вставить("error_code", "field_not_found");
	Результат.Вставить("error", "field_not_found");
	Результат.Вставить("alias", Привязка.alias);
	Результат.Вставить("field", ИмяПоля);
	Результат.Вставить("field_path", Привязка.alias + "." + ИмяПоля);
	Результат.Вставить("object", Привязка.full_name);
	Результат.Вставить("source_table", Привязка.source_table);
	Результат.Вставить("available_fields", ПубличныеПоля);
	Результат.Вставить("available_fields_source", ИсточникПолей);
	Результат.Вставить("available_fields_sample", Sample);
	Результат.Вставить("available_fields_total", ПолныйНаборПолей.Количество());
	Результат.Вставить("available_fields_truncated",
		ПубличныеПоля.Количество() < ПолныйНаборПолей.Количество());
	Результат.Вставить("did_you_mean", Варианты);
	Результат.Вставить("hint", Подсказка);
	Результат.Вставить("see_also", Привязка.source_table);
	Результат.Вставить("suggestions", Suggestions);
	ЗаписатьЛогPreFlightИсточника("field", Привязка.source_table, ИмяПоля, Набор.cache_hit);
	Возврат Результат;

КонецФункции

Функция СообщениеОтказаPreFlightИсточника(Диагностика)

	КодДиагностики = "";
	Если НЕ Диагностика.Свойство("error_code", КодДиагностики) Тогда
		Возврат "Запрос отклонён до выполнения.";
	КонецЕсли;
	Если КодДиагностики = "tabular_part_not_found" Тогда
		Возврат "Запрос отклонён до выполнения: табличная часть не существует.";
	КонецЕсли;
	Возврат "Запрос отклонён до выполнения: поле таблицы не существует.";

КонецФункции

// Усечение списка полей только для показа в ответе. Порядок пришёл из метаданных,
// поэтому срез сохраняет содержательные поля, а не случайные. Предел — защита от
// разбухания ответа на очень широких объектах, а не оракул: проверка существования
// и did_you_mean работают по полному набору.
Функция ОграничитьСписокПолейДляПоказа(Поля)

	Предел = 80;
	Если Поля.Количество() <= Предел Тогда
		Возврат Поля;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Имя Из Поля Цикл
		Если Результат.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаписатьЛогPreFlightИсточника(ВидПроверки, ИсточникТаблица, Имя, CacheHit)

	Попытка
		ДанныеЛога = Новый Структура;
		ДанныеЛога.Вставить("cr_id", "TZ-preflight-source");
		ДанныеЛога.Вставить("check", ВидПроверки);
		ДанныеЛога.Вставить("source_table", ИсточникТаблица);
		ДанныеЛога.Вставить("name", Строка(Имя));
		ДанныеЛога.Вставить("cache_hit", CacheHit);
		ЗаписьЖурналаРегистрации("MCP.query.preflight_source_field_rejected",
			УровеньЖурналаРегистрации.Информация, , ,
			MCP_JSONRPC.СохранитьJSON(ДанныеЛога));
	Исключение
	КонецПопытки;

КонецПроцедуры

// ====================================================================
// Pre-flight валидация полей виртуальных таблиц (до Запрос.Выполнить()).
// Возвращает Неопределено, если блокировать нечего (полей нет, источник-ВТ не
// найден, либо схема ВТ не верифицирована — деградация F-04 с warning в
// Валидация.warnings). Возвращает структуру-диагностику при доказанно
// отсутствующем поле — вызывающая сторона возбуждает validation_failed_before_run.
// ====================================================================
Функция ПроверитьПоляВиртуальныхТаблицПередВыполнением(ТекстЗапроса, Валидация, КешДиагностики) Экспорт

	ОчищенныйТекст = ТекстБезСтрокИКомментариев(ТекстЗапроса);
	Источники = НайтиИсточникиЗапроса(ОчищенныйТекст);

	// F4-fix: неквалифицированные поля (без алиаса) проверяем ТОЛЬКО когда запрос —
	// один простой ВЫБРАТЬ с единственным источником (нет подзапросов/ОБЪЕДИНИТЬ/пакетов).
	// Тогда поле в списке ВЫБРАТЬ однозначно принадлежит этой ВТ. При любой неоднозначности
	// (JOIN, подзапросы, несколько ВЫБРАТЬ) неквалифицированные поля не трогаем — запрос
	// уходит на движок (сохраняется гарантия «ноль ложных отказов»).
	ПроверятьНеквалифицированные = (Источники.Количество() = 1) И ЕдинственныйВыборВЗапросе(ОчищенныйТекст);

	Для Каждого Источник Из Источники Цикл
		Если ПустаяСтрока(Источник.full_name) Тогда
			Продолжить;
		КонецЕсли;
		ИмяВТ = ИмяВиртуальнойТаблицыИзRaw(Источник.raw);
		Если ПустаяСтрока(ИмяВТ) Тогда
			Продолжить;
		КонецЕсли;

		Набор = ПолныйНаборПолейВиртуальнойТаблицыКэшированный(Источник.full_name, ИмяВТ, КешДиагностики);
		Если НЕ Набор.supported Тогда
			// F-04: вид регистра/ВТ не покрыт правилами — не отклоняем, только предупреждаем.
			Если Валидация <> Неопределено Тогда
				Валидация.warnings.Добавить(
					"Схема виртуальной таблицы " + Источник.full_name + "." + ИмяВТ
					+ " не верифицирована (" + Набор.reason
					+ "); pre-flight проверка полей пропущена, запрос отправлен на движок.");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ПоляВТ = Набор.fields;
		Если ПоляВТ.Количество() = 0 Тогда
			// Пустой набор не используем как оракул отклонения.
			Продолжить;
		КонецЕсли;

		// F7: псевдоним ищется только в тех командах пакета, где объявлен сам источник.
		// Раньше и псевдонимы, и обращения к полям искались по всему тексту пакета, из-за
		// чего переиспользование имени псевдонима в следующей команде приписывалось
		// исходной ВТ и давало ложный validation_failed_before_run. Пример: первая
		// команда читает ОстаткиИОбороты КАК Данные и кладёт результат в ВТ, вторая
		// читает эту ВТ тоже КАК Данные и выбирает Данные.Месяц — поля Месяц у
		// ОстаткиИОбороты нет, и запрос отклонялся, хотя он корректен.
		Области = КомандыПакетаСИсточником(ОчищенныйТекст, Источник.raw);
		Если Области.Количество() = 0 Тогда
			// Границы команды доказать не удалось. Пропускаем проверку этого обращения:
			// возврат к поиску по всему пакету означал бы возврат дефекта, а ложный
			// отказ хуже пропуска (то же правило, что у F4).
			Если Валидация <> Неопределено Тогда
				Валидация.warnings.Добавить(
					"Не удалось определить границы команды для источника " + Источник.raw
					+ "; pre-flight проверка полей этой виртуальной таблицы пропущена.");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		АдресованныеПоля = Новый Массив;
		Для Каждого Область Из Области Цикл
			Алиасы = АлиасыИсточникаВиртуальнойТаблицы(Область, Источник.raw);
			Алиасы.Добавить(Источник.raw);
			Для Каждого ПолеОбласти Из ПоляАдресованныеИсточникуВТ(Область, Алиасы) Цикл
				АдресованныеПоля.Добавить(ПолеОбласти);
			КонецЦикла;
		КонецЦикла;

		// F4-fix: при единственном источнике-ВТ добавляем неквалифицированные поля
		// из списка ВЫБРАТЬ. Экстрактор консервативен: неуверенные токены не попадают
		// в список (см. НеквалифицированныеПоляСпискаВыбора), поэтому запрос не падает
		// из-за самой проверки.
		Если ПроверятьНеквалифицированные Тогда
			Для Каждого НеквПоле Из НеквалифицированныеПоляСпискаВыбора(ОчищенныйТекст) Цикл
				АдресованныеПоля.Добавить(НеквПоле);
			КонецЦикла;
		КонецЕсли;

		Для Каждого Поле Из АдресованныеПоля Цикл
			Если НЕ ПолеЕстьВНаборе(Поле, ПоляВТ) Тогда
				Возврат СформироватьДиагностикуPreFlightВТ(
					Источник.full_name, ИмяВТ, Поле, ПоляВТ, Набор.cache_hit);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// F4-fix: Истина, если в тексте ровно один ВЫБРАТЬ/SELECT (нет подзапросов, ОБЪЕДИНИТЬ,
// пакетов из нескольких ВЫБРАТЬ). Признак «простого» запроса, где список ВЫБРАТЬ
// относится к единственному источнику.
Функция ЕдинственныйВыборВЗапросе(ОчищенныйТекст)

	Количество = 0;
	Для Каждого Токен Из ЛексемыИсточников(ОчищенныйТекст) Цикл
		ТокенВРег = ВРег(СокрЛП(Токен));
		Если ТокенВРег = "ВЫБРАТЬ" ИЛИ ТокенВРег = "SELECT" Тогда
			Количество = Количество + 1;
			Если Количество > 1 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество = 1;

КонецФункции

// F4-fix: извлекает из списка ВЫБРАТЬ имена полей, записанных БЕЗ алиаса.
// Возвращает только «чистые» одиночные идентификаторы-поля; всё, что нельзя уверенно
// признать полем (функции/агрегаты, выражения, разыменование Алиас.Поле, параметры &X,
// выходные алиасы после КАК, литералы, ключевые слова), намеренно пропускается.
Функция НеквалифицированныеПоляСпискаВыбора(ОчищенныйТекст)

	Результат = Новый Массив;
	Лексемы = ЛексемыИсточников(ОчищенныйТекст);

	ИндексВыбрать = -1;
	Для Индекс = 0 По Лексемы.Количество() - 1 Цикл
		Т = ВРег(СокрЛП(Лексемы[Индекс]));
		Если Т = "ВЫБРАТЬ" ИЛИ Т = "SELECT" Тогда
			ИндексВыбрать = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИндексВыбрать < 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Собираем элементы списка ВЫБРАТЬ: токены до ИЗ/FROM на глубине 0, разбитые
	// запятыми глубины 0 (запятые/скобки внутри выражений не разрывают элемент).
	Элементы = Новый Массив;
	Текущий = Новый Массив;
	Глубина = 0;
	Индекс = ИндексВыбрать + 1;
	Пока Индекс < Лексемы.Количество() Цикл
		Токен = Лексемы[Индекс];
		ТокенВРег = ВРег(СокрЛП(Токен));
		Если Токен = "(" Тогда
			Глубина = Глубина + 1;
			Текущий.Добавить(Токен);
		ИначеЕсли Токен = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Текущий.Добавить(Токен);
		ИначеЕсли Глубина = 0 И (ТокенВРег = "ИЗ" ИЛИ ТокенВРег = "FROM") Тогда
			Прервать;
		ИначеЕсли Глубина = 0 И Токен = "," Тогда
			Элементы.Добавить(Текущий);
			Текущий = Новый Массив;
		Иначе
			Текущий.Добавить(Токен);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Элементы.Добавить(Текущий);

	Первый = Истина;
	Для Каждого Элемент Из Элементы Цикл
		Токены = Элемент;
		Если Первый Тогда
			Токены = БезВедущихМодификаторовВыбора(Токены);
			Первый = Ложь;
		КонецЕсли;
		ИмяПоля = ИдентификаторПоляЭлементаВыбора(Токены);
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			Результат.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Убирает ведущие модификаторы списка ВЫБРАТЬ: РАЗЛИЧНЫЕ/DISTINCT, РАЗРЕШЕННЫЕ/ALLOWED,
// ПЕРВЫЕ N / TOP N. Возвращает массив токенов без них.
Функция БезВедущихМодификаторовВыбора(Токены)

	Старт = 0;
	Пока Старт < Токены.Количество() Цикл
		Т = ВРег(СокрЛП(Токены[Старт]));
		Если Т = "РАЗЛИЧНЫЕ" ИЛИ Т = "DISTINCT" ИЛИ Т = "РАЗРЕШЕННЫЕ" ИЛИ Т = "ALLOWED" Тогда
			Старт = Старт + 1;
		ИначеЕсли Т = "ПЕРВЫЕ" ИЛИ Т = "TOP" Тогда
			Старт = Старт + 1;
			Если Старт < Токены.Количество() И ЭтоЧисловойТокен(Токены[Старт]) Тогда
				Старт = Старт + 1;
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Индекс = Старт По Токены.Количество() - 1 Цикл
		Результат.Добавить(Токены[Индекс]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает имя поля из элемента списка ВЫБРАТЬ, если элемент — ровно один «чистый»
// идентификатор-поле (до КАК/AS). Иначе возвращает пустую строку (skip-on-uncertainty).
Функция ИдентификаторПоляЭлементаВыбора(Токены)

	ЗначимыеТокены = Новый Массив;
	Для Каждого Токен Из Токены Цикл
		Ток = СокрЛП(Токен);
		Если ПустаяСтрока(Ток) Тогда
			Продолжить;
		КонецЕсли;
		Верх = ВРег(Ток);
		Если Верх = "КАК" ИЛИ Верх = "AS" Тогда
			Прервать;
		КонецЕсли;
		ЗначимыеТокены.Добавить(Ток);
	КонецЦикла;

	Если ЗначимыеТокены.Количество() <> 1 Тогда
		Возврат "";
	КонецЕсли;
	Кандидат = ЗначимыеТокены[0];
	Если ЧистыйИдентификаторПоля(Кандидат) Тогда
		Возврат Кандидат;
	КонецЕсли;
	Возврат "";

КонецФункции

// Истина, если токен — «чистое» имя поля: только символы идентификатора (нет точки,
// скобок, операторов, &, %), не чисто числовой литерал и не ключевое слово.
Функция ЧистыйИдентификаторПоля(Токен)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	ЕстьБуква = Ложь;
	Для Индекс = 1 По СтрДлина(Токен) Цикл
		С = Сред(Токен, Индекс, 1);
		Если НЕ ЯвляетсяСимволомИдентификатора(С) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ЭтоЦифра(С) Тогда
			ЕстьБуква = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьБуква Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ТокенЯвляетсяКлючевымСловомВыбора(ВРег(Токен));

КонецФункции

// Небольшой стоп-список ключевых слов/литералов, которые могут встретиться
// одиночным токеном в списке ВЫБРАТЬ и не являются полями.
Функция ТокенЯвляетсяКлючевымСловомВыбора(ТокенВРег)

	Возврат ТокенВРег = "ИСТИНА" ИЛИ ТокенВРег = "TRUE"
		ИЛИ ТокенВРег = "ЛОЖЬ" ИЛИ ТокенВРег = "FALSE"
		ИЛИ ТокенВРег = "NULL" ИЛИ ТокенВРег = "НЕОПРЕДЕЛЕНО" ИЛИ ТокенВРег = "UNDEFINED"
		ИЛИ ТокенВРег = "ВЫБОР" ИЛИ ТокенВРег = "CASE"
		ИЛИ ТокенВРег = "КОГДА" ИЛИ ТокенВРег = "WHEN"
		ИЛИ ТокенВРег = "ТОГДА" ИЛИ ТокенВРег = "THEN"
		ИЛИ ТокенВРег = "ИНАЧЕ" ИЛИ ТокенВРег = "ELSE"
		ИЛИ ТокенВРег = "КОНЕЦ" ИЛИ ТокенВРег = "END"
		ИЛИ ТокенВРег = "И" ИЛИ ТокенВРег = "AND"
		ИЛИ ТокенВРег = "ИЛИ" ИЛИ ТокенВРег = "OR"
		ИЛИ ТокенВРег = "НЕ" ИЛИ ТокенВРег = "NOT"
		ИЛИ ТокенВРег = "ЕСТЬ" ИЛИ ТокенВРег = "IS"
		ИЛИ ТокенВРег = "ПЕРВЫЕ" ИЛИ ТокенВРег = "TOP"
		ИЛИ ТокенВРег = "РАЗЛИЧНЫЕ" ИЛИ ТокенВРег = "DISTINCT"
		ИЛИ ТокенВРег = "РАЗРЕШЕННЫЕ" ИЛИ ТокенВРег = "ALLOWED"
		ИЛИ ТокенВРег = "КАК" ИЛИ ТокенВРег = "AS";

КонецФункции

// Истина, если токен состоит только из цифр (числовой литерал).
Функция ЭтоЧисловойТокен(Токен)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Токен) Цикл
		Если НЕ ЭтоЦифра(Сред(Токен, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Кеш полного набора полей ВТ на время одного запроса (A-03). Ключ vt_fields_full:<имя>.<вт>.
Функция ПолныйНаборПолейВиртуальнойТаблицыКэшированный(ПолноеИмя, ИмяВТ, КешДиагностики) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("reason", "");
	Результат.Вставить("cache_hit", Ложь);

	Если ПустаяСтрока(ПолноеИмя) ИЛИ НЕ MCP_Security.ТипРазрешен(ПолноеИмя) Тогда
		Результат.reason = "type_not_allowed";
		Возврат Результат;
	КонецЕсли;

	КлючКеша = "vt_fields_full:" + НРег(ПолноеИмя) + "." + НРег(Строка(ИмяВТ));
	Если КешДиагностики <> Неопределено Тогда
		Кешированное = КешДиагностики.Получить(КлючКеша);
		Если Кешированное <> Неопределено Тогда
			Результат.supported = Кешированное.supported;
			Результат.fields = Кешированное.fields;
			Результат.reason = Кешированное.reason;
			Результат.cache_hit = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Набор = MCP_Metadata.ПолныйНаборПолейВиртуальнойТаблицы(ПолноеИмя, ИмяВТ);
	Результат.supported = Набор.supported;
	Результат.fields = Набор.fields;
	Результат.reason = Набор.reason;

	Если КешДиагностики <> Неопределено Тогда
		Снимок = Новый Структура;
		Снимок.Вставить("supported", Набор.supported);
		Снимок.Вставить("fields", Набор.fields);
		Снимок.Вставить("reason", Набор.reason);
		КешДиагностики.Вставить(КлючКеша, Снимок);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Извлекает имена полей, адресованных НАПРЯМУЮ источнику-ВТ через его алиасы
// (берётся только первый сегмент после точки: Алиас.Поле[.Разыменование]).
// Поля внутри скобок-параметров ВТ не попадают сюда (алиас вводится после
// закрывающей скобки), поэтому F-06 (vt_param_field_error) не дублируется.
// Команды пакета: текст делится по «;» на нулевой глубине скобок. Литералы и
// комментарии из текста уже вычищены вызывающей стороной, поэтому «;» внутри строки
// сюда не попадает.
//
// Отдельная функция, а не изменение НайтиИсточникиЗапроса: у той контракт с
// дедупликацией источников, и на неё опираются проверки безопасности — менять его
// ради области видимости псевдонима нельзя.
Функция КомандыПакета(ОчищенныйТекст)

	Результат = Новый Массив;
	Глубина = 0;
	Начало = 1;
	Для Индекс = 1 По СтрДлина(ОчищенныйТекст) Цикл
		Символ = Сред(ОчищенныйТекст, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
		ИначеЕсли Символ = ";" И Глубина = 0 Тогда
			Результат.Добавить(Сред(ОчищенныйТекст, Начало, Индекс - Начало));
			Начало = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Начало <= СтрДлина(ОчищенныйТекст) Тогда
		Результат.Добавить(Сред(ОчищенныйТекст, Начало));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Команды, в которых объявлен сам источник. Именно их текст и есть область, где
// псевдоним источника действует: за пределами своей команды одноимённый псевдоним
// относится к другому источнику.
Функция КомандыПакетаСИсточником(ОчищенныйТекст, RawИсточника)

	Результат = Новый Массив;
	Если ПустаяСтрока(RawИсточника) Тогда
		Возврат Результат;
	КонецЕсли;

	ИскомыйВРег = ВРег(СокрЛП(RawИсточника));
	Для Каждого Команда Из КомандыПакета(ОчищенныйТекст) Цикл
		Если СтрНайти(ВРег(Команда), ИскомыйВРег) > 0 Тогда
			Результат.Добавить(Команда);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоляАдресованныеИсточникуВТ(ОчищенныйТекст, Алиасы)

	Результат = Новый Массив;
	Найдено = Новый Соответствие;
	Для Каждого Алиас Из Алиасы Цикл
		Если ПустаяСтрока(Алиас) Тогда
			Продолжить;
		КонецЕсли;
		ИзвлечьПоляПоАлиасу(ОчищенныйТекст, Алиас, Результат, Найдено);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Алиас источника-ВТ с учётом списка параметров: <источник>(...) [КАК] <алиас>.
// Базовая АлиасыИсточника не пропускает группу (...) и теряет алиас ВТ.
Функция АлиасыИсточникаВиртуальнойТаблицы(ОчищенныйТекст, ИмяИсточника)

	Результат = Новый Массив;
	Лексемы = ЛексемыИсточников(ОчищенныйТекст);
	Для Индекс = 0 По Лексемы.Количество() - 1 Цикл
		Если ВРег(Лексемы[Индекс]) <> ВРег(ИмяИсточника) Тогда
			Продолжить;
		КонецЕсли;
		СледИндекс = Индекс + 1;

		// Пропускаем сбалансированную группу параметров виртуальной таблицы (...).
		Если СледИндекс < Лексемы.Количество() И Лексемы[СледИндекс] = "(" Тогда
			Глубина = 0;
			Пока СледИндекс < Лексемы.Количество() Цикл
				Если Лексемы[СледИндекс] = "(" Тогда
					Глубина = Глубина + 1;
				ИначеЕсли Лексемы[СледИндекс] = ")" Тогда
					Глубина = Глубина - 1;
					Если Глубина = 0 Тогда
						СледИндекс = СледИндекс + 1;
						Прервать;
					КонецЕсли;
				КонецЕсли;
				СледИндекс = СледИндекс + 1;
			КонецЦикла;
		КонецЕсли;

		// Необязательное КАК/AS.
		Если СледИндекс < Лексемы.Количество()
			И (ВРег(Лексемы[СледИндекс]) = "КАК" ИЛИ ВРег(Лексемы[СледИндекс]) = "AS") Тогда
			СледИндекс = СледИндекс + 1;
		КонецЕсли;

		Если СледИндекс < Лексемы.Количество() Тогда
			Кандидат = Лексемы[СледИндекс];
			Если ВыглядитКакАлиасИсточника(Кандидат) Тогда
				Результат.Добавить(Кандидат);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ИзвлечьПоляПоАлиасу(Текст, Алиас, Результат, Найдено)

	АлиасДлина = СтрДлина(Алиас);
	Если АлиасДлина = 0 Тогда
		Возврат;
	КонецЕсли;
	ВерхТекст = ВРег(Текст);
	Шаблон = ВРег(Алиас) + ".";
	ПозицияПоиска = 1;

	Пока Истина Цикл
		Поз = НайтиСПозицииPrivacy(ВерхТекст, Шаблон, ПозицияПоиска);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияПоиска = Поз + АлиасДлина + 1;

		// Левая граница: символ перед алиасом не должен быть частью другого идентификатора
		// или хвостом разыменования (например, Рег.Период не считается алиасом "Период").
		Пропустить = Ложь;
		Если Поз > 1 Тогда
			ПредСимвол = Сред(Текст, Поз - 1, 1);
			Если ЯвляетсяСимволомИдентификатора(ПредСимвол)
				ИЛИ ПредСимвол = "."
				ИЛИ ПредСимвол = "&" Тогда
				Пропустить = Истина;
			ИначеЕсли ПредшествуетКлючевоеСловоКАК(Текст, Поз) Тогда
				// ВЫРАЗИТЬ(... КАК Справочник.Организации), ССЫЛКА Справочник.X:
				// это указание типа, а не обращение к полю по псевдониму.
				Пропустить = Истина;
			КонецЕсли;
		КонецЕсли;

		Если НЕ Пропустить Тогда
			ИмяПоля = ПрочитатьИдентификатор(Текст, Поз + АлиасДлина + 1);
			Если НЕ ПустаяСтрока(ИмяПоля) Тогда
				Ключ = ВРег(ИмяПоля);
				Если Найдено.Получить(Ключ) = Неопределено Тогда
					Найдено.Вставить(Ключ, Истина);
					Результат.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Истина, если непосредственно перед позицией стоит ключевое слово КАК/AS.
// Отсекает указания типа от обращений к полям по псевдониму.
Функция ПредшествуетКлючевоеСловоКАК(Текст, Поз)

	Индекс = Поз - 1;
	Пока Индекс >= 1 Цикл
		С = Сред(Текст, Индекс, 1);
		Если С = " " ИЛИ С = Символы.ПС ИЛИ С = Символы.ВК ИЛИ С = Символы.Таб Тогда
			Индекс = Индекс - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Индекс < 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Слово = "";
	Пока Индекс >= 1 Цикл
		С = Сред(Текст, Индекс, 1);
		Если ЯвляетсяСимволомИдентификатора(С) Тогда
			Слово = С + Слово;
			Индекс = Индекс - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ВРег(Слово) = "КАК" ИЛИ ВРег(Слово) = "AS";

КонецФункции

Функция ПрочитатьИдентификатор(Текст, Начало)

	Результат = "";
	Поз = Начало;
	Длина = СтрДлина(Текст);
	Пока Поз <= Длина Цикл
		С = Сред(Текст, Поз, 1);
		Если ЯвляетсяСимволомИдентификатора(С) Тогда
			Результат = Результат + С;
			Поз = Поз + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Единая нормализация имени поля ВТ для проверки принадлежности и генерации подсказок.
// ОБЯЗАНА совпадать с ключеванием набора в MCP_Metadata.ДобавитьПолеВНабор (ВРег ∘ СокрЛП),
// иначе проверка «поле есть в наборе» и список available_fields расходятся, и валидатор
// может отклонить поле, которое сам же перечисляет как доступное (см. отчёт 2026-07-16 по
// ОстаткиИОбороты.СуммаРазвернутыйКонечныйОстатокДт). Одна функция — один инвариант.
Функция НормализованныйКлючПоля(Значение)

	Возврат ВРег(СокрЛП(Строка(Значение)));

КонецФункции

Функция ПолеЕстьВНаборе(Поле, ПоляВТ)

	КлючПоля = НормализованныйКлючПоля(Поле);
	Для Каждого Кандидат Из ПоляВТ Цикл
		Если НормализованныйКлючПоля(Кандидат) = КлючПоля Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СформироватьДиагностикуPreFlightВТ(ПолноеИмяРегистра, ИмяВТ, ИмяПоля, ПоляВТ, CacheHit)

	ИсточникТаблица = ПолноеИмяРегистра + "." + ИмяВТ;

	ОписаниеПолей = Новый Структура;
	ОписаниеПолей.Вставить("type", ИсточникТаблица);
	ОписаниеПолей.Вставить("fields", ПоляВТ);
	ОписаниеПолей.Вставить("tabular_sections", Новый Массив);
	Sample = Новый Массив;
	Sample.Добавить(ОписаниеПолей);

	Suggestions = Новый Массив;
	Suggestions.Добавить("Поле отклонено до выполнения (движок 1С не вызывался). Используйте одно из available_fields"
		+ " или вызовите get_metadata_structure для источника " + ИсточникТаблица + ".");

	Результат = Новый Структура;
	Результат.Вставить("kind", "pre_flight_virtual_table_field");
	Результат.Вставить("error_code", "validation_failed_before_run");
	Результат.Вставить("error", "validation_failed_before_run");
	Результат.Вставить("field", ?(ПустаяСтрока(ИмяПоля), Null, ИмяПоля));
	Результат.Вставить("field_path", ?(ПустаяСтрока(ИмяПоля), Null, ИмяПоля));
	Результат.Вставить("object", ПолноеИмяРегистра);
	Результат.Вставить("source_table", ИсточникТаблица);
	Результат.Вставить("available_fields", ПоляВТ);
	Результат.Вставить("available_fields_source", "virtual_table");
	Результат.Вставить("available_fields_sample", Sample);
	Результат.Вставить("hint", ПодсказкаЗаменыПоляВиртуальнойТаблицы(ИмяПоля, ПолноеИмяРегистра, ИмяВТ, ПоляВТ));
	Результат.Вставить("see_also", ИсточникТаблица);
	Результат.Вставить("suggestions", Suggestions);
	ЗаписатьЛогPreFlightВТ(ПолноеИмяРегистра, ИмяВТ, ИмяПоля, CacheHit);
	Возврат Результат;

КонецФункции

Процедура ЗаписатьЛогPreFlightВТ(ПолноеИмяРегистра, ИмяВТ, ИмяПоля, CacheHit)

	Попытка
		ДанныеЛога = Новый Структура;
		ДанныеЛога.Вставить("cr_id", "TZ-preflight-vt");
		ДанныеЛога.Вставить("register", ПолноеИмяРегистра);
		ДанныеЛога.Вставить("virtual_table", ИмяВТ);
		ДанныеЛога.Вставить("field", Строка(ИмяПоля));
		ДанныеЛога.Вставить("cache_hit", CacheHit);
		ЗаписьЖурналаРегистрации("MCP.query.preflight_vt_field_rejected",
			УровеньЖурналаРегистрации.Информация, , ,
			MCP_JSONRPC.СохранитьJSON(ДанныеЛога));
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция НайтиИсточникВиртуальнойТаблицыВЗапросе(ТекстЗапроса)

	Источники = НайтиИсточникиЗапроса(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	Для Каждого Источник Из Источники Цикл
		Если ПустаяСтрока(Источник.full_name) Тогда
			Продолжить;
		КонецЕсли;
		ИмяВТ = ИмяВиртуальнойТаблицыИзRaw(Источник.raw);
		Если ПустаяСтрока(ИмяВТ) Тогда
			Продолжить;
		КонецЕсли;
		Результат = Новый Структура;
		Результат.Вставить("source_table", Источник.full_name + "." + ИмяВТ);
		Результат.Вставить("object_name", Источник.full_name);
		Результат.Вставить("virtual_table", ИмяВТ);
		// raw — лексема как она стоит в тексте, вместе с суффиксом виртуальной таблицы.
		// Именно её ищет АлиасыИсточникаВиртуальнойТаблицы; object_name (без суффикса)
		// в тексте не встречается, и поиск псевдонимов по нему не находил ничего никогда.
		Результат.Вставить("raw", Источник.raw);
		Возврат Результат;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ИмяВиртуальнойТаблицыИзRaw(ИмяИсточника)

	Части = СтрРазделить(Строка(ИмяИсточника), ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;
	Кандидат = Части[Части.Количество() - 1];
	Верх = ВРег(Кандидат);
	Если Верх = "ОБОРОТЫ" Тогда Возврат "Обороты"; КонецЕсли;
	Если Верх = "ОБОРОТЫДТКТ" Тогда Возврат "ОборотыДтКт"; КонецЕсли;
	Если Верх = "ОСТАТКИ" Тогда Возврат "Остатки"; КонецЕсли;
	Если Верх = "ОСТАТКИИОБОРОТЫ" Тогда Возврат "ОстаткиИОбороты"; КонецЕсли;
	// ДвиженияССубконто распознаётся наравне с остальными: генератор состава полей
	// для неё есть (ветка добавлена в #81), но без записи здесь источник не считался
	// виртуальной таблицей вовсе — выход происходил до проверки набора, поэтому
	// pre-flight не работал и предупреждения о непокрытой схеме тоже не было.
	// Наблюдалось как отказ движка «Поле не найдено» вместо отказа до выполнения.
	Если Верх = "ДВИЖЕНИЯССУБКОНТО" Тогда Возврат "ДвиженияССубконто"; КонецЕсли;
	Если Верх = "СРЕЗПОСЛЕДНИХ" Тогда Возврат "СрезПоследних"; КонецЕсли;
	Если Верх = "СРЕЗПЕРВЫХ" Тогда Возврат "СрезПервых"; КонецЕсли;
	Возврат "";

КонецФункции

Функция ПоляВиртуальнойТаблицыДляДиагностики(ПолноеИмя, ИмяВТ, КешДиагностики)

	// Единый источник полей ВТ для pre-flight и post-error диагностики (F-07/F-08):
	// тот же генератор MCP_Metadata, тот же per-request кеш (A-03).
	Результат = Новый Структура;
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("cache_hit", Ложь);

	Набор = ПолныйНаборПолейВиртуальнойТаблицыКэшированный(ПолноеИмя, ИмяВТ, КешДиагностики);
	Если Набор.supported Тогда
		Результат.fields = Набор.fields;
	КонецЕсли;
	Результат.cache_hit = Набор.cache_hit;
	Возврат Результат;

КонецФункции

Функция ПодсказкаЗаменыПоляВиртуальнойТаблицы(ИмяПоля, ПолноеИмяРегистра, ИмяВТ, ПоляВТ)

	Подсказка = "Поле '" + ИмяПоля + "' не существует в виртуальной таблице " + ИмяВТ
		+ " регистра " + ПолноеИмяРегистра + ". Доступные поля: "
		+ СтрСоединить(ПоляВТ, ", ") + ".";
	Варианты = ВариантыПохожихПолей(ИмяПоля, ПоляВТ, 3);
	Если Варианты.Количество() > 0 Тогда
		Подсказка = Подсказка + " Возможная замена: " + СтрСоединить(Варианты, " или ") + ".";
	КонецЕсли;
	Возврат Подсказка;

КонецФункции

// F-05: ближайшие валидные имена для did_you_mean и текстовых подсказок.
//
// Кандидат попадает в список, только если расстояние Левенштейна <= 3 ЛИБО одно
// имя является подстрокой другого (правило подстроки ловит пару Тара →
// ВозвратнаяТара, которую расстояние не поймает). Заведомо далёкое имя даёт
// пустой список: ложная подсказка хуже отсутствия подсказки.
//
// Сравнение регистронезависимое — идентификаторы языка запросов 1С
// регистронезависимы. Порядок: префиксные совпадения, затем подстрочные, затем
// по расстоянию; внутри класса — по расстоянию и длине имени.
Функция ВариантыПохожихПолей(ИмяПоля, Поля, Максимум)

	Результат = Новый Массив;
	ВерхИмяПоля = НормализованныйКлючПоля(ИмяПоля);
	Если ПустаяСтрока(ВерхИмяПоля) Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ВерхПоле = НормализованныйКлючПоля(Поле);
		Если ПустаяСтрока(ВерхПоле) Тогда
			Продолжить;
		КонецЕсли;

		// Защита от само-противоречия: не предлагаем как «замену» поле, которое после
		// нормализации совпадает с отклонённым. Совпадение здесь означало бы, что
		// ПолеЕстьВНаборе обязано было вернуть Истину и отказа быть не должно, — общая
		// нормализация (НормализованныйКлючПоля) исключает такое расхождение, а guard
		// делает инвариант явным и локально проверяемым.
		Если ВерхПоле = ВерхИмяПоля Тогда
			Продолжить;
		КонецЕсли;

		ЕстьПрефикс = СтрНачинаетсяС(ВерхПоле, ВерхИмяПоля)
			ИЛИ СтрНачинаетсяС(ВерхИмяПоля, ВерхПоле);
		ЕстьПодстрока = ЕстьПрефикс
			ИЛИ СтрНайти(ВерхПоле, ВерхИмяПоля) > 0
			ИЛИ СтрНайти(ВерхИмяПоля, ВерхПоле) > 0;
		Расстояние = РасстояниеЛевенштейна(ВерхИмяПоля, ВерхПоле);
		Если НЕ (ЕстьПодстрока ИЛИ Расстояние <= 3) Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Новый Структура;
		Кандидат.Вставить("field", Поле);
		Кандидат.Вставить("distance", Расстояние);
		Кандидат.Вставить("rank", ?(ЕстьПрефикс, 0, ?(ЕстьПодстрока, 1, 2)));
		ДобавитьКандидатаПодсказки(Кандидаты, Кандидат, Максимум);
	КонецЦикла;

	Для Каждого Кандидат Из Кандидаты Цикл
		Результат.Добавить(Кандидат.field);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКандидатаПодсказки(Кандидаты, Кандидат, Максимум)

	Добавлено = Ложь;
	Если Кандидаты.Количество() > 0 Тогда
		Для Индекс = 0 По Кандидаты.Количество() - 1 Цикл
			Если КандидатПодсказкиЛучше(Кандидат, Кандидаты[Индекс]) Тогда
				Кандидаты.Вставить(Индекс, Кандидат);
				Добавлено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НЕ Добавлено Тогда
		Кандидаты.Добавить(Кандидат);
	КонецЕсли;
	Пока Кандидаты.Количество() > Максимум Цикл
		Кандидаты.Удалить(Кандидаты.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

Функция КандидатПодсказкиЛучше(Левый, Правый)

	Если Левый.rank <> Правый.rank Тогда
		Возврат Левый.rank < Правый.rank;
	КонецЕсли;
	Если Левый.distance <> Правый.distance Тогда
		Возврат Левый.distance < Правый.distance;
	КонецЕсли;
	Возврат СтрДлина(Строка(Левый.field)) < СтрДлина(Строка(Правый.field));

КонецФункции

Функция РасстояниеЛевенштейна(ЛевыйТекст, ПравыйТекст)

	ЛевыйТекст = Строка(ЛевыйТекст);
	ПравыйТекст = Строка(ПравыйТекст);
	ПредыдущаяСтрока = Новый Массив;
	Для Индекс = 0 По СтрДлина(ПравыйТекст) Цикл
		ПредыдущаяСтрока.Добавить(Индекс);
	КонецЦикла;

	Для ИндексЛевого = 1 По СтрДлина(ЛевыйТекст) Цикл
		ТекущаяСтрока = Новый Массив;
		ТекущаяСтрока.Добавить(ИндексЛевого);
		Для ИндексПравого = 1 По СтрДлина(ПравыйТекст) Цикл
			СтоимостьЗамены = ?(
				Сред(ЛевыйТекст, ИндексЛевого, 1) = Сред(ПравыйТекст, ИндексПравого, 1), 0, 1);
			Удаление = ПредыдущаяСтрока[ИндексПравого] + 1;
			Вставка = ТекущаяСтрока[ИндексПравого - 1] + 1;
			Замена = ПредыдущаяСтрока[ИндексПравого - 1] + СтоимостьЗамены;
			ТекущаяСтрока.Добавить(Мин(Удаление, Мин(Вставка, Замена)));
		КонецЦикла;
		ПредыдущаяСтрока = ТекущаяСтрока;
	КонецЦикла;

	Возврат ПредыдущаяСтрока[СтрДлина(ПравыйТекст)];

КонецФункции

Процедура ЗаписатьЛогCR01(ИсточникВТ, ИмяПоля, CacheHit, CorrelationID)

	Попытка
		ДанныеЛога = Новый Структура;
		ДанныеЛога.Вставить("cr_id", "CR-01");
		ДанныеЛога.Вставить("correlation_id", Строка(CorrelationID));
		ДанныеЛога.Вставить("register", ИсточникВТ.object_name);
		ДанныеЛога.Вставить("virtual_table", ИсточникВТ.virtual_table);
		ДанныеЛога.Вставить("field", Строка(ИмяПоля));
		ДанныеЛога.Вставить("cache_hit", CacheHit);
		ЗаписьЖурналаРегистрации("MCP.query.cr01_virtual_table_field",
			УровеньЖурналаРегистрации.Информация, , ,
			MCP_JSONRPC.СохранитьJSON(ДанныеЛога));
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ОбогатитьОшибкуРесурсаРегистраВГде(Результат, ИмяПоля, ПолноеПоле, ТекстЗапроса)

	Если НЕ РесурсБухгалтерскогоРегистраДляГде(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	Если НайтиИсточникВиртуальнойТаблицыВЗапросе(ТекстЗапроса) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ПолеИспользованоВСекцииГде(ТекстЗапроса, ИмяПоля, ПолноеПоле) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗапросЧитаетОсновнуюТаблицуБухгалтерскогоРегистра(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Результат.Вставить("error_code", "resource_field_in_where");
	Результат.Вставить("error", "resource_field_in_where");
	Результат.Вставить("message", "Поле '" + ИмяПоля + "' является ресурсом регистра бухгалтерии и не может использоваться в условии ГДЕ основной таблицы.");
	Результат.Вставить("hint", "Ресурсы регистра бухгалтерии не являются измерениями основной таблицы и недоступны для фильтрации в ГДЕ. Используйте ИМЕЮЩИЕ для агрегатов или вынесите фильтрацию во внешний запрос.");
	Результат.Вставить("fix_options", FixOptionsРесурсаРегистраВГде(ИмяПоля, ТекстЗапроса));
	Результат.Вставить("see_also", "query_guidance:grouping-and-having");

КонецПроцедуры

Функция РесурсБухгалтерскогоРегистраДляГде(ИмяПоля)

	Верх = ВРег(Строка(ИмяПоля));
	Возврат Верх = "СУММАПР"
		ИЛИ Верх = "СУММАВР"
		ИЛИ Верх = "СУММАНУ"
		ИЛИ Верх = "ВАЛЮТНАЯСУММА"
		ИЛИ Верх = "КОЛИЧЕСТВО";

КонецФункции

Функция ПолеИспользованоВСекцииГде(ТекстЗапроса, ИмяПоля, ПолноеПоле)

	Верх = ВРег(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	ПозицияГде = СтрНайти(Верх, "ГДЕ");
	Если ПозицияГде = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ПозицияКонцаГде = СтрДлина(Верх) + 1;
	Для Каждого КлючевоеСлово Из СтрРазделить("СГРУППИРОВАТЬ ПО,ИМЕЮЩИЕ,УПОРЯДОЧИТЬ ПО,ОБЪЕДИНИТЬ", ",", Истина) Цикл
		ПозицияКлюча = СтрНайти(Верх, КлючевоеСлово, , ПозицияГде + 1);
		Если ПозицияКлюча > 0 И ПозицияКлюча < ПозицияКонцаГде Тогда
			ПозицияКонцаГде = ПозицияКлюча;
		КонецЕсли;
	КонецЦикла;
	СекцияГде = Сред(Верх, ПозицияГде, ПозицияКонцаГде - ПозицияГде);
	Если НЕ ПустаяСтрока(ПолноеПоле) И СтрНайти(СекцияГде, ВРег(ПолноеПоле)) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти(СекцияГде, "." + ВРег(ИмяПоля)) > 0
		ИЛИ СтрНайти(СекцияГде, " " + ВРег(ИмяПоля)) > 0;

КонецФункции

Функция ЗапросЧитаетОсновнуюТаблицуБухгалтерскогоРегистра(ТекстЗапроса)

	Источники = НайтиИсточникиЗапроса(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	Для Каждого Источник Из Источники Цикл
		Если СтрНачинаетсяС(Источник.full_name, "РегистрБухгалтерии.")
			И ВРег(Источник.raw) = ВРег(Источник.full_name) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция FixOptionsРесурсаРегистраВГде(ИмяПоля, ТекстЗапроса)

	Результат = Новый Массив;
	ЕстьГруппировка = СтрНайти(ВРег(ТекстЗапроса), "СГРУППИРОВАТЬ ПО") > 0;

	ВариантИмеющие = Новый Структура;
	ВариантИмеющие.Вставить("scenario", "Запрос с СГРУППИРОВАТЬ ПО — используйте ИМЕЮЩИЕ");
	ВариантИмеющие.Вставить("applicable_when", "В запросе есть СГРУППИРОВАТЬ ПО" + ?(ЕстьГруппировка, " (обнаружено)", ""));
	ВариантИмеющие.Вставить("example",
		"ВЫБРАТЬ" + Символы.ПС
		+ "    Рег.СчетДт.Код," + Символы.ПС
		+ "    СУММА(Рег.СуммаПРОборотДт) КАК СуммаПР" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "    РегистрБухгалтерии.<ИмяРегистра>.ОборотыДтКт(&НачПериода, &КонПериода) КАК Рег" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС
		+ "    Рег.СчетДт.Код" + Символы.ПС
		+ "ИМЕЮЩИЕ" + Символы.ПС
		+ "    СУММА(Рег.СуммаПРОборотДт) <> 0");
	Результат.Добавить(ВариантИмеющие);

	ВариантДетальный = Новый Структура;
	ВариантДетальный.Вставить("scenario", "Детальный запрос без группировки — используйте внешний запрос или фильтрацию после выборки");
	ВариантДетальный.Вставить("applicable_when", "В запросе нет СГРУППИРОВАТЬ ПО, нужны детальные записи");
	ВариантДетальный.Вставить("example",
		"ВЫБРАТЬ" + Символы.ПС
		+ "    ВТ.Период," + Символы.ПС
		+ "    ВТ.СуммаПР" + Символы.ПС
		+ "ИЗ (" + Символы.ПС
		+ "    ВЫБРАТЬ" + Символы.ПС
		+ "        Рег.Период КАК Период," + Символы.ПС
		+ "        Рег.СуммаПР КАК СуммаПР" + Символы.ПС
		+ "    ИЗ РегистрБухгалтерии.<ИмяРегистра> КАК Рег" + Символы.ПС
		+ "    ГДЕ Рег.Период МЕЖДУ &НачПериода И &КонПериода" + Символы.ПС
		+ ") КАК ВТ" + Символы.ПС
		+ "ГДЕ ВТ.СуммаПР <> 0");
	Результат.Добавить(ВариантДетальный);

	Возврат Результат;

КонецФункции

Функция ТекущиеМиллисекундыUTC()
	Возврат (ТекущаяУниверсальнаяДата() - '19700101') * 1000;
КонецФункции

Функция ПараметрПередан(Параметры, ИмяП)

	Если ТипЗнч(Параметры) = Тип("Структура")
		ИЛИ ТипЗнч(Параметры) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Возврат Параметры.Свойство(ИмяП, Значение);
	КонецЕсли;
	Если ТипЗнч(Параметры) = Тип("Соответствие")
		ИЛИ ТипЗнч(Параметры) = Тип("ФиксированноеСоответствие") Тогда
		// Перебираем коллекцию: Получить(Ключ) не отличает «нет ключа» от «есть, но Неопределено».
		Для Каждого КЗ Из Параметры Цикл
			Если Строка(КЗ.Ключ) = ИмяП Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ТекстПохожНаБухгалтерскиеСубконто(ТекстКонтекста)

	Если ПустаяСтрока(ТекстКонтекста) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = ВРег(Строка(ТекстКонтекста));
	Возврат СтрНайти(Текст, "СУБКОНТО") > 0
		ИЛИ СтрНайти(Текст, "РЕГИСТРБУХГАЛТЕРИИ") > 0
		ИЛИ СтрНайти(Текст, "ХОЗРАСЧЕТН") > 0;

КонецФункции

Процедура ДобавитьОшибку(Результат, Код, Сообщение, Локация, Подсказка = "")
	Стр = Новый Структура;
	Стр.Вставить("code", Код);
	Стр.Вставить("message", ?(ПустаяСтрока(Подсказка), Сообщение, Сообщение + " " + Подсказка));
	Стр.Вставить("location", ?(Локация = Неопределено, Null, Строка(Локация)));
	Если НЕ ПустаяСтрока(Подсказка) Тогда
		Стр.Вставить("hint", Подсказка);
	КонецЕсли;
	Результат.errors.Добавить(Стр);
КонецПроцедуры

// F-05.2: объект запрошенного вида не найден, но одноимённый объект существует в
// другом виде метаданных. Самый частый случай — обращение к Константе с именем
// функциональной опции: одноимённой константы-хранилища может не быть.
Функция ПодсказкаОбъектаДругогоВида(ПолноеИмя)

	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	ЗапрошенныйВид = Части[0];
	Имя = Части[1];

	НайденныеВиды = Новый Массив;
	Для Каждого Вид Из ВидыДляПоискаОдноименногоОбъекта() Цикл
		Если ВРег(Вид) = ВРег(ЗапрошенныйВид) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Метаданные.НайтиПоПолномуИмени(Вид + "." + Имя) <> Неопределено Тогда
				НайденныеВиды.Добавить(Вид);
			КонецЕсли;
		Исключение
			// Вид не поддерживается этой версией платформы.
		КонецПопытки;
		Если НайденныеВиды.Количество() >= 3 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НайденныеВиды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Подсказка = "Объект '" + Имя + "' существует как " + СтрСоединить(НайденныеВиды, ", ")
		+ ", но не как " + ЗапрошенныйВид + ".";
	Если ВРег(ЗапрошенныйВид) = ВРег("Константа")
		И ПолеЕстьВНаборе("ФункциональнаяОпция", НайденныеВиды) Тогда
		Подсказка = Подсказка
			+ " Не у каждой функциональной опции есть одноимённая константа-хранилище:"
			+ " проверьте свойство «Хранение» этой опции в конфигурации.";
	КонецЕсли;
	Возврат Подсказка;

КонецФункции

// Виды метаданных для поиска одноимённого объекта. Только платформенные имена
// видов, никаких имён объектов конкретной конфигурации.
