Функция ПодсказкаJOINПоUUIDСубконто()

	Подсказка = Новый Структура;
	Подсказка.Вставить("id", "subconto_join_by_uuid");
	Подсказка.Вставить("applies_to", "Бухгалтерские регистры и аналитика по Субконто1/2/3, СубконтоДт1/2/3 и СубконтоКт1/2/3.");
	Подсказка.Вставить("instruction",
		"Поля Субконто в бухгалтерских регистрах имеют обобщённый ссылочный тип. "
		+ "Они уже доступны через бухгалтерские виртуальные таблицы; отдельного открытия вида субконто в MCP не требуется. "
		+ "Чтобы понять, какая позиция Субконто1/2/3 соответствует нужной аналитике для конкретного счёта, сначала исследуйте план счетов и его табличную часть ВидыСубконто. "
		+ "При соединении независимых подзапросов по субконто выводите стабильный ключ УникальныйИдентификатор(Субконто...) КАК ...UUID и соединяйте по этому UUID; саму ссылку оставляйте отдельным полем для представления.");
	Подсказка.Вставить("configuration_agnostic", Истина);
	Возврат Подсказка;

