		ИЛИ СтрНайти(Текст, "РЕНТАБЕЛ") > 0
		ИЛИ СтрНайти(Текст, "МАРЖ") > 0
		ИЛИ СтрНайти(Текст, "СЕБЕСТОИМ") > 0
		ИЛИ СтрНайти(Текст, "ТОВАР") > 0
		ИЛИ СтрНайти(Текст, "НОМЕНКЛАТУР") > 0
		ИЛИ СтрНайти(Текст, "ТМЦ") > 0
		ИЛИ СтрНайти(Текст, "МАТЕРИАЛ") > 0
		ИЛИ СтрНайти(Текст, "СЫРЬ") > 0
		ИЛИ СтрНайти(Текст, "ЗАПАС") > 0
