	КонецПопытки;

КонецПроцедуры

Функция НайтиИсточникВиртуальнойТаблицыВЗапросе(ТекстЗапроса)

	Источники = НайтиИсточникиЗапроса(ТекстБезСтрокИКомментариев(ТекстЗапроса));
	Для Каждого Источник Из Источники Цикл
		Если ПустаяСтрока(Источник.full_name) Тогда
			Продолжить;
		КонецЕсли;
		ИмяВТ = ИмяВиртуальнойТаблицыИзRaw(Источник.raw);
		Если ПустаяСтрока(ИмяВТ) Тогда
			Продолжить;
		КонецЕсли;
		Результат = Новый Структура;
		Результат.Вставить("source_table", Источник.full_name + "." + ИмяВТ);
		Результат.Вставить("object_name", Источник.full_name);
		Результат.Вставить("virtual_table", ИмяВТ);
		Возврат Результат;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ИмяВиртуальнойТаблицыИзRaw(ИмяИсточника)

	Части = СтрРазделить(Строка(ИмяИсточника), ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;
	Кандидат = Части[Части.Количество() - 1];
	Верх = ВРег(Кандидат);
	Если Верх = "ОБОРОТЫ" Тогда Возврат "Обороты"; КонецЕсли;
	Если Верх = "ОБОРОТЫДТКТ" Тогда Возврат "ОборотыДтКт"; КонецЕсли;
	Если Верх = "ОСТАТКИ" Тогда Возврат "Остатки"; КонецЕсли;
	Если Верх = "ОСТАТКИИОБОРОТЫ" Тогда Возврат "ОстаткиИОбороты"; КонецЕсли;
	Если Верх = "СРЕЗПОСЛЕДНИХ" Тогда Возврат "СрезПоследних"; КонецЕсли;
	Если Верх = "СРЕЗПЕРВЫХ" Тогда Возврат "СрезПервых"; КонецЕсли;
	Возврат "";

КонецФункции

Функция ПоляВиртуальнойТаблицыДляДиагностики(ПолноеИмя, ИмяВТ, КешДиагностики)

	// Единый источник полей ВТ для pre-flight и post-error диагностики (F-07/F-08):
	// тот же генератор MCP_Metadata, тот же per-request кеш (A-03).
	Результат = Новый Структура;
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("cache_hit", Ложь);

	Набор = ПолныйНаборПолейВиртуальнойТаблицыКэшированный(ПолноеИмя, ИмяВТ, КешДиагностики);
	Если Набор.supported Тогда
		Результат.fields = Набор.fields;
	КонецЕсли;
	Результат.cache_hit = Набор.cache_hit;
	Возврат Результат;

КонецФункции

Функция ПодсказкаЗаменыПоляВиртуальнойТаблицы(ИмяПоля, ПолноеИмяРегистра, ИмяВТ, ПоляВТ)

	Подсказка = "Поле '" + ИмяПоля + "' не существует в виртуальной таблице " + ИмяВТ
		+ " регистра " + ПолноеИмяРегистра + ". Доступные поля: "
		+ СтрСоединить(ПоляВТ, ", ") + ".";
	Варианты = ВариантыПохожихПолей(ИмяПоля, ПоляВТ, 3);
	Если Варианты.Количество() > 0 Тогда
		Подсказка = Подсказка + " Возможная замена: " + СтрСоединить(Варианты, " или ") + ".";
	КонецЕсли;
	Возврат Подсказка;

КонецФункции

Функция ВариантыПохожихПолей(ИмяПоля, Поля, Максимум)

	Результат = Новый Массив;
	ВерхИмяПоля = ВРег(Строка(ИмяПоля));
	Для Каждого Поле Из Поля Цикл
		Если Результат.Количество() >= Максимум Тогда
			Возврат Результат;
		КонецЕсли;
		ВерхПоле = ВРег(Строка(Поле));
		Если СтрНачинаетсяС(ВерхПоле, ВерхИмяПоля) Тогда
			Результат.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Кандидат = Новый Структура;
		Кандидат.Вставить("field", Поле);
		Кандидат.Вставить("distance",
			РасстояниеЛевенштейна(ВерхИмяПоля, ВРег(Строка(Поле))));
		ДобавитьКандидатПоРасстоянию(Кандидаты, Кандидат, Максимум);
	КонецЦикла;
	Для Каждого Кандидат Из Кандидаты Цикл
		Результат.Добавить(Кандидат.field);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКандидатПоРасстоянию(Кандидаты, Кандидат, Максимум)

	Добавлено = Ложь;
	Если Кандидаты.Количество() > 0 Тогда
		Для Индекс = 0 По Кандидаты.Количество() - 1 Цикл
			Если Кандидат.distance < Кандидаты[Индекс].distance Тогда
				Кандидаты.Вставить(Индекс, Кандидат);
				Добавлено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НЕ Добавлено Тогда
		Кандидаты.Добавить(Кандидат);
	КонецЕсли;
	Пока Кандидаты.Количество() > Максимум Цикл
		Кандидаты.Удалить(Кандидаты.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

Функция РасстояниеЛевенштейна(ЛевыйТекст, ПравыйТекст)

	ЛевыйТекст = Строка(ЛевыйТекст);
	ПравыйТекст = Строка(ПравыйТекст);
	ПредыдущаяСтрока = Новый Массив;
	Для Индекс = 0 По СтрДлина(ПравыйТекст) Цикл
		ПредыдущаяСтрока.Добавить(Индекс);
	КонецЦикла;

	Для ИндексЛевого = 1 По СтрДлина(ЛевыйТекст) Цикл
		ТекущаяСтрока = Новый Массив;
		ТекущаяСтрока.Добавить(ИндексЛевого);
		Для ИндексПравого = 1 По СтрДлина(ПравыйТекст) Цикл
			СтоимостьЗамены = ?(
				Сред(ЛевыйТекст, ИндексЛевого, 1) = Сред(ПравыйТекст, ИндексПравого, 1), 0, 1);
			Удаление = ПредыдущаяСтрока[ИндексПравого] + 1;
			Вставка = ТекущаяСтрока[ИндексПравого - 1] + 1;
			Замена = ПредыдущаяСтрока[ИндексПравого - 1] + СтоимостьЗамены;
			ТекущаяСтрока.Добавить(Мин(Удаление, Мин(Вставка, Замена)));
		КонецЦикла;
		ПредыдущаяСтрока = ТекущаяСтрока;
	КонецЦикла;

	Возврат ПредыдущаяСтрока[СтрДлина(ПравыйТекст)];

КонецФункции

Процедура ЗаписатьЛогCR01(ИсточникВТ, ИмяПоля, CacheHit, CorrelationID)

	Попытка
		ДанныеЛога = Новый Структура;
		ДанныеЛога.Вставить("cr_id", "CR-01");
		ДанныеЛога.Вставить("correlation_id", Строка(CorrelationID));
		ДанныеЛога.Вставить("register", ИсточникВТ.object_name);
		ДанныеЛога.Вставить("virtual_table", ИсточникВТ.virtual_table);
