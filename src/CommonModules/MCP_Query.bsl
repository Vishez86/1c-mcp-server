Процедура ДобавитьОшибку(Результат, Код, Сообщение, Локация)
	Стр = Новый Структура;
	Стр.Вставить("code", Код);
	Стр.Вставить("message", Сообщение);
	Стр.Вставить("location", ?(Локация = Неопределено, Null, Строка(Локация)));
	Результат.errors.Добавить(Стр);
КонецПроцедуры
