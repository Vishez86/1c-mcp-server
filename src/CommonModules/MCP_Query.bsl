		ИЛИ СтрНайти(Текст, "ЗАКУПК") > 0
		ИЛИ СтрНайти(Текст, "ПОСТАВЩ") > 0
		ИЛИ СтрНайти(Текст, "ОСНОВН") > 0
		ИЛИ СтрНайти(Текст, "НЕМАТЕРИАЛ") > 0
