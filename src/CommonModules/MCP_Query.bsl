// MCP_Query.bsl
// ====================================================================
// Безопасное выполнение и валидация запросов 1С.
// Запрос всегда read-only: запрещены ПОМЕСТИТЬ, ИНДЕКСИРОВАТЬ ПО, УНИЧТОЖИТЬ, ДЛЯ ИЗМЕНЕНИЯ.
// Всегда применяется server-side limit.
// ====================================================================

// Валидация запроса перед выполнением.
//
// Возвращает структуру { valid, errors[], warnings[], detected_objects[], detected_parameters[], estimated_risk }
//
Функция Валидировать(ТекстЗапроса, Параметры, Строгий = Истина, Объяснить = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("valid", Истина);
	Результат.Вставить("errors", Новый Массив);
	Результат.Вставить("warnings", Новый Массив);
	Результат.Вставить("detected_objects", Новый Массив);
	Результат.Вставить("detected_parameters", Новый Массив);
	Результат.Вставить("estimated_risk", "low");

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ДобавитьОшибку(Результат, "empty_query", "Текст запроса пуст.", Неопределено);
		Возврат Результат;
	КонецЕсли;

	// Запрещённые конструкции.
	ЗапрещенныеКлючевыеСлова = Новый Массив;
	ЗапрещенныеКлючевыеСлова.Добавить("ПОМЕСТИТЬ");
	ЗапрещенныеКлючевыеСлова.Добавить("ИНДЕКСИРОВАТЬ ПО");
	ЗапрещенныеКлючевыеСлова.Добавить("УНИЧТОЖИТЬ");
	ЗапрещенныеКлючевыеСлова.Добавить("ДЛЯ ИЗМЕНЕНИЯ");
	ЗапрещенныеКлючевыеСлова.Добавить("PLACE");
	ЗапрещенныеКлючевыеСлова.Добавить("INDEX BY");
	ЗапрещенныеКлючевыеСлова.Добавить("DROP");
	ЗапрещенныеКлючевыеСлова.Добавить("FOR UPDATE");

	ВерхнийТекст = ВРег(ТекстЗапроса);
	Для Каждого КС Из ЗапрещенныеКлючевыеСлова Цикл
		Если СтрНайти(ВерхнийТекст, ВРег(КС)) > 0 Тогда
			ДобавитьОшибку(Результат, "forbidden_keyword",
				"Запрещённая конструкция: " + КС, КС);
		КонецЕсли;
	КонецЦикла;

	// Поиск используемых таблиц метаданных.
	ИспользуемыеТипы = НайтиИспользуемыеТипы(ТекстЗапроса);
	Для Каждого Т Из ИспользуемыеТипы Цикл
		Результат.detected_objects.Добавить(Т);
		Если НЕ MCP_Security.ТипРазрешен(Т) Тогда
			ДобавитьОшибку(Результат, "type_not_allowed",
				"Тип запрещён allowlist: " + Т, Т);
		КонецЕсли;
	КонецЦикла;

	// Параметры.
	НайденныеПараметры = НайтиПараметры(ТекстЗапроса);
	Результат.detected_parameters = НайденныеПараметры;

	Если Параметры <> Неопределено Тогда
		Для Каждого ИмяП Из НайденныеПараметры Цикл
			НашлиЗначение = Ложь;
			Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство(ИмяП) Тогда
				НашлиЗначение = Истина;
			ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") И Параметры.Получить(ИмяП) <> Неопределено Тогда
				НашлиЗначение = Истина;
			КонецЕсли;
			Если НЕ НашлиЗначение Тогда
				Результат.warnings.Добавить("Параметр &" + ИмяП + " не передан.");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Проверка наличия лимита.
	Если СтрНайти(ВерхнийТекст, "ПЕРВЫЕ") = 0 И СтрНайти(ВерхнийТекст, "TOP") = 0 Тогда
		Результат.warnings.Добавить(
			"Запрос не содержит явного ограничения ПЕРВЫЕ N. Будет применён server-side limit.");
	КонецЕсли;

	// Оценка риска.
	Если Результат.errors.Количество() > 0 Тогда
		Результат.valid = Ложь;
		Результат.estimated_risk = "blocked";
	ИначеЕсли Результат.warnings.Количество() > 0 Тогда
		Результат.estimated_risk = "medium";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выполняет запрос с лимитом и таймаутом.
// Возвращает { columns, rows, row_count, truncated, next_cursor, duration_ms, warnings }
Функция Выполнить(ТекстЗапроса, Параметры, Лимит, TimeoutSeconds = Неопределено, Курсор = "") Экспорт

	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;
	Если Лимит > MCP_Config.Лимиты().max_query_rows Тогда
		Лимит = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	ЛимитВыборки = Смещение + Лимит + 1;
	Если ЛимитВыборки > MCP_Config.Лимиты().max_query_rows Тогда
		ЛимитВыборки = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	// Гарантируем server-side limit, если в запросе нет ПЕРВЫЕ.
	ТекстЗапросаLimited = ПрименитьЛимит(ТекстЗапроса, ЛимитВыборки);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаLimited;
	УстановитьПараметрыЗапроса(Запрос, Параметры);

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryValidationFailed(),
			"Ошибка выполнения запроса: " + ОписаниеОшибки());
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;

	Если Длительность / 1000 > MCP_Config.Лимиты().query_timeout_seconds Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_QueryTimeout(),
			"Запрос выполнялся слишком долго: " + Длительность + " мс");
	КонецЕсли;

	// Кодируем результат.
	Колонки = Новый Массив;
	Для Каждого К Из РезультатЗапроса.Колонки Цикл
		КС = Новый Структура;
		КС.Вставить("name", К.Имя);
		КС.Вставить("type_description", Строка(К.ТипЗначения));
		Колонки.Добавить(КС);
	КонецЦикла;

	Строки = Новый Массив;
	Усечено = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Счетчик = 0;
	Пропущено = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Смещение Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		СтрокаJSON = Новый Структура;
		Для Каждого К Из РезультатЗапроса.Колонки Цикл
			СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(Выборка[К.Имя], ОпцииВалью));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("row_count", Счетчик);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("duration_ms", Длительность);
	Результат.Вставить("warnings", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Параметры) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого КЗ Из Параметры Цикл
			Значение = MCP_Values.ДекодироватьПараметр(КЗ.Значение);
			Запрос.УстановитьПараметр(КЗ.Ключ, Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Параметры Цикл
			Значение = MCP_Values.ДекодироватьПараметр(КЗ.Значение);
			Запрос.УстановитьПараметр(Строка(КЗ.Ключ), Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Число(Текст));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция ПрименитьЛимит(ТекстЗапроса, Лимит)

	ВерхнийТекст = ВРег(ТекстЗапроса);
	Если СтрНайти(ВерхнийТекст, "ПЕРВЫЕ") > 0 ИЛИ СтрНайти(ВерхнийТекст, "TOP") > 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	// Вставляем "ПЕРВЫЕ N" после первого ВЫБРАТЬ/SELECT.
	Для Каждого КС Из СтрРазделить("ВЫБРАТЬ РАЗРЕШЕННЫЕ,ВЫБРАТЬ,SELECT", ",", Истина) Цикл
		Поз = СтрНайти(ВерхнийТекст, ВРег(КС));
		Если Поз > 0 Тогда
			Возврат Лев(ТекстЗапроса, Поз + СтрДлина(КС) - 1)
				+ " ПЕРВЫЕ " + Лимит + " "
				+ Сред(ТекстЗапроса, Поз + СтрДлина(КС));
		КонецЕсли;
	КонецЦикла;

	Возврат ТекстЗапроса;

КонецФункции

Функция НайтиИспользуемыеТипы(ТекстЗапроса)

	Результат = Новый Массив;
	// Простой парсер: ищем "ИЗ <Вид>.<Имя>" и "СОЕДИНЕНИЕ <Вид>.<Имя>".
	Виды = Новый Массив;
	Виды.Добавить("Справочник");
	Виды.Добавить("Документ");
	Виды.Добавить("Перечисление");
	Виды.Добавить("РегистрСведений");
	Виды.Добавить("РегистрНакопления");
	Виды.Добавить("РегистрБухгалтерии");
	Виды.Добавить("РегистрРасчета");
	Виды.Добавить("ПланСчетов");
	Виды.Добавить("ПланВидовХарактеристик");
	Виды.Добавить("ПланВидовРасчета");
	Виды.Добавить("ПланОбмена");
	Виды.Добавить("БизнесПроцесс");
	Виды.Добавить("Задача");

	Найдено = Новый Соответствие;
	Лексемы = СтрРазделить(ТекстЗапроса, " " + Символы.ПС + Символы.ВК + Символы.Таб + "(),", Истина);
	Для Каждого Л Из Лексемы Цикл
		Чистая = СокрЛП(Л);
		Поз = СтрНайти(Чистая, ".");
		Если Поз > 0 И Поз < СтрДлина(Чистая) Тогда
			Префикс = Лев(Чистая, Поз - 1);
			Для Каждого В Из Виды Цикл
				Если В = Префикс Тогда
					// Берём первую часть до второй точки (для виртуальных таблиц).
					Хвост = Сред(Чистая, Поз + 1);
					ПозТочки = СтрНайти(Хвост, ".");
					Если ПозТочки > 0 Тогда
						Хвост = Лев(Хвост, ПозТочки - 1);
					КонецЕсли;
					ПолноеИмя = Префикс + "." + Хвост;
					Если Найдено.Получить(ПолноеИмя) = Неопределено Тогда
						Найдено.Вставить(ПолноеИмя, Истина);
						Результат.Добавить(ПолноеИмя);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиПараметры(ТекстЗапроса)

	Результат = Новый Массив;
	Найдено = Новый Соответствие;
	Длина = СтрДлина(ТекстЗапроса);
	Поз = 1;

	Пока Поз <= Длина Цикл
		Симв = Сред(ТекстЗапроса, Поз, 1);
		Если Симв = "&" Тогда
			Имя = "";
			Поз = Поз + 1;
			Пока Поз <= Длина Цикл
				С = Сред(ТекстЗапроса, Поз, 1);
				Если ЯвляетсяСимволомИдентификатора(С) Тогда
					Имя = Имя + С;
					Поз = Поз + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ПустаяСтрока(Имя) И Найдено.Получить(Имя) = Неопределено Тогда
				Найдено.Вставить(Имя, Истина);
				Результат.Добавить(Имя);
			КонецЕсли;
		Иначе
			Поз = Поз + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЯвляетсяСимволомИдентификатора(С)
	Если С = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Код = КодСимвола(С);
	Возврат (Код >= КодСимвола("0") И Код <= КодСимвола("9"))
		ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
		ИЛИ (Код >= КодСимвола("a") И Код <= КодСимвола("z"))
		ИЛИ (Код >= КодСимвола("А") И Код <= КодСимвола("я"));
КонецФункции

Процедура ДобавитьОшибку(Результат, Код, Сообщение, Локация)
	Стр = Новый Структура;
	Стр.Вставить("code", Код);
	Стр.Вставить("message", Сообщение);
	Стр.Вставить("location", ?(Локация = Неопределено, Null, Строка(Локация)));
	Результат.errors.Добавить(Стр);
КонецПроцедуры
