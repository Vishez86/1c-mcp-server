// Модуль формы обработки «Настройка маскирования MCP»: политика маскирования
// набирается галками по дереву метаданных и хранится JSON-текстом в
// предопределённом элементе справочника MCP_Маскирование.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьДеревоМетаданных();
	ПрочитатьПолитикуИзСправочника();
	ОбновитьПанельНастроек();
	Элементы.ГруппаНастройки.Видимость = Ложь;
	Заголовок = ЗаголовокФормыПоСостоянию(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если НЕ ПолитикаИзменена Тогда
		Возврат;
	КонецЕсли;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = "Политика маскирования изменена и не записана.";
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Оповещение = Новый ОписаниеОповещения("ЗакрытиеВопросЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Политика маскирования изменена. Записать перед закрытием?",
		РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьПолитикуКлиент() Тогда
			Закрыть();
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ПолитикаИзменена = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьПолитику(Команда)

	ЗаписатьПолитикуКлиент();

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьПолитику(Команда)

	Если ПолитикаИзменена Тогда
		Оповещение = Новый ОписаниеОповещения("ПеречитатьВопросЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Несохранённые изменения будут потеряны. Перечитать политику из справочника?",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПеречитатьПолитикуНаСервере();
		ОбновитьЗаголовокФормы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПеречитатьПолитикуНаСервере();
		ОбновитьЗаголовокФормы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсе(Команда)

	Оповещение = Новый ОписаниеОповещения("ОчиститьВсеВопросЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Снять все пометки, псевдонимы и записи политики? В справочник изменение попадёт только по кнопке «Записать».",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОчиститьВсеНаСервере();
		ОбновитьЗаголовокФормы();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоМетаданныхПометкаПриИзменении(Элемент)

	Ид = Элементы.ДеревоМетаданных.ТекущаяСтрока;
	Если Ид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработатьПометкуОбъектаНаСервере(Ид);
	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПриАктивизацииСтроки(Элемент)

	// Отложенный вызов: активизация срабатывает на каждое перемещение курсора,
	// а серверное построение панели нужно только для строки, на которой курсор
	// остановился (M-22, ленивость).
	ПодключитьОбработчикОжидания("ОбновитьПоляТекущегоОбъекта", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоляТекущегоОбъекта()

	Ид = Элементы.ДеревоМетаданных.ТекущаяСтрока;
	Если Ид = Неопределено ИЛИ Ид = ИдентификаторТекущегоОбъекта Тогда
		Возврат;
	КонецЕсли;
	ПостроитьПоляОбъектаНаСервере(Ид);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПсевдонимПриИзменении(Элемент)

	Данные = Элементы.ДеревоМетаданных.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Данные.ЭтоВид ИЛИ НЕ Данные.ПсевдонимДоступен Тогда
		// Псевдоним доступен только объектам ссылочных видов; страховка на
		// случай, если условное оформление колонки не настроено.
		Данные.Псевдоним = Ложь;
		Возврат;
	КонецЕсли;

	Если Данные.Псевдоним И ПустаяСтрока(Данные.Префикс) Тогда
		Данные.Префикс = Данные.Имя + "-";
	КонецЕсли;

	ПересчитатьПометкуСтрокиНаСервере(Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПрефиксПриИзменении(Элемент)

	Данные = Элементы.ДеревоМетаданных.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные.Префикс = СокрЛП(Данные.Префикс);
	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ПоляОбъектаПометкаПриИзменении(Элемент)

	Ид = Элементы.ПоляОбъекта.ТекущаяСтрока;
	Если Ид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработатьПометкуПоляНаСервере(Ид);
	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиНажатие(Элемент)

	НоваяВидимость = НЕ Элементы.ГруппаНастройки.Видимость;
	Элементы.ГруппаНастройки.Видимость = НоваяВидимость;
	Если НоваяВидимость Тогда
		// При раскрытии панель показывает свежий предпросмотр и состояние
		// рубильника — отдельной кнопки «Показать JSON» нет (А.4).
		ОбновитьПанельНастроекНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МаскируемыеПоляИмяПоляПриИзменении(Элемент)

	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура МаскируемыеПоляПослеУдаления(Элемент)

	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ПубликоватьДеталиПриИзменении(Элемент)

	ОтметитьИзменение();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписиВнеКонфигурацииПослеУдаления(Элемент)

	ОтметитьИзменение();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыКлиент

&НаКлиенте
Функция ЗаписатьПолитикуКлиент()

	Результат = ЗаписатьПолитикуНаСервере();
	Для Каждого Строчка Из Результат.Сообщения Цикл
		Сообщить(Строчка);
	КонецЦикла;
	ОбновитьЗаголовокФормы();
	Возврат Результат.Успех;

КонецФункции

&НаКлиенте
Процедура ОтметитьИзменение()

	ПолитикаИзменена = Истина;
	ОбновитьЗаголовокФормы();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокФормы()

	Заголовок = ЗаголовокФормыПоСостоянию(ПолитикаИзменена);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокФормыПоСостоянию(ЕстьИзменения)

	Возврат "Настройка маскирования MCP" + ?(ЕстьИзменения, " *", "");

КонецФункции

#КонецОбласти

#Область ПостроениеДереваМетаданных

&НаСервере
Функция ЭтотОбъект(ТекущийОбъект = Неопределено)

	Если ТекущийОбъект = Неопределено Тогда
		Возврат РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");

	Возврат Неопределено;

КонецФункции

// Левое дерево: вид → объект. Поля объектов НЕ строятся — правая панель
// перестраивается лениво при активизации строки (M-22): на ERP жадное
// построение давало бы сотни тысяч строк в реквизите формы.
&НаСервере
Процедура ЗагрузитьДеревоМетаданных()

	перДерево = НовоеДеревоМетаданных();

	Для Каждого ОписаниеВида Из ЭтотОбъект().ВидыМетаданныхДляМаскирования() Цикл

		Коллекция = Метаданные[ОписаниеВида.ИмяКоллекции];
		Если Коллекция.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаВида = перДерево.Строки.Добавить();
		СтрокаВида.Имя = ОписаниеВида.ИмяКоллекции;
		СтрокаВида.Синоним = ОписаниеВида.ИмяКоллекции;
		СтрокаВида.ПолноеИмя = "";
		СтрокаВида.ДанныеПоиска = ОписаниеВида.ДанныеПоиска;
		СтрокаВида.ИндексКартинки = ОписаниеВида.НомерКартинки;
		СтрокаВида.ЭтоВид = Истина;
		СтрокаВида.ПсевдонимДоступен = Ложь;
		СтрокаВида.Пометка = 0;

		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			СтрокаОбъекта = СтрокаВида.Строки.Добавить();
			СтрокаОбъекта.Имя = ОбъектМетаданных.Имя;
			СтрокаОбъекта.Синоним = ?(НЕ ПустаяСтрока(ОбъектМетаданных.Синоним),
				ОбъектМетаданных.Синоним, ОбъектМетаданных.Имя);
			// ЕДИНСТВЕННОЕ число — ОбъектМетаданных.ПолноеИмя(). Склейка
			// «ИмяКоллекции.Имя» дала бы «Справочники.Контрагенты», и вся
			// записанная политика молча не применилась бы (А.10.1).
			СтрокаОбъекта.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			СтрокаОбъекта.ДанныеПоиска = ОписаниеВида.ДанныеПоиска;
			СтрокаОбъекта.ИндексКартинки = ОписаниеВида.НомерКартинки;
			СтрокаОбъекта.ЭтоВид = Ложь;
			СтрокаОбъекта.ПсевдонимДоступен = ОписаниеВида.ПсевдонимДоступен;
			СтрокаОбъекта.Пометка = 0;
		КонецЦикла;

	КонецЦикла;

	ЗначениеВРеквизитФормы(перДерево, "ДеревоМетаданных");

КонецПроцедуры

&НаСервереБезКонтекста
Функция НовоеДеревоМетаданных()

	// "Объекты метаданных" — состав колонок обязан совпадать с реквизитом формы.
	ДеревоМетаданных = Новый ДеревоЗначений;
	ДеревоМетаданных.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("ДанныеПоиска", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1)));
	ДеревоМетаданных.Колонки.Добавить("ИндексКартинки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2)));
	ДеревоМетаданных.Колонки.Добавить("Псевдоним", Новый ОписаниеТипов("Булево"));
	ДеревоМетаданных.Колонки.Добавить("Префикс", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДеревоМетаданных.Колонки.Добавить("ПомеченныеПоля", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("ДопКлючиМаскиJSON", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("ДопКлючиПсевдонимаJSON", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));
	ДеревоМетаданных.Колонки.Добавить("ЭтоВид", Новый ОписаниеТипов("Булево"));
	ДеревоМетаданных.Колонки.Добавить("ПсевдонимДоступен", Новый ОписаниеТипов("Булево"));

	Возврат ДеревоМетаданных;

КонецФункции

#КонецОбласти

#Область ЧтениеПолитики

// Чтение политики из предопределённого элемента справочника MCP_Маскирование.
// Исключение источника (справочник отсутствует, элемент недоступен) — то же
// состояние, которое на сервере даёт аварийный режим: форма его показывает,
// но продолжает работать — «Записать» перезапишет содержимое.
&НаСервере
Процедура ПрочитатьПолитикуИзСправочника()

	ЕстьОшибка = Ложь;
	ТекстОшибки = "";
	ТекстПолитики = "";

	// Обработка — объект расширения MCP: MCP_Config зовётся напрямую, и вызовы
	// видны чекеру межмодульных связей (bsl_cross_module_calls). Ветка «модуль
	// не найден» существовала для внешней обработки и упразднена вместе с ней.
	Попытка
		ТекстПолитики = MCP_Config.ТекстПолитикиМаскирования();
	Исключение
		ЕстьОшибка = Истина;
		ТекстОшибки = "Политика недоступна: " + ОписаниеОшибки();
	КонецПопытки;

	Если НЕ ЕстьОшибка Тогда
		ПрочитатьПолитикуВФорму(ТекстПолитики);
	КонецЕсли;

	Элементы.ТекстОшибки.Видимость = ЕстьОшибка;

КонецПроцедуры

&НаСервере
Процедура ПеречитатьПолитикуНаСервере()

	ПрочитатьПолитикуИзСправочника();
	ОбновитьПанельНастроек();

КонецПроцедуры

// Разбор текста политики в форму (§6.4): псевдонимы и префиксы — из
// type_aliases, пометки полей — из type_field_masks, панель — из masked_fields
// и publish_details. Записи с типами вне конфигурации НЕ выбрасываются (M-23),
// неизвестные ключи сохраняются для round-trip (M-14).
&НаСервере
Процедура ПрочитатьПолитикуВФорму(ТекстJSON)

	ОчиститьФормуОтПолитики();

	Если ПустаяСтрока(ТекстJSON) Тогда
		// Пустое Значение — законное состояние «ничего не настроено».
		ПолитикаИзменена = Ложь;
		Возврат;
	КонецЕсли;

	Попытка
		Данные = ПрочитатьJSONТекст(ТекстJSON);
	Исключение
		ЕстьОшибка = Истина;
		ТекстОшибки = "Политика нечитаема (битый JSON) — на сервере действует аварийный режим"
			+ " с максимальной маской. «Записать» перезапишет содержимое. Ошибка разбора: "
			+ ОписаниеОшибки();
		Элементы.ТекстОшибки.Видимость = Истина;
		ПредпросмотрJSON = ТекстJSON;
		ПолитикаИзменена = Ложь;
		Возврат;
	КонецПопытки;

	Privacy = ЗначениеJSONФормы(Данные, "privacy");
	Если НЕ ЭтоОбъектJSONФормы(Privacy) Тогда
		ПолитикаИзменена = Ложь;
		Возврат;
	КонецЕсли;

	Индекс = ИндексСтрокОбъектов();

	// type_aliases → флажок «Псевдоним» и колонка «Префикс».
	Записи = ЗначениеJSONФормы(Privacy, "type_aliases");
	Если ТипЗнч(Записи) = Тип("Массив") Тогда
		Для Каждого Запись Из Записи Цикл
			Если НЕ ЭтоОбъектJSONФормы(Запись) Тогда
				Продолжить;
			КонецЕсли;
			ИмяТипа = СтрокаJSONФормы(ЗначениеJSONФормы(Запись, "type"));
			Префикс = СтрокаJSONФормы(ЗначениеJSONФормы(Запись, "prefix"));
			ДопКлючи = ДопКлючиЗаписиJSON(Запись, "type,prefix");
			СтрокаДерева = Индекс.Получить(НормКлючФормы(ИмяТипа));
			Если СтрокаДерева <> Неопределено Тогда
				СтрокаДерева.Псевдоним = Истина;
				СтрокаДерева.Префикс = Префикс;
				СтрокаДерева.ДопКлючиПсевдонимаJSON = ДопКлючи;
			Иначе
				НоваяЗапись = ЗаписиВнеКонфигурации.Добавить();
				НоваяЗапись.Раздел = "type_aliases";
				НоваяЗапись.Тип = ИмяТипа;
				НоваяЗапись.Префикс = Префикс;
				НоваяЗапись.Поля = "";
				НоваяЗапись.ДопКлючиJSON = ДопКлючи;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// type_field_masks → служебная колонка ПомеченныеПоля (M-22: без построения
	// правых панелей — пометки не теряются, даже если строку не открывали).
	Записи = ЗначениеJSONФормы(Privacy, "type_field_masks");
	Если ТипЗнч(Записи) = Тип("Массив") Тогда
		Для Каждого Запись Из Записи Цикл
			Если НЕ ЭтоОбъектJSONФормы(Запись) Тогда
				Продолжить;
			КонецЕсли;
			ИмяТипа = СтрокаJSONФормы(ЗначениеJSONФормы(Запись, "type"));
			ПоляЗаписи = ЗначениеJSONФормы(Запись, "fields");
			СтрокаПолей = "";
			Если ТипЗнч(ПоляЗаписи) = Тип("Массив") Тогда
				Имена = Новый Массив;
				Для Каждого Поле Из ПоляЗаписи Цикл
					ИмяПоля = СтрокаJSONФормы(Поле);
					Если НЕ ПустаяСтрока(ИмяПоля) Тогда
						Имена.Добавить(ИмяПоля);
					КонецЕсли;
				КонецЦикла;
				СтрокаПолей = СтрСоединить(Имена, ",");
			КонецЕсли;
			ДопКлючи = ДопКлючиЗаписиJSON(Запись, "type,fields");
			СтрокаДерева = Индекс.Получить(НормКлючФормы(ИмяТипа));
			Если СтрокаДерева <> Неопределено Тогда
				СтрокаДерева.ПомеченныеПоля = СтрокаПолей;
				СтрокаДерева.ДопКлючиМаскиJSON = ДопКлючи;
			Иначе
				НоваяЗапись = ЗаписиВнеКонфигурации.Добавить();
				НоваяЗапись.Раздел = "type_field_masks";
				НоваяЗапись.Тип = ИмяТипа;
				НоваяЗапись.Префикс = "";
				НоваяЗапись.Поля = СтрокаПолей;
				НоваяЗапись.ДопКлючиJSON = ДопКлючи;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// masked_fields → панель «Настройки».
	Поля = ЗначениеJSONФормы(Privacy, "masked_fields");
	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		Для Каждого Поле Из Поля Цикл
			ИмяПоля = СтрокаJSONФормы(Поле);
			Если НЕ ПустаяСтрока(ИмяПоля) Тогда
				НоваяСтрока = МаскируемыеПоля.Добавить();
				НоваяСтрока.ИмяПоля = ИмяПоля;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ПубликоватьДетали = БулевоJSONФормы(ЗначениеJSONФормы(Privacy, "publish_details"), Истина);

	// Прочие ключи privacy — включая упразднённые organization_aliases /
	// person_aliases — сохраняются для round-trip (M-14): о них предупреждает
	// сервер (M-2) после записи, а избавляет от них импорт из MCP_ServerConfig,
	// который переносит их содержимое в явные записи.
	Прочие = Новый Соответствие;
	Для Каждого КлючЗначение Из Privacy Цикл
		ИмяКлюча = Строка(КлючЗначение.Ключ);
		Если ИмяКлюча = "masked_fields" ИЛИ ИмяКлюча = "type_aliases"
			ИЛИ ИмяКлюча = "type_field_masks" ИЛИ ИмяКлюча = "publish_details" Тогда
			Продолжить;
		КонецЕсли;
		Прочие.Вставить(ИмяКлюча, КлючЗначение.Значение);
	КонецЦикла;
	Если Прочие.Количество() > 0 Тогда
		ПрочиеКлючиPrivacyJSON = ЗаписатьJSONВСтроку(Прочие, Ложь);
	КонецЕсли;

	ПересчитатьПометкиПоСостоянию();
	ПолитикаИзменена = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОчиститьФормуОтПолитики()

	Для Каждого СтрокаВида Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		СтрокаВида.Пометка = 0;
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
			СтрокаОбъекта.Пометка = 0;
			СтрокаОбъекта.Псевдоним = Ложь;
			СтрокаОбъекта.Префикс = "";
			СтрокаОбъекта.ПомеченныеПоля = "";
			СтрокаОбъекта.ДопКлючиМаскиJSON = "";
			СтрокаОбъекта.ДопКлючиПсевдонимаJSON = "";
		КонецЦикла;
	КонецЦикла;

	Для Каждого СтрокаГруппы Из ПоляОбъекта.ПолучитьЭлементы() Цикл
		СтрокаГруппы.Пометка = Ложь;
		Для Каждого СтрокаПоля Из СтрокаГруппы.ПолучитьЭлементы() Цикл
			СтрокаПоля.Пометка = Ложь;
		КонецЦикла;
	КонецЦикла;

	МаскируемыеПоля.Очистить();
	ЗаписиВнеКонфигурации.Очистить();
	ПубликоватьДетали = Истина;
	ПрочиеКлючиPrivacyJSON = "";
	ПредпросмотрJSON = "";

КонецПроцедуры

// Пометки строк по состоянию политики БЕЗ обхода метаданных полей (А.10.3):
// точное «1 = помечено всё» требует знать общее число полей типа, поэтому до
// первого построения панели участвующий тип показывается как «частично» (2).
// Построение панели уточняет пометку точным подсчётом.
&НаСервере
Процедура ПересчитатьПометкиПоСостоянию()

	Для Каждого СтрокаВида Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.Псевдоним ИЛИ НЕ ПустаяСтрока(СтрокаОбъекта.ПомеченныеПоля) Тогда
				СтрокаОбъекта.Пометка = 2;
			Иначе
				СтрокаОбъекта.Пометка = 0;
			КонецЕсли;
		КонецЦикла;
		ПересчитатьПометкуВида(СтрокаВида);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИндексСтрокОбъектов()

	Индекс = Новый Соответствие;
	Для Каждого СтрокаВида Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
			Индекс.Вставить(НормКлючФормы(СтрокаОбъекта.ПолноеИмя), СтрокаОбъекта);
		КонецЦикла;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

#КонецОбласти

#Область ПометкиИПраваяПанель

// Ленивое построение правой панели для строки объекта (M-22): один реквизит
// ПоляОбъекта на форму, а не вложенное дерево на каждую строку, как в заготовке.
&НаСервере
Процедура ПостроитьПоляОбъектаНаСервере(Ид)

	ИдентификаторТекущегоОбъекта = Ид;
	СтрокиПанели = ПоляОбъекта.ПолучитьЭлементы();
	СтрокиПанели.Очистить();

	СтрокаДерева = ДеревоМетаданных.НайтиПоИдентификатору(Ид);
	Если СтрокаДерева = Неопределено ИЛИ СтрокаДерева.ЭтоВид Тогда
		Возврат;
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(СтрокаДерева.ПолноеИмя);
	Если ОМД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Помеченные = ИндексПомеченныхПолей(СтрокаДерева.ПомеченныеПоля);
	// Поля вне маскирования вычисляются один раз на объект и оседают в колонке
	// ВнеМаскирования: булевы агрегаты считают только маскируемые поля, иначе
	// галка «все помечены» была бы недостижима из-за служебных полей.
	Исключённые = ИменаПолейВнеМаскирования(СтрокаДерева.ПолноеИмя);

	Для Каждого ИмяКоллекции Из СтрРазделить(СтрокаДерева.ДанныеПоиска, ",", Ложь) Цикл
		Если ИмяКоллекции = "ТабличныеЧасти" Тогда
			ДобавитьГруппыТабличныхЧастей(ОМД, ИмяКоллекции, "Реквизиты", Помеченные, Исключённые);
		ИначеЕсли ИмяКоллекции = "СтандартныеТабличныеЧасти" Тогда
			ДобавитьГруппыТабличныхЧастей(ОМД, ИмяКоллекции, "СтандартныеРеквизиты", Помеченные, Исключённые);
		Иначе
			ДобавитьГруппуСкалярнойКоллекции(ОМД, ИмяКоллекции, Помеченные, Исключённые);
		КонецЕсли;
	КонецЦикла;

	УточнитьПометкуОбъектаПоПанели(СтрокаДерева);

КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппуСкалярнойКоллекции(ОМД, ИмяКоллекции, Помеченные, Исключённые)

	Коллекция = КоллекцияПолейОбъекта(ОМД, ИмяКоллекции);
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаГруппы = Неопределено;
	Для Каждого Поле Из Коллекция Цикл
		Если СтрокаГруппы = Неопределено Тогда
			СтрокаГруппы = ПоляОбъекта.ПолучитьЭлементы().Добавить();
			СтрокаГруппы.Имя = ИмяКоллекции;
			СтрокаГруппы.Синоним = ПредставлениеКоллекцииПолей(ИмяКоллекции);
			СтрокаГруппы.ПолноеИмя = "";
			СтрокаГруппы.ЭтоГруппа = Истина;
			СтрокаГруппы.ИндексКартинки = НомерКартинкиКоллекции(ИмяКоллекции);
		КонецЕсли;
		ДобавитьСтрокуПоля(СтрокаГруппы, Поле, Поле.Имя, Помеченные, Исключённые);
	КонецЦикла;

	Если СтрокаГруппы <> Неопределено Тогда
		ПересчитатьПометкуГруппы(СтрокаГруппы);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппыТабличныхЧастей(ОМД, ИмяКоллекции, ИмяКоллекцииПолей, Помеченные, Исключённые)

	Коллекция = КоллекцияПолейОбъекта(ОМД, ИмяКоллекции);
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТабличнаяЧасть Из Коллекция Цикл
		ПоляЧасти = КоллекцияПолейОбъекта(ТабличнаяЧасть, ИмяКоллекцииПолей);
		Если ПоляЧасти = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаГруппы = Неопределено;
		Для Каждого Поле Из ПоляЧасти Цикл
			Если СтрокаГруппы = Неопределено Тогда
				СтрокаГруппы = ПоляОбъекта.ПолучитьЭлементы().Добавить();
				СтрокаГруппы.Имя = ТабличнаяЧасть.Имя;
				СтрокаГруппы.Синоним = ТабличнаяЧасть.Имя + " (табличная часть)";
				СтрокаГруппы.ПолноеИмя = "";
				СтрокаГруппы.ЭтоГруппа = Истина;
				СтрокаГруппы.ИндексКартинки = НомерКартинкиКоллекции(ИмяКоллекции);
			КонецЕсли;
			// M-21: формат имени поля ТЧ в политике — ПЛОСКОЕ имя поля: читатель
			// МаскиПолейТиповLLM сверяет поля с плоскими коллекциями метаданных, а
			// второй эшелон применяет маску по ключу строки ответа, который тоже
			// плоский. Пометка поля ТЧ, одноимённого полю шапки, закрывает оба —
			// об этом предупреждает СинхронизироватьПомеченныеПоля.
			ДобавитьСтрокуПоля(СтрокаГруппы, Поле, Поле.Имя, Помеченные, Исключённые);
		КонецЦикла;
		Если СтрокаГруппы <> Неопределено Тогда
			ПересчитатьПометкуГруппы(СтрокаГруппы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуПоля(СтрокаГруппы, Поле, ПлоскоеИмя, Помеченные, Исключённые)

	СтрокаПоля = СтрокаГруппы.ПолучитьЭлементы().Добавить();
	СтрокаПоля.Имя = Поле.Имя;
	СтрокаПоля.Синоним = ?(НЕ ПустаяСтрока(Поле.Синоним), Поле.Синоним, Поле.Имя);
	СтрокаПоля.ПолноеИмя = ПлоскоеИмя;
	СтрокаПоля.ЭтоГруппа = Ложь;
	СтрокаПоля.ИндексКартинки = СтрокаГруппы.ИндексКартинки;
	СтрокаПоля.Пометка = Помеченные.Получить(НормКлючФормы(ПлоскоеИмя)) <> Неопределено;
	СтрокаПоля.ВнеМаскирования = Исключённые.Получить(НормКлючФормы(ПлоскоеИмя)) <> Неопределено;

КонецПроцедуры

// Коллекция полей объекта метаданных по имени; отсутствующая у вида коллекция
// пропускается через Попытку — так же обходит поля privacy-движок.
&НаСервере
Функция КоллекцияПолейОбъекта(ОМД, ИмяКоллекции)

	Попытка
		Возврат ОМД[ИмяКоллекции];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеКоллекцииПолей(ИмяКоллекции)

	Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
		Возврат "Стандартные реквизиты";
	ИначеЕсли ИмяКоллекции = "РеквизитыАдресации" Тогда
		Возврат "Реквизиты адресации";
	ИначеЕсли ИмяКоллекции = "ПризнакиУчета" Тогда
		Возврат "Признаки учета";
	ИначеЕсли ИмяКоллекции = "ПризнакиУчетаСубконто" Тогда
		Возврат "Признаки учета субконто";
	КонецЕсли;
	Возврат ИмяКоллекции;

КонецФункции

&НаСервереБезКонтекста
Функция НомерКартинкиКоллекции(ИмяКоллекции)

	СоответствиеКартинок = Новый Соответствие;
	СоответствиеКартинок.Вставить("Реквизиты", 0);
	СоответствиеКартинок.Вставить("СтандартныеРеквизиты", 1);
	СоответствиеКартинок.Вставить("ТабличныеЧасти", 2);
	СоответствиеКартинок.Вставить("СтандартныеТабличныеЧасти", 3);
	СоответствиеКартинок.Вставить("РеквизитыАдресации", 1);
	СоответствиеКартинок.Вставить("Ресурсы", 4);
	СоответствиеКартинок.Вставить("Измерения", 1);
	СоответствиеКартинок.Вставить("ПризнакиУчета", 0);
	СоответствиеКартинок.Вставить("ПризнакиУчетаСубконто", 0);

	Номер = СоответствиеКартинок.Получить(ИмяКоллекции);
	Возврат ?(Номер = Неопределено, 0, Номер);

КонецФункции

// Пометка объекта левого дерева пользователем: 0 — снять всё, 1 — пометить все
// поля и псевдоним (у ссылочных). Каскад выполняется через построенную панель:
// состав полей объекта нужен в обоих случаях, а построение одного объекта
// дёшево (ленивость M-22 запрещает строить ВСЕ панели при открытии, не одну).
&НаСервере
Процедура ОбработатьПометкуОбъектаНаСервере(Ид)

	СтрокаДерева = ДеревоМетаданных.НайтиПоИдентификатору(Ид);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СтрокаДерева.ЭтоВид Тогда
		// Пометка вида — вычисляемый индикатор (А.10.2): правку отменяем.
		ПересчитатьПометкуВида(СтрокаДерева);
		Возврат;
	КонецЕсли;

	НоваяПометка = СтрокаДерева.Пометка % 2;
	СтрокаДерева.Пометка = НоваяПометка;

	ПостроитьПоляОбъектаНаСервере(Ид);

	// Массовая пометка НЕ ставит галки туда, где маска не работает или вредна:
	// колонка ВнеМаскирования заполнена построением панели. Точечно, руками,
	// пометить такое поле можно — пользователь может знать, зачем; но «пометить
	// всё» не должно набивать политику записями, о которых сервер тут же выдаст
	// предупреждения.
	ПометитьВсе = (НоваяПометка = 1);

	Для Каждого СтрокаГруппы Из ПоляОбъекта.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаПоля Из СтрокаГруппы.ПолучитьЭлементы() Цикл
			СтрокаПоля.Пометка = ПометитьВсе И НЕ СтрокаПоля.ВнеМаскирования;
		КонецЦикла;
		ПересчитатьПометкуГруппы(СтрокаГруппы);
	КонецЦикла;

	Если ПометитьВсе Тогда
		Если СтрокаДерева.ПсевдонимДоступен Тогда
			СтрокаДерева.Псевдоним = Истина;
			Если ПустаяСтрока(СтрокаДерева.Префикс) Тогда
				СтрокаДерева.Префикс = ЭтотОбъект().ПрефиксПоУмолчанию(СтрокаДерева.Имя);
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтрокаДерева.Псевдоним = Ложь;
		СтрокаДерева.Префикс = "";
	КонецЕсли;

	СинхронизироватьПомеченныеПоля(СтрокаДерева);
	// Итоговая пометка объекта — точным подсчётом по панели: после массовой
	// установки все маскируемые поля помечены, и объект честно показывает 1,
	// а не «частично» из-за пропущенных служебных полей. Пересчёт вида — внутри.
	УточнитьПометкуОбъектаПоПанели(СтрокаДерева);
	ПолитикаИзменена = Истина;

КонецПроцедуры

// Поля, которые массовая пометка обходит: нормализованное имя → Истина.
//
// Две причины исключения, обе выяснены живой проверкой BUH_KORP 11.08:
//
//   1. МАСКА НЕ ДЕЙСТВУЕТ. Числовое и булево поле сервер не закрывает —
//      подмены, которая не искажает, для них нет (null стёр бы значение).
//      Пометка «пометить всё» у справочника Банки давала четыре записи
//      (ПометкаУдаления, Предопределенный, ЭтоГруппа, РучноеИзменение) и
//      четыре предупреждения сервера на каждый ответ.
//
//   2. МАСКА ВРЕДНА. `Ссылка` и её навигационные соседи — не название, а
//      АДРЕС объекта: закрыв их, теряем uuid и navigation_url, то есть
//      легальный пользователь больше не может расшифровать псевдоним, открыв
//      объект в 1С. Смысл псевдонима обратный: ссылка остаётся, название
//      заменяется стабильным кодом. `ИмяПредопределенныхДанных` — техническое
//      имя, персональных данных не несёт.
&НаСервере
Функция ИменаПолейВнеМаскирования(ПолноеИмяТипа)

	Результат = Новый Соответствие;

	Для Каждого Имя Из СтрРазделить(
		"Ссылка,НавигационнаяСсылка,ИмяПредопределенныхДанных,Предопределенный", ",", Ложь) Цикл
		Результат.Вставить(НормКлючФормы(Имя), Истина);
	КонецЦикла;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
	Если ОМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Числовые и булевы поля — по описанию типов, как это видит сервер.
	Для Каждого ИмяКоллекции Из СтрРазделить(
		"Реквизиты,СтандартныеРеквизиты,Измерения,Ресурсы,РеквизитыАдресации,ПризнакиУчета,ПризнакиУчетаСубконто",
		",", Ложь) Цикл
		Коллекция = КоллекцияПолейОбъекта(ОМД, ИмяКоллекции);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Поле Из Коллекция Цикл
			Если ПолеТолькоЧислоИлиБулево(Поле) Тогда
				Результат.Вставить(НормКлючФормы(Поле.Имя), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого ИмяКоллекцииЧастей Из СтрРазделить("ТабличныеЧасти,СтандартныеТабличныеЧасти", ",", Ложь) Цикл
		Части = КоллекцияПолейОбъекта(ОМД, ИмяКоллекцииЧастей);
		Если Части = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Части Цикл
			Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,СтандартныеРеквизиты", ",", Ложь) Цикл
				Коллекция = КоллекцияПолейОбъекта(Часть, ИмяКоллекции);
				Если Коллекция = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого Поле Из Коллекция Цикл
					Если ПолеТолькоЧислоИлиБулево(Поле) Тогда
						Результат.Вставить(НормКлючФормы(Поле.Имя), Истина);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все типы поля — Число или Булево. Составной тип со строкой маскируется, поэтому
// исключается только поле, у которого строковой составляющей нет вовсе.
&НаСервереБезКонтекста
Функция ПолеТолькоЧислоИлиБулево(Поле)

	Попытка
		Типы = Поле.Тип.Типы();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Типы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Т Из Типы Цикл
		Если Т <> Тип("Число") И Т <> Тип("Булево") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Пометка правой панели — Булево (решение заказчика 11.08: пометка поля —
// бинарный факт). Каскад булев и живёт здесь, а не в модуле объекта: галка
// группы проставляет значение всем полям (исключённые ВнеМаскирования при
// установке не помечаются), галка поля пересчитывает агрегат группы. Затем
// плоский список помеченных синхронизируется в служебную колонку левой строки
// (§6.3: состояние живёт в левом дереве, правая панель лишь отображает).
&НаСервере
Процедура ОбработатьПометкуПоляНаСервере(Ид)

	ЭлементДанных = ПоляОбъекта.НайтиПоИдентификатору(Ид);
	Если ЭлементДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭлементДанных.ЭтоГруппа Тогда
		Для Каждого СтрокаПоля Из ЭлементДанных.ПолучитьЭлементы() Цикл
			СтрокаПоля.Пометка = ЭлементДанных.Пометка И НЕ СтрокаПоля.ВнеМаскирования;
		КонецЦикла;
		// Галка группы отскочит, только если маскируемых полей в ней нет вовсе.
		ПересчитатьПометкуГруппы(ЭлементДанных);
	Иначе
		РодительПоля = ЭлементДанных.ПолучитьРодителя();
		Если РодительПоля <> Неопределено Тогда
			ПересчитатьПометкуГруппы(РодительПоля);
		КонецЕсли;
	КонецЕсли;

	СтрокаДерева = ДеревоМетаданных.НайтиПоИдентификатору(ИдентификаторТекущегоОбъекта);
	Если СтрокаДерева = Неопределено ИЛИ СтрокаДерева.ЭтоВид Тогда
		Возврат;
	КонецЕсли;

	СинхронизироватьПомеченныеПоля(СтрокаДерева);
	УточнитьПометкуОбъектаПоПанели(СтрокаДерева);
	ПолитикаИзменена = Истина;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьПометкуСтрокиНаСервере(Ид)

	СтрокаДерева = ДеревоМетаданных.НайтиПоИдентификатору(Ид);
	Если СтрокаДерева = Неопределено ИЛИ СтрокаДерева.ЭтоВид Тогда
		Возврат;
	КонецЕсли;

	Если Ид = ИдентификаторТекущегоОбъекта Тогда
		УточнитьПометкуОбъектаПоПанели(СтрокаДерева);
	Иначе
		Если СтрокаДерева.Псевдоним ИЛИ НЕ ПустаяСтрока(СтрокаДерева.ПомеченныеПоля) Тогда
			СтрокаДерева.Пометка = 2;
		Иначе
			СтрокаДерева.Пометка = 0;
		КонецЕсли;
		ПересчитатьПометкуВида(СтрокаДерева.ПолучитьРодителя());
	КонецЕсли;

КонецПроцедуры

// Плоский список помеченных полей из правой панели → служебная колонка левой
// строки. Дубликаты плоских имён (поле ТЧ, одноимённое полю шапки) склеиваются
// — формат политики плоский (M-21), о коллизии предупреждаем.
&НаСервере
Процедура СинхронизироватьПомеченныеПоля(СтрокаДерева)

	Помеченные = Новый Массив;
	ИндексДобавленных = Новый Соответствие;
	ВсеИмена = Новый Соответствие;

	Для Каждого СтрокаГруппы Из ПоляОбъекта.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаПоля Из СтрокаГруппы.ПолучитьЭлементы() Цикл
			НормИмя = НормКлючФормы(СтрокаПоля.ПолноеИмя);
			ЧислоВхождений = ВсеИмена.Получить(НормИмя);
			ВсеИмена.Вставить(НормИмя, ?(ЧислоВхождений = Неопределено, 1, ЧислоВхождений + 1));
			Если СтрокаПоля.Пометка И ИндексДобавленных.Получить(НормИмя) = Неопределено Тогда
				// Значение — имя как в метаданных: предупреждение ниже показывает
				// его пользователю, а нормализованный ключ («значение», «имя»)
				// читается как чужое слово и путает.
				ИндексДобавленных.Вставить(НормИмя, СтрокаПоля.ПолноеИмя);
				Помеченные.Добавить(СтрокаПоля.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого КлючЗначение Из ИндексДобавленных Цикл
		Если ВсеИмена.Получить(КлючЗначение.Ключ) > 1 Тогда
			Сообщить("Поле «" + КлючЗначение.Значение + "» встречается в объекте несколько раз"
				+ " (шапка и табличная часть): политика хранит плоские имена, пометка"
				+ " закрывает все одноимённые поля.");
		КонецЕсли;
	КонецЦикла;

	СтрокаДерева.ПомеченныеПоля = СтрСоединить(Помеченные, ",");

КонецПроцедуры

// Точная пометка объекта — только при построенной панели: 1 требует знания
// числа МАСКИРУЕМЫХ полей. Исключённые (ВнеМаскирования) в знаменатель не идут,
// иначе состояние «помечено всё» было бы недостижимо из-за служебных полей;
// помеченное руками исключённое поле политику всё же делает непустой.
&НаСервере
Процедура УточнитьПометкуОбъектаПоПанели(СтрокаДерева)

	ВсегоМаскируемых = 0;
	ПомеченоМаскируемых = 0;
	ЕстьПомеченные = Ложь;
	Для Каждого СтрокаГруппы Из ПоляОбъекта.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаПоля Из СтрокаГруппы.ПолучитьЭлементы() Цикл
			ЕстьПомеченные = ЕстьПомеченные ИЛИ СтрокаПоля.Пометка;
			Если НЕ СтрокаПоля.ВнеМаскирования Тогда
				ВсегоМаскируемых = ВсегоМаскируемых + 1;
				Если СтрокаПоля.Пометка Тогда
					ПомеченоМаскируемых = ПомеченоМаскируемых + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ПсевдонимУчтен = НЕ СтрокаДерева.ПсевдонимДоступен ИЛИ СтрокаДерева.Псевдоним;

	Если НЕ ЕстьПомеченные И НЕ СтрокаДерева.Псевдоним Тогда
		СтрокаДерева.Пометка = 0;
	ИначеЕсли ВсегоМаскируемых > 0 И ПомеченоМаскируемых = ВсегоМаскируемых И ПсевдонимУчтен Тогда
		СтрокаДерева.Пометка = 1;
	Иначе
		СтрокаДерева.Пометка = 2;
	КонецЕсли;

	ПересчитатьПометкуВида(СтрокаДерева.ПолучитьРодителя());

КонецПроцедуры

// Булева галка группы правой панели: Истина — помечены ВСЕ маскируемые поля
// группы. Исключённые (ВнеМаскирования) в счёт не идут — с ними галка была бы
// недостижима у групп со служебными полями. Состояния «частично» у групп нет
// (решение заказчика 11.08: пометка — бинарный факт); частичность типа
// показывает квадратик в левом дереве.
&НаСервере
Процедура ПересчитатьПометкуГруппы(СтрокаГруппы)

	ЕстьМаскируемые = Ложь;
	ВсеПомечены = Истина;
	Для Каждого СтрокаПоля Из СтрокаГруппы.ПолучитьЭлементы() Цикл
		Если СтрокаПоля.ВнеМаскирования Тогда
			Продолжить;
		КонецЕсли;
		ЕстьМаскируемые = Истина;
		ВсеПомечены = ВсеПомечены И СтрокаПоля.Пометка;
	КонецЦикла;

	СтрокаГруппы.Пометка = ЕстьМаскируемые И ВсеПомечены;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьПометкуВида(СтрокаВида)

	Если СтрокаВида = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВсеПомечены = Истина;
	ЕстьПомеченные = Ложь;
	Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
		ВсеПомечены = ВсеПомечены И (СтрокаОбъекта.Пометка = 1);
		ЕстьПомеченные = ЕстьПомеченные ИЛИ (СтрокаОбъекта.Пометка > 0);
	КонецЦикла;

	Если ЕстьПомеченные И ВсеПомечены Тогда
		СтрокаВида.Пометка = 1;
	ИначеЕсли ЕстьПомеченные Тогда
		СтрокаВида.Пометка = 2;
	Иначе
		СтрокаВида.Пометка = 0;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИндексПомеченныхПолей(СтрокаПомеченных)

	Индекс = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(СтрокаПомеченных, ",", Ложь) Цикл
		НормИмя = НормКлючФормы(Имя);
		Если НЕ ПустаяСтрока(НормИмя) Тогда
			Индекс.Вставить(НормИмя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

#КонецОбласти

#Область СборкаИЗаписьПолитики

// Сборка секции privacy из формы (§6.5). Рубильник enabled сюда НЕ входит —
// он живёт в MCP_ServerConfig (§3.2) и обработкой не пишется.
&НаСервере
Функция СобратьПолитику(ТекстОшибкиСборки)

	ТекстОшибкиСборки = "";
	Privacy = Новый Соответствие;

	МассивПолей = Новый Массив;
	Для Каждого СтрокаТаблицы Из МаскируемыеПоля Цикл
		ИмяПоля = СокрЛП(СтрокаТаблицы.ИмяПоля);
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			МассивПолей.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Если МассивПолей.Количество() > 0 Тогда
		Privacy.Вставить("masked_fields", МассивПолей);
	КонецЕсли;

	Псевдонимы = Новый Массив;
	Маски = Новый Массив;
	ПрефиксыНРег = Новый Соответствие;

	Для Каждого СтрокаВида Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл

			Если СтрокаОбъекта.Псевдоним Тогда
				Префикс = СокрЛП(СтрокаОбъекта.Префикс);
				Если ПустаяСтрока(Префикс) Тогда
					ТекстОшибкиСборки = "У типа " + СтрокаОбъекта.ПолноеИмя
						+ " включён псевдоним, но не задан префикс. Запись не выполнена.";
					Возврат "";
				КонецЕсли;
				Если ПрефиксыНРег.Получить(НРег(Префикс)) <> Неопределено Тогда
					Сообщить("Префикс «" + Префикс + "» задан нескольким типам —"
						+ " сервер применит только первую запись, остальные отклонит.");
				КонецЕсли;
				ПрефиксыНРег.Вставить(НРег(Префикс), Истина);

				Запись = Новый Соответствие;
				Запись.Вставить("type", СтрокаОбъекта.ПолноеИмя);
				Запись.Вставить("prefix", Префикс);
				СлитьДопКлючи(Запись, СтрокаОбъекта.ДопКлючиПсевдонимаJSON);
				Псевдонимы.Добавить(Запись);
			КонецЕсли;

			Если НЕ ПустаяСтрока(СтрокаОбъекта.ПомеченныеПоля) Тогда
				ПоляЗаписи = Новый Массив;
				Для Каждого Имя Из СтрРазделить(СтрокаОбъекта.ПомеченныеПоля, ",", Ложь) Цикл
					ИмяПоля = СокрЛП(Имя);
					Если НЕ ПустаяСтрока(ИмяПоля) Тогда
						ПоляЗаписи.Добавить(ИмяПоля);
					КонецЕсли;
				КонецЦикла;
				Если ПоляЗаписи.Количество() > 0 Тогда
					Запись = Новый Соответствие;
					Запись.Вставить("type", СтрокаОбъекта.ПолноеИмя);
					Запись.Вставить("fields", ПоляЗаписи);
					СлитьДопКлючи(Запись, СтрокаОбъекта.ДопКлючиМаскиJSON);
					Маски.Добавить(Запись);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	// Записи вне этой конфигурации сохраняются как есть (M-23): политика
	// переносима между контурами, молчаливая потеря записи — тихая утечка.
	Для Каждого ВнешняяЗапись Из ЗаписиВнеКонфигурации Цикл
		Запись = Новый Соответствие;
		Запись.Вставить("type", ВнешняяЗапись.Тип);
		Если ВнешняяЗапись.Раздел = "type_aliases" Тогда
			Запись.Вставить("prefix", ВнешняяЗапись.Префикс);
			СлитьДопКлючи(Запись, ВнешняяЗапись.ДопКлючиJSON);
			Псевдонимы.Добавить(Запись);
		Иначе
			ПоляЗаписи = Новый Массив;
			Для Каждого Имя Из СтрРазделить(ВнешняяЗапись.Поля, ",", Ложь) Цикл
				ИмяПоля = СокрЛП(Имя);
				Если НЕ ПустаяСтрока(ИмяПоля) Тогда
					ПоляЗаписи.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЦикла;
			Запись.Вставить("fields", ПоляЗаписи);
			СлитьДопКлючи(Запись, ВнешняяЗапись.ДопКлючиJSON);
			Маски.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Если Псевдонимы.Количество() > 0 Тогда
		Privacy.Вставить("type_aliases", Псевдонимы);
	КонецЕсли;
	Если Маски.Количество() > 0 Тогда
		Privacy.Вставить("type_field_masks", Маски);
	КонецЕсли;
	Privacy.Вставить("publish_details", ПубликоватьДетали);

	// Round-trip неизвестных ключей (M-14).
	Если НЕ ПустаяСтрока(ПрочиеКлючиPrivacyJSON) Тогда
		Попытка
			Прочие = ПрочитатьJSONТекст(ПрочиеКлючиPrivacyJSON);
			Если ЭтоОбъектJSONФормы(Прочие) Тогда
				Для Каждого КлючЗначение Из Прочие Цикл
					Если Privacy.Получить(Строка(КлючЗначение.Ключ)) = Неопределено Тогда
						Privacy.Вставить(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Сообщить("Прочие ключи privacy не разобраны и не сохранены: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Корень = Новый Соответствие;
	Корень.Вставить("privacy", Privacy);

	Возврат ЗаписатьJSONВСтроку(Корень, Истина);

КонецФункции

// Запись политики в предопределённый элемент и немедленный показ результата
// применения (M-24): пользователь видит, как сервер понял его политику, без
// ручной пробы после каждой правки.
&НаСервере
Функция ЗаписатьПолитикуНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщения", Новый Массив);

	ТекстОшибкиСборки = "";
	ТекстПолитики = СобратьПолитику(ТекстОшибкиСборки);
	Если НЕ ПустаяСтрока(ТекстОшибкиСборки) Тогда
		Результат.Сообщения.Добавить(ТекстОшибкиСборки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗаписатьТекстПолитикиВСправочник(ТекстПолитики);
	Исключение
		Результат.Сообщения.Добавить("Запись политики не выполнена: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	ПолитикаИзменена = Ложь;
	ЕстьОшибка = Ложь;
	ТекстОшибки = "";
	Элементы.ТекстОшибки.Видимость = Ложь;
	ПредпросмотрJSON = ТекстПолитики;
	ОбновитьПанельНастроек();

	// M-24: результат применения — глазами сервера.
	Попытка
		Информация = MCP_Config.ИнформацияМаскированияLLM();
	Исключение
		Результат.Сообщения.Добавить("Политика записана, но прочитать результат применения не удалось: "
			+ ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Ревизия движка в отчёте обязательна: 11.08 два контура приняли политику в
	// справочник, а считал её старый движок из MCP_ServerConfig — отчёт «применено
	// 0/0/0» выглядел как потеря пометок, и различить сборки было нечем.
	//
	// Диагностики «движок не читает справочник» здесь больше нет: обработка —
	// объект расширения и приезжает ТОЛЬКО вместе с его модулями, а несовпадение
	// версий валит компиляцию этого модуля громко (прямой вызов несуществующего
	// метода), а не молча. Ревизия остаётся — по ней отчёт сверяется с гейтом.
	Ревизия = "";
	Попытка
		Ревизия = Строка(Информация.engine_revision);
	Исключение
		Ревизия = "неизвестна";
	КонецПопытки;

	Результат.Сообщения.Добавить("Политика записана. Маскирование: "
		+ ?(Информация.enabled, "ВКЛЮЧЕНО", "выключено")
		+ ". Ревизия движка: " + Ревизия + ".");
	Результат.Сообщения.Добавить("Применено: псевдонимов типов — "
		+ Информация.type_aliases.entries.Количество()
		+ ", масок полей типов — " + Информация.type_field_masks.entries.Количество()
		+ ", плоских маскируемых полей — " + Информация.masked_fields.Количество() + ".");
	Если НЕ Информация.enabled
		И Информация.type_field_masks.entries.Количество()
			+ Информация.type_aliases.entries.Количество()
			+ Информация.masked_fields.Количество() > 0 Тогда
		// Записи есть, а маскирование выключено — значит выключен рубильник.
		// Без этой строки «выключено» при непустой политике читается как потеря
		// пометок (§3.2: рубильник живёт в константе и обработкой не пишется).
		Результат.Сообщения.Добавить("Политика непуста, но применение выключено рубильником:"
			+ " privacy.enabled = false в константе MCP_ServerConfig.");
	КонецЕсли;
	Для Каждого Предупреждение Из Информация.config_warnings Цикл
		Результат.Сообщения.Добавить("Предупреждение: " + Предупреждение);
	КонецЦикла;
	Для Каждого Ошибка Из Информация.config_errors Цикл
		Результат.Сообщения.Добавить("ОШИБКА: " + Ошибка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запись целиком в единственный предопределённый элемент, в привилегированном
// режиме (А.10.4): построчных записей, как в заготовке, здесь нет.
&НаСервереБезКонтекста
Процедура ЗаписатьТекстПолитикиВСправочник(ТекстПолитики)

	ИмяСправочника = "MCP_Маскирование";
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		ВызватьИсключение "Справочник " + ИмяСправочника + " не найден в конфигурации.";
	КонецЕсли;

	// Режим снимается и на пути исключения — оставлять его включённым после
	// неудачной записи нельзя.
	БылПривилегированный = ПривилегированныйРежим();
	Если НЕ БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 "
			+ "Т.Ссылка КАК Ссылка "
			+ "ИЗ Справочник." + ИмяСправочника + " КАК Т "
			+ "ГДЕ Т.ИмяПредопределенныхДанных = &ИмяЭлемента";
		Запрос.УстановитьПараметр("ИмяЭлемента", "НастройкиМаскирования");
		Выборка = Запрос.Выполнить().Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			ВызватьИсключение "Предопределённый элемент НастройкиМаскирования не найден.";
		КонецЕсли;

		ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементОбъект.Значение = ТекстПолитики;
		ЭлементОбъект.Записать();
	Исключение
		Если НЕ БылПривилегированный Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если НЕ БылПривилегированный Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьВсеНаСервере()

	ОчиститьФормуОтПолитики();
	ИдентификаторТекущегоОбъекта = 0;
	ПолитикаИзменена = Истина;
	ОбновитьПанельНастроек();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельНастроекНаСервере()

	ОбновитьПанельНастроек();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельНастроек()

	// Предпросмотр пересобирается из формы без записи (А.4). Ошибка сборки —
	// тоже информация: её видно там же, где ждали JSON.
	ТекстОшибкиСборки = "";
	Текст = СобратьПолитику(ТекстОшибкиСборки);
	Если ПустаяСтрока(ТекстОшибкиСборки) Тогда
		ПредпросмотрJSON = Текст;
	Иначе
		ПредпросмотрJSON = "Сборка политики невозможна: " + ТекстОшибкиСборки;
	КонецЕсли;

	ОбновитьСостояниеРубильника();

КонецПроцедуры

// Флажок статуса и подпись под него. Значение читается у ДВИЖКА
// (MCP_Config.МаскированиеВключено), а не из константы напрямую: у чтения есть
// дефолты (ключа/секции/константы нет либо JSON нечитаем → Истина, fail-closed),
// и флажок обязан показывать то, чем руководствуется сервер, а не то, что лежит
// в тексте настройки.
&НаСервере
Процедура ОбновитьСостояниеРубильника()

	Попытка
		МаскированиеВключено = MCP_Config.МаскированиеВключено();
	Исключение
		МаскированиеВключено = Истина;
	КонецПопытки;

	// Пустая политика делает рубильник холостым: гасить нечего. Оговорка нужна,
	// иначе «включено» при нуле записей читается как обещание защиты.
	ЕстьЗаписиПолитики = ЕстьХотяБыОднаЗаписьПолитики();

	Если МаскированиеВключено И ЕстьЗаписиПолитики Тогда
		Состояние = "включено — применяется помеченный состав";
	ИначеЕсли МаскированиеВключено Тогда
		Состояние = "включено, но политика пуста — маскировать нечего";
	Иначе
		Состояние = "ВЫКЛЮЧЕНО — значения возвращаются открытыми";
	КонецЕсли;

	Элементы.НадписьРубильник.Заголовок = "Рубильник privacy.enabled (MCP_ServerConfig): "
		+ Состояние + ". Переключается кнопкой «" + ЗаголовокКнопкиРубильника(МаскированиеВключено)
		+ "»; состав политики при переключении сохраняется.";
	Элементы.ПереключитьРубильник.Заголовок = ЗаголовокКнопкиРубильника(МаскированиеВключено);

КонецПроцедуры

// Есть ли в форме хоть одна запись политики: пометка поля либо псевдоним типа
// либо плоское маскируемое поле. Считается по форме, а не по ответу движка:
// панель обновляется и до записи.
&НаСервере
Функция ЕстьХотяБыОднаЗаписьПолитики()

	Если МаскируемыеПоля.Количество() > 0 ИЛИ ЗаписиВнеКонфигурации.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого СтрокаВида Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из СтрокаВида.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.Псевдоним ИЛИ НЕ ПустаяСтрока(СтрокаОбъекта.ПомеченныеПоля) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокКнопкиРубильника(Включено)

	Возврат ?(Включено, "Выключить маскирование", "Включить маскирование");

КонецФункции

#КонецОбласти

#Область Рубильник

// Переключение рубильника privacy.enabled в константе MCP_ServerConfig.
//
// До 12.08 обработка константу не писала: §3.2 запрещал это из-за риска
// повредить limits/http при перезаписи JSON. Требование заказчика 12.08 —
// переключать кнопкой из обработки, и риск снят механикой записи (§3.2, M-27):
// текст константы РАЗБИРАЕТСЯ, меняется единственный ключ privacy.enabled,
// остальное сериализуется обратно как есть; неразобранный JSON — отказ от записи,
// а не перезапись.
//
// Состав политики рубильник не трогает: он живёт в справочнике. Это отличие от
// прежней внешней админ-формы, где privacy.enabled собирался движком как
// дизъюнкция пяти секций и «выключить» означало опустошить их (с копией в
// privacy.disabled_backup). Теперь рубильник — самостоятельный булев ключ,
// и выключение обратимо без сохранения состава.
&НаКлиенте
Процедура ПереключитьРубильник(Команда)

	Если МаскированиеВключено Тогда
		// Выключение открывает данные — спрашиваем. Включение не спрашиваем:
		// оно ужесточает режим.
		Оповещение = Новый ОписаниеОповещения("ПереключитьРубильникЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Выключить маскирование? Значения будут возвращаться клиентам ОТКРЫТЫМИ."
				+ " Состав политики сохранится и включится обратно этой же кнопкой.",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаписатьРубильникКлиент(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРубильникЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаписатьРубильникКлиент(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРубильникКлиент(НовоеЗначение)

	Результат = ЗаписатьРубильникНаСервере(НовоеЗначение);
	Для Каждого Строчка Из Результат.Сообщения Цикл
		Сообщить(Строчка);
	КонецЦикла;

КонецПроцедуры

// Право проверяется явно, привилегированный режим НЕ включается: рубильник —
// средство безопасности, и поднимать права ради его переключения означало бы
// разрешить выключение маскирования тому, кому запись константы не доверена.
&НаСервере
Функция ЗаписатьРубильникНаСервере(НовоеЗначение)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщения", Новый Массив);

	Если НЕ ПравоАдминистратораMCP() Тогда
		Результат.Сообщения.Добавить("Недостаточно прав: переключение рубильника доступно"
			+ " администратору (право «Администрирование» либо «АдминистрированиеДанных»).");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Настройки = ПрочитатьНастройкиСервера();
	Исключение
		Результат.Сообщения.Добавить("Рубильник не переключён: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Privacy = Настройки.Получить("privacy");
	Если ТипЗнч(Privacy) <> Тип("Соответствие") Тогда
		Privacy = Новый Соответствие;
	КонецЕсли;
	Privacy.Вставить("enabled", НовоеЗначение);
	Настройки.Вставить("privacy", Privacy);

	Попытка
		ЗаписатьНастройкиСервера(Настройки);
	Исключение
		Результат.Сообщения.Добавить("Не удалось записать MCP_ServerConfig: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	ОбновитьСостояниеРубильника();

	// Подтверждение читается у движка, а не у формы: расхождение «записали одно,
	// сервер видит другое» обязано быть видно сразу.
	Результат.Сообщения.Добавить("privacy.enabled = " + ?(НовоеЗначение, "true", "false")
		+ " записан в MCP_ServerConfig. Движок сейчас видит: "
		+ ?(МаскированиеВключено, "маскирование включено", "маскирование выключено") + ".");
	Если НовоеЗначение И НЕ ЕстьХотяБыОднаЗаписьПолитики() Тогда
		Результат.Сообщения.Добавить("Политика пуста: рубильник включён, но маскировать нечего —"
			+ " отметьте поля и нажмите «Записать».");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Чтение константы под перезапись. Не-JSON и не-объект — исключение: перезапись
// такого текста уничтожила бы limits/http (образец из прежней админ-формы).
&НаСервереБезКонтекста
Функция ПрочитатьНастройкиСервера()

	Если Метаданные.Константы.Найти("MCP_ServerConfig") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет константы MCP_ServerConfig.";
	КонецЕсли;

	Текст = Строка(Константы["MCP_ServerConfig"].Получить());
	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Попытка
		Разобранное = ПрочитатьJSONТекст(Текст);
	Исключение
		ВызватьИсключение "константа MCP_ServerConfig содержит нечитаемый JSON ("
			+ ОписаниеОшибки()
			+ "). Запись отменена, чтобы не потерять секции limits/http —"
			+ " исправьте текст константы и повторите.";
	КонецПопытки;

	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		ВызватьИсключение "константа MCP_ServerConfig не содержит JSON-объект. Запись отменена,"
			+ " чтобы не потерять её содержимое.";
	КонецЕсли;

	Возврат Разобранное;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьНастройкиСервера(Настройки)

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Константы["MCP_ServerConfig"].Установить(Запись.Закрыть());

КонецПроцедуры

// ПравоДоступа принимает право и объект метаданных; «Администрирование» и
// «АдминистрированиеДанных» относятся к конфигурации целиком, поэтому вторым
// аргументом идёт Метаданные. Проверка недоступна — решают роли на объекте.
&НаСервереБезКонтекста
Функция ПравоАдминистратораMCP()

	Попытка
		Возврат ПравоДоступа("Администрирование", Метаданные)
			ИЛИ ПравоДоступа("АдминистрированиеДанных", Метаданные);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область РаботаСJSON

&НаСервереБезКонтекста
Функция ПрочитатьJSONТекст(Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

// Сериализация с отступами (§6.5): текст политики человекочитаем и диффится в
// истории справочника.
&НаСервереБезКонтекста
Функция ЗаписатьJSONВСтроку(Значение, СОтступами)

	ЗаписьJSON = Новый ЗаписьJSON;
	Если СОтступами Тогда
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ", Истина);
	Иначе
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Ложь);
	КонецЕсли;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоОбъектJSONФормы(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие");

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеJSONФормы(Объект, Имя, ПоУмолчанию = Неопределено)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

&НаСервереБезКонтекста
Функция СтрокаJSONФормы(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

&НаСервереБезКонтекста
Функция БулевоJSONФормы(Значение, ПоУмолчанию)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если Текст = "TRUE" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "1" ИЛИ Текст = "YES" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Текст = "FALSE" ИЛИ Текст = "ЛОЖЬ" ИЛИ Текст = "0" ИЛИ Текст = "NO" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Нормализация имён — та же, что у серверных читателей политики: регистр,
// пробелы, `_`, `-`, `.` и `ё` не значимы. Реализована здесь, а не вызовом
// MCP_Config.НормализоватьКлючPrivacy, потому что функция клиент-серверная
// (&НаКлиентеНаСервереБезКонтекста), а MCP_Config — серверный модуль и на
// клиенте недоступен. Правило нормализации зафиксировано круговым портом
// (scripts/privacy_form_roundtrip_port.mjs): расхождение с серверным читателем
// ловится офлайн.
&НаКлиентеНаСервереБезКонтекста
Функция НормКлючФормы(Имя)

	// Порядок и состав шагов — копия MCP_Config.НормализоватьКлючPrivacy,
	// включая отсечение суффикса дубликата колонки («Наименование#2»): иначе
	// пометка поля не нашла бы свою запись политики.
	Текст = НРег(СокрЛП(Строка(?(Имя = Неопределено, "", Имя))));
	ПозДубликата = СтрНайти(Текст, "#");
	Если ПозДубликата > 1 Тогда
		Текст = Лев(Текст, ПозДубликата - 1);
	КонецЕсли;

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Текст = СтрЗаменить(Текст, "_", "");
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, ".", "");
	Возврат СтрЗаменить(Текст, "ё", "е");

КонецФункции

// Дополнительные ключи записи политики (core_whitelist_foreign и т.п., M-14):
// обработка их не редактирует, но обязана сохранять при перезаписи.
&НаСервереБезКонтекста
Функция ДопКлючиЗаписиJSON(Запись, СписокИсключаемых)

	Исключаемые = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(СписокИсключаемых, ",", Ложь) Цикл
		Исключаемые.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

	Прочие = Новый Соответствие;
	Для Каждого КлючЗначение Из Запись Цикл
		ИмяКлюча = Строка(КлючЗначение.Ключ);
		Если Исключаемые.Получить(НРег(ИмяКлюча)) = Неопределено Тогда
			Прочие.Вставить(ИмяКлюча, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Если Прочие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ЗаписатьJSONВСтроку(Прочие, Ложь);

КонецФункции

&НаСервереБезКонтекста
Процедура СлитьДопКлючи(Запись, ТекстJSON)

	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Прочие = ПрочитатьJSONТекст(ТекстJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если НЕ ЭтоОбъектJSONФормы(Прочие) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из Прочие Цикл
		Если Запись.Получить(Строка(КлючЗначение.Ключ)) = Неопределено Тогда
			Запись.Вставить(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
