// MCP_HTTPService.bsl
// ====================================================================
// HTTP-сервис "MCP". Точка входа MCP-сервера.
// URL: http(s)://<сервер>/<база>/hs/mcp/rpc
//
// Шаблон URL: /rpc
//   POST  -> POST_rpc
//   GET   -> GET_rpc (Streamable HTTP без server-to-client SSE: 405)
//   DELETE -> DELETE_rpc (stateless endpoint: 405)
//   OPTIONS -> OPTIONS_rpc (для CORS preflight, опционально)
// ====================================================================

// Обработчик POST /rpc
Функция POST_rpc(Запрос) Экспорт

	// Не зависит от MCP_Audit: частичная публикация не должна остановить endpoint.
	СтартВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РазмерТекстаЗапроса = Неопределено;
	Ответ = Новый HTTPСервисОтвет(200);
	ЗаполнитьБазовыеЗаголовки(Ответ, Запрос);

	Если НЕ OriginРазрешен(Запрос) Тогда
		Ответ = СформироватьОтветForbiddenOrigin(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "origin_rejected", РазмерТекстаЗапроса);
		Возврат Ответ;
	КонецЕсли;

	Если НЕ ВерсияПротоколаРазрешена(Запрос) Тогда
		Ответ = СформироватьОтветНеподдерживаемаяВерсия(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "protocol_version_rejected", РазмерТекстаЗапроса);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		ТекстЗапроса = Запрос.ПолучитьТелоКакСтроку();
		РазмерТекстаЗапроса = СтрДлина(ТекстЗапроса);
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSONRPC(Null, -32700, "Parse error: empty body"));
			БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "empty_body", РазмерТекстаЗапроса);
			Возврат Ответ;
		КонецЕсли;

		ТелоОтвета = MCP_JSONRPC.ОбработатьЗапрос(ТекстЗапроса);
		// Streamable HTTP: JSON-RPC notifications/responses принимаются как 202 без тела.
		Если ПустаяСтрока(ТелоОтвета) Тогда
			Ответ.КодСостояния = 202;
			БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "notification", РазмерТекстаЗапроса);
			Возврат Ответ;
		КонецЕсли;
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ТелоОтвета);

	Исключение
		// Текст исключения не возвращаем клиенту, чтобы не светить внутренние детали.
		Попытка
			ЗаписьЖурналаРегистрации("MCP.http_service.error",
				УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		Исключение
			// Логирование само могло упасть (например, при отсутствии прав на запись в ЖР) —
			// не позволяем этому сорвать формирование ответа клиенту.
		КонецПопытки;
		Ответ.КодСостояния = 500;
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Попытка
			Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSONRPC(Null, -32603, "Internal error"));
		Исключение
			// Крайний fallback: статическое тело без сериализации.
			Ответ.УстановитьТелоИзСтроки("{""jsonrpc"":""2.0"",""id"":null,""error"":{""code"":-32603,""message"":""Internal error""}}");
		КонецПопытки;
	КонецПопытки;

	БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс,
		?(Ответ.КодСостояния >= 500, "internal_error", "success"), РазмерТекстаЗапроса);
	Возврат Ответ;

КонецФункции

// Аудит входящего HTTP-запроса не влияет на обработку запроса или ответ клиенту.
Процедура БезопасноЗаписатьHTTPЗапрос(КодСостояния, СтартВыполненияМс, Исход, РазмерТелаСимволов, МетодHTTP = "POST")

	Попытка
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - СтартВыполненияМс;
		MCP_Audit.ЗаписатьHTTPЗапрос(КодСостояния, ДлительностьМс, Исход, РазмерТелаСимволов, МетодHTTP);
	Исключение
		Попытка
			ЗаписьЖурналаРегистрации("MCP.http_audit.failed",
				УровеньЖурналаРегистрации.Предупреждение, , , ОписаниеОшибки());
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Обработчик GET /rpc.
// Сервер не открывает отдельный SSE-канал, поэтому Streamable HTTP требует 405.
Функция GET_rpc(Запрос) Экспорт

	СтартВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если НЕ OriginРазрешен(Запрос) Тогда
		Ответ = СформироватьОтветForbiddenOrigin(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "origin_rejected", Неопределено, "GET");
		Возврат Ответ;
	КонецЕсли;

	Если НЕ ВерсияПротоколаРазрешена(Запрос) Тогда
		Ответ = СформироватьОтветНеподдерживаемаяВерсия(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "protocol_version_rejected", Неопределено, "GET");
		Возврат Ответ;
	КонецЕсли;

	Ответ = СформироватьОтветМетодНеРазрешен(Запрос);
	БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "method_not_allowed", Неопределено, "GET");
	Возврат Ответ;

КонецФункции

// Обработчик DELETE /rpc.
// Сессии на уровне транспорта не создаются, поэтому клиенту нечего завершать.
Функция DELETE_rpc(Запрос) Экспорт

	СтартВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если НЕ OriginРазрешен(Запрос) Тогда
		Ответ = СформироватьОтветForbiddenOrigin(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "origin_rejected", Неопределено, "DELETE");
		Возврат Ответ;
	КонецЕсли;

	Если НЕ ВерсияПротоколаРазрешена(Запрос) Тогда
		Ответ = СформироватьОтветНеподдерживаемаяВерсия(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "protocol_version_rejected", Неопределено, "DELETE");
		Возврат Ответ;
	КонецЕсли;

	Ответ = СформироватьОтветМетодНеРазрешен(Запрос);
	БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "method_not_allowed", Неопределено, "DELETE");
	Возврат Ответ;

КонецФункции

// Обработчик OPTIONS /rpc (CORS preflight).
Функция OPTIONS_rpc(Запрос) Экспорт

	СтартВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = Новый HTTPСервисОтвет(204);
	ЗаполнитьБазовыеЗаголовки(Ответ, Запрос);
	Если НЕ OriginРазрешен(Запрос) Тогда
		Ответ = СформироватьОтветForbiddenOrigin(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "origin_rejected", Неопределено, "OPTIONS");
		Возврат Ответ;
	КонецЕсли;
	Если НЕ ВерсияПротоколаРазрешена(Запрос) Тогда
		Ответ = СформироватьОтветНеподдерживаемаяВерсия(Запрос);
		БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "protocol_version_rejected", Неопределено, "OPTIONS");
		Возврат Ответ;
	КонецЕсли;
	Ответ.Заголовки.Вставить("Access-Control-Max-Age", "86400");
	БезопасноЗаписатьHTTPЗапрос(Ответ.КодСостояния, СтартВыполненияМс, "success", Неопределено, "OPTIONS");
	Возврат Ответ;

КонецФункции

// ---- Helpers ----------------------------------------------------

Процедура ЗаполнитьБазовыеЗаголовки(Ответ, Запрос)

	Origin = ЗаголовокЗапроса(Запрос, "Origin");
	Если ПустаяСтрока(Origin) Тогда
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	ИначеЕсли OriginРазрешен(Запрос) Тогда
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", Origin);
		Ответ.Заголовки.Вставить("Vary", "Origin");
	Иначе
		Ответ.Заголовки.Вставить("Vary", "Origin");
	КонецЕсли;

	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, GET, DELETE, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers",
		"Content-Type, Authorization, Accept, MCP-Protocol-Version, MCP-Session-Id, Last-Event-ID");
	Ответ.Заголовки.Вставить("Access-Control-Expose-Headers", "MCP-Session-Id");
	Ответ.Заголовки.Вставить("Cache-Control", "no-cache");

КонецПроцедуры

Функция СформироватьОтветМетодНеРазрешен(Запрос)

	Ответ = Новый HTTPСервисОтвет(405);
	ЗаполнитьБазовыеЗаголовки(Ответ, Запрос);
	Ответ.Заголовки.Вставить("Allow", "POST, GET, DELETE, OPTIONS");
	Возврат Ответ;

КонецФункции

Функция СформироватьОтветForbiddenOrigin(Запрос)

	Ответ = Новый HTTPСервисОтвет(403);
	ЗаполнитьБазовыеЗаголовки(Ответ, Запрос);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSONRPC(Null, -32000, "Forbidden Origin"));
	Возврат Ответ;

КонецФункции

Функция СформироватьОтветНеподдерживаемаяВерсия(Запрос)

	Ответ = Новый HTTPСервисОтвет(400);
	ЗаполнитьБазовыеЗаголовки(Ответ, Запрос);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSONRPC(Null, -32000, "Unsupported MCP-Protocol-Version"));
	Возврат Ответ;

КонецФункции

Функция OriginРазрешен(Запрос)

	Origin = ЗаголовокЗапроса(Запрос, "Origin");
	Если ПустаяСтрока(Origin) Тогда
		Возврат Истина;
	КонецЕсли;

	РазрешенныеOrigins = MCP_Config.РазрешенныеOriginsMCP();
	Если РазрешенныеOrigins.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого РазрешенныйOrigin Из РазрешенныеOrigins Цикл
		Если Строка(РазрешенныйOrigin) = "*" Тогда
			Возврат Истина;
		КонецЕсли;
		Если ВРег(Строка(РазрешенныйOrigin)) = ВРег(Origin) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВерсияПротоколаРазрешена(Запрос)

	Версия = ЗаголовокЗапроса(Запрос, "MCP-Protocol-Version");
	Если ПустаяСтрока(Версия) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат MCP_Config.ВерсияПротоколаMCPПоддерживается(Версия);

КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)

	Попытка
		Заголовки = Запрос.Заголовки;
	Исключение
		Возврат "";
	КонецПопытки;

	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Для Каждого КЗ Из Заголовки Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ВРег(Имя) Тогда
				Возврат Строка(КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Попытка
			Значение = Заголовки.Получить(Имя);
			Если Значение <> Неопределено Тогда
				Возврат Строка(Значение);
			КонецЕсли;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;

	Возврат "";

КонецФункции

Функция СформироватьОшибкуJSONRPC(ID, Код, Сообщение, Данные = Неопределено)

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Если Данные <> Неопределено Тогда
		Ошибка.Вставить("data", Данные);
	КонецЕсли;

	// Прямой ЗаписатьJSON по структуре с Null в свойстве падает: на контуре
	// (БП КОРП 3.0.192.25, платформа 8.3.27.2130) это давало
	// «{MCP HTTPСервис.MCP.Модуль(255)}: Ошибка при вызове метода контекста
	// (ЗаписатьJSON)», из-за чего ветка отказа не доходила до своего HTTPСервисОтвет
	// и клиент получал HTTP 500 с платформенным текстом вместо объявленного ответа.
	// Поражены были все четыре вызова этой функции: -32700 (пустое тело), -32603,
	// -32000 Forbidden Origin и -32000 Unsupported MCP-Protocol-Version.
	//
	// Сериализация идёт через MCP_JSONRPC.СохранитьJSON — тот же путь, которым
	// отдаются штатные ответы: он прогоняет значение через ПодготовитьКЗаписиJSON,
	// где Null приводится к Неопределено, и потому исключения не даёт. Побочный
	// эффект того же приведения — свойство с Null пропадает из результата, поэтому
	// id дописывается в готовый текст: по JSON-RPC 2.0 §5 ответ на запрос с
	// неопознанным id обязан содержать "id": null, а не опускать поле. Ровно такую
	// форму имеет и статический fallback в POST_rpc.
	Стр = Новый Структура;
	Стр.Вставить("jsonrpc", "2.0");
	IDИзвестен = (ID <> Неопределено И ID <> Null);
	Если IDИзвестен Тогда
		Стр.Вставить("id", ID);
	КонецЕсли;
	Стр.Вставить("error", Ошибка);

	Текст = MCP_JSONRPC.СохранитьJSON(Стр);
	Если НЕ IDИзвестен Тогда
		// Текст всегда начинается с "{" и содержит минимум jsonrpc и error,
		// поэтому вставка первого свойства не может дать "{,".
		Текст = "{""id"":null," + Сред(Текст, 2);
	КонецЕсли;
	Возврат Текст;

КонецФункции
