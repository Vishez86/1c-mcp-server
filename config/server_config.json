{
  "http": {
    "allowed_origins": []
  },

  "web_client": {
    "base_url": ""
  },

  "compatibility": {
    "legacy_full_json_content": false
  },

  "response": {
    "include_full_auth_context_by_default": false,
    "tool_result_mode": "text_only"
  },

  "privacy": {
    "masked_fields": [],
    "organization_aliases": {
      "enabled": false,
      "prefix": "Орг-",
